_77":193,"_79":193,"_80":81,"_82":194,"_84":176,"_86":87,"_88":89,"_90":195,"_92":196,"_94":-5},{"_66":169,"_68":170,"_70":171,"_72":-5,"_73":172,"_75":173,"_77":174,"_79":174,"_80":81,"_82":175,"_84":176,"_86":87,"_88":89,"_90":177,"_92":178,"_94":-5},{"_66":156,"_68":157,"_70":158,"_72":-5,"_73":159,"_75":160,"_77":161,"_79":161,"_80":123,"_82":162,"_84":163,"_86":87,"_88":89,"_90":164,"_92":165,"_94":-5},{"_66":139,"_68":140,"_70":141,"_72":-5,"_73":142,"_75":143,"_77":144,"_79":144,"_80":123,"_82":145,"_84":125,"_86":87,"_88":89,"_90":146,"_92":147,"_94":-5},{"_66":117,"_68":118,"_70":119,"_72":-5,"_73":120,"_75":121,"_77":122,"_79":122,"_80":123,"_82":124,"_84":125,"_86":87,"_88":89,"_90":126,"_92":127,"_94":-5},{"_66":67,"_68":69,"_70":71,"_72":-5,"_73":74,"_75":76,"_77":78,"_79":78,"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5},"id","ks1fjg0s7shahtc04vmi7mtli","title","亚马逊B2B广告投放：何时拆分独立业务广告活动","summary","George Meressa在Clear Ads Agency网站撰文讨论亚马逊B2B广告投放：卖家可按产品特性，在Sponsored Products的Amazon Business竞价调整与Amazon Business专属广告活动之间选择。原文来自该机构，存在相关商业利益，并非独立测评。文中“B2B销售占比超过3%即拆分活动”的说法是机构经验规则，并非亚马逊公布的平台门槛。","reason","source",{"_115":116},"publishedAt","2026-10-22T08:56:24.000Z","collectedAt","2026-10-22T11:36:28.728Z","timelineAt","category","advertising","tags",[112,113,114],"score",58,"selected",false,"channel","news","byline",{"_108":109,"_110":111},"media",[95],"x",{"_96":97,"_98":99,"_100":101,"_102":103,"_104":-5,"_105":-5,"_106":-5,"_107":-5},"kind","image","url","/amznews-reading-preview/_img/40f89c39f074d80d.webp","fullUrl","/amznews-reading-preview/_img/40f89c39f074d80d.webp","srcSet","/amznews-reading-preview/_img/40f89c39f074d80d.webp 336w, /amznews-reading-preview/_img/40f89c39f074d80d.webp 720w","width","height","alt","poster","author","George Meressa","platform","ClearAds Agency","广告/运营","亚马逊","Amazon Ads","name","ClearAds Agency 亚马逊广告文章","s72dmbvwb5cy5l1ec98uigt2c","Venture Forge 估算：英国站 Prime 大促 3P 销售额增速高于 1P","Venture Forge CEO Andy Banks 引用其覆盖约 160 万款产品的估算数据称，2026 年 10 月英国站 Prime Big Deal Days 期间，3P（Amazon Seller）销售额同比增长 27.5%，1P（Amazon Vendor）增长 13.9%。该数据由该机构自行统计，本站尚未独立核验，不能推广为总体结论。原文来自该机构，存在相关商业利益，并非独立测评。作者同时指出，3P 并不保证好结果，并非所有品牌都应转向 3P。",{"_115":138},"2026-10-22T09:49:30.000Z","2026-10-22T10:03:26.281Z","product",[136,137,113],60,{"_108":134,"_110":135},[128],{"_96":97,"_98":129,"_100":130,"_102":131,"_104":132,"_105":133,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/7774ca7db5e40d86.webp","/amznews-reading-preview/_img/7774ca7db5e40d86.webp","/amznews-reading-preview/_img/7774ca7db5e40d86.webp 336w, /amznews-reading-preview/_img/7774ca7db5e40d86.webp 720w",1024,590,"Chris Dawson","ChannelX","数据/报告","选品/市场","ChannelX · Chris Dawson","hw9awfsieveai97k76xejy8x3","亚马逊活跃卖家减少16%且流量向头部集中，文章解析市场格局变化与应对策略","ZonFlip 发布分析指出，亚马逊全球活跃卖家一年内减少16%，但总流量增长近5%，导致每位卖家平均获得的访问量提升25%。该文章主要引用 Marketplace Pulse 等机构的数据，揭示了美国第三方GMV高度集中于不足8000家头部卖家、中国卖家占据Top 10000席位过半数（但贡献GMV较少）以及AI购物助手推荐逻辑不同于传统搜索排名等趋势。",{"_115":155},"2026-10-22T10:11:16.000Z","2026-10-22T10:43:28.186Z",[136,137,113,154],{"_108":152,"_110":153},[148],{"_96":97,"_98":149,"_100":150,"_102":151,"_104":-5,"_105":-5,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/bcb2eb19d727e1fa.webp","/amznews-reading-preview/_img/bcb2eb19d727e1fa.webp","/amznews-reading-preview/_img/bcb2eb19d727e1fa.webp 336w, /amznews-reading-preview/_img/bcb2eb19d727e1fa.webp 720w","Joey Glyshaw","ZonFlip","FBA/物流","ZonFlip · Joey Glyshaw","g380w5uqg5iy8swx5j2by8q9y","亚马逊首次披露德国中小企业年销售额超200亿欧元","亚马逊首次披露德国中小企业去年通过其平台产生的总销售额超过200亿欧元，其中跨境销售达59亿欧元。该数据由亚马逊自报，主要出口市场包括法国、奥地利、意大利、美国和西班牙。尽管国际销售增长放缓至个位数百分比，但德国中小企业去年售出逾7.5亿件商品，平均每分钟1400件。",{"_115":168},"2026-10-22T11:44:32.000Z","2026-10-22T12:05:26.057Z",[136,113],40,{"_108":166,"_110":167},[],"Arjan","Ecommerce News Europe","Ecommerce News Europe · Arjan van Oosterhout","au4b14zlybn07jioj29rxaseh","亚马逊达人计划新手申请指南：平台选择与审核要点","ZonBase 分享亚马逊达人计划（Amazon Influencer Program）新手申请经验，建议使用最活跃的社交账号，并保持近期发帖与真实互动。原文引用创作者报告称 YouTube 约 1,000 订阅者、Instagram 1,000-5,000 粉丝等区间通常可过审，但亚马逊未公布官方最低门槛，这些区间并非官方规则。原文来自 ZonBase，文中推广其自有 ACE 工具与免费培训，存在相关商业利益，并非独立测评。",{"_115":186},"2026-10-22T13:00:00.000Z","2026-10-22T13:54:37.576Z",[112,187,113],38,{"_108":185,"_110":186},[179],{"_96":97,"_98":180,"_100":181,"_102":182,"_104":183,"_105":184,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/1d6781debd4d93e6.webp","/amznews-reading-preview/_img/1d6781debd4d93e6.webp","/amznews-reading-preview/_img/1d6781debd4d93e6.webp 336w, /amznews-reading-preview/_img/1d6781debd4d93e6.webp 720w",1200,675,"zeeshan","ZonBase","品牌","zqz73okz3vtf78adnrzvbxyq4","亚马逊搜索与搜索栏推荐机制：A9现状、专利线索及Listing优化建议","原文作者梳理亚马逊搜索排序的公开信息：亚马逊未公开算法细节，A9仍是官方名称，A10为行业叫法；作者认为转化率、销售速度、价格、库存与配送速度影响排名，但这是基于观察的推断，并非亚马逊公布的机制。文章还介绍美国专利12,561,383（2026年2月24日授予）所述搜索栏意图序列推荐框架，并给出Listing优化建议，包括在五点描述中直接回答用户问题、在标题中放置核心关键词、填写后台结构化属性、在图片中呈现文字信息。原文来自该机构，文末推广其电商团队策略咨询并收集表单，存在相关商业利益，并非独立测评。",{"_115":206},"2026-10-22T13:57:33.000Z","2026-10-22T14:36:28.030Z",[112,205,113],{"_108":203,"_110":204},[197],{"_96":97,"_98":198,"_100":199,"_102":200,"_104":201,"_105":202,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/236d5732f0968ffd.webp","/amznews-reading-preview/_img/236d5732f0968ffd.webp","/amznews-reading-preview/_img/236d5732f0968ffd.webp 336w, /amznews-reading-preview/_img/236d5732f0968ffd.webp 720w",1920,1080,"Martin Ortiz","BellaVix","Listing优化","BellaVix · Amazon与Walmart运营洞察","d34kgo07qhmaglo4uz1mzkjwl","UK OPSS 通报 Xin Yue AC PC Power Cable 存在火灾风险","UK OPSS 通报 Xin Yue AC PC Power Cable（型号 8784）因插头假冒、不符合 BS 1363 尺寸要求且缺少镇流器，存在火灾风险。该电缆导体截面积实测约 0.493 mm²，远低于标称的 0.75 mm²，易导致过热起火。S&S Cash and Carry 已将该商品从市场撤回并销毁。",{"_115":221},"2026-10-22T13:59:17.000Z","2026-10-22T21:14:29.562Z","policy",[219,220],15,{"_108":-5,"_110":218},[],"UK OPSS","政策/合规","合规税务","UK OPSS 产品安全公告","mcomvyaq9j31sey89qc3wj1r0","英国通报无叶吹风机存在严重火灾风险，进口被拒并销毁","UK OPSS 产品安全公告指出，一款假冒的无叶吹风机因开关连接不当及插头不符合 BS 1363 标准，存在严重火灾风险。该批次货物在边境被拒绝入境并予以销毁。",{"_115":221},"2026-10-22T14:04:49.000Z",[219,220],18,{"_108":-5,"_110":218},[],"k3vrky9ecb0vcjsv96f05fti8","英国OPSS通报Candle Warmer Lamp (TL-167)触电风险并拒绝进口","英国OPSS通报型号为TL-167的Candle Warmer Lamp存在严重触电风险，因内部单绝缘主线路与可触及未接地金属部件接触且绝缘层破损。该产品不符合《2016年电气设备（安全）条例》，已在边境被拒绝进口。",{"_115":221},"2026-10-22T14:06:26.000Z",[219,220],22,{"_108":-5,"_110":218},[],"lum5k51yu3guxf8z75rxciq64","欧盟委员会拟豁免部分中小企业在各销售国指定废物合规代表的义务","欧盟委员会提议暂停要求部分欧盟小型企业在每个销售国指定废物合规代表的规定，以减轻行政负担。该暂停措施针对生产包装、电池、纺织品、鞋类、电子产品和一次性塑料的欧盟小型企业，拟实施至2035年，或直至通过更全面的循环经济法。企业仍需履行生产者责任延伸制度下的其他义务，如废物预防和支付相关费用。",{"_115":250},"2026-10-22T14:37:32.000Z","2026-10-22T14:37:33.934Z",[219,220],{"_108":249,"_110":167},[],"Pleuni","Ecommerce News Europe · 欧洲电商与平台动态","ijr508ibd175y5f2p9miudoj3","Axkid 召回 MiniKid Core 儿童安全座椅","Axkid 因 MiniKid Core 儿童安全座椅未达到制造商自身安全标准，宣布从终端用户处召回该产品。受影响产品为瑞典制造、适用于新生儿至约7岁儿童的反向安装座椅。用户需凭座椅 ID 在 Axkid 官网注册以免费更换 Minikid 4 Pro。",{"_115":221},"2026-10-22T14:59:39.000Z",[219,113],{"_108":-5,"_110":218},[],"u871iicqu8bazt50x83v4lcj4","Seller Labs 发布自家 Amazon MCP 评测：对比电子表格计算真实利润的成本与效率","Seller Labs 发布关于其 Amazon MCP 工具的自我评测，指出该工具连接亚马逊数据至 Claude 或 ChatGPT，支持通过自然语言查询 SKU 级真实利润。原文强调传统电子表格需手动整合交易、广告及仓储报告且耗时，而 Seller Labs 称其 MCP 已预置数据关联并覆盖 10 个站点，但提醒读者因存在商业利益关系，应自行验证效果。",{"_115":271},"2026-10-22T15:00:00.000Z","2026-10-22T15:18:26.290Z","ai-tools",[272,273,113],27,{"_108":270,"_110":271},[],"Denis D","Seller Labs","AI/工具","卖家工具","ju5cf65w4jgo87plls5uiwhyz","沃尔玛推出 Agent Gateway 允许 AI 代理代客购物，亚马逊则继续封堵","沃尔玛推出 Agent Gateway，这是一个 MCP 服务器，允许经批准的 AI 代理在 Walmart 和 Sam’s Club 搜索库存并下单，代理无需获取用户的个人详情或订单历史。沃尔玛 CEO John Furner 周三在旧金山发布该服务。原文称，从下月起，Agent Profiles 将为每个代理在客户账户中建立独立档案，使代理订单与客户订单分开；每笔购买需经客户批准，或保持在客户设定的消费上限内。沃尔玛条款禁止代理超出购物者要求或接触支付详情，代理下错单时退货政策仍然适用。原文还称，亚马逊在 9 月开始封堵 AI 代理，包括沃尔玛合作伙伴 Meta 的 Muse。",{"_115":290},"2026-10-22T15:57:45.000Z","2026-10-22T17:31:30.761Z",[272,113],{"_108":288,"_110":289},[283],{"_96":97,"_98":284,"_100":285,"_102":286,"_104":287,"_105":132,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/260272be03b1194e.webp","/amznews-reading-preview/_img/260272be03b1194e.webp","/amznews-reading-preview/_img/260272be03b1194e.webp 336w, /amznews-reading-preview/_img/260272be03b1194e.webp 720w",1536,"Paul Drecksler","Shopifreaks","Shopifreaks · 电商行业快讯","s7so7zu3yxboh1tf51xewfv47","亚马逊Q4日常品销量翻倍","Q4期间所有商品销售速度都会加快。日常用品的周转速度是平时的1.5到2倍。\n\n如果某商品在1月至9月每月售出100件，预计11月和12月每月可售出150至200件。\n\n玩具等礼品类商品销量可达5倍、10倍甚至20倍。",{"_115":311},"2026-10-22T17:02:23.000Z","2026-10-22T17:11:29.671Z",[137,310],[],{"_300":301,"_302":303,"_304":305,"_306":307,"_92":308,"_309":-5},"authorName","Dan Boufford","handle","1000asins","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w",[],"quoted","品类趋势","X · Dan Boufford","acqjx500up1w5r091sd7wdh8i","亚马逊推替换零件计划降退货","新！亚马逊正在推广一种更智能的减少退货方式。\n\n亚马逊的“替换零件计划”允许卖家更换损坏或缺失的组件，而不是接受整件产品退货。\n\n亚马逊报告称，2025年收到替换零件的客户中，64%保留了其产品。\n\n退货更少，成本更低，客户更满意。这可能是一个改变游戏规则的因素。\n\n有卖家在使用这个吗？",{"_115":334},"2026-10-22T17:33:47.000Z","2026-10-22T17:42:27.528Z",[219,333,113],50,[],{"_300":322,"_302":323,"_304":324,"_306":325,"_92":326,"_309":-5},"Amazon Sellers ASGTG","AmazonASGTG","/amznews-reading-preview/_img/missing.svg","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w",[327],{"_96":97,"_98":328,"_100":329,"_102":330,"_104":331,"_105":332,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/missing.svg","/amznews-reading-preview/_img/missing.svg","/amznews-reading-preview/_img/missing.svg 336w, /amznews-reading-preview/_img/missing.svg 720w",509,637,"退货管理","X · ASGTG","b7qrpzp6b7xo6qonotjkgo425","FundPark获Bain Capital至多2.5亿美元债务融资以扩展亚洲电商卖家贷款","FundPark从Bain Capital获得至多2.5亿美元债务融资，用于扩大对亚洲电商卖家的贷款规模。其中1亿美元已承诺，剩余1.5亿美元取决于未披露的条件。该公司自2016年成立以来已向4万多家网店累计放贷超100亿美元，其风控模式基于实时销售数据而非传统信用检查。",{"_115":290},"2026-10-22T17:39:19.000Z","2026-10-22T18:32:29.322Z","fba",[349,350],{"_108":288,"_110":289},[345],{"_96":97,"_98":346,"_100":347,"_102":348,"_104":201,"_105":202,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/21711f82959ac1e8.webp","/amznews-reading-preview/_img/21711f82959ac1e8.webp","/amznews-reading-preview/_img/21711f82959ac1e8.webp 336w, /amznews-reading-preview/_img/21711f82959ac1e8.webp 720w","行业动态","供应链","gmuujupo229dv4vkmykudjeih","PHP 曝出高危漏洞，AI 加速发现与修复","PHP 语言曝出 CVE-2026-109618/109619 漏洞（PHP2Shell），攻击者在官方补丁发布前六小时即发起利用。多个团队借助 AI 在数天内发现该存在 14 年的缺陷，导致 WordPress、Magento 等电商平台面临无登录远程代码执行风险。",{"_115":271},"2026-10-22T18:00:00.000Z","2026-10-22T18:21:25.608Z",[272,273,113],{"_108":360,"_110":271},[],"Nhan Dinh","vuo1tzymcyz8qal0hokzdl59p","WOOT BD是什么？适用场景与提报条件（附操盘方自述案例）","本文介绍WOOT BD（Woot Deals）的定义与适用场景，并列出作者给出的提报条件：Review数量≥10个、星级≥4.1星、Deal价格≥$15、日销量≥10单（新品可放宽至≥5单）、子ASIN≤10个且75%以上子ASIN同时参加，活动期间需配合SP/SB/SD广告投放。文中案例为操盘方自述：某老品经3轮BD活动，日销、BSR与关键词收录等数据逐轮变化，ACoS由38.39%降至22.14%；该案例未经本站独立核验，不能推广为总体结论。原文作者强调效果取决于产品基础质量、广告支持及库存准备。原文来自该机构，存在相关商业利益，并非独立测评。",{"_115":377},"2026-10-22T18:44:00.000Z","2026-10-23T03:16:32.759Z",[112,205,113],47,{"_108":375,"_110":376},[371],{"_96":97,"_98":372,"_100":373,"_102":374,"_104":-5,"_105":-5,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/7d573e2d29e2ff9f.webp","/amznews-reading-preview/_img/7d573e2d29e2ff9f.webp","/amznews-reading-preview/_img/7d573e2d29e2ff9f.webp 336w, /amznews-reading-preview/_img/7d573e2d29e2ff9f.webp 720w","跨境Savior","AMZ123","AMZ123 · 跨境头条","w5o7d0ji1csxodde6au404rvx","卖家平台登录受阻时的账户恢复步骤","原文来自账号 amznsellerhelp，其是否代表亚马逊官方尚未经本站独立核实；文中短链 spr.ly 的指向亦未经本站核验。\n\n原文针对无法登录 Seller Central 的情形，列出以下步骤：\n✅ 重置密码并更新两步验证\n✅ 若失去设备访问权限，使用亚马逊的账户恢复流程\n✅ 保持登录凭证和恢复信息最新\n\n原文附有账户恢复与两步验证帮助的短链。原文称账户安全是业务的第一道防线。",{"_115":393},"2026-10-22T19:00:01.000Z","2026-10-22T19:15:28.641Z",[219,113],42,[],{"_300":388,"_302":389,"_304":390,"_306":391,"_92":392,"_309":-5},"Amazon Seller Help","amznsellerhelp","/amznews-reading-preview/_img/missing.svg","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w",[],"X · Amazon Seller Help","lqz9gk9mglvrj1wpifejpsqji","Venture Forge发布2026年亚马逊英国站秋季大促市场数据","电商分析机构Venture Forge公布2026年亚马逊英国站Prime Big Deal Days数据，该周期内总销售额达10.6亿英镑，同比增长22%。其中第三方卖家增速（27.5%）接近自营卖家（13.9%）的两倍，且并非依靠更深折扣取胜。在追踪的10个主要品类中，第三方卖家有8个品类增速超过自营；韩国护肤品牌借势大促快速抢占市场份额，其在该品类中的占比从去年的9%升至25%。","原文引用了第三方机构对英国站大促的追踪数据，拆解了不同渠道和品类的销售表现差异。",{"_115":377},"2026-10-22T19:16:00.000Z","2026-10-23T03:16:32.691Z",[136,137,310,113],62,true,{"_108":410,"_110":376},[406],{"_96":97,"_98":407,"_100":408,"_102":409,"_104":-5,"_105":-5,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/92c4f26b0516012f.webp","/amznews-reading-preview/_img/92c4f26b0516012f.webp","/amznews-reading-preview/_img/92c4f26b0516012f.webp 336w, /amznews-reading-preview/_img/92c4f26b0516012f.webp 720w","亚马逊资讯","nhnpfu6pfo7m8stjtyugrso6d","Azoma 获 Puma Growth Partners 领投 1120 万美元 A 轮融资，优化品牌在 AI 购物助手中的推荐","Azoma 完成由 Puma Growth Partners 领投的 1120 万美元 A 轮融资，Dunnhumby 跟投。其软件旨在追踪并提升品牌产品在 ChatGPT、Gemini 等 AI 购物助手中的曝光与推荐表现。Azoma 称基于 3800 万条 AI 引用分析，各引擎信源偏好差异显著，如 Alexa for Shopping 近 40% 引用来自联盟网站。",{"_115":290},"2026-10-22T19:49:17.000Z","2026-10-22T20:34:26.527Z",[272,425,187],25,{"_108":288,"_110":289},[421],{"_96":97,"_98":422,"_100":423,"_102":424,"_104":201,"_105":202,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/f228da8682844cae.webp","/amznews-reading-preview/_img/f228da8682844cae.webp","/amznews-reading-preview/_img/f228da8682844cae.webp 336w, /amznews-reading-preview/_img/f228da8682844cae.webp 720w","AI工具","ofwc1un87xk74fcl1ji8k14lu","亚马逊AI代理精简供应商价目表","供应商发给我一份5,000行的价目表。在我查看之前，我的AI代理将其缩减到约600行。\n\n它通过UPC将每一行匹配到ASIN，如果没有UPC则通过标题匹配。它检查我是否获得品牌授权，从Keepa拉取数据，剔除销售排名超过300,000的产品，并标记利润率。\n\n构建它大约花了30分钟的提示词编写时间。",{"_115":311},"2026-10-22T19:59:07.000Z","2026-10-22T20:17:29.797Z",[272,425,137],[],{"_300":301,"_302":303,"_304":305,"_306":307,"_92":435,"_309":-5},[],"lk20s9hb6xr8egjlor7g5jdpn","亚马逊宠物用品选品观察：10款产品的预估销售表现","AMZ123选品观察员盘点亚马逊上10款宠物相关产品，涵盖马匹护理、水族设备及爬宠用品等。原文逐款列出“预计销售额”和“销量+”等约数，其中兽用止痛凝胶预计月销售额37.12万美元、销量21,600+，喷泉水泵预计月销售额23.99万美元、销量9,300+，马用驱虫药预计月销售额16.99万美元、销量10,000+。上述数据为原文列出的预估与约数，并非确定销量，且多款产品销量未过万。",{"_115":377},"2026-10-22T20:08:00.000Z","2026-10-23T04:20:25.779Z",[137,310],{"_108":449,"_110":376},[445],{"_96":97,"_98":446,"_100":447,"_102":448,"_104":-5,"_105":-5,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/ee8dc51c56a7429a.webp","/amznews-reading-preview/_img/ee8dc51c56a7429a.webp","/amznews-reading-preview/_img/ee8dc51c56a7429a.webp 336w, /amznews-reading-preview/_img/ee8dc51c56a7429a.webp 720w","AMZ123选品观察员","v0t7czo4xacqwj3n7by6r2qhl","Circana 发布全球健康与福祉市场报告：超九成美国消费者重视健康但仅 38% 满意","Circana 发布《全球健康与福祉市场》报告，指出尽管超过 93% 的美国消费者将健康列为优先事项，但仅 38% 对其现状感到满意，且只有 18% 坚持执行结构化日常。",{"_115":465},"2026-10-22T20:11:51.000Z","2026-10-22T20:34:26.222Z",[137,310],{"_108":463,"_110":464},[459],{"_96":97,"_98":460,"_100":461,"_102":462,"_104":-5,"_105":-5,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/d24357902600cf10.webp","/amznews-reading-preview/_img/d24357902600cf10.webp","/amznews-reading-preview/_img/d24357902600cf10.webp 336w, /amznews-reading-preview/_img/d24357902600cf10.webp 720w","Lynn Petrak","Circana","Circana · 博客与研究发布","x9zixx9a0av3eth4w3uxvknab","Stord 以九位数金额收购 AMS Fulfillment，新增10个仓库及150多个美妆DTC品牌","Stord 以九位数金额收购 AMS Fulfillment，获得洛杉矶、盐湖城和费城的10个仓库及150多个美妆与 DTC 品牌客户。此次交易是 Stord 第11次且最大规模的收购，使其网络超过100个站点，并计划利用现有自动化分拣系统推进机器人和 AI 布局。",{"_115":290},"2026-10-22T20:49:56.000Z","2026-10-22T21:35:26.398Z",[154,350],{"_108":288,"_110":289},[475],{"_96":97,"_98":476,"_100":477,"_102":478,"_104":201,"_105":202,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/f7efe3182dfad270.webp","/amznews-reading-preview/_img/f7efe3182dfad270.webp","/amznews-reading-preview/_img/f7efe3182dfad270.webp 336w, /amznews-reading-preview/_img/f7efe3182dfad270.webp 720w","a6fom67rc4z4cxay408myhqdh","亚马逊生鲜销量激增抢占超市份额","据 NielsenIQ 数据，亚马逊通过扩大生鲜同日达服务，在截至今年8月下旬期间从传统超市手中夺取美国食品市场份额。其海鲜、乳制品和农产品销量在6月至8月间增长数倍。购买者多为高收入年长用户，NielsenIQ 认为此举旨在提升其在亚马逊平台的购物频率。",{"_115":290},"2026-10-22T20:59:42.000Z","2026-10-22T21:35:26.390Z",[349,113],{"_108":288,"_110":289},[488],{"_96":97,"_98":489,"_100":490,"_102":491,"_104":492,"_105":493,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/1fdfff48bcd608dc.webp","/amznews-reading-preview/_img/1fdfff48bcd608dc.webp","/amznews-reading-preview/_img/1fdfff48bcd608dc.webp 336w, /amznews-reading-preview/_img/1fdfff48bcd608dc.webp 720w",1067,800,"s5bb3rz231sygpvzmvh6dia41","Recommended by Agents 测试显示 AI 购物代理在 150 美元以下跑鞋推荐中 Brooks 占比 67%","机构 Recommended by Agents 自报测试显示，AI 购物代理在回答 40 个关于 150 美元以下跑鞋的问题时，Brooks 被推荐的比例为 67%。",{"_115":290},"2026-10-22T23:59:12.000Z","2026-10-23T00:38:26.520Z",[272,425],{"_108":288,"_110":289},[503],{"_96":97,"_98":504,"_100":505,"_102":506,"_104":183,"_105":493,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/b634b6d4de79332e.webp","/amznews-reading-preview/_img/b634b6d4de79332e.webp","/amznews-reading-preview/_img/b634b6d4de79332e.webp 336w, /amznews-reading-preview/_img/b634b6d4de79332e.webp 720w","t367fuyc28on55rkvghjzsqol","亚马逊报告：2025年德国中小企业平台销售额超200亿欧元","亚马逊最新报告显示，2025年德国中小企业通过其平台创造的销售额超过200亿欧元，其中跨境销售额达59亿欧元。这是亚马逊首次披露该群体在平台上的整体销售规模，此前仅公布出口数据。尽管跨境业务持续增长，但增速较早期有所放缓；同时卖家数量表述从2025年的约4.7万家回落至目前的“超过4万家”，具体减少幅度因未给出精确数字而尚不确定。",{"_115":522},"2026-10-23T00:00:00.000Z","2026-10-23T03:48:25.231Z",[136,113],39,{"_108":521,"_110":376},[517],{"_96":97,"_98":518,"_100":519,"_102":520,"_104":-5,"_105":-5,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/a9336a72d8bed4bf.webp","/amznews-reading-preview/_img/a9336a72d8bed4bf.webp","/amznews-reading-preview/_img/a9336a72d8bed4bf.webp 336w, /amznews-reading-preview/_img/a9336a72d8bed4bf.webp 720w","Summer","AMZ123 · SUMMER","kso1hh3j4fo1965e4v7d4gagz","亚马逊Seller Assistant功能介绍","是否希望直接向卖家平台提问，而不必费力查找？\n\n这正是 Seller Assistant 的作用。政策问题、销售趋势、商品详情页问题、账户健康状况：全部以通俗语言呈现，并使用您自己的数据。查看其运作方式并立即开始提问 👉 http://spr.ly/6019BHZWwb",{"_115":546},"2026-10-23T00:00:51.000Z","2026-10-23T00:25:27.902Z",[272,545,113],[],{"_300":532,"_302":533,"_304":534,"_306":535,"_92":536,"_309":-5},"Sell on Amazon","Sell_on_Amazon","/amznews-reading-preview/_img/missing.svg","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w",[537],{"_96":538,"_98":539,"_540":541,"_102":542,"_104":543,"_105":544,"_106":-5,"_107":539},"video","/amznews-reading-preview/_img/missing.svg","originalUrl","https://x.com/Sell_on_Amazon/status/2113420349475786760","/amznews-reading-preview/_img/missing.svg 336w, /amznews-reading-preview/_img/missing.svg 720w",3840,2160,"Seller Central","X · Sell on Amazon","l3rn4y9e88vuei9t9mbbtp9gd","亚马逊NWD通知引卖家关注：10月27日移除订单提交截止，收到邮件不等于下架","近期部分卖家收到亚马逊NWD（品牌方仅做DTC直营、不向批发商或第三方转售商供货）相关通知，邮件提及商品10月27日下架、逾期未处理FBA库存可能被弃置。原文指出，本轮通知由系统批量发给品牌代表和分销商两类账号、不单独识别角色，收到邮件不等于下架，关键看账号在品牌备案后台是否登记为Brand Representative且角色生效；已登记且角色生效的正常销售不受影响，授权经销商、普通转售商不等于品牌代表。原文按品牌维度判定风险，列出分销型、铺货型、精铺型、拿货转售四类高风险卖家，并给出自有品牌误通知、正规分销商、品牌本身属NWD模式、合法经销体系被误判四种场景的应对步骤；其中货物无需27日前实际出库，截止日前成功提交移除订单即可避免弃置。以上为原文观点，具体规则与账号状态需以亚马逊后台及官方通知为准。","原文区分了系统批量通知与确定下架，说明需先核对Brand Representative角色再匹配应对方案，并给出四类高风险卖家与分场景处理步骤，同时保留提交移除订单即可避免弃置的条件。",{"_115":560},"2026-10-23T01:32:00.000Z","2026-10-23T02:02:27.832Z",[219,154,113],74,{"_108":558,"_110":559},[],"海象跨境","卖家之家","卖家之家 · 跨境资讯","jpyda0ot9p5qwpfqk9yp0d4y7","亚马逊黑五入仓截止日临近：作者按运输方式给出的应对建议","作者称10月28日是走Amazon-optimized拆分货件模式的黑五入仓截止日，错过该日期并非完全赶不上黑五，而是无法获得Prime专属优惠标签的流量加持，只能当常规产品卖；AWD的截止日更早，为10月14日。作者按运输方式给出建议：海运需二十多天，6天内赶不上，不建议硬发；空派或快递3到5天可到仓，但需立即安排并盯紧物流；已发货者应查货件状态，确认能否在截止日前到仓上架。原文文末推广WOOT，称其无需后台秒杀资格即可做活动、灵活排期、加速回款；原文来自该机构，存在相关商业利益，并非独立测评。",{"_115":560},"2026-10-23T01:46:00.000Z","2026-10-23T02:18:25.463Z",[112,154,571,113],{"_108":570,"_110":559},[],"悟特胖精灵Woot","库存管理","hcr29r3twlbzzlznrl5h67rno","近期美国专利下证清单涉及空气炸锅等33款产品","积特知识产权发布近期美国专利下证清单，共33项，涉及空气炸锅、碎菜机、吹风机等产品，其中第9项为再颁专利USRE51064E，并非外观设计专利。原文称若销售相关产品需注意排查比对，否则有可能面临侵权投诉和TRO等风险。原文来自该机构，存在相关商业利益，并非独立测评。",{"_115":560},"2026-10-23T01:50:00.000Z","2026-10-23T03:22:29.880Z",[219,220,113],{"_108":585,"_110":559},[581],{"_96":97,"_98":582,"_100":583,"_102":584,"_104":-5,"_105":-5,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/fc1f15271f70676c.webp","/amznews-reading-preview/_img/fc1f15271f70676c.webp","/amznews-reading-preview/_img/fc1f15271f70676c.webp 336w, /amznews-reading-preview/_img/fc1f15271f70676c.webp 720w","积特知识产权","in1lpmvjt43fo5mr1nf2g5n1y","欧盟商标注册指南：覆盖27国、亚马逊备案前提及6步流程","原文介绍欧盟商标由欧盟知识产权局（EUIPO）统一管理，一份申请可在27个成员国获得保护，有效期10年、到期可续展；英国已脱欧，新欧盟商标不包含英国，需单独申请英国商标。原文称欧盟商标是亚马逊品牌备案的关键条件，备案后可使用A+页面、旗舰店、防跟卖、侵权举报等功能。非欧盟申请人须委托欧盟当地合规代理提交，流程为前期检索、确定类别、准备材料、提交申请、审查公示（含3个月公示期）、下证维护。原文另提及“2026新规要求使用证据至少覆盖2个欧盟成员国”，但未给出法规名称、条款或官方链接，本站尚未独立核验该引用，该表述不作为确定合规依据。原文来自跨境服务机构“海象跨境”，存在相关商业利益，并非独立测评。",{"_115":560},"2026-10-23T02:14:00.000Z","2026-10-23T03:22:29.861Z",[219,187],35,{"_108":558,"_110":559},[],"g9bq8nwl79d0as8itqxweivu2","欧盟废止对华太阳能玻璃双反税并启动追溯退税","欧盟委员会于2026年10月21日公告废止对中国太阳能玻璃征收的反倾销与反补贴税，生效日为10月22日。海关将不计利息退还自2025年7月22日起已征收的税款，进口商需主动申请。该政策仅针对特定技术参数的光伏上游工业中间品，与亚马逊等平台的普通消费品无关，体现欧盟对产业链上游放开、下游收紧的结构性分化策略。",{"_115":560},"2026-10-23T02:37:00.000Z","2026-10-23T04:26:28.140Z",[219,220,350],{"_108":609,"_110":559},[605],{"_96":97,"_98":606,"_100":607,"_102":608,"_104":-5,"_105":-5,"_106":-5,"_107":-5},"/amznews-reading-preview/_img/f7f2f2e373b8d459.webp","/amznews-reading-preview/_img/f7f2f2e373b8d459.webp","/amznews-reading-preview/_img/f7f2f2e373b8d459.webp 336w, /amznews-reading-preview/_img/f7f2f2e373b8d459.webp 720w","嘀嗒嘀物流科技","f9d1acp7wporu9qroqzmmg74a","沃尔玛推出代理档案与网关，开放AI代理购物权限","沃尔玛宣布将在未来一个月内推出“代理档案”并测试“代理网关”，允许用户授权AI代理在设定限额内购物或进行审批。该方案基于MCP协议，旨在让外部AI连接服务时不共享用户个人信息，与亚马逊限制Perplexity等代理的做法形成对比。",{"_115":560},"2026-10-23T02:41:48.000Z","2026-10-23T03:22:29.836Z",[272,425],{"_108":619,"_110":559},[],"AI跨境快讯","u9eir28o9ciuz7v1rq7bio2bj","Five9调查：46%消费者对最近一次AI客服体验评价正面","Five9自报调查显示，46%的消费者对最近一次使用AI和聊天机器人渠道的体验给予正面评价，低于电话、邮件等渠道约三分之二的正面评价比例。该调查覆盖美国、英国和德国的3000名消费者和600名企业决策者，本站尚未独立核验。原文引述客户体验专家Brad Cleveland的观点，建议企业确保知识库最新准确、用真实且不完美的客户对话进行测试，并衡量失败率和升级率、保留便捷的人工转接通道。",{"_115":560},"2026-10-23T02:42:48.000Z","2026-10-23T04:26:28.116Z",[272,425],{"_108":619,"_110":559},[],"j8tpmo2mp5ehy98vdmgbs6jq8","亚马逊欧洲站重型大件市场机会与物流方案解析","亚马逊全球开店指出，欧洲站重型大件（如家具、健身器材）因本地居住习惯及分散的竞争格局，为小卖家提供新机会。文章详解了FBA Pan-EU及MSF多卖家灵活配送等物流解决方案，并强调需关注设计耐用性与环保材料等消费者偏好。",{"_115":560},"2026-10-23T03:31:41.000Z","2026-10-23T04:58:30.217Z",[137,154,310,113],{"_108":638,"_110":559},[],"跨境资讯通","qzmmoq731wpzau4mal0lbt2wb","2026年亚马逊英国站秋季大促销售额达10.6亿英镑，第三方卖家增速显著","电商分析机构 Venture Forge 公布 2026 年亚马逊英国站 Prime Big Deal Days 数据，大促周总销售额预计达 10.6 亿英镑，同比增长 22%。","Venture Forge 数据显示第三方卖家增速近自营两倍，且非依赖深折，为黑五备货与渠道策略提供量化参考。",{"_115":560},"2026-10-23T03:33:09.000Z","2026-10-23T04:58:30.197Z",[136,113],{"_108":638,"_110":559},[],"rjra5h5dj4i040g1aq43a4o3d","e-Conomy SEA 2026报告：东南亚电商GMV预计达2260亿美元","谷歌、淡马锡和贝恩公司联合发布《e-Conomy SEA 2026》报告，预计2026年东南亚数字经济GMV达3680亿美元，其中电子商务GMV为2260亿美元，同比增长18%。报告指出AI正改变消费者购物方式，六国约58%劳动年龄人口使用生成式AI，69%受访消费者用AI比较商品；平台如Lazada和Shopee也利用AI提升运营效率与用户体验。","原文引用谷歌等机构联合发布的东南亚互联网经济报告，提供了2026年电商GMV预测及AI在购物决策中的具体渗透率数据。",{"_115":560},"2026-10-23T03:33:42.000Z","2026-10-23T04:58:30.175Z",[136,310,425],{"_108":638,"_110":559},[],"s7vsnql89s149ywwoizbxqjiw","亚马逊最新报告显示，2025年德国中小企业通过其平台创造的销售额超过200亿欧元，其中跨境销售额达59亿欧元。这是亚马逊首次披露该群体在平台上的整体销售规模，主要出口市场包括法国、奥地利等国。尽管商品销量突破7.5亿件，但跨境业务增速较早期明显放缓，卖家数量表述为“超过4万家”，未给出精确增减数据。",{"_115":560},"2026-10-23T04:07:26.000Z","2026-10-23T07:22:31.215Z",[136,310,113],{"_108":638,"_110":559},[],"all","tag","topic","q","tab","time","order","original","collectedSince",{"_677":678},"changelogVersion","2026-10-09T22:08"]
