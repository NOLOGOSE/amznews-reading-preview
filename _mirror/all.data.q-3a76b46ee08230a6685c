dd8e3a.webp","/amznews-reading-preview/_img/9443c168bcdd8e3a.webp 336w, /amznews-reading-preview/_img/9443c168bcdd8e3a.webp 720w",1200,630,"David Gallo","SellerForge","SellerForge · David Gallo","ghnferqmojr4d6q7prhsl4fw5","ZCK01 召回 Kesyup 床垫：违反强制阻燃标准，存在火灾致死致伤风险","ZCK01 召回约 48,405 张 Kesyup 品牌床垫，因其违反床垫强制阻燃标准，存在火灾导致严重伤害或死亡的风险。涉事床垫为 12 英寸厚，有 twin、full、queen 和 king 尺寸，白色顶面配蓝色侧面和蓝色滚边，2024 年 12 月至 2026 年 4 月在 Amazon.com 以 100 至 200 美元售出。",{"_117":265},[266,293,116,267],36,{"_110":-5,"_111":265},[],"合规税务","idr58bzv49dlp7vpq4by32nm7","The Blue Cactus Company 躺椅电池组因火灾和烧伤风险被召回，产品曾在 Amazon 销售","美国消费品安全委员会宣布召回 The Blue Cactus Company 躺椅用 2500 mAh 电池组（型号 RWX-RBP02），涉及约 51,000 件，原因是锂离子电池可能过热，构成火灾和烧伤风险。",{"_117":265},[266,267,116,219],32,{"_110":-5,"_111":265},[],"qhqxtsebkru5cpzkhz4v6jnzu","NEWDERY 移动电源因起火和烧伤风险被召回，产品在 Amazon 销售","美国消费品安全委员会宣布召回约 21,380 个 NEWDERY 移动电源（型号 ZHX-PB22），该产品锂电池可能爆炸或起火，已收到 9 起爆炸起火报告，含 1 起造成 200 万美元财产损失的严重火灾和 1 起烧伤。产品于 2023 年 10 月至 2024 年 11 月在 Amazon.com 以 27 至 50 美元售出，消费者应立即停用并联系 NEWDERY 获取全额退款。",{"_117":265},[266,116,267],{"_110":-5,"_111":265},[],"qjpfxhkgdedg43p6ul6jqvj92","Style Homeware 因火灾致死风险召回 Emerspring 床垫，违反床垫阻燃强制标准","Style Homeware 召回约 263 张 Emerspring 床垫，原因是产品违反床垫阻燃强制标准，存在火灾致重伤或死亡风险。涉事床垫为 12 英寸厚 queen 尺寸，2026 年 1 月至 5 月在 Amazon.com 以 226 美元售出，消费者应立即停用并联系品牌方免费领取合规床垫套。",{"_117":265},[266,267,116,133],{"_110":-5,"_111":265},[],"uyzv917s7qdnvf482uwbrfa8n","5Color 儿童自行车头盔及护具套装因违反强制性标准被召回，存在头部重伤或死亡风险","5Color 品牌儿童自行车头盔及护具套装因不符合自行车头盔强制性安全标准被召回，涉及约 324 套，仅 S 码粉色头盔在列，型号 YD-001、批次 YD-260320。",{"_117":265},[266,116,267],28,{"_110":-5,"_111":265},[],"v0clxjifmksgqmg6egh6zbkln","Love To Dream 召回便携式睡眠机，存在火灾和烧伤风险","Love To Dream 召回约 4,000 台便携式睡眠机（型号 LTD-SM23、日期码 7W15TN），因充电器不兼容时锂电池可能过热，存在火灾和烧伤风险。消费者应立即停用并在官网注册以获得全额退款，退款通过电子支付或店铺积分发放。该产品 2025 年 2 月至 2026 年 9 月在 Target、Nordstrom 及亚马逊等渠道以约 60 美元售出，目前无事故报告。",{"_117":265},[266,267,116],{"_110":-5,"_111":265},[],"xppl6zilgvvnmzlogwe4nj91a","Xinan Home 召回 WinxMatrs 床垫：违反强制阻燃标准，存在火灾致死风险","Xinan Home 召回约 792 张 WinxMatrs 品牌床垫，因违反床垫强制阻燃标准，存在火灾致重伤或死亡风险。该黑色 10 英寸厚单人床垫于 2025 年 8 月至 11 月在 Amazon.com 以约 120 美元线上售出，消费者应立即停用并联系 Xinan Home 获全额退款。",{"_117":265},[266,293,116,267],{"_110":-5,"_111":265},[],"zxzv1wy8xgbeyx3rcvh08x273","Yuyitop 召回 Aitjunz 8 抽屉柜：未固定易倾倒，违反 STURDY Act 强制标准","Yuyitop 召回约 25,073 台 Aitjunz 8 抽屉柜，因未固定上墙时存在倾倒和夹困风险，可致儿童重伤或死亡，且违反 STURDY Act 强制安全标准。",{"_117":265},[266,293,116,267],44,{"_110":-5,"_111":265},[],"lvoqi8zumfluqtxswzdi8hzve","亚马逊升级 Seller Assistant 并推出卖家合作伙伴插件","亚马逊宣布升级卖家助手 Seller Assistant，新增可全天候运行的自动化工作流，并推出卖家合作伙伴插件，首批接入 Amazon Quick，随后以测试版支持 Anthropic 的 Claude。",{"_117":361},"2026-09-24T02:19:34.000Z","2026-09-30T10:06:34.407Z",[113,116,115,114,219],72,{"_110":360,"_111":149},[356],{"_96":97,"_98":357,"_100":358,"_102":359,"_104":-5,"_106":-5,"_108":-5,"_109":-5},"/amznews-reading-preview/_img/0f64ff65ee4a12c3.webp","/amznews-reading-preview/_img/0f64ff65ee4a12c3.webp","/amznews-reading-preview/_img/0f64ff65ee4a12c3.webp 336w, /amznews-reading-preview/_img/0f64ff65ee4a12c3.webp 720w","Summer","AMZ123 · SUMMER","u3p8unb82crh8011zvtqrczbb","亚马逊最近这3个变化，正在影响卖家的流量、库存和履约","亚马逊近期开放面向Amazon Business企业客户的专属限时Deals，活动时长1小时到30天不等，覆盖美国、英国、德国、法国、意大利、西班牙、日本、加拿大等站点。符合条件的TikTok Shop美国订单可使用Amazon MCF配送，并享受12个月的35%履约费优惠。亚马逊还分批恢复高温敏感商品的FBA入仓，但部分商品可发货后仍需等待一段时间才能正式销售。",{"_117":376},"2026-09-24T02:46:00.000Z","2026-09-30T08:21:08.835Z","fba",[219,375,254,116],42,{"_110":373,"_111":374},[],"跨境视频cici","雨果跨境","库存管理","雨果跨境 · 跨境视频cici","c90atm2h46166sqf7d658p2cn","CPSC 拟将特定窗帘绳索列为重大产品危害","美国消费品安全委员会（CPSC）提议将存在特定绳索风险的窗帘产品列为“重大产品危害”，以应对勒颈风险。该提案涵盖定制窗帘中超过8英寸的自由悬挂操作绳、无张力装置的连续环等情形，公众意见征集截止至2026年11月23日。",{"_117":386},"2026-09-24T04:00:00.000Z","2026-10-16T14:13:48.721Z",[266,116],{"_110":-5,"_111":265},[],"CPSC 美国消费品安全委员会 · 联邦公报","kkjcq0dlai7yf5mylgg4qgm7x","亚马逊为商家自有网站提供免费 Prime 配送","亚马逊宣布通过 Amazon Supply Chain Services 推出两项面向美国卖家的新服务：MCF 新老商家可在自有网站添加快速、免费的 Prime 配送，无需在标准 MCF 费用之外支付额外费用；MCF Preferred Pricing Program 则让商家在自有网站、市场和社交渠道的配送费用最高节省 25%，前六个月节省 15% 至 25%。","亚马逊官方发布 MCF 两项新服务，卖家可据此了解自有网站接入 Prime 配送的门槛与费率优惠条件，但需注意 Prime 配送并非完全免费，而是在标准 MCF 费用之外无额外费用，且优惠定价计划有前六个月等条件。",{"_117":406},"2026-09-24T09:58:21.172Z","2026-09-29T19:32:29.631Z",[219,116,254,115],74,{"_110":404,"_111":405},[398],{"_96":97,"_98":399,"_100":400,"_102":401,"_104":402,"_106":403,"_108":-5,"_109":-5},"/amznews-reading-preview/_img/7ab6adff84decc64.webp","/amznews-reading-preview/_img/7ab6adff84decc64.webp","/amznews-reading-preview/_img/7ab6adff84decc64.webp 336w, /amznews-reading-preview/_img/7ab6adff84decc64.webp 720w",1240,698,"Jacquelyn Smith","About Amazon","About Amazon · 零售","pvd22wxo126gpvlmmbllrnqlg","亚马逊推出MCF卖家独立站免费Prime配送及优选定价计划","亚马逊宣布美国地区使用多渠道履约（MCF）的商家可在其独立网站免费提供快速Prime配送，无需额外费用或更改结账流程。同时推出MCF优选定价计划，结合履约费折扣与FBA积分，使商家在前六个月最高节省25%的履约费用，且无合同约束。该功能通过Shopify应用或Selling Partner API激活，旨在帮助商家利用亚马逊物流网络提升转化率并降低运营成本。","原文详细说明了MCF卖家在独立站启用Prime配送的零成本条件及新定价计划的折扣幅度，为多平台运营提供了具体的物流降本方案。",{"_117":220},"2026-09-24T10:41:11.000Z","2026-10-16T18:20:07.495Z",[113,219,116],[],{"_208":209,"_210":211,"_212":213,"_214":215,"_92":417,"_217":-5},[],"r4ruy3u94mzo9so68vru0bvx4","亚马逊推出新工具与服务助力卖家从第一天起实现全球化销售","亚马逊宣布推出一系列新功能和服务，旨在帮助卖家简化跨国运营流程，包括统一扩展视图、单次测试多国认证及全球仓储配送网络。",{"_117":436},"2026-09-24T13:00:05.099Z","2026-10-13T15:21:06.971Z",[113,115,219,116],58,{"_110":435,"_111":405},[428],{"_96":97,"_98":429,"_100":430,"_102":431,"_104":432,"_106":433,"_108":434,"_109":-5},"/amznews-reading-preview/_img/5344c748bfb430d0.webp","/amznews-reading-preview/_img/5344c748bfb430d0.webp","/amznews-reading-preview/_img/5344c748bfb430d0.webp 336w, /amznews-reading-preview/_img/5344c748bfb430d0.webp 720w",1320,743,"Hands typing on a laptop displaying Amazon FBA UK domestic plan dashboard","Sunny Jain","About Amazon · 官方文章 Sitemap","z1ae5umsoiaz4e3pekd8rzypw","Seller Central 多渠道工具逐步面向美国站推出：先核对当前能力","Mary Beth Westmoreland 在2026年9月24日的亚马逊官方署名公告中介绍，多渠道销售工具将在未来数月逐步向美国站卖家推出。原文描述连接 eBay、Shopify、TikTok、Walmart，导入或关联站外商品、查看多渠道销售与订单及履约；跨渠道一次修改商品信息、利润和广告流量分析等能力包含未来推出的表述，不能据此认定所有账户现在都可使用。工具不额外收费，不代表仓储、履约、广告及其他平台费用免费。本站建议先