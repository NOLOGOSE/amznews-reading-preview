:490},[484],{"_114":115,"_116":485,"_118":486,"_120":487,"_122":488,"_123":488,"_124":-5,"_125":-5},"/amznews-reading-preview/_img/087643f6421b3a85.webp","/amznews-reading-preview/_img/087643f6421b3a85.webp","/amznews-reading-preview/_img/087643f6421b3a85.webp 336w, /amznews-reading-preview/_img/087643f6421b3a85.webp 720w",100,"Kamaljit Singh","AMZ One Step","d9zdaxw1b1rl0g7za0q1hzo31","codex 连接不上 Chrome、扩展程序无法重新安装，更换代理节点也无效，有卖家遇到过吗？","有用户反馈，用 codex 处理 Shopify 独立站问题时，Chrome 里的 ChatGPT 扩展程序导致 codex 反复无法连接 Chrome、读取标签页信息。按 codex 建议移除扩展后，从「codex 设置＞电脑操控＞Google chrome 安装」路径跳转 Chrome 应用商店时提示无法找到或购买，按小红书说法更换网络代理节点也未解决，现求助是否有其他人遇到并解决过该问题。",{"_101":501},"2026-09-25T16:00:00.000Z","2026-10-07T11:45:54.283Z",[99,147,100],{"_95":500,"_97":501},[],"阿黄Islander","知无不言","t9tocgypyci6sbbs5k0r2dwxw","星空亚马逊 Agent Codex 插件：串联选品至运营工作流，支持 S5 接入 Amazon Ads API","“星空亚马逊 Agent”Codex 插件将亚马逊运营 Skill 封装为从选品到日常运营的五大板块工作流。其 S5 运营终端支持接入 Amazon Ads API 和 SP-API 数据，提供本地看板诊断与补货参考，但广告调价仍需人工审核确认。作者指出该工具旨在减少第三方 ERP 依赖并提升复盘效率，S6 财务板块及全自动广告闭环目前仅为规划方向。",{"_101":501},"2026-10-07T11:45:55.300Z",[99,147,100],{"_95":514,"_97":501},[510],{"_114":115,"_116":511,"_118":512,"_120":513,"_122":-5,"_123":-5,"_124":-5,"_125":-5},"/amznews-reading-preview/_img/206a364768970b84.webp","/amznews-reading-preview/_img/206a364768970b84.webp","/amznews-reading-preview/_img/206a364768970b84.webp 336w, /amznews-reading-preview/_img/206a364768970b84.webp 720w","跨境者说干货","v1rigkbgaiz8h1yk66i5d4d95","普通卖家分享AI在亚马逊运营中的落地观察：从单点操作转向工作流与客服自动化","一位普通卖家分享AI在亚马逊运营中的落地观察，指出多数用户仍停留在写Listing等单点操作，建议转向广告数据自动处理等工作流。其引用亚马逊2026年6月白皮书称98%中国卖家已用AI，仅16%进入工作流阶段；并强调客服售后因问题重复性高，是AI易见效且常被忽略的场景。",{"_101":501},[99,100],13,{"_95":523,"_97":501},[],"龑302423","k5vgdiwqa6btmyq1q1n07e6sb","AI货架：一场关于产品发现入口的播客讨论","Modern Retail的节目文字导读讨论消费者通过ChatGPT、Claude和Gemini寻找商品，介绍“AI货架”概念，并邀请Spins Foundry的Jessica Wright讨论产品信息如何供AI读取。文中虚构品牌测试是作者转述，效果未经本站独立验证；本页未提供完整播客转录或保证推荐效果的操作步骤。",{"_101":537},"2026-09-26T04:00:00.000Z","2026-09-30T06:02:23.281Z",[99,147,536,380],31,{"_95":534,"_97":535},[],"Gabriela Barkho","modern-retail","品牌","modern-retail · Gabriela Barkho","pdg1rfhcd4iz1g8r26ejfxqjr","作者分享每日向豆包提问以锻炼AI指令能力的经验","原文作者分享通过每天向豆包提不少于10个问题来锻炼AI指令能力的个人实践，强调在AI时代发出有效指令比单纯熟练应用工具更重要。作者认为真正有效的指令需建立在对提问领域的专业洞见之上，建议通过反复追问细节来提升认知并培养使用体感。",{"_101":548},"2026-09-26T16:41:00.000Z","2026-10-04T15:21:34.705Z",[99,147],{"_95":547,"_97":179},[],"跨境电商赢商荟","AMZ123 · 跨境电商赢商荟","xve3enqijcednoz138q523zdt","亚马逊推出全球仓储与分销服务，支持单次入仓覆盖八国","亚马逊宣布推出 Global Warehousing and Distribution (GWD) 服务，允许卖家将一批货物发送至靠近工厂的单一仓库，即可触达美国、英国、日本等八个国家的客户。公司称该服务连接后，存储成本比美国 AWD 低最多 45%，补货至 FBA 的速度快最多五天。此外，亚马逊还推出了针对玩具品类的合规测试简化方案，试点卖家报告合规成本节省最高可达 60%。","原文介绍了亚马逊新推出的全球仓储与分销服务，卖家可单次入仓覆盖八国并降低存储成本。",{"_101":562},"2026-09-27T14:28:24.000Z","2026-10-16T16:16:42.278Z",[99,235,128],71,{"_95":560,"_97":561},[],"Thomas Wasson","FreightWaves","FreightWaves · 亚马逊物流与运输报道","nf8mbo9ip9qal2xh92em945xg","SmartScout 发布亚马逊 Share of Voice 工具评测：SmartScout、Xnurta 等五款工具对比","SmartScout 发布亚马逊 Share of Voice (SOV) 工具评测，将自家产品列为首位并介绍其覆盖超 200 万关键词及 24 个月历史数据的能力。文章对比了 Xnurta、Intentwise、Pacvue 和 DataHawk 四款竞品在自然与广告可见度监测上的差异。该评测指出 SOV 无统一公式，建议用户根据关键词权重、时间周期及站点范围选择合适工具。",{"_101":129},"2026-09-27T16:00:00.000Z",[99,100,576],{"_95":575,"_97":126},[571],{"_114":115,"_116":572,"_118":573,"_120":574,"_122":-5,"_123":-5,"_124":-5,"_125":-5},"/amznews-reading-preview/_img/03d71ebdb467976e.webp","/amznews-reading-preview/_img/03d71ebdb467976e.webp","/amznews-reading-preview/_img/03d71ebdb467976e.webp 336w, /amznews-reading-preview/_img/03d71ebdb467976e.webp 720w","Scott Needham","广告/运营","prr49s61ew404lafwmkj3l5ai","SmartScout 发布亚马逊市场份额工具评测，对比 Jungle Scout 等五款平台","SmartScout 发布文章推荐五款亚马逊市场份额分析工具，并将自家产品列为首选。文中指出 SmartScout 支持自定义细分市场与历史份额查询，Jungle Scout Cobalt 主打企业级基准测试，Stackline、Profitero+ 及 Pacvue 分别侧重跨零售商数据、数字货架执行及零售媒体联动。",{"_101":129},[99,100,127],{"_95":-5,"_97":126},[584],{"_114":115,"_116":585,"_118":586,"_120":587,"_122":-5,"_123":-5,"_124":-5,"_125":-5},"/amznews-reading-preview/_img/475dadb863cdce78.webp","/amznews-reading-preview/_img/475dadb863cdce78.webp","/amznews-reading-preview/_img/475dadb863cdce78.webp 336w, /amznews-reading-preview/_img/475dadb863cdce78.webp 720w","lo2vg4qcs98rbzy1y3ivwjxal","亚马逊广告推出对话式AI分析体验（封闭测试）","亚马逊广告于2026年9月28日发布公告，介绍一项基于自然语言的AI驱动分析体验，广告主可通过提问了解广告活动效果、对比基准并挖掘洞察。该体验将对话式交互与可视化工作区结合，基于亚马逊广告的统一报告功能和第一方购物信号构建，涵盖品牌新客和长期销售归因等指标。原文说明该功能目前处于封闭测试阶段，自行管理广告账户的广告主可通过亚马逊广告代表申请加入，或加入候补名单；适用国家/地区以原文列出的名单为准。原文来自亚马逊广告，存在相关商业利益，并非独立测评。","原文给出了自然语言分析的具体提问示例、适用国家/地区名单，并明确该功能处于封闭测试阶段及申请路径。",{"_101":606},"2026-09-28T00:00:00.000Z","2026-10-22T17:24:11.696Z",[99,576,128,605],{"_95":-5,"_97":604},[598],{"_114":599,"_116":600,"_601":602,"_120":603,"_122":-5,"_123":-5,"_124":-5,"_125":600},"video","/amznews-reading-preview/_img/df5ff0131c11440d.webp","originalUrl","https://advertising.amazon.com/resources/whats-new/analytics/","/amznews-reading-preview/_img/df5ff0131c11440d.webp 336w, /amznews-reading-preview/_img/df5ff0131c11440d.webp 720w","亚马逊广告","Amazon Ads","亚马逊广告 · 产品更新","ne5a0uoqdhzb49xv3i4lv2qbc","亚马逊推出免费多渠道管理工具及多项AI功能","亚马逊在2026年Accelerate大会上宣布推出新的多渠道销售工具和一系列AI功能。新工具允许美国卖家在Seller Central中免费集中管理eBay、Shopify等平台的商品、订单和利润数据。",{"_101":288},"2026-09-28T02:16:58.000Z","2026-09-30T10:06:34.392Z",[99,128,234,254],{"_95":287,"_97":179},[616],{"_114":115,"_116":617,"_118":618,"_120":619,"_122":-5,"_123":-5,"_124":-5,"_125":-5},"/amznews-reading-preview/_img/21acd10fe7e28a57.webp","/amznews-reading-preview/_img/21acd10fe7e28a57.webp","/amznews-reading-preview/_img/21acd10fe7e28a57.webp 336w, /amznews-reading-preview/_img/21acd10fe7e28a57.webp 720w","va73enkr74u1j9jholmnic4t0","Threecolts 提出区分有效 AI Agent 的三项标准并介绍 AI Operator","Threecolts 提出通过实时数据访问、系统内执行权限及清晰操作记录这三项标准，来区分真正能完成任务的 AI Agent 与仅仅提供建议的工具。文章指出许多自称 Agent 的产品实为聊天界面，并建议卖家通过让工具独立执行如重新定价等任务来验证其能力。",{"_101":102},"2026-09-28T10:29:27.000Z","2026-10-16T16:16:42.313Z",[99,100],{"_95":96,"_97":98},[],"xsvwtc3whiucm71g019l0efvo","Data Dive 推出 MCP 连接 Claude 和 ChatGPT","原文来自 Data Dive 官方渠道，推广其自有 MCP 功能，存在相关商业利益，并非独立测评。该功能面向 Standard 和 Enterprise 计划用户，可将账户研究数据接入 Claude、ChatGPT 等支持自定义 MCP 连接器的 AI 工具。原文称设置约需一分钟，AI 在执行操作前会请求确认；写入权限为可选，需用户单独授予。原文还提到 ChatGPT 端存在限制：完整 MCP 支持（含写入工具）在 Business、Enterprise 和 Edu 计划上处于测试阶段，Pro 用户可在开发者模式下连接但仅限读取工具，自定义 MCP 应用不支持移动端，且仅管理员或所有者可开启开发者模式或发布应用。",{"_101":647},"2026-09-28T11:44:05.000Z","2026-10-11T16:17:09.224Z",[99,100,128],30,{"_95":645,"_97":646},[639],{"_114":115,"_116":640,"_118":641,"_120":642,"_122":643,"_123":644,"_124":-5,"_125":-5},"/amznews-reading-preview/_img/fba8cf7c83f02aa6.webp","/amznews-reading-preview/_img/fba8cf7c83f02aa6.webp","/amznews-reading-preview/_img/fba8cf7c83f02aa6.webp 336w, /amznews-reading-preview/_img/fba8cf7c83f02aa6.webp 720w",1024,542,"newsletter","Data Dive","Data Dive · 亚马逊数据与卖家工具","tf5g8iocsfk6iwntbu7d2g3q9","AI 会让人变笨吗？卖家如何在使用 AI 的同时保住核心判断力","AI 会让人变笨吗？答案不是回避工具，而是\"保留音阶\"：永远不要接受一个你自己最终无法得出的答案。作者用爵士乐与行进乐队的比喻说明，AI 擅长执行\"行进式\"的重复工作，交回的是需要人来判断的\"爵士乐\"——比如判断销量激增是真实需求还是单笔大单、是否信任供应商给出的日期。他建议先自己动手把分析做几遍，直到知道好的分析是什么样，再把乐谱交给机器。",{"_101":464},"2026-09-28T13:30:00.000Z","2026-10-01T18:12:22.188Z",[99,147,380],{"_95":463,"_97":464},[],"p45w5hwev70h264q1k1je28ys","我们公司美工组开始转运营了，说说 AI 出图到底改了什么","一家以亚马逊为主的家居百货公司今年把低频新品前期测试的出图流程改为：工厂按一页纸要求用手机拍照，采购录入卖点和成本价后直接转运营组，由运营用公司统一采购的 AI 出图工具一次生成主副图、A+ 图和文案，初稿约十分钟，默认一套八张主副图加四张 A+。",{"_101":501},"2026-09-28T16:00:00.000Z","2026-10-07T11:45:53.205Z",[99,147,180,128,536],36,{"_95":671,"_97":501},[667],{"_114":115,"_116":668,"_118":669,"_120":670,"_122":-5,"_123":-5,"_124":-5,"_125":-5},"/amznews-reading-preview/_img/990b180ed32f4a1d.webp","/amznews-reading-preview/_img/990b180ed32f4a1d.webp","/amznews-reading-preview/_img/990b180ed32f4a1d.webp 336w, /amznews-reading-preview/_img/990b180ed32f4a1d.webp 720w","sabinaa","w3w8c1ua5f9ajjxh0o3godf56","选品、广告、关键词数据从哪来？亚马逊卖家的数据 MCP 选型指南：卖家精灵、Sif、Sorftime 对比（附提示词和教程）","AI+商业实践者、一线跨境卖家 Bulus lan 分享了自己在业务环境中调用卖家精灵、Sif、Sorftime 三家数据 MCP 的个人使用体验，并整理了选品、关键词、买家需求分析等场景的提示词与 MCP 配置教程。原文来自该机构，存在相关商业利益，并非独立测评。文中对三家 MCP 的能力描述均为作者个人使用感受，未提供独立验证或可核验出处，不能作为选型或投放依据。",{"_101":