":-5,"_106":-5,"_108":-5,"_109":-5},"/amznews-reading-preview/_img/df4d833c10551f9d.webp","/amznews-reading-preview/_img/df4d833c10551f9d.webp","/amznews-reading-preview/_img/df4d833c10551f9d.webp 336w, /amznews-reading-preview/_img/df4d833c10551f9d.webp 720w","Regan跨境","AMZ123","关键词","AMZ123 · Regan跨境","g16nwikmogkdwwvpcw8l2geco","品牌需先传视频方可启用达人","一旦品牌在商品详情页上传了自己的视频，亚马逊达人就可以添加他们的视频。\n\n他们根据品类不同，每笔销售可获得约 1-5% 的佣金，因此有动力让产品看起来更好。\n\n大多数品牌尚未上传这第一个视频，这意味着其他人也无法上传。",{"_117":361},"2026-10-16T18:56:04.000Z","2026-10-17T16:14:18.077Z",[114,153,171],[],{"_266":356,"_268":357,"_270":358,"_272":359,"_92":415,"_275":-5},[],"y0rju0dkoe9sppzwy3f06ld58","亚马逊连续下架卖家核心链接","连续第二个周五，亚马逊下架了我的核心商品详情页。哈哈。感觉像是被故意逼着停业。",{"_117":430},"2026-10-16T19:18:18.000Z","2026-10-17T15:42:20.372Z",[204,171],[],{"_266":425,"_268":426,"_270":427,"_272":428,"_92":429,"_275":-5},"Michael Patrón","michaelpatron0","/amznews-reading-preview/_img/missing.svg","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w",[],"X · Michael Patrón","fhgtftmp6vn12k8vtuk1e8qb5","亚马逊统一广告平台为Ads Agent，作者解析其变化与不变之处","亚马逊在unBoxed 2026全球大会上宣布将Ads Console与Amazon DSP整合为统一的Amazon Ads Agent（亚马逊 AI 广告平台）。作者指出该平台带来三大变化：支持自然语言描述需求以简化操作、实现跨广告形式协同（如DVA+和全流域广告活动）、以及将AI创意生成与数据分析纳入工作流；同时强调原有手动控制权保留、广告效率提升不等于利润增加、产品核心竞争力仍是关键。",{"_117":446},"2026-10-16T19:47:00.000Z","2026-10-19T01:48:38.356Z",[114,294,171,319],60,{"_110":445,"_112":403},[441],{"_96":97,"_98":442,"_100":443,"_102":444,"_104":-5,"_106":-5,"_108":-5,"_109":-5},"/amznews-reading-preview/_img/4a89627bf301342f.webp","/amznews-reading-preview/_img/4a89627bf301342f.webp","/amznews-reading-preview/_img/4a89627bf301342f.webp 336w, /amznews-reading-preview/_img/4a89627bf301342f.webp 720w","跨境电商MoonSees","AMZ123 · 跨境电商MoonSees","xd1fyisoaix3f6dr7jqlkulxk","亚马逊卖家应对行情下行：小卖家守老品与大卖家换赛道均难对冲大势，建议精细化运营与控投入","一汤指出，在整体行情下行时，小卖家“守老品”与大卖家“换赛道”均难以有效对冲市场萎缩。作者建议卖家优先确认基本盘盈利状况，通过精细化调整广告、SKU及FBA费用来守住利润，并在不影响现金流的前提下用小成本试错新工具或方向。",{"_117":461},"2026-10-16T20:01:00.000Z","2026-10-19T02:04:35.330Z",[114,171,188],{"_110":460,"_112":403},[456],{"_96":97,"_98":457,"_100":458,"_102":459,"_104":-5,"_106":-5,"_108":-5,"_109":-5},"/amznews-reading-preview/_img/6bb8d8e6bc011816.webp","/amznews-reading-preview/_img/6bb8d8e6bc011816.webp","/amznews-reading-preview/_img/6bb8d8e6bc011816.webp 336w, /amznews-reading-preview/_img/6bb8d8e6bc011816.webp 720w","一汤说","AMZ123 · 一汤说","dr7rcr7pgahmllul4mr3kj47v","亚马逊卖家需检查无标签入库货","我们仓库收到的一些货物完全没有标签。空瓶子，直接来自制造商。\n\n这仅占我们采购量的极小比例，但确实会发生，且这些货物都无法发往亚马逊。\n\n在发往 FBA 前务必检查每一批入库货物，并在 30 天内向供应商标记此问题。",{"_117":361},"2026-10-16T22:08:06.000Z","2026-10-17T16:14:18.068Z",[188,239,473,171],20,[],{"_266":356,"_268":357,"_270":358,"_272":359,"_92":472,"_275":-5},[],"供应链","r1p8tvfzf6ufpg74q317y8rpd","亚马逊大件商品慎用FBA","FBA 并不总是正确的选择，任何告诉你相反情况的人都是在向你推销。\n\n如果你运输的是大型、笨重或沉重的产品，FBA 费用会吞噬你的利润。入库运费、仓储费、AWD，这些在大件商品上迅速累积。\n\n选择 FBA 的理由（Prime 标识、购物车优势、更快的配送、规模化下的更低单位成本）都假设是正常尺寸的产品以正常销量流转。\n\n笨重和超大尺寸是例外。\n\n在选择物流策略之前，先弄清楚你属于哪一类！",{"_117":488},"2026-10-17T00:30:00.000Z","2026-10-17T15:58:17.523Z",[188,239],[],{"_266":483,"_268":484,"_270":485,"_272":486,"_92":487,"_275":-5},"Evan Swanson","Evan_Swanson_","/amznews-reading-preview/_img/missing.svg","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w",[],"X · Evan Swanson","xtbakk5vl602pltqv55uzmkf5","亚马逊对NWD品牌实施销售限制，卖家需在10月27日前处理库存或获取授权","亚马逊向部分卖家发出通知，因涉及NWD（无批发分销）品牌且未获授权，相关商品将于2026年10月27日被强制移除。文章指出，若卖家无法获得品牌方在后台添加的“授权转销商”角色，必须在截止日前成功提交FBA库存移除订单，否则库存将被直接处置且费用由卖家承担。自2026年5月1日起，移除费用已改为按单件直接扣取，精铺卖家需提前核算多SKU同时触发限制的成本。","原文梳理了NWD品牌限制的背景与应对路径，明确了10月27日提交移除订单的关键节点及费用风险。",{"_117":505},"2026-10-17T01:30:00.000Z","2026-10-19T02:19:35.469Z",[204,171,188,153],75,{"_110":504,"_112":403},[500],{"_96":97,"_98":501,"_100":502,"_102":503,"_104":-5,"_106":-5,"_108":-5,"_109":-5},"/amznews-reading-preview/_img/2a6e484a0eabec77.webp","/amznews-reading-preview/_img/2a6e484a0eabec77.webp","/amznews-reading-preview/_img/2a6e484a0eabec77.webp 336w, /amznews-reading-p