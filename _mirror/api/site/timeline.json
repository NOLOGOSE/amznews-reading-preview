l,"alt":null,"poster":null}],"x":null},"group":null},{"key":"s408","anchorAt":"2026-10-20T02:37:38.073Z","item":{"id":"zx1i3z931v0f7cgd3t4wr0dni","title":"亚马逊宣布 11 月起欧洲站物流附加费上调至 2%","summary":"亚马逊宣布将欧洲多个市场的燃油及物流附加费从 1.5% 上调至 2%，FBA 订单自 11 月 2 日起生效，MCF 业务自 11 月 19 日起覆盖。新费率按配送费用计算，预计使欧洲站 FBA 卖家每件商品平均增加约 0.02 欧元成本，英国站约为 0.02 英镑。亚马逊已更新 Seller Central 中的多项经营工具以纳入新费用，并强调该附加费将根据后续市场情况持续评估。","reason":"原文给出了欧洲站物流附加费上调的生效日期、适用市场及平均成本增幅，卖家可据此核算利润。","source":{"name":"AMZ123 · SUMMER"},"publishedAt":"2026-10-20T00:00:00.000Z","collectedAt":"2026-10-20T02:37:38.073Z","timelineAt":"2026-10-20T02:37:38.073Z","category":"policy","tags":["费用变更","FBA/物流","亚马逊"],"score":72,"selected":true,"channel":"news","byline":{"author":"Summer","platform":"AMZ123"},"media":[{"kind":"image","url":"/amznews-reading-preview/_img/5303ec716f4c025e.webp","fullUrl":"/amznews-reading-preview/_img/5303ec716f4c025e.webp","srcSet":"/amznews-reading-preview/_img/5303ec716f4c025e.webp 336w, /amznews-reading-preview/_img/5303ec716f4c025e.webp 720w","width":null,"height":null,"alt":null,"poster":null}],"x":null},"group":{"factId":"fc5buGKM2v34","story":{"publicId":"bc6e2a21-a35f-4fb5-bd3e-84734e57c3d2","title":"亚马逊欧洲站燃油及物流附加费上调至2%"},"additionalSourceCount":2,"reportCount":3,"developmentCount":1,"latestDevelopment":null}},{"key":"s399","anchorAt":"2026-10-19T18:56:39.954Z","item":{"id":"u4bevyxysqo86v2eybjd132qh","title":"亚马逊规定2026年12月18日起多数美国FBM订单需预付退货标签","summary":"亚马逊宣布自2026年12月18日起，美国站大多数卖家自发货（FBM）订单的退货将强制要求提供预付退货标签。卖家须在收到退货请求后的7个日历日内通过“管理卖家自发货退货”上传标签或全额退款且不要求退回商品；若未执行，亚马逊可能自动发放无需退货的退款并从卖家账户扣除相应金额。重型和大件物品暂时豁免此规定，且不在亚马逊退货工作流内发送的标签无效。","reason":"原文明确了FBM卖家处理退货的新规生效日期、7天时限及未合规时的自动退款扣款后果，有助于卖家提前调整运营流程。","source":{"name":"X · ASGTG"},"publishedAt":"2026-10-19T18:36:08.000Z","collectedAt":"2026-10-19T18:56:39.954Z","timelineAt":"2026-10-19T18:56:39.954Z","category":"policy","tags":["政策/合规","FBA/物流","亚马逊"],"score":80,"selected":true,"channel":"x","byline":null,"media":[],"x":{"authorName":"Amazon Sellers ASGTG","han