7":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103,"_109":137},{"_93":140,"_27":141,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103,"_109":137},{"_93":138,"_27":139,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103,"_109":137},{"_93":127,"_27":128,"_96":129,"_97":130,"_99":131,"_100":132,"_101":133,"_118":134,"_102":103,"_104":105,"_106":135,"_107":136,"_108":122,"_109":137},{"_93":124,"_27":125,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103,"_109":126},{"_93":111,"_27":112,"_96":113,"_97":114,"_99":115,"_100":116,"_101":117,"_118":119,"_102":103,"_104":105,"_106":120,"_107":121,"_108":122,"_109":123},{"_93":94,"_27":95,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103,"_109":110},"itemId","dstqzjcofszwh4k30x61fo965","受欧盟新规影响 SpeedPAK调整发往欧盟27国预收欧盟处理费保证金","summary","sourceName","","sourceUrl","sourceId","sourceIconUrl","firstParty",false,"role","媒体","storyPublicId","publishedAt","available","label","FBA 与物流","i6hnhpokxg74kva9wqgwz0v5h","Marketplace Pulse发布2026年TikTok Shop美国站趋势报告：头部卖家销售额占比59%","Marketplace Pulse发布《2026年TikTok Shop美国站趋势报告》，基于截至2026年9月的追踪数据显示，TikTok Shop美国站前1%的卖家贡献了59%的销售额，美妆、服饰和健康类商品占据主导。","AMZ123 · 跨境头条","https://www.amz123.com/t/YSHma6vp","publisher-amz123-headlines","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","sourceIconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w","91b88b79-6333-4d0a-ac5c-b79c345f35e7","2026-10-16T02:07:00.000Z",true,"选品与市场","tovzae92ui3abyrrbkel3pchx","亚马逊前台商品详情页新增AI产品信息摘要","广告与运营","f4513cozfjb0armou6wyn9u9d","同名商标跨站点备案遇阻时如何通过关联商标完成亚马逊品牌注册","卖家 wang厌倦 分享同名商标跨站点备案被提示“品牌已被注册”时的解决方法，即利用已备案主站点商标的“添加关联商标”功能纳入其他站点同名商标。操作路径为进入品牌注册后台的管理知识产权页面选择关联商标，输入序列号后等待3-5个工作日接收验证码完成认证。作者提醒备案品牌名须与证书完全一致，产品图严禁PS或贴纸，发票需为6个月内真实发票且体现品牌名。","知无不言","https://www.wearesellers.com/question/125496","author-wearesellers-public-latest","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w","5deebe7f-e080-4013-a9d9-950a3dfe1997","2026-10-16T02:17:15.555Z","政策与公告","fs1fajfww89nr997v8ubcuvsm","英国拟要求Amazon、eBay、Temu为年销超9万英镑卖家代扣增值税","oft52sq8z3v10nep0rv3xvjhw","美国法院收紧跨境电商TRO批量诉讼规则","hnrat8cou0au5lsdlqk239xuf","亚马逊品牌主实时支持上线5项能力升级","ou0b7ohs3cfqtv7e3x460imev","亚马逊英德站10月15日起实施旺季配送费调整","亚马逊宣布自2026年10月15日至2027年1月14日对英国和德国站部分FBA订单加收节日旺季配送费。英国站符合条件的小型及标准包裹平均每件增加约£0.12，德国站对应商品平均每件增加约€0.27，且适用的1.5%燃油及物流相关附加费会叠加于该费用之上。文章指出卖家在备货黑五圣诞季时，除关注配送费外，还需综合核对促销活动固定及浮动收费、广告投入变化以及库存周转带来的潜在成本影响。","雨果跨境 · 亚马逊频道最新","https://www.cifnews.com/article/189482","publisher-cifnews-amazon","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 48w, /amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 96w","89a51c14-74a4-478a-82d2-14619dc7576f","2026-10-16T09:50:13.000Z","x78bmw0cv7204cphxn6tfvo06","多地跨境卖家收到税务风险提示 需核对平台报送与申报收入差异","lnyxawbnv0z6iah0e1ald8lbk","亚马逊发布NWD下架令，10月27日强制移除无品牌代表授权Listing","emho1jb8iwpip35wvgb30h64g","亚马逊欧洲站 7 类商品须符合欧盟零毁林法规（EUDR）",{"_109":137,"_96":-5,"_164":171},{"_109":126,"_96":-5,"_164":169},{"_109":123,"_96":-5,"_164":167},{"_109":110,"_96":-5,"_164":165},"items",[166],{"_93":94,"_27":95,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103},[168],{"_93":111,"_27":112,"_96":113,"_97":114,"_99":115,"_100":116,"_101":117,"_118":119,"_102":103,"_104":105,"_106":120,"_107":121,"_108":122},[170],{"_93":124,"_27":125,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103},[172,173,174,175,176,177,178,179],{"_93":158,"_27":159,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103},{"_93":156,"_27":157,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103},{"_93":154,"_27":155,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103},{"_93":144,"_27":145,"_96":146,"_97":147,"_99":148,"_100":149,"_101":150,"_118":151,"_102":103,"_104":105,"_106":152,"_107":153,"_108":122},{"_93":142,"_27":143,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103},{"_93":140,"_27":141,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103},{"_93":138,"_27":139,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103},{"_93":127,"_27":128,"_96":129,"_97":130,"_99":131,"_100":132,"_101":133,"_118":134,"_102":103,"_104":105,"_106":135,"_107":136,"_108":122},{"_93":158,"_27":159,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103,"_109":137},{"_93":156,"_27":157,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103,"_109":137},{"_93":154,"_27":155,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103,"_109":137},{"_93":144,"_27":145,"_96":146,"_97":147,"_99":148,"_100":149,"_101":150,"_118":151,"_102":103,"_104":105,"_106":152,"_107":153,"_108":122,"_109":137},{"_93":142,"_27":143,"_96":-5,"_97":98,"_99":98,"_100":-5,"_101":-5,"_102":103,"_104":105,"_106":-5,"_107":-5,"_108":103,"_109":137},"leadParagraph","亚马逊通知卖家，2026年10月27日将从Amazon.com移除被判定为NWD（无批发分销）模式且未绑定“品牌代表”角色的商品Listing。未获官方授权的卖家需在截止前提交FBA库存移除订单，避免库存被弃置；有授权但被系统误判的卖家需联系品牌方在Brand Registry后台配置角色并开Case申诉。",{"_188":189},"changelogVersion","2026-10-09T22:08"]
