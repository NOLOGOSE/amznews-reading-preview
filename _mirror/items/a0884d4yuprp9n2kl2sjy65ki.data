[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","a0884d4yuprp9n2kl2sjy65ki","revision",7,"title","SellerApp 报告：亚马逊 DSP 广告支出占比升至 23.4%，需调整 ROI 衡量指标","originalTitle","Amazon DSP ROI: How Enterprise Brands Measure Advertising Impact","summary","SellerApp 发布《2026 年亚马逊广告现状》报告，基于超 30 亿美元管理广告支出数据显示，DSP 在亚马逊总广告支出中的占比从 17.7% 增至 23.4%。该机构自报调查指出，超过三分之一的 DSP 归因购买来自品牌新客，但传统 ACoS 和最后点击归因往往低估其获客价值。卖家应结合新客获取率等指标，而非仅依赖 ACoS 来评估 DSP 对长期增长的贡献。","reason","source",{"_9":103,"_104":105,"_73":106,"_107":39,"_108":-5},"links",{"_100":101,"_65":102},"publishedAt","2026-08-29T11:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-09-30T06:02:31.887Z","timelineAt","category","advertising","tags",[97,98,99],"score",29,"selected",false,"channel","news","story","x","media",[68,69,70,71,72],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Nithin Mentreddy","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","sellerapp",{"_73":74,"_75":94,"_77":95,"_79":96,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":91,"_77":92,"_79":93,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":88,"_77":89,"_79":90,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":85,"_77":86,"_79":87,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/142202b243f75f3c.webp","fullUrl","/amznews-reading-preview/_img/142202b243f75f3c.webp","srcSet","/amznews-reading-preview/_img/142202b243f75f3c.webp 336w, /amznews-reading-previ