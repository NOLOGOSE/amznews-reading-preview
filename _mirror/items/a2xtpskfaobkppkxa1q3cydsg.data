[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","a2xtpskfaobkppkxa1q3cydsg","revision",2,"title","越南延长对中国聚酯长丝纱线反倾销税至2031年，最高税率17.45%","originalTitle","主义！越南对我国聚酯长丝纱线反倾销税再延五年，最高档17.45%","summary","越南工贸部发布决定，自2026年10月16日起继续对原产于中国等地的聚酯长丝纱线征收反倾销税，有效期五年。中国涉案产品税率为3.36%至17.45%，未列名生产商按最高档17.45%执行。该措施系日落复审肯定性终裁，维持原有税率档位，旨在防止倾销与产业损害再度发生。","reason","source",{"_9":121,"_122":123,"_89":124,"_125":40,"_126":127,"_128":129},"links",{"_118":119,"_68":120},"publishedAt","2026-10-19T01:37:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-20T01:59:39.345Z","timelineAt","category","policy","tags",[116,117],"score",38,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","物流巴巴","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fmejrDE6FZ4o",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","9c1de3b3-543f-4dca-afce-511f8a572092","越南延长对华聚酯长丝纱线反倾销税至2031年",{"_77":78,"_13":79},"platform","AMZ123",{"_89":90,"_91":113,"_93":114,"_95":115,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":110,"_93":111,"_95":112,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":107,"_93":108,"_95":109,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":104,"_93":105,"_95":106,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":101,"_93":102,"_95":103,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":92,"_93":94,"_95"