[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","a3wda6izyiftsjkswpy30upxm","revision",3,"title","美国站儿童解压玩具因商品和食品安全违规下架，已做TIC验证的卖家如何申诉？","originalTitle","美国站儿童玩具突然因商品和食品安全违规行为下架，但去年已经TIC 验证了，有人成功申诉吗","summary","有卖家反映美国站一款解压玩具ASIN突然变狗，健康状况显示商品和食品安全违规行为，绩效通知要求商品详情页（PDP）提交的年龄组须与亚马逊核准的TIC实验室测试报告注明的年龄组相符，但未指出具体哪个年龄字段不一致。申诉界面提示需提供撤销停用原因说明及发票、收据、订单或邮件等证据。该卖家去年已完成TIC验证，询问应递交TIC检测报告还是从其他方向申诉，并寻求有类似case的卖家分享恢复方法。","reason","source",{"_9":91,"_92":67,"_70":93,"_94":39,"_95":96,"_97":98},"links",{"_88":89,"_65":90},"publishedAt","2026-09-16T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T12:46:21.785Z","timelineAt","category","policy","tags",[85,86,87],"score",31,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","linlinlin2024","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_70":71,"_72":82,"_74":83,"_76":84,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/0c147234f6555135.webp","fullUrl","/amznews-reading-preview/_img/0c147234f6555135.webp","srcSet","/amznews-reading-preview/_img/0c147234f6555135.webp 336w, /amznews-reading-preview/_img/0c147234f6555135.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/f12a7d72db99a296.webp","/amznews-reading-preview/_img/f12a7d72db99a296.webp","/amznews-reading-preview/_img/f12a7d72db99a296.webp 336w, /amznews-reading-preview/_img/f12a