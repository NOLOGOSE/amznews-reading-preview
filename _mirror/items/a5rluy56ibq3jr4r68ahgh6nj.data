[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","a5rluy56ibq3jr4r68ahgh6nj","revision",1,"title","Market.us报告：创作者经济规模与联盟佣金数据","originalTitle","92 consumers trust Influencer Recommendations","summary","原文引述Market.us《创作者经济市场报告（2026）》称，全球创作者经济2024年估值1494亿美元，预计2034年达1.0728万亿美元；联盟营销占创作者变现比例从2019年的12.2%微增至2024年的12.5%，联盟与直播购物佣金通常为产品价值的5–10%。原文另称92%消费者更信任网红推荐而非传统广告，但未说明调查方法、样本范围，本站尚未独立核验该引用。原文来自推广该报告的机构，存在相关商业利益，并非独立测评。","reason","source",{"_9":98,"_99":100,"_81":101,"_102":39,"_103":-5},"links",{"_95":96,"_66":97},"publishedAt","2026-09-07T01:37:19.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:42:17.619Z","timelineAt","category","advertising","tags",[93,94],"score",28,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Rambler_Amz","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>92 consumers trust Influencer Recommendations</p><p>Recent data from http://Market.us's Creator Economy Market report (2026) shows how far affiliate marketing has come:<br> <br>→ The global creator economy is valued at $149.4B in 2024 and projected to hit $1,072.8B by 2034 (21.8% CAGR)</p><p>→ Affiliate marketing's share of creator monetization has grown from 12.2% (2019) to 12.5% (2024)</p><p>→ Affiliate and live-shopping commissions now typically run 5–10% of product value</p><p>→ Creators using integrated storefronts see earnings jump by ~18%</p><p>→ 92% of consumers say 