[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","a6fom67rc4z4cxay408myhqdh","revision",2,"title","亚马逊生鲜销量激增抢占超市份额","originalTitle","Amazon takes food market share from supermarkets as its sales of fresh seafood, produce, and dairy jump after same-day expansion","summary","据 NielsenIQ 数据，亚马逊通过扩大生鲜同日达服务，在截至今年8月下旬期间从传统超市手中夺取美国食品市场份额。其海鲜、乳制品和农产品销量在6月至8月间增长数倍。购买者多为高收入年长用户，NielsenIQ 认为此举旨在提升其在亚马逊平台的购物频率。","reason","source",{"_9":102,"_103":104,"_83":105,"_106":39,"_107":108,"_109":110},"links",{"_99":100,"_67":101},"publishedAt","2026-10-22T20:59:42.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T21:35:26.390Z","timelineAt","category","product","tags",[97,98],"score",40,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Paul Drecksler","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fUmuaiqTbU_I",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","c527b1b1-d11f-4858-919b-bb71d2c4d18e","亚马逊生鲜同日达扩围 抢占美国超市份额",{"_76":77,"_13":78},"platform","Shopifreaks",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/1fdfff48bcd608dc.webp","fullUrl","/amznews-reading-preview/_img/1fdfff48bcd608dc.webp","srcSet","/amznews-reading-preview/_img/1fdfff48bcd608dc.webp 336w, /amznews-reading-preview/_img/1fdfff48bcd608dc.webp 720w","width",1067,"height",800,"al