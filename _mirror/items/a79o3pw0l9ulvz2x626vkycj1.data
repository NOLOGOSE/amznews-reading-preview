[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","a79o3pw0l9ulvz2x626vkycj1","revision",7,"title","亚马逊卖家需应对 Alexa for Shopping、ChatGPT 与 Perplexity 三大 AI 平台对商品可见性的影响","originalTitle","Your Listings Are Invisible to a Million Amazon LLM Search Shoppers, and Your Competitors Know It","summary","原文作者（来自 SellerApp，存在相关商业利益，并非独立测评）讨论 Alexa for Shopping、ChatGPT 和 Perplexity 在购物旅程不同阶段以不同机制影响亚马逊商品可见性，并给出分平台的 Listing 与站外内容优化框架。文中引用 Adobe 对 5,000 名美国消费者的调查称 53% 在购物中使用 AI，并称 Rufus 在 2024 年底日均处理 2.74 亿查询、2025 年有 3 亿以上客户使用；本站尚未独立核验这些引用。作者称 ChatGPT 因亚马逊封锁爬虫而依赖站外内容，仅靠亚马逊 Listing 且无 DTC、无 Reddit 提及、无编辑报道的卖家对其不可见；该结论为作者观点，限于 ChatGPT 平台。原文提及亚马逊诉 Perplexity 案尚未解决。","reason","source",{"_9":96,"_97":98,"_71":99,"_100":39,"_101":-5},"links",{"_93":94,"_65":95},"publishedAt","2026-08-19T11:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-09-30T06:33:30.667Z","timelineAt","category","advertising","tags",[89,90,91,92],"score",48,"selected",false,"channel","news","story","x","media",[68,69,70],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Dilip","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","sellerapp",{"_71":72,"_73":86,"_75":87,"_77":88,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":83,"_75":84,"_77":85,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":-5,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/7c614277b7c27783.webp","fullUrl","/amznews-reading-preview/_img/7c614277b7c27783.webp","srcSet","/amznews-reading-preview/