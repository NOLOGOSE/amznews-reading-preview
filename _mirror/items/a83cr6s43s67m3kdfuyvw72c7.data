[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","a83cr6s43s67m3kdfuyvw72c7","revision",1,"title","欧盟3欧元小额包裹税及部分成员国附加处理费","originalTitle","EU Small Parcel Levy and National Handling Fees","summary","原文介绍，欧盟自2026年7月1日起对低值进口包裹征收每件3欧元的小额包裹税，该措施为临时安排，计划持续至2028年海关改革生效。法国、意大利、罗马尼亚等国在此基础上另收本国费用；原文称法国按包裹内每个HS6编码收2欧元，且需通过法国VAT数字系统缴纳，因此卖家须取得法国VAT注册。原文同时表示，该注册是否需定期申报VAT尚无法确认。原文来自VAT合规服务机构SimplyVAT，存在相关商业利益，并非独立测评。","reason","原文梳理了欧盟小额包裹税及部分成员国附加费的生效状态与征收逻辑，并提示法国按HS6编码计费、需本地VAT注册这一合规门槛，同时保留申报义务尚不明确的说明。","source",{"_9":75,"_76":77,"_78":79,"_80":64,"_81":82,"_83":84},"links",{"_72":73,"_66":74},"publishedAt","2026-09-14T15:13:22.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T18:36:26.896Z","timelineAt","category","policy","tags",[69,70,71],"score",72,"selected",true,"channel","news","story","x","media",[],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","Jenny Budd","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","SimplyVAT","政策/合规","FBA/物流","亚马逊","aihot","/items/a83cr6s43s67m3kdfuyvw72c7","https://simplyvat.com/blog/small-parcel-levy/","publisher-simplyvat-blog","name","SimplyVAT · 国际 VAT 与跨境平台合规","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/7b583a80b7d3d834.webp","iconSrcSet","/amznews-reading-preview/_img/7b583a80b7d3d834.webp 48w, /amznews-reading-preview/_img/7b583a80b7d3d834.webp 96w",{"_86":87},"changelogVersion","2026-10-09T22:08"]
