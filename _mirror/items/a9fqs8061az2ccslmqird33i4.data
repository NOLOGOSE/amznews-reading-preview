[{"_1":2,"_3":4},"root",{"_5":124},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","a9fqs8061az2ccslmqird33i4","revision",1,"title","亚马逊发布首份《可信购物体验报告》详解AI防护体系","originalTitle","Inside the AI systems Amazon uses to protect every part of your shopping experience","summary","亚马逊发布首份《可信购物体验报告》，披露其利用 AI 系统保护客户、品牌及卖家。自 2020 年以来，Counterfeit Crimes Unit 已在 14 个国家追究逾 3.2 万名不良行为者；2025 年法律行动关闭超 100 个假评论网站。新推出的 SENTRIX AI 技术使钓鱼网址移除成功率提升逾 10%，早期预警系统曾提前 8 天拦截侵权 Listing。","reason","source",{"_9":115,"_116":117,"_74":118,"_119":60,"_120":121,"_122":123},"links",{"_112":113,"_64":114},"publishedAt","2026-04-22T04:00:06.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:14:06.431Z","timelineAt","category","policy","tags",[110,111],"score",22,"selected",false,"channel","news","story","x","media",[67,68,69,70,71,72,73],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","About Amazon",{"_74":75,"_76":105,"_78":106,"_80":107,"_82":108,"_84":109,"_86":-5,"_87":-5},{"_74":75,"_76":102,"_78":103,"_80":104,"_82":-5,"_84":-5,"_86":-5,"_87":-5},{"_74":75,"_76":99,"_78":100,"_80":101,"_82":91,"_84":92,"_86":-5,"_87":-5},{"_74":75,"_76":96,"_78":97,"_80":98,"_82":83,"_84":85,"_86":-5,"_87":-5},{"_74":75,"_76":93,"_78":94,"_80":95,"_82":83,"_84":85,"_86":-5,"_87":-5},{"_74":75,"_76":88,"_78":89,"_80":90,"_82":91,"_84":92,"_86":-5,"_87":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":-5,"_87":-5},"kind","image","url","/amznews-reading-preview/_img/8fd24dc30c7859f1.webp","fu