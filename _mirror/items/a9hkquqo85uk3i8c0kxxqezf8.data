[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","a9hkquqo85uk3i8c0kxxqezf8","revision",2,"title","亚马逊卖家账号转发卖家对平台退货与费用的批评","originalTitle","#WorkWithUsAmazon @BowTiedBroke is a legend","summary","亚马逊卖家账号AmazonASGTG转发@BowTiedBroke的帖文，称其为“传奇”。被转发帖文作者自述在亚马逊销售15年，认为这可能是最后一年，并批评平台在退货纠纷中偏向买家、费用高企（包括低库存费），以及小卖家面临竞争压力；这些均为该卖家的个人说法，本站尚未独立核验。","reason","source",{"_9":107,"_108":109,"_110":111,"_112":39,"_113":-5},"links",{"_104":105,"_68":106},"publishedAt","2026-10-20T18:02:23.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-20T18:11:41.348Z","timelineAt","category","policy","tags",[101,102,103],"score",18,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":93,"_45":94},"media",[],"byline","detailedGuide","readingMode","full","author","AmazonASGTG","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fuTs0AKRSQio",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","80c63447-ef3a-4a6e-9e08-3b1202f95582","亚马逊卖家转发批评平台退货与费用",{"_77":78,"_13":79},"zh","<p>#WorkWithUsAmazon  @BowTiedBroke is a legend</p>","zhKind","complete","authorName","Amazon Sellers ASGTG","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_85":95,"_87":95,"_96":97,"_98":99,"_100":-5},[],"BowTiedBroke","text","After 15 yrs, I think this will be my last year selling on Amazon. It has now become a DEN OF THIEVES. Buyers purchase an expensive item, receive it, claim it's damaged, return it (but what the buyer returns is usually some broken junk they had laying around their house, while they keep what was in the box they received). Amazon issues a refund to the buyer and the seller can be out thousands of dollars. And Amazon ALWAYS sides with the buyer, rarely the seller.  \n\nIt is also now overrun by Chinese sellers hijacking small mom & pop listings & getting take down orders on the mom & pop listings as I outline in my post below from 2025. And there is literally nothing the small US businesses can do to rectify it. \n\nAnd now the fees they charge almost make it impossible to make a profit. One absurd fee they rolled out is a \"Low inventory fee\". If you run out of stock of an item because it sells fast, you get charged a fee FOR BEING OUT OF STOCK. Heaven forbid your supplier is out of stock, or you just don't have any extra inventory of that item, they'll still whack you with a fee each month for not having inventory at their fulfillment center for them to ship out. Coupled with all the other fees they charge, you can easily hit 40% of your sales revenue going straight to Amazon in fees now. That doesn't include YOUR costs, like cost of goods, packaging, etc. \n\nAfter 15 years, to me, it's just really not worth it anymore. It's been a good run but they've made it almost impossible for small third party sellers to make a profit. They prioritized the low cost Chinese knock offs years ago and now seem to prioritize complete thievery all in the name of Bezos' original mission of being the \"Earth’s most customer-centric company.” The first and most important principle of Amazon's Leadership Principles is \"Customer Obsession\". \n\nBut I'll add one tweak: \"Customer Obsession: Even if the customer is a blatant thief\"   \n\n(A recent screenshot of a discussion on their seller forums)","url","https://x.com/BowTiedBroke/status/2112557835347173729","translation","政策/合规","亚马逊","费用变更","aihot","/items/a9hkquqo85uk3i8c0kxxqezf8","https://x.com/AmazonASGTG/status/2112605364344570003","x-amazon-asgtg","name","X · ASGTG","kind","x_search","firstParty","iconUrl",{"_115":116},"changelogVersion","2026-10-09T22:08"]
