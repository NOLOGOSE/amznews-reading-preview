[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","aa47lj9xle6te3chuac0su5qq","revision",1,"title","USTR 征求关于 2027 年国家贸易评估报告的外国贸易壁垒公众意见","originalTitle","USTR Seeks Public Comment on Foreign Trade Barriers for the 2027 National Trade Estimate Report","summary","USTR 于 2026 年 9 月 14 日邀请公众就阻碍美国商品、服务出口及对外直接投资的外国贸易壁垒提交意见，以纳入 2027 年国家贸易评估报告。大使 Greer 引用特朗普总统的“美国优先”贸易政策，强调通过关税和贸易协定消除壁垒以提升竞争力。意见提交的截止日期为 2026 年 10 月 29 日。","reason","source",{"_9":72,"_73":74,"_75":76,"_77":60,"_78":79,"_80":81},"links",{"_69":70,"_64":71},"publishedAt","2026-09-14T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T09:19:32.339Z","timelineAt","category","policy","tags",[67,68],"score",13,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","USTR","政策/合规","行业动态","aihot","/items/aa47lj9xle6te3chuac0su5qq","https://ustr.gov/about/policy-offices/press-office/press-releases/2026/september/ustr-seeks-public-comment-foreign-trade-barriers-2027-national-trade-estimate-report","official-ustr-press-releases-rolling","name","USTR 美国贸易代表办公室公告","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/dbeb162d0fa0fbc6.webp","iconSrcSet","/amznews-reading-preview/_img/dbeb162d0fa0fbc6.webp 48w, /amznews-reading-preview/_img/dbeb162d0fa0fbc6.webp 96w",{"_83":84},"changelogVersion","2026-10-09T22:08"]
