[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","abutgtobb72hwqtlb4cqfo1bt","revision",1,"title","UPS 2026年再关27个包裹中心，加速削减亚马逊业务以聚焦高利润板块","originalTitle","UPS to close 27 additional parcel facilities in 2026","summary","UPS计划2026年关闭27个额外包裹配送中心，旨在通过激进的成本重组提升盈利能力。作为其战略调整的一部分，UPS大幅减少与最大客户亚马逊的合作，第一季度日均处理量已减少50万件，预计年中将累计减少200万件及50亿美元收入。公司转而聚焦中小企业、B2B及医疗物流等高收益领域，尽管面临短期成本压力，管理层重申了下半年利润增长的预期。","reason","source",{"_9":90,"_91":92,"_69":93,"_94":39,"_95":96,"_97":98},"links",{"_87":88,"_65":89},"publishedAt","2026-04-29T13:40:20.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:17:07.766Z","timelineAt","category","fba","tags",[84,85,86],"score",22,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/1eb0771fd5b3c478.webp","fullUrl","/amznews-reading-preview/_img/1eb0771fd5b3c478.webp","srcSet","/amznews-reading-preview/_img/1eb0771fd5b3c478.webp 336w, /amznews-reading-preview/_img/1eb0771fd5b3c478.webp 720w","width",888,"height",238,"alt","","poster","FBA/物流","供应链","亚马逊","aihot","/items/abutgtobb72hwqtlb4cqfo1bt","https://www.freightwaves.com/news/ups-to-close-27-additional-parcel-facilities-in-2026","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d0