[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","agqxx5ydfp6j5uk2i1h6oyfwo","revision",1,"title","ChatGPT即时结账的退场与Synchrony的AI合作","originalTitle","Resurgence - Buy It in ChatGPT.","summary","原文作者Rambler_Amz回顾OpenAI的ChatGPT Instant Checkout：2025年9月推出，2026年2月向所有美国用户开放，五个月后被悄然停用。作者称该功能仅约30家商户完成入驻、可用商品不足20万件、站内结账转化率约为同一零售商官网的三分之一，并存在缺货商品进入购物车、无可用销售税系统等问题；这些数字和归因是作者叙述，本站尚未独立核验。作者随后讨论Synchrony与OpenAI的合作：Synchrony称其连接近7000万客户，去年为Walmart、Amazon、Lowe's、Sam's Club、JCPenney等合作伙伴产生超过1820亿美元购买量，并正在构建ChatGPT插件以在聊天中展示其零售合作伙伴网络的优惠，内部计划用OpenAI模型加快产品开发，据报道还在探索与Claude Code和Gemini的类似集成。作者观点是：AI采用不是技术问题，企业正把AI嵌入人们已信任的关系中；Instant Checkout试图成为商店而失败，新做法则试图进入决策环节。原文来自作者个人账号，涉及Synchrony与OpenAI的合作，存在相关商业利益，并非独立测评。","reason","source",{"_9":87,"_88":89,"_90":91,"_92":39,"_93":-5},"links",{"_84":85,"_66":86},"publishedAt","2026-08-21T06:13:06.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:42:17.703Z","timelineAt","category","ai-tools","tags",[80,81,82,83],"score",30,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Rambler_Amz","language","zxx","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>http://x.com/i/article/2090683018029793280</p>","zhKind","complete","authorName","Rambler | X -Amazonian | Account Health Expert |","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 