[{"_1":2,"_3":4},"root",{"_5":120},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","ao8lpze5nlei4l8d6ctt87v87","revision",2,"title","越南前三季度电商GMV达158亿美元；Sea Limited拟推动Monee独立上市；马来西亚仅20%消费者属成熟型网购用户","originalTitle","越南前三季度电商卖出26亿件商品，GMV达158亿美元；Shopee母公司谋求支付公司独立上市；马来西亚仅20%消费者属于成熟型网购用户","summary","YouNet ECI数据显示，2026年前9个月越南四大电商平台GMV约158亿美元，销量平稳但交易额增长主要源于价格上涨。路透社报道，Sea Limited正考虑推动旗下数字金融业务Monee独立上市，并计划推出AI企业服务平台Sea Cloud。Lazada与Cube Asia联合报告指出，马来西亚仅20%线上消费者属于“成熟型购物者”，低于东南亚六国24%的平均水平。","reason","source",{"_9":111,"_112":113,"_86":114,"_115":40,"_116":117,"_118":119},"links",{"_108":109,"_68":110},"publishedAt","2026-10-21T08:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-22T06:56:26.403Z","timelineAt","category","product","tags",[104,105,106,107],"score",38,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境东南亚","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fqXALa1NzoKk",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","69bcdf52-336c-4aa5-be80-feabfb3efadd","越南电商GMV达158亿美元，Sea拟分拆Monee上市",{"_77":78,"_13":79},"platform","AMZ123",{"_86":87,"_88":101,"_90":102,"_92":103,"_94":-5,"_95":-5,"_96":-5,"_97":-5},{"_86":87,"_88":98,"_90":99,"_92":100,"_94":-5,"_95":-5,"_96":-5,"_97":-5},{"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":-5,"_96":-5,"_97":-5},"kind","image","url","/amznews-reading-preview/_img/013814326cf3c065.we