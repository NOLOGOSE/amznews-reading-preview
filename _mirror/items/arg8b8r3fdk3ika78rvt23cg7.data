[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","arg8b8r3fdk3ika78rvt23cg7","revision",3,"title","欧洲年底入仓赶卖家大礼包：德国、法国EORI卡顿，到仓60天需提供VAT/EORI怎么办？","originalTitle","欧洲年底要入仓一批货，我该怎么在12月31日前让货件到仓接收拿到欧洲卖家大礼包？同时避开德国、法国EORI卡顿和到仓60天内要提供VAT/EORI的风险？","summary","有卖家为赶在12月31日前货件到仓接收以获取欧洲卖家大礼包，面临德国暂停EORI申请、法国9月初起申请EORI需提供首票欧盟海关业务将在法国进行的证明材料，而德国、法国VAT均预计年底才能下来。税代建议改用波兰申请VAT再申请EORI，但波兰EORI年底才能下来；走德国双清包税又可能遇到到仓60天内需提供VAT和EORI的要求。","reason","source",{"_9":75,"_76":67,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_72":73,"_65":74},"publishedAt","2026-09-13T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T13:47:11.443Z","timelineAt","category","fba","tags",[68,69,70,71],"score",22,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","YHouYi","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","FBA/物流","合规税务","供应链","亚马逊","aihot","/items/arg8b8r3fdk3ika78rvt23cg7","https://www.wearesellers.com/question/124540","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
