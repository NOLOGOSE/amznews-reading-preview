[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","at5c59rprk67jk787sp9w3n1n","revision",3,"title","亚马逊中东站发布2026年新卖家FBA头程返现及佣金抵扣福利","originalTitle","重磅 | 2026 亚马逊中东站福利全面升级！","summary","亚马逊中东站（阿联酋和沙特）推出两项新卖家激励政策：一是2026年6月1日至12月30日的FBA头程返现计划，按商品尺寸提供现金补贴，单个ASIN最高返还约人民币6800元；二是自2025年7月22日起生效的新卖家入门大礼包，符合条件者可获$50,000预付佣金代金券，在前$100万销售额内每笔订单抵扣5%佣金，并额外提供最高$1,000广告折扣券。","reason","原文详细列出了中东站两项激励政策的适用站点、时间窗口及具体补贴金额，卖家可据此评估入驻或发货成本。","source",{"_9":75,"_76":77,"_78":79,"_80":41,"_81":-5},"links",{"_72":73,"_66":74},"publishedAt","2026-09-25T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-26","discoveredAt","2026-10-16T14:13:44.166Z","timelineAt","category","policy","tags",[69,70,71],"score",62,"selected",true,"channel","news","story","x","media",[],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","亚马逊全球开店","政策/合规","FBA/物流","亚马逊","aihot","/items/at5c59rprk67jk787sp9w3n1n","https://globalselling.amazon.com/news/news-brand-260926","official-amazon-global-selling-news","name","亚马逊全球开店 · 官方资讯","kind","web_list","firstParty","iconUrl",{"_83":84},"changelogVersion","2026-10-09T22:08"]
