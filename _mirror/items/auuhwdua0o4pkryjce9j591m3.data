[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","auuhwdua0o4pkryjce9j591m3","revision",2,"title","亚马逊印度站卖家突破200万，AI工具使用量增长7.5倍","originalTitle","summary","截至2026年9月，亚马逊印度站卖家数量突破200万，过去一年新增超30万名卖家，创近三年最强同比增长。过去一年卖家与AI驱动的Seller Assistant互动次数增长7.5倍，使用AI广告工具的广告主占比增长77%。亚马逊物流已覆盖17个邦履约中心、20个邦分拣中心及近2000个最后一公里配送站。","reason","source",{"_9":89,"_90":91,"_69":92,"_93":38,"_94":95,"_96":97},"links",{"_86":87,"_64":88},"publishedAt","2026-09-09T02:21:47.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:19.083Z","timelineAt","category","product","tags",[81,82,83,84,85],"score",34,"selected",false,"channel","news","story","x","media",[68],"byline",{"_50":65,"_66":67},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Summer","platform","AMZ123",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/01f4ec8adb79d1f7.webp","fullUrl","/amznews-reading-preview/_img/01f4ec8adb79d1f7.webp","srcSet","/amznews-reading-preview/_img/01f4ec8adb79d1f7.webp 336w, /amznews-reading-preview/_img/01f4ec8adb79d1f7.webp 720w","width","height","alt","poster","选品/市场","品类趋势","AI工具","亚马逊","FBA/物流","aihot","/items/auuhwdua0o4pkryjce9j591m3","https://www.amz123.com/t/EgQFYHx7","author-amz123-summer","name","AMZ123 · SUMMER","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7