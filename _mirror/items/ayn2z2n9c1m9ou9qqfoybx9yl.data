[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","ayn2z2n9c1m9ou9qqfoybx9yl","revision",3,"title","亚马逊美国站AWD将于7月31日起停止接受大件商品入仓","originalTitle","7/31起，美国AWD不再接受大件商品入仓","summary","亚马逊宣布自2026年7月31日起，美国站AWD仅接受标准尺寸商品入仓，超过长18英寸、宽14英寸、高8英寸或重20磅任一阈值的商品将无法创建AWD货件。受影响的大件商品需直接发送至FBA仓库或使用GWD作为替代方案；已在AWD库内的大件库存无需移出，可继续正常补货至FBA直至出库，且7月31日前创建的货件不受影响。","reason","原文明确了AWD大件商品入仓的尺寸重量阈值及生效日期，并提供了GWD替代方案与存量库存处理指引。","source",{"_9":76,"_77":78,"_79":80,"_81":41,"_82":-5},"links",{"_73":74,"_66":75},"publishedAt","2026-07-10T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-07-11","discoveredAt","2026-10-16T14:13:44.127Z","timelineAt","category","fba","tags",[69,70,71,72],"score",69,"selected",true,"channel","news","story","x","media",[],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","亚马逊全球开店","政策/合规","FBA/物流","库存管理","亚马逊","aihot","/items/ayn2z2n9c1m9ou9qqfoybx9yl","https://gs.amazon.cn/news/news-notices-260711","official-amazon-global-selling-news","name","亚马逊全球开店 · 官方资讯","kind","web_list","firstParty","iconUrl",{"_84":85},"changelogVersion","2026-10-09T22:08"]
