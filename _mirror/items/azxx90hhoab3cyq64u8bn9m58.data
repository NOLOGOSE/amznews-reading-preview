[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","azxx90hhoab3cyq64u8bn9m58","revision",2,"title","美妆品牌通过“去浪费再分配”策略将 TACoS 从 21.95% 降至 14.40%","originalTitle","How a beauty brand cut TACoS from 21.95% to 14.40% while adding $18.9K in sales","summary","某美妆品牌采用“去浪费再分配”策略，在两个9天对比窗口中将 TACoS 从 21.95% 降至 14.40%，销售额增加约 $18.9K。该案例由 Mike Begg 分享，核心在于先通过否定关键词和暂停高 ACOS 广告削减无效支出，再将预算重新分配至高转化活动，从而在降低广告成本的同时提升整体销售表现。","reason","source",{"_9":100,"_101":54,"_82":102,"_103":40,"_104":105,"_106":107},"links",{"_97":98,"_68":99},"publishedAt","2026-10-12T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-12","discoveredAt","2026-10-12T15:15:27.241Z","timelineAt","category","advertising","tags",[95,96],"score",50,"selected",false,"channel","news","story",{"_77":78,"_13":14},"x","media",[81],"byline",{"_53":-5,"_80":54},"detailedGuide","readingMode","full","author","Mike Begg","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fX0T_imxKe8o",{"_77":78,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","92de1f66-c511-4324-a89b-dbbcac891c7d",{"_77":78,"_13":14},"platform",{"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":91,"_93":-5,"_94":-5},"kind","image","url","/amznews-reading-preview/_img/adaa9617d61903e4.webp","fullUrl","/amznews-reading-preview/_img/adaa9617d61903e4.webp","srcSet","/amznews-reading-preview/_img/adaa9617d61903e4.webp 336w, /amznews-reading-preview/_img/adaa9617d61903e4.webp 720w","width",80,"height","alt","poster","广告/运营","广告投放","ai