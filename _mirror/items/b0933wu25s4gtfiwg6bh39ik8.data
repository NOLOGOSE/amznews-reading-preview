[{"_1":2,"_3":4},"root",{"_5":127},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","b0933wu25s4gtfiwg6bh39ik8","revision",1,"title","格力博2025年亏损3.55亿元，自有品牌转型致销售费用激增","originalTitle","江苏园林工具大卖家，亏损3.5亿的背后","summary","格力博2025年实现收入50.56亿元，但亏损3.55亿元。亏损主因是战略性转型下销售费用达8.6亿元（同比增34.8%）及ODM业务收入骤降5.36亿元。尽管自有品牌收入占比超70%，公司仍面临存货跌价、汇兑损失及关税带来的仓储成本上升等压力。","reason","source",{"_9":118,"_119":120,"_76":121,"_122":39,"_123":124,"_125":126},"links",{"_115":116,"_64":117},"publishedAt","2026-06-04T19:55:03.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:54.225Z","timelineAt","category","product","tags",[112,113,114],"score",32,"selected",false,"channel","news","story","x","media",[67,68,69,70,71,72,73,74,75],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","蓝海亿观网",{"_76":77,"_78":109,"_80":110,"_82":111,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":106,"_80":107,"_82":108,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":103,"_80":104,"_82":105,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":100,"_80":101,"_82":102,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":97,"_80":98,"_82":99,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":94,"_80":95,"_82":96,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":91,"_80":92,"_82":93,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":88,"_80":89,"_82":90,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5,"_86":-5,"_87":-5},"kind","image","url","/amznews-reading-preview/