[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":62,"_63":38,"_64":65},"id","b2fhft1pbs9upckxe5m77g1kf","revision",2,"title","英国电商Zavvi停止运营进入破产程序","originalTitle","summary","英国影视游戏收藏品电商Zavvi于10月12日停止业务运营并进入正式破产程序：不再发出任何在库订单与预订单、不再接受退货，德国站zavvi.de已关闭；已付款项不自动退还，消费者需向银行、信用卡机构或支付服务商发起拒付/买家保护申诉。限量收藏版买家受影响最大。","reason","source",{"_9":100,"_101":102,"_80":103,"_104":38,"_105":106,"_107":108},"links",{"_97":98,"_65":99},"publishedAt","2026-10-15T07:08:11.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:54.157Z","timelineAt","category","policy","tags",[94,95,96],"score",45,"selected",false,"channel","news","story",{"_74":75,"_13":14},"x","media",[79],"byline",{"_51":-5,"_77":78},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[76],"indexable","markdownAvailable",true,"group",{"_66":67,"_41":68,"_69":70,"_71":72,"_73":72},"hasTranslation","bodyLanguage","original","factId","fZ1Z15P5YWOI",{"_74":75,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","3db82466-9103-4042-8b80-19ab695127be",{"_74":75,"_13":14},"platform","蓝海亿观网",{"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5},"kind","image","url","/amznews-reading-preview/_img/bf289d3346f01e63.webp","fullUrl","/amznews-reading-preview/_img/bf289d3346f01e63.webp","srcSet","/amznews-reading-preview/_img/bf289d3346f01e63.webp 336w, /amznews-reading-preview/_img/bf289d3346f01e63.webp 720w","width",760,"height",400,"alt","poster","政策/合规","亚马逊","合规税务","aihot","/items/b2fhft1pbs9upckxe5m77g1kf","https://www.egainnews.com/article/74378","publisher-egainnews-articles","name","蓝海亿观网 · 跨境电商资讯