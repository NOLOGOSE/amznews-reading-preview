[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","b2hrs43dsmk15h9vtcqqu0al3","revision",2,"title","亚马逊美国站停止 FBA 混储，转售卖家需为每件商品贴 FNSKU 标签","originalTitle","Commingling Is Over: FNSKU Labels for Every Reseller Unit","summary","亚马逊自 2026 年 3 月 31 日起在美国站停止 FBA 混储，除持有 Brand Representative 角色且具备有效制造商条码的品牌所有者外，所有转售卖家必须为发往 FBA 的每件商品贴 FNSKU 标签。未按要求贴标的商品将被视为缺陷品且无法获得赔偿，同时亚马逊已于 2026 年 1 月 1 日停止提供美国的 FBA 预处理和贴标服务。","reason","source",{"_9":96,"_97":98,"_70":99,"_100":39,"_101":102,"_103":104},"links",{"_93":94,"_65":95},"publishedAt","2026-10-02T21:31:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:22.435Z","timelineAt","category","fba","tags",[89,90,91,92],"score",66,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/bcbe19b1949fe77c.webp","fullUrl","/amznews-reading-preview/_img/bcbe19b1949fe77c.webp","srcSet","/amznews-reading-preview/_img/bcbe19b1949fe77c.webp 336w, /amznews-reading-preview/_img/bcbe19b1949fe77c.webp 720w","width",1600,"height",827,"alt","poster","/amznews-reading-preview/_img/d97deecfecbfb9b2.webp","/amznews-reading-preview/_img/d97deecfecbfb9b2.webp","/amznews-reading-preview/_img/d97deecfecbfb9b2.webp 336w, /amznews