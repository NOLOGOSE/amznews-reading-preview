[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","b6wt1u8a0twn54wx1tsoo9uj1","revision",3,"title","亚马逊卖家自述合伙运营困境：盈利未分红且需贴钱，因理念分歧求助","originalTitle","亚马逊崩了！3年亚马逊运营，这点盈利我也无法分到钱，每个月还要贴人工、房租、社保、餐费进去，我也很无助了。请大佬看看是否还能继续做下去？","summary","一位拥有3年经验的亚马逊卖家自述与朋友合伙运营陷入困境。尽管7-8月实现1w+盈利、9月预计2w+，但因占股49%且约定不领工资，该卖家不仅无法分红，每月还需自贴人工、房租及社保等费用。目前双方就“是否增加团队人员”产生分歧，卖家感到无助并寻求建议。","reason","source",{"_9":74,"_75":68,"_76":77,"_78":40,"_79":80,"_81":82},"links",{"_71":72,"_66":73},"publishedAt","2026-09-18T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-19","discoveredAt","2026-10-07T11:45:55.300Z","timelineAt","category","advertising","tags",[69,70],"score",12,"selected",false,"channel","news","story","x","media",[],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","HIZHIYONG","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","广告/运营","多平台销售","aihot","/items/b6wt1u8a0twn54wx1tsoo9uj1","https://www.wearesellers.com/question/124751","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
