[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","b7qrpzp6b7xo6qonotjkgo425","revision",2,"title","FundPark获Bain Capital至多2.5亿美元债务融资以扩展亚洲电商卖家贷款","originalTitle","FundPark secures up to $250M in debt financing from Bain Capital to expand its lending to e-commerce sellers across Asia","summary","FundPark从Bain Capital获得至多2.5亿美元债务融资，用于扩大对亚洲电商卖家的贷款规模。其中1亿美元已承诺，剩余1.5亿美元取决于未披露的条件。该公司自2016年成立以来已向4万多家网店累计放贷超100亿美元，其风控模式基于实时销售数据而非传统信用检查。","reason","source",{"_9":102,"_103":104,"_83":105,"_106":39,"_107":108,"_109":110},"links",{"_99":100,"_67":101},"publishedAt","2026-10-22T17:39:19.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T18:32:29.322Z","timelineAt","category","fba","tags",[97,98],"score",38,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Paul Drecksler","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fN1P8yZHlHlc",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","f0c78b20-c83c-41a0-977a-aa29273024c3","FundPark获贝恩至多2.5亿美元债务融资",{"_76":77,"_13":78},"platform","Shopifreaks",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/21711f82959ac1e8.webp","fullUrl","/amznews-reading-preview/_img/21711f82959ac1e8.webp","srcSet","/amznews-reading-preview/_img/21711f82959ac1e8.webp 336w, /amznews-reading-preview/_img/21711f82959ac1e8.webp 720w",