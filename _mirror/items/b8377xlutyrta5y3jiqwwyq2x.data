[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","b8377xlutyrta5y3jiqwwyq2x","revision",2,"title","亚马逊强制 Passkey 后，卖家如何创建与保存密钥","originalTitle","亚马逊强制Passkey后，卖家到底怎么创建？","summary","一汤说介绍，亚马逊从9月下旬起以滚动方式对卖家账号强制启用 Passkey，账号被纳入后密码仅用于账号恢复，不再支持日常登录。作者建议本地电脑卖家优先更新系统和浏览器并设置 Windows Hello PIN 来创建，老设备若只弹出 USB 安全密钥提示，可依次尝试换机、用 Bitwarden 等支持 Passkey 的密码管理器，最后才考虑 USB 硬件密钥。","reason","source",{"_9":108,"_109":110,"_74":111,"_112":39,"_113":114,"_115":116},"links",{"_105":106,"_65":107},"publishedAt","2026-10-04T21:04:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-08T03:34:35.666Z","timelineAt","category","policy","tags",[101,102,103,104],"score",62,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","一汤说","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_74":75,"_76":98,"_78":99,"_80":100,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":95,"_78":96,"_80":97,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":92,"_78":93,"_80":94,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":89,"_78":90,"_80":91,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/58bc67064c05b435.webp","fullUrl","/amznews-reading-preview/_img/58bc67064c05b435.webp","srcSet","/amznews-reading-preview/_img/58bc67064c05b435.webp 336w, /amznews-readi