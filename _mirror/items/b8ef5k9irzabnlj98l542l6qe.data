[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":-5,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","b8ef5k9irzabnlj98l542l6qe","revision",3,"title","亚马逊金融科技战略解析：从 Venmo 合作到 Amazon Pay 的布局逻辑","originalTitle","Amazon Briefing: How to make sense of Amazon’s fintech strategy","summary","亚马逊近期先后与 Affirm 和 Venmo 达成合作，允许用户分期付款及在结账时使用 Venmo，推动其支付体系从信用卡、借记卡向更多元方式转移。尽管 Amazon Pay 自 2007 年推出至今市场份额仅约 2.46%，而 Venmo 用户已超 8000 万，亚马逊仍通过外部合作弥补自有支付产品的不足。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":38,"_80":81,"_82":83},"links",{"_71":72,"_64":73},"publishedAt","2021-11-11T15:00:59.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:20:23.824Z","timelineAt","category","tags",[67,68,69,70],"score",24,"selected",false,"channel","news","story","x","media",[],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","Michael Waters","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Modern Retail","行业动态","亚马逊","多平台销售","供应链","aihot","/items/b8ef5k9irzabnlj98l542l6qe","https://www.modernretail.co/retailers/amazon-briefing-how-to-make-sense-of-amazons-fintech-strategy/?utm_campaign=modernretaildis&utm_medium=rss&utm_source=general-rss","author-modern-retail-michael-waters-case-reviewed","name","Modern Retail · Michael Waters","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/feec9bcddc707257.webp","iconSrcSet","/amznews-reading-preview/_img/feec9bcddc707257.webp 48w, /amznews-reading-preview/_img/feec9bcddc707257.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
