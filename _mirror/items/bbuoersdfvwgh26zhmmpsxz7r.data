[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":40,"_60":61,"_62":-5,"_63":40,"_64":65},"id","bbuoersdfvwgh26zhmmpsxz7r","revision",1,"title","亚马逊 DSP 在比利时、波兰等五个新地区上线","originalTitle","Amazon DSP now available in five new locales","summary","亚马逊 DSP 现已扩展至比利时、波兰、新加坡、埃及和南非五个新地区，支持广告主以程序化方式购买展示、视频及音频广告。该更新使区域广告主能利用基于购物与流媒体行为的受众信号及 Performance+ 等 AI 优化工具，投放全流域广告并接入亚马逊营销云。功能面向自助式服务广告主及广告服务商开放。","reason","source",{"_9":88,"_89":90,"_69":91,"_92":61,"_93":94,"_95":96},"links",{"_85":86,"_65":87},"publishedAt","2026-09-25T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-25","discoveredAt","2026-10-22T17:24:11.696Z","timelineAt","category","advertising","tags",[83,84],"score",34,"selected",false,"channel","news","story","x","media",[68],"byline",{"_52":-5,"_66":67},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊广告",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/ccc3ed326b3f0677.webp","fullUrl","/amznews-reading-preview/_img/ccc3ed326b3f0677.webp","srcSet","/amznews-reading-preview/_img/ccc3ed326b3f0677.webp 336w, /amznews-reading-preview/_img/ccc3ed326b3f0677.webp 720w","width",884,"height",742,"alt","poster","广告/运营","亚马逊","aihot","/items/bbuoersdfvwgh26zhmmpsxz7r","https://advertising.amazon.com/resources/whats-new/amazon-dsp-five-new-locales/","official-amazon-ads-whats-new","name","亚马逊广告 · 产品更新","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/59e7dfe2bd310f3d.webp","iconSrcSet","/amznews-reading-preview/_img/59e