[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","bca8s2lentikzc86x2ib44voy","revision",3,"title","亚马逊德国站9月9日起收紧RRP验证，不达标参考价或被隐藏","originalTitle","亚马逊德国站严查商品参考价，商品不符合要求或被隐藏","summary","亚马逊德国站自9月9日起调整参考价格（RRP）验证方式，英国站已于6月23日实施类似规则，其他欧盟站点将陆续跟进。新规收紧原有的Featured Offer验证路径，只有该价格在Rufus价格历史图表中展示过具有代表性的天数，相关销售记录才计入验证，回溯期为90天。若RRP无法通过验证，亚马逊可能隐藏该参考价格，商品Listing上的折扣与节省金额展示也会随之变化。","reason","source",{"_9":88,"_89":90,"_70":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_65":87},"publishedAt","2026-09-10T07:37:01.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:19.083Z","timelineAt","category","policy","tags",[82,83,84],"score",62,"selected",false,"channel","news","story","x","media",[69],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Summer","platform","AMZ123",{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/fbf7136fad87df4d.webp","fullUrl","/amznews-reading-preview/_img/fbf7136fad87df4d.webp","srcSet","/amznews-reading-preview/_img/fbf7136fad87df4d.webp 336w, /amznews-reading-preview/_img/fbf7136fad87df4d.webp 720w","width","height","alt","poster","政策/合规","亚马逊","Listing优化","aihot","/items/bca8s2lentikzc86x2ib44voy","https://www.amz123.com/t/NsXuLmuN","author-amz123-summer","name","AMZ123 · SUMMER","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.web