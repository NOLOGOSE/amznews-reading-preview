[{"_1":2,"_3":4},"root",{"_5":144},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","be3ozmi5kkxrt6le171lmi6ig","revision",2,"title","亚马逊后台新增“创建卖家工作流程”功能及实操方法","originalTitle","亚马逊后台新增“创建卖家工作流程”功能","summary","亚马逊后台新增“创建卖家工作流程”（Seller Assistant Workflows）功能，允许卖家将重复性运营任务设计为持续运行的自动化流程。原文作者分享了该功能与早期Agent能力的区别，并提供了重点ASIN销量变化日报、账户健康待办巡检和重点商品价格观察三个具体任务的指令模板，强调需明确数据口径、判断标准和操作边界才能有效使用。","reason","作者拆解了亚马逊后台新增的卖家工作流程功能，并提供了销量日报、账户巡检和价格观察三个场景的具体指令模板。","source",{"_9":135,"_136":137,"_93":138,"_139":67,"_140":141,"_142":143},"links",{"_132":133,"_69":134},"publishedAt","2026-10-20T17:30:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-21T09:45:08.666Z","timelineAt","category","ai-tools","tags",[129,130,131],"score",62,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86,87,88,89,90,91,92],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","Regan跨境","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":76,"_77":76},"hasTranslation",false,"bodyLanguage","original","factId","fFhuHLpNI8p4",{"_78":79,"_13":80},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","3428490f-2869-4eb0-a6db-bd0a5304bb3f","亚马逊升级Seller Assistant并推卖家工作流程",{"_78":79,"_13":80},"platform","AMZ123",{"_93":94,"_95":126,"_97":127,"_99":128,"_101":-5,"_102":-5,"_103":-5,"_104":-5},{"_93":94,"_95":123,"_97":124,"_99":125,"_101":-5,"_102":-5,"_103":-5,"_104":-5},{"_93":94,"_95":120,"_97":121,"_99":122,"_101":-5,"_102":-5,"_103":-5,"_104":-5},{"_93":94,"_95":117,"_97":118,"_99":119,"_101":-5,"_102":-5,"_103":-5,"_104":-5},{"_93