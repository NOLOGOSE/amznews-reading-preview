[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","bedbslaejef7boyhouzsybo5j","revision",2,"title","亚马逊下架幼儿幽灵服装：因绳索超标存勒颈风险","originalTitle","Product Safety Report: Toddler Ghost Costume sold via Amazon (2609-0106)","summary","亚马逊已下架一款名为“QhgPnt Toddler Ghost Costume”的幼儿幽灵服装（ASIN B0HBBWM2B8），因该产品附带的调节绳长度超过幼儿玩具允许标准，存在严重勒颈风险。此外，其包装塑料袋厚度低于最低要求，亦构成窒息隐患，且不符合《2011年玩具安全法规》。建议用户立即停止使用并联系零售商退款或更换。","reason","source",{"_9":87,"_88":89,"_90":91,"_92":62,"_93":94,"_95":96},"links",{"_84":85,"_67":86},"publishedAt","2026-10-13T17:01:13.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-13T17:29:14.882Z","timelineAt","category","policy","tags",[82,83],"score",38,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":-5,"_80":81},"detailedGuide","readingMode","full","author","Office for Product Safety and Standards","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fNKKRwygI8ko",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","22426b5d-1ca5-45cd-9d42-bd9318074dd4","英国OPSS通报亚马逊下架幼儿幽灵服装",{"_76":77,"_13":78},"platform","UK OPSS","政策/合规","亚马逊","aihot","/items/bedbslaejef7boyhouzsybo5j","https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-report-toddler-ghost-costume-sold-via-amazon-2609-0106","official-uk-opss-rolling","name","UK OPSS 产品安全公告","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/1fbf571bfada1bb0.webp","iconSrcSet","/amznews-reading-preview/_img/