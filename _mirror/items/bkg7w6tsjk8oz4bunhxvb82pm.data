[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","bkg7w6tsjk8oz4bunhxvb82pm","revision",4,"title","2026年H1亚马逊欧盟月活用户达1.94亿，增长放缓","originalTitle","26年H1亚马逊欧盟月活用户达1.94亿，增长放缓","summary","亚马逊向欧盟委员会提交的透明度报告显示，2026年上半年其在欧盟的平均月活跃服务触达人数为1.939亿，低于2025年下半年的1.952亿，半年平均每月减少约130万人。德国以5280万人居首，法国3880万、意大利3810万、西班牙2790万、荷兰660万；五个主要市场中仅荷兰增长4.0%。丹麦增速最高达18.4%，希腊降幅最大为20.2%。","reason","source",{"_9":89,"_90":91,"_70":92,"_93":39,"_94":95,"_96":97},"links",{"_86":87,"_65":88},"publishedAt","2026-09-14T03:17:01.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:19.083Z","timelineAt","category","product","tags",[82,83,84,85],"score",37,"selected",false,"channel","news","story","x","media",[69],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Summer","platform","AMZ123",{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/2fbaf9b7d7698972.webp","fullUrl","/amznews-reading-preview/_img/2fbaf9b7d7698972.webp","srcSet","/amznews-reading-preview/_img/2fbaf9b7d7698972.webp 336w, /amznews-reading-preview/_img/2fbaf9b7d7698972.webp 720w","width","height","alt","poster","选品/市场","品类趋势","数据/报告","亚马逊","aihot","/items/bkg7w6tsjk8oz4bunhxvb82pm","https://www.amz123.com/t/lrTMqj8z","author-amz123-summer","name","AMZ123 · SUMMER","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w,