[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","blqar4ut02jmoxwzghw3p8xzw","revision",3,"title","亚马逊提醒卖家在8月12日前完成欧盟包装法合规","originalTitle","紧急提醒|8/12 PPWR正式生效, 未合规商品可能面临停售","summary","亚马逊发布通知提醒卖家，欧盟《包装与包装废弃物法规》（PPWR）将于8月12日正式生效，未合规商品可能面临停售风险。所有向欧盟配送带包装商品的卖家需在截止日期前获取各目的国注册号（ERN）并上传至卖家平台；法国和西班牙站点的代付服务转为新模式，需先自行注册号码再选择是否继续由亚马逊代为申报缴费，奥地利站点则提供涵盖电池、包装和WEEE类目的注册加代付一站式服务。","reason","原文汇总了欧盟包装法生效前的注册与上传要求，并说明了代付模式变化及验证滞后等实操细节。","source",{"_9":100,"_101":102,"_73":103,"_104":41,"_105":-5},"links",{"_97":98,"_66":99},"publishedAt","2026-07-12T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-07-13","discoveredAt","2026-10-16T14:13:44.119Z","timelineAt","category","policy","tags",[94,95,96],"score",82,"selected",true,"channel","news","story","x","media",[69,70,71,72],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","亚马逊全球开店",{"_73":74,"_75":91,"_77":92,"_79":93,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":88,"_77":89,"_79":90,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":85,"_77":86,"_79":87,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/97de034773c6c474.webp","fullUrl","/amznews-reading-preview/_img/97de034773c6c474.webp","srcSet","/amznews-reading-preview/_img/97de034773c6c474.webp 336w, /amznews-reading-preview/_img/97de034773c6c474.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/41988315f59fb4b2.webp","/amznews-reading-preview/_img/41988315f59fb4b2.webp","/amznews-reading-preview/_img/41988315f59fb4b2.webp 336w, /amznews-reading-preview/_img/41988315f59fb4b2.webp 720w","/amznews-reading-preview/_img/156ab60f533f8224.webp","/amznews-reading-preview/_img/156ab60f533f8224.webp","/amznews-reading-preview/_img/156ab60f533f8224.webp 336w, /amznews-reading-preview/_img/156ab60f533f8224.webp 720w","/amznews-reading-preview/_img/7816f3331d0ac461.webp","/amznews-reading-preview/_img/7816f3331d0ac461.webp","/amznews-reading-preview/_img/7816f3331d0ac461.webp 336w, /amznews-reading-preview/_img/7816f3331d0ac461.webp 720w","政策/合规","FBA/物流","亚马逊","aihot","/items/blqar4ut02jmoxwzghw3p8xzw","https://gs.amazon.cn/news/news-notices-260713","official-amazon-global-selling-news","name","亚马逊全球开店 · 官方资讯","web_list","firstParty","iconUrl",{"_107":108},"changelogVersion","2026-10-09T22:08"]
