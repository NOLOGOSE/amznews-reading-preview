[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","bmu9g75i86pwknzu1btjnayrr","revision",1,"title","卖家Jimmy Smith分享从自发货转FBA经历","originalTitle","I spent Christmas Eve taping boxes of lighted wire-frame deer sets while buyers paid crazy premiums for expedited shipping to get them in...","summary","亚马逊卖家顾问 Jimmy Smith 分享其从圣诞季自发货（FBM）转向 FBA 的经历。他早期通过亲自打包和加急配送赚取初始资金，随后雇佣人员过渡，最终实现 100% 使用 FBA，以便在旺季无需亲自处理物流即可休假。","reason","source",{"_9":86,"_87":88,"_89":90,"_91":39,"_92":-5},"links",{"_83":84,"_66":85},"publishedAt","2026-10-07T15:00:06.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T16:14:18.263Z","timelineAt","category","fba","tags",[80,81,82],"score",15,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","askjimmysmith","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>I spent Christmas Eve taping boxes of lighted wire-frame deer sets while buyers paid crazy premiums for expedited shipping to get them in time.</p><p>The local retail stores were clearancing them out, the demand on Amazon was through the roof, and people were happy to pay whatever it cost to have a box arrive before Christmas morning. I spent the day printing labels, packing boxes at my kitchen counter, and racing to the carrier counter right before the cutoff window closed.</p><p>That merchant-fulfilled rush brought in great money. When you are starting out, trading physical sweat and long hours to build your initial working capital makes complete sense. That cash funded inventory purchases for months, and I actually ran that same holiday merchant-fulfilled sprint for the next couple of years.</p><p>Eventually I did not want to do that fulfillment grind myself anymore.</p><p>Once the capital was established, I hired people to take over the packing and shipping work, and then transitioned my business entirely to Amazon FBA. Today I sell 100% through FBA. The inventory goes to Amazon warehouses well ahead of Q4, Amazon handles the late-night holiday rush, and I get to take Christmas week off without touching a roll of tape.</p>","zhKind","complete","authorName","Jimmy Smith","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"FBA/物流","库存管理","亚马逊","aihot","/items/bmu9g75i86pwknzu1btjnayrr","https://x.com/askjimmysmith/status/2107848445746651504","x-jimmy-smith","name","X · Jimmy Smith","kind","x_search","firstParty","iconUrl",{"_94":95},"changelogVersion","2026-10-09T22:08"]
