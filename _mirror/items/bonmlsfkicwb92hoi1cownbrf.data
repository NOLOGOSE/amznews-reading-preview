[{"_1":2,"_3":4},"root",{"_5":125},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","bonmlsfkicwb92hoi1cownbrf","revision",9,"title","历史资料：亚马逊披露CCU五年打假执法协作成果","originalTitle","Amazon efforts lead to criminal sanctions and $180 million in penalties against bad actors","summary","Dharmesh Mehta在2025年6月25日的官方文章中称，CCU五年间发起超过200起民事行动；亚马逊打击假冒与欺诈的努力促成超过1.8亿美元的法院赔偿及判决金额，并涉及全球刑事追诉。该金额不能一概称为刑事罚款；数据为机构披露，本文不作本站独立验证或对具体卖家的法律判断。","reason","source",{"_9":116,"_117":118,"_75":119,"_120":61,"_121":122,"_123":124},"links",{"_113":114,"_65":115},"publishedAt","2025-06-25T22:00:15.237Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-02T00:27:21.091Z","timelineAt","category","policy","tags",[110,111,112],"score",32,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Dharmesh Mehta","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","About Amazon",{"_75":76,"_77":107,"_79":108,"_81":109,"_83":92,"_85":93,"_87":-5,"_88":-5},{"_75":76,"_77":104,"_79":105,"_81":106,"_83":84,"_85":86,"_87":-5,"_88":-5},{"_75":76,"_77":101,"_79":102,"_81":103,"_83":92,"_85":93,"_87":-5,"_88":-5},{"_75":76,"_77":98,"_79":99,"_81":100,"_83":84,"_85":86,"_87":-5,"_88":-5},{"_75":76,"_77":94,"_79":95,"_81":96,"_83":97,"_85":86,"_87":-5,"_88":-5},{"_75":76,"_77":89,"_79":90,"_81":91,"_83":92,"_85":93,"_87":-5,"_88":-5},{"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5,"_88":-5},"kind","image","url","/amznews-reading-preview/_img/80acc63de092580d.webp","fullUrl","/amznews-readin