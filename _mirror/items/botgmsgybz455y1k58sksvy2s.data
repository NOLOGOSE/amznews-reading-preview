[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","botgmsgybz455y1k58sksvy2s","revision",1,"title","亚马逊 Rufus 新增账户级用户画像，TikTok 测试付费会员","originalTitle","Amazon's Rufus Just Started Keeping a Permanent File on Every Shopper — And Rewriting Your Search Rank Around It","summary","据 PPC Land 报道，亚马逊 Rufus 推出“Tell us about you”功能，将购物者自述的风格、爱好、家庭和宠物等信息保存为账户级持久档案，并在后续搜索中参考该档案，使同一关键词可为不同购物者呈现不同产品；购物者可在“About you”中查看和编辑。原文另提到 TikTok 正在测试名为“TikTok Shop Plus”的付费会员，据 Business Insider 截图显示月费为 6、10 或 15 美元，捆绑免费配送和会员折扣，但截至报道时 TikTok 未公开确认该测试。作者建议卖家围绕具体买家身份和使用场景优化 Listing 内容，而非仅堆砌关键词。","reason","source",{"_9":109,"_110":111,"_73":112,"_113":40,"_114":115,"_116":117},"links",{"_106":107,"_66":108},"publishedAt","2026-10-09T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-09","discoveredAt","2026-10-12T16:04:31.545Z","timelineAt","category","advertising","tags",[103,104,105],"score",62,"selected",false,"channel","news","story","x","media",[68,69,70,71,72],"byline",{"_52":-5,"_67":53},"detailedGuide","readingMode","full","author","SellerBites","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform",{"_73":74,"_75":100,"_77":101,"_79":102,"_81":-5,"_83":-5,"_85":-5,"_86":-5},{"_73":74,"_75":95,"_77":96,"_79":97,"_81":98,"_83":99,"_85":-5,"_86":-5},{"_73":74,"_75":92,"_77":93,"_79":94,"_81":90,"_83":91,"_85":-5,"_86":-5},{"_73":74,"_75":87,"_77":88,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":-5},"kind","image","url","/amznews-reading-preview/_img/fdcfc292c1e612af.webp