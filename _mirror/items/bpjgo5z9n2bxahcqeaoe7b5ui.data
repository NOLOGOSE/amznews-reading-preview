[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","bpjgo5z9n2bxahcqeaoe7b5ui","revision",2,"title","DTC 品牌如何划分品牌与效果广告预算：按阶段调整比例及衡量方法","originalTitle","Brand vs Performance Spend: How Much Should a DTC Brand Put in Each?","summary","原文来自 SellerElevate，存在相关商业利益，并非独立测评。作者 Mohammad Jalil（MJ）提出，品牌与效果广告的预算划分没有唯一正确比例，但应按阶段设定起点：产品市场契合前品牌占比约 10% 或更低，单位经济模型验证后为 20% 至 35%，付费社交增长停滞的成熟阶段为 35% 或以上；这些是作者团队的经验法则，并非行业统计数据。作者引用 1-800-DTC 于 2026 年 4 月发布的文章称，2023 至 2025 年间电商平均获客成本上升 40% 至 60%，并引用 Shopify 代理机构 Tenten 的 2026 年 DTC CAC 基准报告称，其组合内品牌将付费社交依赖从 50% 以上降至约 35% 至 40%，但该结果来自单一机构组合、非对照研究，本站尚未独立核验，不能推广为总体结论。作者建议通过品牌搜索量、亚马逊品牌查询量、新客率和 MER 等指标衡量品牌支出，并强调品牌支出需可测量，否则容易被优先削减。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-03T11:54:18.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:20.412Z","timelineAt","category","advertising","tags",[89,90,91],"score",30,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/ea3c93a38f3d946d.webp","fullUrl","/amznews-reading-preview/_img/ea3c93a38f3d946d.webp","srcSet","/amznews-reading-preview/_img/ea3c93a38f3d946d.webp 336w, /amznews-reading-preview/_img/ea3c93a38f3d946d.webp 720w","width",1600,"height",808,"alt","poster","/amznews-reading-preview/_img/997a39e04c39a285.webp","/amznews-reading-preview/_img/997a39e04c39a285.webp","/amznews-reading-preview/_img/997a39e04c39a285.webp 336w, /amznews-reading-preview/_img/997a39e04c39a285.webp 720w",1024,538,"广告/运营","广告投放","品牌","aihot","/items/bpjgo5z9n2bxahcqeaoe7b5ui","https://sellerelevate.com/brand-performance-spend-much-dtc-brand-put-each/","publisher-sellerelevate-written-rolling","name","SellerElevate 亚马逊广告与运营文章","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/3c5cd185312c2802.webp","iconSrcSet","/amznews-reading-preview/_img/3c5cd185312c2802.webp 48w, /amznews-reading-preview/_img/3c5cd185312c2802.webp 96w",{"_105":106},"changelogVersion","2026-10-09T22:08"]
