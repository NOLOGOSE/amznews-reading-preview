[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","bq7bxov6peht7lidjbqisj29k","revision",2,"title","Shoper数据：9月波兰电商销售额同比增13.1%，工具家具品类热销","originalTitle","9月波兰电商销售额增长13.1%，工具和家具产品热销","summary","电商平台服务商Shoper发布数据显示，2026年9月受调查约2万家网店销售额同比增长13.1%，创近12个月最高。增长主要由购买人数增加驱动，订单量同比增9.2%，平均订单金额仅微增3.5%至409.48波兰兹罗提。工具及建筑材料、家具品类表现突出，分别同比增长28.3%和22.7%。","reason","source",{"_9":102,"_103":104,"_84":105,"_106":40,"_107":108,"_109":110},"links",{"_99":100,"_68":101},"publishedAt","2026-10-16T01:55:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-16","discoveredAt","2026-10-16T14:43:50.715Z","timelineAt","category","product","tags",[96,97,98],"score",40,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","欧洲电商资讯","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","ft7DOFB2WYFk",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","3d96fd12-f2e4-4456-bccf-6eadbb21bec4","Shoper指数：波兰9月电商销售额同比增13.1%",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/bfcce16f896c4c47.webp","fullUrl","/amznews-reading-preview/_img/bfcce16f896c4c47.webp","srcSet","/amznews-reading-preview/_img/bfcce16f896c4c47.webp 336w, /amznews-reading-preview/_img/bfcce16f896c4c47.webp 720w","width","height","alt","poster","选品/市场","品类趋势","数据/报告","aihot","/items/bq7bxov6peht7li