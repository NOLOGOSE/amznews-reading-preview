[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","bu8v8a04mpkojic01gvf9sk1v","revision",1,"title","Shein 本地化从未落地：90% 收入仍来自中国仓，美国市场一季度营收下滑 14.3%","originalTitle","Shein's Localization Never Arrived","summary","Shein 递交的 IPO 招股书显示，其 2025 年超过 90% 的净收入仍来自先存放于中国中央仓库再发货的商品，本地化战略并未改变收入来源。2026 年第一季度美国营收同比下降 14.3% 至 20.4 亿美元，营业利润率从 3.9% 压缩至 2.9%，并转为季度净亏损。欧洲自 7 月 1 日起对每项海关商品分类征收 3 欧元费用，直接冲击其中国直发模式。","reason","source",{"_9":89,"_90":91,"_69":92,"_93":39,"_94":95,"_96":97},"links",{"_86":87,"_65":88},"publishedAt","2026-07-30T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T09:37:54.025Z","timelineAt","category","product","tags",[81,82,83,84,85],"score",38,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Ben Donovan","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Marketplace Pulse",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/ceb52237d93b2f87.webp","fullUrl","/amznews-reading-preview/_img/ceb52237d93b2f87.webp","srcSet","/amznews-reading-preview/_img/ceb52237d93b2f87.webp 336w, /amznews-reading-preview/_img/ceb52237d93b2f87.webp 720w","width","height","alt","poster","选品/市场","品类趋势","供应链","多平台销售","亚马逊","aihot","/items/bu8v8a04mpkojic01gvf9sk1v","https://www.marketplacepulse.com/articles/sheins-localization-never-arrived","author-marketplace-pulse-ben","name","Marketplace Pulse · Ben Donovan","web_list","firstParty","iconUrl","/amznews-read