[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","bxx2zbpb3l8j2tp7g6ilyiv5x","revision",2,"title","巧豚豚拆解 WOOT 提报规则与 Q4 广告补贴","originalTitle","WOOT可以0元提报？拆解亚马逊最新 WOOT 提报规则与 Q4 广告补贴","summary","原文来自 Frual 巧豚豚 - WOOT，存在相关商业利益，并非独立测评。作者介绍其理解的 WOOT 提报收费逻辑与 9.15–11.15 阶段性广告补贴规则：标准提报在活动周期内日均 GMV 达到 3500 美金可免提报费，第 7 轮 BD 起后续活动可免费参与；批次团购提报一次性提交 3 个及以上不同父体 ASIN，任意子体在活动期间日均 GMV 达到 1000 美金，对应父体免提报费，未达门槛则对应父体三轮提报费用为 199 美金。补贴需通过巧豚豚提报 Woot Deal，Deal 期间日均广告花费大于 30 美金，按单个 Campaign 的 ACoS 分档发放，各 Campaign 独立核算，档位不可叠加，最终补贴金额以后台核查结果为准。作者还介绍了六大智豚工具的定位及适合、不适合申报 Woot 的场景。以上规则与效果均为作者自述，本站尚未独立核验。","reason","source",{"_9":110,"_111":82,"_86":112,"_113":40,"_114":115,"_116":117},"links",{"_107":108,"_68":109},"publishedAt","2026-10-09T00:04:12.416Z","publishedPrecision","calendar","calendarDate","2026-10-09","discoveredAt","2026-10-09T01:54:31.355Z","timelineAt","category","advertising","tags",[104,105,106],"score",52,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","Frual 巧豚豚 - WOOT","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fiDcHLLPdST4",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","cf010500-c24c-43de-a4b1-33767fab9d08","WOOT提报规则与Q4广告补贴拆解",{"_77":78,"_13":79},"platform","知无不言",{"_86":87,"_88":101,"_90":102,"_92":103,"_94":-5,"_95":-5,"_96":-5,"_97":-5},{"_86":87,"_88":98,"_90":99,"_92":100,"_94":-5,"_95":-5,"_96":-5,"_97":-5},{"_86":87,"_88":89,