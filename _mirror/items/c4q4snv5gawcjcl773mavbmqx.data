[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","c4q4snv5gawcjcl773mavbmqx","revision",2,"title","中国9月出口额同比增长36.3%，贸易顺差达1335.3亿美元","originalTitle","9月中国出口额增长36.3%，贸易顺差持续扩大","summary","中国海关数据显示，2026年9月中国出口额同比增长36.3%，进口额增长31%，均超市场预期。当月贸易顺差扩大至1335.3亿美元，其中对美顺差创20个月新高，主要受AI相关产品、半导体及汽车出口强劲带动。尽管国内需求疲软，前三季度累计顺差已近1万亿美元，但中美欧贸易摩擦风险随之上升。","reason","source",{"_9":101,"_102":103,"_84":104,"_105":40,"_106":107,"_108":109},"links",{"_98":99,"_68":100},"publishedAt","2026-10-20T01:52:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-20","discoveredAt","2026-10-20T10:07:40.440Z","timelineAt","category","product","tags",[96,97],"score",22,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境物流资讯","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fzkSuuP2__T8",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","06d5d7c4-8585-4142-bb17-6eeea7cb26e1","中国9月出口增36.3%，贸易顺差扩至1335.3亿美元",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/7a0c24131f3fbf20.webp","fullUrl","/amznews-reading-preview/_img/7a0c24131f3fbf20.webp","srcSet","/amznews-reading-preview/_img/7a0c24131f3fbf20.webp 336w, /amznews-reading-preview/_img/7a0c24131f3fbf20.webp 720w","width","height","alt","poster","行业动态","品类趋势","aihot","/items/c4q4snv5gawcjcl773mavbmqx","https: