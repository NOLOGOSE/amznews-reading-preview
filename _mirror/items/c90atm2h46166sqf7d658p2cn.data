[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","c90atm2h46166sqf7d658p2cn","revision",1,"title","CPSC 拟将特定窗帘绳索列为重大产品危害","originalTitle","Substantial Product Hazard List: Amendments to Requirements for Window Covering Cords","summary","美国消费品安全委员会（CPSC）提议将存在特定绳索风险的窗帘产品列为“重大产品危害”，以应对勒颈风险。该提案涵盖定制窗帘中超过8英寸的自由悬挂操作绳、无张力装置的连续环等情形，公众意见征集截止至2026年11月23日。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":61,"_79":80,"_81":82},"links",{"_70":71,"_65":72},"publishedAt","2026-09-24T04:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:13:48.721Z","timelineAt","category","policy","tags",[68,69],"score",32,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_66":67},"detailedGuide","readingMode","full","author","Consumer Product Safety Commission","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","aihot","/items/c90atm2h46166sqf7d658p2cn","https://www.federalregister.gov/documents/2026/09/24/2026-19579/substantial-product-hazard-list-amendments-to-requirements-for-window-covering-cords","official-cpsc-federal-register","name","CPSC 美国消费品安全委员会 · 联邦公报","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/fb25db0934701e45.webp","iconSrcSet","/amznews-reading-preview/_img/fb25db0934701e45.webp 48w, /amznews-reading-preview/_img/fb25db0934701e45.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
