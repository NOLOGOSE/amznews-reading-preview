[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","c963fmzvytbe1h75hnsi8ket2","revision",5,"title","亚马逊 Account Health Assurance 计划：AHR 250 分门槛与防封号指南","originalTitle","How to Prevent an Amazon Account Suspension in 2026","summary","亚马逊提供 Account Health Assurance 计划，卖家需维持 AHR 250 分以上至少 6 个月并登记有效紧急联系人方可自动加入。该计划承诺在账户停用前由专员联系，若卖家在 72 小时内响应并配合解决，可避免账号被停用。此外，严重违规触发后有 3 天宽限期，但高 AHR 分数无法豁免假冒或安全类严重违规导致的直接停用风险。","reason","source",{"_9":104,"_105":106,"_72":107,"_108":39,"_109":110,"_111":112},"links",{"_101":102,"_65":103},"publishedAt","2026-09-15T22:06:38.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-09T05:26:55.161Z","timelineAt","category","policy","tags",[99,100],"score",48,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Chuck Kessler","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Canopy Management",{"_72":73,"_74":94,"_76":95,"_78":96,"_80":97,"_82":98,"_84":-5,"_85":-5},{"_72":73,"_74":90,"_76":91,"_78":92,"_80":93,"_82":93,"_84":-5,"_85":-5},{"_72":73,"_74":86,"_76":87,"_78":88,"_80":89,"_82":81,"_84":-5,"_85":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/9cd16b01c9898e52.webp","fullUrl","/amznews-reading-preview/_img/9cd16b01c9898e52.webp","srcSet","/amznews-reading-preview/_img/9cd16b01c9898e52.webp 336w, /amznews-reading-preview/_img/9cd16b01c9898e52.webp 720w","width",1024,"height",512,"alt","poster","/amznews-readin