[{"_1":2,"_3":4},"root",{"_5":122},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","caopwyl5yz22h4db46q4cvm4d","revision",2,"title","卖家实测亚马逊SBV视频广告：CTR高2倍但ACOS高8%及优化建议","originalTitle","我测试亚马逊SBV视频广告后，CTR高2倍、订单多3倍但ACOS高8%，新品到底该不该优先投视频？","summary","奋斗的青年分享其针对新品的亚马逊SBV视频广告实测结果，数据显示相比SP广告，SBV的点击率高2倍、订单多3倍，但ACOS高出8%。作者指出该测试受产品自然排名和上架初期流量影响，并总结了制作高转化率视频的最佳实践，包括前3秒出现人物可提升12% CTR、时长控制在15-30秒以及进行A/B测试等策略。文中还提及通过特定平台寻找达人合作制作视频素材的方法。","reason","source",{"_9":114,"_115":82,"_87":116,"_117":40,"_118":119,"_120":121},"links",{"_111":112,"_68":113},"publishedAt","2026-10-15T05:01:26.814Z","publishedPrecision","calendar","calendarDate","2026-10-15","discoveredAt","2026-10-15T05:49:22.613Z","timelineAt","category","advertising","tags",[108,109,110],"score",52,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","奋斗的青年","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fbk8F3PeoP7Y",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","5def8a0a-c8d7-4097-afae-d5f1fd06407c","卖家实测亚马逊SBV视频广告效果",{"_77":78,"_13":79},"platform","知无不言",{"_87":88,"_89":105,"_91":106,"_93":107,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":102,"_91":103,"_93":104,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":99,"_91":100,"_93":101,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5,"_97":-5,"_98":-5},"kind","image","url","/amznews-reading-preview/_img/d876215f2