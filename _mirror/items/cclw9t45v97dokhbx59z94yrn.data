[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","cclw9t45v97dokhbx59z94yrn","revision",2,"title","亚马逊推出自动购买功能：卖家需关注其对优惠券与调价的影响","originalTitle","Amazon Add to Auto Buy: Shoppers Set a Price and Wait","summary","亚马逊近期向 Prime 会员推出了“Add to Auto Buy”（自动购买）功能，允许用户设定目标价格并在商品降价时自动下单。据多方报道，该功能仅适用于亚马逊配送（FBA）的商品，且优惠券无法应用于此类订单。这意味着卖家的调价下限可能直接成为触发大量低价订单的开关，同时买家现在可以查看长达 365 天的历史价格，频繁波动的定价将变得透明。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T18:01:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:23.839Z","timelineAt","category","advertising","tags",[89,90,91],"score",62,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/498f429d45f791f4.webp","fullUrl","/amznews-reading-preview/_img/498f429d45f791f4.webp","srcSet","/amznews-reading-preview/_img/498f429d45f791f4.webp 336w, /amznews-reading-preview/_img/498f429d45f791f4.webp 720w","width",1600,"height",787,"alt","poster","/amznews-reading-preview/_img/0b137f064c4ae8a4.webp","/amznews-reading-preview/_img/0b137f064c4ae8a4.webp","/amznews-reading-preview/_img/0b137f064c4ae8a4.webp 336w, /amznews-reading-previ