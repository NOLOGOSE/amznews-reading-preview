[{"_1":2,"_3":4},"root",{"_5":154},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":63,"_64":39,"_65":66},"id","ceqk5grnb6gc5wlufyjzi0ed0","revision",2,"title","快时尚出海品牌 ZAFUL 正式破产：负债超8亿，月访问量暴跌至15万","originalTitle","SHEIN的老对手，正式破产","summary","深圳前海合作区人民法院于10月15日正式裁定宣告飒芙（ZAFUL母公司）破产。截至2025年9月30日，飒芙总负债高达8.13亿元，净资产为负7.35亿元；其独立站月均访问量从巅峰期的1.07亿暴跌至15.2万，亚马逊美国站近30天预估销售额约145.6万美元，同比减少约63万美元。","reason","source",{"_9":145,"_146":147,"_90":148,"_149":39,"_150":151,"_152":153},"links",{"_142":143,"_66":144},"publishedAt","2026-10-19T06:25:25.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T06:40:44.036Z","timelineAt","category","product","tags",[139,140,141],"score",52,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","media",[81,82,83,84,85,86,87,88,89],"byline",{"_52":-5,"_79":80},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[78],"indexable","markdownAvailable",true,"group",{"_67":68,"_42":69,"_70":71,"_72":73,"_74":73},"hasTranslation","bodyLanguage","original","factId","f8HND7x2BoRo",{"_75":76,"_13":77},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","2bc7d969-7d76-4b87-bc4e-caccdd7b398d","跨境通子公司飒芙（ZAFUL）被裁定破产",{"_75":76,"_13":77},"platform","蓝海亿观网",{"_90":91,"_92":134,"_94":135,"_96":136,"_98":137,"_100":138,"_102":-5,"_103":-5},{"_90":91,"_92":130,"_94":131,"_96":132,"_98":99,"_100":133,"_102":-5,"_103":-5},{"_90":91,"_92":126,"_94":127,"_96":128,"_98":99,"_100":129,"_102":-5,"_103":-5},{"_90":91,"_92":122,"_94":123,"_96":124,"_98":99,"_100":125,"_102":-5,"_103":-5},{"_90":91,"_92":118,"_94":119,"_96":120,"_98":99,"_100":121,"_102":-5,"_103":-5},{"_90":91,"_92":114,"_94":115,"_9