[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","cf7t60y1gscv83z7opd2oktgu","revision",1,"title","TikTok 测试 TikTok Shop Plus 会员以对标 Amazon Prime","originalTitle","TikTok Is Testing TikTok Shop Plus to Compete With Amazon Prime","summary","TikTok 在美国测试付费购物会员 TikTok Shop Plus，提供免运费、专属折扣等权益以增强用户留存。该功能旨在减少用户因物流优势转向 Amazon Prime，配合 FBT 及多渠道履约完善基础设施。GeekSeller 指出卖家已利用 TikTok 库存处理来自 Walmart、Amazon 等平台的订单，显示其正从发现渠道向综合销售与履约平台演进。","reason","source",{"_9":87,"_88":89,"_69":90,"_91":39,"_92":93,"_94":95},"links",{"_84":85,"_65":86},"publishedAt","2026-10-04T21:11:43.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T18:36:27.972Z","timelineAt","category","policy","tags",[81,82,83],"score",42,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":-5,"_66":67},"detailedGuide","readingMode","full","author","GeekSeller Editorial Team","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","GeekSeller",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/ff3c466222b1b2fa.webp","fullUrl","/amznews-reading-preview/_img/ff3c466222b1b2fa.webp","srcSet","/amznews-reading-preview/_img/ff3c466222b1b2fa.webp 336w, /amznews-reading-preview/_img/ff3c466222b1b2fa.webp 720w","width","height","alt","poster","行业动态","多平台销售","亚马逊","aihot","/items/cf7t60y1gscv83z7opd2oktgu","https://www.geekseller.com/blog/tiktok-is-testing-tiktok-shop-plus-to-compete-with-amazon-prime/","publisher-geekseller-blog","name","GeekSeller · 多平台卖家博客","rss","firstParty","i