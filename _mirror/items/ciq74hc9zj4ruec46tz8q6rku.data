[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","ciq74hc9zj4ruec46tz8q6rku","revision",2,"title","作者自述：45天内开设14个批发账户的案例","originalTitle","14 wholesale accounts in 45 days.","summary","作者自述案例：Jett做了2.5年零售套利，月收入约6万美元；他看到平台门槛限制趋严，希望转向更持久的业务。他自行尝试品牌直供6个月，谈下几个品牌。因其业务架构已就绪，作者称双方直接聚焦目标品牌与推销策略。作者强调，在亚马逊销售与开设品牌账户是两种不同技能。以上为作者个人经验陈述，本站尚未独立核验。","reason","source",{"_9":111,"_112":113,"_94":114,"_115":39,"_116":-5},"links",{"_108":109,"_68":110},"publishedAt","2026-10-20T15:05:08.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-20T15:05:41.760Z","timelineAt","category","advertising","tags",[106,107],"score",18,"selected",false,"channel","x","story",{"_77":78,"_13":14},{"_84":85,"_86":52,"_87":88,"_89":90,"_91":-5,"_45":92},"media",[],"byline","detailedGuide","readingMode","full","author","1000asins","language","en","body",{"_80":-5,"_68":81,"_82":-5,"_83":63},"outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fL1wc1zk5q-c",{"_77":78,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","088fbb86-ed7d-4401-a8f4-d40b4b6a83aa",{"_77":78,"_13":14},"zh","<p>14 wholesale accounts in 45 days.</p><p>Jett has done retail arbitrage for 2.5 years, around $60K a month. He watched gating get stricter and wanted something that lasts.</p><p>He spent 6 months trying brand direct on his own and landed a couple of brands.</p><p>His business was already set up, so we skipped straight to which brands to target and how to pitch them.</p><p>Selling on Amazon and opening brand accounts are two different skills.</p>","zhKind","complete","authorName","Dan Boufford","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[93],{"_94":95,"_96":97,"_98":99,"_100":101,"_102":103,"_104":-5,"_105":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",587,"height",202,"alt","poster","广告/运营","多平台销售","aihot","/items/ciq74hc9zj4ruec46tz8q6rku","https://x.com/1000asins/status/2112560758508638517","x-dan-boufford","name","X · Dan Boufford","x_search","firstParty","iconUrl",{"_118":119},"changelogVersion","2026-10-09T22:08"]
