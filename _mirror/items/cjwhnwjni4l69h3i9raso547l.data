[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","cjwhnwjni4l69h3i9raso547l","revision",2,"title","亚马逊变体评论共享调整后，新变体做站外为何退货上升","originalTitle","父体4.6星，为什么新变体一做站外就退货？","summary","作者亚马逊站外推广仔称，亚马逊在2026年2月12日至5月31日期间按品类逐步调整变体间的评论共享，判断核心是变体差异是否影响产品功能，功能或规格差异明显的子体不再天然共享同一组评论；该政策主张来自作者自述，未提供可核验的官方出处，本站未独立验证。作者据此提出，新变体做站外前应建立子体证据卡，写清独有规格与不适用条件，并核对折扣链接是否落到目标子ASIN。文中以脱敏演示案例说明，沿用父体4.6星与碎冰卖点推广迷你款，可能导致消费者带着标准款预期下单，进而出现退货。原文多次正面提及VIPON，存在相关商业利益，并非独立测评。","reason","source",{"_9":96,"_97":67,"_71":98,"_99":39,"_100":101,"_102":103},"links",{"_93":94,"_65":95},"publishedAt","2026-09-21T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T12:46:21.785Z","timelineAt","category","advertising","tags",[89,90,91,92],"score",62,"selected",false,"channel","news","story","x","media",[68,69,70],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","亚马逊站外推广仔","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_71":72,"_73":86,"_75":87,"_77":88,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":83,"_75":84,"_77":85,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":-5,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/b5f4c6888df92093.webp","fullUrl","/amznews-reading-preview/_img/b5f4c6888df92093.webp","srcSet","/amznews-reading-preview/_img/b5f4c6888df92093.webp 336w, /amznews-reading-preview/_img/b5f4c6888df92093.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/1008551e5d2afe10.webp","/amznews-reading-preview/_i