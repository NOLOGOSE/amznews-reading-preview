[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","cl0zg02ouqu8ci90zlndo8nvf","revision",1,"title","亚马逊PPC零销词累积致损","originalTitle","Amazon PPC accounts rarely bleed out from one insanely bad keyword.","summary","亚马逊 PPC 账户很少因一个极差的关键词而严重亏损。\n\n通常是 100 个关键词花费 $8… $12… $17… 却没有产生销售。\n\n单独看它们似乎无害。\n\n但加起来每月可能高达数千美元。\n\n这就是为什么账户层面的清理至关重要。","reason","source",{"_9":85,"_86":87,"_88":89,"_90":39,"_91":-5},"links",{"_82":83,"_66":84},"publishedAt","2026-10-15T00:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.560Z","timelineAt","category","advertising","tags",[80,81],"score",22,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Evan_Swanson_","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Amazon PPC accounts rarely bleed out from one insanely bad keyword.</p><p>It’s usually 100 keywords spending $8… $12… $17… with no sales.</p><p>Individually they look harmless.</p><p>Together they can be thousands a month.</p><p>This is why account-level cleanup matters.</p>","zhKind","complete","authorName","Evan Swanson","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"广告/运营","广告投放","aihot","/items/cl0zg02ouqu8ci90zlndo8nvf","https://x.com/Evan_Swanson_/status/2110528584045760571","x-evan-swanson","name","X · Evan Swanson","kind","x_search","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
