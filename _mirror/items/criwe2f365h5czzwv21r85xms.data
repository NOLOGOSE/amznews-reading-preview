[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","criwe2f365h5czzwv21r85xms","revision",2,"title","发往IMO1/IMWA6等仓库的FBA货件被\"Reserved\"卡死？教你开英文CASE快速催上架","originalTitle","血泪教训！发往IMO1/IMWA6等仓库的货全“Reserved”卡死？教你如何快速催上架！！","summary","部分卖家发往IMII、IMO1、IWA6、IMS1、INC1、IAZ1等仓库的FBA货件被接收后长期显示预留状态，等了一个多月仍未上架，打乱备货计划。国内客服反馈这些货物暂存特殊仓库、无法加快中转运出，建议改开英文CASE联系国外客服，提供Shipment ID和入仓接收邮件截图，并强调产品为季节性、日销XX单、7天内将断货。已有卖家反馈小部分库存已上架。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-09-27T22:41:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:20:55.560Z","timelineAt","category","fba","tags",[68,69,70],"score",38,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","跟着阿杜学跨境电商","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123","FBA/物流","库存管理","亚马逊","aihot","/items/criwe2f365h5czzwv21r85xms","https://www.amz123.com/t/CLig4cqM","author-amz123-adu-reviewed","name","AMZ123 · 跟着阿杜学跨境电商","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
