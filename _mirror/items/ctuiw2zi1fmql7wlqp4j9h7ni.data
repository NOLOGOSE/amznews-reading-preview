[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":62,"_63":38,"_64":65},"id","ctuiw2zi1fmql7wlqp4j9h7ni","revision",2,"title","TikTok巴西数据中心未来6个月内开建，投资500亿雷亚尔","originalTitle","summary","巴西矿业与能源部长席尔维拉宣布，TikTok巴西数据中心将于未来6个月内开建，选址塞阿拉州佩塞姆港口综合体。该项目由字节跳动与风能开发商Casa dos Ventos联合推进，投资达500亿雷亚尔（约91.1亿美元），并获卢拉政府联邦税收减免支持。项目落地后将缓解巴西短视频加载与直播延迟，提升拉美数据基础设施竞争力，并为TikTok Shop巴西业务扩张铺路。","reason","source",{"_9":101,"_102":103,"_81":104,"_105":38,"_106":107,"_108":109},"links",{"_98":99,"_65":100},"publishedAt","2026-10-15T07:04:59.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:54.164Z","timelineAt","category","policy","tags",[95,96,97],"score",33,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","media",[80],"byline",{"_51":-5,"_78":79},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[77],"indexable","markdownAvailable",true,"group",{"_66":67,"_41":68,"_69":70,"_71":72,"_73":72},"hasTranslation","bodyLanguage","original","factId","fDB0n10t3a3Q",{"_74":75,"_13":76},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","a10219fe-904e-4f7a-ae29-1105c7f42698","TikTok巴西数据中心拟6个月内开建",{"_74":75,"_13":76},"platform","蓝海亿观网",{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5},"kind","image","url","/amznews-reading-preview/_img/57fa124613db42c0.webp","fullUrl","/amznews-reading-preview/_img/57fa124613db42c0.webp","srcSet","/amznews-reading-preview/_img/57fa124613db42c0.webp 336w, /amznews-reading-preview/_img/57fa124613db42c0.webp 720w","width",760,"height",400,"alt","poster","政策/合规","亚马逊","FBA/物流","aihot","/items/ctuiw2zi1fmql7wlqp4j9h7ni","https:/