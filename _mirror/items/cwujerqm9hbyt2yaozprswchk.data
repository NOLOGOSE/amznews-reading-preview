[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","cwujerqm9hbyt2yaozprswchk","revision",4,"title","2023广告衡量简报：先区分认知与转化目标","originalTitle","Research Briefing: Amazon courts non-Amazon selling brands with display ads — marketers’ second most-used ad channel","summary","Catherine Wolf于2023年8月31日发表于Modern Retail的免费研究简报，讨论展示广告可以承担品牌认知或转化目标，不同目标需要不同衡量指标。本站整理的复盘问题是：这次投放希望更多人认识品牌，还是带来购买；现有记录能说明曝光、点击或销售中的哪一环；是否把不同目标和不同投放方式的数据混在一起比较。先写清目标与口径，再观察指标变化，不能仅凭点击率推断盈利。原文调查比例和当时的广告资格变化属于出版社研究或2023报道，未经本站独立验证，不代表今天的市场比例、账户权限或可复制ROI。当前可投放范围需在官方广告账户另核。本文完整读取的是免费简报，会员完整研究未读取；出版社推广会员和调查项目的商业利益保留说明。只提供有限原创中文导读，保留真实作者、原发日期和原稿入口，不转载研究全文、图片或译文，也不把历史内容列为今天新政策。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2023-08-31T17:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-03T04:01:37.568Z","timelineAt","category","advertising","tags",[88,89,90,91],"score",62,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Catherine Wolf","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Modern Retail",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":81,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/a73c8b28488ddced.webp","fullUrl","/amznews-reading-preview/_img/a73c8b28488ddced.webp","srcSet","/amznews-reading-preview/_img/a73c8b28488ddced.webp 336w, /amznews-reading-preview/_img/a73c8b28488ddced.webp 720w","width",619,"height",585,"alt","poster","/amznews-reading-preview/_img/5d89530dfb7ed2ea.webp","/amznews-reading-preview/_img/5d89530dfb7ed2ea.webp","/amznews-reading-preview/_img/5d89530dfb7ed2ea.webp 336w, /amznews-reading-preview/_img/5d89530dfb7ed2ea.webp 720w",543,"数据/报告","广告投放","亚马逊","Amazon Ads","aihot","/items/cwujerqm9hbyt2yaozprswchk","https://www.modernretail.co/marketing/research-briefing-amazon-courts-non-amazon-selling-brands-with-display-ads-marketers-second-most-used-ad-channel/","author-modern-retail-catherine-ad-metrics-reviewed","name","Modern Retail · Catherine Wolf","rss","firstParty","iconUrl","/amznews-reading-preview/_img/feec9bcddc707257.webp","iconSrcSet","/amznews-reading-preview/_img/feec9bcddc707257.webp 48w, /amznews-reading-preview/_img/feec9bcddc707257.webp 96w",{"_105":106},"changelogVersion","2026-10-09T22:08"]
