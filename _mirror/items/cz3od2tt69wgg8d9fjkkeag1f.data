[{"_1":2,"_3":4},"root",{"_5":126},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","cz3od2tt69wgg8d9fjkkeag1f","revision",2,"title","亚马逊卖家求助：A产品降价加券曝光高转化低，B产品因类目错放排名暴跌","originalTitle","# Amazon案例分析 # A产品降价到17.99还配了15%优惠券，曝光5.3万却只出了39单，手动精准加了顶部和其余位置40%bid反而单更少，是不是因为竞价不够没占到顶部，还是链接只有一个评论转化太差？","summary","卖家分享A产品在17.99美元售价配15%优惠券下，曝光53,600仅出39单，手动精准3组竞价0.8加顶部和其余位置40%的bid后订单反降，作者不确定是否因CPC够不到顶部或链接仅一个评论致转化差。B产品因平台放错类目致小类排名从31跌至2852，卖家关闭广告等待Vine计划回评以翻新链接。此外，A产品因图片风格相似被判定版权侵权申诉失败，卖家咨询是否需找服务商“内部恢复”，原文提到服务商报价2300，存在相关商业利益，并非独立测评。","reason","source",{"_9":118,"_119":82,"_88":120,"_121":40,"_122":123,"_124":125},"links",{"_115":116,"_68":117},"publishedAt","2026-10-11T21:07:57.394Z","publishedPrecision","calendar","calendarDate","2026-10-12","discoveredAt","2026-10-12T07:44:25.443Z","timelineAt","category","advertising","tags",[112,113,114],"score",18,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87],"byline",{"_53":-5,"_81":82},"detailedGuide","readingMode","full","author","123132","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fawHq2Vqg0Qg",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","839dc835-13d0-4ace-b143-3ebb2366e29a","亚马逊卖家广告转化困境与类目错放风波",{"_77":78,"_13":79},"platform","知无不言",{"_88":89,"_90":109,"_92":110,"_94":111,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":106,"_92":107,"_94":108,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":103,"_92":104,"_94":105,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":100,"_92":101,