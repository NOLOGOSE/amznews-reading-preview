[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","d34kgo07qhmaglo4uz1mzkjwl","revision",2,"title","UK OPSS 通报 Xin Yue AC PC Power Cable 存在火灾风险","originalTitle","Product Safety Report: Xin Yue AC PC Power Cable (2610-0158)","summary","UK OPSS 通报 Xin Yue AC PC Power Cable（型号 8784）因插头假冒、不符合 BS 1363 尺寸要求且缺少镇流器，存在火灾风险。该电缆导体截面积实测约 0.493 mm²，远低于标称的 0.75 mm²，易导致过热起火。S&S Cash and Carry 已将该商品从市场撤回并销毁。","reason","source",{"_9":87,"_88":89,"_90":91,"_92":62,"_93":94,"_95":96},"links",{"_84":85,"_67":86},"publishedAt","2026-10-22T13:59:17.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T21:14:29.562Z","timelineAt","category","policy","tags",[82,83],"score",15,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":-5,"_80":81},"detailedGuide","readingMode","full","author","Office for Product Safety and Standards","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fXw7D2hrFKkQ",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","a45b2756-2c8c-496f-b85a-64ffec394b85","UK OPSS 通报 Xin Yue 电源线火灾风险",{"_76":77,"_13":78},"platform","UK OPSS","政策/合规","合规税务","aihot","/items/d34kgo07qhmaglo4uz1mzkjwl","https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-report-counterfeit-xin-yue-ac-pc-power-cable-2610-0158","official-uk-opss-rolling","name","UK OPSS 产品安全公告","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/1fbf571bfada1bb0.webp","iconSrcSet","/amznews-reading