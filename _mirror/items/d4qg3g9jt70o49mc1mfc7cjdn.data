[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","d4qg3g9jt70o49mc1mfc7cjdn","revision",1,"title","推文转述FTC诉讼文件：一名亚马逊员工曾咨询ChatGPT","originalTitle","Personally, I would have called it “profit extraction lever”","summary","作者guyfosel在推文中转述@eric_seufert的引述：后者称在阅读美国司法部针对谷歌的“广告技术”诉讼时，惊讶于员工在邮件中讨论敏感话题；随后提到，亚马逊员工可能对内部沟通有同样想法，其中一人决定咨询ChatGPT，并称该内容来自美国联邦贸易委员会（FTC）对亚马逊的诉讼文件。上述内容为推文转述，本站尚未独立核验相关诉讼文件。","reason","source",{"_9":93,"_94":95,"_96":97,"_98":39,"_99":-5},"links",{"_90":91,"_66":92},"publishedAt","2026-09-02T01:23:37.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:16.934Z","timelineAt","category","policy","tags",[88,89],"score",7,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":79,"_44":80},"media",[],"byline","detailedGuide","readingMode","full","author","guyfosel","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Personally, I would have called it “profit extraction lever”</p>","zhKind","complete","authorName","Bearded Egg FBA 🛠️","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_71":81,"_73":82,"_83":84,"_85":86,"_87":-5},[],"Eric Seufert","eric_seufert","text","In reading the DoJ's \"ad tech\" suit against Google, I was surprised by how freely employees discussed highly sensitive topics over email. \n\nAmazon employees may have had the same thought regarding internal comms, so one decided...to consult ChatGPT.\n\nFrom the FTC's Amazon suit:","url","https://x.com/eric_seufert/status/2094875125820571853","translation","政策/合规","亚马逊","aihot","/items/d4qg3g9jt70o49mc1mfc7cjdn","https://x.com/guyfosel/status/2094959399408112000","x-bearded-egg-fba","name","X · Bearded Egg FBA","kind","x_search","firstParty","iconUrl",{"_101":102},"changelogVersion","2026-10-09T22:08"]
