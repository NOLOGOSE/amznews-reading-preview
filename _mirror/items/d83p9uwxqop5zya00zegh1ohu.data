[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":-5,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","d83p9uwxqop5zya00zegh1ohu","revision",1,"title","亚马逊推出 FBA 评级和转售服务，助卖家从退货中收回价值","originalTitle","借助 FBA 评级和转售，让退货重获新生","summary","亚马逊为使用 FBA 的卖家提供“评级和转售”服务，通过检查并重新上架符合条件的退货商品，帮助卖家从买家退货中收回价值。该服务将退货分为“类似新品”、“非常好”、“良好”或“可接受”四种二手条件，并向买家提供详细状况描述。案例显示 JB Tools 借此收回超过 50 万美元，卖家可简化退货管理并支持可持续发展。","reason","source",{"_9":88,"_89":90,"_68":91,"_92":60,"_93":-5},"links",{"_85":86,"_64":87},"publishedAt","2025-09-10T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2025-09-11","discoveredAt","2026-10-16T15:14:35.013Z","timelineAt","category","fba","tags",[82,83,84],"score","selected",false,"channel","news","story","x","media",[67],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊卖家官方博客",{"_68":69,"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/2146066fe4780b10.webp","fullUrl","/amznews-reading-preview/_img/2146066fe4780b10.webp","srcSet","/amznews-reading-preview/_img/2146066fe4780b10.webp 336w, /amznews-reading-preview/_img/2146066fe4780b10.webp 720w","width",588,"height",331,"alt","poster","FBA/物流","退货管理","亚马逊","aihot","/items/d83p9uwxqop5zya00zegh1ohu","https://sell.amazon.com/zh/blog/announcements/fba-grade-and-resell","official-amazon-seller-announcements","name","亚马逊卖家官方博客 · 公告","web_list","firstParty","iconUrl",{"_95":96},"changelogVersion","2026-10-09T22:08"]
