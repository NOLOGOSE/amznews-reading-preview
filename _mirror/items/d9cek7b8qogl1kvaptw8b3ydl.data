[{"_1":2,"_3":4},"root",{"_5":131},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","d9cek7b8qogl1kvaptw8b3ydl","revision",3,"title","亚马逊封锁 Meta Muse 购物权限并起诉退款欺诈团伙","originalTitle","Amazon Locks Meta's Muse Out of Its Marketplace — Here's Why That Matters","summary","亚马逊阻止 Meta 的 Muse AI 代理在 Amazon.com 完成购买，坚持仅允许自家 Rufus 和 Alexa 处理智能体购物。Meta 随即转向推出面向小企业的 Muse，连接 Shopify、QuickBooks 等后台软件但不含 Seller Central。此外，亚马逊起诉一个利用虚假警方报告骗取约 400 万美元 GPU 和笔记本电脑退款的哈萨克斯坦团伙。","reason","source",{"_9":122,"_123":124,"_86":125,"_126":39,"_127":128,"_129":130},"links",{"_119":120,"_67":121},"publishedAt","2026-10-08T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T14:22:23.554Z","timelineAt","category","policy","tags",[116,117,118],"score",62,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[81,82,83,84,85],"byline",{"_52":-5,"_80":53},"detailedGuide","readingMode","full","author","SellerBites","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fsy1nNfNCtbo",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","e254d365-616e-4cd9-a672-0f1b6bcacbbb","亚马逊封锁Meta Muse购物代理访问",{"_76":77,"_13":78},"platform",{"_86":87,"_88":113,"_90":114,"_92":115,"_94":-5,"_96":-5,"_98":-5,"_99":-5},{"_86":87,"_88":108,"_90":109,"_92":110,"_94":111,"_96":112,"_98":-5,"_99":-5},{"_86":87,"_88":105,"_90":106,"_92":107,"_94":103,"_96":104,"_98":-5,"_99":-5},{"_86":87,"_88":100,"_90":101,"_92":102,"_94":103,"_96":104,"_98":-5,"_99":-5},{"_86":87,"_88":89,"_90":91,"_92