[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","d9zdaxw1b1rl0g7za0q1hzo31","revision",3,"title","codex 连接不上 Chrome、扩展程序无法重新安装，更换代理节点也无效，有卖家遇到过吗？","originalTitle","codex连接不上chrome的问题，小红书上查了一下说更换网络代理节点可以解决问题，我试了一下都没用，哪位高人碰到过这样的问题呢，最后怎么解决的？","summary","有用户反馈，用 codex 处理 Shopify 独立站问题时，Chrome 里的 ChatGPT 扩展程序导致 codex 反复无法连接 Chrome、读取标签页信息。按 codex 建议移除扩展后，从「codex 设置＞电脑操控＞Google chrome 安装」路径跳转 Chrome 应用商店时提示无法找到或购买，按小红书说法更换网络代理节点也未解决，现求助是否有其他人遇到并解决过该问题。","reason","source",{"_9":74,"_75":67,"_76":77,"_78":39,"_79":80,"_81":82},"links",{"_71":72,"_65":73},"publishedAt","2026-09-25T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:45:54.283Z","timelineAt","category","ai-tools","tags",[68,69,70],"score",8,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","阿黄Islander","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","AI/工具","AI工具","卖家工具","aihot","/items/d9zdaxw1b1rl0g7za0q1hzo31","https://www.wearesellers.com/question/124961","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
