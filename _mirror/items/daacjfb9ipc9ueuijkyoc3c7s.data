[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","daacjfb9ipc9ueuijkyoc3c7s","revision",1,"title","亚马逊在 Prime Big Deal Days 前后裁减 Stores 部门职位","originalTitle","Amazon Cut Jobs in Seller Support — Right in the Middle of Big Deal Days","summary","亚马逊确认裁减 Stores 部门不足 1,000 个白领职位，涉及美国、印度和英国员工，据 Reuters 报道（经 Khaleej Times 转引）。据 Fox 13 Tampa Bay 援引的内部 Slack 帖，客服和销售伙伴服务团队在受影响之列；亚马逊仅表示“调整了 Stores 业务的部分环节”，未确认 Seller Support 被裁。原文建议卖家对影响收入的问题（如被抑制的 Listing、被冻结的资金、账户健康标记）通过电话、聊天、客户经理等多渠道升级处理；原文称工单变慢可能与此有关，属推测。","reason","source",{"_9":103,"_104":105,"_72":106,"_107":40,"_108":109,"_110":111},"links",{"_100":101,"_66":102},"publishedAt","2026-10-16T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-16","discoveredAt","2026-10-19T17:56:54.377Z","timelineAt","category","policy","tags",[98,99],"score",40,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_52":-5,"_67":53},"detailedGuide","readingMode","full","author","SellerBites","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform",{"_72":73,"_74":94,"_76":95,"_78":96,"_80":97,"_82":38,"_84":-5,"_85":-5},{"_72":73,"_74":91,"_76":92,"_78":93,"_80":89,"_82":90,"_84":-5,"_85":-5},{"_72":73,"_74":86,"_76":87,"_78":88,"_80":89,"_82":90,"_84":-5,"_85":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/fdcfc292c1e612af.webp","fullUrl","/amznews-reading-preview/_img/fdcfc292c1e612af.webp","srcSet","/amznews-reading-preview/_img/fdcfc292c1e612af.webp 336w, /amznews-reading-preview/