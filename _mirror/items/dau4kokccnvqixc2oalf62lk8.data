[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","dau4kokccnvqixc2oalf62lk8","revision",1,"title","亚马逊卖家周报：鞋类品牌限制引发担忧，Listing Protection 计划年底上线","originalTitle","Footwear Gating Concerns | Positive Amazon News | Stubborn Appeals Resolved","summary","亚马逊计划于年底前推出 Listing Protection 功能，允许符合条件的卖家在解决违规或申诉期间保持商品详情页活跃。同期，卖家论坛反映亚马逊对品牌鞋类的限制日益严格，引发对消费者选择及库存可用性的担忧。此外，假日配送费将于10月15日启动，Q4标准尺寸仓储费率将增至三倍。","reason","source",{"_9":76,"_77":78,"_79":80,"_81":40,"_82":83,"_84":85},"links",{"_73":74,"_66":75},"publishedAt","2026-10-08T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-08","discoveredAt","2026-10-13T14:19:19.092Z","timelineAt","category","policy","tags",[69,70,71,72],"score",34,"selected",false,"channel","news","story","x","media",[],"byline",{"_52":-5,"_67":68},"detailedGuide","readingMode","full","author","admin","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","ASGTG","政策/合规","亚马逊","FBA/物流","费用变更","aihot","/items/dau4kokccnvqixc2oalf62lk8","https://asgtg.com/footwear-gating-concerns-positive-amazon-news-stubborn-appeals-resolved/","publisher-asgtg-official-blog-rolling","name","ASGTG · 官方卖家周报","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cb7e87c8dd6d977d.webp","iconSrcSet","/amznews-reading-preview/_img/cb7e87c8dd6d977d.webp 48w, /amznews-reading-preview/_img/cb7e87c8dd6d977d.webp 96w",{"_87":88},"changelogVersion","2026-10-09T22:08"]
