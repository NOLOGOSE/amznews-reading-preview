[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","ddojjud6hi92xhq7x4h5gwriy","revision",2,"title","大型亚马逊卖家如何用AI：把一个月的工作压缩到一天","originalTitle","How Bigger Amazon Sellers Use AI: A Month of Work in a Day","summary","原文作者Nhan Dinh在Seller Labs博客中讲述两位亚马逊卖家的个人经验：一位七位数规模的转售卖家自行用Claude搭建仪表盘，在完成约一年的产品数据治理后，将Listing创建从团队耗时一个月缩短至一天（作者转述其说法为“至少”如此），并由团队逐条审核Listing后再上线；另一位八位数、85人品牌的创始人于2025年12月终止月费约1.5万美元的广告代理合作，通过Seller Labs的MCP Server将Claude接入其亚马逊数据，自行管理约40个广告活动，并逐项批准AI提出的广告改动。原文来自Seller Labs，其推广自家MCP Server，存在相关商业利益，并非独立测评。文中关于节省金额、广告支出、点击成本、销量增长及90%新品售出等效果数字均为作者转述的个案自述，本站尚未独立核验，不能推广为普遍结论。","reason","source",{"_9":91,"_92":81,"_93":94,"_95":39,"_96":97,"_98":99},"links",{"_88":89,"_67":90},"publishedAt","2026-10-19T13:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T14:06:41.404Z","timelineAt","category","ai-tools","tags",[82,83,84,85,86,87],"score",42,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Nhan Dinh","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fti4fNTIEke0",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","c553a039-ac60-48fe-b529-f5f1015c8858","Seller Labs 谈亚马逊卖家如何用 AI 管理广告",{"_76":77,"_13":78},"platform","Seller Labs","AI/工具","AI工具","卖家工具","Listing优化","广告投放","亚马逊","aihot","/items/ddojjud6hi92xhq7x4h5gwriy","https://www.sellerlabs.com/blog/how-bigger-amazon-sellers-use-ai/","rss-sellerlabs-prelaunch","name","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp","iconSrcSet","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 48w, /amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 96w",{"_101":102},"changelogVersion","2026-10-09T22:08"]
