[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","de9npv4m6m28brebl1qkjzkhi","revision",1,"title","亚马逊在英国达灵顿首次部署Prime Air无人机配送","originalTitle","Amazon deploys drones outside U.S. for 1st time","summary","亚马逊自2月起在英格兰达灵顿一处大型履约中心启用Prime Air无人机配送，这是该服务首次在美国以外落地。据亚马逊网站文章，服务使用MK30无人机，订单可在60分钟或更短时间内送达；目前面向达灵顿该履约中心7.5英里半径内拥有garden、yard或driveway的客户，商品重量不超过5磅（2.2千克）且能装入大鞋盒时可选择无人机配送。原文称目前英国Prime Air配送包含在Prime会员权益内，并称未来向更广区域扩展时将评估与其它优先时效服务一致的配送费。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":39,"_79":80,"_81":82},"links",{"_70":71,"_65":72},"publishedAt","2026-08-17T12:55:18.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:42.356Z","timelineAt","category","fba","tags",[68,69],"score",12,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves","FBA/物流","亚马逊","aihot","/items/de9npv4m6m28brebl1qkjzkhi","https://www.freightwaves.com/news/amazon-deploys-drones-outside-u-s-for-1st-time","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
