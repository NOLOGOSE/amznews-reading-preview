[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","dhw9wen02foydpmaw5axcfv13","revision",2,"title","Google 在美国逐步推出 Universal Cart，支持跨零售商保存商品","originalTitle","Google Launches Universal Cart for Shopping Across Multiple Retailers","summary","Google 已开始在美国逐步推出 Universal Cart，允许用户在 Google 搜索和 Gemini 应用中保存来自不同零售商的商品。原文称该功能于 10 月 15 日开始逐步推出，未注明该日期所属年份。原文列出的参与零售商包括 Walmart、Target、Nike、Sephora、Ulta Beauty、Wayfair 及部分 Shopify 商家。结账方式因商家而异：部分商家可在 Google 内直接购买，其他则跳转至商家网站；共享购物车不等于合并结账。商家仍是记录卖方，并负责订单确认与客服。","reason","source",{"_9":101,"_102":103,"_83":104,"_105":39,"_106":107,"_108":109},"links",{"_98":99,"_67":100},"publishedAt","2026-10-22T00:06:45.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T18:36:27.943Z","timelineAt","category","advertising","tags",[95,96,97],"score",38,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82],"byline",{"_52":-5,"_80":81},"detailedGuide","readingMode","full","author","GeekSeller Editorial Team","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","flgI6pcZZeiE",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","845e5817-acea-464a-8129-a83b36bcdf5e","Google 在美国逐步推出 Universal Cart",{"_76":77,"_13":78},"platform","GeekSeller",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":-5,"_93":-5,"_94":-5},"kind","image","url","/amznews-reading-preview/_img/ee134d277bf0cf83.webp","fullUrl","/amznews-reading-preview/_img/ee134d277bf0cf83.webp","srcSet","/amznews-reading-previe