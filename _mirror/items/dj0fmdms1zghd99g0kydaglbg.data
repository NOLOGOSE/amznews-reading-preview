[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","dj0fmdms1zghd99g0kydaglbg","revision",2,"title","Mike Begg 分享家居品牌通过 Bid-and-Budget Rebalance 策略实现销量增长与 ACOS 降低的案例","originalTitle","How a home goods brand grew sales 54.6% in a week while cutting ACOS from 24.35% to 13.79%","summary","Mike Begg 分享一个家居品牌案例：通过“Bid-and-Budget Rebalance”策略，该品牌周销售额从 $11,981.70 增至 $18,527.10（增长 54.6%），同时 ACOS 从 24.35% 降至 13.79%。该策略核心在于根据表现重新分配预算和出价，将资金集中于高转化目标并削减低效支出，而非单纯增加总预算。此为作者提供的个案经验，具体效果因账户而异。","reason","source",{"_9":102,"_103":54,"_83":104,"_105":40,"_106":107,"_108":109},"links",{"_99":100,"_68":101},"publishedAt","2026-10-12T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-12","discoveredAt","2026-10-12T15:15:27.241Z","timelineAt","category","advertising","tags",[96,97,98],"score",30,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[82],"byline",{"_53":-5,"_81":54},"detailedGuide","readingMode","full","author","Mike Begg","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f4YB1vPmbsL8",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","7f9671dd-31e8-4882-b74c-63aedac5254c","Mike Begg分享家居品牌广告预算重平衡案例",{"_77":78,"_13":79},"platform",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":92,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/adaa9617d61903e4.webp","fullUrl","/amznews-reading-preview/_img/adaa9617d61903e4.webp","srcSet","/amznews-reading-preview/_img/adaa9617d61903e4.webp 336w, /amzn