[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","dj7c6k9w8d8ys3fw62huh43ek","revision",4,"title","把价差与净收益分开：一篇2021年的成本核算方法","originalTitle","亚马逊精品运营-成本控制","summary","跨境知识汇在2021年11月30日提醒，平台售价与采购价之间的差额不能直接当作利润。作者把核算拆成单品成本与价格试算、逐月销量和费用假设两部分，另外考虑促销、广告、退货、认证及库存损失等支出。本站建议按当前账户账单和自己的经营条件建立多个情景，并明确哪些费用尚未取得报价。原文中的税率、佣金、促销收费和固定利润或广告比例均未重新核实，不能套用为现行规则；客户个案也未独立验证。这是一篇历史方法阅读，不构成财税意见或收益承诺。","reason","source",{"_9":121,"_122":123,"_77":124,"_125":39,"_126":127,"_128":129},"links",{"_118":119,"_65":120},"publishedAt","2021-11-30T00:17:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-02T08:20:24.606Z","timelineAt","category","advertising","tags",[113,114,115,116,117],"score",26,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","跨境知识汇","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_77":78,"_79":110,"_81":111,"_83":112,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":107,"_81":108,"_83":109,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":104,"_81":105,"_83":106,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":98,"_81":99,"_83":100,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":95,"_81":96,"_83":97,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":92,"_81":93,"_83":94,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":80,"_81":