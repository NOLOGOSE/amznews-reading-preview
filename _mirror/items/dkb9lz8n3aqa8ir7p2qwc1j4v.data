[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","dkb9lz8n3aqa8ir7p2qwc1j4v","revision",1,"title","CPSC 申请延长服装纺织品与乙烯塑料薄膜易燃性标准的信息收集批准","originalTitle","Agency Information Collection Activities; Extension of Collection; Standard for the Flammability of Clothing Textiles, 16 CFR Part 1610; Standard for the Flammability of Vinyl Plastic Film, 16 CFR Part 1611","summary","美国消费品安全委员会（CPSC）已向白宫管理和预算办公室（OMB）提交请求，申请延长《服装纺织品易燃性标准》（16 CFR Part 1610）和《乙烯塑料薄膜易燃性标准》（16 CFR Part 1611）相关信息收集的批准。现有批准将于 2026 年 10 月 31 日到期，公众可于 2026 年 10 月 28 日前通过电子邮件或传真向 OMB 提交意见。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":61,"_79":80,"_81":82},"links",{"_70":71,"_65":72},"publishedAt","2026-09-28T04:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:13:48.715Z","timelineAt","category","policy","tags",[68,69],"score",12,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_66":67},"detailedGuide","readingMode","full","author","Consumer Product Safety Commission","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","CPSC 美国消费品安全委员会","政策/合规","合规税务","aihot","/items/dkb9lz8n3aqa8ir7p2qwc1j4v","https://www.federalregister.gov/documents/2026/09/28/2026-19748/agency-information-collection-activities-extension-of-collection-standard-for-the-flammability-of","official-cpsc-federal-register","name","CPSC 美国消费品安全委员会 · 联邦公报","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/fb25db0934701e45.webp","iconSrcSet","/amznews-reading-preview/_img/fb25db0934701e45.webp 48w, /amznews-reading-preview/_i