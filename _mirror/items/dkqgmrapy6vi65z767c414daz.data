[{"_1":2,"_3":4},"root",{"_5":135},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","dkqgmrapy6vi65z767c414daz","revision",2,"title","卖家精灵MCP结合AI-Skill实操亚马逊竞品调研案例","originalTitle","我把亚马逊竞品调研做成了一个AI-Skill（万字干货竞品调研Skill实操案例）","summary","作者分享将亚马逊竞品调研流程固化为AI-Skill的方法，并利用卖家精灵MCP对美国站ASIN B0GFD6L4YK进行实操演示。该案例展示了如何通过六步流程筛选直接竞品、区分商品与页面差距及验证关键词相关性，强调数据需结合成本与利润条件复核，避免仅凭销量或排名盲目决策。","reason","source",{"_9":126,"_127":128,"_90":129,"_130":40,"_131":132,"_133":134},"links",{"_123":124,"_68":125},"publishedAt","2026-10-12T17:30:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-13","discoveredAt","2026-10-13T09:49:32.183Z","timelineAt","category","ai-tools","tags",[120,121,122],"score",27,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","Regan跨境","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fGrBYUHgzE-Y",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","3d47a957-dc03-47e5-8327-f46ad941cb9c","卖家精灵MCP结合AI-Skill的亚马逊选品与竞品调研实操",{"_77":78,"_13":79},"platform","AMZ123",{"_90":91,"_92":117,"_94":118,"_96":119,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":114,"_94":115,"_96":116,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":111,"_94":112,"_96":113,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":108,"_94":109,"_96":110,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":105,"_94":106,"_96":107,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"