[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","dltymocprbf6whcogzpx6zk89","revision",8,"title","亚马逊推出 AI 生成评论摘要功能","originalTitle","Amazon’s AI-Generated Review Summaries: A Game-Changer or a Gimmick?","summary","原文介绍，亚马逊于 2023 年 8 月 14 日推出利用生成式 AI 创建和显示客户评论摘要的新功能，目前仅面向美国部分移动端用户开放。该功能旨在通过提炼已验证购买评论中的常见产品特征和客户情感倾向，帮助买家快速了解产品。原文同时指出，该功能存在过度简化、遗漏细微差别或放大负面属性导致偏差的风险。原文来自 SellerApp，该机构销售亚马逊卖家工具及相关服务，存在相关商业利益，并非独立测评。","reason","source",{"_9":86,"_87":88,"_69":89,"_90":39,"_91":-5},"links",{"_83":84,"_65":85},"publishedAt","2023-08-23T11:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-09-30T06:33:30.325Z","timelineAt","category","ai-tools","tags",[81,82],"score",60,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Arishekar N","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","sellerapp",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/7d074d829739b308.webp","fullUrl","/amznews-reading-preview/_img/7d074d829739b308.webp","srcSet","/amznews-reading-preview/_img/7d074d829739b308.webp 336w, /amznews-reading-preview/_img/7d074d829739b308.webp 720w","width","height","alt","poster","AI/工具","亚马逊","aihot","/items/dltymocprbf6whcogzpx6zk89","https://www.sellerapp.com/blog/amazon-ai-reviews/","author-sellerapp-arishekar","name","sellerapp · Arishekar N","rss","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
