[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","domkxv67msy6777xnymc4bkxo","revision",2,"title","美国海关强化进口商身份核查，同一IOR挂多家客户需厘清权责","originalTitle","大批货物遭扣押！美国海关全面严查！","summary","原文讨论美国海关与边境保护局（CBP）强化对Form 5106资料准确性的核查，不准确或不完整的进口商记录面临被作废的风险。原文强调，同一个合法进口商使用连续Bond办理多次进口本身并不违规；需要警惕的是一些渠道把同一套进口主体资料反复提供给不同客户使用，却说不清实际IOR是谁、是否获得授权以及由谁承担进口责任。原文并列出评估IOR渠道的四项自查问题：实际IOR是谁、Bond对应谁、5106资料是否真实、后续谁来配合。以上为作者观点，本站尚未独立核验相关引用。","reason","source",{"_9":106,"_107":108,"_85":109,"_110":40,"_111":112,"_113":114},"links",{"_103":104,"_68":105},"publishedAt","2026-10-17T20:14:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-18","discoveredAt","2026-10-19T01:35:41.181Z","timelineAt","category","policy","tags",[100,101,102],"score",55,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境知道网","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":12,"_73":74,"_75":76},"hasTranslation","bodyLanguage","original","factId","faOr9ZpRNask",{"_77":78,"_13":79},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","906a830a-2904-4754-bfaf-04c4c3fa028c","美国海关强化进口商身份核查，IOR渠道风险受关注",{"_77":78,"_13":79},"platform","AMZ123",{"_85":86,"_87":97,"_89":98,"_91":99,"_93":-5,"_94":-5,"_95":-5,"_96":-5},{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/f6cf9764a31a33c7.webp","fullUrl","/amznews-reading-preview/_img/f6cf9764a31a33c7.webp","srcSet","/amznews-reading-preview/_img/f6cf9764a31a33c7.webp 