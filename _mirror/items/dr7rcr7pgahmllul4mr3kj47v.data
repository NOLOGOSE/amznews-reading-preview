[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","dr7rcr7pgahmllul4mr3kj47v","revision",2,"title","亚马逊卖家需检查无标签入库货","originalTitle","Some of what shows up at our warehouse has no label at all. Blank bottles, straight from the manufacturer.","summary","我们仓库收到的一些货物完全没有标签。空瓶子，直接来自制造商。\n\n这仅占我们采购量的极小比例，但确实会发生，且这些货物都无法发往亚马逊。\n\n在发往 FBA 前务必检查每一批入库货物，并在 30 天内向供应商标记此问题。","reason","source",{"_9":101,"_102":103,"_104":105,"_106":39,"_107":-5},"links",{"_98":99,"_68":100},"publishedAt","2026-10-16T22:08:06.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T16:14:18.068Z","timelineAt","category","fba","tags",[94,95,96,97],"score",20,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","1000asins","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fCoBFDNIiWpI",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","7a68d1c2-54ea-492a-9183-0acdb9c3678f","卖家提醒：无标签入库货无法发往亚马逊",{"_77":78,"_13":79},"zh","<p>Some of what shows up at our warehouse has no label at all. Blank bottles, straight from the manufacturer.</p><p>It's a fraction of a percent of what we buy, but it happens, and none of it can go to Amazon.</p><p>Check every inbound before it ships to FBA, and flag it to the supplier within 30 days.</p>","zhKind","complete","authorName","Dan Boufford","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"FBA/物流","库存管理","供应链","亚马逊","aihot","/items/dr7rcr7pgahmllul4mr3kj47v","https://x.com/1000asins/status/2111217648151228484","x-dan-boufford","name","X · Dan Boufford","kind","x_search","firstParty","iconUrl",{"_109":110},"changelogVersion","2026-10-09T22:08"]
