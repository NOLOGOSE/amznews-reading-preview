[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":40,"_60":61,"_62":-5,"_63":40,"_64":65},"id","drsu68hdkb9flj45d7b898oi0","revision",1,"title","亚马逊广告在2026澳大利亚Upfront大会宣布Prime Video月均触达超550万并推出多项AI广告新格式","originalTitle","Amazon Ads lights up 2026 Australian Upfront","summary","亚马逊广告在2026年澳大利亚Upfront大会上宣布，Prime Video广告版月均触达观众已增长至超过550万。会上发布了基于位置的互动式视频广告、动态电视创意素材（Dynamic TV Creative）及Next Up Ads等全新AI驱动广告格式，其中动态电视创意素材将于2027年初面向澳大利亚品牌开放。","reason","source",{"_9":108,"_109":110,"_73":111,"_112":61,"_113":114,"_115":116},"links",{"_105":106,"_65":107},"publishedAt","2026-09-23T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-23","discoveredAt","2026-10-22T17:24:11.070Z","timelineAt","category","advertising","tags",[101,102,103,104],"score",20,"selected",false,"channel","news","story","x","media",[68,69,70,71,72],"byline",{"_52":-5,"_66":67},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊广告",{"_73":74,"_75":98,"_77":99,"_79":100,"_81":89,"_83":90,"_84":-5,"_85":-5},{"_73":74,"_75":95,"_77":96,"_79":97,"_81":89,"_83":90,"_84":-5,"_85":-5},{"_73":74,"_75":91,"_77":92,"_79":93,"_81":89,"_83":94,"_84":-5,"_85":-5},{"_73":74,"_75":86,"_77":87,"_79":88,"_81":89,"_83":90,"_84":-5,"_85":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":82,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/a68cfe26a471a29d.webp","fullUrl","/amznews-reading-preview/_img/a68cfe26a471a29d.webp","srcSet","/amznews-reading-preview/_img/a68cfe26a471a29d.webp 336w, /amznews-reading-preview/_img/a68cfe26a471a29d.webp