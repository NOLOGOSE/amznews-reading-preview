[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","dv8m8gykzdmalfqs6sio3dc05","revision",2,"title","自动化债务：AI 工作流进入第二年会发生什么","originalTitle","Automation Debt: What Happens to Your AI Workflows in Year Two","summary","原文作者提出“自动化债务”概念，指 AI 工作流上线后因模型更替、流程变化和规则调整而累积的隐性维护成本，类比软件技术债务但积累更快、更难察觉。文章梳理了五个主要债务来源，并称欧盟 AI Act 大部分剩余条款将于 2026 年 8 月 2 日适用，使未记录的自动化同时成为合规问题。","reason","source",{"_9":107,"_108":109,"_74":110,"_111":39,"_112":113,"_114":115},"links",{"_104":105,"_65":106},"publishedAt","2026-09-24T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T22:19:56.423Z","timelineAt","category","ai-tools","tags",[101,102,103],"score",22,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Joey Glyshaw","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","ZonFlip",{"_74":75,"_76":98,"_78":99,"_80":100,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":95,"_78":96,"_80":97,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":92,"_78":93,"_80":94,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":89,"_78":90,"_80":91,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/cfb7f2eba6b63ebf.webp","fullUrl","/amznews-reading-preview/_img/cfb7f2eba6b63ebf.webp","srcSet","/amznews-reading-preview/_img/cfb7f2eba6b63ebf.webp 336w, /amznews-rea