[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","dwstt8ub54g3kmnfxcs8hcfl7","revision",1,"title","亚马逊卖家社区反馈 Seller Central 图片异常问题","originalTitle","🚨 RED ALERT: Amazon sellers are reporting a serious image issue in Seller Central.","summary","亚马逊卖家社区 ASGTG 转发多位卖家反馈，称 Seller Central 中大量产品图片出现异常。部分图片疑似变为 AI 生成或错误图像，且存在点击后显示原图但详情页实际消失或错乱的情况，作者质疑是否为平台新测试并呼吁官方澄清。","reason","source",{"_9":85,"_86":87,"_88":89,"_90":39,"_91":-5},"links",{"_82":83,"_66":84},"publishedAt","2026-10-14T19:23:43.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:42:17.974Z","timelineAt","category","policy","tags",[80,81],"score",58,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","AmazonASGTG","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>🚨 RED ALERT: Amazon sellers are reporting a serious image issue in Seller Central.</p><p>This morning, sellers noticed that many product images in Seller Central had changed. Some images appear to be AI-generated or otherwise incorrect. In some cases, clicking through still shows the original image, but sellers are also reporting images disappearing from live product detail pages and incorrect images appearing on listings.</p><p>Is Amazon testing something new? If so, this rollout appears to be causing a mess.</p><p>@amznsellerhelp, can you clarify what’s happening?</p><p>@AmitAgarwal @dharmeshmehta</p>","zhKind","complete","authorName","Amazon Sellers ASGTG","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"行业动态","亚马逊","aihot","/items/dwstt8ub54g3kmnfxcs8hcfl7","https://x.com/AmazonASGTG/status/2110451505048539273","x-amazon-asgtg","name","X · ASGTG","kind","x_search","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
