[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","dx18zvp08agskgujx3yqxrdx4","revision",2,"title","国家发改委发布《对外投资管理办法》自2026年12月1日起施行","originalTitle","重磅！国家发改委发布《对外投资管理办法》，自2026年12月1日起施行","summary","国家发改委公布《对外投资管理办法》，共76条，将于2026年12月1日起施行，同步废止2017年版《企业境外投资管理办法》。新办法明确投资者包括境内企业、其他组织和居民个人，并完善重大不利情况报告及信息年度报告制度以保护权益。针对境外风险，增设前期工作情况报告制度，支持通过合格境内机构投资者等渠道进行境外金融市场投资。","reason","source",{"_9":133,"_134":135,"_92":136,"_137":40,"_138":139,"_140":141},"links",{"_130":131,"_68":132},"publishedAt","2026-10-22T06:08:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-23T02:12:30.761Z","timelineAt","category","policy","tags",[128,129],"score",22,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89,90,91],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境易税通","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","flfgX6XwD0h4",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","53496832-14ae-4f8c-b518-e402c5f4d3fe","国家发改委发布《对外投资管理办法》",{"_77":78,"_13":79},"platform","AMZ123",{"_92":93,"_94":125,"_96":126,"_98":127,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":122,"_96":123,"_98":124,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":119,"_96":120,"_98":121,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":116,"_96":117,"_98":118,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":113,"_96":114,"_98":115,"_100":-5,"_101":-5,"_102":