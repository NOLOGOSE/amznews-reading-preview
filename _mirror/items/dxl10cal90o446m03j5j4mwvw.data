[{"_1":2,"_3":4},"root",{"_5":124},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","dxl10cal90o446m03j5j4mwvw","revision",2,"title","TikTok工厂自运营兴起，卖家面临同款竞争与合作权益挑战","originalTitle","TikTok的生意，工厂也要争一争","summary","TK观察指出TikTok Shop正吸引中国产业带工厂从供货转向自建团队直接卖货，如本顿科技、瑞民服饰等案例显示工厂试图掌握销售主动权。这一趋势导致工厂与原有运营团队在品牌归属及分润上产生矛盾，且工厂快速响应能力加剧了同款商品竞争，挤压依赖现货选品的卖家利润空间。","reason","source",{"_9":115,"_116":117,"_87":118,"_119":40,"_120":121,"_122":123},"links",{"_112":113,"_68":114},"publishedAt","2026-10-22T03:24:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-23T01:40:37.274Z","timelineAt","category","product","tags",[108,109,110,111],"score",38,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","TK观察","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fc9gouRv0ljo",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","13b36050-0876-4f3e-9d62-2ab9f1b390c5","TikTok工厂自营兴起，卖家面临同款竞争",{"_77":78,"_13":79},"platform","AMZ123",{"_87":88,"_89":105,"_91":106,"_93":107,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":102,"_91":103,"_93":104,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":99,"_91":100,"_93":101,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5,"_97":-5,"_98":-5},"kind","image","url","/amznews-reading-preview/_img/4791093966360ff7.webp","fullUrl","/amznews-reading-preview/_img/4791093966360ff7.webp"