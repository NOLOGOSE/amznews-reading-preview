[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","dy9pb8tt89g2xr8qb3wjx0764","revision",4,"title","亚马逊销售日期从两个变为三个：订单、交易与放款日期需区分","originalTitle","An Amazon Sale Used to Have Two Dates. It Has Three Now.","summary","原文作者Nhan Dinh以一次手工对账经历说明：亚马逊销售记录涉及订单日期、交易日期和放款日期三个时间点。交易日期约在发货时记录，放款日期因资金延迟释放而晚于交易日期，两者不再相同。若报表把放款日期当作交易日期，收入、费用和成本可能整体跨月错配，在12月等大月尤为明显。作者建议先确认报表实际记录的是哪一个日期，再测量自身账户的资金释放滞后范围，并重点检查月末边界。原文来自Seller Labs，存在相关商业利益，并非独立测评。文中十天线滞后为单个账户的经验，作者明确其并非恒定值，具体滞后取决于品类、履约方式和配送时间；本站尚未独立核验文中引用的A2X及Amazon Finances API相关内容。","reason","source",{"_9":73,"_74":67,"_75":76,"_77":39,"_78":79,"_80":81},"links",{"_70":71,"_65":72},"publishedAt","2026-09-08T15:59:11.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-05T07:14:15.427Z","timelineAt","category","fba","tags",[68,69],"score",52,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Nhan Dinh","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Seller Labs","广告/运营","亚马逊","aihot","/items/dy9pb8tt89g2xr8qb3wjx0764","https://www.sellerlabs.com/blog/amazon-sale-two-dates-now-three/","rss-sellerlabs-prelaunch","name","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp","iconSrcSet","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 48w, /amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 96w",{"_83":84},"changelogVersion","2026-10-09T22:08"]
