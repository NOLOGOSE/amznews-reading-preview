[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":62,"_63":38,"_64":65},"id","e07nxvb5d4v4ktudff8ofqcrr","revision",2,"title","Allegro开通乌克兰出口通道，暂不设独立站点","originalTitle","summary","波兰电商平台Allegro宣布开通面向乌克兰的出口通道，该业务将先在波兰站内运行，暂时不会推出独立的乌克兰站点。项目自今年6月起以小范围试点邀请波兰合作伙伴参与，现已扩大范围。同时，平台更新规则禁止将商品二次转售至俄罗斯、白俄罗斯及俄方控制地区。","reason","source",{"_9":101,"_102":103,"_81":104,"_105":38,"_106":107,"_108":109},"links",{"_98":99,"_65":100},"publishedAt","2026-10-16T07:50:06.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:54.133Z","timelineAt","category","policy","tags",[95,96,97],"score",45,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","media",[80],"byline",{"_51":-5,"_78":79},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[77],"indexable","markdownAvailable",true,"group",{"_66":67,"_41":68,"_69":70,"_71":72,"_73":72},"hasTranslation","bodyLanguage","original","factId","fRhJpCFLRaqo",{"_74":75,"_13":76},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","9528adfd-83c9-40ed-b1bf-94e82b4eb43e","Allegro开通乌克兰出口通道并更新转售规则",{"_74":75,"_13":76},"platform","蓝海亿观网",{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5},"kind","image","url","/amznews-reading-preview/_img/8bc8d5ae19b906da.webp","fullUrl","/amznews-reading-preview/_img/8bc8d5ae19b906da.webp","srcSet","/amznews-reading-preview/_img/8bc8d5ae19b906da.webp 336w, /amznews-reading-preview/_img/8bc8d5ae19b906da.webp 720w","width",760,"height",400,"alt","poster","政策/合规","亚马逊","费用变更","aihot","/items/e07nxvb5d4v4ktudff8ofqcrr","https://www.egainnews.com/article/74387","publisher-egainnews-article