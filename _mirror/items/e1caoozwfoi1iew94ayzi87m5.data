[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","e1caoozwfoi1iew94ayzi87m5","revision",1,"title","亚马逊英国站联合 Affirm 推出分期支付选项","originalTitle","Amazon and Affirm offer UK customers new instalment options","summary","亚马逊英国站与 Affirm 合作，即日起为符合条件的用户提供分期支付服务。该功能支持“0% Pay-in-3”免息三期及最长 48 个月的固定利率（22% Representative APR）方案，订单金额需满 £50 且无逾期或隐藏费用。Affirm 融资适用于 Amazon.co.uk 大多数商品类别，但排除礼品卡、生鲜及部分数字内容，未来几周将逐步向合格用户开放。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":39,"_79":80,"_81":82},"links",{"_70":71,"_65":72},"publishedAt","2026-09-23T08:40:07.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T09:17:27.493Z","timelineAt","category","policy","tags",[68,69],"score",17,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Chris Dawson","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","ChannelX","政策/合规","亚马逊","aihot","/items/e1caoozwfoi1iew94ayzi87m5","https://channelx.world/2026/09/amazon-and-affirm-offer-uk-customers-new-instalment-options/","rss-tamebay-amazon","name","Tamebay · Amazon 卖家新闻","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/87679903b998bbb0.webp","iconSrcSet","/amznews-reading-preview/_img/87679903b998bbb0.webp 48w, /amznews-reading-preview/_img/87679903b998bbb0.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
