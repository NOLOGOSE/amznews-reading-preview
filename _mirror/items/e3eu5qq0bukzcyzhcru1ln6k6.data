[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","e3eu5qq0bukzcyzhcru1ln6k6","revision",2,"title","聊聊最近被吹上天的“飞天僵尸”：亚马逊卖家如何核查变体评论共享与后续投入","originalTitle","聊聊最近被吹上天的“飞天僵尸”","summary","针对近期被热炒的“飞天僵尸”操作，有卖家明确表示不会采用依赖旧ASIN评论的推广方案，并曾因合并僵尸链接被封店。亚马逊官方在2026年公布变体评论共享调整，从2月12日起按类目逐步实施，重点让评论在不影响功能的轻微差异变体之间共享，差异较大的变体评论展示可能变化。卖家应核查商品事实、变体关系与评论适用性，并重新评估采购和广告等后续投入。","reason","source",{"_9":121,"_122":123,"_77":124,"_125":39,"_126":127,"_128":129},"links",{"_118":119,"_65":120},"publishedAt","2026-09-28T18:37:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:24.894Z","timelineAt","category","advertising","tags",[113,114,115,116,117],"score",24,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Regan跨境","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_77":78,"_79":110,"_81":111,"_83":112,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":107,"_81":108,"_83":109,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":104,"_81":105,"_83":106,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":98,"_81":99,"_83":100,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":95,"_81":96,"_83":97,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":92,"_81":93,"_83":94,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86"