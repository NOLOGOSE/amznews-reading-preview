[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":-5,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","e5nwbkcovrj7mbhhqeen5fucm","revision",3,"title","亚马逊公布2026年日本站销售佣金与FBA费用变更","originalTitle","2026亚马逊日本站销售佣金与亚马逊物流费用变更","summary","亚马逊宣布自2026年4月1日起调整日本站费用结构，涵盖物流配送费下调、销售佣金及超龄库存附加费变更。定价高于750日元的商品销售佣金率提高0.4%，标准尺寸（20-80厘米、≤5公斤）商品配送费降低；非媒介类商品存储365天及以上每月每件最低收取20日元附加费。","reason","source",{"_9":75,"_76":77,"_78":79,"_80":60,"_81":-5},"links",{"_72":73,"_64":74},"publishedAt","2025-12-01T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2025-12-02","discoveredAt","2026-10-16T14:13:44.063Z","timelineAt","category","policy","tags",[67,68,69,70,71],"score","selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊全球开店","政策/合规","费用变更","FBA/物流","库存管理","亚马逊","aihot","/items/e5nwbkcovrj7mbhhqeen5fucm","https://gs.amazon.cn/news/news-notices-251202?ref=as_cn_ags_news_hp_notice_s3","official-amazon-global-selling-news","name","亚马逊全球开店 · 官方资讯","kind","web_list","firstParty","iconUrl",{"_83":84},"changelogVersion","2026-10-09T22:08"]
