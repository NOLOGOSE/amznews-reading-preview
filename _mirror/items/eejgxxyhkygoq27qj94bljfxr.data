[{"_1":2,"_3":4},"root",{"_5":129},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","eejgxxyhkygoq27qj94bljfxr","revision",5,"title","亚马逊推出全球仓储与配送服务GWD，并扩展AGL与AI清关工具","originalTitle","Independent sellers move 5 billion products annually through Amazon’s network of global logistics, domestic freight, and bulk warehousing","summary","亚马逊宣布推出全球仓储与配送服务（GWD），让卖家在制造地附近低成本批量备货，再按需发往各目的国，早期试点中商品进入FBA网络最多快7天。亚马逊同时扩展Amazon Global Logistics直航运线，预计到2026年底AGL覆盖卖家发往FBA的96%入境货量，并用生成式AI预填商品分类等清关字段，早期结果显示卖家清关文书时间减少一半以上。","reason","亚马逊官方披露供应链服务多项更新，含GWD新服务、AGL覆盖目标和AI清关工具，卖家可据此评估物流布局。","source",{"_9":123,"_124":125,"_77":126,"_127":40,"_128":-5},"links",{"_120":121,"_66":122},"publishedAt","2025-09-18T13:00:24.125Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T06:05:39.650Z","timelineAt","category","fba","tags",[116,117,118,119],"score",62,"selected",true,"channel","news","story","x","media",[69,70,71,72,73,74,75,76],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","Dharmesh Mehta","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","About Amazon",{"_77":78,"_79":111,"_81":112,"_83":113,"_85":114,"_87":115,"_89":-5,"_90":-5},{"_77":78,"_79":108,"_81":109,"_83":110,"_85":-5,"_87":-5,"_89":-5,"_90":-5},{"_77":78,"_79":105,"_81":106,"_83":107,"_85":94,"_87":95,"_89":-5,"_90":-5},{"_77":78,"_79":102,"_81":103,"_83":104,"_85":86,"_87":88,"_89":-5,"_90":-5},{"_77":78,"_79":99,"_81":100,"_83":101,"_85":86,"_87":88,"_89":-5,"_90":-5},{"_77":78,"_79":96,"_81":97,"_83":98,"_85":86,"_87":88,"_89":-5,"_90":-5},{"_77":78,"_79":91,"_81":92,"_83"