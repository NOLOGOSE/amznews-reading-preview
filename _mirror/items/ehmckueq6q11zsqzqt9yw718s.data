[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","ehmckueq6q11zsqzqt9yw718s","revision",5,"title","亚马逊卖家利用AI提示词还原用户画像与优化Listing的方法","originalTitle","这套提示词，3步还原用户画像！让AI充当你的资深数据分析师","summary","原文作者分享了一套用于亚马逊运营的AI提示词，旨在通过整合Listing文案、流量词及买家评论数据，辅助卖家构建精准用户画像并识别需求差距。该方案要求输入三类核心数据，引导AI执行从关键词分析到Gap Analysis的五步流程，最终输出包含PPC广告布局、视觉素材方向及文案优化的落地指南。文中以便携式轮胎充气泵为例演示操作，强调需借助第三方工具导出数据并清理格式后上传至大模型使用。","reason","source",{"_9":105,"_106":68,"_74":107,"_108":40,"_109":110,"_111":112},"links",{"_102":103,"_66":104},"publishedAt","2025-12-19T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2025-12-20","discoveredAt","2026-10-01T09:32:55.479Z","timelineAt","category","ai-tools","tags",[98,99,100,101],"score",46,"selected",false,"channel","news","story","x","media",[69,70,71,72,73],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","必胜哥的三板斧","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_74":75,"_76":95,"_78":96,"_80":97,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":92,"_78":93,"_80":94,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":89,"_78":90,"_80":91,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/48b7a84010c6285e.webp","fullUrl","/amznews-reading-preview/_img/48b7a84010c6285e.webp","srcSet","/amznews-reading-preview/_img/48b7a84010c6285e.webp 336w, /amznews-reading-preview/_img/48b7a84010c6285e.webp 720w