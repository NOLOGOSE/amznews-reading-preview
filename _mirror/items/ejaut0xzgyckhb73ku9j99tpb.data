[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","ejaut0xzgyckhb73ku9j99tpb","revision",1,"title","Seller Snap 发布 Prime Day 2026 定价与需求数据分析报告","originalTitle","What Prime Day 2026 Reveals about Pricing and Demand","summary","Seller Snap 分析美国站超 10 万款商品发现，仅 18% 的商品在 Prime Day 期间降价 5% 以上，却贡献了 70% 的销量增长。数据显示折扣越深销量提升越大（如降价 30% 以上销量激增 771%），且大幅降价品类在活动后出现明显的销量回落。","reason","基于10万款商品同品对比，量化了折扣深度与销量增幅的阶梯关系，并验证了促销后的需求透支效应。","source",{"_9":107,"_108":109,"_74":110,"_111":64,"_112":113,"_114":115},"links",{"_104":105,"_66":106},"publishedAt","2026-07-15T07:47:44.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:44.568Z","timelineAt","category","product","tags",[101,102,103],"score",66,"selected",true,"channel","news","story","x","media",[69,70,71,72,73],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","Julian Goldhill","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","Seller Snap",{"_74":75,"_76":98,"_78":99,"_80":100,"_82":83,"_84":85,"_86":87,"_88":-5},{"_74":75,"_76":95,"_78":96,"_80":97,"_82":83,"_84":85,"_86":87,"_88":-5},{"_74":75,"_76":92,"_78":93,"_80":94,"_82":83,"_84":85,"_86":87,"_88":-5},{"_74":75,"_76":89,"_78":90,"_80":91,"_82":83,"_84":85,"_86":87,"_88":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":-5},"kind","image","url","/amznews-reading-preview/_img/5d56c0781220e206.webp","fullUrl","/amznews-reading-preview/_img/5d56c0781220e206.webp","srcSet","/amznews-reading-preview/_img/5d56c0781220e206.webp 336w, /amznews-reading-preview/_img/5d