[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ejsd3ofg593qc4rpj3cuvvoez","revision",3,"title","亚马逊强制通行密钥 Passkey 登陆：Windows 组装台式机只支持 USB 安全密钥的解决办法","originalTitle","亚马逊登陆时二次验证完强制要求创建通行密钥Passkey登陆，WINDOW电脑要求使用USB安全密钥的解决办法","summary","有卖家登陆亚马逊时二次验证后被强制要求创建通行密钥 Passkey，公司老款组装台式机无指纹/人脸识别，创建时仅支持 USB 安全密钥。作者将系统从 WIN7 升级到 WIN10、Chrome 更新到最新版并设置 Windows Hello PIN 后仍无法通过，最终用 Chrome 插件 bitwarden 创建 passkey 验证成功。该密钥与硬件绑定，建议用备用机也添加一个。","reason","source",{"_9":104,"_105":67,"_73":106,"_107":39,"_108":109,"_110":111},"links",{"_101":102,"_65":103},"publishedAt","2026-09-10T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:45:54.283Z","timelineAt","category","ai-tools","tags",[97,98,99,100],"score",40,"selected",false,"channel","news","story","x","media",[68,69,70,71,72],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","iasffa","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_73":74,"_75":94,"_77":95,"_79":96,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":91,"_77":92,"_79":93,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":88,"_77":89,"_79":90,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":85,"_77":86,"_79":87,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/62543c23133161c8.webp","fullUrl","/amznews-reading-preview/_img/62543c23133161c8.webp","srcSet","/amznews-reading-preview/_img/62543c23133161c8.webp 336w, /amznews-reading-preview/_