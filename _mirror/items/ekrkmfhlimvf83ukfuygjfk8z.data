[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","ekrkmfhlimvf83ukfuygjfk8z","revision",2,"title","台风“蔷琵”致福建海事局收紧台湾海峡管控，华南北上航线面临调整","originalTitle","台风 “蔷琵” 来袭！港口管控升级，华南北上航线面临调整","summary","福建海事局因台风“蔷琵”及冷空气影响，自10月21日12时起暂停广东方向其他船舶进入台湾海峡。此前已分阶段限制闽浙交界及部分货船北上，并引导中小船舶避风、暂停部分海上作业。受此影响，东海及台湾海峡海域未来几天将出现6—13级大风，华南至北方航线的货代与货主需重新确认实际通行安排并预留运输时间余量。","reason","source",{"_9":121,"_122":123,"_89":124,"_125":40,"_126":127,"_128":129},"links",{"_118":119,"_68":120},"publishedAt","2026-10-21T01:19:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-22T01:48:30.640Z","timelineAt","category","fba","tags",[116,117],"score",40,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","威速易供应链平台","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fU61sC4kefAg",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","e716e9aa-bcf2-4da6-8a32-690c3fa67558","台风蔷琵致长三角干线船班期延误3至4天",{"_77":78,"_13":79},"platform","AMZ123",{"_89":90,"_91":113,"_93":114,"_95":115,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":110,"_93":111,"_95":112,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":107,"_93":108,"_95":109,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":104,"_93":105,"_95":106,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":101,"_93":102,"_95":103,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":92,"_93":9