[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","el59ooul6zejlgxn1tf2fib8s","revision",2,"title","会做亚马逊运营，离独立赚钱还有多远？","originalTitle","summary","一名在公司\"一推一个爆款\"的亚马逊运营出来单干，半年亏掉几十万后重新回去打工。文章指出，运营在公司里复制的是打法而非条件：产品选品、备货资金、容错周期和亏损承担都由公司兜底，个人创业后同一动作从\"正常投入\"变成\"重仓\"。作者建议出来做之前先算清最多能连续错几次、单个品上限投入多少、什么条件下停。","reason","source",{"_9":94,"_95":96,"_70":97,"_98":38,"_99":100,"_101":102},"links",{"_91":92,"_64":93},"publishedAt","2026-09-10T21:55:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:29.562Z","timelineAt","category","advertising","tags",[88,89,90],"score",23,"selected",false,"channel","news","story","x","media",[67,68,69],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","一汤说","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_70":71,"_72":85,"_74":86,"_76":87,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":82,"_74":83,"_76":84,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/234f71ae8e91b82e.webp","fullUrl","/amznews-reading-preview/_img/234f71ae8e91b82e.webp","srcSet","/amznews-reading-preview/_img/234f71ae8e91b82e.webp 336w, /amznews-reading-preview/_img/234f71ae8e91b82e.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/62d8502570166eaf.webp","/amznews-reading-preview/_img/62d8502570166eaf.webp","/amznews-reading-preview/_img/62d8502570166eaf.webp 336w, /amznews-reading-preview/_img/62d8502570166eaf.webp 720w","/amz