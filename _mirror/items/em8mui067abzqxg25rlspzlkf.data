[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","em8mui067abzqxg25rlspzlkf","revision",3,"title","亚马逊美国站卖家遇专利投诉链接下架，同款竞品仍正常在售引困惑","originalTitle","美国站被专利权利人投诉，链接直接中招，但同款还有7家正常在售，到底是什么逻辑？","summary","一位入驻半年的亚马逊美国站卖家遭遇专利侵权投诉导致链接下架，但发现七八家外观结构相似的同款竞品仍正常在售。该卖家因账户绩效无申诉入口且权利人未回复邮件而陷入困境，正寻求撤诉、和解或授权的处理建议，并担忧不处理会影响账户健康。","reason","source",{"_9":96,"_97":68,"_72":98,"_99":40,"_100":101,"_102":103},"links",{"_93":94,"_66":95},"publishedAt","2026-09-10T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-11","discoveredAt","2026-10-07T13:47:12.754Z","timelineAt","category","policy","tags",[90,91,92],"score",27,"selected",false,"channel","news","story","x","media",[69,70,71],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","cherish1207","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/87badc3c4cf21e86.webp","fullUrl","/amznews-reading-preview/_img/87badc3c4cf21e86.webp","srcSet","/amznews-reading-preview/_img/87badc3c4cf21e86.webp 336w, /amznews-reading-preview/_img/87badc3c4cf21e86.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/2078c16ea4da3222.webp","/amznews-reading-preview/_img/2078c16ea4da3222.webp","/amznews-reading-preview/_img/2078c16ea4da3222.webp 336w, /amznews-reading-preview/_img/2078c