[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","emhmcndfoxd4whes5rooeje51","revision",1,"title","卖家Saul回顾2024黑五周末与2026劳动节周末营收对比","originalTitle","A recent comment made this pop up again.","summary","电商卖家SaulSellsStuff在推文中回顾，其2024年黑五提前促销周末营收为40,000美元，2026年劳动节促销周末营收为176,000美元；他建议卖家回顾历史数据，以感知日常不易察觉的增长，并关注时间分配、利润等非营收指标的变化。上述营收数字来自作者自述，本站尚未独立核验。","reason","source",{"_9":91,"_92":93,"_94":95,"_96":39,"_97":-5},"links",{"_88":89,"_66":90},"publishedAt","2026-09-22T15:33:19.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.631Z","timelineAt","category","advertising","tags",[86,87],"score",12,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":79,"_44":80},"media",[],"byline","detailedGuide","readingMode","full","author","SaulSellsStuff","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>A recent comment made this pop up again.</p><p>We live in our own little worlds and don't look back enough.</p><p>Early BF sale weekend in 2024 = $40,000<br>Labor Day sale weekend in 2026 = $176,000</p><p>BF 2026? We will see 🫰</p><p>You may think growth isn't happening, especially when you surround yourself with others doing cool things.</p><p>But similar to having a kid its hard to see the daily changes when you're living in it. Take a peak sometime at where you've been.</p><p>Won't always be revenue. Think about how you're now spending your time, your business balance, clients, profit, etc.</p>","zhKind","complete","authorName","Saul","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_71":72,"_73":51,"_81":82,"_83":84,"_85":-5},[],"text","Our mini Black Friday weekend showed up. \n\nJust over $40,000 in revenue across markets from Shopify, WM, and Amazon.  \n\nTook us 2.5 hours of shipping. Here’s to double that for the real thing 🥂","url","https://x.com/SaulSellsStuff/status/1861103373564428385","translation","广告/运营","多平台销售","aihot","/items/emhmcndfoxd4whes5rooeje51","https://x.com/SaulSellsStuff/status/2102420989732704736","x-saul-sells-stuff","name","X · Saul","kind","x_search","firstParty","iconUrl",{"_99":100},"changelogVersion","2026-10-09T22:08"]
