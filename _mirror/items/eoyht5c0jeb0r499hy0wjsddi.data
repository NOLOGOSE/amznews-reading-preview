[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","eoyht5c0jeb0r499hy0wjsddi","revision",2,"title","亚马逊：多数美国卖家自发货退货将需预付标签，并拟推出跨渠道工具","originalTitle","Amazon’s Next Big Move Has Sellers Nervous | Texas Targets Linked Accounts | 200+ Safety Requests","summary","原文转述亚马逊公告称，自2026年12月18日起，多数美国卖家自发货（FBM）退货将要求使用预付标签；卖家需在7个日历日内上传，否则可能触发自动无退货退款。原文还提到，亚马逊宣布的Seller Central工具拟整合eBay、Shopify、TikTok和Walmart的列表、订单与盈利数据，但卖家对亚马逊可见的跨渠道数据范围及履约错误是否会影响其他平台账户表示担忧。","reason","source",{"_9":90,"_91":92,"_93":94,"_95":40,"_96":97,"_98":99},"links",{"_87":88,"_68":89},"publishedAt","2026-10-22T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-22T14:45:26.383Z","timelineAt","category","policy","tags",[83,84,85,86],"score",35,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":-5,"_81":82},"detailedGuide","readingMode","full","author","admin","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":12,"_75":76},"hasTranslation","bodyLanguage","original","factId","fXfrQy_90Ddk",{"_77":78,"_13":79},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","54a20201-0a95-4fe1-9774-3181d400f595","亚马逊FBM退货预付标签新规",{"_77":78,"_13":79},"platform","ASGTG","政策/合规","亚马逊","Seller Central","退货管理","aihot","/items/eoyht5c0jeb0r499hy0wjsddi","https://asgtg.com/amazons-next-big-move-has-sellers-nervous-texas-targets-linked-accounts-200-safety-requests/","publisher-asgtg-official-blog-rolling","name","ASGTG · 官方卖家周报","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cb7e87c8dd6