[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","epc21wxlizkla89cy8g1mmfk2","revision",2,"title","亚马逊首页广告挤占自然位","originalTitle","Search almost anything on Amazon right now and the entire first row is ads. 5 sponsored spots before the first organic result.","summary","现在在亚马逊搜索几乎任何内容，第一行全是广告。在第一个自然结果出现之前有 5 个赞助位。\n\n大多数购物者不会翻过第一页的前半部分。\n\n未投放 PPC 的品牌在大多数搜索中起始位置都在首屏以下。","reason","source",{"_9":99,"_100":101,"_102":103,"_104":39,"_105":-5},"links",{"_96":97,"_68":98},"publishedAt","2026-10-15T17:04:05.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T16:14:18.099Z","timelineAt","category","advertising","tags",[94,95],"score",38,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","1000asins","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fHlxgryIh2mo",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","02050f05-4d22-46ab-886f-bb0cd25a2d82","亚马逊搜索结果首页广告位挤占自然位",{"_77":78,"_13":79},"zh","<p>Search almost anything on Amazon right now and the entire first row is ads. 5 sponsored spots before the first organic result.</p><p>Most shoppers never scroll past the first half of page one.</p><p>A brand that isn't running PPC is starting most searches below the fold.</p>","zhKind","complete","authorName","Dan Boufford","handle","avatarUrl","/amznews-reading-