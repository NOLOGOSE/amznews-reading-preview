[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ex0fg0v610d0we29mxdh0oi43","revision",2,"title","亚马逊提醒卖家14天内完成虚拟身份验证，逾期账户可能被暂停","originalTitle","亚马逊发来这类通知，14天内不处理，账户可能被暂停","summary","亚马逊发文提醒卖家，收到虚拟身份验证通知后通常需在14天内完成验证，部分账户可能没有宽限期，逾期未完成账户可能被暂停。验证主要确认法人身份、实际运营人、注册地址与收款主体是否一致，法人不参与运营的还需提供社保、劳动合同等关系证明。卖家可通过注册邮箱、卖家平台账户状况下的绩效通知及优先操作模块查看通知，验证时长通常为10-60分钟，审核约需5个工作日。","reason","source",{"_9":88,"_89":90,"_69":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_65":87},"publishedAt","2026-09-29T01:30:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:45.080Z","timelineAt","category","policy","tags",[81,82,83,84],"score",62,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","跨境电商优匠学堂","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/25c8eaa58f97cda9.webp","fullUrl","/amznews-reading-preview/_img/25c8eaa58f97cda9.webp","srcSet","/amznews-reading-preview/_img/25c8eaa58f97cda9.webp 336w, /amznews-reading-preview/_img/25c8eaa58f97cda9.webp 720w","width","height","alt","poster","政策/合规","亚马逊","Seller Central","合规税务","aihot","/items/ex0fg0v610d0we29mxdh0oi43","https://www.amz123.com/t/5tp06NFg","author-amz123-youjiang-reviewed","name","AMZ123 · 跨境电商优匠学堂","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6