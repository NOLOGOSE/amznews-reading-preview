[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","eydu0x48sxwkan92tonk1it0w","revision",1,"title","亚马逊卖家平台图片异常疑似AI测试","originalTitle","So this morning we noticed all of our Amazon images are changed in seller central. It looks like this is ai? @amznsellerhelp Is this so...","summary","今早我们发现卖家平台上的所有亚马逊图片都变了。看起来像是 AI？@amznsellerhelp 这是亚马逊现在正在测试的功能吗？如果是，那简直一团糟。还看到我们线上商品详情页的图片被移除，且使用了错误的产品图片。","reason","source",{"_9":85,"_86":87,"_88":89,"_90":39,"_91":-5},"links",{"_82":83,"_66":84},"publishedAt","2026-10-14T12:26:35.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:42:20.407Z","timelineAt","category","policy","tags",[80,81],"score",35,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","michaelpatron0","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>So this morning we noticed all of our Amazon images are changed in seller central.  It looks like this is ai?  @amznsellerhelp Is this something Amazon is testing now? If so, it a complete mess.  Also seeing images removed from our live PDP and wrong product images being used.</p>","zhKind","complete","authorName","Michael Patrón","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"政策/合规","亚马逊","aihot","/items/eydu0x48sxwkan92tonk1it0w","https://x.com/michaelpatron0/status/2110346528175038590","x-michael-patron","name","X · Michael Patrón","kind","x_search","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
