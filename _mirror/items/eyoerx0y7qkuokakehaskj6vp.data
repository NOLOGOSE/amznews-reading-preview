[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":-5,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","eyoerx0y7qkuokakehaskj6vp","revision",1,"title","UPS 削减亚马逊业务并转向高利润服务，分析师认可其重组执行","originalTitle","UPS navigates Amazon draw down in hard pivot to premium services","summary","UPS 正通过大幅削减与亚马逊的业务量（计划至2026年中减少50%）来转向更高利润的B2B及医疗物流领域。该公司已裁减数万名员工并关闭多个设施，预计上半年因调整成本导致国内利润率降至4%-5%，但下半年将随效率提升而改善。尽管面临密度降低带来的涨价压力，UPS 仍保持97.2%的节日季准时交付率，获分析师对其重组执行力的正面评价。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":38,"_79":80,"_81":82},"links",{"_70":71,"_64":72},"publishedAt","2026-03-11T13:34:45.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:17:07.879Z","timelineAt","category","fba","tags",[67,68,69],"score","selected",false,"channel","news","story","x","media",[],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves","FBA/物流","供应链","亚马逊","aihot","/items/eyoerx0y7qkuokakehaskj6vp","https://www.freightwaves.com/news/ups-navigates-amazon-draw-down-in-hard-pivot-to-premium-services","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
