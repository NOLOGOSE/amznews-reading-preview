[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","f08bvuxqe20nap0qii5ht0l8a","revision",2,"title","亚马逊下架 Todimart T1/T3 儿童电动滑板车，因插头不符 BS 1363 标准存火灾风险","originalTitle","Product Safety Report: Todimart T1 and T3 Electric Children’s Scooter sold via Amazon (2610-0119)","summary","UK OPSS 公告显示，亚马逊已下架 Todimart T1 和 T3 儿童电动滑板车。该产品随附插头不符合 BS 1363 尺寸要求且缺失保险丝，存在过热或爆炸引发火灾的风险。此外，产品未提供有效的符合性声明，也不满足英国《2008 年机械供应（安全）条例》及《1994 年插头插座（安全）条例》的要求。","reason","source",{"_9":88,"_89":90,"_91":92,"_93":62,"_94":95,"_96":97},"links",{"_85":86,"_67":87},"publishedAt","2026-10-20T07:50:35.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-20T21:46:10.413Z","timelineAt","category","policy","tags",[82,83,84],"score",30,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":-5,"_80":81},"detailedGuide","readingMode","full","author","Office for Product Safety and Standards","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fdhR-zq7unxs",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","f1e5b4e0-94fb-41d4-b365-7eac3c0104c5","亚马逊下架Todimart T1/T3儿童滑板车",{"_76":77,"_13":78},"platform","UK OPSS","政策/合规","合规税务","亚马逊","aihot","/items/f08bvuxqe20nap0qii5ht0l8a","https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-report-todimart-t1-and-t3-electric-childrens-scooter-sold-via-amazon-2610-0119","official-uk-opss-rolling","name","UK OPSS 产品安全公告","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/1fbf571bfada1bb0.webp","iconSrcSet","/amznews-reading-preview/_img/1fbf571bfada1bb0.webp 48w, /amznews-reading-preview/_img/1fbf571bfada1bb0.webp 96w",{"_99":100},"changelogVersion","2026-10-09T22:08"]
