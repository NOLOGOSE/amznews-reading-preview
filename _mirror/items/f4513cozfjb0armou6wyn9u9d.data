[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","f4513cozfjb0armou6wyn9u9d","revision",4,"title","同名商标跨站点备案遇阻时如何通过关联商标完成亚马逊品牌注册","originalTitle","同名商标跨站点备案总被提示“品牌已被注册”？用1个主商标关联其他站点，3-5个工作日完成亚马逊品牌备案","summary","卖家 wang厌倦 分享同名商标跨站点备案被提示“品牌已被注册”时的解决方法，即利用已备案主站点商标的“添加关联商标”功能纳入其他站点同名商标。操作路径为进入品牌注册后台的管理知识产权页面选择关联商标，输入序列号后等待3-5个工作日接收验证码完成认证。作者提醒备案品牌名须与证书完全一致，产品图严禁PS或贴纸，发票需为6个月内真实发票且体现品牌名。","reason","作者分享同名商标跨站点备案的操作步骤，指出需通过关联商标功能并强调名称一致与实物图要求。","source",{"_9":104,"_105":83,"_85":106,"_107":67,"_108":109,"_110":111},"links",{"_101":102,"_69":103},"publishedAt","2026-10-16T02:17:15.555Z","publishedPrecision","calendar","calendarDate","2026-10-16","discoveredAt","2026-10-16T02:29:14.834Z","timelineAt","category","policy","tags",[97,98,99,100],"score",62,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","wang厌倦","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":76,"_77":76},"hasTranslation",false,"bodyLanguage","original","factId","f766pxdkXgjw",{"_78":79,"_13":80},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","5deebe7f-e080-4013-a9d9-950a3dfe1997","同名商标跨站点备案受阻 关联商标功能解困",{"_78":79,"_13":80},"platform","知无不言",{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/cd5974773c10ab2f.webp","fullUrl","/amznews-reading-preview/_img/cd5974773c10ab2f.webp","srcSet","/amznews-reading-preview/_img/cd5974773c10ab2f.webp 336w, /amznews-reading-preview/_img/cd5974773c10ab2f.webp 7