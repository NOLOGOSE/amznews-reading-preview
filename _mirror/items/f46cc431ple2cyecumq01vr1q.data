[{"_1":2,"_3":4},"root",{"_5":125},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","f46cc431ple2cyecumq01vr1q","revision",3,"title","非标新品冲量前如何调整广告？先优化现有广告，再补精准关键词与流量入口","originalTitle","非标新品开始冲量，怎么提前做好准备？冲量前筛选好精准关键词、补充更多流量入口。","summary","一款售价19.9刀的非标新品近7天出87单、转化率8.9%，目前只开了自动广告、手动广泛广告和一个ASIN定位广告。手动广泛广告转化率11.3%，顶部位置表现最好、商品页最差，调整方向是降低基础竞价并给顶部和其余位置补充百分比；自动广告转化率10.1%，可直接增加基础竞价放量；ASIN定位广告转化率5.8%，先给顶部加百分比并优化无单投放目标。","reason","source",{"_9":117,"_118":67,"_76":119,"_120":39,"_121":122,"_123":124},"links",{"_114":115,"_65":116},"publishedAt","2026-09-17T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T12:46:21.785Z","timelineAt","category","advertising","tags",[109,110,111,112,113],"score",33,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","阿浩的广告复盘","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_76":77,"_78":106,"_80":107,"_82":108,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":103,"_80":104,"_82":105,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":100,"_80":101,"_82":102,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":97,"_80":98,"_82":99,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":94,"_80":95,"_82":96,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":91,"_80":92,"_82":93,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":88,"_80":89,"_82":90,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5,"_86":-5,"_87":-5},"kind","image","url","/amznews-read