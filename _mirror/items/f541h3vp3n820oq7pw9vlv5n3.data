[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","f541h3vp3n820oq7pw9vlv5n3","revision",2,"title","亚马逊 ASIN 创建新规：转售商需获品牌备案 Reseller 角色","originalTitle","Amazon’s New ASIN Creation Rule: Resellers Need a Brand Registry Role","summary","据 EcomCrew、Canopy Management 等来源，自2026年6月1日起，为已加入 Brand Registry 的品牌创建新 ASIN 需要由品牌管理员分配 Reseller 角色；被标记的卖家有30天时间提供授权信或发票，否则可能面临账号停用（该最坏情形来自 Amazon Sellers Lawyer 与 Canopy 等来源，本站尚未独立核验）。各来源对适用对象是供应商还是第三方卖家存在分歧，原文建议两类账号均按此规则自查并获取授权。原文来自 SellerElevate，存在相关商业利益，并非独立测评。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T18:51:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:23.230Z","timelineAt","category","policy","tags",[89,90,91],"score",68,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/cb3898f2c88d510c.webp","fullUrl","/amznews-reading-preview/_img/cb3898f2c88d510c.webp","srcSet","/amznews-reading-preview/_img/cb3898f2c88d510c.webp 336w, /amznews-reading-preview/_img/cb3898f2c88d510c.webp 720w","width",1600,"height",1325,"alt","poster","/amznews-reading-preview/_img/94d5faea55da6a59.webp","/amznews-reading-previe