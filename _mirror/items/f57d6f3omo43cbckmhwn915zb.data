[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","f57d6f3omo43cbckmhwn915zb","revision",1,"title","亚马逊卖家自动化工具两年演变：从规则配置转向 AI Agent 与合规接入","originalTitle","What changed in seller automation over the last two years","summary","Threecolts 博客回顾过去两年亚马逊卖家自动化的变化，称 Amazon Seller Assistant 升级为可主动监控账户并执行计划的代理式工具，Amazon 于 2026 年 2 月 2 日开放 Ads MCP Server 公测，允许外部 AI 工具通过标准化接入连接广告账户，随后 Agent Policy 生效，要求代理须自我标识为自动化并通过官方 SP-API 运行。原文来自 Threecolts，存在相关商业利益，并非独立测评。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-10-12T10:44:28.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:42.232Z","timelineAt","category","ai-tools","tags",[68,69,70],"score",24,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Angela Apolonio","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Threecolts","AI/工具","卖家工具","亚马逊","aihot","/items/f57d6f3omo43cbckmhwn915zb","https://www.threecolts.com/blog/amazon-seller-automation-progress/","publisher-threecolts-blog","name","Threecolts · 亚马逊卖家工具博客","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/3b9ced962f320ee4.webp","iconSrcSet","/amznews-reading-preview/_img/3b9ced962f320ee4.webp 48w, /amznews-reading-preview/_img/3b9ced962f320ee4.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
