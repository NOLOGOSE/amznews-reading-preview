[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","f6exhegvsb8dwkhgczvlpn7g8","revision",2,"title","菲律宾COD占比居东南亚首位，越南拟2027年GDP增长超10%，马来西亚推进电商监管立法","originalTitle","货到付款（COD）仍然是该市场的重要支付方式；越南提出2027年GDP增长10%以上；马来西亚连续释放加强电商监管的信号","summary","Xendit报告显示菲律宾货到付款（COD）交易额占电商总额约23%，居东南亚六国之首。越南政府提出2027年GDP增长10%以上目标，并设定人均GDP达6100美元等指标。马来西亚新版《电子商务法案》草案已完成，计划于2027年提交国会审议以加强平台监管。","reason","source",{"_9":89,"_90":91,"_92":93,"_94":40,"_95":96,"_97":98},"links",{"_86":87,"_68":88},"publishedAt","2026-10-18T08:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-18","discoveredAt","2026-10-19T03:37:38.373Z","timelineAt","category","policy","tags",[83,84,85],"score",29,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境东南亚","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fx6HWxoiSbLM",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","efb20cc7-795e-4426-bd92-3b0cd08ab74e","东南亚电商动态：菲律宾COD居首、越南增长目标与马来西亚立法",{"_77":78,"_13":79},"platform","AMZ123","政策/合规","多平台销售","亚马逊","aihot","/items/f6exhegvsb8dwkhgczvlpn7g8","https://www.amz123.com/t/OLhmvEYq","publisher-amz123-headlines","name","AMZ123 · 跨境头条","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_100":101},"changelogVersion",