[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","f76z2hpi1sbjlr2foup99l7iw","revision",7,"title","我把亚马逊选品流程重新做了一遍：从站外找任务到小批量测品","originalTitle","我把亚马逊选品流程重新做了一遍","summary","作者复盘多轮新品后，把亚马逊选品流程重排为“站外找任务→识别补偿行为→抽象需求→Amazon反查→供应侧验证→形成产品假设→小批量测品→决定放大或停止”，并将站内数据从第一步挪到第二阶段。站外线索按求助、抱怨、补偿行为、放弃行为、反方证据和带货内容分类，其中补偿行为最能暴露用户已承担的成本与方案限制。测品可用 VIPON 等站外 Deal 渠道分批次、一次只改一个变量，并提前写好停止条件。","reason","source",{"_9":96,"_97":98,"_71":99,"_100":39,"_101":102,"_103":104},"links",{"_93":94,"_65":95},"publishedAt","2026-09-19T23:47:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T09:35:29.986Z","timelineAt","category","product","tags",[89,90,91,92],"score",27,"selected",false,"channel","news","story","x","media",[68,69,70],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","VIPON站外促销平台","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_71":72,"_73":86,"_75":87,"_77":88,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":83,"_75":84,"_77":85,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":-5,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/c3b907e77624b4cc.webp","fullUrl","/amznews-reading-preview/_img/c3b907e77624b4cc.webp","srcSet","/amznews-reading-preview/_img/c3b907e77624b4cc.webp 336w, /amznews-reading-preview/_img/c3b907e77624b4cc.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/d9cb60a3e816e35a.webp","/amznews-reading-preview/_img/d9cb60a3e816e35a.webp","/amznews-reading-preview/_img/d9cb60a3e816