[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","f974g1kys9nh989rjwgh5qtiw","revision",2,"title","亚马逊在墨西哥测试AI购物助手Alexa，未来几周向所有消费者推出","originalTitle","亚马逊在墨西哥测试AI购物助手Alexa","summary","亚马逊在墨西哥推出购物助手Alexa测试版，面向部分符合条件的登录用户免费开放，用户可在亚马逊购物App和桌面版网站通过自然对话完成商品搜索、品类探索、产品比较和购买决策。该功能目前支持研究、发现、比较三类购物任务，未来几周将向所有消费者推出。亚马逊披露，过去12个月全球已有超过3.5亿消费者使用过Alexa，近几个月活跃用户数量几乎翻了一倍，互动次数较上一年增加5倍以上。","reason","source",{"_9":88,"_89":90,"_70":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_65":87},"publishedAt","2026-09-10T02:18:23.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:19.083Z","timelineAt","category","ai-tools","tags",[82,83,84],"score",30,"selected",false,"channel","news","story","x","media",[69],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Summer","platform","AMZ123",{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/f77e418d3cf26ff6.webp","fullUrl","/amznews-reading-preview/_img/f77e418d3cf26ff6.webp","srcSet","/amznews-reading-preview/_img/f77e418d3cf26ff6.webp 336w, /amznews-reading-preview/_img/f77e418d3cf26ff6.webp 720w","width","height","alt","poster","AI/工具","AI工具","亚马逊","aihot","/items/f974g1kys9nh989rjwgh5qtiw","https://www.amz123.com/t/ynw9ReXl","author-amz123-summer","name","AMZ123 · SUMMER","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.web