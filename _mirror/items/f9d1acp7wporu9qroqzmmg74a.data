[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","f9d1acp7wporu9qroqzmmg74a","revision",2,"title","沃尔玛推出代理档案与网关，开放AI代理购物权限","originalTitle","沃尔玛向外部AI代理开放购物权限，但设有防护措施","summary","沃尔玛宣布将在未来一个月内推出“代理档案”并测试“代理网关”，允许用户授权AI代理在设定限额内购物或进行审批。该方案基于MCP协议，旨在让外部AI连接服务时不共享用户个人信息，与亚马逊限制Perplexity等代理的做法形成对比。","reason","source",{"_9":87,"_88":89,"_90":91,"_92":39,"_93":-5},"links",{"_84":85,"_67":86},"publishedAt","2026-10-23T02:41:48.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-23T03:22:29.836Z","timelineAt","category","ai-tools","tags",[82,83],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","AI跨境快讯","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":12,"_72":73,"_74":75},"hasTranslation","bodyLanguage","original","factId","fWxX72jKf1KQ",{"_76":77,"_13":78},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","73999efa-0426-424b-b502-b1aedfb0cd2d","沃尔玛开放AI代理购物，亚马逊封堵",{"_76":77,"_13":78},"platform","卖家之家","AI/工具","AI工具","aihot","/items/f9d1acp7wporu9qroqzmmg74a","https://mjzj.com/article/g21zclyoterk","publisher-mjzj-feed","name","卖家之家 · 跨境资讯","kind","rss","firstParty","iconUrl",{"_95":96},"changelogVersion","2026-10-09T22:08"]
