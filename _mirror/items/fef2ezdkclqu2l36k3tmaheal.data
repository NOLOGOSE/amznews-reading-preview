[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_42":45,"_46":47,"_48":-5,"_49":-5,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":61,"_62":40,"_63":40,"_64":65,"_66":67,"_68":69},"id","fef2ezdkclqu2l36k3tmaheal","revision",2,"title","亚马逊要求FBM卖家提供预付退货标签","originalTitle","Even more reason to diversify off Amazon. They will look back at 2026 and realize this is when they lost their way as they threw sellers...","summary","亚马逊宣布自2026年12月18日起，大多数美国FBM订单退货需卖家提供预付退货标签。卖家须在7天内上传标签或全额退款，否则亚马逊可能自动执行无退货退款并从账户扣款，重型和大件商品暂时豁免。作者转发此消息并评论称这是卖家应分散亚马逊依赖的又一理由。","reason","原文引用了亚马逊关于FBM退货标签的新规细节，并附带卖家对平台政策的批评观点。","source",{"_9":109,"_110":111,"_112":113,"_114":67,"_115":-5},"links",{"_106":107,"_69":108},"publishedAt","2026-10-19T19:00:09.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T19:27:39.835Z","timelineAt","category","policy","tags",[103,104,105],"score",71,"selected",true,"channel","x","story",{"_78":79,"_13":80},{"_86":87,"_88":53,"_89":90,"_91":92,"_93":94,"_46":95},"media",[],"byline","detailedGuide","readingMode","full","author","michaelpatron0","language","en","body",{"_82":-5,"_69":83,"_84":-5,"_85":40},"outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_43":72,"_73":74,"_75":12,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fXfrQy_90Ddk",{"_78":79,"_13":80},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","54a20201-0a95-4fe1-9774-3181d400f595","亚马逊FBM退货预付标签新规",{"_78":79,"_13":80},"zh","<p>Even more reason to diversify off Amazon.  They will look back at 2026 and realize this is when they lost their way as they threw sellers under the bus again and again and again and again.</p>","zhKind","complete","authorName","Michael Patrón","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_86":96,"_88":97,"_98":99,"_100":101,"_102":-5},[],"Amazon Sellers ASGTG","AmazonASGTG","text","FYI for FBM sellers: Amazon says that starting December 18, 2026, most US returns for seller-fulfilled orders will require a prepaid return label.\n\nWithin seven calendar days of a return request, sellers must upload the label through Manage Seller-Fulfilled Returns or issue a full refund without requiring the item back. If neither happens, Amazon says it may automatically issue a returnless refund and deduct the amount from the seller’s account.\n\nHeavy and bulky items are temporarily excluded. Labels sent outside Amazon’s returns workflow won’t count.","url","https://x.com/AmazonASGTG/status/2112251468099043498","translation","政策/合规","FBA/物流","亚马逊","aihot","/items/fef2ezdkclqu2l36k3tmaheal","https://x.com/michaelpatron0/status/2112257512204554496","x-michael-patron","name","X · Michael Patrón","kind","x_search","firstParty","iconUrl",{"_117":118},"changelogVersion","2026-10-09T22:08"]
