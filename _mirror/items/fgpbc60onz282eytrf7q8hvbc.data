[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","fgpbc60onz282eytrf7q8hvbc","revision",4,"title","FBA 补货日期计算：何时下采购订单（PO）","originalTitle","FBA Reorder Date Calculation: When to Place the PO","summary","FBA 补货日期计算的核心规则是：当剩余可售天数降至总备货时间加安全库存天数时下单，等同于库存单位数触及补货点。以日销 10 件、总备货时间 60 天、安全库存 20 天（200 件）为例，补货点为 800 件，触发天数为 80 天可售天数；若当前持有 900 件即 90 天，距触发约 10 天。","reason","source",{"_9":76,"_77":78,"_79":80,"_81":39,"_82":83,"_84":85},"links",{"_73":74,"_65":75},"publishedAt","2026-04-08T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T18:26:15.185Z","timelineAt","category","fba","tags",[68,69,70,71,72],"score",40,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Andrew Erickson","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Inventory Hero","FBA/物流","库存管理","供应链","卖家工具","亚马逊","aihot","/items/fgpbc60onz282eytrf7q8hvbc","https://www.inventoryhero.ai/blog/reorder-date-calculation","author-inventoryhero-andrew-erickson-reviewed","name","Inventory Hero · Andrew Erickson","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/1c961974147ba2ce.webp","iconSrcSet","/amznews-reading-preview/_img/1c961974147ba2ce.webp 48w, /amznews-reading-preview/_img/1c961974147ba2ce.webp 96w",{"_87":88},"changelogVersion","2026-10-09T22:08"]
