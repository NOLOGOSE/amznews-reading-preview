[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","fhgtftmp6vn12k8vtuk1e8qb5","revision",1,"title","亚马逊统一广告平台为Ads Agent，作者解析其变化与不变之处","originalTitle","从 Ads Console 到 Ads Agent：亚马逊广告的三变三不变","summary","亚马逊在unBoxed 2026全球大会上宣布将Ads Console与Amazon DSP整合为统一的Amazon Ads Agent（亚马逊 AI 广告平台）。作者指出该平台带来三大变化：支持自然语言描述需求以简化操作、实现跨广告形式协同（如DVA+和全流域广告活动）、以及将AI创意生成与数据分析纳入工作流；同时强调原有手动控制权保留、广告效率提升不等于利润增加、产品核心竞争力仍是关键。","reason","source",{"_9":105,"_106":107,"_74":108,"_109":40,"_110":111,"_112":113},"links",{"_102":103,"_66":104},"publishedAt","2026-10-16T19:47:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-17","discoveredAt","2026-10-19T01:48:38.356Z","timelineAt","category","advertising","tags",[98,99,100,101],"score",60,"selected",false,"channel","news","story","x","media",[69,70,71,72,73],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","跨境电商MoonSees","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_74":75,"_76":95,"_78":96,"_80":97,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":92,"_78":93,"_80":94,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":89,"_78":90,"_80":91,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/9eac0abf29d0c17c.webp","fullUrl","/amznews-reading-preview/_img/9eac0abf29d0c17c.webp","srcSet","/amznews-reading-preview/_img/9eac0abf29d0c17c.webp 336w, /amznews-reading-preview/_img/9e