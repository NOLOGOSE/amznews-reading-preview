[{"_1":2,"_3":4},"root",{"_5":138},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","fibyaorfbnrm6fouavo4fq2gf","revision",6,"title","搜索词研究如何拆开看：2020年的 RPSB 方法讨论","originalTitle","RPSB: Still The Best Keyword Research Strategy?","summary","Nancy Lili Gonzalez在2020年的署名文章中介绍RPSB：研究搜索词、从报告中挑出需要进一步验证的词、在手动广告中单独观察，并讨论是否在原探索活动中排除这些词。文章来自广告工具提供商，是历史方法观点，不是本站实测或现行平台规则。可借鉴的部分是区分出价关键词与真实搜索词，使用自有花费、订单和归因口径一致的报表，记录调整前后的条件。一次转化未必足以说明可重复的需求；进一步测试也须考虑样本量、预算、归因延迟及商品差异。原文的两周、两次转化、10次点击、50次展示、5%转化率及出价公式不是通用阈值，不作为本站指令。其自动商品定位、否定ASIN及否定词导流的历史规则未核对当前官方要求，不能据此关闭全部替代品或互补品，也不保证添加否定词能降低CPC或提高利润。本文仅整理已读取的文字，不声称收听或核实播客；保留原文入口，不转载全文、译文、图像或字幕。","reason","source",{"_9":129,"_130":131,"_77":132,"_133":39,"_134":135,"_136":137},"links",{"_126":127,"_65":128},"publishedAt","2020-01-15T20:30:16.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-02T11:41:26.847Z","timelineAt","category","advertising","tags",[122,123,124,125],"score",62,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Nancy Lili Gonzalez","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Ad Badger",{"_77":78,"_79":119,"_81":120,"_83":121,"_85":-5,"_87":-5,"_88":-5,"_89":-5},{"_77":78,"_79":114,"_81":115,"_83":116,"_85":117,"_87":118,"_88":-5,"_89":-5},{"_77":78,"_79":111,"_81":112,"_83":113,"_85":-5,"_87":-5,"_88":-5,"_89":-5},{"_77":78,"_79":106,"_81":107,"_83":108,"_85":109,"_87":110,"_88":-5,"_89":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":104,"_87":105,"_88":-5,"_89":-5},{"_77":78,"_79":97