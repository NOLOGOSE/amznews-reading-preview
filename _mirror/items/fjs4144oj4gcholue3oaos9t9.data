[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","fjs4144oj4gcholue3oaos9t9","revision",1,"title","用户发帖批评 Helium 10 涨价与限流","originalTitle","12+ months after Helium10 rug-pulled its affiliates…","summary","作者在 X 发帖称，距 Helium 10 取消联盟计划已过去 12 个多月，距其涨价并新增速率限制已过去 8 个多月，并认为这些限制使 Platinum 套餐基本失去作用；作者称对 H10 的不满仍在持续。作者推测 H10 短期可能尚可，因为获客成本仍低、费率上调或可抵消流失增加，但长期将面临功能更优、价格更低的新兴竞品以及头部博主推广的挑战。以上均为作者个人观点与推测，本站尚未独立核验相关说法。","reason","source",{"_9":98,"_99":100,"_81":101,"_102":39,"_103":-5},"links",{"_95":96,"_66":97},"publishedAt","2026-08-20T21:54:15.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:16.959Z","timelineAt","category","ai-tools","tags",[93,94],"score",22,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","guyfosel","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>12+ months after Helium10 rug-pulled its affiliates…</p><p>And 8+ months after H10 raised prices and added rate limits that basically made the Platinum plan useless…</p><p>…the hate for H10 still runs deep.</p><p>You’ll see H10 people justify the changes with some version of “we’ve released a bunch of new features!”</p><p>But they’re using that as a smokescreen.</p><p>H10 is probably fine in the short term.</p><p>They’re enough of a leader in the space that their CAC will still be low (new aspiring sellers will sign up after 2min of Google research).</p><p>And their LTV is probably fine right now because the rate increases offset an increase in churn.</p><p>But that won’t be the case forever.</p><p>There’s A LOT of emerging competition with better feature sets at lower prices.</p><p>And there are large influencers in the space actively promoting those emerging competitors.</p>","zhKind","complete","authorName","Bearded Egg FBA 🛠️","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[80],{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1206,"height",1909,"alt","poster","AI/工具","卖家工具","aihot","/items/fjs4144oj4gcholue3oaos9t9","https://x.com/guyfosel/status/2090558054865449306","x-bearded-egg-fba","name","X · Bearded Egg FBA","x_search","firstParty","iconUrl",{"_105":106},"changelogVersion","2026-10-09T22:08"]
