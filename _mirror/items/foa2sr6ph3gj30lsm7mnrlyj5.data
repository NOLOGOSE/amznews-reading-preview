[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","foa2sr6ph3gj30lsm7mnrlyj5","revision",3,"title","亚马逊推出评论邀请广告功能，10月下旬美国公测","originalTitle","Accelerate authentic reviews with Review Requests","summary","亚马逊广告宣布，评论邀请（Review Requests）广告将于 2026 年 10 月下旬在美国开放公测。广告面向近期购买过商品的顾客，邀请他们在亚马逊购物时提交星级评分或文字评论；广告活动在 Amazon Ads Agent 中创建和管理，使用与其他亚马逊广告活动相同的出价和预算控制。使用资格：广告账户状态良好、没有未处理政策违规的注册卖家和供应商；商品的评分和评论合计须少于 1000 条，达到 1000 条后该商品的评论邀请自动暂停。目前只在美国站提供，其他站点计划后续开放。官方称早期测试中，商品每周获得的评分和评论约为测试前的 3 倍（亚马逊内部数据，封闭测试，美国，2026 年 6 月 3–21 日）。","reason","官方上线公告写明了公测时间、卖家与商品的使用资格、1000 条自动暂停的门槛，以及测试数据的来源，卖家可据此判断自己的新品能否使用。","source",{"_9":98,"_99":100,"_72":101,"_102":41,"_103":104,"_105":106},"links",{"_95":96,"_66":97},"publishedAt","2026-09-29T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-29","discoveredAt","2026-10-22T17:24:11.696Z","timelineAt","category","advertising","tags",[92,93,94],"score",71,"selected",true,"channel","news","story","x","media",[69,70,71],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","亚马逊广告",{"_72":73,"_74":89,"_76":90,"_78":91,"_80":81,"_82":83,"_84":-5,"_85":-5},{"_72":73,"_74":86,"_76":87,"_78":88,"_80":81,"_82":83,"_84":-5,"_85":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/87f9b56a38df5551.webp","fullUrl","/amznews-reading-preview/_img/87f9b56a38df5551.webp","srcSet","/amznews-reading-preview/_img/87f9b56a38df5551.webp 336w, /amznews-reading-preview/_img/87f9b56a38df5551.webp 720w","width",453,"height",912,"alt","poster","/amznews-reading-preview/_img/54e05c1b279d4ae0.webp","/amznews-reading-preview/_img/54e05c1b279d4ae0.webp","/amznews-reading-preview/_img/54e05c1b279d4ae0.webp 336w, /amznews-reading-preview/_img/54e05c1b279d4ae0.webp 720w","/amznews-reading-preview/_img/0d99445593e2004c.webp","/amznews-reading-preview/_img/0d99445593e2004c.webp","/amznews-reading-preview/_img/0d99445593e2004c.webp 336w, /amznews-reading-preview/_img/0d99445593e2004c.webp 720w","AI/工具","亚马逊","广告/运营","aihot","/items/foa2sr6ph3gj30lsm7mnrlyj5","https://advertising.amazon.com/resources/whats-new/get-product-reviews-faster-with-review-requests/","official-amazon-ads-whats-new","name","亚马逊广告 · 产品更新","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/59e7dfe2bd310f3d.webp","iconSrcSet","/amznews-reading-preview/_img/59e7dfe2bd310f3d.webp 48w, /amznews-reading-preview/_img/59e7dfe2bd310f3d.webp 96w",{"_108":109},"changelogVersion","2026-10-09T22:08"]
