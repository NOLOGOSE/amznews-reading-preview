[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","foy3nzl2hj887uwz0khk17g43","revision",4,"title","亚马逊定制产品广告投放技巧：如何用广告增加流量入口并校准精准度","originalTitle","亚马逊定制产品玩法——广告投放技巧1","summary","亚马逊定制类产品（FBM）投放广告的核心目的有两种：增加收录、扩大流量入口，以及获取更多自然流量和销量。实操上可用自动广告、手动词组、手动广泛和ASIN扩展来拓展流量入口，再用手动精准和ASIN精准定位校准流量方向。作者自述曾做过一次测试：一条FBM链接上传24小时后被收录95个关键词，开5美金自动广告跑一晚后增至285个。","reason","source",{"_9":105,"_106":107,"_73":108,"_109":39,"_110":111,"_112":113},"links",{"_102":103,"_65":104},"publishedAt","2023-08-19T02:47:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:12.502Z","timelineAt","category","advertising","tags",[97,98,99,100,101],"score",34,"selected",false,"channel","news","story","x","media",[68,69,70,71,72],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","老陈聊跨境","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_73":74,"_75":94,"_77":95,"_79":96,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":91,"_77":92,"_79":93,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":88,"_77":89,"_79":90,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":85,"_77":86,"_79":87,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/90f972341f3a0ece.webp","fullUrl","/amznews-reading-preview/_img/90f972341f3a0ece.webp","srcSet","/amznews-reading-preview/_img/90f972341f3a0ece.webp 336w, /amznews-reading-preview/_img/90f972341f3a0ece.webp 720w","width","height","alt","poster","/amznews-read