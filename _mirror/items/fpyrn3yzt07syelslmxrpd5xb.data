[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","fpyrn3yzt07syelslmxrpd5xb","revision",2,"title","亚马逊发布欧洲站EUDR合规指南：7类商品需按角色提交尽职调查声明","originalTitle","2026年底大限！亚马逊欧洲7类商品须过零毁林关","summary","亚马逊发布针对欧洲站卖家的欧盟零毁林法规（EUDR）合规指南，要求牛肉、木材等7类商品的经营者或下游贸易商根据企业规模分别在2026年12月30日或2027年6月30日前完成合规。","reason","亚马逊官方详细解读了欧盟零毁林法规的适用对象、时间节点及卖家在供应链中的角色判定，并提供了后台提交合规信息的具体操作指引。","source",{"_9":133,"_134":135,"_92":136,"_137":66,"_138":139,"_140":141},"links",{"_130":131,"_68":132},"publishedAt","2026-10-16T09:52:07.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T15:07:28.121Z","timelineAt","category","policy","tags",[128,54,129],"score",74,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89,90,91],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","亚马逊","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation",false,"bodyLanguage","original","factId","f4GLlpC9pjRw",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","af4f0253-a091-412a-8eee-8d83cd6e3aa3","亚马逊欧洲站EUDR合规：7类商品分阶段执行",{"_77":78,"_13":79},"platform","雨果跨境",{"_92":93,"_94":125,"_96":126,"_98":127,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":122,"_96":123,"_98":124,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":119,"_96":120,"_98":121,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":116,"_96":117,"_98":118,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":113,"_96":114,"_98":115,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93