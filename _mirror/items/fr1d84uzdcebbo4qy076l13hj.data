[{"_1":2,"_3":4},"root",{"_5":127},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","fr1d84uzdcebbo4qy076l13hj","revision",6,"title","亚马逊卖家费用结构逐层审计：解析收入与利润差距及贡献毛利计算","originalTitle","Where Your Amazon Margin Actually Goes: A Line-by-Line Audit of the Seller Fee Stack","summary","文章指出亚马逊费用并非单一费率，而是由推荐费、FBA 配送费及入库配置服务费等构成的叠加体系，导致营收数字掩盖真实利润。作者建议通过计算单位贡献毛利（售价减去所有可变成本）来评估业务健康度，并强调需定期对照 Seller Central 最新费率页进行月度审计以捕捉利润泄漏。","reason","source",{"_9":118,"_119":120,"_88":121,"_122":40,"_123":124,"_125":126},"links",{"_115":116,"_68":117},"publishedAt","2026-10-08T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-09","discoveredAt","2026-10-09T11:09:39.006Z","timelineAt","category","policy","tags",[112,113,114],"score",28,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","Joey Glyshaw","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fjlbGebsfu48",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","47f38cca-a28d-4dd5-ac0c-a28e3b5f9825","亚马逊卖家费用结构详解与利润审计指南",{"_77":78,"_13":79},"platform","ZonFlip",{"_88":89,"_90":109,"_92":110,"_94":111,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":106,"_92":107,"_94":108,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":103,"_92":104,"_94":105,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":100,"_92":101,"_94":102,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":91,"_92":93,"_94":95,"_96":-5,"_97":-5,"