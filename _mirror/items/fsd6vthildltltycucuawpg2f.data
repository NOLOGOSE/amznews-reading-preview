[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":29,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":62,"_63":38,"_64":65},"id","fsd6vthildltltycucuawpg2f","revision",2,"title","Ozon 12月起调整卖家结算与物流收费","originalTitle","summary","Ozon宣布12月1日起取消折扣积分，改为结算公式直接计算折扣，并新设“送到分拣中心”费及越库固定价。该政策覆盖FBO、FBS、realFBS及Ozon配送模式，其中3公斤内每单最高收7卢布，超重每公斤加1卢布，单封上限39卢布；提货点代理费按经营年限每月1至550卢布，2027年7月起老点位涨至2200卢布。","reason","source",{"_9":100,"_101":102,"_80":103,"_104":38,"_105":106,"_107":108},"links",{"_97":98,"_65":99},"publishedAt","2026-10-20T08:16:44.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-20T09:06:39.114Z","timelineAt","category","fba","tags",[94,95,96],"score",45,"selected",false,"channel","news","story",{"_74":75,"_13":14},"x","media",[79],"byline",{"_51":-5,"_77":78},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[76],"indexable","markdownAvailable",true,"group",{"_66":67,"_41":68,"_69":70,"_71":72,"_73":72},"hasTranslation","bodyLanguage","original","factId","fhjYKSfRLEVI",{"_74":75,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","e9703fe5-2afc-4e30-9937-311a032a1468",{"_74":75,"_13":14},"platform","蓝海亿观网",{"_80":81,"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5},"kind","image","url","/amznews-reading-preview/_img/a7853733e61a8b4a.webp","fullUrl","/amznews-reading-preview/_img/a7853733e61a8b4a.webp","srcSet","/amznews-reading-preview/_img/a7853733e61a8b4a.webp 336w, /amznews-reading-preview/_img/a7853733e61a8b4a.webp 720w","width",760,"height",400,"alt","poster","FBA/物流","费用变更","亚马逊","aihot","/items/fsd6vthildltltycucuawpg2f","https://www.egainnews.com/article/74429","publisher-egainnews-article