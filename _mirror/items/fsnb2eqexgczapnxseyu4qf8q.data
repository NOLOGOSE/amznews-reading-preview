[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","fsnb2eqexgczapnxseyu4qf8q","revision",2,"title","亚马逊卖家获取Listing页面当日达次日达标标识的实操指南","originalTitle","过去4周群里问爆了：Listing页面上的这个“小标识”到底怎么获取？","summary","亚马逊全球开店发布卖家常见问题解答，指导如何提升商品前台“当日达/次日达”标识的展示比例。文章指出该标识由系统根据消费者位置与库存分布实时匹配，建议卖家将头部ASIN库存维持在6-8周并每3周规律补货，优先选择多点入仓或使用BPR包装方式（每件可获$0.15配送费折扣），并通过“配送时效”报告验证调整效果。","reason","原文以问答形式梳理了提升当日达次日达标展示比例的实操方法，涵盖数据查询、库存分布与入仓策略。","source",{"_9":101,"_102":103,"_73":104,"_105":41,"_106":-5},"links",{"_98":99,"_66":100},"publishedAt","2026-04-24T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-04-25","discoveredAt","2026-10-16T14:28:58.347Z","timelineAt","category","fba","tags",[94,95,96,97],"score",62,"selected",true,"channel","news","story","x","media",[69,70,71,72],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","亚马逊全球开店",{"_73":74,"_75":91,"_77":92,"_79":93,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":88,"_77":89,"_79":90,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":85,"_77":86,"_79":87,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/311e759c1866e32b.webp","fullUrl","/amznews-reading-preview/_img/311e759c1866e32b.webp","srcSet","/amznews-reading-preview/_img/311e759c1866e32b.webp 336w, /amznews-reading-preview/_img/311e759c1866e32b.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/62921d239fccf9ca.webp","