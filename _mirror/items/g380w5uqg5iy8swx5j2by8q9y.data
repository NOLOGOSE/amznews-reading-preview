[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","g380w5uqg5iy8swx5j2by8q9y","revision",2,"title","亚马逊首次披露德国中小企业年销售额超200亿欧元","originalTitle","German SMEs generate over 20 billion euros in sales on Amazon","summary","亚马逊首次披露德国中小企业去年通过其平台产生的总销售额超过200亿欧元，其中跨境销售达59亿欧元。该数据由亚马逊自报，主要出口市场包括法国、奥地利、意大利、美国和西班牙。尽管国际销售增长放缓至个位数百分比，但德国中小企业去年售出逾7.5亿件商品，平均每分钟1400件。","reason","source",{"_9":87,"_88":89,"_90":91,"_92":39,"_93":94,"_95":96},"links",{"_84":85,"_67":86},"publishedAt","2026-10-22T11:44:32.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T12:05:26.057Z","timelineAt","category","product","tags",[82,83],"score",40,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Arjan","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":12,"_74":75},"hasTranslation","bodyLanguage","original","factId","f6_-MPw7RGgM",{"_76":77,"_13":78},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","27e66195-34ca-4406-af25-7bd4066b8f36","亚马逊首披德国中小企业年销售额超200亿欧元",{"_76":77,"_13":78},"platform","Ecommerce News Europe","数据/报告","亚马逊","aihot","/items/g380w5uqg5iy8swx5j2by8q9y","https://ecommercenews.eu/german-smes-generate-over-20-billion-euros-in-sales-on-amazon/","author-ecommercenews-arjan-rolling","name","Ecommerce News Europe · Arjan van Oosterhout","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d9eefda62cc58e78.webp","iconSrcSet","/amznews-reading-preview/_img/d9eefda62cc58e78.webp 48w, /amznews-reading-preview/_img/d