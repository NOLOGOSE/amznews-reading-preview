[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","g5m08e5qsqsoy92hf7v6j94vp","revision",6,"title","Etsy 开店优缺点：费用、流量与 AI 渠道","originalTitle","Pros and cons of selling on Etsy: What No One Tells You Before You Start Selling","summary","原文来自 SellerApp，存在相关商业利益，并非独立测评。文章以该机构客户经验为基础，讨论在 Etsy 开店的优缺点：作者认为 Etsy 自带购买意图较强的买家、启动成本低、可继承平台信任，并称平台已接入 AI 购物渠道；同时列出竞争加剧、无法直接拥有客户、账户可能被暂停、支付储备占用现金流、算法调整影响排名、广告与站外广告费用、手工可信度受冲击等风险。费用方面，原文列出上架费每件 $0.20、交易费 6.5%、美国卖家支付处理 3% + $0.25、Etsy Plus 可选 $10/月、站外广告 12%（年销售额超过 $10,000 后强制），并称综合通常为每笔销售 10–14%，低于 Amazon Handmade 的 15%。文中客户案例与效果均为作者自述，本站尚未独立核验。","reason","source",{"_9":95,"_96":97,"_72":98,"_99":39,"_100":-5},"links",{"_92":93,"_65":94},"publishedAt","2026-08-05T11:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-09-30T06:02:30.425Z","timelineAt","category","product","tags",[90,91],"score",22,"selected",false,"channel","news","story","x","media",[69,70,71],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Nithin Mentreddy / Nived Uthaiah P / Ishita Banerjee / Spadikha Chakravarthy","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Nithin Mentreddy 等","platform","sellerapp",{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/1400f2279a42bd9f.webp","fullUrl","/amznews-reading-preview/_img/1400f2279a42bd9f.webp","srcSet","/amznews-reading