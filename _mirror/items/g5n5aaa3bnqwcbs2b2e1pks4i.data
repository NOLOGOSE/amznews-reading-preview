[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","g5n5aaa3bnqwcbs2b2e1pks4i","revision",1,"title","跨平台定价混乱损害品牌形象","originalTitle","$19.99 in stores. $16.99 on Amazon. $25.99 on TikTok.","summary","实体店售价 $19.99。亚马逊售价 $16.99。TikTok 售价 $25.99。\n\n当品牌定价参差不齐时，客户会感到困惑，品牌也会显得廉价。\n\n在首次通话中指出这一点。这能向品牌表明你在为他们的业务着想。","reason","source",{"_9":86,"_87":88,"_89":90,"_91":39,"_92":-5},"links",{"_83":84,"_66":85},"publishedAt","2026-10-13T14:25:13.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T16:14:18.159Z","timelineAt","category","advertising","tags",[80,81,82],"score",22,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","1000asins","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>$19.99 in stores. $16.99 on Amazon. $25.99 on TikTok.</p><p>When a brand's pricing is all over the place, customers get confused and the brand starts to look cheap.</p><p>Point that out on your first call. It shows the brand you're thinking about their business.</p>","zhKind","complete","authorName","Dan Boufford","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"广告/运营","多平台销售","品牌","aihot","/items/g5n5aaa3bnqwcbs2b2e1pks4i","https://x.com/1000asins/status/2110013996011061605","x-dan-boufford","name","X · Dan Boufford","kind","x_search","firstParty","iconUrl",{"_94":95},"changelogVersion","2026-10-09T22:08"]
