[{"_1":2,"_3":4},"root",{"_5":138},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","g5npfl4l5y6fvf9b8bi902jap","revision",1,"title","易智魔方推出文案侵权检测工具，注册送2026年会员","originalTitle","AI生图，能自动排查文案侵权风险了 | 注册福利","summary","易智魔方正式推出文案侵权检测工具，旨在AI生成内容上架前拦截商标词侵权风险。该工具支持对商品标题、描述及图片进行自动检测并高亮疑似侵权词，同时为AI创作素材提供风险提醒。原文带有商业推广性质，用户注册易智魔方即可获赠2026年全年白银会员及免费使用检测工具的福利。","reason","source",{"_9":129,"_130":131,"_76":132,"_133":39,"_134":135,"_136":137},"links",{"_126":127,"_64":128},"publishedAt","2026-10-14T07:51:36.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:54.170Z","timelineAt","category","ai-tools","tags",[122,123,124,125],"score",12,"selected",false,"channel","news","story","x","media",[67,68,69,70,71,72,73,74,75],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","蓝海亿观网",{"_76":77,"_78":118,"_80":119,"_82":120,"_84":85,"_86":121,"_88":-5,"_89":-5},{"_76":77,"_78":115,"_80":116,"_82":117,"_84":85,"_86":110,"_88":-5,"_89":-5},{"_76":77,"_78":111,"_80":112,"_82":113,"_84":114,"_86":114,"_88":-5,"_89":-5},{"_76":77,"_78":107,"_80":108,"_82":109,"_84":85,"_86":110,"_88":-5,"_89":-5},{"_76":77,"_78":102,"_80":103,"_82":104,"_84":105,"_86":106,"_88":-5,"_89":-5},{"_76":77,"_78":97,"_80":98,"_82":99,"_84":100,"_86":101,"_88":-5,"_89":-5},{"_76":77,"_78":93,"_80":94,"_82":95,"_84":85,"_86":96,"_88":-5,"_89":-5},{"_76":77,"_78":90,"_80":91,"_82":92,"_84":85,"_86":87,"_88":-5,"_89":-5},{"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":-5,"_89":-5},"kind","image","url",