[{"_1":2,"_3":4},"root",{"_5":133},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","g673jzl01inbiu8f9x4evz3r4","revision",2,"title","亚马逊欧洲10站燃油物流附加费上调至2% 11月旺季生效","originalTitle","亚马逊欧洲附加费再涨，旺季账要重算","summary","亚马逊宣布自2026年11月2日起将欧洲10个站点的FBA燃油及物流附加费从1.5%上调至2%，MCF服务自11月19日起执行。计费基数为配送费，平台称平均每件增加约0.02欧元，作者分析指出这收回了年初降费的约四成，且因按百分比计算会与旺季配送费叠加，大件重货受影响更大。","reason","原文梳理了欧洲站燃油物流附加费上调的具体费率、生效日期及与旺季配送费的叠加影响，并对比了历史降费数据。","source",{"_9":124,"_125":126,"_90":127,"_128":67,"_129":130,"_131":132},"links",{"_121":122,"_69":123},"publishedAt","2026-10-20T23:12:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-21T10:31:12.381Z","timelineAt","category","policy","tags",[117,118,119,120],"score",62,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86,87,88,89],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","欧洲跨境之路","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":12,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fc5buGKM2v34",{"_78":79,"_13":80},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","bc6e2a21-a35f-4fb5-bd3e-84734e57c3d2","亚马逊欧洲站燃油及物流附加费上调至2%",{"_78":79,"_13":80},"platform","AMZ123",{"_90":91,"_92":114,"_94":115,"_96":116,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":111,"_94":112,"_96":113,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":108,"_94":109,"_96":110,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":105,"_94":106,"_96":107,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":102,"_94":103,"_96":104,"_98":-5,"_99":-5,"_100