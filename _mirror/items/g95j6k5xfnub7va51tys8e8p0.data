[{"_1":2,"_3":4},"root",{"_5":79},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":24,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","g95j6k5xfnub7va51tys8e8p0","revision",1,"title","商务部美大司负责人解读第八轮中美经贸磋商成果","originalTitle","summary","商务部美大司负责人就第八轮中美经贸磋商成果进行解读。双方同意在中美经贸磋商机制项下建立中美贸易理事会和投资理事会；在贸易理事会框架下就“300亿对300亿”对等降税安排达成共识，双方同意以对等方式降低自对方进口的规模约300亿美元产品的关税，其中各自约90%产品的关税将降至最惠国税率水平，并将在按照各自国内法律履行相关程序后同步实施，有关情况将后续公布。中方自美进口煤炭关税将纳入该框架。双方同意在贸易理事会下设立农业工作组，由中国商务部和美国贸易代表办公室共同牵头，并计划在2026年年底前举行第一次会议；双方还建立人工智能对话并同意建立人工智能事件沟通渠道。吉隆坡经贸磋商联合安排将延期至2027年1月10日，双方将继续探讨。","reason","source",{"_9":72,"_73":74,"_75":76,"_77":60,"_78":-5},"links",{"_69":70,"_64":71},"publishedAt","2026-09-28T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-28","discoveredAt","2026-10-17T05:16:21.106Z","timelineAt","category","policy","tags",[67,68],"score",47,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","商务部","政策/合规","亚马逊","aihot","/items/g95j6k5xfnub7va51tys8e8p0","https://www.mofcom.gov.cn/xwfb/sjfzrfb/art/2026/art_cd060e0649964da8ae13216c3bb1a645.html","official-cn-mofcom-press","name","商务部 · 新闻发布","kind","web_list","firstParty","iconUrl",{"_80":81},"changelogVersion","2026-10-09T22:08"]
