[{"_1":2,"_3":4},"root",{"_5":137},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","g9bq8nwl79d0as8itqxweivu2","revision",2,"title","欧盟废止对华太阳能玻璃双反税并启动追溯退税","originalTitle","欧盟服软了！欧盟取消对中国商品的关税","summary","欧盟委员会于2026年10月21日公告废止对中国太阳能玻璃征收的反倾销与反补贴税，生效日为10月22日。海关将不计利息退还自2025年7月22日起已征收的税款，进口商需主动申请。该政策仅针对特定技术参数的光伏上游工业中间品，与亚马逊等平台的普通消费品无关，体现欧盟对产业链上游放开、下游收紧的结构性分化策略。","reason","source",{"_9":131,"_132":133,"_88":134,"_135":39,"_136":-5},"links",{"_128":129,"_67":130},"publishedAt","2026-10-23T02:37:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-23T04:26:28.140Z","timelineAt","category","policy","tags",[125,126,127],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83,84,85,86,87],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","嘀嗒嘀物流科技","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","f0jTg6AcJukY",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","26c44292-5142-4269-98c3-ea160df62492","欧盟废止对华太阳能玻璃双反税并追溯退税",{"_76":77,"_13":78},"platform","卖家之家",{"_88":89,"_90":122,"_92":123,"_94":124,"_96":-5,"_98":-5,"_100":-5,"_101":-5},{"_88":89,"_90":117,"_92":118,"_94":119,"_96":120,"_98":121,"_100":-5,"_101":-5},{"_88":89,"_90":112,"_92":113,"_94":114,"_96":115,"_98":116,"_100":-5,"_101":-5},{"_88":89,"_90":107,"_92":108,"_94":109,"_96":110,"_98":111,"_100":-5,"_101":-5},{"_88":89,"_90":102,"_92":103,"_94":104,"_96":105,"_98":106,"_100":-5,"_101":-5},{"_88":89,"_90":91,"_92":93,"_94":95,"_96":97,"_