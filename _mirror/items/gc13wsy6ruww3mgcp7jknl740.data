[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","gc13wsy6ruww3mgcp7jknl740","revision",3,"title","亚马逊在巴西巴拉那州启用首个配送中心，每周可处理超70万件包裹","originalTitle","亚马逊巴西启用巴拉那州首个配送中心","summary","亚马逊在巴西巴拉那州圣若泽杜斯平海斯启用该州首个配送中心，面积2.4万平方米，初始每周可处理超70万件包裹，巴拉那州消费者可享当日送达。该中心全年无休、7×24小时运行，旺季最多可调动900名直接和间接工作人员，负责向巴拉那州和圣卡塔琳娜州发运商品并支持合作卖家。目前亚马逊在巴西拥有超300个物流中心，其中40多个位于南部地区。","reason","source",{"_9":88,"_89":90,"_70":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_65":87},"publishedAt","2026-09-07T03:13:59.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:19.083Z","timelineAt","category","fba","tags",[82,83,84],"score",22,"selected",false,"channel","news","story","x","media",[69],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Summer","platform","AMZ123",{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/b91b51852c7cf3ab.webp","fullUrl","/amznews-reading-preview/_img/b91b51852c7cf3ab.webp","srcSet","/amznews-reading-preview/_img/b91b51852c7cf3ab.webp 336w, /amznews-reading-preview/_img/b91b51852c7cf3ab.webp 720w","width","height","alt","poster","FBA/物流","供应链","亚马逊","aihot","/items/gc13wsy6ruww3mgcp7jknl740","https://www.amz123.com/t/TGz96JMa","author-amz123-summer","name","AMZ123 · SUMMER","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_