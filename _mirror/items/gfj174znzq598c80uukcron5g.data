[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","gfj174znzq598c80uukcron5g","revision",1,"title","SellerApp 2026 基准数据：亚马逊 DSP 新客购买率达 36.5%","originalTitle","Amazon DSP for New to Brand Growth Backed by SellerApp 2026 Benchmark Data","summary","SellerApp 发布 2026 年基准报告，显示亚马逊 DSP 的新品牌（New to Brand, NTB）购买率为 36.5%，表明 NTB 在 DSP 归因销售中占比显著。NTB 定义为过去 12 个月内未从该品牌购买的客户完成合格购买，是衡量 DSP 是否真正扩大客户群而非仅转化现有需求的关键指标。","reason","source",{"_9":100,"_101":102,"_72":103,"_104":39,"_105":-5},"links",{"_97":98,"_65":99},"publishedAt","2026-10-17T11:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T20:00:28.904Z","timelineAt","category","advertising","tags",[93,94,95,96],"score",38,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Ankitha Nagaraj","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","sellerapp",{"_72":73,"_74":90,"_76":91,"_78":92,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/ae902a2ff311fdf8.webp","fullUrl","/amznews-reading-preview/_img/ae902a2ff311fdf8.webp","srcSet","/amznews-reading-preview/_img/ae902a2ff311fdf8.webp 336w, /amznews-reading-preview/_img/ae902a2ff311fdf8.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/ff280cf