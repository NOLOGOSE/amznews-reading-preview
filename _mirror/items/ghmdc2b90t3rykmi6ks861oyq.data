[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","ghmdc2b90t3rykmi6ks861oyq","revision",2,"title","用卖家精灵 MCP 跑选品：3 个反常识方法，帮中小卖家找到可复制机会","originalTitle","summary","卖家精灵 MCP 把卖家精灵的数据能力接入 AI，让中小卖家按自己的选品逻辑批量整理数据。文章给出 3 个反常识方法：小卖家复制法（研究资源相近、打法可复制的卖家而非大卖）、差评分析法（从 1–3 星评论按人群—场景—任务—痛点拆解产品改良方向）、场景元素迁移法（把其他场景已验证的视觉、礼品、配件元素迁移到当前产品）。MCP 不是自动选品按钮，而是效率放大器，指令越明确输出越稳定。","reason","source",{"_9":121,"_122":123,"_76":124,"_125":38,"_126":127,"_128":129},"links",{"_118":119,"_64":120},"publishedAt","2026-09-23T17:37:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:27.939Z","timelineAt","category","ai-tools","tags",[112,113,114,115,116,117],"score",23,"selected",false,"channel","news","story","x","media",[67,68,69,70,71,72,73,74,75],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","卖家精灵","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_76":77,"_78":109,"_80":110,"_82":111,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":106,"_80":107,"_82":108,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":103,"_80":104,"_82":105,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":100,"_80":101,"_82":102,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":97,"_80":98,"_82":99,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":94,"_80":95,"_82":96,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":91,"_80":92,"_82":93,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":88,"_80":89,"_82":90,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85