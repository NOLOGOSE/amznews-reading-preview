[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","gmtfdhqj36uh7y6or01t6i0xs","revision",2,"title","亚马逊 FBA 箱标贴放指南：Box ID 与承运商标签贴在哪里","originalTitle","Amazon FBA Box Label Placement: Where to Put Box ID and Carrier Labels","summary","亚马逊 FBA 入仓时，每个外箱都需贴 FBA Box ID（箱标），并通常另贴承运商标签，两者须平整、无遮挡地贴在干净箱面，条码不得折过边角。若走 LTL/FTL 打托，还需在缠绕膜外侧四面加贴托盘标签，但托盘标签不替代箱标。常见错误包括标签跨接缝、用胶带或塑料袋覆盖条码，以及复用旧箱未清除旧标导致误扫。","reason","source",{"_9":97,"_98":67,"_71":99,"_100":39,"_101":102,"_103":104},"links",{"_94":95,"_65":96},"publishedAt","2026-02-06T02:00:35.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-01T18:12:05.210Z","timelineAt","category","fba","tags",[91,92,93],"score",31,"selected",false,"channel","news","story","x","media",[68,69,70],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Aaron Yi","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FBABEE",{"_71":72,"_73":88,"_75":89,"_77":90,"_79":80,"_81":82,"_83":-5,"_84":-5},{"_71":72,"_73":85,"_75":86,"_77":87,"_79":80,"_81":82,"_83":-5,"_84":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/cd26350251db7700.webp","fullUrl","/amznews-reading-preview/_img/cd26350251db7700.webp","srcSet","/amznews-reading-preview/_img/cd26350251db7700.webp 336w, /amznews-reading-preview/_img/cd26350251db7700.webp 720w","width",1536,"height",1024,"alt","poster","/amznews-reading-preview/_img/360552b36d3e1b23.webp","/amznews-reading-preview/_img/360552b36d3e1b23.webp","/amznews-reading-preview/