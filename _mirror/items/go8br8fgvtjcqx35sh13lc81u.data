[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","go8br8fgvtjcqx35sh13lc81u","revision",2,"title","2026年亚马逊AWD是否值得使用：成本对比与选品建议","originalTitle","Is Amazon AWD Still Worth It in 2026? A Cost Comparison","summary","作者认为2026年标准尺寸且销量稳定的卖家在Q4旺季备货时使用亚马逊仓储和分销（AWD）更具性价比，但在非旺季则不划算。文章指出自2026年起AWD西部存储费上涨至$0.57每立方英尺每月，且不再接受超大件商品并要求入库前完成预处理。作者建议卖家根据单品的具体体积、包装密度和平均周转天数进行单位成本核算，以决定采用AWD还是第三方海外仓。","reason","source",{"_9":96,"_97":98,"_70":99,"_100":39,"_101":102,"_103":104},"links",{"_93":94,"_65":95},"publishedAt","2026-10-02T21:41:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:20.660Z","timelineAt","category","fba","tags",[89,90,91,92],"score",62,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/1d5e4990800a94c9.webp","fullUrl","/amznews-reading-preview/_img/1d5e4990800a94c9.webp","srcSet","/amznews-reading-preview/_img/1d5e4990800a94c9.webp 336w, /amznews-reading-preview/_img/1d5e4990800a94c9.webp 720w","width",1600,"height",979,"alt","poster","/amznews-reading-preview/_img/e8ed074b4e63a434.webp","/amznews-reading-preview/_img/e8ed074b4e63a434.webp","/amznews-reading-preview/_img/e8ed074b4e63a434.webp 336w, /amznews-reading-preview/_im