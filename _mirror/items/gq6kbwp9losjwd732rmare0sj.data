[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","gq6kbwp9losjwd732rmare0sj","revision",2,"title","亚马逊开放 Claude 管理卖家平台与广告功能及实操指南","originalTitle","Managing Amazon Through Claude: Seller Plugin and Ads MCP Server","summary","原文介绍亚马逊 Selling Partner 插件（Claude 美国站 beta）和 Amazon Ads MCP server（open beta），并给出按任务风险分配权限的实操建议。原文来自该机构，存在相关商业利益，并非独立测评。插件为美国站 beta，Ads MCP server 需 Amazon Ads API 凭证，插件看不到 COGS、运费、关税或 VAT，无法判断利润；定价、预算、删除和申诉需人工决策，建议先以 recommend-only 模式运行并每周审查审计记录。","reason","source",{"_9":96,"_97":98,"_70":99,"_100":39,"_101":102,"_103":104},"links",{"_93":94,"_65":95},"publishedAt","2026-10-02T16:11:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:24.492Z","timelineAt","category","ai-tools","tags",[89,90,91,92],"score",62,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/a6082a46ea0ec479.webp","fullUrl","/amznews-reading-preview/_img/a6082a46ea0ec479.webp","srcSet","/amznews-reading-preview/_img/a6082a46ea0ec479.webp 336w, /amznews-reading-preview/_img/a6082a46ea0ec479.webp 720w","width",1600,"height",787,"alt","poster","/amznews-reading-preview/_img/588bec8cc3353d5f.webp","/amznews-reading-preview/_img/588bec8cc3353d5f.