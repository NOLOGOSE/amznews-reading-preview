[{"_1":2,"_3":4},"root",{"_5":122},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":41,"_62":41,"_63":-5,"_64":65,"_66":67},"id","gr9k6706bzanrqncbj0sdkzql","revision",1,"title","Regan跨境分享亚马逊广告位加价导致ACOS飙升的原因与排查步骤","originalTitle","我把亚马逊广告位调整10%，ACOS直接就炸了","summary","Regan跨境指出卖家盲目上调搜索顶部等广告位加价比例易导致CPC翻倍而销售额未同比例增长，进而使ACOS恶化。作者建议先根据产品利润测算每单可承受的广告费上限和目标平均CPC，再对比调整前后各广告位的CPC、转化率及花费占比以定位成本来源。此外，作者强调需结合7天点击归因窗口和报表延迟判断数据成熟度，并通过控制变量重新测试来验证调整效果。","reason","作者结合竞价叠加机制与归因窗口，拆解了调整广告位后ACOS飙升的排查逻辑，提供了从测算盈亏平衡点到控制变量测试的实操方法。","source",{"_9":113,"_114":115,"_77":116,"_117":65,"_118":119,"_120":121},"links",{"_110":111,"_67":112},"publishedAt","2026-10-16T18:07:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-17","discoveredAt","2026-10-19T01:50:34.981Z","timelineAt","category","advertising","tags",[107,108,109],"score",62,"selected",true,"channel","news","story","x","media",[70,71,72,73,74,75,76],"byline",{"_53":54,"_68":69},"detailedGuide","readingMode","full","author","Regan跨境","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","AMZ123",{"_77":78,"_79":104,"_81":105,"_83":106,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":98,"_81":99,"_83":100,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":95,"_81":96,"_83":97,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":92,"_81":93,"_83":94,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":-5,"_87":-5,"_88":-5},"kind","image","url","/amznews-reading-preview/_img/35b0f7b8