[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","gs36i069bdcn44r66g25n1jfg","revision",1,"title","Acadia 解析 Amazon Marketing Cloud 如何改变亚马逊广告定向","originalTitle","Smarter Targeting, Better Results: What AMC Actually Changes About Amazon Advertising","summary","原文来自 Acadia，作者 Ross Walker 自述为该公司零售媒体总监，存在相关商业利益，并非独立测评。文章讨论 Amazon Marketing Cloud（AMC）在亚马逊广告定向中的两类用法：一是基于实际购买者数据构建相似受众，对搜索或受众条件做进一步筛选；二是按用户已接触的广告与行为信号做序列化投放。作者强调序列化投放只有在信号能够打通时才成立，并称其经验中可衡量上层漏斗的品牌才会持续投入该部分预算。文中还提到亚马逊五年零售购买回溯期（此前为13个月），作者称其面向耐用品、补货品和季节性商品，并支持自定义受众与客户生命周期价值等指标。作者引用一项客户案例，称在关键词不变的情况下复制广告活动、降低出价并叠加购买者相似受众的出价调整后，ACoS、ROAS、CPC、CVR、CPA 等指标出现变化；该案例为单一客户个案，本站尚未独立核验。作者还称有品牌使用更长数据集后报告 CPM 下降 26%，但明确表示不会向任何人保证该数字。文中提到亚马逊暂时取消第一方 AMC 付费功能数据集的付费墙，免费期至 2026 年 12 月 31 日，若选择加入后未在年底前退出，2027 年继续使用将被收费；第三方数据集如 Experian 仍需付费订阅。作者认为数据更易获取不等于策略自动成立，真正的门槛在于把数据转化为受众、出价和序列执行。","reason","source",{"_9":87,"_88":89,"_69":90,"_91":39,"_92":93,"_94":95},"links",{"_84":85,"_65":86},"publishedAt","2026-09-16T17:29:55.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-12T06:06:11.413Z","timelineAt","category","advertising","tags",[81,82,83],"score",44,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Ross Walker","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Acadia",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/a969e1019557d516.svg","fullUrl","/amznews-reading-preview/_img/a969e1019557d516.svg","srcSet","/amznews-reading-preview/_img/a969e1019557d516.svg 336w, /amznews-reading-preview/_img/a969e1019557d516.svg 720w","width","height","alt","poster","广告/运营","Amazon Ads","亚马逊","aihot","/items/gs36i069bdcn44r66g25n1jfg","https://acadia.io/amc-audiences-amazon-ad-targeting","acadia-retail-media-rolling","name","Acadia 亚马逊与零售媒体博客","rss","firstParty","iconUrl","/amznews-reading-preview/_img/bf0321f1fad93a43.webp","iconSrcSet","/amznews-reading-preview/_img/bf0321f1fad93a43.webp 48w, /amznews-reading-preview/_img/bf0321f1fad93a43.webp 96w",{"_97":98},"changelogVersion","2026-10-09T22:08"]
