[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","gwhllys3xsumw0phi5k97yoxl","revision",1,"title","Regfear 召回 BedsPick 床垫：违反强制阻燃标准，存在火灾致死致伤风险","originalTitle","Regfear Recalls BedsPick Mattresses Due to Risk of Serious Injury or Death from Fire; Violate Mandatory Flammability Standard for Mattresses","summary","Regfear Ltd. 召回约 818 张 BedsPick 品牌床垫，原因是违反床垫强制阻燃标准，存在火灾导致严重伤害或死亡的风险。涉事床垫为 12 英寸厚 queen 尺寸，2025 年 2 月至 2026 年 5 月在 Amazon.com 以 140 至 200 美元售出，消费者应停用并联系 Regfear 获取全额退款。","reason","source",{"_9":73,"_74":66,"_75":76,"_77":60,"_78":79,"_80":81},"links",{"_70":71,"_64":72},"publishedAt","2026-09-17T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T14:12:19.627Z","timelineAt","category","policy","tags",[67,68,69],"score",24,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","退货管理","aihot","/items/gwhllys3xsumw0phi5k97yoxl","https://cpsc.gov/Recalls/2026/Regfear-Recalls-BedsPick-Mattresses-Due-to-Risk-of-Serious-Injury-or-Death-from-Fire-Violate-Mandatory-Flammability-Standard-for-Mattresses","official-cpsc-amazon-recalls-reviewed","name","kind","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp","iconSrcSet","/amznews-reading-preview/_img/382881c3aef48a1a.webp 48w, /amznews-reading-preview/_img/382881c3aef48a1a.webp 96w",{"_83":84},"changelogVersion","2026-10-09T22:08"]
