[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","gy3vj64j8pb1honnxcqz8byo0","revision",2,"title","Feedvisor 发布 Prime Day 2026 数据：营收增长但盈利难度加大","originalTitle","Prime Day 2026 Results: Growth Continued, But Profitable Growth Got More Harder to Earn","summary","Feedvisor 分析显示，其客户在 Prime Day 2026 期间销售额同比增长 25%，但平均订单价值下降 5.8%。由于 CPC 和 CPM 分别上涨 13.5% 和 11%，商品详情页转化率从 3.23% 提升至 5.20% 成为维持利润的核心因素。此外，亚马逊自 4 月起收紧参考价规则，要求划线价必须有真实成交记录支撑，这促使卖家放弃虚假折扣以换取更高的价格可信度。","reason","原文结合第三方数据与自身客户样本，指出转化率提升是抵消流量成本上涨的关键，并提示了定价规则收紧对折扣可信度的影响。","source",{"_9":112,"_113":114,"_74":115,"_116":64,"_117":-5},"links",{"_109":110,"_66":111},"publishedAt","2026-07-13T18:21:11.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:47.681Z","timelineAt","category","product","tags",[105,106,107,108],"score",62,"selected",true,"channel","news","story","x","media",[69,70,71,72,73],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","Marissa Incitti","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","Feedvisor",{"_74":75,"_76":102,"_78":103,"_80":104,"_82":97,"_84":98,"_86":87,"_88":-5},{"_74":75,"_76":99,"_78":100,"_80":101,"_82":97,"_84":98,"_86":87,"_88":-5},{"_74":75,"_76":94,"_78":95,"_80":96,"_82":97,"_84":98,"_86":87,"_88":-5},{"_74":75,"_76":89,"_78":90,"_80":91,"_82":92,"_84":93,"_86":87,"_88":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":-5},"kind","image","url","/amznews-reading-preview/_img/53d17b535575eb26.webp","fullUrl","/amznews-reading-preview/_img/53d17b535575eb26.webp",