[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","gzuclmfy9tg4nywvfi6oo4l08","revision",2,"title","壹鑫财税解析ODI备案后境外利润合规汇回境内的路径与税务风险","originalTitle","壹鑫财税｜ODI备案后，境外公司赚到的利润如何汇回境内？","summary","壹鑫财税指出，完成ODI备案不代表境外利润可直接汇回境内，企业需区分账户余额、会计利润与可分配利润，并依法履行分红程序。文章强调资金回流须匹配真实交易，涉及境外所得税申报、境内企业所得税抵免及银行审核材料准备，建议提前梳理财务与税务证据链以规避合规风险。","reason","source",{"_9":101,"_102":103,"_84":104,"_105":40,"_106":107,"_108":109},"links",{"_98":99,"_68":100},"publishedAt","2026-10-22T00:32:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-22T10:36:26.801Z","timelineAt","category","policy","tags",[96,97],"score",27,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","壹鑫国际财税专栏","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fsWrnjPjD4jY",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","1c493207-bbd6-4748-9125-d88b78844235","壹鑫财税解析ODI备案后境外利润汇回合规路径",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/12f476cb054d28ab.webp","fullUrl","/amznews-reading-preview/_img/12f476cb054d28ab.webp","srcSet","/amznews-reading-preview/_img/12f476cb054d28ab.webp 336w, /amznews-reading-preview/_img/12f476cb054d28ab.webp 720w","width","height","alt","poster","政策/合规","合规税务","aihot","/items/gzuclmfy9tg4nywvfi6oo4l08","https://www.amz123.com