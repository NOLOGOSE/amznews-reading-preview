[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","h1wphhcy6yp7nqlepnpro1rs8","revision",2,"title","亚马逊提醒卖家确认进口备案人以应对美国进口新规","originalTitle","美国进口新规将生效，亚马逊卖家需确认IOR","summary","亚马逊发布通知，指出基于EO 14411的美国进口新规则正处审查阶段，可能较快实施，建议卖家提前确认进口备案人（IOR）身份。使用外国IOR的卖家受影响最大，需准备CTPAT资质核查、保证金类型确认等；美国IOR卖家需关注资产覆盖与合规状态。目前无变更生效，但建议本周内联系货运代理或报关行核实IOR信息并制定预案。","reason","source",{"_9":133,"_134":135,"_92":136,"_137":39,"_138":139,"_140":141},"links",{"_130":131,"_67":132},"publishedAt","2026-10-20T10:04:52.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-20T10:37:38.058Z","timelineAt","category","policy","tags",[128,129,53],"score",58,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89,90,91],"byline",{"_52":53,"_81":82},"detailedGuide","readingMode","full","author","亚马逊","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":76},"hasTranslation","bodyLanguage","original","factId","fmaocLwjsyyA",{"_77":78,"_13":79},"reportCount",4,"additionalSourceCount",1,"developmentCount",0,"publicId","17e32b95-4b2d-40d4-9f1a-a5926dff996a","亚马逊提醒卖家自查IOR应对美国进口新规",{"_77":78,"_13":79},"platform","雨果跨境",{"_92":93,"_94":125,"_96":126,"_98":127,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":122,"_96":123,"_98":124,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":119,"_96":120,"_98":121,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":116,"_96":117,"_98":118,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":113,"_96":114,"_98":115,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":11