[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","h27wgigbautmkay1e2g02z012","revision",1,"title","亚马逊暂停与21 Air的货运合同","originalTitle","Amazon calls timeout on 21 Air cargo contract","summary","亚马逊因21 Air货机在迈阿密机场冲出跑道致5人死亡，决定暂时暂停与其业务合作。发言人Kelly Nantel称此举旨在配合调查并评估安全协议，预计对客户影响甚微。鉴于旺季临近及飞机转移需近一年，行业高管推测亚马逊可能转向ABX Air等现有合作伙伴填补运力缺口。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-09-15T14:16:29.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:42.306Z","timelineAt","category","fba","tags",[68,69,70],"score",20,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves","FBA/物流","供应链","亚马逊","aihot","/items/h27wgigbautmkay1e2g02z012","https://www.freightwaves.com/news/amazon-calls-timeout-on-21-air-cargo-contract","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
