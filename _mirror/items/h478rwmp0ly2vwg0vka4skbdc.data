[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","h478rwmp0ly2vwg0vka4skbdc","revision",2,"title","TikTok Shop LIVE 是人员配置问题，不是内容问题","originalTitle","TikTok Shop LIVE Is a Staffing Problem, Not a Content Problem","summary","TikTok Shop LIVE 直播失败多因运营结构问题，而非内容质量差。原文指出直播需要主播、副播、场控、制片、运营五个角色，小团队可一人多角色但每个职责需有明确负责人；建议先搭好运营流程再增加直播频次，并强调真实稀缺、真实社会证明、合规宣称与诚实定价。","reason","source",{"_9":108,"_109":110,"_74":111,"_112":39,"_113":114,"_115":116},"links",{"_105":106,"_65":107},"publishedAt","2026-09-29T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T22:19:55.595Z","timelineAt","category","advertising","tags",[101,102,103,104],"score",32,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Joey Glyshaw","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","ZonFlip",{"_74":75,"_76":98,"_78":99,"_80":100,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":95,"_78":96,"_80":97,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":92,"_78":93,"_80":94,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":89,"_78":90,"_80":91,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/7aba20785aa0d722.webp","fullUrl","/amznews-reading-preview/_img/7aba20785aa0d722.webp","srcSet","/amznews-reading-preview/_img/7aba20785aa0d722.webp 336w, /amznews-r