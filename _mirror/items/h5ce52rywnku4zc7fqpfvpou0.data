[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","h5ce52rywnku4zc7fqpfvpou0","revision",1,"title","美国海关发布低值货物入境规则：区分非邮政与邮政渠道暂停免税待遇","originalTitle","Low-Value Shipments","summary","美国海关与边境保护局（CBP）在联邦公报发布关于低值货物（Low-Value Shipments）的规则文件。据原文脚注，2026年6月24日CBP分别发布两份临时最终规则，一份暂停非邮政渠道低值货物的免税豁免，另一份暂停邮政渠道低值货物的免税豁免。","reason","原文列出了低值货物免税豁免暂停后涉及的入境类型要求、数据字段及违规罚款标准等规则内容，可供相关进口商与承运人了解合规要求。","source",{"_9":74,"_75":76,"_77":78,"_79":40,"_80":81,"_82":83},"links",{"_71":72,"_66":73},"publishedAt","2026-10-08T04:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:13:45.511Z","timelineAt","category","policy","tags",[69,70],"score",62,"selected",true,"channel","news","story","x","media",[],"byline",{"_52":-5,"_67":68},"detailedGuide","readingMode","full","author","Homeland Security Department, U.S. Customs and Border Protection","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","美国海关 CBP","政策/合规","行业动态","aihot","/items/h5ce52rywnku4zc7fqpfvpou0","https://www.federalregister.gov/documents/2026/10/08/2026-20650/low-value-shipments","official-us-cbp-federal-register","name","美国海关 CBP · 联邦公报公告","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/fb25db0934701e45.webp","iconSrcSet","/amznews-reading-preview/_img/fb25db0934701e45.webp 48w, /amznews-reading-preview/_img/fb25db0934701e45.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
