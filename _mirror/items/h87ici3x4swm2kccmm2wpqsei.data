[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","h87ici3x4swm2kccmm2wpqsei","revision",3,"title","亚马逊秋促预算有限卖家的5类捡漏广告打法","originalTitle","接下来的亚马逊秋促别只抢首页流量，5类“捡漏打法”分享！","summary","Regan跨境提出，预算有限的卖家在大促期间不必全天硬抢核心词首页，而应寻找竞品预算断档、长尾词、非首页广告位、竞品详情页和大促尾场留下的流量缺口。文中给出可承受CPC的计算方式，即售价乘目标ACOS再乘预估转化率，并以售价40美元、目标ACOS 25%、预估转化率10%为例算出可承受CPC为1美元。","reason","source",{"_9":121,"_122":123,"_77":124,"_125":39,"_126":127,"_128":129},"links",{"_118":119,"_65":120},"publishedAt","2026-09-20T18:01:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:24.894Z","timelineAt","category","advertising","tags",[113,114,115,116,117],"score",52,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Regan跨境","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_77":78,"_79":110,"_81":111,"_83":112,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":107,"_81":108,"_83":109,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":104,"_81":105,"_83":106,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":98,"_81":99,"_83":100,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":95,"_81":96,"_83":97,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":92,"_81":93,"_83":94,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":-5,"_87":-5,"_88":-5