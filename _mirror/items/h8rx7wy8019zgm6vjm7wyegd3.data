[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","h8rx7wy8019zgm6vjm7wyegd3","revision",3,"title","每位 FBA 卖家都该记住的补货点公式","originalTitle","The Reorder Point Formula Every FBA Seller Should Have Memorized by Now","summary","FBA 补货点公式为（日均销量 × 补货周期）+ 安全库存，例如日均 20 单、周期 30 天、安全库存 200 件时补货点为 800 件。旺季前用固定 30 天均值会失真：近 30 天日均 29 单、前两期分别为 21 和 17 单时，按 50%/30%/20% 加权可得约 24.2 单/天。亚马逊称其 FBA 补货建议使用销售历史、需求预测和季节性。","reason","source",{"_9":92,"_93":67,"_70":94,"_95":39,"_96":97,"_98":99},"links",{"_89":90,"_65":91},"publishedAt","2026-09-09T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T18:26:14.161Z","timelineAt","category","fba","tags",[85,86,87,88],"score",26,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Bob Norberg","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","eComEngine",{"_70":71,"_72":82,"_74":83,"_76":84,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/b1f016d4b49d866e.webp","fullUrl","/amznews-reading-preview/_img/b1f016d4b49d866e.webp","srcSet","/amznews-reading-preview/_img/b1f016d4b49d866e.webp 336w, /amznews-reading-preview/_img/b1f016d4b49d866e.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/99af8aead9e5ee93.webp","/amznews-reading-preview/_img/99af8aead9e5ee93.webp","/amznews-reading-preview/_img/99af8aead9e5ee93.webp 336w, /amznews-reading-preview/_img/99af8ae