[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","he2zxwslq3mgjm3ckkd3ne3md","revision",1,"title","亚马逊市值破3万亿及遭200亿美元诉讼","originalTitle","Amazon touched a $3T market cap on Aug 3, 2026 : 5th company ever to hit that mark","summary","亚马逊于2026年8月3日市值突破3万亿美元，主要受AWS收入同比增长37%驱动。同期FTC联合22州起诉亚马逊，指控其自2019年起通过Sponsored Products等广告收取约200亿美元隐藏附加费。作者指出尽管亚马逊辩称平均竞价下降50%，但部分关键词CPC仍高达5-8美元。","reason","source",{"_9":99,"_100":101,"_81":102,"_103":39,"_104":-5},"links",{"_96":97,"_66":98},"publishedAt","2026-09-03T17:58:06.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:42:17.667Z","timelineAt","category","policy","tags",[93,94,95],"score",30,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Rambler_Amz","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Amazon touched a $3T market cap on Aug 3, 2026 : 5th company ever to hit that mark</p><p>Driven almost entirely by AWS: revenue +37% YoY, fastest growth in years</p><p>Wall Street is now pricing Amazon as an Al/cloud infrastructure company first, retailer second</p><p>Stock has since cooled ~4% off that high, alongside a $4B Bezos insider sale</p><p>This week: $20 Billion Lawsuit</p><p>FTC + 22 states sue Amazon<br>Alleges $20B in hidden ad surcharges since 2019</p><p>Covers Sponsored Products, Sponsored Brands, Sponsored Display</p><p>Amazon's defense: avg. winning bid down 50% since 2019; advertisers saved $8B +(2021-2025) from relevance-based ranking.</p><p>Trillions vs Billions and here my partners are paying $5-$8 USD (CPC) on few keywords</p>","zhKind","complete","authorName","Rambler | X -Amazonian | Account Health Expert |","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[80],{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1408,"height",768,"alt","poster","政策/合规","亚马逊","Amazon Ads","aihot","/items/he2zxwslq3mgjm3ckkd3ne3md","https://x.com/Rambler_Amz/status/2095572055953703105","x-rambler-amz","name","X · Rambler","x_search","firstParty","iconUrl",{"_106":107},"changelogVersion","2026-10-09T22:08"]
