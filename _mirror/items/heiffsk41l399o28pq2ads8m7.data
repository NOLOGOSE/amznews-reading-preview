[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","heiffsk41l399o28pq2ads8m7","revision",2,"title","亚马逊要求为含 AI 生成人物的图片添加标签","originalTitle","Amazon Now Requires a Label on AI-Generated Models in Product Images","summary","自 2026 年 7 月 22 日起，亚马逊要求在包含逼真 AI 生成人物的产品图片、视频或 A+ 页面中嵌入“contains-synthetic-performer”元数据标签。该规定源于纽约州法律，但适用于全球站点；真人照片经 AI 修饰或非逼真插画无需打标。卖家需在上传前通过支持 IPTC 的编辑器将关键词写入文件的 XMP dc:subject 字段，并确保导出后未被压缩工具抹除。","reason","source",{"_9":96,"_97":98,"_70":99,"_100":39,"_101":102,"_103":104},"links",{"_93":94,"_65":95},"publishedAt","2026-10-02T16:21:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:24.492Z","timelineAt","category","policy","tags",[89,90,91,92],"score",65,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/8c5ecbef5f4cdcc6.webp","fullUrl","/amznews-reading-preview/_img/8c5ecbef5f4cdcc6.webp","srcSet","/amznews-reading-preview/_img/8c5ecbef5f4cdcc6.webp 336w, /amznews-reading-preview/_img/8c5ecbef5f4cdcc6.webp 720w","width",1600,"height",1325,"alt","poster","/amznews-reading-preview/_img/b3b2d617d39987ba.webp","/amznews-reading-preview/_img/b3b2d617d39987ba.webp","/amznews-reading-preview/_img/b3b2d617d39987ba.