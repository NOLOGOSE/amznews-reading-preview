[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","hhcvoj4j20sj2ka42mhree6dm","revision",3,"title","亚马逊欧洲站要求卖家验证主要营业地址，逾期将扣留付款或停用账户","originalTitle","亚马逊欧洲站请尽快验证主要营业地址，逾期付款扣留、账户停用","summary","亚马逊要求欧盟和英国站卖家验证主要营业地址以符合 VOEC 法规，逾期未完成将面临宽限期结束前 15 天起扣留付款、结束后停用账户的风险。中国跨境卖家通常因主要营业地址在境内，由亚马逊代收代缴增值税，只需确认后台地址准确并按时提交运营证据即可。","reason","原文说明了验证主要营业地址的合规要求、逾期后果及中国卖家注意事项，有助于卖家及时完成账户验证。","source",{"_9":104,"_105":106,"_74":107,"_108":41,"_109":-5},"links",{"_101":102,"_66":103},"publishedAt","2026-08-03T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-08-04","discoveredAt","2026-10-16T14:13:44.102Z","timelineAt","category","policy","tags",[98,99,100],"score",78,"selected",true,"channel","news","story","x","media",[69,70,71,72,73],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","亚马逊全球开店",{"_74":75,"_76":95,"_78":96,"_80":97,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":92,"_78":93,"_80":94,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":89,"_78":90,"_80":91,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/d0ba8283f6ab372c.webp","fullUrl","/amznews-reading-preview/_img/d0ba8283f6ab372c.webp","srcSet","/amznews-reading-preview/_img/d0ba8283f6ab372c.webp 336w, /amznews-reading-preview/_img/d0ba8283f6ab372c.webp 720w","width","height","alt","poster","/amznews-r