[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","hjxta8ffh9iggiv12stpn0as6","revision",5,"title","知无不言分享亚马逊市场容量调研方法：避免关键词数据误导，建议结合具体属性筛选","originalTitle","也许这才是正确的打开方式，较为准确的计算市场容量","summary","知无不言作者指出直接依赖关键词（如 coffee table）的市场容量数据存在偏差，因产品属性多样导致样本不精准。作者建议通过搜索具体属性组合（如 White Wood Coffee Table），利用卖家精灵插件导出结果并人工剔除不符项，再汇总月销量以估算更准确的市场容量。","reason","source",{"_9":107,"_108":68,"_75":109,"_110":40,"_111":112,"_113":114},"links",{"_104":105,"_66":106},"publishedAt","2023-08-08T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2023-08-08","discoveredAt","2026-10-01T09:32:55.437Z","timelineAt","category","product","tags",[102,103],"score",24,"selected",false,"channel","news","story","x","media",[69,70,71,72,73,74],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","什么都不懂","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_75":76,"_77":99,"_79":100,"_81":101,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":96,"_79":97,"_81":98,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":93,"_79":94,"_81":95,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":90,"_79":91,"_81":92,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":87,"_79":88,"_81":89,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5,"_84":-5,"_85":-5,"_86":-5},"kind","image","url","/amznews-reading-preview/_img/bd07c382156a3dc8.webp","fullUrl","/amznews-reading-preview/_img/bd07c382156a3dc8.webp","srcSet","/amznews-reading-preview/_img/bd07c382156a3dc8.webp 336w, /amznews-reading-preview/_img/bd07c382