[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","hlugzsiwrfvokqj7png3za1gd","revision",2,"title","亚马逊2026年严打虚假评论：起诉刷单网络、限制变体共享及FTC处罚风险","originalTitle","Fake and AI-Written Reviews: Amazon’s 2026 Crackdown","summary","亚马逊在2026年通过起诉刷单服务商和收紧变体评论共享规则来打击虚假评论，配合美国联邦贸易委员会（FTC）最高53,088美元的单次违规罚款，使得购买评论面临极高的法律与封号风险。文章指出，自2026年起亚马逊仅允许功能相同的变体（如颜色、尺寸）共享评论，不同配方或型号不再合并；同时列举了Vine计划和“请求评论”按钮作为合规获取评论的主要途径，警告卖家避免使用诱导性插页或AI生成评论。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T22:01:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:20.660Z","timelineAt","category","policy","tags",[89,90,91],"score",62,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/076aab44e779ee4a.webp","fullUrl","/amznews-reading-preview/_img/076aab44e779ee4a.webp","srcSet","/amznews-reading-preview/_img/076aab44e779ee4a.webp 336w, /amznews-reading-preview/_img/076aab44e779ee4a.webp 720w","width",1600,"height",935,"alt","poster","/amznews-reading-preview/_img/6e33fd38dd8cef48.webp","/amznews-reading-preview/_img/6e33fd38dd8cef48.webp","/amznews-reading-preview/_img/6e33fd38dd8cef48.webp 336w