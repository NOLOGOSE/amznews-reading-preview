[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","hr1libniif0aj51yzuyrsiqd3","revision",2,"title","品牌简报：为在亚马逊上增长销量，品牌正转向 TikTok Shop","originalTitle","Brands Briefing: To grow sales on Amazon, brands are turning to TikTok Shop","summary","多位品牌高管向 Modern Retail 表示，TikTok Shop 上的内容走红可能带动亚马逊等渠道的销售，因为消费者会在 TikTok Shop 发现产品、再到亚马逊下单。Envision Horizons 的一项调查显示，仅 9.5% 消费者把 TikTok Shop 列为首选购买渠道，亚马逊以 48.8% 领先；放弃 TikTok Shop 下单的原因包括想比价（36.7%）和找到更划算的交易（35%）。受访者称这种外溢效应因品类而异，并伴随库存与供应链挑战。","reason","source",{"_9":76,"_77":78,"_79":80,"_81":39,"_82":83,"_84":85},"links",{"_73":74,"_65":75},"publishedAt","2026-08-25T14:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-05T07:13:36.910Z","timelineAt","category","advertising","tags",[68,69,70,71,72],"score",34,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Julia Waldow","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","modern-retail","广告/运营","多平台销售","品牌","亚马逊","广告投放","aihot","/items/hr1libniif0aj51yzuyrsiqd3","https://www.modernretail.co/operations/brands-briefing-to-grow-sales-on-amazon-brands-are-turning-to-tiktok-shop/","author-modern-retail-juliawaldow","name","modern-retail · Julia Waldow","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/feec9bcddc707257.webp","iconSrcSet","/amznews-reading-preview/_img/feec9bcddc707257.webp 48w, /amznews-reading-preview/_img/feec9bcddc707257.webp 96w",{"_87":88},"changelogVersion","2026-10-09T22:08"]
