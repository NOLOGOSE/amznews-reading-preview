[{"_1":2,"_3":4},"root",{"_5":131},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","hw9awfsieveai97k76xejy8x3","revision",2,"title","亚马逊活跃卖家减少16%且流量向头部集中，文章解析市场格局变化与应对策略","originalTitle","Amazon Lost 16% of Its Active Sellers. Here’s Who Took Their Customers.","summary","ZonFlip 发布分析指出，亚马逊全球活跃卖家一年内减少16%，但总流量增长近5%，导致每位卖家平均获得的访问量提升25%。该文章主要引用 Marketplace Pulse 等机构的数据，揭示了美国第三方GMV高度集中于不足8000家头部卖家、中国卖家占据Top 10000席位过半数（但贡献GMV较少）以及AI购物助手推荐逻辑不同于传统搜索排名等趋势。","reason","source",{"_9":122,"_123":124,"_88":125,"_126":39,"_127":128,"_129":130},"links",{"_119":120,"_67":121},"publishedAt","2026-10-22T10:11:16.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T10:43:28.186Z","timelineAt","category","product","tags",[115,116,117,118],"score",60,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83,84,85,86,87],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Joey Glyshaw","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fxn0q7RoJYNg",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","b0cc97f2-c722-435e-94c2-88c3c492fc76","亚马逊活跃卖家减少、流量向头部集中",{"_76":77,"_13":78},"platform","ZonFlip",{"_88":89,"_90":112,"_92":113,"_94":114,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":109,"_92":110,"_94":111,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":106,"_92":107,"_94":108,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":103,"_92":104,"_94":105,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":100,"_92":1