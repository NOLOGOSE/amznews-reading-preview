[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","hwz078b3awewuiuy6jxm88jie","revision",3,"title","有运营经验但缺选品能力，小资金做亚马逊该独立起步还是找开发合伙？","originalTitle","有运营经验但缺少选品能力，想小资金做亚马逊：独立起步还是找开发合伙？","summary","一位深耕亚马逊大件精品多年、做过VC店铺的运营者，因缺少选品和供应链开发经验，纠结于小资金起步方式：自己从零练选品、与有选品和供应链的朋友合伙出资开精铺店，还是自己主导项目、按次购买选品复核与开发辅导。他担心与不太熟的朋友合伙后，在主导权、利润分配、亏损承担和退出机制上因不擅谈判而让步，想了解开发与运营合伙最常见的实际矛盾及试合作经验。","reason","source",{"_9":76,"_77":67,"_78":79,"_80":39,"_81":82,"_83":84},"links",{"_73":74,"_65":75},"publishedAt","2026-09-27T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:45:54.283Z","timelineAt","category","advertising","tags",[68,69,70,71,72],"score",12,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","吃瓜一级观察员","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","广告/运营","选品/市场","供应链","品牌","亚马逊","aihot","/items/hwz078b3awewuiuy6jxm88jie","https://www.wearesellers.com/question/125003","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_86":87},"changelogVersion","2026-10-09T22:08"]
