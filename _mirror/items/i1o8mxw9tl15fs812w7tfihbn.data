[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","i1o8mxw9tl15fs812w7tfihbn","revision",8,"title","亚马逊宣布GWD仓储服务将扩展至欧亚洲七国","originalTitle","亚马逊GWD仓储服务将扩展至欧亚洲七国","summary","亚马逊宣布将在今年年底前把全球仓储与配送服务（GWD）扩展到欧洲、亚洲等七个市场，包括德国、法国、意大利、西班牙、英国、日本和加拿大。通过GWD，卖家可将库存集中存放在一个由亚马逊运营的设施中，再根据各国实际需求调拨商品；相比AWD，其仓储成本更低且补货至FBA的速度最快可缩短5天。","reason","原文说明了GWD服务扩展至欧洲和亚洲七个市场，卖家可借此集中库存并按需调拨以优化跨境物流成本。","source",{"_9":102,"_103":104,"_85":105,"_106":66,"_107":108,"_109":110},"links",{"_99":100,"_68":101},"publishedAt","2026-09-29T03:10:45.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-09-30T09:35:26.073Z","timelineAt","category","fba","tags",[97,98],"score",62,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","media",[84],"byline",{"_53":81,"_82":83},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation",false,"bodyLanguage","original","factId","f0CSEvmoFgUo",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","a2b567f1-dad3-4d23-9b51-21c6b92de8d3","亚马逊GWD仓储服务年底前扩至七国",{"_77":78,"_13":79},"Summer","platform","AMZ123",{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/1074d350cefa1431.webp","fullUrl","/amznews-reading-preview/_img/1074d350cefa1431.webp","srcSet","/amznews-reading-preview/_img/1074d350cefa1431.webp 336w, /amznews-reading-preview/_img/1074d350cefa1431.webp 720w","width","height","alt","poster","FBA/物流","亚马逊","aihot","/items/i1o8mxw9