[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","i209qv7sb0zlivd0383ah3q00","revision",2,"title","速卖通双11海外备货激增146%并推品牌增长计划","originalTitle","速卖通双11海外备货激增146%，推出品牌增长计划","summary","速卖通数据显示今年商家整体海外备货量同比增长146%，并于10月19日与天猫联合发布“中国品牌出海增长计划”。该计划旨在通过专属服务、天使轮投资及托管服务，推动品牌业务占比提升至50%以上。平台强调其平均佣金约8%-10%低于亚马逊，并投入数亿元流量补贴以争夺旺季市场。","reason","source",{"_9":102,"_103":104,"_84":105,"_106":40,"_107":108,"_109":110},"links",{"_99":100,"_68":101},"publishedAt","2026-10-22T01:38:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-22T09:52:25.949Z","timelineAt","category","policy","tags",[96,97,98],"score",42,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境平台资讯","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f5wvk_mmZONg",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","b8b53c3b-3777-4afa-ae3a-cbfd350ef8b1","速卖通发布中国品牌出海增长计划",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/3f82db708c5971a3.webp","fullUrl","/amznews-reading-preview/_img/3f82db708c5971a3.webp","srcSet","/amznews-reading-preview/_img/3f82db708c5971a3.webp 336w, /amznews-reading-preview/_img/3f82db708c5971a3.webp 720w","width","height","alt","poster","政策/合规","多平台销售","行业动态","aihot","/items/i209qv7sb0zlivd0383ah3q00","https://www.amz123.c