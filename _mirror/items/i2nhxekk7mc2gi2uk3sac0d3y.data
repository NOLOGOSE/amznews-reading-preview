[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","i2nhxekk7mc2gi2uk3sac0d3y","revision",2,"title","美国CBP加强IOR信息核查，卖家需自查进口商登记资料","originalTitle","美国IOR新规已启动，亚马逊卖家速查进口商身份！","summary","美国海关与边境保护局（CBP）加强对进口商记录（IOR）的核查，若CBP Form 5106中的信息不准确或不完整，相关IOR编号可能被作废。作者建议通过美国公司经营亚马逊或使用第三方物流的卖家尽快开展自查，重点核实实体地址、联系邮箱、联系电话及报关授权是否真实有效且属于IOR本身。","reason","原文梳理了美国海关对进口商登记信息的核查要求及卖家自查步骤，为使用第三方物流或报关服务的跨境卖家提供了合规参考。","source",{"_9":102,"_103":104,"_84":105,"_106":66,"_107":108,"_109":110},"links",{"_99":100,"_68":101},"publishedAt","2026-10-21T08:13:18.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-21T09:17:10.002Z","timelineAt","category","policy","tags",[96,97,98],"score",62,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","Yiju谈跨境","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":12,"_73":74,"_75":76},"hasTranslation",false,"bodyLanguage","original","factId","faOr9ZpRNask",{"_77":78,"_13":79},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","906a830a-2904-4754-bfaf-04c4c3fa028c","美国海关强化进口商身份核查，IOR渠道风险受关注",{"_77":78,"_13":79},"platform","雨果跨境",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/7acb045251075723.webp","fullUrl","/amznews-reading-preview/_img/7acb045251075723.webp","srcSet","/amznews-reading-preview/_img/7acb045251075723.webp 336w, /amznews-reading-preview/_img/7acb045251075723.webp 720w","width","height","alt","poster","政策/合规","FBA/物流","亚马逊",