[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","i35c4kvehcm5l9khoykokqvoe","revision",2,"title","非标品广告策略：何时开启精准词冲排名及广泛/自动/品牌广告调整方法","originalTitle","非标品9.9美元，近7天141单、转化率22%却卡在排名瓶颈，现在该开精准词冲排名了吗？","summary","原文作者分享经验，建议新品前期优先使用广泛、词组及自动广告拓展流量入口，待订单稳定且自然排名进入瓶颈期后，再开启精准关键词集中推进排名。以一款9.9美元非标品为例，其近7天出单141个、整体转化率22%，作者通过对比手动广泛、自动宽泛及品牌词组广告的ACOS与点击率数据，演示了如何根据顶部、其余位置及商品页的表现差异调整竞价百分比，并指出应优先对已有自然排名的关键词建立精准广告。","reason","source",{"_9":134,"_135":81,"_91":136,"_137":40,"_138":139,"_140":141},"links",{"_131":132,"_68":133},"publishedAt","2026-10-07T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-08","discoveredAt","2026-10-08T05:17:31.642Z","timelineAt","category","advertising","tags",[127,128,129,130],"score",33,"selected",false,"channel","news","story",{"_77":78,"_13":14},"x","media",[82,83,84,85,86,87,88,89,90],"byline",{"_53":54,"_80":81},"detailedGuide","readingMode","full","author","阿浩的广告复盘","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","feKGLnEEWVSE",{"_77":78,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","74110626-d103-47ef-bcfc-48c936b53070",{"_77":78,"_13":14},"platform","知无不言",{"_91":92,"_93":124,"_95":125,"_97":126,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":121,"_95":122,"_97":123,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":118,"_95":119,"_97":120,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":115,"_95":116,"_97":117,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":112,"_95":113,"_97":1