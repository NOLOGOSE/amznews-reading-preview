[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":63,"_64":39,"_65":66},"id","i51x3cvnguumqaoamr7wlxngw","revision",2,"title","TikTok Shop德国直播带货仅占13%，可购物视频贡献64% GMV","originalTitle","TikTok Shop在德国直播带货仅13%，可购物视频成主力","summary","ECDB数据显示，TikTok Shop在德国、法国、意大利和西班牙市场中，带购买按钮的短视频贡献了64%的商品交易总额（GMV），而直播带货在德国的占比仅为13%，法意西三国各约20%。在德国与西班牙，传统商品卡片的转化效果甚至已超过直播，表明可购物视频已成为主力形式。","reason","source",{"_9":102,"_103":104,"_82":105,"_106":39,"_107":108,"_109":110},"links",{"_99":100,"_66":101},"publishedAt","2026-10-22T08:53:24.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T09:53:25.989Z","timelineAt","category","product","tags",[96,97,98],"score",45,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","media",[81],"byline",{"_52":-5,"_79":80},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[78],"indexable","markdownAvailable",true,"group",{"_67":68,"_42":69,"_70":71,"_72":73,"_74":73},"hasTranslation","bodyLanguage","original","factId","fWaQxVA5gz8s",{"_75":76,"_13":77},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","f14d9b63-9100-452d-9613-42a5655490a8","TikTok Shop德法意西：可购物视频占GMV 64%",{"_75":76,"_13":77},"platform","蓝海亿观网",{"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/c6b0ff32581c4dad.webp","fullUrl","/amznews-reading-preview/_img/c6b0ff32581c4dad.webp","srcSet","/amznews-reading-preview/_img/c6b0ff32581c4dad.webp 336w, /amznews-reading-preview/_img/c6b0ff32581c4dad.webp 720w","width",760,"height",400,"alt","poster","选品/市场","品类趋势","亚马逊","aihot","/items/i51x3cvnguumqaoamr7wlxngw","h