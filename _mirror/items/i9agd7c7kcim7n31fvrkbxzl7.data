[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","i9agd7c7kcim7n31fvrkbxzl7","revision",2,"title","亚马逊 Search Query Performance 报告解读：如何通过市场占比数据定位 Listing 转化漏洞","originalTitle","Ranked but Not Winning? How to Read Amazon Search Query Performance Market Share Data","summary","My Amazon Guy 提出利用亚马逊 Search Query Performance (SQPR) 报告中的品牌与 ASIN 市场占比，通过对比曝光、点击、加购及购买四个阶段的份额落差来定位 Listing 转化瓶颈。该教程建议拉取过去 13 周数据，识别最大份额下降环节以针对性优化主图、A+ 页面或价格，并指出 SQPR 不区分广告与自然流量且需结合广告报表使用。原文来自该机构，存在相关商业利益，并非独立测评。该教程的 Phase 4 方法仅适用于已索引 800+ 关键词的成熟 Listing，且原文未给出可推广的通用购买占比标准。","reason","source",{"_9":89,"_90":91,"_92":93,"_94":39,"_95":96,"_97":98},"links",{"_86":87,"_67":88},"publishedAt","2026-10-14T22:24:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-15T14:11:25.575Z","timelineAt","category","advertising","tags",[82,83,84,85],"score",34,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Francisco Valadez","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fAIbzmhllXZc",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","d4eabd66-c8a2-402f-b29f-609e6cbbadac","My Amazon Guy 连载亚马逊 SEO 五阶段方法",{"_76":77,"_13":78},"platform","My Amazon Guy","广告/运营","Listing优化","关键词","亚马逊","aihot","/items/i9agd7c7kcim7n31fvrkbxzl7","https://myamazonguy.com/seo/amazon-search-query-performance-market-share-data/","author-myamazonguy-francisco-valadez-rolling","name",