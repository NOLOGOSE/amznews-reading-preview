[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","i9ocnuhnit3iw8bk2n7exvccp","revision",2,"title","亚马逊西班牙启用首个配送中心ZAZ8，投资超1亿欧元","originalTitle","亚马逊西班牙投资超1亿欧元，启用首个配送中心","summary","亚马逊正式启用位于西班牙萨拉戈萨省拉穆埃拉的配送中心ZAZ8，总投资超过1亿欧元，占地超3万平方米，目前拥有100多名员工，预计未来3年扩至600人以上。该中心最多可储存890万件商品，向西班牙全国40多个物流中心供货，不直接向消费者发货。2025年亚马逊在西班牙当天或次日送达商品超1.9亿件，当天送达已覆盖16座城市。","reason","source",{"_9":88,"_89":90,"_70":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_65":87},"publishedAt","2026-09-08T07:48:48.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:19.083Z","timelineAt","category","fba","tags",[82,83,84],"score",22,"selected",false,"channel","news","story","x","media",[69],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Summer","platform","AMZ123",{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/ce89d17e59527cf0.webp","fullUrl","/amznews-reading-preview/_img/ce89d17e59527cf0.webp","srcSet","/amznews-reading-preview/_img/ce89d17e59527cf0.webp 336w, /amznews-reading-preview/_img/ce89d17e59527cf0.webp 720w","width","height","alt","poster","FBA/物流","供应链","亚马逊","aihot","/items/i9ocnuhnit3iw8bk2n7exvccp","https://www.amz123.com/t/XphCkjuG","author-amz123-summer","name","AMZ123 · SUMMER","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/