[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ibc401rucdt18bgbi4tovlx3p","revision",1,"title","Fabacus 推出 Verified Intellectual Property Protocol，亚马逊为首发合作伙伴","originalTitle","Fabacus Verified Intellectual Property Protocol launches with Amazon","summary","Fabacus 宣布推出 Verified Intellectual Property (VIP) Protocol，并确认亚马逊为其首发合作伙伴。该协议旨在通过标准化 SKU 级授权产品数据共享，帮助市场平台、搜索引擎及 AI 平台更准确识别官方授权商品。Fabacus 称其基础设施可提升品牌保护效率与消费者信任度，目前已有 Paramount、Hasbro 等客户参与。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-09-15T14:00:53.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T09:17:27.504Z","timelineAt","category","policy","tags",[68,69,70],"score",22,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Chris Dawson","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","ChannelX","政策/合规","品牌","亚马逊","aihot","/items/ibc401rucdt18bgbi4tovlx3p","https://channelx.world/2026/09/fabacus-verified-intellectual-property-protocol-launches-with-amazon/","rss-tamebay-amazon","name","Tamebay · Amazon 卖家新闻","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/87679903b998bbb0.webp","iconSrcSet","/amznews-reading-preview/_img/87679903b998bbb0.webp 48w, /amznews-reading-preview/_img/87679903b998bbb0.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
