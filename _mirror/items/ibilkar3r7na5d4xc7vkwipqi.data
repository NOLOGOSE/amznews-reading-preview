[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ibilkar3r7na5d4xc7vkwipqi","revision",6,"title","亚马逊德国站 Merchant Fulfillment API v0 新增身份验证枚举值","originalTitle","New Enum Values for Domestic Shipments in the Germany Amazon Store","summary","官方公告说明，自2026年10月1日起，Merchant Fulfillment API v0 在 getEligibleShipmentServices 和 createShipment 的 DeliveryExperience 与 DeliveryExperienceOption 字段中新增 DeliveryConfirmationWithIdentityCheck 和 DeliveryConfirmationWithNameVerification。配送验证服务适用于德国（DE）商城的 DHL Paket National Shipping；新增枚举会进入全球 API 模型，使用固定枚举列表进行校验或反序列化的集成需检查兼容性，并按原文要求更新处理逻辑。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":61,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-09-16T21:11:52.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-07T11:19:42.691Z","timelineAt","category","policy","tags",[68,69,70],"score",24,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","AntonioM_Amazon","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Amazon SP-API","政策/合规","FBA/物流","亚马逊","aihot","/items/ibilkar3r7na5d4xc7vkwipqi","https://developer-docs.amazon/sp-api/changelog/new-enum-values-for-domestic-shipments-in-the-germany-amazon-store","official-amazon-spapi-updates","name","Amazon SP-API 更新","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/9b8d2c0eb5b987fc.webp","iconSrcSet","/amznews-reading-preview/_img/9b8d2c0eb5b987fc.webp 48w, /amznews-reading-preview/_img/9b8d2c0eb5b987fc.webp 96w",{"_85":86},"