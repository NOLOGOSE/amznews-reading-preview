[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","icer46e8t9s67cw3pq3t3io5p","revision",6,"title","协调制度（HS）代码概述","originalTitle","An Overview of Harmonized System Codes","summary","世界海关组织（WCO）管理的协调制度（HS）是用于全球商品贸易分类的标准化数字方法，被200多个国家采用。该体系每五年更新一次，最新第七版于2022年发布，包含6位标准代码及层级结构。美国在此基础上扩展为8至10位代码，分别通过Schedule B和HTS系统对出口和进口进行更细致的关税统计与监管。","reason","source",{"_9":94,"_95":67,"_70":96,"_97":61,"_98":99,"_100":101},"links",{"_91":92,"_65":93},"publishedAt","2025-06-11T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T09:12:34.033Z","timelineAt","category","policy","tags",[89,90],"score",12,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":-5,"_66":67},"detailedGuide","readingMode","full","author","Isabella Gabriele from the Office of Trade and Economic Analysis","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","美国国际贸易署 Tradeology",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/0c7dd69c7f93c2a5.webp","fullUrl","/amznews-reading-preview/_img/0c7dd69c7f93c2a5.webp","srcSet","/amznews-reading-preview/_img/0c7dd69c7f93c2a5.webp 336w, /amznews-reading-preview/_img/0c7dd69c7f93c2a5.webp 720w","width",620,"height",339,"alt","poster","/amznews-reading-preview/_img/2dc0869a9f77b23d.webp","/amznews-reading-preview/_img/2dc0869a9f77b23d.webp","/amznews-reading-preview/_img/2dc0869a9f77b23d.webp 336w, /amznews-reading-preview/_img/2dc0869