[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","idlsawc6izb39ln8f4eg0qd4w","revision",2,"title","作者自述案例：Tropeza在2024年比较AI与人工PPC","originalTitle","AI vs Manual Amazon PPC: A Real Case Study (Tropeza, 2024)","summary","Daniks.AI创始人Ekaterina Rubtcova自述，Tropeza在2024年8月比较两组PPC广告：AI组RoAS为3.1、ACoS为32.7%，人工组为1.8、56.6%。两组花费约为3069和746美元，广告组不同且未进行隔离对照；作者有直接商业利益，数据未经本站独立审计，不能证明AI普遍优于人工或保证利润。","reason","source",{"_9":91,"_92":93,"_69":94,"_95":39,"_96":97,"_98":99},"links",{"_88":89,"_65":90},"publishedAt","2026-04-25T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-01T20:57:39.555Z","timelineAt","category","ai-tools","tags",[83,84,85,86,87],"score",27,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Ekaterina Rubtcova","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","TheFBAGirl",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/835adb6c65294fbb.webp","fullUrl","/amznews-reading-preview/_img/835adb6c65294fbb.webp","srcSet","/amznews-reading-preview/_img/835adb6c65294fbb.webp 336w, /amznews-reading-preview/_img/835adb6c65294fbb.webp 720w","width",1376,"height",768,"alt","poster","AI/工具","广告投放","AI工具","亚马逊","Amazon Ads","aihot","/items/idlsawc6izb39ln8f4eg0qd4w","https://thefbagirl.com/blog/ai-vs-manual-amazon-ppc-case-study-tropeza/","author-thefbagirl-reviewed-cases","name","TheFBAGirl · Ekaterina Rubtcova","rss","firstParty","iconUrl","/amznews