[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","ifl9hgr7of09eet7zfa488ify","revision",1,"title","亚马逊卖家顾问分享RA转OA经验","originalTitle","This post has gotten more pushback from some BIG Amazon sellers on this platform and I figured I should provide more context for anyone t...","summary","亚马逊卖家顾问 Jimmy Smith 分享从零售套利（RA）转向在线套利（OA）的经验，称 OA 更利于其生活平衡。他自述曾管理10余人团队做 RA，后改为仅需1名虚拟助理和自动系统的 OA 模式，虽利润率低于 RA 但更易规模化至月销10万美元以上。他认为 AI 是减少低效的工具而非捷径，实际执行者仍具优势。","reason","source",{"_9":92,"_93":94,"_95":96,"_97":39,"_98":-5},"links",{"_89":90,"_66":91},"publishedAt","2026-10-05T15:24:26.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T16:14:18.331Z","timelineAt","category","advertising","tags",[86,87,88],"score",15,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":79,"_44":80},"media",[],"byline","detailedGuide","readingMode","full","author","askjimmysmith","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>This post has gotten more pushback from some BIG Amazon sellers on this platform and I figured I should provide more context for anyone that's considering RA vs OA vs other methods.</p><p>First, the pushback has come from bigger sellers than me, some that have been on Amazon less time than me and some that have more time on the platform. I've been selling on Amazon since 2015 (on my 11th year) and I've done nearly every model you can think of. But those responding are admittedly bigger sellers than I am, doing a scale that I honestly may not even want. I'm happy with how my Amazon business operates, but they have more experience getting past the $200k per month level which my experience tops out at.</p><p>I know I don't know everything, and there will always be people that are crushing it with something that no longer works for you or your lifestyle.</p><p>To clarify, years ago I built a team of 3-4 shoppers, 6-7 prep/ship team members, a warehouse lease and everything that comes with that, etc. This was all based around Retail Arbitrage and some Online Arbitrage at the time. I had more freedom and flexibility than most doing RA at the time because I did scale it, but it came with an operational complexity and mental load of handling employees and team members that was never calculated into the equation of \"is this worth it?\" Managing 10+ people was tough and I didn't want to be the 2 man RA person that worked 60+ hours per week anymore, so it was either scale the team or have a job that required me to work more to grow. So we scaled the team.</p><p>Unfortunately, after going through a divorce and continuing to work in that operation for 2 more years still, I had to rebuild on my own. I switched to OA/Wholesale and while the profit margin percentages are smaller than RA due to the ability for anyone to find those items, the sheer ability to scale quickly is something RA can't do as easily (nothing is easy FYI but OA scaling was easier for me than RA). To hit $3k+ days (pacing for $100k+ months) in the matter of a couple months can happen but not quite like it can with OA/wholesale and my level of experience over 11 years.</p><p>Not to mention, the complexity of running an OA business with similar scale in terms of revenue, has been MUCH simpler for me. I can do it with automated lead systems, 1 VA, and a prep center. I can move anywhere and not have to worry about what I do with my team.</p><p>For my life, OA systems are MUCH better than RA. For others, that will not be the case. I admire those that have been doing RA at massive scale for a long time. For me, OA has been much better for my life and time.</p><p>Maybe AI takes over OA in the future, in which case I may go back into RA or I'll go into something entirely different. But right now automations and AI are helping sellers way more than it's hurting them, because it still requires people to actually learn things and put it into practice.</p><p>Anyone actually doing the work will beat out those looking for shortcuts. AI is not the shortcut, it's the ability to reduce inefficiencies and it takes people to actually use them properly.</p>","zhKind","complete","authorName","Jimmy Smith","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_71":72,"_73":51,"_81":82,"_83":84,"_85":-5},[],"text","If your Amazon business requires scanning barcodes in retail aisles every weekend, you built yourself a weekend shift.\n\nRunning through Target or Walmart with a phone scanner works to build some great profit margins, but real operational scale comes from online sourcing, automated Keepa filters, and replen systems that run whether you step foot in a store or not.\n\nBeing able to step away from store aisles without sales stopping is the whole point.","url","https://x.com/askjimmysmith/status/2107078563740488151","translation","广告/运营","多平台销售","亚马逊","aihot","/items/ifl9hgr7of09eet7zfa488ify","https://x.com/askjimmysmith/status/2107129794433351934","x-jimmy-smith","name","X · Jimmy Smith","kind","x_search","firstParty","iconUrl",{"_100":101},"changelogVersion","2026-10-09T22:08"]
