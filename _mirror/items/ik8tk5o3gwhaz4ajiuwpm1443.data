[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ik8tk5o3gwhaz4ajiuwpm1443","revision",3,"title","Ad Badger播客讲解如何识别亚马逊交叉销售与真实自然销量","originalTitle","How to Find Your Amazon Cross-Sales and True Organic Sales [The PPC Den Podcast]","summary","Ad Badger播客邀请Steve Patenaude分享如何利用亚马逊新版拖拽式报告构建两个关键报表：一是按广告ASIN统计交叉销售占比，二是通过业务报告收入减去同ASIN广告销售及关联销售来计算真实自然销量。文中指出旧版Sponsored Products报告已停用，新报告能同时展示被广告的ASIN和被购买的ASIN，从而揭示产品间的关联关系及非主销SKU对流量的贡献。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-09-11T12:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-09-30T08:51:28.477Z","timelineAt","category","advertising","tags",[68,69,70],"score",62,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","The Badger","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Ad Badger","广告/运营","亚马逊","Seller Central","aihot","/items/ik8tk5o3gwhaz4ajiuwpm1443","https://www.adbadger.com/blog/amazon-ppc-education/how-to-find-your-amazon-cross-sales-and-true-organic-sales-the-ppc-den-podcast/","author-adbadger-thebadger","name","Ad Badger · The Badger","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/20a766fd7260a353.webp","iconSrcSet","/amznews-reading-preview/_img/20a766fd7260a353.webp 48w, /amznews-reading-preview/_img/20a766fd7260a353.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
