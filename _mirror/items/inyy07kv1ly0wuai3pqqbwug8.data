[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","inyy07kv1ly0wuai3pqqbwug8","revision",1,"title","美国海关 CBP 就入境摘要信息收集修订征求公众意见","originalTitle","Agency Information Collection Activities; Revision; Entry Summary","summary","美国海关与边境保护局（CBP）发布联邦公报公告，就“入境摘要”信息收集活动的修订向公众征求意见。该请求将提交至管理和预算办公室（OMB）依据《1995年文书工作减少法》进行审查批准。公众须在2026年11月2日前通过 reginfo.gov 网站以英文提交评论以确保被考虑。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":61,"_79":80,"_81":82},"links",{"_70":71,"_65":72},"publishedAt","2026-10-01T04:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:13:45.538Z","timelineAt","category","policy","tags",[68,69],"score",12,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_66":67},"detailedGuide","readingMode","full","author","Homeland Security Department, U.S. Customs and Border Protection","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","美国海关 CBP","政策/合规","亚马逊","aihot","/items/inyy07kv1ly0wuai3pqqbwug8","https://www.federalregister.gov/documents/2026/10/01/2026-20171/agency-information-collection-activities-revision-entry-summary","official-us-cbp-federal-register","name","美国海关 CBP · 联邦公报公告","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/fb25db0934701e45.webp","iconSrcSet","/amznews-reading-preview/_img/fb25db0934701e45.webp 48w, /amznews-reading-preview/_img/fb25db0934701e45.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
