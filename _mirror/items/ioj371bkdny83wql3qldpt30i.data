[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ioj371bkdny83wql3qldpt30i","revision",1,"title","Circana 2026 假日消费研究：消费者选择性支出而非远离购物季","originalTitle","Circana’s 2026 Holiday Study Finds Consumers Spending Selectively, Not Stepping Away","summary","Circana 发布 2026 年美国假日购买意向研究（调查 3,534 名消费者），显示假日支出预计平均 $779，略低于去年的 $796，Q4 整体支出预计在下降 1% 至增长 2.5% 之间。该机构自报调查显示，74% 的消费者计划采取省钱行为，超半数在感恩节前开始购物；57% 的消费者可能因社交媒体种草而购买（Z 世代达 82%）。","reason","source",{"_9":87,"_88":89,"_69":90,"_91":39,"_92":93,"_94":95},"links",{"_84":85,"_65":86},"publishedAt","2026-10-08T20:42:32.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T17:31:27.186Z","timelineAt","category","product","tags",[81,82,83],"score",55,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Kiara Barrett","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Circana",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/9049dfb0fcbcd412.webp","fullUrl","/amznews-reading-preview/_img/9049dfb0fcbcd412.webp","srcSet","/amznews-reading-preview/_img/9049dfb0fcbcd412.webp 336w, /amznews-reading-preview/_img/9049dfb0fcbcd412.webp 720w","width","height","alt","poster","数据/报告","选品/市场","品类趋势","aihot","/items/ioj371bkdny83wql3qldpt30i","https://www.circana.com/post/circana-s-2026-holiday-study-finds-consumers-spending-selectively-not-stepping-away","publisher-circana-blog","name","Circana · 博客与研究发布","rss","firstParty","iconU