[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","iphi67ilsdtqhdax776oy69wr","revision",2,"title","波兰拟扩大电商检查权限，违规最高罚年营业额10%","originalTitle","波兰严查电商销售流程，违规者最高罚年营业额10%","summary","波兰竞争与消费者保护局（UOKiK）计划扩大执法人员权限，允许其以普通消费者身份实际购买商品以检验销售流程。新规赋予监管机构要求发布警告、删除内容或限制访问等管理手段，侵害消费者集体利益者最高面临相当于年度营业额10%的罚款。","reason","source",{"_9":101,"_102":103,"_84":104,"_105":40,"_106":107,"_108":109},"links",{"_98":99,"_68":100},"publishedAt","2026-10-19T20:01:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-20","discoveredAt","2026-10-20T05:02:40.068Z","timelineAt","category","policy","tags",[96,97],"score",40,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","欧洲电商资讯","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","foFkGeHb9Pvc",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","898ed4a0-affb-4770-83dd-5298c0647778","波兰拟扩大UOKiK执法权限并提高罚款上限",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/10442e5c8e3c69bd.webp","fullUrl","/amznews-reading-preview/_img/10442e5c8e3c69bd.webp","srcSet","/amznews-reading-preview/_img/10442e5c8e3c69bd.webp 336w, /amznews-reading-preview/_img/10442e5c8e3c69bd.webp 720w","width","height","alt","poster","政策/合规","亚马逊","aihot","/items/iphi67ilsdtqhdax776oy69wr","https://www.amz123.com/t/jgp2MFtQ","publisher-amz1