[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","irsgaru4enhcemhhhc66cf52w","revision",2,"title","如何针对亚马逊购物助手（Alexa for Shopping/Rufus）优化商品详情页","originalTitle","How to Optimize an Amazon Listing for Alexa for Shopping (Rufus)","summary","作者提出针对亚马逊购物助手（原 Rufus）优化 Listing 的核心在于用具体事实回答买家问题，而非堆砌关键词。建议优先补全后台属性，将每条五点描述对应一个具体问题并给出数字，标题控制在 75 字符内；可通过向助手提问 10 个真实买家问题来测试优化效果。","reason","source",{"_9":96,"_97":98,"_70":99,"_100":39,"_101":102,"_103":104},"links",{"_93":94,"_65":95},"publishedAt","2026-10-02T15:41:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:24.492Z","timelineAt","category","advertising","tags",[89,90,91,92],"score",56,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/1981534ec044b190.webp","fullUrl","/amznews-reading-preview/_img/1981534ec044b190.webp","srcSet","/amznews-reading-preview/_img/1981534ec044b190.webp 336w, /amznews-reading-preview/_img/1981534ec044b190.webp 720w","width",1600,"height",1256,"alt","poster","/amznews-reading-preview/_img/98d9a639649a4aa8.webp","/amznews-reading-preview/_img/98d9a639649a4aa8.webp","/amznews-reading-preview/_img/98d9a639649a4aa8.webp 336w, /amznews-reading-preview/_img/98d