[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","ix4vzvneoi5xdglxfxqj3k0j2","revision",2,"title","亚马逊新手卖家分享自学与求职经历，请教运营基础补充方向","originalTitle","论自学和请教同行的大半年的学习结果，顺带吐槽这两年的遭遇，麻烦各位大佬指点一下我还要往哪方面补充基础，感觉现在还是有很多东西欠缺","summary","一位自称“NPC”的亚马逊新手卖家分享其从零基础自学到入职FBA及FBM岗位的经历，并请求同行指点还需补充哪些运营基础。该卖家自述掌握了SKU管理、变体拆合、广告竞价逻辑、利润表制作及VLOOKUP数据分析等技能，但在折扣运营思维、词库建立等方面仍感欠缺。文中还提及了此前雇主拖欠工资及未缴社保等遭遇，目前正计划利用黑五等大促积累更多实战经验。","reason","source",{"_9":89,"_90":81,"_91":92,"_93":40,"_94":95,"_96":97},"links",{"_86":87,"_68":88},"publishedAt","2026-10-13T21:26:24.946Z","publishedPrecision","calendar","calendarDate","2026-10-14","discoveredAt","2026-10-14T09:08:27.309Z","timelineAt","category","advertising","tags",[82,83,84,85],"score",8,"selected",false,"channel","news","story",{"_77":78,"_13":14},"x","media",[],"byline",{"_53":54,"_80":81},"detailedGuide","readingMode","full","author","虚心请教的毛孩子","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fbulwTRfZs8U",{"_77":78,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","054ec920-ae09-494a-b2fb-a737e9209f93",{"_77":78,"_13":14},"platform","知无不言","广告/运营","Listing优化","关键词","FBA/物流","aihot","/items/ix4vzvneoi5xdglxfxqj3k0j2","https://www.wearesellers.com/question/125426","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_99":100},"