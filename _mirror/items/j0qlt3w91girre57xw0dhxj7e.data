[{"_1":2,"_3":4},"root",{"_5":156},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","j0qlt3w91girre57xw0dhxj7e","revision",2,"title","亚马逊 FBA 库存丢失或损坏的赔偿申请指南","originalTitle","Amazon FBA Inventory Reimbursement: How to Recover Money for Lost or Damaged Inventory","summary","作者 Ivonne Haire 介绍了亚马逊 FBA 卖家在库存丢失或损坏时申请赔偿的流程框架，包括在货件处于“Closed”状态后核对已接收与预期数量、准备发票和承运方签收单据等凭证，以及通过卖家中心提交索赔。原文指出 90 天期限针对货件关闭情形，并说明不同索赔类型的截止窗口可能不同，卖家应以卖家中心具体索赔类型为准。原文还称亚马逊通常按商品成本而非零售价赔付，未提供成本时可能按估值处理。原文推荐第三方自动化工具并设有账户审查表单，存在相关商业利益，并非独立测评。","reason","source",{"_9":147,"_148":149,"_90":150,"_151":39,"_152":153,"_154":155},"links",{"_144":145,"_67":146},"publishedAt","2026-10-20T15:17:55.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-20T15:52:41.796Z","timelineAt","category","fba","tags",[139,140,141,142,143],"score",60,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83,84,85,86,87,88,89],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Ivonne Haire","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","f1HhiHNHOsNk",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","4e6eac06-c446-4561-91fe-4b9711836d61","亚马逊FBA库存丢失或损坏赔偿申请指南",{"_76":77,"_13":78},"platform","BellaVix",{"_90":91,"_92":134,"_94":135,"_96":136,"_98":137,"_100":138,"_102":-5,"_103":-5},{"_90":91,"_92":129,"_94":130,"_96":131,"_98":132,"_100":133,"_102":-5,"_103":-5},{"_90":91,"_92":124,"_94":125,"_96":126,"_98":127,"_100":128,"_102":-5,"_103":-5},{"_90":91,"_92":119,"_