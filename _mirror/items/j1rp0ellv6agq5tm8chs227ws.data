[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_40":42,"_43":44,"_45":-5,"_46":-5,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":38,"_60":61,"_62":-5,"_63":38,"_64":65},"id","j1rp0ellv6agq5tm8chs227ws","revision",1,"title","卖家投诉亚马逊账号停用处理不当","originalTitle","#WorkWithUsAmazon","summary","reason","source",{"_9":92,"_93":94,"_95":96,"_97":38,"_98":-5},"links",{"_89":90,"_65":91},"publishedAt","2026-10-13T20:17:30.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:42:17.986Z","timelineAt","category","policy","tags",[87,88],"score",22,"selected",false,"channel","x","story",{"_70":71,"_72":50,"_73":74,"_75":76,"_77":78,"_43":79},"media",[],"byline","detailedGuide","readingMode","full","author","AmazonASGTG","language","qht","body",{"_66":-5,"_65":67,"_68":-5,"_69":61},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>#WorkWithUsAmazon</p>","zhKind","complete","authorName","Amazon Sellers ASGTG","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_70":80,"_72":81,"_82":83,"_84":85,"_86":-5},[],"Mohammed Almisbaa","MA2Almisbaa","text","@amznsellerhelp \nI am deeply disappointed with how Amazon has handled my seller account deactivation since September 3, 2026.\n\nMy account was deactivated over an alleged connection to another account that I have never owned, operated, or had any relationship with.\n\nDespite submitting multiple appeals, official documents, and support requests, I continue to receive generic responses without a clear explanation or meaningful resolution.\n\nI have invested significant amounts in inventory, manufacturing, packaging, and international shipping. Some shipments have already reached Amazon's fulfillment centers, while others are still in transit.\n\nMy investment is now at risk, my inventory is tied up, and my business cannot operate.\n\nWhat is particularly frustrating is that my support requests keep being transferred between departments that confirm the issue is outside their responsibility.\n\nI respectfully request Amazon's senior seller support team to review my situation, investigate the alleged account connection, and provide a clear path toward resolution.\n\nSellers deserve transparency, accountability, and meaningful support, especially when their businesses and investments are at stake.","url","https://x.com/MA2Almisbaa/status/2109534541832401282","translation","政策/合规","亚马逊","aihot","/items/j1rp0ellv6agq5tm8chs227ws","https://x.com/AmazonASGTG/status/2110102651031457850","x-amazon-asgtg","name","X · ASGTG","kind","x_search","firstParty","iconUrl",{"_100":101},"changelogVersion","2026-10-09T22:08"]
