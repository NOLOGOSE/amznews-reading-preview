[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","j3fyibxp94irr8478nk5fv0aj","revision",1,"title","欧盟拟引入市场监督费以加强非欧盟包裹检查","originalTitle","EU wants to introduce another parcel tax","summary","据泄露草案显示，欧盟委员会计划推出“联盟市场监督费”，旨在资助对来自欧盟以外产品的市场监督和检查。该费用将在现有的3欧元进口关税和即将实施的2欧元清关处理费之外叠加，原则上由进口商承担，且针对直接发货给消费者的个人包裹费率高于批量进口。此外，草案还规定违规者可能面临高达全球年营收6%的罚款。","reason","原文梳理了欧盟拟议的第三项包裹费用及最高6%全球营收罚款，为跨境卖家提供了合规成本与风险参考。","source",{"_9":74,"_75":76,"_77":78,"_79":64,"_80":81,"_82":83},"links",{"_71":72,"_66":73},"publishedAt","2026-10-09T16:17:20.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T09:17:27.464Z","timelineAt","category","policy","tags",[69,70],"score",62,"selected",true,"channel","news","story","x","media",[],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","Arjan","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","Ecommerce News Europe","政策/合规","行业动态","aihot","/items/j3fyibxp94irr8478nk5fv0aj","https://ecommercenews.eu/eu-wants-to-introduce-another-parcel-tax/","rss-ecommercenews-eu","name","Ecommerce News Europe · 欧洲电商与平台动态","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d9eefda62cc58e78.webp","iconSrcSet","/amznews-reading-preview/_img/d9eefda62cc58e78.webp 48w, /amznews-reading-preview/_img/d9eefda62cc58e78.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
