[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","j5r1frdofsf26w43bvf5aavn9","revision",1,"title","亚马逊 Prime Air 无人机配送计划年底覆盖近 500 个社区","originalTitle","Amazon drone delivery expansion targets 500 cities by year’s end","summary","亚马逊宣布其 Prime Air 无人机配送服务将于 2026 年底扩展至近 500 个社区，较目前的 11 个地点大幅增加。Prime 会员在订单满 $50 时享受免费无人机配送，未满则收取 $2.99 费用；非会员需支付 $4.99。该服务使用 MK30 无人机，载重 5 磅，多数订单在结账后约 60 分钟内送达。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":39,"_79":80,"_81":82},"links",{"_70":71,"_65":72},"publishedAt","2026-08-19T14:47:08.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:42.349Z","timelineAt","category","fba","tags",[68,69],"score",12,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves","FBA/物流","亚马逊","aihot","/items/j5r1frdofsf26w43bvf5aavn9","https://www.freightwaves.com/news/amazon-drone-delivery-expansion-targets-500-cities-by-years-end","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
