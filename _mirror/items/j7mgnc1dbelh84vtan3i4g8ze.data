[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","j7mgnc1dbelh84vtan3i4g8ze","revision",2,"title","深圳老牌LED企业丽晶光电破产清算，员工从651人降至4人","originalTitle","从651人到4人！深圳又一老牌大厂破产清算","summary","深圳市丽晶光电科技股份有限公司被法院裁定受理破产清算，其员工规模从2013年末的651人缩减至2024年的4人。该公司曾深耕海外业务，产品超80%出口欧美，但因重资产模式及债务风险导致经营困难。债权申报截止日为10月29日，第一次债权人会议定于11月9日召开。","reason","source",{"_9":88,"_89":90,"_91":92,"_93":39,"_94":95,"_96":97},"links",{"_85":86,"_67":87},"publishedAt","2026-10-17T09:40:57.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T10:29:15.757Z","timelineAt","category","policy","tags",[82,83,84],"score",26,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":-5,"_80":81},"detailedGuide","readingMode","full","author","雨果跨境编辑部","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fxrYKFS3v-GQ",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","26b8a904-54ee-455e-9f62-f6b59af4f141","深圳丽晶光电被受理破产清算",{"_76":77,"_13":78},"platform","雨果跨境","政策/合规","合规税务","亚马逊","aihot","/items/j7mgnc1dbelh84vtan3i4g8ze","https://www.cifnews.com/article/189490","publisher-cifnews-amazon","name","雨果跨境 · 亚马逊频道最新","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp","iconSrcSet","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 48w, /amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 96w",{"_99":100},"changelogVersion","2026-10-09T22:08"]
