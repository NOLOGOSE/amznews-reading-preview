[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","jaicq9pjtp27kr44hsggyfbwd","revision",2,"title","卖家分享护肩新品上架19天冲进小类前四的快跟截流打法","originalTitle","卖12年的老链接，被28条评分的新品挤到第5","summary","作者“嚼不烂的牛肉干”基于卖家精灵数据，拆解护肩类目新品 Bula Bear 的案例。原文称该链接标价$35.99不变，上架初期挂15% Coupon、后加到20%，折后$28.79，卡在FIGHTECH（$25.95）和Anaconda（$49.95）之间，面向被Anaconda种草、又嫌$50偏贵的买家；其流量部分来自Anaconda品牌词下的自然排名。原文同时提示合并评分已引来删评、复制结构存在侵权风险。以上为作者个人运营看法，不构成商业推广或建议；数据来源于卖家精灵，本站尚未独立核验。","reason","source",{"_9":134,"_135":81,"_91":136,"_137":40,"_138":139,"_140":141},"links",{"_131":132,"_68":133},"publishedAt","2026-10-09T01:33:27.565Z","publishedPrecision","calendar","calendarDate","2026-10-09","discoveredAt","2026-10-09T13:15:46.901Z","timelineAt","category","advertising","tags",[127,128,129,130],"score",60,"selected",false,"channel","news","story",{"_77":78,"_13":14},"x","media",[82,83,84,85,86,87,88,89,90],"byline",{"_53":54,"_80":81},"detailedGuide","readingMode","full","author","嚼不烂的牛肉干","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f5Lhyo5uOx7Q",{"_77":78,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","2afaffda-2e2e-455f-804f-d1ac2e194a0c",{"_77":78,"_13":14},"platform","知无不言",{"_91":92,"_93":124,"_95":125,"_97":126,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":121,"_95":122,"_97":123,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":118,"_95":119,"_97":120,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":115,"_95":116,"_97":117,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":9