[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","jcem29w53t30yzjcckk2ks3im","revision",2,"title","美国海关 CBP 延长邮政包裹正式报关合规期限","originalTitle","Indefinite Suspension of the De Minimis Exemption for Mail Shipments and New Postal Informal Entry Process; Delayed Compliance Extension","summary","美国海关与边境保护局（CBP）宣布延长针对国际邮政网络入境商品的正式报关合规日期，该规定原于 2026 年 6 月 24 日发布。此次延期旨在给公众更多时间准备合规，涉及受合作伙伴政府机构要求、需缴纳关税或申请免税待遇的商品。同时，CBP 指出在延迟合规窗口结束时，申报人可选择进行正式报关，或参与针对价值不超过 $2,500 合格货物的 Entry Type 13 自愿电子邮件流程测试。","reason","CBP 官方公告明确延长邮政包裹正式报关的合规期限，并说明 Entry Type 13 测试作为可选替代方案。","source",{"_9":88,"_89":90,"_91":92,"_93":40,"_94":95,"_96":97},"links",{"_85":86,"_68":87},"publishedAt","2026-10-22T04:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T05:17:26.677Z","timelineAt","category","policy","tags",[83,84],"score",60,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":-5,"_81":82},"detailedGuide","readingMode","full","author","Homeland Security Department, U.S. Customs and Border Protection","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation",false,"bodyLanguage","original","factId","fP9zQPcqdVf4",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","13833d0c-deba-463e-b73d-be904872d427","CBP延长邮政包裹正式报关合规期限",{"_77":78,"_13":79},"platform","美国海关 CBP","政策/合规","亚马逊","aihot","/items/jcem29w53t30yzjcckk2ks3im","https://www.federalregister.gov/documents/2026/10/22/2026-21600/indefinite-suspension-of-the-de-minimis-exemption-for-mail-shipments-and-new-postal-informal-entry","official-us-cbp-federal-register","name","美国海关 CBP · 联邦公报公告","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/fb25db0934701e45.webp","iconSrcSet","/amznews-reading-preview/_img/fb25db0934701e45.webp 48w, /amznews-reading-preview/_img/fb25db0934701e45.webp 96w",{"_99":100},"changelogVersion","2026-10-09T22:08"]
