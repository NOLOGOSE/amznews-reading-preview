[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","jdtupo69gj2ln2qqdnzgv89w0","revision",2,"title","竞争少的亚马逊产品，为什么也可能不值得做？","originalTitle","summary","亚马逊选品中，竞争少只是结果指标，可能对应需求刚起的机会，也可能对应被前人算过账后放弃的市场，两者在选品工具界面上无法区分。文章指出，类目容量不足、认证专利门槛、工厂起订量等成本不会体现在竞品数量里，而消费者搜索习惯不同或线下替代也会造成\"空白入口\"。判断关键在于能否说清别人放弃的具体原因，且该原因对自己不成立。","reason","source",{"_9":94,"_95":96,"_70":97,"_98":38,"_99":100,"_101":102},"links",{"_91":92,"_64":93},"publishedAt","2026-09-12T21:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:29.562Z","timelineAt","category","product","tags",[88,89,90],"score",24,"selected",false,"channel","news","story","x","media",[67,68,69],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","一汤说","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_70":71,"_72":85,"_74":86,"_76":87,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":82,"_74":83,"_76":84,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/5fe7794865499f35.webp","fullUrl","/amznews-reading-preview/_img/5fe7794865499f35.webp","srcSet","/amznews-reading-preview/_img/5fe7794865499f35.webp 336w, /amznews-reading-preview/_img/5fe7794865499f35.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/8abe117e2ef5d025.webp","/amznews-reading-preview/_img/8abe117e2ef5d025.webp","/amznews-reading-preview/_img/8abe117e2ef5d025.webp 336w, /amznews-reading-preview/_img/8abe117e2ef5d025.webp 720w","