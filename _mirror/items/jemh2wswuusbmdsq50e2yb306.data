[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","jemh2wswuusbmdsq50e2yb306","revision",1,"title","CommerceIQ 数据：亚马逊宠物类目营收增 20% 且缺货损失降 63%","originalTitle","Fur-midable Growth: Pets Dominate Amazon","summary","CommerceIQ 数据显示，2026 年 Q2 亚马逊宠物类目卖家营收同比增长 20%，缺货损失单季度下降 63%，是唯一在该季度（含 Prime Day）减少缺货损失的追踪类目。","reason","source",{"_9":99,"_100":101,"_81":102,"_103":39,"_104":-5},"links",{"_96":97,"_66":98},"publishedAt","2026-09-06T15:09:37.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:42:17.626Z","timelineAt","category","product","tags",[93,94,95],"score",58,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Rambler_Amz","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Fur-midable Growth: Pets Dominate Amazon<br> <br>63% Drop in Amazon Out-of-Stock Losses<br> <br>Yes, pet brands cut their out-of-stock losses by 63% in a single quarter.<br> <br>CommerceIQ data shows pet category sellers on Amazon grew revenue 20% year-over-year in Q2 2026 &gt; the only tracked category to reduce out-of-stock losses during a quarter that included Prime Day.<br> <br>Now the question is, how did they pull that off without discounting?<br> <br>Supply chain execution. On-hand inventory rose 11%, out-of-stock rates fell to just 1% (the best in-stock rate of any category tracked), and purchase order fill rates climbed to 89%.<br> <br>Interesting thing to watch out for: ad spend jumped 28% and ROAS improved to 4.4x, but conversion rate actually dropped 6 points to 52%. So the growth story is inventory discipline, not just throwing more ad dollars at the funnel.<br> <br>30% gross margin: pet trailed only office products for the strongest growth-to-margin balance in CommerceIQ's entire dataset.<br> <br>However, unlike a single-company announcement, this is aggregated, anonymized data across the whole pet category - CommerceIQ didn't break out which specific brands or SKUs drove the numbers.</p>","zhKind","complete","authorName","Rambler | X -Amazonian | Account Health Expert |","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[80],{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1080,"height",1350,"alt","poster","数据/报告","品类趋势","亚马逊","aihot","/items/jemh2wswuusbmdsq50e2yb306","https://x.com/Rambler_Amz/status/2096616817838174632","x-rambler-amz","name","X · Rambler","x_search","firstParty","iconUrl",{"_106":107},"changelogVersion","2026-10-09T22:08"]
