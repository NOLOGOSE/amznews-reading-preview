[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","jepevhlibbnq8caas06sfpcsn","revision",3,"title","FTC起诉亚马逊广告拍卖机制，作者建议卖家自查竞价成本","originalTitle","Amazon Says Its Ad Auction Was Second-Price. The FTC Says You Paid Your Own Bid Anyway.","summary","2026年8月31日，美国联邦贸易委员会（FTC）联合22州总检察长在华盛顿西区联邦法院起诉亚马逊，指控其Sponsored Products等广告拍卖在2019年起通过内部所称“软保留价”使广告主支付自身出价而非第二高价，涉及超100万品牌。亚马逊回应称保留价属行业常见做法，并称其竞价机制使平均CPC持平、中标价下降。双方数据口径不同，均未经法院审理。原文来自Ad Badger，存在相关商业利益，并非独立测评。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-09-10T17:15:16.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-07T22:04:41.993Z","timelineAt","category","advertising","tags",[68,69,70],"score",71,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","The Badger","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Ad Badger","行业动态","亚马逊","Amazon Ads","aihot","/items/jepevhlibbnq8caas06sfpcsn","https://www.adbadger.com/blog/amazon-says-its-ad-auction-was-second-price-the-ftc-says-you-paid-your-own-bid-anyway/","author-adbadger-thebadger","name","Ad Badger · The Badger","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/20a766fd7260a353.webp","iconSrcSet","/amznews-reading-preview/_img/20a766fd7260a353.webp 48w, /amznews-reading-preview/_img/20a766fd7260a353.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
