[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","jfqm8x81jolf1c9xy2oqtcgvb","revision",2,"title","知无不言情景故事解析 ORCsize 留评率异常判定逻辑","originalTitle","为啥你做测评老被抓？ORCsize 暴露的，不只是订单。本文中的 ORCsize 按原稿所示口径呈现，用于理解留评率异常，不代表亚马逊公开算法、官方阈值或单一判定规则","summary","知无不言文章以情景故事形式讨论 ORCsize 指标，称其通过比较近期与历史基准留评率的相对变化来观察刷单风险。文中给出 7 天和 14 天 ORCsize 公式，并强调真人操作若呈现协同或异常增长仍可能被判违规。该口径仅用于理解风控逻辑，不代表亚马逊公开算法或官方阈值。原文来自该问答页作者，文末提供 ORCsize 计算表格及合规真人体验流程交流，存在相关商业利益，并非独立测评。","reason","source",{"_9":101,"_102":81,"_83":103,"_104":40,"_105":106,"_107":108},"links",{"_98":99,"_68":100},"publishedAt","2026-10-12T01:33:36.151Z","publishedPrecision","calendar","calendarDate","2026-10-12","discoveredAt","2026-10-12T13:13:26.540Z","timelineAt","category","policy","tags",[95,96,97],"score",22,"selected",false,"channel","news","story",{"_77":78,"_13":14},"x","media",[82],"byline",{"_53":54,"_80":81},"detailedGuide","readingMode","full","author","dh***d","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fSpAg_5dnwrI",{"_77":78,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","303cc2db-4c8e-49c6-9bdb-5903d20351cc",{"_77":78,"_13":14},"platform","知无不言",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":-5,"_93":-5,"_94":-5},"kind","image","url","/amznews-reading-preview/_img/5afe240ded81b35c.webp","fullUrl","/amznews-reading-preview/_img/5afe240ded81b35c.webp","srcSet","/amznews-reading-preview/_img/5afe240ded81b35c.webp 336w, /amznews-reading-preview/_img/5afe240ded81b35c.webp 720w","width","height","alt"