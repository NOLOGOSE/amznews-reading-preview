[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","jfqyzegov2gposnfztbkgbpo6","revision",1,"title","亚马逊Q1营收达1815亿美元，加速配送并提升物流效率","originalTitle","Amazon pushes delivery speed as Q1 revenue surges to $181B","summary","亚马逊第一季度营收达1815亿美元，同比增长17%，CEO Andy Jassy强调通过提速配送和扩大选品推动电商增长。公司今年已实现超10亿件商品当日或次日达，并将“Amazon Now”极速配送扩展至九个国家。尽管出货量增长15%，但出库运费与履约费用增幅低于销量增速，显示其物流网络在库存定位与自动化方面提升了效率。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-04-29T23:14:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:17:07.757Z","timelineAt","category","fba","tags",[68,69,70],"score",23,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Noi Mahoney","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves","FBA/物流","亚马逊","行业动态","aihot","/items/jfqyzegov2gposnfztbkgbpo6","https://www.freightwaves.com/news/amazon-pushes-delivery-speed-as-q1-revenue-surges-to-181b","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
