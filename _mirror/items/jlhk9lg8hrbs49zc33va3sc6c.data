[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":-5,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","jlhk9lg8hrbs49zc33va3sc6c","revision",1,"title","亚马逊 CEO 称 2026 年将扩大 Prime Air 无人机配送规模","originalTitle","Amazon to scale up drone delivery in 2026, CEO says","summary","亚马逊 CEO Andy Jassy 在致股东信中表示，2026 年将显著扩大 Prime Air 无人机配送能力，目标年底前覆盖 3000 万客户。依托超 85 个当日达履约中心，Prime Air 计划本十年末实现年交付 5 亿件包裹且耗时少于 30 分钟。同时，亚马逊继续推进 Amazon Now 极速地面配送及农村网络扩张，以应对快速配送成本与消费者需求之间的平衡挑战。","reason","source",{"_9":72,"_73":74,"_75":76,"_77":38,"_78":79,"_80":81},"links",{"_69":70,"_64":71},"publishedAt","2026-04-10T15:13:25.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:17:07.808Z","timelineAt","category","fba","tags",[67,68],"score","selected",false,"channel","news","story","x","media",[],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves","FBA/物流","亚马逊","aihot","/items/jlhk9lg8hrbs49zc33va3sc6c","https://www.freightwaves.com/news/amazon-to-scale-up-drone-delivery-in-2025-ceo-says","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_83":84},"changelogVersion","2026-10-09T22:08"]
