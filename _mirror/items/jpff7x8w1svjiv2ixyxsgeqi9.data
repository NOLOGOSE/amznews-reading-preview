[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","jpff7x8w1svjiv2ixyxsgeqi9","revision",2,"title","ChatGPT Ads Manager 开放自助投放，电商品牌是否应测试？","originalTitle","ChatGPT Ads Manager Is Open: Should Ecommerce Brands Test It?","summary","OpenAI 于 2026 年 5 月向美国广告主开放 ChatGPT Ads Manager 自助服务，取消 $50,000 最低消费并支持 CPC 竞价。9 月起购物结果需连接产品 Feed，广告扩展至欧洲等地。鉴于公开成本基准稀缺且预估 CPC 为 $3-$5，建议具备完善追踪与高客单价的品牌以固定预算小规模测试。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T19:31:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:23.230Z","timelineAt","category","advertising","tags",[89,90,91],"score",40,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/84078aac48c91d04.webp","fullUrl","/amznews-reading-preview/_img/84078aac48c91d04.webp","srcSet","/amznews-reading-preview/_img/84078aac48c91d04.webp 336w, /amznews-reading-preview/_img/84078aac48c91d04.webp 720w","width",1600,"height",827,"alt","poster","/amznews-reading-preview/_img/d37d5d0893a894c4.webp","/amznews-reading-preview/_img/d37d5d0893a894c4.webp","/amznews-reading-preview/_img/d37d5d0893a894c4.webp 336w, /amznews-reading-