[{"_1":2,"_3":4},"root",{"_5":93},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","jrqjs3rt83fyrv2b5u6t7bjgi","revision",1,"title","亚马逊Listing关键词权重分布","originalTitle","Amazon weighs keywords by where they sit on the listing.","summary","亚马逊根据关键词在商品详情页中的位置赋予不同权重。\n\n标题的权重远高于其他部分。其次是五点描述。然后是规格、产品描述，甚至图片内的文字。\n\n你最好的关键词应该放在标题里。","reason","source",{"_9":86,"_87":88,"_89":90,"_91":39,"_92":-5},"links",{"_83":84,"_66":85},"publishedAt","2026-10-11T19:22:23.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T16:14:18.206Z","timelineAt","category","advertising","tags",[80,81,82],"score",40,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","1000asins","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Amazon weighs keywords by where they sit on the listing.</p><p>The title carries the most weight by far. Then the bullets. Then specs, the description, and even the text inside your images.</p><p>Your best keywords belong in the title.</p>","zhKind","complete","authorName","Dan Boufford","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"广告/运营","Listing优化","关键词","aihot","/items/jrqjs3rt83fyrv2b5u6t7bjgi","https://x.com/1000asins/status/2109364002945917038","x-dan-boufford","name","X · Dan Boufford","kind","x_search","firstParty","iconUrl",{"_94":95},"changelogVersion","2026-10-09T22:08"]
