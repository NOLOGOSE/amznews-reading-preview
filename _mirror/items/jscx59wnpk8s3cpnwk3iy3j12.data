[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","jscx59wnpk8s3cpnwk3iy3j12","revision",2,"title","Jungle Scout MCP 入门指南：把亚马逊市场情报接入 AI 工具","originalTitle","Getting Started with Jungle Scout MCP","summary","Jungle Scout 推出 MCP（Model Context Protocol），让团队在已使用的 AI 工具中直接用自然语言查询亚马逊市场情报，无需登录后台、导出数据或手动做报表。MCP 可调用市场份额、类目增长、竞品、定价、关键词、商品属性、卖家与品牌表现等数据，并支持追问驱动因素。它不替代 Jungle Scout 的 Cobalt，而是把同样的亚马逊情报延伸到 AI 工作流中。","reason","source",{"_9":90,"_91":52,"_68":92,"_93":39,"_94":95,"_96":97},"links",{"_87":88,"_65":89},"publishedAt","2026-07-08T16:38:54.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T10:08:13.744Z","timelineAt","category","ai-tools","tags",[82,83,84,85,86],"score",22,"selected",false,"channel","news","story","x","media",[67],"byline",{"_51":-5,"_66":52},"detailedGuide","readingMode","full","author","Jungle Scout","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform",{"_68":69,"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/a27855682e8206a4.webp","fullUrl","/amznews-reading-preview/_img/a27855682e8206a4.webp","srcSet","/amznews-reading-preview/_img/a27855682e8206a4.webp 336w, /amznews-reading-preview/_img/a27855682e8206a4.webp 720w","width",2140,"height",642,"alt","poster","AI/工具","AI工具","卖家工具","亚马逊","数据/报告","aihot","/items/jscx59wnpk8s3cpnwk3iy3j12","https://www.junglescout.com/resources/articles/getting-started-with-jungle-scout-mcp/","author-jungle-scout-shared-articles","name","rss","firstParty","iconUrl","/amznews-reading-preview/_img/c