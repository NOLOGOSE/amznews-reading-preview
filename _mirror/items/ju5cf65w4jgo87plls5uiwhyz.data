[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","ju5cf65w4jgo87plls5uiwhyz","revision",2,"title","沃尔玛推出 Agent Gateway 允许 AI 代理代客购物，亚马逊则继续封堵","originalTitle","Walmart launches Agent Gateway so AI agents can shop for customers, while Amazon keeps blocking agents from buying on its site","summary","沃尔玛推出 Agent Gateway，这是一个 MCP 服务器，允许经批准的 AI 代理在 Walmart 和 Sam’s Club 搜索库存并下单，代理无需获取用户的个人详情或订单历史。沃尔玛 CEO John Furner 周三在旧金山发布该服务。原文称，从下月起，Agent Profiles 将为每个代理在客户账户中建立独立档案，使代理订单与客户订单分开；每笔购买需经客户批准，或保持在客户设定的消费上限内。沃尔玛条款禁止代理超出购物者要求或接触支付详情，代理下错单时退货政策仍然适用。原文还称，亚马逊在 9 月开始封堵 AI 代理，包括沃尔玛合作伙伴 Meta 的 Muse。","reason","source",{"_9":102,"_103":104,"_83":105,"_106":39,"_107":108,"_109":110},"links",{"_99":100,"_67":101},"publishedAt","2026-10-22T15:57:45.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T17:31:30.761Z","timelineAt","category","ai-tools","tags",[97,98],"score",40,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Paul Drecksler","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":12,"_72":73,"_74":75},"hasTranslation","bodyLanguage","original","factId","fWxX72jKf1KQ",{"_76":77,"_13":78},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","73999efa-0426-424b-b502-b1aedfb0cd2d","沃尔玛开放AI代理购物，亚马逊封堵",{"_76":77,"_13":78},"platform","Shopifreaks",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/260272be03b1194e.webp","fullUrl","/amznews-reading-preview/_img/260272be03b1194e.webp","srcSet","/amznews-reading-preview/_img/260272be03b1194e.webp 336w, /amznews-reading-preview/_img/260272be03b1194e.webp 720w","width",1536,"height",1024,"alt","poster","AI/工具","亚马逊","aihot","/items/ju5cf65w4jgo87plls5uiwhyz","https://www.shopifreaks.com/walmart-launches-agent-gateway-so-ai-agents-can-shop-for-customers-while-amazon-keeps-blocking-agents-from-buying-on-its-site/","publisher-shopifreaks-news","name","Shopifreaks · 电商行业快讯","rss","firstParty","iconUrl","/amznews-reading-preview/_img/142f20f64079a020.webp","iconSrcSet","/amznews-reading-preview/_img/142f20f64079a020.webp 48w, /amznews-reading-preview/_img/142f20f64079a020.webp 96w",{"_112":113},"changelogVersion","2026-10-09T22:08"]
