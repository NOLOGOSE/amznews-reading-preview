[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","ju78rac76rw4bihkd3shbt0sy","revision",1,"title","亚马逊卖家外包备货与采购的个人经验","originalTitle","When I quit my corporate job, I was spending 20 hours a week taping boxes and prepping shipments.","summary","作者自述：辞去公司工作后，每周花20小时贴箱子和准备发货。作者认为，备货是需要当地帮手以每小时15美元完成的体力活，采购可以交给虚拟助理（VA）以每小时6美元完成，从而腾出时间做作者所称每小时价值75美元的补货。作者提到，独立卖家因利润微薄而犹豫雇佣帮手；作者个人观点是，买回时间去寻找更好的库存或陪伴家人能立即回本，该说法属于作者经验与观点，本站尚未独立核验，不构成普遍保证。","reason","source",{"_9":85,"_86":87,"_88":89,"_90":39,"_91":-5},"links",{"_82":83,"_66":84},"publishedAt","2026-10-08T00:00:58.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T16:14:18.235Z","timelineAt","category","fba","tags",[80,81],"score",20,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","askjimmysmith","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>When I quit my corporate job, I was spending 20 hours a week taping boxes and prepping shipments.</p><p>Prepping is physical work that requires local help at $15 an hour. Sourcing can be handed to a VA for $6 an hour. Both free you up for high-margin replens worth $75 an hour.</p><p>Solo sellers hesitate because paying help feels risky on tight margins. But buying back hours to source better inventory or be with family pays for itself immediately.</p>","zhKind","complete","authorName","Jimmy Smith","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"FBA/物流","供应链","aihot","/items/ju78rac76rw4bihkd3shbt0sy","https://x.com/askjimmysmith/status/2107984559614652681","x-jimmy-smith","name","X · Jimmy Smith","kind","x_search","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
