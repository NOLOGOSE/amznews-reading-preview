[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","jy84t8ms18ap2f8p4xz7pl10z","revision",1,"title","分析师称亚马逊 LTL 服务难撼动市场格局","originalTitle","Analysts say Amazon won’t shake LTL market—yet","summary","分析师认为亚马逊新推出的零担（LTL）物流服务难以撼动传统承运商的市场地位。Deutsche Bank 与 TD Cowen 指出，其轻资产模式主要对标经纪业务或经济型细分市场，缺乏挑战全国性重货网络的能力。尽管股价因消息小幅下跌，但行业高壁垒及亚马逊现有网络规模限制了其全面竞争潜力。","reason","source",{"_9":90,"_91":92,"_69":93,"_94":39,"_95":96,"_97":98},"links",{"_87":88,"_65":89},"publishedAt","2026-06-10T20:39:49.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:42.462Z","timelineAt","category","fba","tags",[84,85,86],"score",22,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Todd Maiden","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/bdd0bf2de49debcb.webp","fullUrl","/amznews-reading-preview/_img/bdd0bf2de49debcb.webp","srcSet","/amznews-reading-preview/_img/bdd0bf2de49debcb.webp 336w, /amznews-reading-preview/_img/bdd0bf2de49debcb.webp 720w","width",1200,"height",670,"alt","","poster","FBA/物流","供应链","亚马逊","aihot","/items/jy84t8ms18ap2f8p4xz7pl10z","https://www.freightwaves.com/news/analysts-say-amazon-wont-shake-ltl-market-yet","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-