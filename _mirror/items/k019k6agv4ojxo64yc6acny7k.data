[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","k019k6agv4ojxo64yc6acny7k","revision",2,"title","美国IOR监管趋严，亚马逊提醒卖家自查进口主体","originalTitle","summary","亚马逊向美国站卖家发送风险提示邮件，提醒核实发货使用的IOR（进口备案人）属于美国本土实体还是境外实体。此次变动源于2026年6月3日签署的第14411号行政令《加强海关执法》，要求国土安全部与CBP在2026年11月30日前完成进口商资质条款修订。","reason","原文梳理了美国IOR新规对进口商资质和保证金的收紧要求，并给出了卖家自查货代配套IOR属性的具体步骤。","source",{"_9":103,"_104":105,"_85":106,"_107":66,"_108":109,"_110":111},"links",{"_100":101,"_68":102},"publishedAt","2026-10-20T18:19:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-21T02:23:12.996Z","timelineAt","category","policy","tags",[97,98,99],"score",74,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84],"byline",{"_53":54,"_82":83},"detailedGuide","readingMode","full","author","北美电商资讯","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fmaocLwjsyyA",{"_78":79,"_13":80},"reportCount",4,"additionalSourceCount",1,"developmentCount",0,"publicId","17e32b95-4b2d-40d4-9f1a-a5926dff996a","亚马逊提醒卖家自查IOR应对美国进口新规",{"_78":79,"_13":80},"platform","AMZ123",{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/d031d52c2a21e8ae.webp","fullUrl","/amznews-reading-preview/_img/d031d52c2a21e8ae.webp","srcSet","/amznews-reading-preview/_img/d031d52c2a21e8ae.webp 336w, /amznews-reading-preview/_img/d031d52c2a21e8ae.webp 720w","width","height","alt","poster","政策/合规","亚马逊","FBA/物流","aihot","/items/k019k6agv4ojxo64yc6acny7k