[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","k4nnf87f7q1mmhj1cg0l64bpk","revision",3,"title","公司突被列入走逃，税局查后称系统问题：亚马逊数据推送后报关出口遇阻","originalTitle","企业突然间被列入走逃，去税局查了之后发现是系统问题","summary","有卖家反映其公司9月11日被列为走逃，9月16日到税局查询后被告知系统无风险提示，属系统问题，近期多家公司出现类似情况，税局让其回来等待。该卖家称公司2020年成立、2026年才开始报关出口，怀疑与去年亚马逊开始推送数据、今年突然大批量出口触发风险提示有关，目前税务异常导致海关无法进行9810报关，正值发货高峰期。","reason","source",{"_9":74,"_75":67,"_76":77,"_78":39,"_79":80,"_81":82},"links",{"_71":72,"_65":73},"publishedAt","2026-09-17T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:45:53.205Z","timelineAt","category","policy","tags",[68,69,70],"score",29,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","ECFarmers","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","政策/合规","合规税务","亚马逊","aihot","/items/k4nnf87f7q1mmhj1cg0l64bpk","https://www.wearesellers.com/question/124715","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
