[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","k4vru9v1yowva6bgyyk0gkbxz","revision",1,"title","美国消费品安全委员会就微出行产品锂电池安全标准提案征集口头意见","originalTitle","Safety Standard for Lithium-Ion Batteries Used in Micromobility Products and Electrical Systems of Micromobility Products Containing Such Batteries","summary","美国消费品安全委员会（CPSC）为微出行产品及其电气系统中使用的锂离子电池安全标准拟议规则制定通知（NPRM）提供口头陈述机会。相关方需在2026年10月15日东部时间下午5点前提交申请及书面文本，并于同日完成预注册。口头陈述会议定于2026年10月21日东部时间上午10点举行，所有意见将纳入规则制定记录。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":61,"_79":80,"_81":82},"links",{"_70":71,"_65":72},"publishedAt","2026-10-05T04:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:13:48.701Z","timelineAt","category","policy","tags",[68,69],"score",12,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_66":67},"detailedGuide","readingMode","full","author","Consumer Product Safety Commission","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","aihot","/items/k4vru9v1yowva6bgyyk0gkbxz","https://www.federalregister.gov/documents/2026/10/05/2026-20296/safety-standard-for-lithium-ion-batteries-used-in-micromobility-products-and-electrical-systems-of","official-cpsc-federal-register","name","CPSC 美国消费品安全委员会 · 联邦公报","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/fb25db0934701e45.webp","iconSrcSet","/amznews-reading-preview/_img/fb25db0934701e45.webp 48w, /amznews-reading-preview/_img/fb25db0934701e45.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
