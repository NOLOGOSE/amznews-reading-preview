[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","k5icxz26w1g7o72wr6oyvyd99","revision",2,"title","亚马逊2026变体Review共享规则梳理：哪些能共享、哪些会被拆","originalTitle","哪些变体Review能共享，哪些会被亚马逊强制拆分？这21类情况一次看懂","summary","亚马逊自2026年2月12日起调整变体Review共享规则，并在5月31日前分品类逐步实施，只有差异较小且不影响产品功能的变体才继续共享评论。官方明确颜色或图案变化、功能不变的尺寸变化、包装数量变化、非气味型商品的次要香味变化及同款适配不同型号可继续共享，而蛋白粉口味、宠物食品口味等直接影响体验的差异不再共享。","reason","source",{"_9":108,"_109":110,"_74":111,"_112":39,"_113":114,"_115":116},"links",{"_105":106,"_65":107},"publishedAt","2026-09-13T18:12:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:19.007Z","timelineAt","category","policy","tags",[101,102,103,104],"score",62,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","跨境电商MoonSees","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_74":75,"_76":98,"_78":99,"_80":100,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":95,"_78":96,"_80":97,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":92,"_78":93,"_80":94,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":89,"_78":90,"_80":91,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5,"_84":-5,"_85":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/afc6a64a9fe78b9b.webp","fullUrl","/amznews-reading-preview/_img/afc6a64a9fe78b9b.webp","srcSet","/amznews-reading-preview/_img/afc6a64a9fe78b9b.webp 336w, /amznews-rea