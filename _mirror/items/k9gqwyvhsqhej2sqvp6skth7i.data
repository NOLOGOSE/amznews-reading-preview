[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","k9gqwyvhsqhej2sqvp6skth7i","revision",2,"title","Regan跨境解析亚马逊十月大促销量与盈利关系，提供复盘方法","originalTitle","十月PD销量都说涨了，但你真的盈利吗？（附大促复盘表）","summary","Regan跨境指出亚马逊十月大促销量上涨不等于盈利，强调需区分利润目标与排名目标。其通过假设数据演示了折扣、广告及费用增加可能导致总贡献利润下降，并建议卖家按ASIN核算成交收入、广告归因（注意7天回溯窗口）及现金流。针对冲排名的投入，作者提出需设定明确验收标准，避免仅凭BSR或短期排名截图判断成功，主张以可持续的贡献利润验证增长价值。","reason","source",{"_9":119,"_120":121,"_77":122,"_123":39,"_124":125,"_126":127},"links",{"_116":117,"_65":118},"publishedAt","2026-10-09T22:27:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-12T01:49:44.920Z","timelineAt","category","advertising","tags",[113,114,115],"score",33,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Regan跨境","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_77":78,"_79":110,"_81":111,"_83":112,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":107,"_81":108,"_83":109,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":104,"_81":105,"_83":106,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":98,"_81":99,"_83":100,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":95,"_81":96,"_83":97,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":92,"_81":93,"_83":94,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":-