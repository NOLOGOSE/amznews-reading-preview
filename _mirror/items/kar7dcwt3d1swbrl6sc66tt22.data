[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","kar7dcwt3d1swbrl6sc66tt22","revision",2,"title","海关总署：前三季度我国跨境电商进出口总额约2.18万亿元","originalTitle","前三季度我国跨境电商进出口总额约2.18万亿元","summary","海关总署新闻发言人吕大良介绍，据初步测算，前三季度我国跨境电商进出口总额约为2.18万亿元，同比增长4.4%。其中出口约1.75万亿元，增长4.6%；进口约4340.5亿元，增长3.3%。上半年正式统计显示，出口集中在服饰鞋包首饰、家居家纺等品类，货源主要来自广东、浙江、福建、江苏四省。目前海关已全面落地“先查验后装运”监管方式以提升通关效率并降低企业成本。","reason","source",{"_9":102,"_103":104,"_84":105,"_106":40,"_107":108,"_109":110},"links",{"_99":100,"_68":101},"publishedAt","2026-10-18T18:12:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-19T02:36:37.050Z","timelineAt","category","policy","tags",[96,97,98],"score",52,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","AMZ123跨境快报","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fnv9I6uFcgwo",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","3c40a18b-f965-4475-a706-237d2261cb44","海关总署：前三季度跨境电商进出口约2.18万亿元",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/37783e077fee5de9.webp","fullUrl","/amznews-reading-preview/_img/37783e077fee5de9.webp","srcSet","/amznews-reading-preview/_img/37783e077fee5de9.webp 336w, /amznews-reading-preview/_img/37783e077fee5de9.webp 720w","width","height","alt","poster","数据/报告","行业动态","供应链","aihot