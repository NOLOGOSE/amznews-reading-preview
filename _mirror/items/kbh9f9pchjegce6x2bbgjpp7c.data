[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","kbh9f9pchjegce6x2bbgjpp7c","revision",2,"title","Ozon圣彼得堡仓库遭无人机袭击起火，暂停接收卖家货物","originalTitle","Ozon仓库起火，俄罗斯圣彼得堡遭大规模无人机袭击","summary","俄罗斯电商平台Ozon位于圣彼得堡的物流中心遭无人机袭击并发生火灾，官方确认员工已安全撤离且无人员伤亡。受此影响，Ozon暂时停止接收发往该仓库的卖家货物，可能干扰相关卖家的发货与库存安排。截至报道时，Ozon尚未公布仓库受损程度、停运时间及对订单配送的具体影响。","reason","source",{"_9":100,"_101":102,"_83":103,"_104":40,"_105":106,"_107":108},"links",{"_97":98,"_68":99},"publishedAt","2026-10-18T18:35:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-19T02:36:37.018Z","timelineAt","category","fba","tags",[95,96],"score",38,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82],"byline",{"_53":54,"_80":81},"detailedGuide","readingMode","full","author","俄罗斯电商资讯","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":12,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","f534tcEqSlKo",{"_76":77,"_13":78},"reportCount","additionalSourceCount",0,"developmentCount","publicId","87b375d0-0c98-46af-a87c-0b42b51281e6","Ozon圣彼得堡仓库遭无人机袭击起火",{"_76":77,"_13":78},"platform","AMZ123",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":-5,"_93":-5,"_94":-5},"kind","image","url","/amznews-reading-preview/_img/27b0a8faf7efeb22.webp","fullUrl","/amznews-reading-preview/_img/27b0a8faf7efeb22.webp","srcSet","/amznews-reading-preview/_img/27b0a8faf7efeb22.webp 336w, /amznews-reading-preview/_img/27b0a8faf7efeb22.webp 720w","width","height","alt","poster","FBA/物流","供应链","aihot","/items/kbh9f9pchjegce6x2bbgjpp7c","https://www.amz123.com/t/JsSmqafY"