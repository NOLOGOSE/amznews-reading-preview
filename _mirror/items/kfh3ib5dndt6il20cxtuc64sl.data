[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","kfh3ib5dndt6il20cxtuc64sl","revision",2,"title","亚马逊取消购物车独立资格门槛 卖家需关注新排名规则","originalTitle","Amazon Removed the Featured Offer Eligibility Gate: What Decides the Buy Box Now","summary","亚马逊自2026年7月起逐步取消购物车（Featured Offer）的独立卖家绩效资格检查，预计年底完成全球推广。绩效指标不再作为准入门槛，而是与价格和配送速度共同作为单一排名的输入项。这意味着此前因绩效未达标而无法参与竞争的卖家现在将直接加入排名池，卖家可能面临更多低价但绩效较弱的竞争对手。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T18:41:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:23.230Z","timelineAt","category","policy","tags",[89,90,91],"score",62,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/ea37e3eb7d48c399.webp","fullUrl","/amznews-reading-preview/_img/ea37e3eb7d48c399.webp","srcSet","/amznews-reading-preview/_img/ea37e3eb7d48c399.webp 336w, /amznews-reading-preview/_img/ea37e3eb7d48c399.webp 720w","width",1600,"height",837,"alt","poster","/amznews-reading-preview/_img/74ce278664f34ee5.webp","/amznews-reading-preview/_img/74ce278664f34ee5.webp","/amznews-reading-preview/_img/74ce278664f34ee5.webp 336w, /amznews-reading-preview/_im