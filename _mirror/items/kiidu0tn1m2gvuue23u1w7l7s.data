[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","kiidu0tn1m2gvuue23u1w7l7s","revision",2,"title","亚马逊来信要“NOB”，到底要你交什么？先分清3种情况再动手","originalTitle","亚马逊来信要\"NOB\"，到底要你交什么？先分清3种情况再动手","summary","知无不言用户Sai日本合规指出，NOB是日本经产省事业届出受理后的回执，不是需要另办的证件，用于证明卖家主体已登记，但不代表产品合规。作者按已有回执、丢失回执、未届出三种情况给出应对思路，并提醒2026年6月30日起邮寄提交的届出不再退回盖章回执，保安网受理完成画面即为凭证。以上为作者经验分享，具体适用条件以平台和主管部门要求为准。","reason","source",{"_9":87,"_88":81,"_89":90,"_91":39,"_92":93,"_94":95},"links",{"_84":85,"_67":86},"publishedAt","2026-10-16T08:29:32.557Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T08:40:32.036Z","timelineAt","category","policy","tags",[82,83],"score",60,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Sai日本合规","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fH_5nubEfLBM",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","cb56199c-2f44-49fe-b5aa-55ad0d5aca84","日本经产省邮寄届出不再退回盖章回执",{"_76":77,"_13":78},"platform","知无不言","政策/合规","亚马逊","aihot","/items/kiidu0tn1m2gvuue23u1w7l7s","https://www.wearesellers.com/question/125526","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_97":98},"changelogVersion","2026-10-09T22:08"]
