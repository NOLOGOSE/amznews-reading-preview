[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","kkjcq0dlai7yf5mylgg4qgm7x","revision",6,"title","亚马逊为商家自有网站提供免费 Prime 配送","originalTitle","Amazon brings free Prime delivery to merchants’ own websites","summary","亚马逊宣布通过 Amazon Supply Chain Services 推出两项面向美国卖家的新服务：MCF 新老商家可在自有网站添加快速、免费的 Prime 配送，无需在标准 MCF 费用之外支付额外费用；MCF Preferred Pricing Program 则让商家在自有网站、市场和社交渠道的配送费用最高节省 25%，前六个月节省 15% 至 25%。","reason","亚马逊官方发布 MCF 两项新服务，卖家可据此了解自有网站接入 Prime 配送的门槛与费率优惠条件，但需注意 Prime 配送并非完全免费，而是在标准 MCF 费用之外无额外费用，且优惠定价计划有前六个月等条件。","source",{"_9":111,"_112":113,"_74":114,"_115":40,"_116":-5},"links",{"_108":109,"_66":110},"publishedAt","2026-09-24T09:58:21.172Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-29T19:32:29.631Z","timelineAt","category","fba","tags",[104,105,106,107],"score",74,"selected",true,"channel","news","story","x","media",[69,70,71,72,73],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","Jacquelyn Smith","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","About Amazon",{"_74":75,"_76":99,"_78":100,"_80":101,"_82":102,"_84":103,"_86":-5,"_87":-5},{"_74":75,"_76":96,"_78":97,"_80":98,"_82":83,"_84":85,"_86":-5,"_87":-5},{"_74":75,"_76":91,"_78":92,"_80":93,"_82":94,"_84":95,"_86":-5,"_87":-5},{"_74":75,"_76":88,"_78":89,"_80":90,"_82":83,"_84":85,"_86":-5,"_87":-5},{"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":-5,"_87":-5},"kind","image","url","/amznews-reading-preview/_img/ad651865ec0d2888.webp","fullUrl","/amznews-reading-preview/_img/ad651865ec0d2888.webp","srcSet",