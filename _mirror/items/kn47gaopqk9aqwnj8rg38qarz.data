[{"_1":2,"_3":4},"root",{"_5":123},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","kn47gaopqk9aqwnj8rg38qarz","revision",5,"title","亚马逊报告：2025年超7.5万名独立卖家销售额破百万美元，同比增长36%","originalTitle","A record number of independent sellers in Amazon’s store surpassed $1 million in sales in 2025","summary","亚马逊2025年小企业赋能报告显示，超7.5万名独立卖家在亚马逊店铺销售额突破100万美元，较2024年增长36%，美国卖家年均销售额超37.5万美元。独立卖家目前贡献亚马逊店铺超60%的销售额。亚马逊AI工具Seller Assistant月活超23万，卖家采纳其建议的比例超90%。","reason","source",{"_9":117,"_118":119,"_75":120,"_121":61,"_122":-5},"links",{"_114":115,"_65":116},"publishedAt","2026-04-30T12:00:19.564Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-29T19:32:29.451Z","timelineAt","category","product","tags",[109,110,111,112,113],"score",32,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mary Beth Westmoreland","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","About Amazon",{"_75":76,"_77":106,"_79":107,"_81":108,"_83":84,"_85":86,"_87":-5,"_88":-5},{"_75":76,"_77":103,"_79":104,"_81":105,"_83":84,"_85":86,"_87":-5,"_88":-5},{"_75":76,"_77":100,"_79":101,"_81":102,"_83":84,"_85":86,"_87":-5,"_88":-5},{"_75":76,"_77":97,"_79":98,"_81":99,"_83":95,"_85":96,"_87":-5,"_88":-5},{"_75":76,"_77":92,"_79":93,"_81":94,"_83":95,"_85":96,"_87":-5,"_88":-5},{"_75":76,"_77":89,"_79":90,"_81":91,"_83":84,"_85":86,"_87":-5,"_88":-5},{"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5,"_88":-5},"kind","image","url","/amznews-reading-preview/_img/7694fb2c14387912.webp","