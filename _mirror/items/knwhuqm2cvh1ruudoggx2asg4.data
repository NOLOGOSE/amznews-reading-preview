[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","knwhuqm2cvh1ruudoggx2asg4","revision",2,"title","亚马逊美国站商业责任险新规11月2日生效，大陆卖家须通过AIA投保","originalTitle","倒计时！亚马逊美国站保险新规11月2日生效","summary","亚马逊公布美国站商业责任险新规将于11月2日正式生效，规定销售具有更严格安全要求的商品无论销售额高低均须投保，且中国大陆卖家新提交保单必须通过亚马逊保险加速器（AIA）获取。不符合要求的listing将被停售，保单需满足每次事故及累计赔偿限额至少100万美元等13项标准。","reason","原文梳理了亚马逊美国站商业责任险新规的生效时间、触发条件及中国大陆卖家通过AIA投保的具体要求。","source",{"_9":133,"_134":135,"_93":136,"_137":66,"_138":139,"_140":141},"links",{"_130":131,"_68":132},"publishedAt","2026-10-20T10:01:33.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-20T10:37:38.068Z","timelineAt","category","policy","tags",[129,54],"score",88,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86,87,88,89,90,91,92],"byline",{"_53":54,"_82":83},"detailedGuide","readingMode","full","author","亚马逊","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fJrNToYU4s3w",{"_78":79,"_13":80},"reportCount",3,"additionalSourceCount",1,"developmentCount",0,"publicId","c280b4c3-d97f-48fd-913d-ea5ac97dba7e","亚马逊美国站商业责任险新规11月2日生效",{"_78":79,"_13":80},"platform","雨果跨境",{"_93":94,"_95":126,"_97":127,"_99":128,"_101":-5,"_102":-5,"_103":-5,"_104":-5},{"_93":94,"_95":123,"_97":124,"_99":125,"_101":-5,"_102":-5,"_103":-5,"_104":-5},{"_93":94,"_95":120,"_97":121,"_99":122,"_101":-5,"_102":-5,"_103":-5,"_104":-5},{"_93":94,"_95":117,"_97":118,"_99":119,"_101":-5,"_102":-5,"_103":-5,"_104":-5},{"_93":94,"_95":114,"_97":115,"_99":116,"_101":-5,"_102":-5,"_10