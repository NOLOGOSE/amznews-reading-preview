[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","kqhe6l009afmw44rv44tp1sva","revision",1,"title","亚马逊将第三方物流业务整合为 Amazon Supply Chain Services","originalTitle","Amazon rebrands third-party logistics arms as unified supply chain service","summary","亚马逊于周一正式推出统一品牌 Amazon Supply Chain Services，将其内部使用的货运、配送及仓储等物流服务向所有第三方企业开放。该举措旨在利用网络剩余产能，使汽车、医疗等行业客户能获取从原材料到成品的端到端供应链支持，分析师指出其需加大基础设施投入以与 FedEx 等巨头竞争。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-05-04T16:56:57.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:17:07.746Z","timelineAt","category","fba","tags",[68,69,70],"score",50,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves","FBA/物流","亚马逊","供应链","aihot","/items/kqhe6l009afmw44rv44tp1sva","https://www.freightwaves.com/news/amazon-rebrands-third-party-logistics-arms-as-unified-supply-chain-service","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
