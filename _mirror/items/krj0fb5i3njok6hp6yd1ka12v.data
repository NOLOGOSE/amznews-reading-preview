[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","krj0fb5i3njok6hp6yd1ka12v","revision",1,"title","亚马逊推出 Branded Conversations 广告让品牌影响 Alexa 回答并拓展至站外","originalTitle","Amazon Just Let Brands Buy Into What Alexa Tells Shoppers — And Took the Ads Off-Site","summary","亚马逊推出“Branded Conversations”新广告格式，允许品牌付费影响 Alexa 对商品类别的解释性回答，并将对话式购物广告首次拓展至非亚马逊网站。据 Adweek 和 Shopifreaks 报道，该功能使卖家能塑造用户听到的实际话术而非仅购买赞助位。这为竞争激烈的品类提供了新的营销杠杆，但原文未提供具体费率或生效日期。","reason","source",{"_9":109,"_110":111,"_73":112,"_113":40,"_114":115,"_116":117},"links",{"_106":107,"_66":108},"publishedAt","2026-10-12T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-12","discoveredAt","2026-10-14T18:08:23.868Z","timelineAt","category","advertising","tags",[103,104,105],"score",42,"selected",false,"channel","news","story","x","media",[68,69,70,71,72],"byline",{"_52":-5,"_67":53},"detailedGuide","readingMode","full","author","SellerBites","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform",{"_73":74,"_75":100,"_77":101,"_79":102,"_81":-5,"_83":-5,"_85":-5,"_86":-5},{"_73":74,"_75":95,"_77":96,"_79":97,"_81":98,"_83":99,"_85":-5,"_86":-5},{"_73":74,"_75":92,"_77":93,"_79":94,"_81":90,"_83":91,"_85":-5,"_86":-5},{"_73":74,"_75":87,"_77":88,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":-5},"kind","image","url","/amznews-reading-preview/_img/fdcfc292c1e612af.webp","fullUrl","/amznews-reading-preview/_img/fdcfc292c1e612af.webp","srcSet","/amznews-reading-preview/_img/fdcfc292c1e612af.webp 336w, /a