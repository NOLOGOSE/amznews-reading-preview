[{"_1":2,"_3":4},"root",{"_5":127},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","krsb8i29e63ia6i2fr0vxyorp","revision",1,"title","傲雷2025年营收16.65亿元，亚马逊与独立站合计贡献13.242亿元","originalTitle","卖手电，一年收入16个亿，广东卖家要上市了","summary","广东照明企业傲雷（Olight）2025年营收16.65亿元，原文称其亚马逊与品牌官网合计贡献13.242亿元收入。原文同时列出亚马逊收入约14.96亿元、亚马逊收入比重49.38%等数据，口径存在冲突，本站尚未独立核验。原文为蓝海亿观网原创，正文引用卖家精灵Sellersprite数据，存在相关商业利益，并非独立测评。原文称傲雷面临品类集中、渠道与北美市场依赖、销售费用较高等挑战，能否将Osight、Ostation等品牌发展为第二增长曲线尚待时间验证。","reason","source",{"_9":118,"_119":120,"_76":121,"_122":39,"_123":124,"_125":126},"links",{"_115":116,"_64":117},"publishedAt","2026-06-24T15:07:17.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:54.186Z","timelineAt","category","product","tags",[112,113,114],"score",37,"selected",false,"channel","news","story","x","media",[67,68,69,70,71,72,73,74,75],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","蓝海亿观网",{"_76":77,"_78":109,"_80":110,"_82":111,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":106,"_80":107,"_82":108,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":103,"_80":104,"_82":105,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":100,"_80":101,"_82":102,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":97,"_80":98,"_82":99,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":94,"_80":95,"_82":96,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":91,"_80":92,"_82":93,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":88,"_80":89,"_82":90,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76"