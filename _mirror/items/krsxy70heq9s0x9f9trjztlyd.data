[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","krsxy70heq9s0x9f9trjztlyd","revision",2,"title","从中国发往美国亚马逊 FBA 的运费报价受哪些因素影响？","originalTitle","Amazon FBA Shipping Cost from China to USA: What Affects Your Quote?","summary","从中国发往美国亚马逊 FBA 的运费没有统一固定价格，报价取决于运输方式、实际重量或体积重、货量、目的地、DDP 或清关范围、亚马逊 FBA 贴标与路由要求以及时效。承运商会比较实际重量与体积重，按较大者计费，因此体积大而轻的纸箱报价可能高于卖家预期。卖家询价前应准备箱数、每箱毛重、纸箱长宽高、总 CBM、产品信息、目的地及预期服务范围，并确认各报价使用相同运输数据和交付范围。","reason","source",{"_9":102,"_103":67,"_72":104,"_105":39,"_106":107,"_108":109},"links",{"_99":100,"_65":101},"publishedAt","2026-06-07T12:00:21.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-01T17:39:11.373Z","timelineAt","category","fba","tags",[95,96,97,98],"score",20,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Aaron Yi","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FBABEE",{"_72":73,"_74":92,"_76":93,"_78":94,"_80":81,"_82":83,"_84":-5,"_85":-5},{"_72":73,"_74":89,"_76":90,"_78":91,"_80":81,"_82":83,"_84":-5,"_85":-5},{"_72":73,"_74":86,"_76":87,"_78":88,"_80":81,"_82":83,"_84":-5,"_85":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/df681a4661e45125.webp","fullUrl","/amznews-reading-preview/_img/df681a4661e45125.webp","srcSet","/amznews-reading-preview/_img/df681a4661e45125.webp 336w, /amznews-reading-preview/_img/df681a4661e45125.webp 720w","width",1672,"height",941,"alt","poster","/amznews-reading-pr