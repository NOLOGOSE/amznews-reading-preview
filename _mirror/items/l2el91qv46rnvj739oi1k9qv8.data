[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","l2el91qv46rnvj739oi1k9qv8","revision",2,"title","David Stellato 分享利用联盟营销漏斗在亚马逊外提升销量的策略","originalTitle","Sell More Off Amazon With Affiliate Funnels, with David Stellato","summary","David Stellato 提出通过直接响应漏斗将亚马逊卖家流量转化为自有 Shopify 销售，以摆脱仅构建亚马逊客户列表的局面。该模式包含广告、软文及多级结账流程，旨在将 $50 订单提升至 $100-$150，并建议附加率至少达 30%。Stellato 还分享了设置成本、收入分成比例及媒体测试资金储备等关键运营数据。","reason","source",{"_9":107,"_108":81,"_84":109,"_110":39,"_111":112,"_113":114},"links",{"_105":106,"_67":101},"publishedAt","2026-10-13T13:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-13T13:40:40.873Z","timelineAt","category","advertising","tags",[102,103,104],"score",32,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Nhan Dinh","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fmQqqr46CUu8",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","636f2e59-a816-47b6-a8fd-5bc3dc7a9998","David Stellato 谈亚马逊外联盟营销漏斗策略",{"_76":77,"_13":78},"platform","Seller Labs",{"_84":98,"_86":99,"_100":101,"_92":-5,"_94":-5,"_96":-5,"_97":-5},{"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":95,"_96":-5,"_97":-5},"kind","image","url","/amznews-reading-preview/_img/b5dc6d8803c6d607.webp","fullUrl","/amznews-reading-preview/_img/b5dc6d8803c6d607.webp","srcSet","/amznews-reading-preview/_img/b5dc6d8803c6d607.webp 336w, /amznews-