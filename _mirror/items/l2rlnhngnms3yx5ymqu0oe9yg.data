[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","l2rlnhngnms3yx5ymqu0oe9yg","revision",2,"title","亚马逊 FBA 货件拆分指南：选项、权衡与发货前检查清单","originalTitle","Amazon FBA Shipment Splits Guide: Options, Trade-Offs, and Pre-Shipment Checklist","summary","亚马逊 FBA 货件拆分是入库配置选项，可能将库存发往一个或多个入库地点，卖家通常会看到最小拆分、部分拆分或亚马逊优化拆分等选项。最小拆分操作更简单但可能产生入库配置费，亚马逊优化拆分在货件符合条件时被亚马逊描述为免收该费用，但入库地点更多。卖家无法完全控制亚马逊的分配决定，但可在创建货件前核对 SKU 与数量、箱数、商品尺寸重量及特殊处理分类，并结合运费报价与断货时限比较总成本。","reason","source",{"_9":98,"_99":67,"_71":100,"_101":39,"_102":103,"_104":105},"links",{"_95":96,"_65":97},"publishedAt","2026-06-07T14:00:06.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-01T17:39:11.358Z","timelineAt","category","fba","tags",[91,92,93,94],"score",32,"selected",false,"channel","news","story","x","media",[68,69,70],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Aaron Yi","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FBABEE",{"_71":72,"_73":88,"_75":89,"_77":90,"_79":80,"_81":82,"_83":-5,"_84":-5},{"_71":72,"_73":85,"_75":86,"_77":87,"_79":80,"_81":82,"_83":-5,"_84":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/9591098ab5e25d1d.webp","fullUrl","/amznews-reading-preview/_img/9591098ab5e25d1d.webp","srcSet","/amznews-reading-preview/_img/9591098ab5e25d1d.webp 336w, /amznews-reading-preview/_img/9591098ab5e25d1d.webp 720w","width",1672,"height",941,"alt","poster","/amznews-reading-preview/_img/2bd8a5cf823437e9.webp","/amznews-reading-preview/_img/2