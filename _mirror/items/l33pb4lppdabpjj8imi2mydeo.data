[{"_1":2,"_3":4},"root",{"_5":129},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","l33pb4lppdabpjj8imi2mydeo","revision",2,"title","Keith律所代理德国插画师Franzi Draws发起版权诉讼（案号26-cv-02270）","originalTitle","【侵权快讯】26-cv-02270 速看避雷！Keith 律所代理德国插画师Franzi Draws发起TRO维权，5 幅治愈系矢量插画版权起诉 66 名卖家！","summary","据原文，Keith & Ference律所代理德国插画师Franziska Paetzold（Franzi Draws）就5幅矢量插画提起版权诉讼，案号26-cv-02270，起诉时间为2026年10月20日。原文标题提及66名卖家，但正文未列出被告人数，本站尚未独立核验该数字及诉讼文书。原文建议卖家按图排查多平台相似图案，并在收到平台冻结或法院材料时依据案号核验TRO是否真实签发，再在21天响应窗口期内联系专业律师；该期限的起算与适用条件原文未说明。","reason","source",{"_9":120,"_121":122,"_88":123,"_124":40,"_125":126,"_127":128},"links",{"_117":118,"_68":119},"publishedAt","2026-10-21T01:52:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-22T06:12:25.567Z","timelineAt","category","policy","tags",[115,116],"score",55,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83,84,85,86,87],"byline",{"_53":54,"_80":81},"detailedGuide","readingMode","full","author","而为网","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":12,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fT8YvvlZENVM",{"_76":77,"_13":78},"reportCount","additionalSourceCount",0,"developmentCount","publicId","8b8ba895-6f53-455b-bb6d-0061c5d7c32d","插画师Paetzold版权诉讼涉66名卖家",{"_76":77,"_13":78},"platform","AMZ123",{"_88":89,"_90":112,"_92":113,"_94":114,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":109,"_92":110,"_94":111,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":106,"_92":107,"_94":108,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":103,"_92":104,"_94":105,