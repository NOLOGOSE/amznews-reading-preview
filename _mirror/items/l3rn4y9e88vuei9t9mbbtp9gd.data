[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","l3rn4y9e88vuei9t9mbbtp9gd","revision",2,"title","亚马逊NWD通知引卖家关注：10月27日移除订单提交截止，收到邮件不等于下架","originalTitle","紧急｜亚马逊NWD下架倒计时：10月27日截止，不处理库存或被弃置","summary","近期部分卖家收到亚马逊NWD（品牌方仅做DTC直营、不向批发商或第三方转售商供货）相关通知，邮件提及商品10月27日下架、逾期未处理FBA库存可能被弃置。原文指出，本轮通知由系统批量发给品牌代表和分销商两类账号、不单独识别角色，收到邮件不等于下架，关键看账号在品牌备案后台是否登记为Brand Representative且角色生效；已登记且角色生效的正常销售不受影响，授权经销商、普通转售商不等于品牌代表。原文按品牌维度判定风险，列出分销型、铺货型、精铺型、拿货转售四类高风险卖家，并给出自有品牌误通知、正规分销商、品牌本身属NWD模式、合法经销体系被误判四种场景的应对步骤；其中货物无需27日前实际出库，截止日前成功提交移除订单即可避免弃置。以上为原文观点，具体规则与账号状态需以亚马逊后台及官方通知为准。","reason","原文区分了系统批量通知与确定下架，说明需先核对Brand Representative角色再匹配应对方案，并给出四类高风险卖家与分场景处理步骤，同时保留提交移除订单即可避免弃置的条件。","source",{"_9":89,"_90":91,"_92":93,"_94":66,"_95":-5},"links",{"_86":87,"_68":88},"publishedAt","2026-10-23T01:32:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-23T02:02:27.832Z","timelineAt","category","policy","tags",[83,84,85],"score",74,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","海象跨境","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":73,"_74":12,"_75":76},"hasTranslation",false,"bodyLanguage","original","factId","fbAjJrnzgSnM",{"_77":78,"_13":79},"reportCount",5,"additionalSourceCount","developmentCount",0,"publicId","dbf445cd-5ab4-4c48-9b75-67dad0c62a93","亚马逊NWD限售通知引发卖家下架与库存担忧",{"_77":78,"_13":79},"platform","卖家之家","政策/合规","FBA/物流","亚马逊","aihot","/items/l3rn4y9e88vuei9t9mbbtp9gd","https://mjzj.com/article/g1z90atu4agw","publisher-mjzj-feed","name","卖家之家 · 跨境资讯","kind","rss","firstParty","iconUrl",{"_97":98},"changelogVersion","2026-10-09T22:08"]
