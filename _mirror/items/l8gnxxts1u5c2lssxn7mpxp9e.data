[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","l8gnxxts1u5c2lssxn7mpxp9e","revision",1,"title","亚马逊无预警下架日销2万链接","originalTitle","Hey @amznsellerhelp","summary","@amznsellerhelp\n\n亚马逊刚刚在无通知的情况下下架了一个日销售额达 $20k 的商品详情页\n\n我们已获取 TRF ID，并立即通过亚马逊购买了 Eurofins 测试\n\n我们也将分享过去的 GMP 和 COA\n\n但亚马逊还威胁在库存滞留 30 天后将其处置\n\n这太疯狂了——警告期在哪里？为什么在等待测试结果期间不恢复商品详情页？\n\n案例编号：22591088931","reason","source",{"_9":85,"_86":87,"_88":89,"_90":39,"_91":-5},"links",{"_82":83,"_66":84},"publishedAt","2026-10-14T18:36:37.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.567Z","timelineAt","category","policy","tags",[80,81],"score",40,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Evan_Swanson_","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Hey @amznsellerhelp</p><p>Amazon just took down a listing WITHOUT NOTICE doing $20k/day</p><p>We have a TRF ID and immediately purchased a Eurofins test through Amazon</p><p>We will also share the past GMP and COAs</p><p>But Amazon is also threatening to DISPOSE of the inventory after it's stranded for 30 days</p><p>This is crazy - where is the warning period? Why is the listing not reinstated while we wait for testing results?</p><p>Case ID: 22591088931</p>","zhKind","complete","authorName","Evan Swanson","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"政策/合规","亚马逊","aihot","/items/l8gnxxts1u5c2lssxn7mpxp9e","https://x.com/Evan_Swanson_/status/2110439652842717565","x-evan-swanson","name","X · Evan Swanson","kind","x_search","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
