[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","l8l6ejwuf0z6960r9z8fu2112","revision",5,"title","卖家客服中 AI 应置于人工背后而非替代对话","originalTitle","I’m So Glad I Talked to a Person Instead of AI","summary","原文作者主张在客服场景中，AI 仅用于检索历史、起草回复及润色措辞，严禁直接面向客户对话，以确保人工始终掌控沟通。Gartner 2024 年调查显示 64% 客户偏好无 AI 服务，而 2026 年数据指出 87% 认为保留人工通道至关重要。实现该模式需通过 MCP 连接邮件等系统，使 AI 能读取完整上下文辅助人工决策。","reason","source",{"_9":87,"_88":81,"_89":90,"_91":39,"_92":93,"_94":95},"links",{"_84":85,"_67":86},"publishedAt","2026-10-05T13:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-05T13:44:06.000Z","timelineAt","category","ai-tools","tags",[82,83],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Nhan Dinh","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fWDQ-1hNRRv0",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","16d3e57b-c6be-4551-b2f8-0dd6e7e10083","客服从业者主张AI只用于准备环节",{"_76":77,"_13":78},"platform","Seller Labs","AI/工具","AI工具","aihot","/items/l8l6ejwuf0z6960r9z8fu2112","https://www.sellerlabs.com/blog/customer-service-ai-that-keeps-the-human-on-the-phone/","rss-sellerlabs-prelaunch","name","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp","iconSrcSet","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 48w, /amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 96w",{"_97":98},"changelogVersion",