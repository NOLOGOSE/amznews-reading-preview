[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":-5,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","lbk45xiybb0a3i0rk9oo1a53a","revision",4,"title","TikTok Shop墨西哥站拟于2月13日启动，首批为本土卖家","originalTitle","重磅！TiKTok Shop墨西哥站即将上线","summary","原文称，TikTok Shop墨西哥站将于1月13日开启首批店铺和达人入驻权限，2月6日开放达人电商权限，2月13日正式启动；首批商户均为本土卖家。原文还转述业内知情人士消息称，平台已向美客多、美区及亚马逊头部卖家发出定向邀请，首批活动拟投入200-300万美元预算进行产品端补贴，消费者享三单五折，商家享免佣金和免邮费两个月。上述邀请、预算及补贴信息均来自原文转述，未经独立验证，不能作为确定事实或行动依据。","reason","source",{"_9":86,"_87":88,"_68":89,"_90":38,"_91":92,"_93":94},"links",{"_83":84,"_64":85},"publishedAt","2025-01-07T01:08:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:52:58.001Z","timelineAt","category","tags",[80,81,82],"score",45,"selected",false,"channel","news","story","x","media",[67],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","KJ123跨境电商","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":-5,"_78":-5,"_79":-5},"kind","image","url","/amznews-reading-preview/_img/3284f770d37ecfbb.webp","fullUrl","/amznews-reading-preview/_img/3284f770d37ecfbb.webp","srcSet","/amznews-reading-preview/_img/3284f770d37ecfbb.webp 336w, /amznews-reading-preview/_img/3284f770d37ecfbb.webp 720w","width","height","alt","poster","行业动态","多平台销售","亚马逊","aihot","/items/lbk45xiybb0a3i0rk9oo1a53a","https://www.amz123.com/t/mIdGOhD6","author-amz123-kj123-reviewed","name","AMZ123 · KJ123跨境电商","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c