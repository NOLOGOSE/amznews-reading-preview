[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":-5,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","lccbzpcou6g3rwvk5p47wgfht","revision",3,"title","帮工厂做亚马逊电商：4方出资50万，操盘人该占多少实股、工资怎么定？","originalTitle","工厂合作股权协议问题，目前我的想法是我想占35%，与C合起来大于50%，C做亚马逊的，懂运营，可能后期决策有作用（当然他们是一伙的）……","summary","一位操盘人计划帮熟悉的工厂做亚马逊为主的电商业务，第一期资金50万，A为工厂老板、B为A的朋友、C为A的姐姐（也做亚马逊），三方仅出资，由提问者负责选品改良与运营。C要求占20%股，提问者初定有10%干股分红加阶梯工资，并考虑以工资和奖金转35%实股，询问实股比例、工资标准及技术入股是否应打折。","reason","source",{"_9":72,"_73":66,"_74":75,"_76":38,"_77":78,"_79":80},"links",{"_69":70,"_64":71},"publishedAt","2026-09-28T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:45:54.283Z","timelineAt","category","tags",[67,68],"score",10,"selected",false,"channel","news","story","x","media",[],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","薄情忘情纵情","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","其他","品牌","aihot","/items/lccbzpcou6g3rwvk5p47wgfht","https://www.wearesellers.com/question/125048","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_82":83},"changelogVersion","2026-10-09T22:08"]
