[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","lcuj2icne2pnube1ggszms9sf","revision",2,"title","ChannelEngine 指南：如何在 Marketplace 设定最低价格以保护利润","originalTitle","Marketplace pricing strategy - How to set your minimum price on marketplaces","summary","ChannelEngine 发布指南，指导卖家通过计算产品成本、运营费用及平台佣金来设定覆盖所有支出的最低价格。该策略旨在防止动态定价下亏损销售并维持品牌一致性。文中详细拆解了从 COGS 到中间件费用的核算步骤，并介绍如何利用 ChannelEngine 的价格规则配置基础价与最低商业价。","reason","source",{"_9":92,"_93":94,"_70":95,"_96":39,"_97":98,"_99":100},"links",{"_89":90,"_65":91},"publishedAt","2026-06-24T10:45:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-11T18:21:10.849Z","timelineAt","category","advertising","tags",[86,87,88],"score",22,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Robert Grundeken","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","ChannelEngine",{"_70":71,"_72":83,"_74":84,"_76":85,"_78":-5,"_80":-5,"_81":-5,"_82":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":79,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/e7c7ad13f6bd118f.webp","fullUrl","/amznews-reading-preview/_img/e7c7ad13f6bd118f.webp","srcSet","/amznews-reading-preview/_img/e7c7ad13f6bd118f.webp 336w, /amznews-reading-preview/_img/e7c7ad13f6bd118f.webp 720w","width",152,"height","alt","poster","/amznews-reading-preview/_img/07136e6675abd79e.webp","/amznews-reading-preview/_img/07136e6675abd79e.webp","/amznews-reading-preview/_img/07136e6675abd79e.webp 336w, /amznews-reading-prev