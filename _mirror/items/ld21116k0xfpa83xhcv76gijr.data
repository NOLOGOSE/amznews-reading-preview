[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ld21116k0xfpa83xhcv76gijr","revision",1,"title","沃尔玛第三方市场增速创近年最快，一季度同比增长近50%","originalTitle","Walmart Marketplace Growth Reaches Fastest Pace in Years","summary","沃尔玛美国第三方市场在2027财年第一季度（截至2026年4月30日）同比增长近50%，为两年半来最高增速。其市场GMV估计约150亿美元，约占其美国电商业务1500亿美元的10%，而亚马逊美国GMV约4400亿美元中第三方占比估计为69%。沃尔玛当季通过WFS发货的当日或次日达商品增长近150%，Walmart Connect广告收入（不含VIZIO）增长44%，第三方广告支出增长超50%。","reason","source",{"_9":88,"_89":90,"_69":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_65":87},"publishedAt","2026-06-04T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T10:08:14.697Z","timelineAt","category","product","tags",[81,82,83,84],"score",62,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Ben Donovan","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Marketplace Pulse",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/54e253ab03166816.webp","fullUrl","/amznews-reading-preview/_img/54e253ab03166816.webp","srcSet","/amznews-reading-preview/_img/54e253ab03166816.webp 336w, /amznews-reading-preview/_img/54e253ab03166816.webp 720w","width","height","alt","poster","数据/报告","品类趋势","多平台销售","亚马逊","aihot","/items/ld21116k0xfpa83xhcv76gijr","https://www.marketplacepulse.com/articles/walmart-marketplace-growth-reaches-fastest-pace-in-years","author-marketplace-pulse-ben","name","Marketplace Pulse · Ben Donovan","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/176ec5ffdcc82f4c.webp","iconSrcSet","/amznews-reading-preview/_img/176ec5ffdcc82f4c.webp 48w, /amznews-reading-preview/_img/176ec5ffdcc82f4c.webp 96w",{"_98":99},"changelogVersion","2026-10-09T22:08"]
