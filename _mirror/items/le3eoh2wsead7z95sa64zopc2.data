[{"_1":2,"_3":4},"root",{"_5":137},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","le3eoh2wsead7z95sa64zopc2","revision",2,"title","亚马逊SEND海运服务开通中国至英国和德国航线","originalTitle","英德卖家福音！亚马逊头程新选择，价格比货代还低","summary","原文介绍亚马逊跨境承运伙伴方案（Amazon SEND）开通中国至英国、德国的海运服务，目前可选承运商包括美通供应链（AAF）和九方通逊（Jiufang）。原文称该服务在卖家平台提供下单、查价与货件追踪，使用亚马逊协议价，国内仓库入仓费用和中转费全免，并支持上门取件或自送集货点两种方式。原文为亚马逊SEND服务的推广内容，存在相关商业利益，并非独立测评；文中价格、时效等主张来自原文，本站尚未独立核验。","reason","source",{"_9":129,"_130":82,"_91":131,"_132":40,"_133":134,"_135":136},"links",{"_126":127,"_68":128},"publishedAt","2026-10-12T01:33:36.752Z","publishedPrecision","calendar","calendarDate","2026-10-12","discoveredAt","2026-10-12T13:13:26.540Z","timelineAt","category","fba","tags",[124,125],"score",62,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89,90],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","guowenbo1","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","ft8fAr2zVCv8",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","79b0bd05-e7fa-44ce-beba-e563a6514841","亚马逊SEND海运开通中英中德航线",{"_77":78,"_13":79},"platform","知无不言",{"_91":92,"_93":121,"_95":122,"_97":123,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":118,"_95":119,"_97":120,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":115,"_95":116,"_97":117,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":112,"_95":113,"_97":114,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":109,"_95":110,"_97":111,"_99":-5,"_100