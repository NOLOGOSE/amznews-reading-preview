[{"_1":2,"_3":4},"root",{"_5":126},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","leedi00iwdgf79r2xsu3qocq5","revision",2,"title","亚马逊全球开店推出标杆新卖家孵化计划，目标到2029年扶持2000个品牌三年销售破亿","originalTitle","利好！亚马逊上线标杆新卖家孵化计划：目标扶持2000个品牌三年销售破亿","summary","亚马逊全球开店于2026年7月16日发布标杆新卖家孵化计划，目标到2029年助力2000个新品牌实现单品牌三年销售额突破1亿元人民币。符合条件的卖家最高可获得75万美元专属激励资源支持，涵盖销售佣金减免、物流仓储补贴、站内广告费优惠、促销费用优惠和早期口碑评测权益，权益随业务成长分阶段释放，并非无条件现金。","reason","source",{"_9":117,"_118":119,"_76":120,"_121":39,"_122":123,"_124":125},"links",{"_114":115,"_65":116},"publishedAt","2026-09-07T18:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:24.894Z","timelineAt","category","policy","tags",[109,110,111,112,113],"score",58,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Regan跨境","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_76":77,"_78":106,"_80":107,"_82":108,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":103,"_80":104,"_82":105,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":100,"_80":101,"_82":102,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":97,"_80":98,"_82":99,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":94,"_80":95,"_82":96,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":91,"_80":92,"_82":93,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":88,"_80":89,"_82":90,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5,"_86":-5,"_87":-5},"kind","image","url","/amznews-reading-preview/_img/