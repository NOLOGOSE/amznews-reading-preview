[{"_1":2,"_3":4},"root",{"_5":132},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","lg5xud7n70x74fdooakksb8sy","revision",4,"title","亚马逊推行 Seller Central Passkeys、十月大促撞期及 FedEx 新增国际运费","originalTitle","Amazon Passkeys, October Deal Wars & the AI Shopping Fight","summary","亚马逊通知卖家，Seller Central 的 Passkeys 将从9月下旬起按账户分批强制启用；共享主账号登录可能失效，卖家应改用具名次级用户并配置各自 Passkeys。Amazon Prime Big Deal Days 定于10月6日至7日，Walmart 活动为10月5日至11日，Target Circle Deal Days 为10月6日至7日。FedEx 自9月21日起对部分美国进口包裹加收国际需求附加费，其中中国、香港、澳门为每磅 $0.54 至 $0.91，其他来源地费率不同。","reason","source",{"_9":123,"_124":125,"_75":126,"_127":39,"_128":129,"_130":131},"links",{"_120":121,"_65":122},"publishedAt","2026-09-23T11:32:35.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-11T18:46:08.796Z","timelineAt","category","policy","tags",[117,118,119],"score",40,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74],"byline",{"_51":-5,"_66":67},"detailedGuide","readingMode","full","author","Bellavix","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","BellaVix",{"_75":76,"_77":112,"_79":113,"_81":114,"_83":115,"_85":116,"_87":-5,"_88":-5},{"_75":76,"_77":108,"_79":109,"_81":110,"_83":92,"_85":111,"_87":-5,"_88":-5},{"_75":76,"_77":103,"_79":104,"_81":105,"_83":106,"_85":107,"_87":-5,"_88":-5},{"_75":76,"_77":98,"_79":99,"_81":100,"_83":101,"_85":102,"_87":-5,"_88":-5},{"_75":76,"_77":93,"_79":94,"_81":95,"_83":96,"_85":97,"_87":-5,"_88":-5},{"_75":76,"_77":89,"_79":90,"_81":91,"_83":92,"_85":86,"_87":-5,"_88":-5},{"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86,"_87":-5,"_88"