[{"_1":2,"_3":4},"root",{"_5":127},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ljpmcz35cf3m5mst5zki5lglg","revision",3,"title","选品空手而归时：先复盘筛选条件，再决定是否换方法","originalTitle","Podcast Episode 105 – Overcoming Your Fear of an Empty Cart","summary","Stephen Smotherman 署名的2021年文字稿记录了他与 Rebecca 的选品讨论，适用于零售、线上采购或批发选品中的决策反思。作者认为，为了证明没有白跑而放宽原定条件，可能比暂时不买更难处理；别人晒出的满车或长收据不能证明其利润、销售结果或是否真正购买。反复找不到商品时，作者建议分别检查采购渠道、品类、工具和知识缺口，而不是凭焦虑补库存。本站的资料整理建议是：在出发或浏览供应商前记下本次筛选条件；回来后分别记录“没有找到”和“不符合条件”的原因；若连续遇到同一障碍，只改变一个待验证因素并保留前后记录，再判断是否值得继续。这是一张复盘清单，不是收益公式，也不保证换渠道或买软件能盈利；实际成本、需求、销售权限与产品条件仍需按当前资料核对。原文中的课程、Scoutify、Keepa 与 Tactical Arbitrage 有商业推广或优惠码，本站未实测工具效果，不推荐购买。两位主持人的观点和个人做法分别看待；本站仅核对公开文字材料，未听取或下载原音频，不认证文字稿逐字无误。2021年10月9日是原发日，2024年修改及今天收录不当作新消息。本文是有限原创历史方法导读，第三方全文、译文、完整字幕、图片和音频不在本站展示，完整背景请见原文。","reason","source",{"_9":118,"_119":120,"_74":121,"_122":39,"_123":124,"_125":126},"links",{"_115":116,"_65":117},"publishedAt","2021-10-09T20:45:40.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-02T20:22:31.498Z","timelineAt","category","advertising","tags",[111,112,113,114],"score",17,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Stephen Smotherman","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Full-Time FBA",{"_74":75,"_76":106,"_78":107,"_80":108,"_82":109,"_84":110,"_86":-5,"_87":-5},{"_74":75,"_76":102,"_78":103,"_80":104,"_82":105,"_84":105,"_86":-5,"_87":-5},{"_74":75,"_76":97,"_78":98,"_80":99,"_82":100,"_84":101,"_86":-5,"_87":-5},{"_74":75,"_76":92,"_