[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ljuva79xc5zns4vpu5vvmmrvr","revision",2,"title","亚马逊承认一季度税务报告报送数据存在差异，称两周内联系卖家","originalTitle","罕见！亚马逊官方承认报送数据存在差异","summary","5月19日晚，不少中国卖家收到亚马逊发送的2026年第一季度税务报告，发现平台报送税局的费用与后台真实费用差距明显。一位美国站卖家一季度销售额约230万元、后台费用约110万元，但报送税局的佣金及服务费合计仅8.9万元，占销售额3.6%；部分加拿大站、墨西哥站卖家报告中的成本甚至出现负数。亚马逊回应称正在审核所有报告，预计两周内联系相关卖家，卖家暂时无需执行任何操作。","reason","source",{"_9":92,"_93":94,"_70":95,"_96":39,"_97":98,"_99":100},"links",{"_89":90,"_65":91},"publishedAt","2026-05-28T00:23:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:34.663Z","timelineAt","category","policy","tags",[85,86,87,88],"score",71,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","咱们的跨境运营笔记","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_70":71,"_72":82,"_74":83,"_76":84,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/11a17276246b6ced.webp","fullUrl","/amznews-reading-preview/_img/11a17276246b6ced.webp","srcSet","/amznews-reading-preview/_img/11a17276246b6ced.webp 336w, /amznews-reading-preview/_img/11a17276246b6ced.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/7ff683ac9b65c490.webp","/amznews-reading-preview/_img/7ff683ac9b65c490.webp","/amznews-reading-preview/_img/7ff683ac9b65c490.webp 336w, /amznews-reading-preview/_img/7ff683ac9b65c490.webp 720w","行业动态","合规税务","亚马逊","FBA/物流","aihot","/items/ljuva79xc5zns4vpu5vvmmrvr","https://www.amz123.com/t/zImBnKQg","author-amz123-zanmen-reviewed","name","AMZ123 · 咱们的跨境运营笔记","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_102":103},"changelogVersion","2026-10-09T22:08"]
