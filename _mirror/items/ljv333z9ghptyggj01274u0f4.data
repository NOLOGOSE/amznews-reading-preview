[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","ljv333z9ghptyggj01274u0f4","revision",2,"title","亚马逊危险品审核被拒常见于 MSDS 与 ASIN 不符等四个细节","originalTitle","亚马逊危险品审核被拒，不是有 MSDS 就能通过，很多卖家卡在这 4 个细节","summary","作者根据自身经验整理亚马逊危险品审核被拒的四个常见原因：MSDS 信息与产品 ASIN 不一致、后台产品属性填错、产品包装标签缺失、豁免类别误判。作者认为审核人员会核对成分、包装及分类信息是否与后台属性匹配，仅提交正规 MSDS 文件不足以保证通过；多次提交不符合要求的材料可能拉长审核周期。以上为作者观点，具体审核要求以亚马逊官方为准。原文来自该机构，存在相关商业利益，并非独立测评。","reason","source",{"_9":102,"_103":82,"_84":104,"_105":40,"_106":107,"_108":109},"links",{"_99":100,"_68":101},"publishedAt","2026-10-15T04:07:40.779Z","publishedPrecision","calendar","calendarDate","2026-10-15","discoveredAt","2026-10-15T03:45:20.820Z","timelineAt","category","policy","tags",[96,97,98],"score",39,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","A电M商Z郑老师","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fJJU6ZrLQA_Y",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","3973f8de-2611-4fc8-a6b3-672c681a2a60","亚马逊危险品审核触发原因与申诉要点",{"_77":78,"_13":79},"platform","知无不言",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/f0fca116308cd686.webp","fullUrl","/amznews-reading-preview/_img/f0fca116308cd686.webp","srcSet","/amznews-reading-preview/_img/f0fca116308cd686.webp 336w, /amznews-reading-preview/_img/f0fca116308cd686.webp 720w","width","height","alt","poster","政策/合规