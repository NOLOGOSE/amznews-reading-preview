[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","lm45o5oryqdvvi1m1hr4zjci2","revision",5,"title","关键词自然位进首页后，如何用降 bid 梯度测试判断广告是否抢自然单","originalTitle","关键词自然位进入首页后，怎么判断广告是否抢了自然单？","summary","针对核心关键词自然排名已上首页、广告订单占比仍偏高的情形，可用只降 bid 不关词的梯度测试判断广告是否在抢自然单。测试前要求自然排名至少首页前16且稳定2周以上、花费有体量、近两周单量平稳，降幅建议10%-20%，随后进入2周静默期并等待7天点击归因窗口。复盘按总单量没掉、轻微下降、断崖式下降三种结果分别对应固定竞价、算账观察、立刻调回竞价，并可结合 TACoS 走势交叉验证。","reason","source",{"_9":76,"_77":78,"_79":80,"_81":39,"_82":83,"_84":85},"links",{"_73":74,"_65":75},"publishedAt","2026-09-23T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:39.036Z","timelineAt","category","advertising","tags",[68,69,70,71,72],"score",62,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","跨境移花宫","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123","广告/运营","广告投放","关键词","Listing优化","亚马逊","aihot","/items/lm45o5oryqdvvi1m1hr4zjci2","https://www.amz123.com/t/3IFvf6Ih","author-amz123-yihuagong-reviewed","name","AMZ123 · 跨境移花宫","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_87":88},"changelogVersion","2026-10-09T22:08"]
