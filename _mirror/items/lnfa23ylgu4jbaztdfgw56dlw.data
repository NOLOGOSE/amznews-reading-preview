[{"_1":2,"_3":4},"root",{"_5":124},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","lnfa23ylgu4jbaztdfgw56dlw","revision",1,"title","中国卖家撑起ManoMano“半边天”，致欧等品牌成核心供应链支撑","originalTitle","中国卖家，撑起ManoMano平台的“半边天”","summary","中国卖家在ManoMano平台实现快速增长，致欧、司顺等品牌成为其供应链核心。2026年招商政策显示，入驻需具备欧洲站月销3万欧元以上或同类业绩，法国等站点月租115欧元，佣金约12%-20%。面对亚马逊及Leroy Merlin竞争，ManoMano依赖中国产业带补足品类短板，部分卖家单月GMV突破50万欧元。","reason","source",{"_9":115,"_116":117,"_75":118,"_119":39,"_120":121,"_122":123},"links",{"_112":113,"_64":114},"publishedAt","2026-06-02T14:03:42.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:54.233Z","timelineAt","category","policy","tags",[108,109,110,111],"score",42,"selected",false,"channel","news","story","x","media",[67,68,69,70,71,72,73,74],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","蓝海亿观网",{"_75":76,"_77":105,"_79":106,"_81":107,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":102,"_79":103,"_81":104,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":99,"_79":100,"_81":101,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":96,"_79":97,"_81":98,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":93,"_79":94,"_81":95,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":90,"_79":91,"_81":92,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":87,"_79":88,"_81":89,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5,"_84":-5,"_85":-5,"_86":-5},"kind","image","url","/amznews-reading-preview/_img/7e713a0a6f9cc760.webp","fullUrl"