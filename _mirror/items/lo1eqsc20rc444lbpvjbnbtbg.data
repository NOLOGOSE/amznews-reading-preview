[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","lo1eqsc20rc444lbpvjbnbtbg","revision",3,"title","2019官方案例复盘：保存亚马逊培训付款与往来证据","originalTitle","Amazing Wealth System Settlement Update","summary","Bridget Small在2019年5月1日的FTC文章中，回顾Amazing Wealth System等亚马逊培训商业机会的和解后续。原文记载2018年和解对相关被告销售商业机会和辅导服务的限制，并建议受影响的人保留付款记录、宣传材料、邮件往来及与Amazon业务有关的文件，保存原件和副本。本站将其作为历史证据整理案例，建议把宣传承诺、付款与沟通记录对应归档。文中当时的退款等待、投诉菜单与申报安排不是今天的申请指南；案件页另列后续退款记录，本文未核实当前资格或进展，不提供追款服务、申报步骤或赔付保证。原文的获利宣传是案件涉及的承诺，不能当成可复现收益。这里只提供有限原创历史导读，完整原稿请阅FTC；AI阅读评分不构成真实性或法律保证。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":61,"_80":-5},"links",{"_71":72,"_65":73},"publishedAt","2019-05-01T17:27:08.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-03T02:06:38.795Z","timelineAt","category","policy","tags",[68,69,70],"score",12,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Bridget Small","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FTC Consumer Advice","政策/合规","亚马逊","合规税务","aihot","/items/lo1eqsc20rc444lbpvjbnbtbg","https://consumer.ftc.gov/consumer-alerts/2019/05/amazing-wealth-system-settlement-update","author-ftc-bridget-official-crossref-reviewed","name","FTC Consumer Advice · Bridget Small","kind","web_list","firstParty","iconUrl",{"_82":83},"changelogVersion","2026-10-09T22:08"]
