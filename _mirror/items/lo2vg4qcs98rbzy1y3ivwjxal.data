[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","lo2vg4qcs98rbzy1y3ivwjxal","revision",1,"title","亚马逊广告推出对话式AI分析体验（封闭测试）","originalTitle","Analytics through conversational experience in Amazon Ads","summary","亚马逊广告于2026年9月28日发布公告，介绍一项基于自然语言的AI驱动分析体验，广告主可通过提问了解广告活动效果、对比基准并挖掘洞察。该体验将对话式交互与可视化工作区结合，基于亚马逊广告的统一报告功能和第一方购物信号构建，涵盖品牌新客和长期销售归因等指标。原文说明该功能目前处于封闭测试阶段，自行管理广告账户的广告主可通过亚马逊广告代表申请加入，或加入候补名单；适用国家/地区以原文列出的名单为准。原文来自亚马逊广告，存在相关商业利益，并非独立测评。","reason","原文给出了自然语言分析的具体提问示例、适用国家/地区名单，并明确该功能处于封闭测试阶段及申请路径。","source",{"_9":96,"_97":98,"_71":99,"_100":41,"_101":102,"_103":104},"links",{"_94":95,"_66":88},"publishedAt","2026-09-28T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-28","discoveredAt","2026-10-22T17:24:11.696Z","timelineAt","category","advertising","tags",[90,91,92,93],"score",60,"selected",true,"channel","news","story","x","media",[69,70],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","亚马逊广告",{"_71":85,"_73":86,"_87":88,"_77":89,"_79":-5,"_81":-5,"_83":-5,"_84":86},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/5a10313fe9cb476d.webp","fullUrl","/amznews-reading-preview/_img/5a10313fe9cb476d.webp","srcSet","/amznews-reading-preview/_img/5a10313fe9cb476d.webp 336w, /amznews-reading-preview/_img/5a10313fe9cb476d.webp 720w","width",1450,"height",1072,"alt","poster","video","/amznews-reading-preview/_img/df5ff0131c11440d.webp","originalUrl","https://advertising.