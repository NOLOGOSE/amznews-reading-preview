[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","lohdjcq7ua0dydvd6l84naivh","revision",2,"title","亚马逊美国站公布锂电池供电智能家居及消费电子产品合规标准","originalTitle","锂电池供电的智能家居设备和消费类电子产品均符合适用的法律、法规和标准","summary","亚马逊要求美国站所有由锂电池供电的智能家居和消费类电子产品符合适用的法律、法规和标准。监控摄像头、视频门铃等音视频设备需符合 UL/CSA C22.2 No. 62368-1；空气质量和环境监测仪、数字万用表等测量控制设备需符合 UL/CSA-C22.2 No. 61010-1 及相关特殊要求；锂电池充电器需符合 UL 1310 或 UL 62368-1。","reason","source",{"_9":101,"_102":82,"_84":103,"_104":40,"_105":106,"_107":108},"links",{"_98":99,"_68":100},"publishedAt","2026-10-13T01:27:32.261Z","publishedPrecision","calendar","calendarDate","2026-10-13","discoveredAt","2026-10-13T01:44:28.523Z","timelineAt","category","policy","tags",[96,97],"score",62,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","中了彩票的人生","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f2i45ZBNrq-A",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","d516afc1-fe0f-4183-afc6-89e3f64a3c0d","亚马逊美国站锂电池智能家居产品合规标准",{"_77":78,"_13":79},"platform","知无不言",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/97af998607badbe5.webp","fullUrl","/amznews-reading-preview/_img/97af998607badbe5.webp","srcSet","/amznews-reading-preview/_img/97af998607badbe5.webp 336w, /amznews-reading-preview/_img/97af998607badbe5.webp 720w","width","height","alt","poster","政策/合规","亚马逊","aihot","/items/lo