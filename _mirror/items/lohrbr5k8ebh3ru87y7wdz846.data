[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","lohrbr5k8ebh3ru87y7wdz846","revision",1,"title","亚马逊起诉Perplexity并回应Meta Muse争议","originalTitle","Some helpful context on the new Amazon v Meta/Muse battle that you'd already know if you subscribed to @ReadTheAisle 😎","summary","亚马逊修改对 Perplexity 的诉讼，指控其误导法院称服务器未直接访问亚马逊数据。此前上诉法院曾支持 Perplexity，但亚马逊现指出在 iOS 上其服务器利用客户 Cookie 登录了亚马逊。针对 Meta/Muse 竞争，记者提及亚马逊已有 AI 购物代理 Buy for Me，但未大规模营销。","reason","source",{"_9":94,"_95":96,"_97":98,"_99":39,"_100":-5},"links",{"_91":92,"_66":93},"publishedAt","2026-09-21T21:09:47.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:35:22.377Z","timelineAt","category","policy","tags",[88,89,90],"score",32,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":79,"_44":80},"media",[],"byline","detailedGuide","readingMode","full","author","DelRey","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Some helpful context on the new Amazon v Meta/Muse battle that you'd already know if you subscribed to @ReadTheAisle  😎</p><p>1. Amazon already has its own AI shopping agent called Buy for Me. The company hasn't marketed it heavily yet (maybe because it does some of the things that Amazon is trying to stop other AI agents from doing?)</p><p>2. Amazon last year sued Perplexity over the AI startup's Comet AI agent that some Amazon customers were using to shop on their behalf. An appeals court recently sided with Perplexity (after a lower court had previously ruled in favor of Amazon to temporarily ban Comet from accessing Amazon for shoppers).</p><p>3. On Monday, Amazon amended its complaint against Perplexity accusing Perplexity of misleading the appeals court. Perplexity had told the court its own servers never directly touched Amazon's and that everything happened in the customer's browser.  But Amazon says that's false and that on iOS, Perplexity's servers logged into Amazon themselves using customers' sign-in cookies. We'll see if this case makes it to trial.</p><p>Would be shocked if Amazon sues Meta but this is the era of crazy first times.</p><p>More in The Aisle this week...</p>","zhKind","complete","authorName","Jason Del Rey","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_71":81,"_73":82,"_83":84,"_85":86,"_87":-5},[],"BuccoCapital Bloke","buccocapital","text","Amazon cuts off Muse. \n\nWhile I am bullish Meta and Muse, I think many people are overlooking the digital knife fight that’s about to occur\n\nNobody wants to get commoditized or layered here. Let the games begin","url","https://x.com/buccocapital/status/2102012446600794222","translation","政策/合规","AI工具","亚马逊","aihot","/items/lohrbr5k8ebh3ru87y7wdz846","https://x.com/DelRey/status/2102143275444416771","x-jason-del-rey","name","X · Jason Del Rey","kind","x_search","firstParty","iconUrl",{"_102":103},"changelogVersion","2026-10-09T22:08"]
