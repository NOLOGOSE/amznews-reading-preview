[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":63,"_64":39,"_65":66},"id","lp65rtoyohvr30opj2khtmltc","revision",2,"title","亚马逊欧洲上调燃油及物流附加费至2%","originalTitle","亚马逊欧洲再上调燃油及物流附加费至2%","summary","亚马逊宣布将欧洲多个市场的燃油及物流附加费从1.5%上调至2%，为7个月内第二次调整。新费率自2026年11月2日起适用于FBA订单，覆盖德、法、意、西、英等市场；11月19日扩展至MCF。附加费按配送费用计算，预计FBA卖家每件商品平均增加约0.02欧元（英国站约0.02英镑）。","reason","source",{"_9":103,"_104":105,"_82":106,"_107":39,"_108":109,"_110":111},"links",{"_100":101,"_66":102},"publishedAt","2026-10-21T07:10:56.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-21T07:28:13.632Z","timelineAt","category","policy","tags",[96,97,98,99],"score",45,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","media",[81],"byline",{"_52":-5,"_79":80},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[78],"indexable","markdownAvailable",true,"group",{"_67":68,"_42":69,"_70":71,"_72":12,"_73":74},"hasTranslation","bodyLanguage","original","factId","fc5buGKM2v34",{"_75":76,"_13":77},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","bc6e2a21-a35f-4fb5-bd3e-84734e57c3d2","亚马逊欧洲站燃油及物流附加费上调至2%",{"_75":76,"_13":77},"platform","蓝海亿观网",{"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/328211a8cb694be5.webp","fullUrl","/amznews-reading-preview/_img/328211a8cb694be5.webp","srcSet","/amznews-reading-preview/_img/328211a8cb694be5.webp 336w, /amznews-reading-preview/_img/328211a8cb694be5.webp 720w","width",760,"height",400,"alt","poster","政策/合规","费用变更","FBA/物流","亚马逊","aihot","/items/lp65rtoyohvr30opj2khtmltc","https://www.egainnews.com