[{"_1":2,"_3":4},"root",{"_5":133},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","lqz9gk9mglvrj1wpifejpsqji","revision",2,"title","Venture Forge发布2026年亚马逊英国站秋季大促市场数据","originalTitle","26年亚马逊英国站秋季大促销售额达10.6亿英镑","summary","电商分析机构Venture Forge公布2026年亚马逊英国站Prime Big Deal Days数据，该周期内总销售额达10.6亿英镑，同比增长22%。其中第三方卖家增速（27.5%）接近自营卖家（13.9%）的两倍，且并非依靠更深折扣取胜。在追踪的10个主要品类中，第三方卖家有8个品类增速超过自营；韩国护肤品牌借势大促快速抢占市场份额，其在该品类中的占比从去年的9%升至25%。","reason","原文引用了第三方机构对英国站大促的追踪数据，拆解了不同渠道和品类的销售表现差异。","source",{"_9":124,"_125":126,"_90":127,"_128":67,"_129":130,"_131":132},"links",{"_121":122,"_69":123},"publishedAt","2026-10-22T19:16:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-23","discoveredAt","2026-10-23T03:16:32.691Z","timelineAt","category","product","tags",[117,118,119,120],"score",62,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86,87,88,89],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","亚马逊资讯","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":12,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fLIaznCfF5lo",{"_78":79,"_13":80},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","cd69dc58-b2ce-4078-b0fa-1f87f3448a59","Venture Forge：英国站秋季大促3P增速近1P两倍",{"_78":79,"_13":80},"platform","AMZ123",{"_90":91,"_92":114,"_94":115,"_96":116,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":111,"_94":112,"_96":113,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":108,"_94":109,"_96":110,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":105,"_94":106,"_96":107,"_98":-5,"_99":-5,"_100":-5,"_10