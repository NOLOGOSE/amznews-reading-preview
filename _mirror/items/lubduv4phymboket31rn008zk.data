[{"_1":2,"_3":4},"root",{"_5":121},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","lubduv4phymboket31rn008zk","revision",1,"title","亚马逊 2025 年媒体合作浪潮：重塑广告购买规则","originalTitle","Amazon’s 2025 Partnership Wave: Rewriting the Rules of Media Buying","summary","亚马逊在 2025 年与 Roku、Disney、Netflix 等建立战略合作，旨在通过 Amazon DSP 统一规划高端数字媒体。这些合作提供登录身份去重、Clean Room 数据协作及跨渠道频率控制，将 CTV 和音频转化为可衡量的绩效渠道。此举推动开放网络向高信号平台整合，预计 2026 年将加速独家供应对齐及 AMC 驱动的计划标准化。","reason","source",{"_9":112,"_113":114,"_73":115,"_116":39,"_117":118,"_119":120},"links",{"_109":110,"_65":111},"publishedAt","2026-01-20T17:21:16.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T11:14:25.524Z","timelineAt","category","advertising","tags",[106,107,108],"score",27,"selected",false,"channel","news","story","x","media",[68,69,70,71,72],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Maarja Hewitt","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Ad Advance",{"_73":74,"_75":102,"_77":103,"_79":104,"_81":105,"_83":105,"_85":-5,"_86":-5},{"_73":74,"_75":97,"_77":98,"_79":99,"_81":100,"_83":101,"_85":-5,"_86":-5},{"_73":74,"_75":92,"_77":93,"_79":94,"_81":95,"_83":96,"_85":-5,"_86":-5},{"_73":74,"_75":87,"_77":88,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":-5},"kind","image","url","/amznews-reading-preview/_img/4ed8f73cb3164521.webp","fullUrl","/amznews-reading-preview/_img/4ed8f73cb3164521.webp","srcSet","/amznews-reading-preview/_img/4ed8f73cb3164521.webp 336w, /amznews-reading-preview/_img/4ed8