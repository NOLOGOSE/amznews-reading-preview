[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","lum5k51yu3guxf8z75rxciq64","revision",2,"title","欧盟委员会拟豁免部分中小企业在各销售国指定废物合规代表的义务","originalTitle","EU wants to simplify waste legislation for SMEs","summary","欧盟委员会提议暂停要求部分欧盟小型企业在每个销售国指定废物合规代表的规定，以减轻行政负担。该暂停措施针对生产包装、电池、纺织品、鞋类、电子产品和一次性塑料的欧盟小型企业，拟实施至2035年，或直至通过更全面的循环经济法。企业仍需履行生产者责任延伸制度下的其他义务，如废物预防和支付相关费用。","reason","source",{"_9":87,"_88":89,"_90":91,"_92":39,"_93":94,"_95":96},"links",{"_84":85,"_67":86},"publishedAt","2026-10-22T14:37:32.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T14:37:33.934Z","timelineAt","category","policy","tags",[82,83],"score",40,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Pleuni","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fuhuBQD8H4Kw",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","6ff390cc-121b-4121-b501-3c6e9f5f2557","欧盟拟豁免部分中小企业逐国指定废物合规代表",{"_76":77,"_13":78},"platform","Ecommerce News Europe","政策/合规","合规税务","aihot","/items/lum5k51yu3guxf8z75rxciq64","https://ecommercenews.eu/eu-wants-to-simplify-waste-legislation-for-smes/","rss-ecommercenews-eu","name","Ecommerce News Europe · 欧洲电商与平台动态","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d9eefda62cc58e78.webp","iconSrcSet","/amznews-reading-preview/_img/d9eefda62cc58e78.webp 48w, /amznews-reading-preview/_img/d9eefda62cc58e78.webp 96w",{"_98":99}