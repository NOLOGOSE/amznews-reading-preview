[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","lvwy5yuc68z2mrcwazqkq67bw","revision",3,"title","与货代沟通艰难：发票仓库代码填错致送错仓，1785元缺陷费责任该如何划分","originalTitle","与货代沟通问题非常艰难，我想知道送错仓的责任问题到底该如何划分","summary","卖家称8月15日通过义乌某货代发快船至美国，因发票模板中FTW1的仓库代码误填至州名位置，货代仅按仓库代码下单，导致两票货全部送至SBD1，产生1785元送错仓缺陷费用。卖家称货代业务经理表示业务员有核对义务但出问题无需担责，且该票货还出现丢件后找回、延一水的情况，卖家询问该如何维权。","reason","source",{"_9":99,"_100":67,"_72":101,"_102":39,"_103":104,"_105":106},"links",{"_96":97,"_65":98},"publishedAt","2026-09-23T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:45:53.205Z","timelineAt","category","fba","tags",[93,94,95],"score",17,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","泥舟不渡人","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_72":73,"_74":90,"_76":91,"_78":92,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/10d41b253abb5b73.webp","fullUrl","/amznews-reading-preview/_img/10d41b253abb5b73.webp","srcSet","/amznews-reading-preview/_img/10d41b253abb5b73.webp 336w, /amznews-reading-preview/_img/10d41b253abb5b73.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/17d4a8dbd4a8560e.webp","/amznews-reading-preview/_img/17d4a8dbd4a8560e.webp","/amznew