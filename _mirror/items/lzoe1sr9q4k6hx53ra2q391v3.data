[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","lzoe1sr9q4k6hx53ra2q391v3","revision",5,"title","【亚马逊财务篇】盘点库存到底是在盘什么","originalTitle","【亚马逊财务篇】 盘点库存到底是在盘什么","summary","盘点库存本质是盘现金流状况，核心是盘消耗速度与供给速度两个维度。消耗速度以近7天/14天/21天/30天日均销量按权重计算，供给速度用库存周转天数与库存安全天数（生产交期+物流运转周期+上架时间）对比。按周转天数与安全天数比值决定清货、补货或不动：周转天数>安全天数×1.5清货，<安全天数补货，介于两者之间则不动。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-09-06T15:56:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:42.252Z","timelineAt","category","fba","tags",[68,69,70],"score",30,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","一味君","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123","FBA/物流","库存管理","亚马逊","aihot","/items/lzoe1sr9q4k6hx53ra2q391v3","https://www.amz123.com/t/ExcHBJPB","author-amz123-yiweijun-reviewed","name","AMZ123 · 一味君","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
