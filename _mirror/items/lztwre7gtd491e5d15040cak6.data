[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","lztwre7gtd491e5d15040cak6","revision",5,"title","AI 自动化存在隐性衰减成本，需预算维护而非仅关注上线","originalTitle","Your AI Automation Is Already Decaying: The Upkeep Problem Nobody Budgets For","summary","ZonFlip 指出 AI 自动化因模型更新、外部系统变更及概率性输出特性而持续“衰减”，导致准确率下降且无报错。Anthropic 2025 年 9 月数据显示美国员工 AI 使用率达 40%，加剧了无人复核的自动化风险。企业应参照 Google 技术债务理论，在商业计划中单独预算长期维护与监控成本，避免仅计算构建费用。","reason","source",{"_9":121,"_122":123,"_89":124,"_125":40,"_126":127,"_128":129},"links",{"_118":119,"_68":120},"publishedAt","2026-10-10T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-11","discoveredAt","2026-10-11T17:59:33.087Z","timelineAt","category","ai-tools","tags",[116,117],"score",22,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","Joey Glyshaw","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fGivVjZqlFds",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","00d80179-c942-46cf-b988-3b097a09c5b2","AI自动化上线后衰减与维护成本问题",{"_77":78,"_13":79},"platform","ZonFlip",{"_89":90,"_91":113,"_93":114,"_95":115,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":110,"_93":111,"_95":112,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":107,"_93":108,"_95":109,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":104,"_93":105,"_95":106,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":101,"_93":102,"_95":10