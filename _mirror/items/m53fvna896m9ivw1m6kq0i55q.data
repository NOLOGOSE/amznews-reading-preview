[{"_1":2,"_3":4},"root",{"_5":133},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","m53fvna896m9ivw1m6kq0i55q","revision",4,"title","亚马逊 Rufus 更名 Alexa for Shopping 后卖家如何调整 Listing 与运营策略","originalTitle","What Changed About Amazon Selling When Rufus Became Alexa for Shopping","summary","Joey Glyshaw 分析指出，亚马逊于 2026 年 5 月 13 日将 Rufus 更名为 Alexa for Shopping，并将其与 Alexa+ 整合为统一的购物 AI 助手，标志着对话式购物成为核心渠道。原文引用亚马逊自报数据称，过去一年超过 2.5 亿客户使用 Rufus，月活用户同比增长 149%，互动量增长 210%；本站尚未独立核验这些引用。作者建议卖家从关键词匹配转向回答具体问题，利用 COSMO 常识图谱补充功能与受众语境，并定期审计评论主题与 Q&A 以确保 AI 能提取准确信息。原文来自 ZonFlip，该站销售自有服务与工具，存在相关商业利益，并非独立测评。","reason","原文拆解了亚马逊 AI 助手基于 RAG 和 COSMO 的推荐逻辑，提供了从 Listing 改写、评论审计到站外对齐的 30 天实操计划，并提示评论操纵政策风险。","source",{"_9":124,"_125":126,"_90":127,"_128":67,"_129":130,"_131":132},"links",{"_121":122,"_69":123},"publishedAt","2026-10-13T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-14","discoveredAt","2026-10-14T17:50:25.893Z","timelineAt","category","advertising","tags",[117,118,119,120],"score",62,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86,87,88,89],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","Joey Glyshaw","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":76,"_77":76},"hasTranslation",false,"bodyLanguage","original","factId","frfgOVzlhLeI",{"_78":79,"_13":80},"reportCount",2,"additionalSourceCount",0,"developmentCount","publicId","fa3fcf00-4c8b-45d6-917b-eace9ec52f37","亚马逊将Rufus更名为Alexa for Shopping",{"_78":79,"_13":80},"platform","ZonFlip",{"_90":91,"_92":114,"_94":115,"_96":116,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_9