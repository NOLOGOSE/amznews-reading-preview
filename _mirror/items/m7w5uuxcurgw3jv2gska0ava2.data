[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","m7w5uuxcurgw3jv2gska0ava2","revision",2,"title","Jungle Scout 推出 Share Diagnosis 功能分析亚马逊市场份额变动原因","originalTitle","Amazon Market Share: Find Out Why Yours Moved","summary","Jungle Scout 介绍其 AI Solutions 中的 Share Diagnosis 功能，旨在诊断亚马逊市场份额变动的具体驱动因素。该工具通过测试定价、促销、库存率及竞品动态等变量，按对营收的影响程度排序原因，并区分份额增长是结构性优势还是暂时性波动。用户可通过内置的 Ask Cobalt 助手或连接 Claude、ChatGPT 等外部 AI 工具调用此技能获取分析结果。","reason","source",{"_9":108,"_109":53,"_83":110,"_111":39,"_112":113,"_114":115},"links",{"_105":106,"_67":107},"publishedAt","2026-10-21T20:02:36.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-21T20:24:10.707Z","timelineAt","category","ai-tools","tags",[102,103,104],"score",18,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[81,82],"byline",{"_52":-5,"_80":53},"detailedGuide","readingMode","full","author","Jungle Scout","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fRAYx16v9hLY",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","ba1d2d92-fdfc-4b26-a71b-e227ab02a212","Jungle Scout 推出 Share Diagnosis 份额诊断功能",{"_76":77,"_13":78},"platform",{"_83":84,"_85":97,"_87":98,"_89":99,"_91":100,"_93":101,"_95":-5,"_96":-5},{"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/dea902a56858d5bf.webp","fullUrl","/amznews-reading-preview/_img/dea902a56858d5bf.webp","srcSet","/amznews-reading-preview/_img/dea902a568