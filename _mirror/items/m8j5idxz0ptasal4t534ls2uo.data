[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","m8j5idxz0ptasal4t534ls2uo","revision",2,"title","亚马逊 2026 Q4 旺季费用：峰值履约费、仓储涨价与 3.5% 燃油附加费","originalTitle","Q4 2026 Amazon Fees: Peak Fee, $2.40 Storage and 3.5% Fuel","summary","据 Chain Store Age、AMZ Prep、PPC Land 等报道，2026 年 Q4 亚马逊 FBA 费用出现三项叠加：10 月 15 日至 2027 年 1 月 14 日假日高峰履约费平均每件增加 $0.32（原文注明为平均值，实际按尺寸重量分层）；10 至 12 月标准尺寸月度仓储费由 $0.78 涨至 $2.40/立方英尺，大件由 $0.56 涨至 $1.40；自 2026 年 4 月 17 日起对履约费（非售价）收取 3.5% 燃油与物流附加费。原文提示以 Seller Central 费率卡与费用预览为准。原文来自该机构，存在相关商业利益，并非独立测评。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T14:51:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:25.111Z","timelineAt","category","policy","tags",[89,90,91],"score",71,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/fc4257f35f00e953.webp","fullUrl","/amznews-reading-preview/_img/fc4257f35f00e953.webp","srcSet","/amznews-reading-preview/_img/fc4257f35f00e953.webp 336w, /amznews-reading-preview/_img/fc4257f35f00e953.webp 720w","width",1600,"height",959,"alt","poster","/amznews-reading-preview/_img/d114105b1ed7dbf7.webp","/amz