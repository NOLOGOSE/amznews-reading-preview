[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":40,"_60":61,"_62":-5,"_63":40,"_64":65},"id","m969p752j30rg7jlecot3a8sw","revision",1,"title","亚马逊 DSP 在 Alexa+ Echo Show 设备推出全屏自动播放视频广告","originalTitle","Full Screen Autoplay Ads on Alexa+","summary","亚马逊广告发布公告称，亚马逊 DSP 广告主可在 Alexa+ Echo Show 设备上投放全屏静音自动播放视频广告，适用美国、德国和英国。原文称现有 15 秒 ABC 视频素材无需新设置即可自动启用；时长不超过 15 秒的视频自动播放，较长视频（最长 120 秒）则以点击播放形式投放。顾客可点击屏幕或向 Alexa 发出语音指令，播放带声音的完整视频并跳转至落地页。原文来自亚马逊广告官方产品更新，存在相关商业利益，并非独立测评。","reason","source",{"_9":94,"_95":96,"_70":97,"_98":61,"_99":100,"_101":102},"links",{"_91":92,"_65":93},"publishedAt","2026-09-30T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-30","discoveredAt","2026-10-22T17:24:11.696Z","timelineAt","category","advertising","tags",[89,90],"score",20,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_52":-5,"_66":67},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊广告",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/22d24461d36d660f.webp","fullUrl","/amznews-reading-preview/_img/22d24461d36d660f.webp","srcSet","/amznews-reading-preview/_img/22d24461d36d660f.webp 336w, /amznews-reading-preview/_img/22d24461d36d660f.webp 720w","width",1306,"height",431,"alt","poster","/amznews-reading-preview/_img/74c169a04a5d49e0.webp","/amznews-reading-preview/_img/74c169a04a5d49e0.webp","/amznews-reading-preview/_img/74c169a04a5d49e0.webp 336w, /am