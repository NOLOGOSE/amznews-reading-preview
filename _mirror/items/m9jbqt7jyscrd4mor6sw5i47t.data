[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","m9jbqt7jyscrd4mor6sw5i47t","revision",3,"title","新品广告在首页却没点击？亚马逊卖家应先看后台流量结构而非前台广告位截图","originalTitle","我通过关键词搜索发现产品的广告明明在首页，为什么就是没人点？","summary","针对新品广告在首页却无点击的问题，原文作者建议卖家不要靠每天搜索关键词看广告位来判断投放效果，因为前台搜索只是受设备、IP、邮编和实时竞价影响的一次快照。作者举例其账户业务报告中移动应用 Sessions 占 77%、浏览器仅 23%，并指出应优先确认关键词对 ASIN 的实际流量贡献及曝光发生的 Placement。人工搜索更适合用于排查广告能否触发、前台展示是否正常和关键词相关性。","reason","source",{"_9":101,"_102":67,"_72":103,"_104":39,"_105":106,"_107":108},"links",{"_98":99,"_65":100},"publishedAt","2026-09-17T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T12:46:21.785Z","timelineAt","category","advertising","tags",[93,94,95,96,97],"score",33,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","十一郎与流氓","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_72":73,"_74":90,"_76":91,"_78":92,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/3b9eed415179a75b.webp","fullUrl","/amznews-reading-preview/_img/3b9eed415179a75b.webp","srcSet","/amznews-reading-preview/_img/3b9eed415179a75b.webp 336w, /amznews-reading-preview/_img/3b9eed415179a75b.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/38604f35fdab325b.we