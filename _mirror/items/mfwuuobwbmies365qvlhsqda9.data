[{"_1":2,"_3":4},"root",{"_5":135},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","mfwuuobwbmies365qvlhsqda9","revision",2,"title","卖家实测亚马逊退货定制分级功能：自定义标准拦截缺件退货当新品","originalTitle","退货缺件还被当作新品发出去？亚马逊这个新功能，终于让卖家自己定规矩了","summary","亚马逊推出“定制分级”（Customized grading）功能，允许卖家在后台设定退货作为新品转售的具体标准。作者实测指出，该功能支持从密封包装、随附配件、设备功能和正品标识四个维度自定义验收规则，例如要求所有配件均须存在或封膜破损不可当新品。","reason","source",{"_9":127,"_128":82,"_90":129,"_130":40,"_131":132,"_133":134},"links",{"_124":125,"_68":126},"publishedAt","2026-10-13T21:01:40.712Z","publishedPrecision","calendar","calendarDate","2026-10-14","discoveredAt","2026-10-14T08:49:26.750Z","timelineAt","category","fba","tags",[120,121,122,123],"score",66,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","嚼不烂的牛肉干","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fCEQWL--4LIE",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","419cfaa6-a612-4626-bc53-a977c19b8439","亚马逊推FBA退货定制分级功能",{"_77":78,"_13":79},"platform","知无不言",{"_90":91,"_92":117,"_94":118,"_96":119,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":114,"_94":115,"_96":116,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":111,"_94":112,"_96":113,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":108,"_94":109,"_96":110,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":105,"_94":106,"_96":107,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":102,"_94":103,"_96":10