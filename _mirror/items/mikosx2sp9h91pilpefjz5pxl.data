[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","mikosx2sp9h91pilpefjz5pxl","revision",2,"title","Adobe 数据显示亚马逊秋季 Prime 大促带动美国线上销售增长 8.5%","originalTitle","How Amazon Fall Prime Day went for sellers","summary","Adobe Analytics 追踪显示，10 月 6 日至 7 日美国零售商线上销售额达 98.6 亿美元，同比增长 8.5%。电子、玩具和视频游戏等品类显著上涨，其中玩具较 9 月日均销量激增 158%。多位亚马逊卖家反馈，今年消费者价格敏感度较高，品牌通过折扣和捆绑套装策略有效提升了客单价与销售表现。","reason","source",{"_9":88,"_89":90,"_91":92,"_93":39,"_94":95,"_96":97},"links",{"_85":86,"_67":87},"publishedAt","2026-10-09T19:30:33.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T20:05:19.097Z","timelineAt","category","advertising","tags",[82,83,84],"score",53,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Gabriela Barkho","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":12,"_74":75},"hasTranslation","bodyLanguage","original","factId","fw5dE6lZaZQs",{"_76":77,"_13":78},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","b2998d5b-b69b-4617-ab2b-3355708454cf","亚马逊2026秋季Prime大促落幕：数据与卖家反馈",{"_76":77,"_13":78},"platform","modern-retail","数据/报告","亚马逊","品类趋势","aihot","/items/mikosx2sp9h91pilpefjz5pxl","https://www.modernretail.co/marketing/how-amazon-fall-prime-day-went-for-sellers/?utm_campaign=modernretaildis&utm_medium=rss&utm_source=general-rss","author-modern-retail-gabriela-barkho","name","modern-retail · Gabriela Barkho","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/feec9bcddc707257.webp","iconSrcSet","/amz