[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","mje02vnm4dy168b0qcjjkw1c9","revision",2,"title","亚马逊红海类目BS1卖家为何难降广告支出：需平衡自然排名与维持成本","originalTitle","都做到BS1，为什么还不能降低广告支出？排名越靠前，越需要维持广告成本和自然排名之间的平衡。","summary","原文作者分析指出，在亚马逊大红海类目中，即使商品详情页（Listing）做到小类第一（BS1），卖家仍需维持高广告成本以稳固自然排名。数据显示核心关键词自然排名第一与第二的日订单量差距可达约1000单，且部分亏损广告因能带来额外自然订单而整体盈利。作者强调，在竞争激烈的红海类目，降低竞价可能导致排名迅速下滑，因此不能仅凭ACOS判断广告价值，需结合自然排名稳定性综合决策。","reason","source",{"_9":134,"_135":82,"_92":136,"_137":40,"_138":139,"_140":141},"links",{"_131":132,"_68":133},"publishedAt","2026-10-15T03:01:39.985Z","publishedPrecision","calendar","calendarDate","2026-10-15","discoveredAt","2026-10-15T03:33:22.181Z","timelineAt","category","advertising","tags",[128,129,130],"score",26,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89,90,91],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","阿浩的广告复盘","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","foIEFAptTQpc",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","8988c4a0-0d0e-4b38-a55c-7cf6df48c776","亚马逊红海类目BS1卖家为何难降广告支出",{"_77":78,"_13":79},"platform","知无不言",{"_92":93,"_94":125,"_96":126,"_98":127,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":122,"_96":123,"_98":124,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":119,"_96":120,"_98":121,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":116,"_96":117,"_98":118,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":