[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":40,"_60":61,"_62":-5,"_63":40,"_64":65},"id","mjwkvm4gyqr04d7dxdtxa2lc5","revision",1,"title","亚马逊AI广告平台推出智能体式媒体策划功能，支持自然语言预估受众与触达","originalTitle","Size audiences and forecast reach with agentic media planning","summary","亚马逊广告官方产品更新公告称，亚马逊AI广告平台已在对话式体验中面向全球开放“智能体式媒体策划”封闭测试，允许用户通过自然语言提示词预估受众规模、预测触达量并获取预算分配建议。原文称该功能有助于将媒体策划周期从数小时缩短至数分钟，但未提供可独立核验的统计依据，本站尚未独立验证该效果。该功能目前仅对选择广告主、广告代理商及参与封闭测试的企业客户开放，需联系亚马逊广告代表申请加入。原文来自亚马逊广告，存在相关商业利益，并非独立测评。","reason","source",{"_9":89,"_90":91,"_69":92,"_93":61,"_94":95,"_96":97},"links",{"_86":87,"_65":88},"publishedAt","2026-09-28T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-28","discoveredAt","2026-10-22T17:24:11.696Z","timelineAt","category","advertising","tags",[83,84,85],"score",36,"selected",false,"channel","news","story","x","media",[68],"byline",{"_52":-5,"_66":67},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊广告",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/3fb4f7de1cd7610e.webp","fullUrl","/amznews-reading-preview/_img/3fb4f7de1cd7610e.webp","srcSet","/amznews-reading-preview/_img/3fb4f7de1cd7610e.webp 336w, /amznews-reading-preview/_img/3fb4f7de1cd7610e.webp 720w","width",876,"height",1772,"alt","poster","广告/运营","AI工具","亚马逊","aihot","/items/mjwkvm4gyqr04d7dxdtxa2lc5","https://advertising.amazon.com/resources/whats-new/agentic-media-planning/","official-amazon-ads-whats-new","name","亚马逊广告 · 产品更新","json_list","firstParty","iconUrl"