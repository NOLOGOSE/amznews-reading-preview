[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","mm01j733gtq5lq30van8wxejv","revision",2,"title","Google AI Mode 购物广告与结账：Merchant Center 操作要点","originalTitle","Selling in Google AI Mode: Checkout, Shopping Ads and Merchant Center","summary","原文来自 SellerElevate，该机构在文末推广其免费账户审计与 Google Ads 管理服务，存在相关商业利益，并非独立测评。原文称：Shopping 广告自 2026 年 2 月 11 日起出现在 Google AI Mode，标注为赞助，由已连接 Merchant Center 的现有 Shopping 和 Performance Max 广告系列投放，无需单独选择加入；AI Mode 内的结账基于 Google 的通用商务协议（UCP），仅限美国，面向符合资格并被选中的商家，需在 Merchant Center 商品 Feed 中添加 native_commerce 属性并提交意向表，商家仍为记录卖家，退货与客户关系归商家，付款通过 Google Pay，支付服务商需支持 Google Pay token。原文提醒部分功能仍标注为早期访问，行动前应在 Merchant Center 和 Google Ads 中确认日期与资格。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T19:41:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:23.230Z","timelineAt","category","advertising","tags",[89,90,91],"score",42,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/0343aea9ecd93c85.webp","fullUrl","/amznews-reading-preview/_img/0343aea9ecd93c85.webp","srcSet","/amznews-reading-preview/_img/0343aea9ecd93c85.webp 336w, /am