[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":64,"_65":40,"_66":67},"id","mm5wjwfh09k3p253mou59k1z5","revision",4,"title","美国CPSC召回Romorgniz六斗柜，因违反STURDY Act存在倾倒风险","originalTitle","Romorgniz Recalls Six-Drawer Dressers Due to Risk of Serious Injury or Death from Tip-Over and Entrapment Hazards; Violate Mandatory Standard for Clothing Storage Units","summary","美国消费品安全委员会（CPSC）于2026年10月8日召回约12,078件Romorgniz六斗柜，因其未固定时存在导致儿童严重受伤或死亡的倾倒及被困风险，且违反STURDY Act强制安全标准。该木质斗柜在Amazon.com以100至170美元售价销售，消费者应立即停用并联系厂商获取全额退款后自行处置。","reason","source",{"_9":87,"_88":81,"_89":90,"_91":62,"_92":93,"_94":95},"links",{"_84":85,"_67":86},"publishedAt","2026-10-08T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-08","discoveredAt","2026-10-08T20:49:57.080Z","timelineAt","category","policy","tags",[82,83],"score",34,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_53":-5,"_80":81},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_43":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fT9oQw3wDajM",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","5c55d413-4e6c-40e3-b902-10033905b8d2","Romorgniz召回在亚马逊销售的六斗柜",{"_76":77,"_13":78},"platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","aihot","/items/mm5wjwfh09k3p253mou59k1z5","https://www.cpsc.gov/Recalls/2027/Romorgniz-Recalls-Six-Drawer-Dressers-Due-to-Risk-of-Serious-Injury-or-Death-from-Tip-Over-and-Entrapment-Hazards-Violate-Mandatory-Standard-for-Clothing-Storage-Units","official-cpsc-amazon-recalls-reviewed","name","kind","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp","iconSrcSet","/amznews-reading-preview/_img/382881c3aef48a1a.webp 48w, /amznews-reading-preview/_img/382881c3aef48a1a.webp 96w",{"_97":98},"changelogVersion","2026-10-09T22:08"]
