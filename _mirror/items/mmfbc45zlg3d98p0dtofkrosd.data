[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","mmfbc45zlg3d98p0dtofkrosd","revision",4,"title","Bogg 推出 Go Tote 拓展通勤与旅行场景","originalTitle","Why Bogg is moving beyond its signature EVA beach bag","summary","Bogg 本月推出新品 Go Tote，旨在从海滩包拓展至通勤、运动及旅行市场。该系列提供三种尺寸（售价 $90-$150），具备拉链封口、笔记本电脑隔层及 EVA 泡沫底，由创始人 Kim Vaccarella 称基于客户反馈开发。尽管受关税影响去年损失近 $10 million，Bogg 仍保持原价并计划通过优化 GEO 描述及线下推广提升 AI 引擎可见度。","reason","source",{"_9":88,"_89":90,"_91":92,"_93":39,"_94":95,"_96":97},"links",{"_85":86,"_67":87},"publishedAt","2026-10-15T10:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-15T10:27:31.219Z","timelineAt","category","product","tags",[82,83,84],"score",17,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Julia Waldow","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fWsCycuC_22g",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","aa463e52-532f-4cd4-a765-b53e5a8d18d9","Bogg推出Go Tote拓展通勤旅行场景",{"_76":77,"_13":78},"platform","modern-retail","选品/市场","品类趋势","品牌","aihot","/items/mmfbc45zlg3d98p0dtofkrosd","https://www.modernretail.co/operations/why-bogg-is-moving-away-from-its-signature-eva-beach-bag/?utm_campaign=modernretaildis&utm_medium=rss&utm_source=general-rss","author-modern-retail-juliawaldow","name","modern-retail · Julia Waldow","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/feec9bcddc707257.w