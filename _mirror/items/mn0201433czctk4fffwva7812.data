[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","mn0201433czctk4fffwva7812","revision",1,"title","美国消费品安全委员会撤回关于婴儿弹跳椅和固定活动中心的过时规则","originalTitle","Revocation of Obsolete Rules Regarding Infant Bouncer Seats and Stationary Activity Centers","summary","美国消费品安全委员会（CPSC）于2026年9月17日撤回一项直接最终规则，该规则原计划删除关于婴儿弹跳椅和固定活动中心的过时规定。因收到重大反对意见，CPSC决定撤销此前于2026年7月22日发布的拟议删除动作，相关旧规则继续有效。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":61,"_79":80,"_81":82},"links",{"_70":71,"_65":72},"publishedAt","2026-09-17T04:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:13:48.727Z","timelineAt","category","policy","tags",[68,69],"score",15,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_66":67},"detailedGuide","readingMode","full","author","Consumer Product Safety Commission","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","aihot","/items/mn0201433czctk4fffwva7812","https://www.federalregister.gov/documents/2026/09/17/2026-19065/revocation-of-obsolete-rules-regarding-infant-bouncer-seats-and-stationary-activity-centers","official-cpsc-federal-register","name","CPSC 美国消费品安全委员会 · 联邦公报","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/fb25db0934701e45.webp","iconSrcSet","/amznews-reading-preview/_img/fb25db0934701e45.webp 48w, /amznews-reading-preview/_img/fb25db0934701e45.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
