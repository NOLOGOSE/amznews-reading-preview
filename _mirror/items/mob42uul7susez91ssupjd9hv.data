[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","mob42uul7susez91ssupjd9hv","revision",2,"title","广告ACOS爆表时，如何通过卡位瀑布流控制成本？","originalTitle","summary","广告ACOS爆表时，可用\"低基础竞价+高位置溢价（BID%）\"把预算锁定在搜索结果顶部（TOS），规避转化率低的商品页面（PP）流量。实操上以系统建议竞价向下按0.05美金阶梯设多组广告，每组配10-20次点击预算，表现好的加预算、差的降竞价。调整需留7-14天观察周期，秒杀（BD/LD）期间转化率提升，是大词卡位的黄金期。","reason","source",{"_9":75,"_76":66,"_77":78,"_79":38,"_80":81,"_82":83},"links",{"_72":73,"_64":74},"publishedAt","2026-06-04T08:42:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T17:46:53.777Z","timelineAt","category","advertising","tags",[67,68,69,70,71],"score",46,"selected",false,"channel","news","story","x","media",[],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","Mechael","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","广告/运营","广告投放","关键词","Listing优化","亚马逊","aihot","/items/mob42uul7susez91ssupjd9hv","https://wearesellers.com/question/120634","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
