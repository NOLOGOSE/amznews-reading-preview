[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","mpl8heh5b1b85h9vl130cdvg3","revision",2,"title","亚马逊套利与批发模式对比","originalTitle","Arbitrage sucks. Wholesale sucks. You hear it all. I did both and here is my honest take.","summary","套利很烂。批发也很烂。你总听到这种说法。我两者都做过，以下是我的真实看法。\n\n套利在两点上胜出。你可以用几百美元起步，且利润率更高。我的批发平均利润率约为15%。\n\n批发在风险、规模、持续时间以及能否出售业务方面胜出。\n\n我根据你的情况，按类别对两者进行了评分。评论 SCORECARD，我会发给你。","reason","source",{"_9":99,"_100":101,"_102":103,"_104":39,"_105":-5},"links",{"_96":97,"_68":98},"publishedAt","2026-10-18T15:04:13.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-18T15:04:22.822Z","timelineAt","category","product","tags",[94,95],"score",18,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","1000asins","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fp2dov5-R5u0",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","da1d5f65-0903-40b5-84b1-e14d152cfeea","亚马逊卖家顾问对比套利与批发模式",{"_77":78,"_13":79},"zh","<p>Arbitrage sucks. Wholesale sucks. You hear it all. I did both and here is my honest take.</p><p>Arbitrage wins on two things. You can start with a few hundred dollars, and the margins are higher. My wholesale average is about 15%.</p><p>Wholesale wins on risk, scale, how long it lasts, and whether you can ever sell the business.</p><p>I scored both, category by category, based on your situation. Comment SCORECARD and I'll send it over.</p>","zhKind","complete","authorName","Dan Boufford","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"选品/市场","多平台销售","aihot","/items/mpl8heh5b1b85h9vl130cdvg3","https://x.com/1000asins/status/2111835748290682948","x-dan-boufford","name","X · Dan Boufford","kind","x_search","firstParty","iconUrl",{"_107":108},"changelogVersion","2026-10-09T22:08"]
