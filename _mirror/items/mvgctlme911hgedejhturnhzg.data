[{"_1":2,"_3":4},"root",{"_5":123},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","mvgctlme911hgedejhturnhzg","revision",2,"title","亚马逊群发“NWD品牌移除”通知系系统误发，持有品牌代表角色卖家可忽略","originalTitle","虚惊一场！亚马逊群发“NWD品牌移除”通知!!","summary","亚马逊向部分卖家群发“无批发分销（NWD）”计划下的商品移除通知，经客服核实该消息为系统自动发送，适用于所有关联卖家。若账户持有品牌代表角色，则不会面临停用风险，可直接忽略；非品牌代表需尽快获取授权，否则2026年10月27日后库存将被移除。","reason","source",{"_9":114,"_115":116,"_87":117,"_118":40,"_119":120,"_121":122},"links",{"_111":112,"_68":113},"publishedAt","2026-10-20T18:39:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-21T09:41:08.911Z","timelineAt","category","policy","tags",[108,109,110],"score",40,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跟着阿杜学跨境电商","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":73},"hasTranslation","bodyLanguage","original","factId","fSPgbeXwcDN4",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","dbf445cd-5ab4-4c48-9b75-67dad0c62a93","亚马逊NWD限售通知引发卖家下架与库存担忧",{"_77":78,"_13":79},"platform","AMZ123",{"_87":88,"_89":105,"_91":106,"_93":107,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":102,"_91":103,"_93":104,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":99,"_91":100,"_93":101,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5,"_97":-5,"_98":-5},"kind","image","url","/amznews-reading-preview/_img/46a860fea84c43ad.webp","fullUrl","/amznews-reading-preview/_img/46a860fea84c43ad.webp