[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","mvhc19llydg9hie3wt36tcmmk","revision",3,"title","亚马逊卖家需在 Q4 前审计 FBA 费用：关注燃油附加费与假日高峰费率","originalTitle","The Hidden Fees Still Eating Your October Margin","summary","原文来自 SellerPulse 所属机构，存在相关商业利益，并非独立测评。文章建议亚马逊卖家在 Q4 前按 SKU 审计 FBA 费用，关注履约费、假日高峰履约费、入库放置费、月度仓储与长期库存费、退货处理费、移除与弃置费等类别。文中提到亚马逊自 2026 年 4 月 17 日起对 FBA 履约费加收 3.5% 燃油与物流相关附加费，2026 年假日高峰履约费适用期为 2026 年 10 月 15 日至 2027 年 1 月 14 日，并称附加费同样适用于高峰费率；还称 2026 年部分标准尺寸产品在特定运输配置下入库放置费平均每单位增加 $0.05。上述费率与金额均引自原文，本站尚未独立核验。文章提出的五步审计流程（识别高销量 SKU、对比近期费用变化、重算 SKU 真实利润、排查异常项、先修正经济模型再放量）属于作者建议，适用条件与例外因卖家产品、库存与履约策略而异。","reason","source",{"_9":108,"_109":81,"_84":110,"_111":39,"_112":113,"_114":115},"links",{"_105":106,"_67":107},"publishedAt","2026-10-09T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T23:35:17.805Z","timelineAt","category","fba","tags",[103,104],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Bob Norberg","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fJtEtHRSLn10",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","b0181d64-a06a-4ce5-8781-b22fd7b0dee7","亚马逊美国站2026年旺季配送费调整",{"_76":77,"_13":78},"platform","eComEngine",{"_84":85,"_86":98,"_88":99,"_90":100,"_92":101,"_94":102,"_96":-5,"_97":-5},{"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":95,"_96":-5,"_97":-5},"kind","image","ur