[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","mx3zr7p2g3i84tk2uxjoh3h2h","revision",2,"title","卖家分享用 AMC 与 NTB 率搭建广告决策流程的经验","originalTitle","我们用 AMC 做广告决策，比同行少浪费 40% 的测词预算","summary","原文作者以“奋斗的青年”署名，分享其团队将亚马逊营销云（AMC）从报告工具转为广告决策流程的经验：引入品牌新客转化率（NTB 率）辅助判断，并区分每周/每两周的止损模式与每月的战略模式，止损以盈亏平衡点为锚点、战略基于 30 天数据做五维分析。作者称其将流程做成了可直接使用的 skill，原文来自该团队，存在相关商业利益，并非独立测评；文中“比同行少浪费 40% 测词预算”等效果与对比数字无原文支持，已删除。","reason","source",{"_9":89,"_90":80,"_91":92,"_93":39,"_94":95,"_96":97},"links",{"_86":87,"_67":88},"publishedAt","2026-10-16T07:01:30.823Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T07:11:30.233Z","timelineAt","category","advertising","tags",[81,82,83,84,85],"score",42,"selected",false,"channel","news","story",{"_76":77,"_13":14},"x","media",[],"byline",{"_52":53,"_79":80},"detailedGuide","readingMode","full","author","奋斗的青年","language","body","outline",[],"relatedStories",[78],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","f2LRHxQnctDA",{"_76":77,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","9a7c32a5-a758-4497-a32c-372b05c8acb5",{"_76":77,"_13":14},"platform","知无不言","广告/运营","广告投放","关键词","卖家工具","亚马逊","aihot","/items/mx3zr7p2g3i84tk2uxjoh3h2h","https://www.wearesellers.com/question/125515","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_99":100},"changelogVe