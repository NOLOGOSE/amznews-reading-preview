[{"_1":2,"_3":4},"root",{"_5":129},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","mxgpg2pyp5bza9py6hnvbts4l","revision",3,"title","5套提示词，用WorkBuddy跑出亚马逊竞品精准狙击最佳实践（附教程/资料包）","originalTitle","summary","AI+跨境电商卖家Bulus lan（原文署名buluslan）分享了一套用WorkBuddy搭配卖家精灵MCP跑亚马逊竞品追踪的五步法：从自有ASIN反查流量词圈出候选池、按流量重叠度聚合筛选、用视觉模型区分同形态与跨形态竞品、对Listing打分锁定对标对象，最后深拆文案、视觉、评论与市场动作四个板块。他以美区站点一个自动卷发棒产品为例演示全流程，并自述最终圈出一款熊脸自动卷发棒作为直接对标竞品；该结论来自作者自述的工具演示，本站尚未独立核验。原文强调不能完全交给AI视觉模型判读、建议人工做二次校对，完整提示词需通过原文提供的飞书链接另行领取。原文推广WorkBuddy+卖家精灵MCP组合并引导领取资料包，存在相关商业利益，并非独立测评。","reason","source",{"_9":121,"_122":66,"_76":123,"_124":38,"_125":126,"_127":128},"links",{"_118":119,"_64":120},"publishedAt","2026-09-10T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T13:47:11.443Z","timelineAt","category","ai-tools","tags",[112,113,114,115,116,117],"score",27,"selected",false,"channel","news","story","x","media",[67,68,69,70,71,72,73,74,75],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","buluslan","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_76":77,"_78":109,"_80":110,"_82":111,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":106,"_80":107,"_82":108,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":103,"_80":104,"_82":105,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":100,"_80":101,"_82":102,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":97,"_80":98,"_82":99,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":94,"_80":95,"_82":96,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":91,"_80":92,"_82":93,"_84":-5,"_85":-5,"_86