[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","mxo533l4xnmgzjh0pgv0u73uy","revision",4,"title","亚马逊美国站保险新规：部分商品月销不足1万美元也须投保","originalTitle","亚马逊保险新规月销不到1万美元，也要提前查","summary","2026年11月2日起，亚马逊美国站具有增强安全Listing要求的商品不论月销是否超过1万美元都须投保商业责任保险，新老Listing均适用，公告举例包括儿童商品、化妆品及可摄入类商品、锂电池商品。同日起来自中国大陆卖家新提交的保单须通过亚马逊保险加速器计划（AIA）取得，否则会被拒绝；11月2日前已提交且有效的第三方保单可用至到期，到期后须走AIA渠道。","reason","source",{"_9":101,"_102":103,"_72":104,"_105":39,"_106":107,"_108":109},"links",{"_98":99,"_65":100},"publishedAt","2026-09-09T22:21:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T09:35:30.026Z","timelineAt","category","policy","tags",[94,95,96,97],"score",71,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","VIPON站外促销平台","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_72":73,"_74":90,"_76":91,"_78":92,"_80":93,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/2777e61529379f19.webp","fullUrl","/amznews-reading-preview/_img/2777e61529379f19.webp","srcSet","/amznews-reading-preview/_img/2777e61529379f19.webp 336w, /amznews-reading-preview/_img/2777e61529379f19.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/e77f6a33e66e9b21.webp","/amznews-reading-preview/_