[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","mxvyax7w6kz5snoroke671us1","revision",5,"title","2023年多家跨境大卖发布业绩快报或预告：道通科技、致欧科技、赛维时代、易佰网络数据盘点","originalTitle","2023年多家跨境大卖实现利润暴涨！","summary","原文盘点道通科技、致欧科技、赛维时代、易佰网络等跨境大卖2023年度业绩数据。其中道通科技发布的是《2023年度业绩快报》，营业收入32.51亿元、归属于母公司所有者的净利润1.83亿元；致欧科技、赛维时代、华凯易佰（易佰网络）发布的是业绩预告，相关营收和净利润为预计区间。原文另提及安克创新尚未发布2023年财报，仅引用其2023年三季度报告数据。","reason","source",{"_9":101,"_102":103,"_72":104,"_105":39,"_106":107,"_108":109},"links",{"_98":99,"_65":100},"publishedAt","2024-02-29T17:22:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T20:09:32.535Z","timelineAt","category","product","tags",[93,94,95,96,97],"score",38,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","船长BI","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_72":73,"_74":90,"_76":91,"_78":92,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/859f7f9e8a8d82fc.webp","fullUrl","/amznews-reading-preview/_img/859f7f9e8a8d82fc.webp","srcSet","/amznews-reading-preview/_img/859f7f9e8a8d82fc.webp 336w, /amznews-reading-preview/_img/859f7f9e8a8d82fc.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/7b9ef80b371e5f34.webp","/amznews-reading-pre