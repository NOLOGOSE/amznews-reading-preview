[{"_1":2,"_3":4},"root",{"_5":132},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","n10luis1w9v00r9vy891ivae0","revision",2,"title","便携式宠物拉杆箱因缺“钩环搭扣”初步判定不侵犯美国发明专利","originalTitle","热销品类#便携式宠物拉杆箱 是否构成发明侵权，零件“钩环搭扣”是关键","summary","AMZ123分析指出，亚马逊美国站热销的便携式宠物拉杆箱因未设置专利核心特征“钩环搭扣”，初步判定不构成对该项美国发明专利的侵权。该专利保护一种可折叠、带旋转提手及特定固定结构的宠物运输箱组合，样品外观显示其缺少关键扣合部件且折叠宽度不明，故未落入权利要求保护范围。","reason","source",{"_9":123,"_124":125,"_89":126,"_127":40,"_128":129,"_130":131},"links",{"_120":121,"_68":122},"publishedAt","2026-10-22T05:56:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-23T02:12:30.778Z","timelineAt","category","policy","tags",[116,117,118,119],"score",38,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","案说跨境知识产权","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f_NNfFHIUBNM",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","f48e584a-ca61-4f60-9601-40abcb33f015","便携式宠物拉杆箱专利侵权初判分析",{"_77":78,"_13":79},"platform","AMZ123",{"_89":90,"_91":113,"_93":114,"_95":115,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":110,"_93":111,"_95":112,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":107,"_93":108,"_95":109,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":104,"_93":105,"_95":106,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":101,"_93":102,"_95":103,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":92,"_93":94,"_