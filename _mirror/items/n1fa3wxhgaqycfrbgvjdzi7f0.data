[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","n1fa3wxhgaqycfrbgvjdzi7f0","revision",1,"title","低ACOS未必代表PPC表现良好","originalTitle","A low ACOS is not automatically good PPC.","summary","低 ACOS 并不自动意味着 PPC 表现良好。\n\n你可以通过竞价品牌词、削减发现型流量并放弃所有昂贵的通用关键词来获得漂亮的 ACOS。\n\n恭喜，仪表盘显示绿色。\n\n但你也可能停止了增长。","reason","source",{"_9":85,"_86":87,"_88":89,"_90":39,"_91":-5},"links",{"_82":83,"_66":84},"publishedAt","2026-10-13T18:15:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.600Z","timelineAt","category","advertising","tags",[80,81],"score",22,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Evan_Swanson_","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>A low ACOS is not automatically good PPC.</p><p>You can get a beautiful ACOS by bidding on branded terms, cutting discovery and starving every expensive generic keyword.</p><p>Congrats, the dashboard is green.</p><p>You may also have stopped growing.</p>","zhKind","complete","authorName","Evan Swanson","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"广告/运营","亚马逊","aihot","/items/n1fa3wxhgaqycfrbgvjdzi7f0","https://x.com/Evan_Swanson_/status/2110071822624624875","x-evan-swanson","name","X · Evan Swanson","kind","x_search","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
