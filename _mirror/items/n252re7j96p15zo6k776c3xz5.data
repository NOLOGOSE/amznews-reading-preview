[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":64,"_65":40,"_66":67},"id","n252re7j96p15zo6k776c3xz5","revision",2,"title","Papablic 召回可转换床边婴儿床，因存在窒息及跌落风险","originalTitle","Papablic, of USA Recalls Convertible Bedside Sleepers Due to Risk of Serious Injury or Death from Entrapment, Suffocation and Fall Hazards; Violate Mandatory Standard for Play Yards","summary","Papablic 于 2026 年 10 月 15 日召回约 248 件 PAPA03001AI 型号可转换床边婴儿床，因床垫移位可能导致婴儿窒息，且锁定机制失效可能引发严重伤害或死亡。该产品违反游戏围栏强制安全标准，消费者应立即停用并联系品牌方获取全额退款。","reason","source",{"_9":87,"_88":81,"_89":90,"_91":62,"_92":93,"_94":95},"links",{"_84":85,"_67":86},"publishedAt","2026-10-15T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-15","discoveredAt","2026-10-15T16:24:40.988Z","timelineAt","category","policy","tags",[82,83],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_53":-5,"_80":81},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_43":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fAwsCP9BMqIY",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","cec585b3-5da7-46d2-a3ea-d07f56ffafaa","Papablic召回在亚马逊销售的婴儿床边睡篮",{"_76":77,"_13":78},"platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","aihot","/items/n252re7j96p15zo6k776c3xz5","https://cpsc.gov/Recalls/2027/Papablic-of-USA-Recalls-Convertible-Bedside-Sleepers-Due-to-Risk-of-Serious-Injury-or-Death-from-Entrapment-Suffocation-and-Fall-Hazards-Violate-Mandatory-Standard-for-Play-Yards","official-cpsc-amazon-recalls-reviewed","n