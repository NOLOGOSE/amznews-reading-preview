[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","n35lttgcxwc11yozm34if346k","revision",3,"title","自然位排名还在手动查？分享一套用西柚MCP和飞书机器人自动监控关键词排名的流程","originalTitle","自然位排名还在手动查？分享一套自动化流程。","summary","原文作者分享了一套自动化流程：用西柚（XY）的MCP获取关键词监控数据，机器人每小时自动整理自然位和广告位排名并发送到飞书群，无需再手动打开亚马逊前台查询。作者还在此基础上增加了每日链接状态监控（大类/小类排名、评分、评价数对比）和运营日报机器人，可自动记录销量、销售额、流量、转化率、广告花费、ACOS等指标并对比昨日与前7天数据，库存按日均销量计算可售天数并在预警时提醒。","reason","source",{"_9":120,"_121":67,"_77":122,"_123":39,"_124":125,"_126":127},"links",{"_117":118,"_65":119},"publishedAt","2026-09-15T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T13:47:11.443Z","timelineAt","category","ai-tools","tags",[113,114,115,116],"score",33,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","阿浩的广告复盘","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_77":78,"_79":110,"_81":111,"_83":112,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":107,"_81":108,"_83":109,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":104,"_81":105,"_83":106,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":98,"_81":99,"_83":100,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":95,"_81":96,"_83":97,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":92,"_81":93,"_83":94,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":80,"_81":82,"_83"