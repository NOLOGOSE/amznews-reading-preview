[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","n47qwkrftmeqj1owkh1snz6di","revision",6,"title","产品生命周期与广告：区分目标，谨慎使用历史模板","originalTitle","How Product Lifecycles Affect PPC Strategy","summary","Vince Montero在2021年5月12日讨论新品、扩张和清货阶段的广告目标差异：分别关注信息收集、广告效率及库存处置，再结合费用与可承受支出评估。Launch/Scale/Liquidate是厂商模板，80%/70%预算、15条评论、2–4周及默认30%ACoS属于历史建议或工具设置，不是平台标准或收益保证。来源有软件推广利益；本站不建议仅按评论数切换阶段或不顾利润追求曝光。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2021-05-12T13:50:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-02T03:03:08.370Z","timelineAt","category","advertising","tags",[89,90,91],"score",27,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Vince Montero","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Helium 10",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/e3525907a9efdf48.webp","fullUrl","/amznews-reading-preview/_img/e3525907a9efdf48.webp","srcSet","/amznews-reading-preview/_img/e3525907a9efdf48.webp 336w, /amznews-reading-preview/_img/e3525907a9efdf48.webp 720w","width",390,"height",286,"alt","poster","/amznews-reading-preview/_img/5d21efdbc6651c66.webp","/amznews-reading-preview/_img/5d21efdbc6651c66.webp","/amznews-reading-preview/_img/5d21efdbc6651c66.webp 336w, /amznews-reading-preview/_img