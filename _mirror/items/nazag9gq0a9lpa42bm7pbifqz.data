[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","nazag9gq0a9lpa42bm7pbifqz","revision",5,"title","亚马逊合伙创业散伙案例：MoonSees建议提前明确6项关键规则","originalTitle","两个朋友合伙做亚马逊，公司赚钱了却闹到散伙：合伙前这6件事一定要提前讲清楚","summary","MoonSees通过老A与廖哥因采购价、决策权及资产归属分歧导致公司盈利却散伙的案例，建议亚马逊合伙人在创业前明确工资计算、关联采购定价、经营权限划分、利润分配条件、店铺数据资产归属及退出机制这6件事。作者指出运营能力不等于公司经营能力，强调需在关系良好时签署协议以规避后期利益纠纷，文中观点仅为个人经验分享，不构成法律或投资建议。","reason","source",{"_9":88,"_89":90,"_91":92,"_93":40,"_94":95,"_96":97},"links",{"_85":86,"_68":87},"publishedAt","2026-10-07T20:34:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-08","discoveredAt","2026-10-09T02:47:31.764Z","timelineAt","category","policy","tags",[83,84],"score",27,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境电商MoonSees","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f50G9ZPggTiY",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","b76938a3-1756-4fde-be2e-5e9a9c3256a6","亚马逊合伙创业散伙案例：运营与供应链股东因利益分配、决策权及资产归属分歧导致合作破裂",{"_77":78,"_13":79},"platform","AMZ123","政策/合规","其他","aihot","/items/nazag9gq0a9lpa42bm7pbifqz","https://www.amz123.com/t/mobc4Dhr","author-amz123-moonsees-reviewed","name","AMZ123 · 跨境电商MoonSees","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_99":100}