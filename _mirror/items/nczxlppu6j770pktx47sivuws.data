[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","nczxlppu6j770pktx47sivuws","revision",2,"title","韩国公平交易委员会发布指引要求电商简化退订并严查暗黑模式","originalTitle","韩国要求电商简化退订流程，严查误导性页面设计","summary","韩国公平交易委员会（FTC）近日发布监管指引，要求电商平台和订阅服务商减少“暗黑模式”设计，简化取消订阅流程并禁止未经同意的自动添加商品。该指引虽不具法律约束力，但整合了此前指导并提供详细案例，企业若违反《电商消费者保护法》仍可能面临监管调查或执法行动。","reason","source",{"_9":101,"_102":103,"_84":104,"_105":40,"_106":107,"_108":109},"links",{"_98":99,"_68":100},"publishedAt","2026-10-19T01:09:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-19T09:43:35.850Z","timelineAt","category","policy","tags",[96,97],"score",38,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","日韩电商资讯","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fSXCQNb0GHXQ",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","ac6f7e8e-1aee-4598-a715-7cfbe3539785","韩国FTC发布指引规范电商退订与暗黑模式",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/77f95b08bbba6c38.webp","fullUrl","/amznews-reading-preview/_img/77f95b08bbba6c38.webp","srcSet","/amznews-reading-preview/_img/77f95b08bbba6c38.webp 336w, /amznews-reading-preview/_img/77f95b08bbba6c38.webp 720w","width","height","alt","poster","政策/合规","亚马逊","aihot","/items/nczxlppu6j770pktx47sivuws","https://www.amz123.com/t/7JDNPwfa",