[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","ng472os1khbifmrvea6pc9ags","revision",2,"title","Klaviyo 2026 电商邮件基准：活动平均打开率 31%、点击率 1.69%，自动化流程点击率 5.58%","originalTitle","What Is a Good Email Open and Click Rate in 2026? Klaviyo’s Data","summary","原文来自 SellerElevate，该机构销售自有账户管理与审计服务，存在相关商业利益，并非独立测评。文章引用 Klaviyo 2026 邮件营销基准，称活动平均打开率为 31%、点击率 1.69%，自动化流程平均点击率为 5.58%；这些为平台平均值，并非受控测试，本站尚未独立核验该引用。作者指出 Apple Mail Privacy Protection 可能使打开率虚高，且 Klaviyo 基准页未说明如何处理机器打开，因此建议以点击率和每位收件人收入（RPR）为主要判断指标，并将流程与活动分开比较。","reason","source",{"_9":109,"_110":111,"_84":112,"_113":39,"_114":115,"_116":117},"links",{"_106":107,"_67":108},"publishedAt","2026-10-19T04:24:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T04:49:38.399Z","timelineAt","category","advertising","tags",[103,104,105],"score",42,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fmviugCRj-7g",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","62aa033f-d9e0-4985-ae41-5cd6dca81d59","Klaviyo 2026 邮件基准：活动打开率 31%、点击率 1.69%",{"_76":77,"_13":78},"platform","SellerElevate",{"_84":85,"_86":98,"_88":99,"_90":100,"_92":101,"_94":102,"_96":-5,"_97":-5},{"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":95,"_96":-5,"_97":-5},"kind","image","url","/amznews-reading-preview/_img/aaccab2b02cf87a2.web