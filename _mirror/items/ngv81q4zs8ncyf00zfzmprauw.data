[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","ngv81q4zs8ncyf00zfzmprauw","revision",2,"title","ASGTG社区讨论亚马逊向卖家发送合规通知","originalTitle","FYI: Amazon safety requests are reportedly reaching established resellers, too.","summary","亚马逊卖家社区 ASGTG 转发讨论称，亚马逊近期向部分卖家发送了合规相关通知。该信息源自社区用户反馈，具体涉及的通知类型、触发条件及官方回应细节在原文中未明确说明。","reason","source",{"_9":99,"_100":101,"_102":103,"_104":39,"_105":-5},"links",{"_96":97,"_68":98},"publishedAt","2026-10-16T01:41:12.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:42:17.917Z","timelineAt","category","policy","tags",[94,95],"score",58,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","AmazonASGTG","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","frPsXk-kWhBM",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","f3f47f6b-65ce-4c53-83c7-3117e1117c7e","ASGTG社区称亚马逊向老卖家发安全请求",{"_77":78,"_13":79},"zh","<p>FYI: Amazon safety requests are reportedly reaching established resellers, too.</p><p>A seller tells ASGTG that Aurora resellers have received more than 200 safety requests involving stock products. Some requests appear to be duplicated across sellers, and the seller says Amazon explained that the process helps determine who is legitimate.</p><p>These requests could also affect bundles, where a product’s documentation may be requested across multiple listings. Sellers are asking whether invoices and letters of authorization can establish legitimate sourcing—and whether safety testing could be handled centrally at the brand level.</p><p>This is a report from sellers, not a confirmed Amazon-wide policy announcement. If you’re receiving similar requests, let us know what products are affected and what documentation Amazon is asking you to provide.</p>","zhKind","complete","authorName","Amazon Sellers ASGTG","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"行业动态","亚马逊","aihot","/items/ngv81q4zs8ncyf00zfzmprauw","https://x.com/AmazonASGTG/status/2110908889604428142","x-amazon-asgtg","name","X · ASGTG","kind","x_search","firstParty","iconUrl",{"_107":108},"changelogVersion","2026-10-09T22:08"]
