[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":40,"_60":40,"_61":-5,"_62":63,"_64":65},"id","nh8bxs4e30n8m1xnmthamza4f","revision",1,"title","亚马逊封禁 Meta AI 智能体 Muse 访问购物功能，Shopify 选择合作接入支付体系","originalTitle","亚马逊紧急封禁，Meta新上线的AI产品，有多“危险”？","summary","蓝海亿观网报道，Meta 新上线的 AI 智能体 Muse 因表现强劲引发关注，亚马逊于 9 月 20 日阻止其代替用户购物，理由是未获授权、未表明 AI 身份及存在隐私安全风险；而 Shopify 则主动开放商品库数据并将 Shop Pay 接入 Muse 支付体系。","reason","原文对比了亚马逊封禁与 Shopify 拥抱 Meta AI 智能体 Muse 的不同策略，并分析了背后的商业模式差异。","source",{"_9":106,"_107":108,"_72":109,"_110":63,"_111":112,"_113":114},"links",{"_103":104,"_65":105},"publishedAt","2026-10-09T07:04:19.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:54.096Z","timelineAt","category","ai-tools","tags",[100,101,102],"score",62,"selected",true,"channel","news","story","x","media",[68,69,70,71],"byline",{"_52":-5,"_66":67},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","蓝海亿观网",{"_72":73,"_74":95,"_76":96,"_78":97,"_80":98,"_82":99,"_84":-5,"_85":-5},{"_72":73,"_74":90,"_76":91,"_78":92,"_80":93,"_82":94,"_84":-5,"_85":-5},{"_72":73,"_74":86,"_76":87,"_78":88,"_80":81,"_82":89,"_84":-5,"_85":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/5b49d860695469db.webp","fullUrl","/amznews-reading-preview/_img/5b49d860695469db.webp","srcSet","/amznews-reading-preview/_img/5b49d860695469db.webp 336w, /amznews-reading-preview/_img/5b49d860695469db.webp 720w","width",1080,"height",904,"alt","poster","/amznews-reading-preview/_img/d4c4