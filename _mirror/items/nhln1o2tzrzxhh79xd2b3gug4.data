[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","nhln1o2tzrzxhh79xd2b3gug4","revision",2,"title","TikTok Shop 发布美国包装与保质期新规","originalTitle","TikTok Shop Packaging and Shelf-Life Rules: The Pre-Q4 Checklist","summary","TikTok Shop 于 2026 年 9 月 3 日发布美国订单十项禁止包装行为，明确禁止好评诱导插页。自 2026 年 6 月 5 日起，膳食补充剂及美妆外用产品送达时剩余保质期须至少 365 天，医疗器械须达 730 天。违规将导致账户健康评分扣分、链接移除及失去销售权限。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T20:41:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:22.435Z","timelineAt","category","policy","tags",[89,90,91],"score",30,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/075e7bfaa80f1a29.webp","fullUrl","/amznews-reading-preview/_img/075e7bfaa80f1a29.webp","srcSet","/amznews-reading-preview/_img/075e7bfaa80f1a29.webp 336w, /amznews-reading-preview/_img/075e7bfaa80f1a29.webp 720w","width",1600,"height",1256,"alt","poster","/amznews-reading-preview/_img/b18c6aadc82a9881.webp","/amznews-reading-preview/_img/b18c6aadc82a9881.webp","/amznews-reading-preview/_img/b18c6aadc82a9881.webp 336w, /amznews-reading-preview/_img/b18c6aadc82a9881.webp