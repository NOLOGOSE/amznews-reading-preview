[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","nhnpfu6pfo7m8stjtyugrso6d","revision",2,"title","Azoma 获 Puma Growth Partners 领投 1120 万美元 A 轮融资，优化品牌在 AI 购物助手中的推荐","originalTitle","Azoma raises an $11.2M Series A led by Puma Growth Partners for software that helps brands get recommended by AI shopping agents","summary","Azoma 完成由 Puma Growth Partners 领投的 1120 万美元 A 轮融资，Dunnhumby 跟投。其软件旨在追踪并提升品牌产品在 ChatGPT、Gemini 等 AI 购物助手中的曝光与推荐表现。Azoma 称基于 3800 万条 AI 引用分析，各引擎信源偏好差异显著，如 Alexa for Shopping 近 40% 引用来自联盟网站。","reason","source",{"_9":103,"_104":105,"_83":106,"_107":39,"_108":109,"_110":111},"links",{"_100":101,"_67":102},"publishedAt","2026-10-22T19:49:17.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T20:34:26.527Z","timelineAt","category","ai-tools","tags",[97,98,99],"score",25,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Paul Drecksler","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fXp__tyKfu4M",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","f2b7bc25-8819-4884-8dc2-8df0dda8fe5c","Azoma 获 1120 万美元 A 轮融资，优化 AI 购物助手推荐",{"_76":77,"_13":78},"platform","Shopifreaks",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/f228da8682844cae.webp","fullUrl","/amznews-reading-preview/_img/f228da8682844cae.webp","srcSet","/amznews-reading