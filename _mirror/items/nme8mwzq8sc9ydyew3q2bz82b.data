[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","nme8mwzq8sc9ydyew3q2bz82b","revision",5,"title","亚马逊卖家规模化风险管理：2026年账户健康与合规指南","originalTitle","Amazon Scaling Risk Management: A 2026 Guide for Mid-Market and Enterprise Sellers","summary","本文提供亚马逊卖家在收入、ASIN数量及团队规模增长时的风险管理指南，强调需将监控力度匹配业务扩张。文章详解 Account Health Rating (AHR) 评分机制（新账号起始200分，低于100分面临限制）及订单缺陷率<1%、迟发率<4%等关键指标阈值。针对2026年AI优先的执法模式，指南建议建立风险登记册以应对自动Listing编辑、紧急文档请求及隐性费用上涨等规模化特有挑战。","reason","source",{"_9":91,"_92":93,"_70":94,"_95":39,"_96":-5},"links",{"_88":89,"_65":90},"publishedAt","2026-10-05T11:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-07T12:33:38.911Z","timelineAt","category","policy","tags",[85,86,87],"score",22,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Nived Uthaiah P","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","sellerapp",{"_70":71,"_72":82,"_74":83,"_76":84,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/db2d2c73bbb29525.webp","fullUrl","/amznews-reading-preview/_img/db2d2c73bbb29525.webp","srcSet","/amznews-reading-preview/_img/db2d2c73bbb29525.webp 336w, /amznews-reading-preview/_img/db2d2c73bbb29525.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/4db0d6e39643d2f7.webp","/amznews-reading-preview/_img/4db0d6e39643d2f7.webp","/amznews-reading-preview/_img/4db0d6e39643d2f7.webp 336w, /am