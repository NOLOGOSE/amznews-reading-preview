[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","nreq93fjqrio1ckskyltj6wpz","revision",2,"title","三起插画及数字艺术版权诉讼立案，卖家需关注共同起诉程序与答辩期限","originalTitle","又是插画！这些作品可不只是画着好看","summary","原文介绍三起于2026年10月20日立案的版权诉讼：原告分别为插画师FRAN ZIS KA PAETZOLD、插画师兼设计师TOBIAS TEIXEIRA DA FONSECA（又名Tobe Fonseca）和数字艺术创作者ADAM VILIMEK，代理律所均为Ference & Associates。原文还讨论美国《联邦民事诉讼规则》第20条对共同起诉多被告的要求，并提示收到平台TRO相关邮件后应尽快介入；传票正式送达后通常需在21天内提交答辩，逾期可能面临缺席判决风险。","reason","source",{"_9":133,"_134":135,"_92":136,"_137":40,"_138":139,"_140":141},"links",{"_130":131,"_68":132},"publishedAt","2026-10-21T01:42:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-22T01:48:30.618Z","timelineAt","category","policy","tags",[128,129],"score",40,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89,90,91],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","聚德知识产权","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fwwkxLjbnYE4",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","e04bc85f-6387-48bb-b253-9579db985a2b","三起插画版权诉讼立案 共153名卖家被诉",{"_77":78,"_13":79},"platform","AMZ123",{"_92":93,"_94":125,"_96":126,"_98":127,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":122,"_96":123,"_98":124,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":119,"_96":120,"_98":121,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":116,"_96":117,"_98":118,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{