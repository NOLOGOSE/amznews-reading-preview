[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","o2nmg9yfehov8pliwxemppt5v","revision",2,"title","亚马逊后台AI推荐的标题好不好，能不能用？","originalTitle","summary","亚马逊两段标题要求宣布三个月后，本月开始大规模推送，卖家关注AI推荐标题能否直接使用。商品名（Item name）限制75字符，新增Item Highlights（商品亮点）125字符，可被搜索并展示在搜索结果和详情页；有变体时建议将最重要的变体属性放在商品名称内，其余迁移至商品亮点。作者实测修改一个月流量暂未受影响，但提醒务必人工审核AI生成内容，赶在10月至12月旺季前完成更新。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":38,"_100":101,"_102":103},"links",{"_92":93,"_64":94},"publishedAt","2026-09-15T18:52:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:12.022Z","timelineAt","category","advertising","tags",[88,89,90,91],"score",50,"selected",false,"channel","news","story","x","media",[67,68,69],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","Kris浩","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_70":71,"_72":85,"_74":86,"_76":87,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":82,"_74":83,"_76":84,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/5bae0bfa147194b3.webp","fullUrl","/amznews-reading-preview/_img/5bae0bfa147194b3.webp","srcSet","/amznews-reading-preview/_img/5bae0bfa147194b3.webp 336w, /amznews-reading-preview/_img/5bae0bfa147194b3.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/141e32414f485744.webp","/amznews-reading-preview/_img/141e32414f485744.webp","/amznews-reading-preview/_img/141e32414f485744.webp 336w, /amznews-readin