[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":-5,"_32":33,"_34":35,"_36":37,"_38":39,"_40":-5,"_41":-5,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":-5,"_53":54,"_55":56,"_57":37,"_58":59,"_60":-5,"_61":37,"_62":63},"id","o43rsgcph62lvtzqfvqpcbhee","revision",2,"title","纸箱的两面：向下流动的美国中部，向上生长的中国制造 |《履单》","originalTitle","summary","《履单》第二章讲述美国代顿制造业衰退中托德一家的经历：小布什任内当地约三分之一制造业岗位消失，托德一度住进救济中心，2018年进入刘易斯堡集装箱公司做瓦楞纸箱，起薪约每小时10美元，而这家纸箱厂最大客户是亚马逊。书中同时对照2001年中国加入世界贸易组织后中国制造与跨境电商的上升，并提到2017年亚马逊全球超一半商品销量来自第三方卖家、跨境销售增长超50%。","reason","source",{"_9":90,"_91":92,"_68":93,"_94":37,"_95":96,"_97":98},"links",{"_87":88,"_63":89},"publishedAt","2026-09-12T23:24:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:19.007Z","timelineAt","category","tags",[83,84,85,86],"score",12,"selected",false,"channel","news","story","x","media",[66,67],"byline",{"_49":50,"_64":65},"detailedGuide","readingMode","full","author","跨境电商MoonSees","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_68":69,"_70":80,"_72":81,"_74":82,"_76":-5,"_77":-5,"_78":-5,"_79":-5},{"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":-5,"_78":-5,"_79":-5},"kind","image","url","/amznews-reading-preview/_img/b7e5e985369f951d.webp","fullUrl","/amznews-reading-preview/_img/b7e5e985369f951d.webp","srcSet","/amznews-reading-preview/_img/b7e5e985369f951d.webp 336w, /amznews-reading-preview/_img/b7e5e985369f951d.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/e39b3faec29067f3.webp","/amznews-reading-preview/_img/e39b3faec29067f3.webp","/amznews-reading-preview/_img/e39b3faec29067f3.webp 336w, /amznews-reading-preview/_img/e39b3faec29067f3.webp 720w","行业动态","品类趋势","供应链","亚马逊","aihot","/items/o43rsgc