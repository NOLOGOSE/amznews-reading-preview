[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","o7kn5o69m03o7ues0p9998d69","revision",2,"title","亚马逊美国站FBA仓库拥堵，卖家旺季入仓受阻","originalTitle","亚马逊严重爆仓！卖家：货到门口进不去","summary","原文报道称，2026年10月亚马逊美国站多个热门FBA仓库出现拥堵、预约紧张和入仓延迟，部分卖家货物到仓后无法及时入库。原文列出黑五网一入仓截止线：AWD为10月14日，选择“最少货件拆分”的FBA为10月21日，选择“亚马逊优化货件拆分”的FBA为10月28日；并称自2026年7月31日起AWD仅接受标准尺寸商品。原文引用Descartes数据称美国9月海运集装箱进口量及中国货物进口量同比增长，并引用贝恩公司对旺季零售额的预测；本站尚未独立核验上述引用。原文还提到部分仓库拒收率和卸货等待时长，相关说法来自物料商信息，本站未独立核实。","reason","文章汇总了美国站旺季入仓截止线、仓库拥堵情况及卖家应对建议，并标注了进口数据与预测的来源归属；相关统计和拒收率说法本站尚未独立核验，读者应结合原文条件判断。","source",{"_9":121,"_122":123,"_89":124,"_125":67,"_126":127,"_128":129},"links",{"_118":119,"_69":120},"publishedAt","2026-10-18T05:12:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-18","discoveredAt","2026-10-19T03:37:38.400Z","timelineAt","category","fba","tags",[113,114,115,116,117],"score",65,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86,87,88],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","跨境电商头条","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":12,"_74":75,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fNJwDSXZ1tCg",{"_78":79,"_13":80},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","5cfa749d-785d-4a90-86a8-2c88d423eca0","亚马逊美国站FBA旺季爆仓与入仓截止线",{"_78":79,"_13":80},"platform","AMZ123",{"_89":90,"_91":110,"_93":111,"_95":112,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":107,"_93":108,"_95":109,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":104,"_93":105,"_95":106,"_97":-5,"_98":-5,"_99":-5,"_1