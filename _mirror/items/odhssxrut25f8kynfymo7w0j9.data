[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","odhssxrut25f8kynfymo7w0j9","revision",1,"title","亚马逊FBA服务迎来20周年","originalTitle","From storing products in his mom's garage to building a $7 million-a-year business, the seller behind McMiller Games is a reminder of wha...","summary","亚马逊宣布FBA服务成立20周年，该服务已实现日均配送数千万件商品。官方通过高管访谈回顾其从2006年首单至今的发展历程，并分享卖家借助FBA将业务规模扩大至700万美元的案例。","reason","source",{"_9":100,"_101":102,"_81":103,"_104":62,"_105":-5},"links",{"_98":99,"_66":86},"publishedAt","2026-10-02T22:00:26.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:27:07.864Z","timelineAt","category","fba","tags",[96,97],"score",12,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Sell_on_Amazon","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>From storing products in his mom's garage to building a $7 million-a-year business, the seller behind McMiller Games is a reminder of what's possible. When he turned to Fulfillment by Amazon, his mom finally got to \"retire\" from her daily trips to the post office, and he got to spend more time growing the business.</p><p>It's one of countless journeys FBA has helped make possible. This year marks 20 years of FBA, and the service has come a long way: from its very first order back in 2006 to delivering tens of millions of units a day. Storing inventory, picking, packing, shipping, Amazon handles the fulfillment so sellers can focus on what they do best: building.</p><p>Hear more seller stories like this on the newest episode of Learn and Be Curious, where Doug Herrington, CEO of Worldwide Amazon Stores, sits down with Piyush Saraogi, VP of Fulfillment by Amazon, to trace that 20-year journey and the bold early decisions that made it all possible. Watch the full episode on YouTube: http://spr.ly/6017BGvCYU</p><p>#sellonamazon #FBA #SellerStory #SmallBusiness #Ecommerce</p>","zhKind","complete","authorName","Sell on Amazon","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[80],{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":95},"kind","video","url","/amznews-reading-preview/_img/missing.svg","originalUrl","https://x.com/Sell_on_Amazon/status/2106142286622962007","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1080,"height",1920,"alt","poster","/amznews-reading-preview/_img/missing.svg","FBA/物流","亚马逊","aihot","/items/odhssxrut25f8kynfymo7w0j9","x-sell-on-amazon","name","X · Sell on Amazon","x_search","firstParty","iconUrl",{"_107":108},"changelogVersion","2026-10-09T22:08"]
