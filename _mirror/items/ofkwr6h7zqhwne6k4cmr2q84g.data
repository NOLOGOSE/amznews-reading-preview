[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","ofkwr6h7zqhwne6k4cmr2q84g","revision",2,"title","跨境郭太侠解析香港公司无发票费用的入账与税务扣除规则","originalTitle","香港公司没发票，这笔钱算不算数？","summary","跨境郭太侠分享香港公司费用管理实务，指出香港不发行增值税发票，会计入账看交易真实性，审计认可看证据链完整性，税务扣除须符合《税务条例》第16(1)条及第17条规定。作者强调离岸利润豁免与费用扣除是跷跷板关系，若利润被认定为离岸来源则对应费用不可在利得税中扣除；同时提醒不入账比没发票风险更高，可能影响银行开户与尽职调查。","reason","source",{"_9":101,"_102":103,"_84":104,"_105":40,"_106":107,"_108":109},"links",{"_98":99,"_68":100},"publishedAt","2026-10-19T07:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-20T08:05:39.689Z","timelineAt","category","policy","tags",[96,97],"score",58,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境郭太侠","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","foWhkzDKmhPc",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","4892d1e1-c6c3-46e8-ae99-69c0942324f6","香港公司无发票费用的入账与税务扣除实务",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/db5acb2f51179924.webp","fullUrl","/amznews-reading-preview/_img/db5acb2f51179924.webp","srcSet","/amznews-reading-preview/_img/db5acb2f51179924.webp 336w, /amznews-reading-preview/_img/db5acb2f51179924.webp 720w","width","height","alt","poster","其他","合规税务","aihot","/items/ofkwr6h7zqhwne6k4cmr2q84g","https://www.am