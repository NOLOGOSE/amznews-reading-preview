[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","ofwc1un87xk74fcl1ji8k14lu","revision",2,"title","亚马逊AI代理精简供应商价目表","originalTitle","A supplier sends me a 5,000-line price list. My AI agent cuts it to about 600 before I ever look at it.","summary","供应商发给我一份5,000行的价目表。在我查看之前，我的AI代理将其缩减到约600行。\n\n它通过UPC将每一行匹配到ASIN，如果没有UPC则通过标题匹配。它检查我是否获得品牌授权，从Keepa拉取数据，剔除销售排名超过300,000的产品，并标记利润率。\n\n构建它大约花了30分钟的提示词编写时间。","reason","source",{"_9":100,"_101":102,"_103":104,"_105":39,"_106":-5},"links",{"_97":98,"_68":99},"publishedAt","2026-10-22T19:59:07.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T20:17:29.797Z","timelineAt","category","ai-tools","tags",[94,95,96],"score",38,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","1000asins","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fGiTbcoJ6FYg",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","5db16e61-8c53-4004-b08a-4205ba3c2942","卖家自建AI代理精简供应商价目表",{"_77":78,"_13":79},"zh","<p>A supplier sends me a 5,000-line price list. My AI agent cuts it to about 600 before I ever look at it.</p><p>It matches every line to an ASIN by UPC, or by title if there's no UPC. It checks whether I'm approved for the brand, pulls the numbers from Keepa, drops anything over a 300,000 sales rank, and flags the margin.</p><p>Building it took about 30 minutes of prompting.</p>","zhKind","complete","authorName","Dan Boufford","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"AI/工具","AI工具","选品/市场","aihot","/items/ofwc1un87xk74fcl1ji8k14lu","https://x.com/1000asins/status/2113359514279780623","x-dan-boufford","name","X · Dan Boufford","kind","x_search","firstParty","iconUrl",{"_108":109},"changelogVersion","2026-10-09T22:08"]
