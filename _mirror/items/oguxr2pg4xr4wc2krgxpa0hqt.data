[{"_1":2,"_3":4},"root",{"_5":127},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","oguxr2pg4xr4wc2krgxpa0hqt","revision",2,"title","多地跨境卖家接税务局通知：增值税收入按出口报关单FOB价申报","originalTitle","税务申报又有新变化！深圳卖家已接到通知","summary","AMZ123获悉，近期深圳、广州等多地跨境卖家接到税务局通知，要求2026年第三季度增值税收入按出口报关单上的FOB价格申报。原文称该要求依据2026年1月1日施行的《增值税实施条例》第四十一条。原文同时提到，税务局回复称所得税营业收入仍按实际销售额申报，允许与增值税收入存在误差，但未明确可接受的误差范围。原文来自AMZ123，文中含该平台自身活动的推广内容，存在相关商业利益，并非独立测评。","reason","原文报道了深圳、广州等多地跨境卖家接到按出口报关单FOB价申报2026年第三季度增值税收入的通知，并保留了税务局关于所得税按实际销售额申报、允许存在误差但未明确误差范围的回复，以及作者对报关价与实际销售额差额可能引发解释要求的讨论。","source",{"_9":118,"_119":120,"_89":121,"_122":67,"_123":124,"_125":126},"links",{"_115":116,"_69":117},"publishedAt","2026-10-22T00:01:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-22T08:24:33.213Z","timelineAt","category","policy","tags",[113,114],"score",72,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86,87,88],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","AMZ123跨境电商","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":12,"_74":75,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","f-j41dJZBwzo",{"_78":79,"_13":80},"reportCount","additionalSourceCount",0,"developmentCount",1,"publicId","3a33e402-9e5d-4faf-9524-2ef79929ad65","多地跨境卖家收税务风险提示",{"_78":79,"_13":80},"platform","AMZ123",{"_89":90,"_91":110,"_93":111,"_95":112,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":107,"_93":108,"_95":109,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":104,"_93":105,"_95":106,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":101,"_93":102,"_95":103,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":92,"_93":94,"_95":96,"_97":-5,"_98":-5,"_99":-5,"_100":-5},"kind","image","url","/amznews-reading-preview/_img/b530677e12bf653b.webp","fullUrl","/amznews-reading-preview/_img/b530677e12bf653b.webp","srcSet","/amznews-reading-preview/_img/b530677e12bf653b.webp 336w, /amznews-reading-preview/_img/b530677e12bf653b.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/8e3ed96e0c44c243.webp","/amznews-reading-preview/_img/8e3ed96e0c44c243.webp","/amznews-reading-preview/_img/8e3ed96e0c44c243.webp 336w, /amznews-reading-preview/_img/8e3ed96e0c44c243.webp 720w","/amznews-reading-preview/_img/76d455a78a8d4492.webp","/amznews-reading-preview/_img/76d455a78a8d4492.webp","/amznews-reading-preview/_img/76d455a78a8d4492.webp 336w, /amznews-reading-preview/_img/76d455a78a8d4492.webp 720w","/amznews-reading-preview/_img/adb50a55f4fd7aec.webp","/amznews-reading-preview/_img/adb50a55f4fd7aec.webp","/amznews-reading-preview/_img/adb50a55f4fd7aec.webp 336w, /amznews-reading-preview/_img/adb50a55f4fd7aec.webp 720w","/amznews-reading-preview/_img/4c4b953d04817700.webp","/amznews-reading-preview/_img/4c4b953d04817700.webp","/amznews-reading-preview/_img/4c4b953d04817700.webp 336w, /amznews-reading-preview/_img/4c4b953d04817700.webp 720w","政策/合规","合规税务","aihot","/items/oguxr2pg4xr4wc2krgxpa0hqt","https://www.amz123.com/t/coVWde16","publisher-amz123-headlines","name","AMZ123 · 跨境头条","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_128":129},"changelogVersion","2026-10-09T22:08"]
