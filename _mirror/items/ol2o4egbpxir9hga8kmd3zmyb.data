[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","ol2o4egbpxir9hga8kmd3zmyb","revision",8,"title","亚马逊AGL新增两项中美空运服务及零配置费政策","originalTitle","亚马逊新增两项中美空运服务，最快7天入仓","summary","亚马逊宣布扩大中国至美国的Amazon Global Logistics（AGL）空运服务，新增Air SMP和Economy Air两种运输选项。其中Air SMP预计7至10天送达且免收FBA入库配置服务费，Economy Air预计11至15天送达；自2026年第四季度起，空运货物将纳入0美元FBA入库配置费结构。","reason","原文梳理了新增空运选项的时效与费用，并提示卖家需综合计算包含关税在内的完整到岸成本。","source",{"_9":102,"_103":104,"_85":105,"_106":66,"_107":108,"_109":110},"links",{"_99":100,"_68":101},"publishedAt","2026-09-30T02:37:42.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-09-30T09:35:26.029Z","timelineAt","category","fba","tags",[97,98],"score",62,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","media",[84],"byline",{"_53":81,"_82":83},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation",false,"bodyLanguage","original","factId","f6ZMw0AdzIgo",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","c0cd2408-6a67-40e4-8388-c96f663ad2c0","亚马逊AGL新增中美空运选项并扩围零配置费",{"_77":78,"_13":79},"Summer","platform","AMZ123",{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/4aa82a708b8eb1b3.webp","fullUrl","/amznews-reading-preview/_img/4aa82a708b8eb1b3.webp","srcSet","/amznews-reading-preview/_img/4aa82a708b8eb1b3.webp 336w, /amznews-reading-preview/_img/4aa82a708b8eb1b3.webp 720w","width","height","alt","poster","FBA/物流","亚马逊","ai