[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","opkxkxphhwrv4pmjbzwjqf9rb","revision",2,"title","亚马逊 SPN：被忽视的代理机构获客渠道","originalTitle","Amazon SPN and The Client Acquisition Channel Agencies Are Sleeping On","summary","亚马逊服务商网络（SPN）为代理机构提供直接触达有需求卖家的获客渠道，目前收录超750家服务商并拥有约3.7万卖家反馈。该渠道区别于面向开发者的SPP，需通过Solution Provider Portal注册方可入驻。SellerApp指出，结合其基准报告可帮助机构将SPN流量转化为具体营收增长。","reason","source",{"_9":109,"_110":111,"_85":112,"_113":39,"_114":-5},"links",{"_106":107,"_67":108},"publishedAt","2026-10-19T11:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T11:51:38.926Z","timelineAt","category","advertising","tags",[103,104,105],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83,84],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Nithin Mentreddy","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fVwvE6a6VX6c",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","e079d828-b1a1-46a7-89b4-54dabf79d5f8","亚马逊SPN成代理机构获客渠道",{"_76":77,"_13":78},"platform","sellerapp",{"_85":86,"_87":100,"_89":101,"_91":102,"_93":-5,"_94":-5,"_95":-5,"_96":-5},{"_85":86,"_87":97,"_89":98,"_91":99,"_93":-5,"_94":-5,"_95":-5,"_96":-5},{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/0a2d8ab2c124f6c3.webp","fullUrl","/amznews-reading-preview/_img/0a2d8ab2c124f6c3.webp","srcSet","/amznews-reading-preview