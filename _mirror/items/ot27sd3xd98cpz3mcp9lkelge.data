[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":40,"_60":61,"_62":-5,"_63":40,"_64":65},"id","ot27sd3xd98cpz3mcp9lkelge","revision",3,"title","亚马逊卖家福利页面可查询激励优惠及领取路径","originalTitle","@卖家，您可能有一笔钱尚未领取！隔壁王老板上新品时，查了下卖家福利页面","summary","原文来自亚马逊全球开店官方资讯，存在相关商业利益，并非独立测评。原文列出2026年面向卖家的激励，包括新卖家入门大礼包、新品入仓优惠计划、品牌引流奖励计划、多渠道配送优惠，以及新站点拓店启动金、优质选品跨站补贴、特定品类上架激励金等个性化福利，并提示福利有时效性，需及时领取使用。原文给出查询路径：原版卖家后台首页→建议栏→【查看激励优惠】；下一代销售界面左侧菜单栏→【了解卖家权益】。原文以Neakasa和朱雀跨境为例说明广告抵扣券与FBA配送费减免的使用情况，属原文案例，本站尚未独立核验。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":61,"_80":-5},"links",{"_71":72,"_65":73},"publishedAt","2026-06-08T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-06-09","discoveredAt","2026-10-16T14:13:44.251Z","timelineAt","category","policy","tags",[68,69,70],"score",22,"selected",false,"channel","news","story","x","media",[],"byline",{"_52":-5,"_66":67},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊全球开店","政策/合规","费用变更","亚马逊","aihot","/items/ot27sd3xd98cpz3mcp9lkelge","https://gs.amazon.cn/news/news-product-260609","official-amazon-global-selling-news","name","亚马逊全球开店 · 官方资讯","kind","web_list","firstParty","iconUrl",{"_82":83},"changelogVersion","2026-10-09T22:08"]
