[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","ou0b7ohs3cfqtv7e3x460imev","revision",2,"title","亚马逊英德站10月15日起实施旺季配送费调整","originalTitle","亚马逊英德站旺季配送费10月15日生效，费率、适用范围与叠加规则全解读","summary","亚马逊宣布自2026年10月15日至2027年1月14日对英国和德国站部分FBA订单加收节日旺季配送费。英国站符合条件的小型及标准包裹平均每件增加约£0.12，德国站对应商品平均每件增加约€0.27，且适用的1.5%燃油及物流相关附加费会叠加于该费用之上。文章指出卖家在备货黑五圣诞季时，除关注配送费外，还需综合核对促销活动固定及浮动收费、广告投入变化以及库存周转带来的潜在成本影响。","reason","原文整理了英德站旺季配送费的具体增量、适用期限及叠加规则，并提示卖家需结合促销与广告成本重新核算Q4预算。","source",{"_9":89,"_90":91,"_92":93,"_94":66,"_95":96,"_97":98},"links",{"_86":87,"_68":88},"publishedAt","2026-10-16T09:50:13.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T15:07:28.127Z","timelineAt","category","policy","tags",[83,84,85],"score",66,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境早知道","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":12,"_73":74,"_75":76},"hasTranslation",false,"bodyLanguage","original","factId","fyOjvQN86b1A",{"_77":78,"_13":79},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","89a51c14-74a4-478a-82d2-14619dc7576f","亚马逊英德站旺季配送费10月15日起实施",{"_77":78,"_13":79},"platform","雨果跨境","费用变更","FBA/物流","亚马逊","aihot","/items/ou0b7ohs3cfqtv7e3x460imev","https://www.cifnews.com/article/189482","publisher-cifnews-amazon","name","雨果跨境 · 亚马逊频道最新","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp","iconSrcSet","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 48w, /amznews-reading-preview/_img/3eb2ff60