[{"_1":2,"_3":4},"root",{"_5":120},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","owjehrlrkwho1jcpthmor8byn","revision",2,"title","亚马逊NWD下架通知倒计时及卖家应对指南","originalTitle","紧急！亚马逊下架通知倒计时！","summary","亚马逊向部分卖家发送NWD（无批发分销）通知，要求2026年10月27日前处理相关库存，否则可能被弃置。该通知由系统批量发送给品牌代表和分销商两类账号，品牌代表角色可忽略，但需确认后台登记无误。自有品牌若因角色同步问题误收通知，应先修正后台配置再提交Case申诉。分销型、铺货型等卖家需尽快创建移除订单或清仓，注意旺季移除周期可能长达10到30天。","reason","原文梳理了NWD通知的误发逻辑与申诉步骤，并给出不同身份卖家的库存处理方案。","source",{"_9":111,"_112":113,"_87":114,"_115":67,"_116":117,"_118":119},"links",{"_108":109,"_69":110},"publishedAt","2026-10-21T01:05:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-22T02:32:47.060Z","timelineAt","category","policy","tags",[105,106,107],"score",72,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","三头六臂跨境电商联盟","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":12,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fbAjJrnzgSnM",{"_78":79,"_13":80},"reportCount",5,"additionalSourceCount","developmentCount",0,"publicId","dbf445cd-5ab4-4c48-9b75-67dad0c62a93","亚马逊NWD限售通知引发卖家下架与库存担忧",{"_78":79,"_13":80},"platform","AMZ123",{"_87":88,"_89":102,"_91":103,"_93":104,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":99,"_91":100,"_93":101,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5,"_97":-5,"_98":-5},"kind","image","url","/amznews-reading-preview/_img/df6ba0c5dc78d721.webp","fullUrl","/amznews-reading-preview/_img/df6ba0c5dc78d721.webp","srcSet