[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","oyh18c2kk75j7akiynb9vqujl","revision",2,"title","亚马逊广告推出 Review Requests 功能，10月下旬美国站开启公测","originalTitle","即将开放！亚马逊评论新入口将执行","summary","亚马逊广告宣布推出 Review Requests 功能，计划于2026年10月下旬在美国站进入公开测试阶段。卖家可通过 Amazon Ads Agent 创建广告活动，向近期购买者展示原生邀评广告以获取星级评分或评价。该功能主要面向累计评论少于1000条的商品，达到上限后广告自动暂停，旨在帮助新品卖家缩短评论积累周期并提升真实反馈比例。","reason","原文梳理了亚马逊Review Requests功能的测试时间、适用条件及运作流程，为新品卖家提供了站内合规邀评的新路径参考。","source",{"_9":108,"_109":110,"_87":111,"_112":67,"_113":114,"_115":116},"links",{"_105":106,"_69":107},"publishedAt","2026-10-20T07:59:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-20","discoveredAt","2026-10-21T02:23:13.034Z","timelineAt","category","policy","tags",[102,103,104],"score",67,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","media",[85,86],"byline",{"_54":55,"_83":84},"detailedGuide","readingMode","full","author","速推站外","language","body","outline",[],"relatedStories",[82],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":76,"_77":78},"hasTranslation",false,"bodyLanguage","original","factId","fESWmwI3Tsz4",{"_79":80,"_13":81},"reportCount",6,"additionalSourceCount",4,"developmentCount",1,"publicId","bb008d0d-3282-49d0-a71b-39b869403450","亚马逊10月下旬美国站公测付费邀评广告",{"_79":80,"_13":81},"platform","AMZ123",{"_87":88,"_89":99,"_91":100,"_93":101,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5,"_97":-5,"_98":-5},"kind","image","url","/amznews-reading-preview/_img/d154387345b4ab96.webp","fullUrl","/amznews-reading-preview/_img/d154387345b4ab96.webp","srcSet","/amznews-reading-preview/_img/d154387345b4