[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":40,"_60":61,"_62":-5,"_63":40,"_64":65},"id","ozduuz3m0y923j8mmbnhezi2z","revision",1,"title","亚马逊广告GIA上线预构建品牌渗透率指数","originalTitle","Activate pre-built brand penetration indices with GIA","summary","亚马逊广告宣布地理洞察与激活（GIA）功能现已在 DVA+ 位置小部件中直接提供带高级设置的预构建渗透率指数。该功能由亚马逊第一方零售数据驱动，根据广告主跟踪的商品 ASIN 生成并将品牌渗透率与更广泛的商品品类进行对比，使广告主无需配置亚马逊营销云（AMC）即可可视化品牌渗透率并激活地理优化。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":61,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-02","discoveredAt","2026-10-22T17:24:11.696Z","timelineAt","category","advertising","tags",[89,90,91],"score",58,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_52":-5,"_66":67},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊广告",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/e1090233a669bffc.webp","fullUrl","/amznews-reading-preview/_img/e1090233a669bffc.webp","srcSet","/amznews-reading-preview/_img/e1090233a669bffc.webp 336w, /amznews-reading-preview/_img/e1090233a669bffc.webp 720w","width",1176,"height",758,"alt","poster","/amznews-reading-preview/_img/190b0e0412f42a42.webp","/amznews-reading-preview/_img/190b0e0412f42a42.webp","/amznews-reading-preview/_img/190b0e0412f42a42.webp 336w, /amznews-reading-preview/_img/190b0e0412f42a42.webp 720w",1129,753,"AI/