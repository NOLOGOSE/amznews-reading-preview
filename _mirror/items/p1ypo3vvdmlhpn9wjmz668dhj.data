[{"_1":2,"_3":4},"root",{"_5":156},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","p1ypo3vvdmlhpn9wjmz668dhj","revision",4,"title","亚马逊自动创建多包装Listing、调整费用类别及Google推出Universal Cart","originalTitle","Amazon Multipacks, FBA Fee Changes & Google Universal Cart","summary","亚马逊将在10月28日前为部分品牌自有的FBA商品自动创建虚拟多包装Listing，11月11日起允许客户购买，卖家可在“管理所有库存”中审核、编辑或删除。亚马逊费用类别更新于10月31日生效，新增3D打印机专属类别；卖家应查看费用预览报告，核对当前费用类别及即将发生的变化，如认为ASIN分类有误可提出争议。原文来自Bellavix，文末附有该机构的电商咨询服务表单，存在相关商业利益，并非独立测评。","reason","source",{"_9":147,"_148":149,"_90":150,"_151":39,"_152":153,"_154":155},"links",{"_144":145,"_67":146},"publishedAt","2026-10-21T12:15:21.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-21T13:13:12.419Z","timelineAt","category","policy","tags",[139,140,141,142,143],"score",43,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83,84,85,86,87,88,89],"byline",{"_52":-5,"_80":81},"detailedGuide","readingMode","full","author","Bellavix","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","ffo94TB2Syfc",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","27220d8e-6e05-4cb1-ac39-9154ecf9ae80","亚马逊自动创建多包装Listing并调整费用类别",{"_76":77,"_13":78},"platform","BellaVix",{"_90":91,"_92":134,"_94":135,"_96":136,"_98":137,"_100":138,"_102":-5,"_103":-5},{"_90":91,"_92":129,"_94":130,"_96":131,"_98":132,"_100":133,"_102":-5,"_103":-5},{"_90":91,"_92":124,"_94":125,"_96":126,"_98":127,"_100":128,"_102":-5,"_103":-5},{"_90":91,"_92":119,"_94":120,"_96":121,"_98":122,"_100"