[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","p2t0sod8egjz5l1t0hpqyesz4","revision",1,"title","FJTJBSI 六抽屉柜因倾倒与夹困风险被 CPSC 召回，违反 STURDY Act 强制标准","originalTitle","FJTJBSI Recalls Six-Drawer Dressers Due to Risk of Serious Injury or Death from Tip-Over and Entrapment Hazards; Violate Mandatory Standard for Clothing Storage Units","summary","FJTJBSI 品牌六抽屉柜因未固定时不稳定、存在倾倒与夹困致儿童重伤或死亡风险，违反 STURDY Act 强制标准，被 CPSC 召回，涉及约 9,000 件。该产品 2024 年 11 月至 2026 年 7 月在 Amazon.com 售出，售价约 $170，消费者应停用并联系 FJTJBSI 获全额退款。","reason","source",{"_9":74,"_75":66,"_76":77,"_78":60,"_79":80,"_81":82},"links",{"_71":72,"_64":73},"publishedAt","2026-09-10T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T14:12:19.627Z","timelineAt","category","policy","tags",[67,68,69,70],"score",43,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","CPSC 美国消费品安全委员会","政策/合规","合规税务","亚马逊","退货管理","aihot","/items/p2t0sod8egjz5l1t0hpqyesz4","https://cpsc.gov/Recalls/2026/FJTJBSI-Recalls-Six-Drawer-Dressers-Due-to-Risk-of-Serious-Injury-or-Death-from-Tip-Over-and-Entrapment-Hazards-Violate-Mandatory-Standard-for-Clothing-Storage-Units","official-cpsc-amazon-recalls-reviewed","name","kind","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp","iconSrcSet","/amznews-reading-preview/_img/382881c3aef48a1a.webp 48w, /amznews-reading-preview/_img/382881c3aef48a1a.webp 96w",{"_84":85},"chang