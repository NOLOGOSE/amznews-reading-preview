[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","p4zrteu71fdb6wsq8l052qssn","revision",2,"title","亚马逊品牌搜索数据诊断","originalTitle","One brand I sell gets about 38,000 searches a month by name.","summary","我销售的一个品牌每月约有 38,000 次按名称搜索。\n\nBrand Analytics（品牌分析）将这部分从类目搜索中分离出来。高品牌搜索量伴随低销量意味着需求存在，但商品详情页未能承接；低品牌搜索量则意味着人们尚不了解该品牌。\n\n在着手解决问题之前，先明确你面临的是哪种情况。","reason","source",{"_9":100,"_101":102,"_103":104,"_105":39,"_106":-5},"links",{"_97":98,"_68":99},"publishedAt","2026-10-21T20:58:05.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-21T21:03:14.872Z","timelineAt","category","advertising","tags",[94,95,96],"score",22,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","1000asins","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fg-qtqAMW6DE",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","4c38495a-e107-479f-9077-68536a7ba056","卖家借亚马逊品牌分析诊断转化与品牌搜索",{"_77":78,"_13":79},"zh","<p>One brand I sell gets about 38,000 searches a month by name.</p><p>Brand Analytics splits that out from category searches. High branded search with low sales means the demand is there and the listing is losing it. Low branded search means people don't know the brand yet.</p><p>Know which problem you have before you start fixing things.</p>","zhKind","complete","authorName","Dan 