[{"_1":2,"_3":4},"root",{"_5":124},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","p5bh3lhbteb297ieqx0jx3ei9","revision",2,"title","亚马逊推出 Review Requests 付费广告邀请买家评分","originalTitle","Amazon Review Requests: The New Paid Ad That Asks Buyers to Rate Your Product","summary","亚马逊宣布在 Amazon Ads 中推出 Review Requests 功能，这是一种付费广告，旨在邀请近期购买者通过一键操作留下星级评分。该功能目前仅在美国市场开放测试，要求产品总评分和评论数少于 1,000 条，达到阈值后自动暂停。亚马逊尚未公布具体定价模型，建议卖家通过计算“每个额外评分的成本”来评估效果，并将其作为 Vine 计划和免费“请求评论”按钮的补充手段，而非替代品。","reason","原文梳理了Review Requests的资格限制、与Vine及免费按钮的区别，并提供了基于增量评分成本的测试方法。","source",{"_9":115,"_116":117,"_88":118,"_119":66,"_120":121,"_122":123},"links",{"_112":113,"_68":114},"publishedAt","2026-10-20T06:38:49.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-20T11:11:41.143Z","timelineAt","category","advertising","tags",[109,110,111],"score",62,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86,87],"byline",{"_53":54,"_82":83},"detailedGuide","readingMode","full","author","George Meressa","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fESWmwI3Tsz4",{"_78":79,"_13":80},"reportCount",6,"additionalSourceCount",4,"developmentCount",1,"publicId","bb008d0d-3282-49d0-a71b-39b869403450","亚马逊10月下旬美国站公测付费邀评广告",{"_78":79,"_13":80},"platform","ClearAds Agency",{"_88":89,"_90":106,"_92":107,"_94":108,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":103,"_92":104,"_94":105,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":100,"_92":101,"_94":102,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":9