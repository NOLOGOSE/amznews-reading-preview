[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","p6cfc4b7v3r6wvnvq0zwrrdop","revision",2,"title","亚马逊 FBA 赔付审计教程：用三份报告做一次 20 分钟初筛","originalTitle","How Much Is Amazon Quietly Owing You? A 20-Minute Reimbursement Audit","summary","eComEngine 作者 Bob Norberg 提出一套 20 分钟 FBA 赔付初筛流程：从卖家后台导出赔付报告、FBA 客户退货报告和库存调整记录，标记“已退款但未退回可售库存”和“丢失或损坏但无对应赔付”的条目，并抽查高销量 SKU 的费用是否与实际尺寸重量相符。作者称亚马逊自 2024 年底起仅对部分丢失或损坏情形自动赔付，多数索赔窗口约 60 天，但该规则与时限本站尚未独立核验。原文来自 eComEngine，文末推广其 SellerPulse 与 RestockPro Plus 试用，存在相关商业利益，并非独立测评；作者亦说明这两款工具不代为申报索赔，申报仍在卖家后台进行。","reason","source",{"_9":107,"_108":82,"_84":109,"_110":40,"_111":112,"_113":114},"links",{"_104":105,"_68":106},"publishedAt","2026-10-19T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-19T16:51:38.289Z","timelineAt","category","fba","tags",[98,99,100,101,102,103],"score",58,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","Bob Norberg","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fLp_YY927Pl0",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","ff06809e-5b79-43b5-a84a-898a72f4868c","eComEngine 发布 20 分钟 FBA 赔付初筛教程",{"_77":78,"_13":79},"platform","eComEngine",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":95,"_96":-5,"_97":-5},"kind","image","url","/amznews-reading-preview/_img/487676b6f1765f50.webp","fullUrl","/amznews-reading-preview/_img/487676b6f1765f50.web