[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":16,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":64,"_65":40,"_66":67},"id","pakytssxlrach7tok40vfiek4","revision",2,"title","佛山诺爱童装商行召回 CIYTI 发光公主裙，因纽扣电池易致儿童误吞","originalTitle","FoShanShiNanHaiQuNuoAiTongZhuangShangHang Recalls CIYTI Light-Up Princess Costumes Due to Risk of Serious Injury or Death from Battery Ingestion; Violate Mandatory Standard for Toys","summary","佛山诺爱童装商行（FoShanShiNanHaiQuNuoAiTongZhuangShangHang）召回约 94 件 CIYTI 发光公主裙，因其违反玩具强制安全标准，纽扣电池易被儿童接触并导致严重伤害或死亡。该产品于 2025 年 2 月至 6 月在亚马逊以 $21-$35 价格销售，消费者应立即停止使用并联系卖家获取全额退款。","reason","source",{"_9":87,"_88":89,"_90":91,"_92":40,"_93":94,"_95":96},"links",{"_84":85,"_67":86},"publishedAt","2026-10-22T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-22T18:36:28.171Z","timelineAt","category","policy","tags",[82,83],"score",20,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_53":-5,"_80":81},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_43":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","f4m1gKs7ETbU",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","03a9831b-415e-46f9-8393-34afff2dab01","佛山诺爱童装商行召回CIYTI发光公主裙",{"_76":77,"_13":78},"platform","美国 CPSC","政策/合规","亚马逊","aihot","/items/pakytssxlrach7tok40vfiek4","https://www.cpsc.gov/Recalls/2027/FoShanShiNanHaiQuNuoAiTongZhuangShangHang-Recalls-CIYTI-Light-Up-Princess-Costumes-Due-to-Risk-of-Serious-Injury-or-Death-from-Battery-Ingestion-Violate-Mandatory-Standard-for-Toys","offic