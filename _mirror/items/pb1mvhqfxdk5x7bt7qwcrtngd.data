[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","pb1mvhqfxdk5x7bt7qwcrtngd","revision",2,"title","亚马逊公布 Listing Protection 机制：符合条件卖家在违规审核期间可继续销售","originalTitle","亚马逊放大招：Listing违规也能继续卖！这项新机制或将改变卖家申诉方式","summary","亚马逊在 Accelerate 大会公布 Listing Protection 机制：符合条件的卖家在商品被标记违规后的审核期间可继续维持销售。该权益与 Account Health Assurance（AHA）资格挂钩，要求账户健康评分（AHR）达到 250 分或以上、连续保持 6 个月，且在此期间评分低于 250 分的时间不超过 10 天；达到要求后自动纳入，无需额外申请。原文同时说明，继续销售不等于违规被豁免，最终是否受限仍取决于亚马逊审核结果，具体执行以正式上线规则为准。","reason","source",{"_9":89,"_90":91,"_92":93,"_94":39,"_95":96,"_97":98},"links",{"_86":87,"_67":88},"publishedAt","2026-10-19T07:21:28.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T07:57:35.172Z","timelineAt","category","policy","tags",[83,84,85],"score",60,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_52":53,"_81":82},"detailedGuide","readingMode","full","author","阿U","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":76},"hasTranslation","bodyLanguage","original","factId","feo6IK5EleFM",{"_77":78,"_13":79},"reportCount",7,"additionalSourceCount",3,"developmentCount",0,"publicId","dd0d4720-1478-41f4-b385-9924666d8024","亚马逊公布Listing Protection机制：AHA卖家违规审核期可继续销售",{"_77":78,"_13":79},"platform","雨果跨境","政策/合规","Listing优化","亚马逊","aihot","/items/pb1mvhqfxdk5x7bt7qwcrtngd","https://www.cifnews.com/article/189518","publisher-cifnews-amazon","name","雨果跨境 · 亚马逊频道最新","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp","iconSrcSet","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp