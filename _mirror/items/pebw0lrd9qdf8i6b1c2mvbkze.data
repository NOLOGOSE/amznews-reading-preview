[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","pebw0lrd9qdf8i6b1c2mvbkze","revision",2,"title","鞋服跨境出口面临欧盟PFAS新规与美国海关侵权扣押双重监管收紧","originalTitle","AB趣谈 | 跨境向好？最大品类却开始收紧政策…","summary","鞋服品类作为跨境电商最大出口类目，正遭遇欧盟PFAS限制生效及美国海关加大侵权货物扣押力度的监管收紧。欧盟PFAS新规于2026年10月10日生效，禁止特定浓度物质销售；欧洲鞋业联合会测试显示Shein、Temu部分样品化学指标超标。同时，低价小包直邮模式因欧盟3欧元进口费及多国取消免税政策而成本激增，合规成为卖家生存关键。","reason","source",{"_9":122,"_123":124,"_88":125,"_126":39,"_127":-5},"links",{"_119":120,"_67":121},"publishedAt","2026-10-22T08:47:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T11:38:28.920Z","timelineAt","category","policy","tags",[115,116,117,118],"score",50,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83,84,85,86,87],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","AB观跨境","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fEWVyZd9jYk0",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","669da939-3b11-435b-b2c7-0012ad520838","鞋服跨境出口遇欧盟PFAS新规与美国海关扣押收紧",{"_76":77,"_13":78},"platform","卖家之家",{"_88":89,"_90":112,"_92":113,"_94":114,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":109,"_92":110,"_94":111,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":106,"_92":107,"_94":108,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":103,"_92":104,"_94":105,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":100,"_92":101,"_94":102,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":91,"_92":93,"_94":