[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":40,"_60":61,"_62":-5,"_63":40,"_64":65},"id","pmynynjcroprqltfe8biejhr9","revision",1,"title","亚马逊全球智能枢纽仓（GWD）支持保质期商品分批补货至美国FBA","originalTitle","保质期商品备多了怕临期，备少了怕断货？","summary","亚马逊宣布全球智能枢纽仓（GWD）支持个护美妆、母婴及家清等保质期商品入仓，允许大货存放国内并依据美国站销量分批补货至FBA，以降低临期风险。该服务提供沪深甬三仓选择，不限货件数量且无长期承诺，入仓享30天免费仓储（截至2026年12月31日）。商品需满足入库距创建日期≥365天、出库距补货订单创建日期≥180天的保质期要求，危险品、食品等暂不支持。","reason","source",{"_9":75,"_76":77,"_78":79,"_80":61,"_81":-5},"links",{"_72":73,"_65":74},"publishedAt","2026-10-11T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-12","discoveredAt","2026-10-22T02:12:29.859Z","timelineAt","category","fba","tags",[68,69,70,71],"score",57,"selected",false,"channel","news","story","x","media",[],"byline",{"_52":-5,"_66":67},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊全球开店","AI/工具","FBA/物流","库存管理","亚马逊","aihot","/items/pmynynjcroprqltfe8biejhr9","https://globalselling.amazon.com/news/news-brand-261012","official-amazon-global-selling-news","name","亚马逊全球开店 · 官方资讯","kind","web_list","firstParty","iconUrl",{"_83":84},"changelogVersion","2026-10-09T22:08"]
