[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":16,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":64,"_65":40,"_66":67},"id","pnw3d619cimh2zwcgkftfx3ip","revision",2,"title","美国 CPSC 召回 Bamamon LED 投影手指灯玩具，因纽扣电池易被儿童误吞","originalTitle","BAMAMON Recalls LED Projecting Finger Light Toys Due to Risk of Serious Injury or Death from Battery Ingestion; Violate Mandatory Standard for Toys","summary","美国 CPSC 于 2026 年 10 月 22 日召回约 6,533 件 Bamamon LED 投影手指灯玩具，因其违反玩具强制标准，纽扣电池仓易被儿童打开，存在导致严重伤害或死亡的误吞风险。该产品由深圳麦多多贸易有限公司（Bamamon）在 Amazon.com 销售，售价约 $13-$14。消费者应立即停用并联系厂商获取退款，需发送产品丢弃照片至指定邮箱。","reason","source",{"_9":88,"_89":90,"_91":92,"_93":40,"_94":95,"_96":97},"links",{"_85":86,"_67":87},"publishedAt","2026-10-22T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-22T18:36:28.188Z","timelineAt","category","policy","tags",[82,83,84],"score",38,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_53":-5,"_80":81},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_43":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fFg3zhgupCwA",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","9a87a13d-4ae0-4cc8-993a-279b8109cd4e","Bamamon召回LED手指灯玩具因纽扣电池风险",{"_76":77,"_13":78},"platform","美国 CPSC","政策/合规","合规税务","亚马逊","aihot","/items/pnw3d619cimh2zwcgkftfx3ip","https://www.cpsc.gov/Recalls/2027/BAMAMON-Recalls-LED-Projecting-Finger-Light-Toys-Due-to-Risk-of-Serious-Injury-or-Death-from-Battery-Ingestion-Violate-Mandatory-Standard-for-Toys","official-us-cpsc-recalls","name","美国 CPSC · 产品召回","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp","iconSrcSet","/amznews-reading-preview/_img/382881c3aef48a1a.webp 48w, /amznews-reading-preview/_img/382881c3aef48a1a.webp 96w",{"_99":100},"changelogVersion","2026-10-09T22:08"]
