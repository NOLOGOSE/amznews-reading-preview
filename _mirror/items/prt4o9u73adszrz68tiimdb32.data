[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","prt4o9u73adszrz68tiimdb32","revision",2,"title","实体零售清仓渠道助亚马逊卖家获利","originalTitle","In my series to help resellers think outside of the box.","summary","Saul分享通过Urban Outfitters等实体店清仓区采购黑胶唱片在亚马逊转售的经验，实现$5-10成本转化为$35-$60售价。他建议探索CVS、Walgreens等非传统门店及商场角落以发现库存机会，指出常规商店仍有大量优质货源可供挖掘。","reason","source",{"_9":111,"_112":113,"_95":114,"_115":39,"_116":-5},"links",{"_108":109,"_68":110},"publishedAt","2026-10-16T12:05:08.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.516Z","timelineAt","category","product","tags",[107],"score",18,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","SaulSellsStuff","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fflC1ijhz14g",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","5b0cbdb7-91bd-4f39-b908-1a60b1949f57","卖家分享实体店清仓区采购转售亚马逊经验",{"_77":78,"_13":79},"zh","<p>In my series to help resellers think outside of the box.</p><p>At one point Urban Outfitters was my number one source of Vinyl Records to sell on Amazon.</p><p>Physically locations had a section and dozens would end up on sale / clearance.</p><p>$5-10 into $35-$60</p><p>You can source and do very well at conventional stores. You can also find lots of great inventory at stores you may not be thinking about.</p><p>Worth a stop in at different stores at your local mall to get a better sense of what they sell. Then do the same at strip malls, etc.</p><p>One Black Friday years ago I only sourced at CVS / Walgreens for toys 🤷‍♂️</p>","zhKind","complete","authorName","Saul","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[94],{"_95":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":-5,"_106":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1536,"height",960,"alt","poster","选品/市场","aihot","/items/prt4o9u73adszrz68tiimdb32","https://x.com/SaulSellsStuff/status/2111065905325105631","x-saul-sells-stuff","name","X · Saul","x_search","firstParty","iconUrl",{"_118":119},"changelogVersion","2026-10-09T22:08"]
