[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","pta4wt0bf47j1smy78z88k0x4","revision",1,"title","亚马逊 LTL 网络缺失高端加急层级，收购 Forward Air 被视为最快补齐方案","originalTitle","Amazon’s LTL gap has a name: Forward Air","summary","分析师指出亚马逊新推出的 LTL 网络目前仅覆盖经济型市场，缺乏高端加急层级。Forward Air 拥有成熟的全国加急物流网络及机场枢纽资源，与亚马逊现有资产形成互补。文章认为收购 Forward Air 是亚马逊快速补齐这一短板、构建完整国家物流体系的最快路径。","reason","source",{"_9":75,"_76":77,"_78":79,"_80":39,"_81":82,"_83":84},"links",{"_72":73,"_65":74},"publishedAt","2026-06-11T23:11:09.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:42.442Z","timelineAt","category","fba","tags",[69,70,71],"score",22,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Craig Fuller, CEO at FreightWaves","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Craig Fuller","platform","FreightWaves","FBA/物流","供应链","亚马逊","aihot","/items/pta4wt0bf47j1smy78z88k0x4","https://www.freightwaves.com/news/amazons-ltl-gap-has-a-name-forward-air","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_86":87},"changelogVersion","2026-10-09T22:08"]
