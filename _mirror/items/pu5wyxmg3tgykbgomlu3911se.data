[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","pu5wyxmg3tgykbgomlu3911se","revision",5,"title","亚马逊PD大促后广告、价格与库存收尾指南","originalTitle","PD大促结束后，广告怎么收、价格怎么调、库存怎么补？","summary","Regan跨境分享亚马逊PD大促后的运营收尾策略，核心是按活动后的利润、转化和库存条件重新安排投入。作者建议美国站FBA卖家在结束后24小时内检查促销与广告设置，注意Sponsored Products归因窗口为7天，避免仅凭当天数据关停广告；同时需核对正常售价下的ACOS承受力，并基于保守、基准、乐观三种情景重算补货需求，防止将大促峰值误判为日常销量。","reason","source",{"_9":133,"_134":135,"_91":136,"_137":40,"_138":139,"_140":141},"links",{"_130":131,"_68":132},"publishedAt","2026-10-07T23:45:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-08","discoveredAt","2026-10-09T01:46:31.742Z","timelineAt","category","advertising","tags",[127,128,129],"score",48,"selected",false,"channel","news","story",{"_77":78,"_13":14},"x","media",[82,83,84,85,86,87,88,89,90],"byline",{"_53":54,"_80":81},"detailedGuide","readingMode","full","author","Regan跨境","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f3zkZfu8f2ek",{"_77":78,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","6f51f645-4fad-4038-86fe-7b1a85b2af07",{"_77":78,"_13":14},"platform","AMZ123",{"_91":92,"_93":124,"_95":125,"_97":126,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":121,"_95":122,"_97":123,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":118,"_95":119,"_97":120,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":115,"_95":116,"_97":117,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":112,"_95":113,"_97":114,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"