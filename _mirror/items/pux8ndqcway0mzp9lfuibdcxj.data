[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":64,"_65":40,"_66":67},"id","pux8ndqcway0mzp9lfuibdcxj","revision",2,"title","CPSC 召回 usOpal Xalirium 成人便携床栏，因存在夹困窒息风险","originalTitle","usOpal Recalls Xalirium Portable Bed Rails Due to Risk of Serious Injury or Death from Entrapment and Asphyxiation; Violate Mandatory Standard for Adult Portable Bed Rails","summary","CPSC 于 2026 年 10 月 15 日召回约 200 件 usOpal Xalirium 成人便携床栏，因其违反强制性标准，存在用户被夹困导致窒息死亡及跌落风险。该产品曾在 Amazon.com 以约 $60 售价销售，消费者应立即停用并联系 usOpal 获取全额退款。","reason","source",{"_9":87,"_88":81,"_89":90,"_91":62,"_92":93,"_94":95},"links",{"_84":85,"_67":86},"publishedAt","2026-10-15T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-15","discoveredAt","2026-10-15T16:24:40.988Z","timelineAt","category","policy","tags",[82,83],"score",21,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_53":-5,"_80":81},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_43":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fZ3WQ_Riui6k",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","411d059d-cffd-49e0-a3f1-ccbac8118478","usOpal召回Xalirium成人便携床栏",{"_76":77,"_13":78},"platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","aihot","/items/pux8ndqcway0mzp9lfuibdcxj","https://cpsc.gov/Recalls/2027/usOpal-Recalls-Xalirium-Portable-Bed-Rails-Due-to-Risk-of-Serious-Injury-or-Death-from-Entrapment-and-Asphyxiation-Violate-Mandatory-Standard-for-Adult-Portable-Bed-Rails","official-cpsc-amazon-recalls-reviewed","