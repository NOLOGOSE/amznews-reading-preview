[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_42":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":40,"_62":40,"_63":-5,"_64":65,"_66":67},"id","pvd22wxo126gpvlmmbllrnqlg","revision",1,"title","亚马逊推出MCF卖家独立站免费Prime配送及优选定价计划","originalTitle","Merchants can now offer Amazon Prime delivery on their own websites at no additional cost","summary","亚马逊宣布美国地区使用多渠道履约（MCF）的商家可在其独立网站免费提供快速Prime配送，无需额外费用或更改结账流程。同时推出MCF优选定价计划，结合履约费折扣与FBA积分，使商家在前六个月最高节省25%的履约费用，且无合同约束。该功能通过Shopify应用或Selling Partner API激活，旨在帮助商家利用亚马逊物流网络提升转化率并降低运营成本。","reason","原文详细说明了MCF卖家在独立站启用Prime配送的零成本条件及新定价计划的折扣幅度，为多平台运营提供了具体的物流降本方案。","source",{"_9":87,"_88":89,"_90":91,"_92":40,"_93":-5},"links",{"_84":85,"_67":86},"publishedAt","2026-09-24T10:41:11.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:20:07.495Z","timelineAt","category","fba","tags",[81,82,83],"score",62,"selected",true,"channel","x","story",{"_72":73,"_74":52,"_75":76,"_77":78,"_79":-5,"_45":80},"media",[],"byline","detailedGuide","readingMode","full","author","amazonnews","language","zxx","body",{"_68":-5,"_67":69,"_70":-5,"_71":40},"outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","zh","<p>https://x.com/i/article/2103071373094453248</p>","zhKind","complete","authorName","Amazon News","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"AI/工具","FBA/物流","亚马逊","aihot","/items/pvd22wxo126gpvlmmbllrnqlg","https://x.com/amazonnews/status/2103072248504434688","x-amazon-news","name","X · Amazon News","kind","x_search","firstParty","iconUrl",{"_95":96},"changelogVersion","2026-10-09T22:08"]
