[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","pwgwhalt9my4f3nw1za9pjbia","revision",2,"title","Mike Begg 分享亚马逊补剂品牌通过“Flat-Spend Lift”策略在广告支出仅增 0.9% 时实现周销增长 $1,253","originalTitle","How a supplements brand added $1,253 a week in PPC sales on 0.9% more ad spend","summary","Mike Begg 分享亚马逊补剂品牌采用“Flat-Spend Lift”策略，在广告支出仅增加 0.9% 的情况下，使每周 PPC 销售额从 $7,440 增至 $8,693（增长约 $1,253）。该案例显示，通过优化高转化关键词出价、降低低效目标出价并将预算重新分配至表现更好的活动，ACoS 从 35.8% 降至 30.9%，TACoS 从 12.6% 降至 9.0%。","reason","source",{"_9":101,"_102":54,"_83":103,"_104":40,"_105":106,"_107":108},"links",{"_98":99,"_68":100},"publishedAt","2026-10-12T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-12","discoveredAt","2026-10-12T15:15:27.241Z","timelineAt","category","advertising","tags",[96,97],"score",34,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[82],"byline",{"_53":-5,"_81":54},"detailedGuide","readingMode","full","author","Mike Begg","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f521047JI1tE",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","6594bf58-94ec-4a36-bfad-c475c299b57e","亚马逊补剂品牌平价提效案例",{"_77":78,"_13":79},"platform",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":92,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/adaa9617d61903e4.webp","fullUrl","/amznews-reading-preview/_img/adaa9617d61903e4.webp","srcSet","/amznews-reading-preview/_img/adaa9617d61903e4.webp 336w, /amznews-reading-preview/_img/adaa