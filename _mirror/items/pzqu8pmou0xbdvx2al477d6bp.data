[{"_1":2,"_3":4},"root",{"_5":145},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","pzqu8pmou0xbdvx2al477d6bp","revision",4,"title","亚马逊扩展 Seller Central 多渠道管理并推出 MCF 新激励","originalTitle","Amazon Multichannel, AI Agents & a $275B Holiday Forecast","summary","亚马逊将 Seller Central 扩展为可连接 eBay、Shopify、TikTok Shop 及 Walmart 的多渠道管理环境，支持导入商品、查看订单并使用亚马逊履约。原文称，Amazon Supply Chain Services 客户在使用 Multichannel Fulfillment 时，可为其自有网站新增 Prime 配送且无需额外费用；MCF Preferred Pricing 则依据符合条件的销量，将履约费用降低 15% 至 25%。原文来自该机构，存在相关商业利益，并非独立测评。","reason","source",{"_9":136,"_137":138,"_77":139,"_140":39,"_141":142,"_143":144},"links",{"_133":134,"_65":135},"publishedAt","2026-09-30T14:00:48.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-11T18:46:08.796Z","timelineAt","category","policy","tags",[129,130,131,132],"score",41,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":-5,"_66":67},"detailedGuide","readingMode","full","author","Bellavix","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","BellaVix",{"_77":78,"_79":124,"_81":125,"_83":126,"_85":127,"_87":128,"_89":-5,"_90":-5},{"_77":78,"_79":119,"_81":120,"_83":121,"_85":122,"_87":123,"_89":-5,"_90":-5},{"_77":78,"_79":115,"_81":116,"_83":117,"_85":118,"_87":99,"_89":-5,"_90":-5},{"_77":78,"_79":110,"_81":111,"_83":112,"_85":113,"_87":114,"_89":-5,"_90":-5},{"_77":78,"_79":105,"_81":106,"_83":107,"_85":108,"_87":109,"_89":-5,"_90":-5},{"_77":78,"_79":100,"_81":101,"_83":102,"_85":103,"_87":104,"_89":-5,"_90":-5},{"_77":78,"_79":96,"_81":97,"_83":98,"_85":86,"_87":99,