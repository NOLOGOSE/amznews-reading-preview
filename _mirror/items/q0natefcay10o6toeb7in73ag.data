[{"_1":2,"_3":4},"root",{"_5":133},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","q0natefcay10o6toeb7in73ag","revision",1,"title","亚马逊发布由智能体式 AI 驱动的亚马逊 AI 广告平台","originalTitle","Meet Amazon Ads Agent, your AI-powered ad platform","summary","在 2026 年 unBoxed 大会上，亚马逊广告发布了由智能体式 AI 驱动的“亚马逊 AI 广告平台”，将搜索、展示视频音频及全流域广告整合至统一界面。该平台包含面向美国所有广告主开放的全流域广告活动（利用 AI 跨格式共享信号并自动优化）以及将于 10 月下旬推出的 DVA+（简化程序化购买体验）。","reason","原文介绍了亚马逊 AI 广告平台及其核心功能全流域广告活动，展示了其整合多种广告形式并利用 AI 自动优化的能力。","source",{"_9":124,"_125":126,"_76":127,"_128":41,"_129":130,"_131":132},"links",{"_121":122,"_66":123},"publishedAt","2026-09-29T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-29","discoveredAt","2026-10-22T17:24:11.070Z","timelineAt","category","advertising","tags",[117,118,119,120],"score",62,"selected",true,"channel","news","story","x","media",[69,70,71,72,73,74,75],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","亚马逊广告",{"_76":77,"_78":112,"_80":113,"_82":114,"_84":115,"_86":116,"_87":-5,"_88":-5},{"_76":77,"_78":107,"_80":108,"_82":109,"_84":110,"_86":111,"_87":-5,"_88":-5},{"_76":77,"_78":104,"_80":105,"_82":106,"_84":102,"_86":103,"_87":-5,"_88":-5},{"_76":77,"_78":99,"_80":100,"_82":101,"_84":102,"_86":103,"_87":-5,"_88":-5},{"_76":77,"_78":94,"_80":95,"_82":96,"_84":97,"_86":98,"_87":-5,"_88":-5},{"_76":77,"_78":89,"_80":90,"_82":91,"_84":92,"_86":93,"_87":-5,"_88":-5},{"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":85,"_87":-5,"_88":-5},"kind","image","url","/amznews-reading-preview/_img/a6