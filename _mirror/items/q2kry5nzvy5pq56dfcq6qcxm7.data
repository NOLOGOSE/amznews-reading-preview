[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","q2kry5nzvy5pq56dfcq6qcxm7","revision",1,"title","商务部公布中美贸易理事会及“300亿对300亿”对等降税框架有关情况","originalTitle","商务部公布中美贸易理事会和“300亿对300亿”对等降税框架有关情况","summary","商务部公布中美双方就建立政府间贸易理事会及“300亿对300亿”对等降税框架达成的共识。双方商定，对各自规模约为300亿美元（参照2024年度双边贸易额）的进口产品，在符合双方各自国内法律和程序的基础上，以对等方式提供降低关税待遇；其中超过90%的产品将免除相互加征的全部关税，享受最惠国关税待遇。后续双方将在履行各自国内相关法律程序后，同步实施降税。","reason","原文披露了中美贸易理事会工作规程、300亿美元对等降税框架的产品清单及实施条件，并明确降税须在符合双方各自国内法律和程序的基础上、履行相关程序后同步实施。","source",{"_9":74,"_75":76,"_77":78,"_79":41,"_80":-5},"links",{"_71":72,"_66":73},"publishedAt","2026-09-28T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-28","discoveredAt","2026-10-17T05:16:20.993Z","timelineAt","category","policy","tags",[69,70],"score",67,"selected",true,"channel","news","story","x","media",[],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","商务部","政策/合规","行业动态","aihot","/items/q2kry5nzvy5pq56dfcq6qcxm7","https://www.mofcom.gov.cn/xwfb/rcxwfb/art/2026/art_7f879be341ec4137a22f6d0360a5a291.html","official-cn-mofcom-press","name","商务部 · 新闻发布","kind","web_list","firstParty","iconUrl",{"_82":83},"changelogVersion","2026-10-09T22:08"]
