[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","q2oi9g5xbekxa3mkhlb63yupd","revision",1,"title","亚马逊卖家PPC点击价值计算法","originalTitle","Simple PPC math I wish more sellers used:","summary","我希望更多卖家使用的简单 PPC 数学：\n\n一次点击对你来说实际值多少收入？\n\n如果一个关键词转化率为 10%，AOV 为 $30，那么该点击平均产生约 $3 的收入。\n\n由此你可以反推你能承受的出价。\n\n出价变得不再那么情绪化。","reason","source",{"_9":85,"_86":87,"_88":89,"_90":39,"_91":-5},"links",{"_82":83,"_66":84},"publishedAt","2026-10-14T00:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.595Z","timelineAt","category","advertising","tags",[80,81],"score",38,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Evan_Swanson_","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Simple PPC math I wish more sellers used:</p><p>How much revenue is a click actually worth to you?</p><p>If a keyword converts 10% and AOV is $30, that click produces ~$3 in revenue on average.</p><p>From there you can back into what you can afford to pay.</p><p>Bids become way less emotional.</p>","zhKind","complete","authorName","Evan Swanson","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"广告/运营","关键词","aihot","/items/q2oi9g5xbekxa3mkhlb63yupd","https://x.com/Evan_Swanson_/status/2110166195962093739","x-evan-swanson","name","X · Evan Swanson","kind","x_search","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
