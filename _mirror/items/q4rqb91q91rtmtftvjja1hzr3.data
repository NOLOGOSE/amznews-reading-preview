[{"_1":2,"_3":4},"root",{"_5":140},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","q4rqb91q91rtmtftvjja1hzr3","revision",2,"title","亚马逊全美多地FBA仓库爆仓致入仓延迟，卖家旺季备货面临双重压力","originalTitle","FBA爆仓蔓延全美，今年旺季卖家比以往更被动！","summary","原文由枫筝国际发布，该机构在文末推广其在美国、加拿大的海外仓服务，存在相关商业利益，并非独立测评。原文称亚马逊美西、美中、美东等地FBA仓库出现拥堵，部分核心仓库拒收率最高达90%，入仓周期从正常的3到5天拉长至10到21天；原文将原因归于Prime Day提前备货、巴拿马运河限流及黑五集中出货等多重因素叠加。上述仓库拥堵与时效数据来自原文自述，本站尚未独立核验。","reason","source",{"_9":131,"_132":133,"_90":134,"_135":39,"_136":137,"_138":139},"links",{"_128":129,"_67":130},"publishedAt","2026-10-19T02:15:55.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T03:57:35.561Z","timelineAt","category","fba","tags",[123,124,125,126,127],"score",55,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83,84,85,86,87,88,89],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","枫筝国际","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":12,"_72":73,"_74":75},"hasTranslation","bodyLanguage","original","factId","fNJwDSXZ1tCg",{"_76":77,"_13":78},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","5cfa749d-785d-4a90-86a8-2c88d423eca0","亚马逊美国站FBA旺季爆仓与入仓截止线",{"_76":77,"_13":78},"platform","雨果跨境",{"_90":91,"_92":120,"_94":121,"_96":122,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":117,"_94":118,"_96":119,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":114,"_94":115,"_96":116,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":111,"_94":112,"_96":113,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":108,"_94":109,"_96":110,"_98":-5,"_99":-5,"_100":-5,"_