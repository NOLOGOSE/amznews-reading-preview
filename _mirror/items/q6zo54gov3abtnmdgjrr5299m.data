[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","q6zo54gov3abtnmdgjrr5299m","revision",7,"title","历史案例：FDA 对 Umary、Amazy 未标示药物成分的警示","originalTitle","FDA warns consumers not to purchase or use Umary and Amazy products as they may be harmful to your health","summary","FDA 原文以2024年9月5日为警示日期，页面注明2024年10月9日更新；这是历史案例。公告针对以膳食补充剂推广的 Umary、Amazy 及名称变体，称这些产品曾在包括 Amazon、SoloVital、Main Products 的多个网站和部分实体店销售。FDA 实验室在某些产品中发现标签未列出的双氯芬酸和奥美拉唑，并说明相关健康风险；这是 FDA 的检测结论，不是本站实测，也不能推广到所有补充剂。原文提及2024年7月 Main Products 与 SoloVital 召回 Umary，不把该事实扩写成 Amazon 当前全站召回。消费者关注、医疗咨询和不良事件报告入口请查原公告。本站建议相关卖家核对配料标签、供应材料与具体产品通知；本站未核对当前在售状态，不提供诊断、用药或收益建议，不保证个案合规。本文为原创导读，出处 FDA，收录不表示官方认可本站。","reason","source",{"_9":90,"_91":66,"_69":92,"_93":60,"_94":-5},"links",{"_87":88,"_64":89},"publishedAt","2024-10-09T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-03T08:10:16.781Z","timelineAt","category","policy","tags",[84,85,86],"score",34,"selected",false,"channel","news","story","x","media",[67,68],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FDA 美国食品药品监督管理局",{"_69":70,"_71":81,"_73":82,"_75":83,"_77":-5,"_78":-5,"_79":-5,"_80":-5},{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/5ffed032318efcac.webp","fullUrl","/amznews-reading-preview/_img/5ffed032318efcac.webp","srcSet","/amznews-reading-preview/_img/5ffed032318efcac.webp 336w, /amznews-reading-preview/_img/5ffed032318efcac.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/8a7271e1bb29fd60.webp","/amznews-reading-preview/_img/8a7271e1bb29fd60.webp","/amznews-reading-preview/_img/8a7271e1bb29fd60.webp 336w, /amznews-reading-preview/_img/8a7271e1bb29fd60.webp 720w","政策/合规","合规税务","亚马逊","aihot","/items/q6zo54gov3abtnmdgjrr5299m","https://www.fda.gov/drugs/drug-safety-and-availability/fda-warns-consumers-not-purchase-or-use-umary-and-amazy-products-they-may-be-harmful-your-health","official-fda-drug-alerts-reviewed","name","web_list","firstParty","iconUrl",{"_96":97},"changelogVersion","2026-10-09T22:08"]
