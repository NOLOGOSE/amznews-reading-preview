[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","q9jrh2r3zq1l65sge5wypfpjf","revision",2,"title","亚马逊拟70亿美元收购AI公司Decart，交易尚未确认","originalTitle","重磅！亚马逊拟砸70亿美元收购AI公司","summary","据《华尔街日报》报道，亚马逊正洽谈以约70亿美元收购以色列AI初创公司Decart，该交易目前尚未得到双方正式确认。Decart的核心技术DOS旨在优化AI模型在英伟达、Trainium等不同硬件上的运行效率。若交易落地，可能通过降低广告素材生成成本、改变商品发现方式及提升物流自动化水平，间接影响亚马逊卖家的运营策略与费用结构。","reason","source",{"_9":102,"_103":104,"_84":105,"_106":40,"_107":108,"_109":110},"links",{"_99":100,"_68":101},"publishedAt","2026-10-18T07:59:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-18","discoveredAt","2026-10-19T03:37:38.381Z","timelineAt","category","ai-tools","tags",[96,97,98],"score",34,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","速推站外","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fYRpJCx0ghlc",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","39e83027-08d8-4e8e-98b1-7adaf386a0d0","亚马逊洽谈约70亿美元收购AI公司Decart",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/34f7945ed62f97fc.webp","fullUrl","/amznews-reading-preview/_img/34f7945ed62f97fc.webp","srcSet","/amznews-reading-preview/_img/34f7945ed62f97fc.webp 336w, /amznews-reading-preview/_img/34f7945ed62f97fc.webp 720w","width","height","alt","poster","AI/工具","亚马逊","行业动态","aihot","/items/q9jrh2r3zq1l65