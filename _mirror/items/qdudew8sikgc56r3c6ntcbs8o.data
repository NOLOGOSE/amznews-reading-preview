[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":-5,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","qdudew8sikgc56r3c6ntcbs8o","revision",2,"title","从“Chinese Junk”到“China Haul”：十年前，为什么亚马逊评论区 Made in China 常常意味着差评？②","originalTitle","从“Chinese Junk”到“China Haul”：十年前，为什么亚马逊评论区Made in China常常意味着差评？②","summary","十年前 Made in China 在亚马逊评论区常与差评挂钩，原因并非只有偏见：中国制造业增加值占全球比重从 2000 年前后约 6%—7% 升至 2015 年约 25%—26%，靠成本优势快速扩张的同时，低价竞争压低了材料、质检等环节。消费者把不同工厂的坏体验统一归到产地，好体验归给品牌；跨境电商早期刷单、刷评、侵权等违规行为又持续消耗信任，最终由后来的正规卖家承担后果。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":38,"_80":81,"_82":83},"links",{"_71":72,"_64":73},"publishedAt","2026-09-23T18:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:19.007Z","timelineAt","category","tags",[67,68,69,70],"score",17,"selected",false,"channel","news","story","x","media",[],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","跨境电商MoonSees","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123","行业动态","品牌","品类趋势","亚马逊","aihot","/items/qdudew8sikgc56r3c6ntcbs8o","https://www.amz123.com/t/8x2Gs1DJ","author-amz123-moonsees-reviewed","name","AMZ123 · 跨境电商MoonSees","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
