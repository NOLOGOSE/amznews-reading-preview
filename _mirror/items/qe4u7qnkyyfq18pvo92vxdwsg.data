[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","qe4u7qnkyyfq18pvo92vxdwsg","revision",2,"title","亚马逊新品上架极简化广告投放策略建议","originalTitle","新品上架后的广告投放建议","summary","原文作者建议新卖家、小卖家、运营经验不熟或预算有限的卖家采用“极简化”广告投放策略：产品上架后仅设置一个自动型广告，竞价固定为1美金，预算控制在30-50美金，选择固定竞价与默认匹配，搜索结果首页顶部、其余位置和商品详情页均不加百分比，以控制成本、避免数据样本不均衡。作者建议先让广告运营1-2周，再根据实际数据调整。以上为作者个人经验观点，适用对象和条件以原文为准。","reason","source",{"_9":89,"_90":91,"_92":93,"_94":40,"_95":96,"_97":98},"links",{"_86":87,"_68":88},"publishedAt","2026-10-11T17:42:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-12","discoveredAt","2026-10-12T09:26:32.933Z","timelineAt","category","advertising","tags",[83,84,85],"score",32,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境电商赢商荟","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fXMLtQusl1PI",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","081e1494-ced4-4cf4-8222-ee43378d475e","亚马逊新品极简化广告投放策略建议",{"_77":78,"_13":79},"platform","AMZ123","广告/运营","广告投放","亚马逊","aihot","/items/qe4u7qnkyyfq18pvo92vxdwsg","https://www.amz123.com/t/zNW861nl","author-amz123-winshang-reviewed","name","AMZ123 · 跨境电商赢商荟","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_100":101},"changelogVersion","2026-10-09T22:08"]
