[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","qhqxtsebkru5cpzkhz4v6jnzu","revision",1,"title","NEWDERY 移动电源因起火和烧伤风险被召回，产品在 Amazon 销售","originalTitle","NEWDERY Power Banks Recalled Due to Fire and Burn Hazards; Risk of Serious Injury; Sold on Amazon","summary","美国消费品安全委员会宣布召回约 21,380 个 NEWDERY 移动电源（型号 ZHX-PB22），该产品锂电池可能爆炸或起火，已收到 9 起爆炸起火报告，含 1 起造成 200 万美元财产损失的严重火灾和 1 起烧伤。产品于 2023 年 10 月至 2024 年 11 月在 Amazon.com 以 27 至 50 美元售出，消费者应立即停用并联系 NEWDERY 获取全额退款。","reason","source",{"_9":73,"_74":66,"_75":76,"_77":60,"_78":79,"_80":81},"links",{"_70":71,"_64":72},"publishedAt","2026-09-24T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T14:12:19.627Z","timelineAt","category","policy","tags",[67,68,69],"score",36,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","退货管理","aihot","/items/qhqxtsebkru5cpzkhz4v6jnzu","https://cpsc.gov/Recalls/2026/NEWDERY-Power-Banks-Recalled-Due-to-Fire-and-Burn-Hazards-Risk-of-Serious-Injury-Sold-on-Amazon","official-cpsc-amazon-recalls-reviewed","name","kind","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp","iconSrcSet","/amznews-reading-preview/_img/382881c3aef48a1a.webp 48w, /amznews-reading-preview/_img/382881c3aef48a1a.webp 96w",{"_83":84},"changelogVersion","2026-10-09T22:08"]
