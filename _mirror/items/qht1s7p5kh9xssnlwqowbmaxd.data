[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","qht1s7p5kh9xssnlwqowbmaxd","revision",2,"title","空运正成为解决库存问题的昂贵手段","originalTitle","Air freight is becoming a costly fix for inventory issues","summary","面对亚洲港口拥堵和供应链中断，Capri、Figs 等品牌正选择性使用空运加速补货。Capri 高管在财报电话会上称 Michael Kors 库存同比降 25%，一季度营收下滑 7.1%，全年营收预期下调至 34 亿美元。IATA 数据显示航空燃油价格仍比 2025 年高出近 46%，Xeneta 报告预计运价今年将维持高位。","reason","source",{"_9":76,"_77":78,"_79":80,"_81":39,"_82":83,"_84":85},"links",{"_73":74,"_65":75},"publishedAt","2026-08-17T14:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-05T07:13:37.510Z","timelineAt","category","fba","tags",[68,69,70,71,72],"score",22,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Melissa Daniels","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Modern Retail","FBA/物流","供应链","库存管理","行业动态","亚马逊","aihot","/items/qht1s7p5kh9xssnlwqowbmaxd","https://www.modernretail.co/operations/air-freight-is-becoming-a-costly-fix-for-inventory-issues/","author-modern-retail-melissa-case-reviewed","name","Modern Retail · Melissa Daniels","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/feec9bcddc707257.webp","iconSrcSet","/amznews-reading-preview/_img/feec9bcddc707257.webp 48w, /amznews-reading-preview/_img/feec9bcddc707257.webp 96w",{"_87":88},"changelogVersion","2026-10-09T22:08"]
