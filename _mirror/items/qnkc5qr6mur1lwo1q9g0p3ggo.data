[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","qnkc5qr6mur1lwo1q9g0p3ggo","revision",2,"title","欧洲及地中海多国港口计划10月30日罢工，法国勒阿弗尔与马赛福斯港作业受扰","originalTitle","欧洲及地中海多国港口计划罢工，法国两大港口作业也受影响","summary","意大利USB工会等组织宣布将于10月30日在欧洲及地中海超40个港口开展联合罢工，涉及热那亚、安科纳等至少八个意大利主要港口。法国勒阿弗尔港诺曼底码头因技术故障关闭，集装箱进出受阻且预计恢复后面临拥堵；马赛福斯港此前也因CGT号召的罢工导致装卸运输受影响。","reason","source",{"_9":109,"_110":111,"_86":112,"_113":40,"_114":115,"_116":117},"links",{"_106":107,"_68":108},"publishedAt","2026-10-20T23:13:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-21T09:30:11.251Z","timelineAt","category","fba","tags",[104,105],"score",42,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","运无界跨境物流聚合平台","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f6ZN-nNID2-8",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","80e0d824-b5a7-4280-a78c-05e0162488e1","欧洲及地中海多国港口拟10月30日联合罢工",{"_77":78,"_13":79},"platform","AMZ123",{"_86":87,"_88":101,"_90":102,"_92":103,"_94":-5,"_95":-5,"_96":-5,"_97":-5},{"_86":87,"_88":98,"_90":99,"_92":100,"_94":-5,"_95":-5,"_96":-5,"_97":-5},{"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":-5,"_96":-5,"_97":-5},"kind","image","url","/amznews-reading-preview/_img/dd0a8e26cf1e9227.webp","fullUrl","/amznews-reading-preview/_img/dd0a8e26cf1e9227.webp","srcSet","/amznews-reading-preview/_img/dd0a8e26cf1e9227.webp 336w, /am