[{"_1":2,"_3":4},"root",{"_5":120},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","qny6lz83jjrjxhpkeavv42jjx","revision",2,"title","德国包装新规实施：境外卖家需指定包装EPR授权代表","originalTitle","德国包装新规已实施：已有欧代，还要指定授权代表吗？","summary","自2026年8月12日起，无德国分支机构且直接向德国终端用户提供带包装商品的境外企业，须指定符合要求的德国包装EPR授权代表。该义务独立于产品欧代，已有LUCID注册号的卖家需核实并补充资料；同一生产者仅可指定一名授权代表，且协议须以德语签署并经系统确认生效。","reason","原文梳理了德国包装EPR授权代表与产品欧代的区别，并给出了LUCID资料更新的具体核查步骤。","source",{"_9":111,"_112":113,"_87":114,"_115":67,"_116":117,"_118":119},"links",{"_108":109,"_69":110},"publishedAt","2026-10-22T03:41:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-23T01:40:37.264Z","timelineAt","category","policy","tags",[105,106,107],"score",72,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","腾邦说跨境","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":76,"_77":76},"hasTranslation",false,"bodyLanguage","original","factId","fap0sW-Kflfo",{"_78":79,"_13":80},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","e0e689ef-33d9-4bc4-810e-c3f31fa0e4bd","德国包装EPR新规：境外卖家须指定授权代表",{"_78":79,"_13":80},"platform","AMZ123",{"_87":88,"_89":102,"_91":103,"_93":104,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":99,"_91":100,"_93":101,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5,"_97":-5,"_98":-5},"kind","image","url","/amznews-reading-preview/_img/4168240fd2c3d7e0.webp","fullUrl","/amznews-reading-preview/_img/4168240fd2c3d7e0.webp","srcSet","/amznews-reading-previ