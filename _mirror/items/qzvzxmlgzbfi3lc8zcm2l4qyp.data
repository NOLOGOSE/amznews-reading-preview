[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","qzvzxmlgzbfi3lc8zcm2l4qyp","revision",8,"title","库存缺口方法：先估算可售天数，再调整广告节奏","originalTitle","亚马逊链接马上断货，广告到底怎么调？","summary","Regan跨境在2026年9月20日提出作者运营方法：先核对真正可售的库存、补货可售间隔和预计自然订单，再以“库存÷间隔天数－自然日均订单”估算广告可贡献的订单参考值；若自然订单已超过库存承受量，应先暂停扩量并处理补货。按流量价值、竞价、预算依次调整，用实际总订单复盘。覆盖率分档、缓冲天数与恢复比例均是作者建议，不是亚马逊强制标准；补货和销量会变化，示例未经本站实测，也不保证排名恢复。本文为原创方法摘要，页面商业推广不作推荐。","reason","source",{"_9":121,"_122":123,"_77":124,"_125":39,"_126":127,"_128":129},"links",{"_118":119,"_65":120},"publishedAt","2026-09-19T18:06:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-02T01:54:55.604Z","timelineAt","category","advertising","tags",[113,114,115,116,117],"score",61,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Regan跨境","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_77":78,"_79":110,"_81":111,"_83":112,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":107,"_81":108,"_83":109,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":104,"_81":105,"_83":106,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":98,"_81":99,"_83":100,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":95,"_81":96,"_83":97,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":92,"_81":93,"_83":94,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":