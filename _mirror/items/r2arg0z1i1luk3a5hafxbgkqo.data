[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","r2arg0z1i1luk3a5hafxbgkqo","revision",2,"title","亚马逊宣布推出Listing保护机制，AHA卖家商品审核期间或可继续销售","originalTitle","新政！亚马逊将推出listing保护机制！Listing被判违规或可继续销售","summary","亚马逊在2026年9月22日至24日西雅图Accelerate大会上宣布推出Listing Protection（listing保护机制）。据大会说明，在大多数情况下，商品被判定违规后，Listing可在卖家处理问题期间保持正常售卖，并提供处理步骤和错误判定申诉通道。该机制适用对象为AHA卖家，即账户健康评分（AHR）保持在250分以上持续6个月、期间低于250分的天数不超过10天的专业卖家，符合条件后自动纳入；美国站预计2026年底前覆盖AHA卖家，2027年扩展至全球。原文同时介绍Seller Challenge申诉机制，并提示具体适用范围、执行细节及开放进度以亚马逊后续正式政策和卖家平台通知为准。","reason","原文梳理了亚马逊在Accelerate大会宣布的Listing Protection机制，说明其适用对象为AHA卖家，并列出AHR 250分、持续6个月、低于250分不超过10天等资格条件及美国站2026年底、2027年全球的落地安排；同时提示细节以正式政策为准，未将大会说明表述为已生效结论。","source",{"_9":103,"_104":105,"_85":106,"_107":66,"_108":109,"_110":111},"links",{"_100":101,"_68":102},"publishedAt","2026-10-19T06:38:36.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T06:53:39.723Z","timelineAt","category","policy","tags",[97,98,99],"score",62,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84],"byline",{"_53":54,"_82":83},"detailedGuide","readingMode","full","author","董海温","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","feo6IK5EleFM",{"_78":79,"_13":80},"reportCount",7,"additionalSourceCount",3,"developmentCount",0,"publicId","dd0d4720-1478-41f4-b385-9924666d8024","亚马逊公布Listing Protection机制：AHA卖家违规审核期可继续销售",{"_78":79,"_13":80},"platform","雨果跨境",{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/0055a76c6eb82370.webp","fullUrl","/amznews-reading-preview/_img/0055a76c6eb82370.webp","srcSet","/amznews-reading-preview/_img/0055a76c6eb82370.webp 336w, /amznews-reading-preview/_img/0055a76c6eb82370.webp 720w","width","height","alt","poster","政策/合规","Listing优化","亚马逊","aihot","/items/r2arg0z1i1luk3a5hafxbgkqo","https://www.cifnews.com/article/189503","publisher-cifnews-amazon","name","雨果跨境 · 亚马逊频道最新","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp","iconSrcSet","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 48w, /amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 96w",{"_113":114},"changelogVersion","2026-10-09T22:08"]
