[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","r2bigge2c1tzion3hv1pobao6","revision",1,"title","G20 贸易部长会议主席声明：就食品武器化达成共识，未就强迫劳动达成一致","originalTitle","Chair’s Statement of the G20 Trade Ministerial","summary","G20 贸易部长会议主席 Jamieson Greer 宣布，G20 成员在密尔沃基会议上就反对通过胁迫性贸易行动将食品武器化达成共识。尽管美国、墨西哥和阿根廷联合发表声明呼吁消除全球供应链中的强迫劳动，但 G20 未能就此议题达成一致。此外，部分成员拒绝建立针对结构性产能过剩的合作行动路径，但各方同意继续探讨改进最惠国待遇（MFN）原则以适应当前全球贸易环境。","reason","source",{"_9":72,"_73":74,"_75":76,"_77":60,"_78":79,"_80":81},"links",{"_69":70,"_64":71},"publishedAt","2026-10-02T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T09:19:32.339Z","timelineAt","category","policy","tags",[67,68],"score",10,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","USTR","政策/合规","供应链","aihot","/items/r2bigge2c1tzion3hv1pobao6","https://ustr.gov/about/policy-offices/press-office/press-releases/2026/october/chairs-statement-g20-trade-ministerial","official-ustr-press-releases-rolling","name","USTR 美国贸易代表办公室公告","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/dbeb162d0fa0fbc6.webp","iconSrcSet","/amznews-reading-preview/_img/dbeb162d0fa0fbc6.webp 48w, /amznews-reading-preview/_img/dbeb162d0fa0fbc6.webp 96w",{"_83":84},"changelogVersion","2026-10-09T22:08"]
