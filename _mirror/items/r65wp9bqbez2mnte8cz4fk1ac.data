[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","r65wp9bqbez2mnte8cz4fk1ac","revision",2,"title","亚马逊广告新增分时定价功能怎么用？船长BI分时调价功能解析","originalTitle","亚马逊广告又调整了，新增的分时定价功能怎么用效果好？","summary","亚马逊后台已向部分卖家开放分时定价功能，可按每周、每天时段增加广告溢价，目前仅适用于商品推广活动，且只能调高竞价、需单店铺调整。船长BI自述其分时调价、分时预算和智能投放功能支持按24小时自定义竞价、多店铺一键管理，智能投放可设10个指标自动执行，最多应用到500个广告对象。","reason","source",{"_9":121,"_122":123,"_77":124,"_125":39,"_126":127,"_128":129},"links",{"_118":119,"_65":120},"publishedAt","2023-10-27T00:32:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T20:09:32.535Z","timelineAt","category","advertising","tags",[113,114,115,116,117],"score",38,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","船长BI","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_77":78,"_79":110,"_81":111,"_83":112,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":107,"_81":108,"_83":109,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":104,"_81":105,"_83":106,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":98,"_81":99,"_83":100,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":95,"_81":96,"_83":97,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":92,"_81":93,"_83":94,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":-5,"_87":-5,"_88":-5},"kind",