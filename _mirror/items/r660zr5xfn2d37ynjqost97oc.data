[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","r660zr5xfn2d37ynjqost97oc","revision",3,"title","产品用15%折扣两周把核心大词推到前5，但广告ACOS很高，该现在调广告还是等折扣取消后再调？","originalTitle","亚马逊价格折扣打排名问题：产品用15%折扣两周把核心大词从20名外推到前5，自然单量提升了但广告ACOS很高，我该现在调整广告，还是等折扣取消后再调整？具体该怎么调？","summary","卖家反馈一款产品开有3组精准大词词组广告、2组精准大词精准广告及自动紧密、自动同类各1组，因关键词排名差做了15%价格折扣，约两周后几个核心大词从20名开外进入前5，自然单量提升不少，但投放的几组广告出单仍不理想、ACOS很高（TACOS还可以），其也有降低广告预算的想法。卖家现纠结是立即调整广告、等折扣取消后再调整，还是有更优方案。","reason","source",{"_9":76,"_77":67,"_78":79,"_80":39,"_81":82,"_83":84},"links",{"_73":74,"_65":75},"publishedAt","2026-09-28T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:45:54.283Z","timelineAt","category","advertising","tags",[68,69,70,71,72],"score",29,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","zxy雨痕","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","广告/运营","广告投放","关键词","Listing优化","亚马逊","aihot","/items/r660zr5xfn2d37ynjqost97oc","https://www.wearesellers.com/question/125023","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_86":87},"changelogVersion","2026-10-09T22:08"]
