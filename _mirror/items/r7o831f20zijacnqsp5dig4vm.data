[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","r7o831f20zijacnqsp5dig4vm","revision",1,"title","韩国美妆出口规模与西方品牌采用韩系配方的讨论","originalTitle","K-beauty just crossed an interesting threshold.","summary","作者在X帖文中称，韩国化妆品去年出口额达114亿美元，超过美国升至全球第二；并提到Yepoda、hwarang'、MiiN等西方品牌采用韩系配方、制造和命名方式在本土市场销售，AXIS-Y获MBK Partners约40%少数股权、估值约4300亿韩元，创始人保留60%股权和管理控制权。作者还称亚马逊美国站部分单品月营收预计达六位数。上述出口、融资和营收数字均为作者自述，本站尚未独立核验；帖文涉及相关品牌与投资方，存在商业利益，并非独立测评。作者据此提出K-beauty是否正从产地标签转向配方与制造标准、全球优先策略是否成为新默认路径、美国零售是否成为下一争夺点等问题，均属作者观点与讨论框架。","reason","source",{"_9":100,"_101":102,"_81":103,"_104":39,"_105":-5},"links",{"_97":98,"_66":99},"publishedAt","2026-09-07T17:06:17.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:42:17.612Z","timelineAt","category","product","tags",[93,94,95,96],"score",40,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Rambler_Amz","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>K-beauty just crossed an interesting threshold.</p><p>Korea's cosmetics exports hit $11.4B last year, enough to push Korea past the U.S. into #2 globally, behind only France. Exports to Europe were up 62.4% in H1 2026 alone.</p><p>But the more interesting shift isn't the export number. It's who's exporting the category now.</p><p>Brands like Yepoda (Berlin), hwarang' (Finland), and MiiN (Barcelona) aren't Korean companies selling into the West, they're Western companies adopting Korean formulation, manufacturing, and naming conventions to sell K-beauty to their own local markets. MiiN alone runs 55+ stores across five European countries and is growing revenue ~40% a year.</p><p>On the brand side, the capital is following. AXIS-Y - a vegan, climate-inspired skincare brand that built 90%+ of its revenue outside Korea before it even launched properly at home, just brought in MBK Partners for a 40% minority stake at a ~KRW 430B valuation. Founder keeps 60% and full management control. Twenty million+ units sold of one hero serum, no funding round required to get there.</p><p>And on Amazon US specifically, the category is showing real depth beyond the headline brands, some individual hero SKUs alone are estimated to be moving well into six figures in monthly revenue.</p><p>A few questions this raises for anyone building or investing in this space:</p><p>&gt; Is \"K-beauty\" becoming a formulation/manufacturing standard rather than a country-of-origin label?</p><p>&gt; Does global-first, domestic-second (like AXIS-Y) become the new default playbook for the next wave of brands?</p><p>&gt; With PE now pricing K-beauty brands at scale, does US retail (Amazon, Target, Ulta) become the next major land-grab?</p>","zhKind","complete","authorName","Rambler | X -Amazonian | Account Health Expert |","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[80],{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1080,"height",1350,"alt","poster","选品/市场","品类趋势","品牌","亚马逊","aihot","/items/r7o831f20zijacnqsp5dig4vm","https://x.com/Rambler_Amz/status/2097008565273899095","x-rambler-amz","name","X · Rambler","x_search","firstParty","iconUrl",{"_107":108},"changelogVersion","2026-10-09T22:08"]
