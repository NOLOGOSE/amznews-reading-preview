[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","r8nntvx9hq7c0xuszya94o9ke","revision",1,"title","卖家自述12个月内替换10类工具","originalTitle","Tools I’ve replaced in the last 12 months for our 8 figure business:","summary","一位自称经营8位数规模业务的卖家在X上列出过去12个月替换掉的Typeform、TripleWhale、Zapier、Alchemer、多个Shopify应用、联盟管理、CRM、供应链管理、约90%客服工单流程及社交聆听工具，并列出仍在使用的Airtable、Klaviyo、Canva、Frame、Google套件和Figma。作者称节省了数万（原文未标明币种）并减少40-60%重复性任务，但强调这套做法因适配自身团队、无需扩展到100个业务才有效，属于作者个人经验，本站尚未独立核验。作者还称常与中小企业通话展示其系统，存在相关商业利益，并非独立测评。","reason","source",{"_9":85,"_86":87,"_88":89,"_90":39,"_91":-5},"links",{"_82":83,"_66":84},"publishedAt","2026-09-23T02:49:07.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.625Z","timelineAt","category","ai-tools","tags",[80,81],"score",18,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","SaulSellsStuff","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Tools I’ve replaced in the last 12 months for our 8 figure business:</p><p>1. Typeform<br>2. TripleWhale<br>3. Zapier<br>4. Alchemer<br>5. Many Shopify apps<br>6. Affiliate management <br>7. CRMs<br>8. Supply Chain Management <br>9. 90% of CS ticket pipeline <br>10. Social listening tools</p><p>Tools we still use:<br>1. Airtable <br>2 Klaviyo <br>3. Canva <br>4. Frame<br>5. Google suite <br>6. Figma</p><p>Saved tens of thousands and plainly have just reduced 40-60% of the repetitive tasks so the team gets to focus on the human ones.</p><p>This works really well because it’s built for our team. The principles behind these work well for lots of team but I’m smart enough to know what I have works because it doesn’t need to scale to 100 businesses.</p><p>I take calls often now with SMBs and show them what’s built but more so talk about why they work and the structure that makes it easier to build more on top. So they can do the same.</p><p>The hard part eventually is really not what you can build but more what you should spend time building. Because you can lose a week on a feature nobody really needs because it sounds cool, or you can built something in 2 hours that will have a meaningful impact on your team the same day.</p>","zhKind","complete","authorName","Saul","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"AI/工具","卖家工具","aihot","/items/r8nntvx9hq7c0xuszya94o9ke","https://x.com/SaulSellsStuff/status/2102591061252087821","x-saul-sells-stuff","name","X · Saul","kind","x_search","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
