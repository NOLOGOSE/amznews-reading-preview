[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","r8t36uu0ol1k9otb5z58wv0lt","revision",2,"title","亚马逊卖家协议新规：禁止转让账户及质押回款","originalTitle","Amazon Now Bans Seller Account Transfers and Revenue Pledging","summary","自2026年8月24日起，亚马逊更新《商业解决方案协议》，明确禁止卖家转让协议项下的权利或义务，并首次将质押未来回款作为担保列为违约行为。据多方报道，直接移交账号密码将被视为违规，真实的业务收购需通过卖家平台提交文件并经亚马逊审核；同时，以亚马逊回款为抵押的收入融资、商户预付款等安排面临冲突风险，但亚马逊自营贷款不受影响。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T19:01:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:23.230Z","timelineAt","category","policy","tags",[89,90,91],"score",64,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/c795cbccae121b0d.webp","fullUrl","/amznews-reading-preview/_img/c795cbccae121b0d.webp","srcSet","/amznews-reading-preview/_img/c795cbccae121b0d.webp 336w, /amznews-reading-preview/_img/c795cbccae121b0d.webp 720w","width",1600,"height",1256,"alt","poster","/amznews-reading-preview/_img/8dae0af3145f6004.webp","/amznews-reading-preview/_img/8dae0af3145f6004.webp","/amznews-reading-preview/_img/8dae0af3145f6004.webp 336w, /amznews-reading-preview/_img/8dae0af3145f6004.webp 720w",1024,538,"政策/合规","亚马逊","Seller Central","aihot","/items/r8t36uu0ol1k9otb5z58wv0lt","https://sellerelevate.com/amazon-account-transfer-revenue-pledging-ban/","publisher-sellerelevate-written-rolling","name","SellerElevate 亚马逊广告与运营文章","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/3c5cd185312c2802.webp","iconSrcSet","/amznews-reading-preview/_img/3c5cd185312c2802.webp 48w, /amznews-reading-preview/_img/3c5cd185312c2802.webp 96w",{"_105":106},"changelogVersion","2026-10-09T22:08"]
