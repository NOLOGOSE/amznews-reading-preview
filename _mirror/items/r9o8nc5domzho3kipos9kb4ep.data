[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","r9o8nc5domzho3kipos9kb4ep","revision",4,"title","广告报告历史导读：ASIN 行不能证明对手的站外流量","originalTitle","Why Are ASINs Displayed In Amazon Sponsored Products Search Terms Reports?","summary","Brandon Checketts 于2017年5月31日在 Seller Labs 解释广告搜索词报告中的 ASIN 行，2025年的修改日期不代表新稿。作者把 ASIN 与广告展示的商品页联系起来，并由此推测对手可能拥有站外流量。但一行 ASIN 本身不足以证实对手的流量来源；文内“超过一半流量”等统计也未由本站独立核实。本站不把这些推测、旧 URL 参数或广告位描述作为现行归因规则。本文可参考的阅读思路是区分报表字段、观察结果与进一步推断，避免把推测直接变成投放决策。本站建议同时记录报告类型、观察区间、广告活动和仍缺的证据，并在真实账户及当前官方材料中核对字段定义；这是本站整理的方法。发布方推广自家关键词软件，本站没有实测该工具，也不承诺优化效果。保留原文入口，本站不转载全文、译文、截图或表格。","reason","source",{"_9":97,"_98":99,"_70":100,"_101":39,"_102":103,"_104":105},"links",{"_94":95,"_65":96},"publishedAt","2017-05-31T15:00:45.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-02T23:46:13.137Z","timelineAt","category","advertising","tags",[89,90,91,92,93],"score",42,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Brandon Checketts","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Seller Labs",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/44c4f3f10384f91f.webp","fullUrl","/amznews-reading-preview/_img/44c4f3f10384f91f.webp","srcSet","/amznews-reading-preview/_img/44c4f3f10384f91f.webp 336w, /amznews-reading-preview/_img/44c4f3f10384f91f.webp 720w","width",1754,"height",122