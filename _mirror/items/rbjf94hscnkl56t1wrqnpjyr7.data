[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","rbjf94hscnkl56t1wrqnpjyr7","revision",7,"title","美国站B2B自配送：BHDR须维持90%，未改善可能影响企业客户报价","originalTitle","亚马逊Q4进入关键阶段：B2B履约、旺季费用和AI流量都有新变化","summary","Amazon官方公告要求美国站面向Amazon Business客户的自配送订单，自2026年9月30日起维持至少90%的营业时间送达率（BHDR），按滚动14天计算。若到10月30日仍未改善，相关自配送报价可能不再面向企业客户；FBA及零售报价资格不受影响。","reason","source",{"_9":89,"_90":91,"_92":93,"_94":39,"_95":96,"_97":98},"links",{"_86":87,"_67":88},"publishedAt","2026-09-30T02:54:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-09-30T08:21:08.809Z","timelineAt","category","policy","tags",[82,83,84,85],"score",58,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","跨境视频cici","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fP170A4Pkh24",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","4d0af82d-ef51-4b0e-941e-48f5df3f650c","亚马逊美国站B2B自配送90%履约率要求",{"_76":77,"_13":78},"platform","雨果跨境","政策/合规","亚马逊","FBA/物流","AI工具","aihot","/items/rbjf94hscnkl56t1wrqnpjyr7","https://www.cifnews.com/article/189235","author-cifnews-cici","name","雨果跨境 · 跨境视频cici","kind","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp","iconSrcSet","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 48w, /amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 96w",{"_100":101},"changelogVersion","2026-10-09T22:08"]
