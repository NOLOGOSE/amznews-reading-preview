[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","rboac4qh7y3tg5xxqrfkfc0sy","revision",1,"title","SimplyVAT 发布 HS Codes 2026 指南：解析分类规则与合规重要性","originalTitle","What Are HS Codes? The 2026 Guide","summary","SimplyVAT 发布《HS Codes 2026 指南》，详解由世界海关组织管理的 6 位国际通用商品编码及其在关税适用中的作用。文章指出下一版协调制度将于 2028 年 1 月 1 日生效，并区分了全球通用的 HS Code 与国家特定的 Commodity Code（如欧盟 CN、美国 HTS）。正确应用编码可避免清关延误及多缴关税，卖家需通过官方数据库查询或咨询报关行以确保合规。","reason","source",{"_9":92,"_93":94,"_70":95,"_96":39,"_97":98,"_99":100},"links",{"_89":90,"_65":91},"publishedAt","2026-09-15T15:35:08.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T18:36:26.889Z","timelineAt","category","policy","tags",[87,88],"score",40,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Eva Malpass","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SimplyVAT",{"_70":71,"_72":83,"_74":84,"_76":85,"_78":-5,"_79":-5,"_80":86,"_82":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":81,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/19083cc62767c55b.webp","fullUrl","/amznews-reading-preview/_img/19083cc62767c55b.webp","srcSet","/amznews-reading-preview/_img/19083cc62767c55b.webp 336w, /amznews-reading-preview/_img/19083cc62767c55b.webp 720w","width","height","alt","UK & EU LANDED COST CALCULATOR   Work out what a shipment will cost once it clears customs, from duty to VAT  ","poster","/amznews-reading-preview/_img/b5c1e8d75aecc4c2.webp","/amznews-reading-preview/_img/b5c1