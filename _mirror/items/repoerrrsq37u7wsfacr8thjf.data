[{"_1":2,"_3":4},"root",{"_5":124},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","repoerrrsq37u7wsfacr8thjf","revision",5,"title","多名卖家主图被改成\"亚马逊风格\"，前设计师分析主图比例尺寸","originalTitle","突发！多名卖家主图被改成“亚马逊风格”， 深度分析为什么被改的是“你”！","summary","近期有部分卖家反映主图被不明原因修改，被改后的主图均完全符合亚马逊要求且比例尺寸与亚马逊自营主图一致。一位自称半路转行亚马逊的前资深设计师结合Anker主图规范，分析了亚马逊搜索页主图展示逻辑，并给出网页端与移动端的主图比例尺寸建议，其中移动端推荐宽高比1:1.26至1:1.3、尺寸1520px*2000px。上述卖家反馈来自作者转述，未经独立验证；文中比例尺寸建议为作者个人经验，移动端流量占比等数据为作者自述，不能推广为总体结论。","reason","source",{"_9":115,"_116":117,"_76":118,"_119":39,"_120":121,"_122":123},"links",{"_112":113,"_65":114},"publishedAt","2022-06-13T23:30:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:20:58.194Z","timelineAt","category","advertising","tags",[109,110,111],"score",38,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","跨境品牌哥","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_76":77,"_78":106,"_80":107,"_82":108,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":103,"_80":104,"_82":105,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":100,"_80":101,"_82":102,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":97,"_80":98,"_82":99,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":94,"_80":95,"_82":96,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":91,"_80":92,"_82":93,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":88,"_80":89,"_82":90,"_84":-5,"_85":-5,"_86":-5,"_87":-5},{"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5,"_86":-5,"_87":-5},"ki