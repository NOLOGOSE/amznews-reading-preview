[{"_1":2,"_3":4},"root",{"_5":157},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":63,"_64":39,"_65":66},"id","resuir5rqhsx6mgczh2pe5mhq","revision",2,"title","亚马逊前员工创立 Wyze 智能家居，低价模式面临订阅涨价与安全事件考验","originalTitle","亚马逊前员工，做智能家居，登顶畅销榜，一年卖20亿","summary","四位亚马逊前工程师于 2017 年创立智能家居品牌 Wyze，以低价硬件与订阅服务组合切入市场。原文引用 ECDB 数据称其 2025 年线上业务 GMV 约 3.59 亿美元，本站尚未独立核验该引用。原文同时提到 Wyze 独立站访问量数据存在“4-9月”与“2026年3-8月”两个不同统计区间，均记为 4185 万，口径矛盾未获解释，故不采用“访问量超 eufy”的对比结论。原文还提及该品牌面临 Cam Plus 订阅费上涨、App 广告增多及隐私安全事件等挑战，其性价比优势正受到考验。","reason","source",{"_9":148,"_149":150,"_90":151,"_152":39,"_153":154,"_155":156},"links",{"_145":146,"_66":147},"publishedAt","2026-10-15T06:59:38.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:54.079Z","timelineAt","category","product","tags",[141,142,143,144],"score",26,"selected",false,"channel","news","story",{"_75":76,"_13":77},"x","media",[81,82,83,84,85,86,87,88,89],"byline",{"_52":-5,"_79":80},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[78],"indexable","markdownAvailable",true,"group",{"_67":68,"_42":69,"_70":71,"_72":73,"_74":73},"hasTranslation","bodyLanguage","original","factId","fV26zC-OMKII",{"_75":76,"_13":77},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","5ff80312-50d8-42cb-8fff-15fbb5a5f5b6","亚马逊前员工创立的Wyze：低价模式面临多重考验",{"_75":76,"_13":77},"platform","蓝海亿观网",{"_90":91,"_92":136,"_94":137,"_96":138,"_98":139,"_100":140,"_102":-5,"_103":-5},{"_90":91,"_92":132,"_94":133,"_96":134,"_98":99,"_100":135,"_102":-5,"_103":-5},{"_90":91,"_92":127,"_94":128,"_96":129,"_98":130,"_100":131,"_102":-5,"_103":-5},{"_90":91,"_92":122,"_94":123,"_96":124,"_98":125,"_100":126,"_102":