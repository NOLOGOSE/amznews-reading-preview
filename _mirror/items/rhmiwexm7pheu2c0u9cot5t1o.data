[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","rhmiwexm7pheu2c0u9cot5t1o","revision",4,"title","亚马逊要求11类增强安全商品卖家持有100万美元责任险，11月2日生效","originalTitle","11月2日生效，亚马逊要求卖家持有100万美元责任险","summary","亚马逊发布通知，自2026年11月2日起，销售儿童用品、化妆品、可食用及可摄入产品、锂电池产品等11类增强安全要求商品的卖家，无论月销售额多少都必须持有至少100万美元的商业责任保险，新商品和现有商品同样适用。","reason","亚马逊把责任险触发条件从销售额改为品类，并限定中国大陆卖家走 AIA 渠道，卖家可据此核对自身品类与投保路径。","source",{"_9":90,"_91":92,"_71":93,"_94":64,"_95":96,"_97":98},"links",{"_87":88,"_66":89},"publishedAt","2026-09-22T08:57:19.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T10:06:34.420Z","timelineAt","category","policy","tags",[83,84,85,86],"score",81,"selected",true,"channel","news","story","x","media",[70],"byline",{"_52":67,"_68":69},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","Summer","platform","AMZ123",{"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":-5,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/c9c429b1a8a2f288.webp","fullUrl","/amznews-reading-preview/_img/c9c429b1a8a2f288.webp","srcSet","/amznews-reading-preview/_img/c9c429b1a8a2f288.webp 336w, /amznews-reading-preview/_img/c9c429b1a8a2f288.webp 720w","width","height","alt","poster","政策/合规","亚马逊","合规税务","FBA/物流","aihot","/items/rhmiwexm7pheu2c0u9cot5t1o","https://www.amz123.com/t/7zPsBP3K","author-amz123-summer","name","AMZ123 · SUMMER","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, 