[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":40,"_60":61,"_62":-5,"_63":40,"_64":65},"id","ri1x5f4sd0y6h7xtx65a6hfag","revision",1,"title","亚马逊广告宣布推出品牌导购功能","originalTitle","Find the right products with Branded Conversations","summary","亚马逊广告宣布将于2027年1月推出品牌导购（Branded Conversations）功能，把品牌推广提示词升级为Alexa购物助手中的多轮品牌导购体验。该功能基于卖家现有广告活动、投放方案及预算自动启用，无需额外设置；对话开场提示词仅按CPC收费，后续对话轮次不额外收费。初期面向美国站使用品牌推广合集广告的亚马逊广告主开放，支持通过广告平台和API查看效果指标及管理智购功能。","reason","source",{"_9":90,"_91":92,"_69":93,"_94":61,"_95":96,"_97":98},"links",{"_87":88,"_65":89},"publishedAt","2026-09-29T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-29","discoveredAt","2026-10-22T17:24:11.696Z","timelineAt","category","advertising","tags",[83,84,85,86],"score",52,"selected",false,"channel","news","story","x","media",[68],"byline",{"_52":-5,"_66":67},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊广告",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/4d17a4dcaccdc195.webp","fullUrl","/amznews-reading-preview/_img/4d17a4dcaccdc195.webp","srcSet","/amznews-reading-preview/_img/4d17a4dcaccdc195.webp 336w, /amznews-reading-preview/_img/4d17a4dcaccdc195.webp 720w","width",1050,"height",536,"alt","poster","AI/工具","广告/运营","亚马逊","Amazon Ads","aihot","/items/ri1x5f4sd0y6h7xtx65a6hfag","https://advertising.amazon.com/resources/whats-new/unboxed-2026-branded-conversations/","official-amazon-ads-whats-new","name","亚马逊广告 · 产品更新","json_list","firstParty","iconUrl","/amznews-reading-preview