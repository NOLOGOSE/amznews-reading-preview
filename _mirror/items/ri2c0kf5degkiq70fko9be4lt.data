[{"_1":2,"_3":4},"root",{"_5":119},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","ri2c0kf5degkiq70fko9be4lt","revision",2,"title","亚马逊卖家称拥有自有品牌仍收到Listing下架通知","originalTitle","This is a strange one. An @amazon seller says they’ve owned and manufactured their own brand for more than 10 years, are enrolled in Bra...","summary","ASGTG社区分享一卖家案例，该卖家声称拥有并制造自有品牌超10年且已备案Brand Registry，却收到亚马逊通知将于10月28日移除其Listing，理由是品牌不再符合第三方卖家资格。亚马逊表示具有Brand Representative角色的卖家可继续销售，但此规则让实际品牌所有者感到困惑，发帖人询问是否有其他类似情况以评估影响范围。","reason","source",{"_9":113,"_114":115,"_95":116,"_117":39,"_118":-5},"links",{"_110":111,"_68":112},"publishedAt","2026-10-20T15:17:04.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-20T15:36:44.067Z","timelineAt","category","policy","tags",[107,108,109],"score",58,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","AmazonASGTG","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":73},"hasTranslation","bodyLanguage","original","factId","fK9ryMiBmucc",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","dbf445cd-5ab4-4c48-9b75-67dad0c62a93","亚马逊NWD限售通知引发卖家下架与库存担忧",{"_77":78,"_13":79},"zh","<p>This is a strange one. An @amazon  seller says they’ve owned and manufactured their own brand for more than 10 years, are enrolled in Brand Registry, and never sell third-party products.</p><p>Yet Amazon sent them this notice saying their listings will be removed October 28 because the brand is no longer eligible for third-party sellers.</p><p>Amazon says sellers with the Brand Representative role can continue selling, which makes this even more confusing for actual brand owners receiving the notice.</p><p>Has anyone else received this despite owning the brand and having the correct Brand Registry roles?</p><p>Trying to understand how widespread this is.</p>","zhKind","complete","authorName","Amazon Sellers ASGTG","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[94],{"_95":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":-5,"_106":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1083,"height",841,"alt","poster","行业动态","品牌","亚马逊","aihot","/items/ri2c0kf5degkiq70fko9be4lt","https://x.com/AmazonASGTG/status/2112563758342062527","x-amazon-asgtg","name","X · ASGTG","x_search","firstParty","iconUrl",{"_120":121},"changelogVersion","2026-10-09T22:08"]
