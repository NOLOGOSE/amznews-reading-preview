[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","rjra5h5dj4i040g1aq43a4o3d","revision",2,"title","e-Conomy SEA 2026报告：东南亚电商GMV预计达2260亿美元","originalTitle","最新报告｜东南亚电商增长18%！2026年GMV突破2260亿美元","summary","谷歌、淡马锡和贝恩公司联合发布《e-Conomy SEA 2026》报告，预计2026年东南亚数字经济GMV达3680亿美元，其中电子商务GMV为2260亿美元，同比增长18%。报告指出AI正改变消费者购物方式，六国约58%劳动年龄人口使用生成式AI，69%受访消费者用AI比较商品；平台如Lazada和Shopee也利用AI提升运营效率与用户体验。","reason","原文引用谷歌等机构联合发布的东南亚互联网经济报告，提供了2026年电商GMV预测及AI在购物决策中的具体渗透率数据。","source",{"_9":89,"_90":91,"_92":93,"_94":66,"_95":-5},"links",{"_86":87,"_68":88},"publishedAt","2026-10-23T03:33:42.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-23T04:58:30.175Z","timelineAt","category","product","tags",[83,84,85],"score",62,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境资讯通","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":12,"_73":74,"_75":76},"hasTranslation",false,"bodyLanguage","original","factId","fVD5raRKaW1Y",{"_77":78,"_13":79},"reportCount","additionalSourceCount",1,"developmentCount",0,"publicId","5cb080fd-5b05-40c4-ae60-e5c0d64bd827","e-Conomy SEA 2026：东南亚电商GMV预计2260亿美元",{"_77":78,"_13":79},"platform","卖家之家","数据/报告","品类趋势","AI工具","aihot","/items/rjra5h5dj4i040g1aq43a4o3d","https://mjzj.com/article/g223z6sfol4w","publisher-mjzj-feed","name","卖家之家 · 跨境资讯","kind","rss","firstParty","iconUrl",{"_97":98},"changelogVersion","2026-10-09T22:08"]
