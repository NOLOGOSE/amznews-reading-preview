[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","rn1e3sv9ixo1wfool8t5ddchq","revision",7,"title","Mina Elias 的历史 PPC 分组经验：原文数字存在冲突","originalTitle","Amazon PPC Campaign Structure 101","summary","Mina Elias 在 Helium 10 博客分享个人 PPC 分组经验，偏好单活动、单广告组，并讨论按相近搜索量分组。原文邀请读者测试其理论，未附独立实验数据。正文写最多 10 个关键词，FAQ 又写 30—50 个，二者冲突；FAQ 的 1000 词上限和 70% 卖家比例没有可核验出处。高搜索量词必然耗尽预算是作者观点，本文不将其列为已验证效果或当前平台规则。来源开篇推广 Helium 10 PPC 软件，存在工具商业推广关系。该材料作为历史经验阅读，不能据此直接改变当前广告设置。","reason","source",{"_9":108,"_109":110,"_72":111,"_112":39,"_113":114,"_115":116},"links",{"_105":106,"_65":107},"publishedAt","2020-08-14T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-02T03:28:06.688Z","timelineAt","category","advertising","tags",[100,101,102,103,104],"score",39,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mina Elias","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Helium 10",{"_72":73,"_74":95,"_76":96,"_78":97,"_80":98,"_82":99,"_84":-5,"_85":-5},{"_72":73,"_74":91,"_76":92,"_78":93,"_80":89,"_82":94,"_84":-5,"_85":-5},{"_72":73,"_74":86,"_76":87,"_78":88,"_80":89,"_82":90,"_84":-5,"_85":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/ee62b99fb50e592f.webp","fullUrl","/amznews-reading-preview/_img/ee62b99fb50e592f.webp","srcSet","/amznews-reading-preview/_img/ee62b99fb50e592f.webp 336w, /amznews-reading-preview/_img/ee62b99fb50e592f.webp 720w","width",699