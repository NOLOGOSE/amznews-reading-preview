[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","rpgh9efyh4ecb92bn4d5qcsh5","revision",4,"title","Seller Labs 分享用 Playwright 和 AI 解决新版 Seller Central 导航难题","originalTitle","Lost in the New Seller Central: How Playwright and AI Fix the Navigation Problem","summary","Seller Labs 提出利用 Playwright MCP 连接 AI 模型，通过读取页面结构自动定位新版 Seller Central 中隐藏的报告，以解决卖家因界面重组导致的导航困难。该方案基于作者 2026 年 10 月 5 日的实测案例，AI 代理在只读模式下四步找到“父子和子项销售”报告，无需记忆新菜单路径且能应对后续改版。","reason","source",{"_9":88,"_89":81,"_90":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_67":87},"publishedAt","2026-10-09T13:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-09T13:55:42.223Z","timelineAt","category","ai-tools","tags",[82,83,84],"score",34,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Nhan Dinh","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fMmpOUDi5L8M",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","35e53c35-348b-49b9-bcf8-c146bd1ac293","作者演示用Playwright和AI代理解决新Seller Central导航问题",{"_76":77,"_13":78},"platform","Seller Labs","AI/工具","Seller Central","亚马逊","aihot","/items/rpgh9efyh4ecb92bn4d5qcsh5","https://www.sellerlabs.com/blog/new-seller-central-navigation-ai-agent/","rss-sellerlabs-prelaunch","name","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp","iconSrcSet","/amznews-reading-preview/_img/2e4fdd2c4f