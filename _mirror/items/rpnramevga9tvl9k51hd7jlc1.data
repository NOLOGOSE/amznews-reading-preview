[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","rpnramevga9tvl9k51hd7jlc1","revision",5,"title","俄罗斯宠物用品市场5900亿卢布：湿粮半年增产16.5%，增长机会在哪？","originalTitle","summary","2025年俄罗斯宠物用品市场规模约5900亿卢布，同比增长15.8%，2026年上半年宠物商品销售额同比增长约5%—8%。同期宠物食品产量90.29万吨、同比增长10.8%，其中湿粮产量增长16.5%，贡献近三分之二新增产量，干粮仍以51.4%的产量占比居首。中央联邦管区产量占比已从2021年的72.6%降至65.3%，本地产能与零售商自有品牌扩张正改变跨境进入方式。","reason","source",{"_9":102,"_103":104,"_72":105,"_106":38,"_107":108,"_109":110},"links",{"_99":100,"_64":101},"publishedAt","2026-08-27T18:03:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T10:06:34.652Z","timelineAt","category","product","tags",[96,97,98],"score",38,"selected",false,"channel","news","story","x","media",[67,68,69,70,71],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","VIPON站外促销平台","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_72":73,"_74":93,"_76":94,"_78":95,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":90,"_76":91,"_78":92,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/9d9ee691bab2dbd1.webp","fullUrl","/amznews-reading-preview/_img/9d9ee691bab2dbd1.webp","srcSet","/amznews-reading-preview/_img/9d9ee691bab2dbd1.webp 336w, /amznews-reading-preview/_img/9d9ee691bab2dbd1.webp 720w","width","height","alt","poster","/amznews-readi