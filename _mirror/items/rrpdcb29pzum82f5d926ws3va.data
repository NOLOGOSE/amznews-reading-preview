[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","rrpdcb29pzum82f5d926ws3va","revision",2,"title","亚马逊卖家外包Listing内容制作","originalTitle","I have a designer who spends 20-30 hours a week on nothing but listing content.","summary","作者自述：他有一位设计师，每周花20-30小时专门处理商品详情页内容。作者把ASIN发给这位设计师，说明每个ASIN需要做什么（图片堆叠、A+页面、视频），设计师按优先级队列逐个处理。作者表示自己不使用Photoshop，并认为读者也不应使用。以上为作者个人经验与观点，未说明外包成本、质量控制及适用条件。","reason","source",{"_9":99,"_100":101,"_102":103,"_104":39,"_105":-5},"links",{"_96":97,"_68":98},"publishedAt","2026-10-19T18:56:05.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T18:56:39.992Z","timelineAt","category","advertising","tags",[94,95],"score",15,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","1000asins","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fsv7863Pftpw",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","c3a0185c-b24e-458e-aa5d-d9a581155fa4","亚马逊卖家外包Listing内容制作经验分享",{"_77":78,"_13":79},"zh","<p>I have a designer who spends 20-30 hours a week on nothing but listing content.</p><p>We send him the ASINs, tell him what each one needs (image stack, A+, video), and he works through a priority queue.</p><p>I'm not in Photoshop and you shouldn't be either.</p>","zhKind","complete","authorName","Dan Boufford","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"广告/运营","Listing优化","aihot","/items/rrpdcb29pzum82f5d926ws3va","https://x.com/1000asins/status/2112256487313617055","x-dan-boufford","name","X · Dan Boufford","kind","x_search","firstParty","iconUrl",{"_107":108},"changelogVersion","2026-10-09T22:08"]
