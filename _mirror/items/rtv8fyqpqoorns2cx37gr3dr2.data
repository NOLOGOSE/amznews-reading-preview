[{"_1":2,"_3":4},"root",{"_5":116},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","rtv8fyqpqoorns2cx37gr3dr2","revision",4,"title","亚马逊旺季配送费生效后站外Deal折扣测算指南","originalTitle","旺季配送费生效后，亚马逊站外Deal最低能打几折？","summary","亚马逊美国站2026年10月15日至2027年1月14日旺季配送费平均每件增加0.32美元，卖家需按SKU单独核算而非统一加价。文章通过假设案例演示，若目标利润为1.50美元且佣金率15%，最低到手价约15.42美元（约5.14折），直接五折可能导致结余不足。此外，广告位费用需按实际成交量分摊，销量低于预期将显著推高单件推广成本，建议排期前用保守数据重新校验预算与定价。","reason","source",{"_9":107,"_108":109,"_86":110,"_111":40,"_112":113,"_114":115},"links",{"_104":105,"_68":106},"publishedAt","2026-10-08T00:21:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-08","discoveredAt","2026-10-08T08:35:36.181Z","timelineAt","category","advertising","tags",[101,102,103],"score",34,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85],"byline",{"_53":54,"_82":83},"detailedGuide","readingMode","full","author","VIPON站外促销平台","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":77},"hasTranslation","bodyLanguage","original","factId","fIuQZcniLSlc",{"_78":79,"_13":80},"reportCount",3,"additionalSourceCount",2,"developmentCount",0,"publicId","b0181d64-a06a-4ce5-8781-b22fd7b0dee7","亚马逊美国站2026年旺季配送费调整",{"_78":79,"_13":80},"platform","AMZ123",{"_86":87,"_88":98,"_90":99,"_92":100,"_94":-5,"_95":-5,"_96":-5,"_97":-5},{"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":-5,"_96":-5,"_97":-5},"kind","image","url","/amznews-reading-preview/_img/2d4aec5356b4fc29.webp","fullUrl","/amznews-reading-preview/_img/2d4aec5356b4fc29.webp","srcSet","/amznews-reading-preview/_img/2d4aec5356b4fc29.webp 336w, /amznews-reading-preview/_img/