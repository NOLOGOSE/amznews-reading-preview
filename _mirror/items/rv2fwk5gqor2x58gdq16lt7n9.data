[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","rv2fwk5gqor2x58gdq16lt7n9","revision",1,"title","UPS 完成亚马逊低利润业务剥离，营收与利润双增","originalTitle","UPS shift away from Amazon shows bigger payoff","summary","UPS 在剔除亚马逊低利润包裹后实现营收增长 7.6% 至 228 亿美元，调整后运营利润提升 12%，单件收入显著增加。该公司通过关闭设施与自动化升级消除每日 200 万件亚马逊货量及 45 亿美元相关支出，目前亚马逊仅占其营收约 9%。尽管股价因下半年指引担忧下跌，管理层强调网络重构提升了运营杠杆与长期盈利能力。","reason","source",{"_9":96,"_97":98,"_70":99,"_100":39,"_101":102,"_103":104},"links",{"_93":94,"_65":95},"publishedAt","2026-07-28T19:37:31.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:42.388Z","timelineAt","category","fba","tags",[90,91,92],"score",22,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves",{"_70":71,"_72":85,"_74":86,"_76":87,"_78":88,"_80":89,"_82":83,"_84":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/9678a8e2a7fefa09.webp","fullUrl","/amznews-reading-preview/_img/9678a8e2a7fefa09.webp","srcSet","/amznews-reading-preview/_img/9678a8e2a7fefa09.webp 336w, /amznews-reading-preview/_img/9678a8e2a7fefa09.webp 720w","width",977,"height",276,"alt","","poster","/amznews-reading-preview/_img/765f13c5692c2d78.webp","/amznews-reading-preview/_img/765f13c5692c2d78.webp","/amznews-reading-preview/_img/765f13c5692c2d78.webp 336w, /amznews-reading-preview/_img/765f13c5692c2d78.webp 720w",