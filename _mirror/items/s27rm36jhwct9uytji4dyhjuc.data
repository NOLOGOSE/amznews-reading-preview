[{"_1":2,"_3":4},"root",{"_5":119},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","s27rm36jhwct9uytji4dyhjuc","revision",2,"title","亚马逊运营案例：断货期广告与售价平衡策略","originalTitle","案例拆解：运营中的广告、售价、销量、库存等要素的平衡策略建议","summary","原文作者分享亚马逊卖家在面临断货风险时，应优先控制销量而非盲目投放广告。建议采取小步涨价、降低表现差广告的竞价与预算（如从1美元降至0.3美元），或关闭低效活动以节省成本。若库存充足，可将省下的广告预算用于降价以提升转化率，实现运营要素的动态平衡。","reason","source",{"_9":110,"_111":112,"_86":113,"_114":40,"_115":116,"_117":118},"links",{"_107":108,"_68":109},"publishedAt","2026-10-21T17:04:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-22T10:06:25.679Z","timelineAt","category","advertising","tags",[104,105,106],"score",40,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境电商赢商荟","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fZT3u5qNlVXg",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","3a028a3e-ddb4-4636-abb7-2ffd8d762dcb","亚马逊卖家断货期广告与售价平衡策略案例",{"_77":78,"_13":79},"platform","AMZ123",{"_86":87,"_88":101,"_90":102,"_92":103,"_94":-5,"_95":-5,"_96":-5,"_97":-5},{"_86":87,"_88":98,"_90":99,"_92":100,"_94":-5,"_95":-5,"_96":-5,"_97":-5},{"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":-5,"_96":-5,"_97":-5},"kind","image","url","/amznews-reading-preview/_img/34f7945ed62f97fc.webp","fullUrl","/amznews-reading-preview/_img/34f7945ed62f97fc.webp","srcSet","/amznews-reading-preview/_img/34f7945ed62f97fc.webp 336w, /amznews-readin