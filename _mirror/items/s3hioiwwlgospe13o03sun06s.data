[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","s3hioiwwlgospe13o03sun06s","revision",2,"title","TikTok Shop越南站调整退货申诉规则；印尼明确配送费监管分工；越南下架11.6万件违规商品","originalTitle","卖家须在7天内申诉，TTS该站调整退货申诉规则；越南超5.1万家网店被处理；印尼三大部门分工管理配送费和平台抽佣","summary","TikTok Shop 越南站宣布自 10 月 27 日起，卖家对退款决定有异议须在 7 个自然日内提交申诉，并强化拆包及打包视频证据要求。印尼公布《2026 年第 27 号总统条例》，明确交通部、通信与数字部及中小微企业部分工管理配送费用与平台抽佣，网约客运平台服务费比例调整为 8%。","reason","source",{"_9":106,"_107":108,"_85":109,"_110":40,"_111":112,"_113":114},"links",{"_103":104,"_68":105},"publishedAt","2026-10-19T08:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-20T08:05:39.675Z","timelineAt","category","policy","tags",[100,101,102],"score",43,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境东南亚","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fv0XBq2WGNnw",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","83a59d02-fd9f-40ae-bfc5-bcd78f1a911e","东南亚电商监管动态：越南退货申诉与印尼配送费分工",{"_77":78,"_13":79},"platform","AMZ123",{"_85":86,"_87":97,"_89":98,"_91":99,"_93":-5,"_94":-5,"_95":-5,"_96":-5},{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/d154387345b4ab96.webp","fullUrl","/amznews-reading-preview/_img/d154387345b4ab96.webp","srcSet","/amznews-reading-preview/_img/d154387345b4ab96.webp 336w, /amznews-reading-previe