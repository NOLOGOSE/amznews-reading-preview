[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","s3lsxmh94kd8fxt0t70uo8nl2","revision",3,"title","深圳亚马逊卖家称月销150万店铺被核定转查账，成本增加2个点","originalTitle","深圳亚马逊店铺月销150万被核定转查账，成本多2个点、超500万还要先交后退，大家怎么扛？","summary","一名深圳亚马逊卖家称，第三季度接到深圳税局通知，跨境核定征收将改为查账征收，需正常取得进项票并按国家所得税率缴纳所得税。其深圳店铺月销约150万，改查账后成本增加两个点，超过500万后增值税需先交后退，占用13%资金；其咨询的垫付退税服务收费10%。该卖家还称深圳税局表示国税局统一发政策、后续陆续取消核定，而郑州税局称无此政策，其郑州公司核定未变。","reason","source",{"_9":74,"_75":67,"_76":77,"_78":39,"_79":80,"_81":82},"links",{"_71":72,"_65":73},"publishedAt","2026-09-20T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T12:46:21.785Z","timelineAt","category","policy","tags",[68,69,70],"score",60,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","zhj3396","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","政策/合规","合规税务","亚马逊","aihot","/items/s3lsxmh94kd8fxt0t70uo8nl2","https://www.wearesellers.com/question/124803","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
