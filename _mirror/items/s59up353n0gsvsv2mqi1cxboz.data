[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","s59up353n0gsvsv2mqi1cxboz","revision",2,"title","凯度与亚马逊联合发布白皮书，解析旺季消费者跨渠道购物行为及AI推荐策略","originalTitle","必读！旺季到了，亚马逊卖家如何提升销售效果？","summary","凯度 Kantar 与亚马逊广告联合发布《出海新视野》和《品牌破局》两份白皮书，指出消费者平均跨 4.5 个渠道、耗时约 8.8 天完成购买。数据显示 76.2% 用户在听说、查询、下单环节使用不同渠道，且 AI 助手正成为关键决策入口，在家具等品类作为“唤醒触发渠道”占比最高达 9.6%。作者 Kris 建议卖家通过多类型广告覆盖全链路，并重视视频内容及为 AI 短名单优化信息以应对旺季变化。","reason","source",{"_9":89,"_90":91,"_92":93,"_94":40,"_95":96,"_97":98},"links",{"_86":87,"_68":88},"publishedAt","2026-10-13T18:50:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-14","discoveredAt","2026-10-15T03:26:20.165Z","timelineAt","category","advertising","tags",[83,84,85],"score",35,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","Kris浩","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fEoqidZ4d5Nk",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","916b3bf8-c2da-4127-8604-bb66dfc07980","凯度与亚马逊广告发布旺季出海白皮书",{"_77":78,"_13":79},"platform","AMZ123","广告/运营","广告投放","亚马逊","aihot","/items/s59up353n0gsvsv2mqi1cxboz","https://www.amz123.com/t/PAlYGE9C","author-amz123-kris-reviewed","name","AMZ123 · Kris浩","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_100":101},"cha