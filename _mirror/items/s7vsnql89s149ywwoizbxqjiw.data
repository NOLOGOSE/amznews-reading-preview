[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","s7vsnql89s149ywwoizbxqjiw","revision",2,"title","亚马逊报告：2025年德国中小企业平台销售额超200亿欧元","originalTitle","亚马逊德国中小企业的年销售额超200亿欧元","summary","亚马逊最新报告显示，2025年德国中小企业通过其平台创造的销售额超过200亿欧元，其中跨境销售额达59亿欧元。这是亚马逊首次披露该群体在平台上的整体销售规模，主要出口市场包括法国、奥地利等国。尽管商品销量突破7.5亿件，但跨境业务增速较早期明显放缓，卖家数量表述为“超过4万家”，未给出精确增减数据。","reason","source",{"_9":88,"_89":90,"_91":92,"_93":39,"_94":-5},"links",{"_85":86,"_67":87},"publishedAt","2026-10-23T04:07:26.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-23T07:22:31.215Z","timelineAt","category","product","tags",[82,83,84],"score",42,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","跨境资讯通","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":12,"_74":75},"hasTranslation","bodyLanguage","original","factId","f6_-MPw7RGgM",{"_76":77,"_13":78},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","27e66195-34ca-4406-af25-7bd4066b8f36","亚马逊首披德国中小企业年销售额超200亿欧元",{"_76":77,"_13":78},"platform","卖家之家","数据/报告","品类趋势","亚马逊","aihot","/items/s7vsnql89s149ywwoizbxqjiw","https://mjzj.com/article/g226zhgxfpj4","publisher-mjzj-feed","name","卖家之家 · 跨境资讯","kind","rss","firstParty","iconUrl",{"_96":97},"changelogVersion","2026-10-09T22:08"]
