[{"_1":2,"_3":4},"root",{"_5":145},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","s7wravl11gf6df03qugqfm96v","revision",1,"title","拆解亚马逊 A9 算法：用 Helium 10 工具做 SEO 审计的 Jordi 方法","originalTitle","Steal Our Amazon SEO Strategy (Based on A9 Algorithms)","summary","Helium 10 作者 Jordi Ordóñez 分享了一套其自述基于亚马逊 A9 算法的 SEO 审计方法，将审计分为抓取、索引、排名三个阶段。抓取阶段用 Cerebro 提取 ASIN 的关键词与 SEO/PPC 排名，并用 Listing Analyzer 批量导出、Review Insights 抓取评论关键词；索引阶段则判断 A9 是否已正确提取并匹配商品详情页内容。作者强调审计结果取决于数据、经验与细分市场，因品类、竞争和需求而异。","reason","source",{"_9":136,"_137":138,"_77":139,"_140":39,"_141":142,"_143":144},"links",{"_133":134,"_65":135},"publishedAt","2023-11-07T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:22:50.206Z","timelineAt","category","advertising","tags",[127,128,129,130,131,132],"score",29,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Jordi Ordóñez","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Helium 10",{"_77":78,"_79":122,"_81":123,"_83":124,"_85":125,"_87":126,"_89":-5,"_90":-5},{"_77":78,"_79":118,"_81":119,"_83":120,"_85":86,"_87":121,"_89":-5,"_90":-5},{"_77":78,"_79":114,"_81":115,"_83":116,"_85":86,"_87":117,"_89":-5,"_90":-5},{"_77":78,"_79":109,"_81":110,"_83":111,"_85":112,"_87":113,"_89":-5,"_90":-5},{"_77":78,"_79":105,"_81":106,"_83":107,"_85":99,"_87":108,"_89":-5,"_90":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":86,"_87":104,"_89":-5,"_90":-5},{"_77":78,"_79":96,"_81":97,"_83":98,"_85":99,"_87":100,"_89":-5,"_90