[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","s87dq1adhy872meaosx9fxne7","revision",1,"title","作者称亚马逊促销日交易量约为平日三倍","originalTitle","Morning!","summary","作者表示，自己目前看到的交易量约为平日的3倍，且有很多零售商匹配；这是作者的个人阶段性观察，并非经独立核验的销量数据。作者希望亚马逊能保持这一节奏，超越以往大促日的表现。","reason","source",{"_9":97,"_98":99,"_81":100,"_101":39,"_102":-5},"links",{"_94":95,"_66":96},"publishedAt","2026-10-06T11:47:59.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.562Z","timelineAt","category","advertising","tags",[93],"score",12,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","SaulSellsStuff","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Morning!</p><p>I was asleep but it was a good day to be up early, or I suppose stay up late.</p><p>Currently seeing about 3x the deal volume so far with many retailer matches.</p><p>Hopefully Amazon can continue the pace and beat out previous sale days.</p>","zhKind","complete","authorName","Saul","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[80],{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/m