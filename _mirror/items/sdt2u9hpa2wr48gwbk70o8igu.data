[{"_1":2,"_3":4},"root",{"_5":132},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","sdt2u9hpa2wr48gwbk70o8igu","revision",2,"title","亚马逊美国站融蜡灯款式不侵权美国发明专利的分析","originalTitle","被吓到了！这种款式“融蜡灯”不侵权这项美国发明专利！","summary","针对亚马逊美国站热销的融蜡灯，经比对分析，某特定款式因缺少“容置槽”、“第二发光元件”及“防眩部”等技术特征，未落入相关美国发明专利权利要求1的保护范围，初步判定不构成侵权。该结论基于外观结构图与专利权利要求的技术特征对比，提示卖家在关注外观专利的同时也需排查发明专利风险。","reason","source",{"_9":123,"_124":125,"_89":126,"_127":40,"_128":129,"_130":131},"links",{"_120":121,"_68":122},"publishedAt","2026-10-21T02:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-22T06:12:25.556Z","timelineAt","category","policy","tags",[116,117,118,119],"score",38,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","案说跨境知识产权","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","faslLw7iXuWM",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","e8b1ad04-7348-43bb-a755-1b82b4712e9f","亚马逊美国站融蜡灯款式专利侵权分析",{"_77":78,"_13":79},"platform","AMZ123",{"_89":90,"_91":113,"_93":114,"_95":115,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":110,"_93":111,"_95":112,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":107,"_93":108,"_95":109,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":104,"_93":105,"_95":106,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":101,"_93":102,"_95":103,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":92,"_93":94,"_95":96,"_