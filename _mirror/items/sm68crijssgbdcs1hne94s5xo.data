[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","sm68crijssgbdcs1hne94s5xo","revision",1,"title","Circana 计划将 Jungle Scout 数据纳入第三方市场销售测量","originalTitle","Circana Puts Third-Party Marketplace Sales on the Map: $200 Billion of Previously Hidden Demand, Now Measured Weekly","summary","Circana 发布文章称，计划引入由 Jungle Scout 提供的商品级数据，用于测量第三方市场销售，并计划于 2027 年第一季度将其纳入 Circana 的销售点（POS）测量体系、按周监测。原文标题提及“2000 亿美元此前未统计需求”，但正文未给出该数字的统计方法或可核验出处，本站尚未独立核验。原文来自 Circana，涉及该公司自身测量服务及与 Jungle Scout 的合作，存在相关商业利益，并非独立测评。","reason","source",{"_9":86,"_87":88,"_69":89,"_90":39,"_91":92,"_93":94},"links",{"_83":84,"_65":85},"publishedAt","2026-10-15T13:56:30.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T17:31:27.161Z","timelineAt","category","product","tags",[81,82],"score",42,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Stuart Aitken","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Circana",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/b7bcfec74ec2559f.webp","fullUrl","/amznews-reading-preview/_img/b7bcfec74ec2559f.webp","srcSet","/amznews-reading-preview/_img/b7bcfec74ec2559f.webp 336w, /amznews-reading-preview/_img/b7bcfec74ec2559f.webp 720w","width","height","alt","poster","数据/报告","选品/市场","aihot","/items/sm68crijssgbdcs1hne94s5xo","https://www.circana.com/post/circana-puts-third-party-marketplace-sales-on-the-map-200-billion-of-previously-hidden-demand