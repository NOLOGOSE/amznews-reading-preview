[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":40,"_63":64,"_65":66,"_67":68},"id","soobkm191itpfweiq8iux9usl","revision",2,"title","亚马逊推出Amazon Ads Agent及全漏斗广告活动","originalTitle","亚马逊AI升级，推出全漏斗广告！","summary","亚马逊推出AI驱动的Amazon Ads Agent平台，整合赞助广告、DVA+及全漏斗广告活动，帮助广告主打通从曝光到购买的链路。官方数据显示，2026年6月至8月测试期间，长期ROAS提升67%，新客获取成本降低29%（基于内部测试）。目前全漏斗广告已向美国部分广告主开放公测，DVA+计划于2026年10月下旬逐步开放。","reason","原文梳理了亚马逊新推出的全漏斗广告功能及测试数据，卖家可了解其如何整合多类广告并优化预算分配。","source",{"_9":90,"_91":92,"_93":94,"_95":66,"_96":97,"_98":99},"links",{"_87":88,"_68":89},"publishedAt","2026-10-21T07:29:01.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-21T08:13:08.255Z","timelineAt","category","advertising","tags",[83,84,85,86],"score",62,"selected",true,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","Yiju谈跨境","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable","group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":73},"hasTranslation",false,"bodyLanguage","original","factId","fEvNTyNgo4Sk",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","bb008d0d-3282-49d0-a71b-39b869403450","亚马逊10月下旬美国站公测付费邀评广告",{"_77":78,"_13":79},"platform","雨果跨境","广告/运营","AI工具","亚马逊","Amazon Ads","aihot","/items/soobkm191itpfweiq8iux9usl","https://www.cifnews.com/article/189579","publisher-cifnews-amazon","name","雨果跨境 · 亚马逊频道最新","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp","iconSrcSet","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 48w, /amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 96w",{"_101