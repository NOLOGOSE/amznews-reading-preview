[{"_1":2,"_3":4},"root",{"_5":123},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","spncsqio9m0cnks9qngic1csr","revision",4,"title","读懂广告展示量比较：一篇2023年的报告方法笔记","originalTitle","干货：详解搜索词展示量排名报告！","summary","船长BI在2023年2月16日介绍搜索词展示量排名报告的阅读思路。Amazon Ads的历史官方公告支持：报告在指定期间比较同一搜索词、同一广告类型下账户的广告展示量排名与份额。广告展示量排名不是自然搜索排名或销量，展示量份额也不是全站搜索量。作者用四种情景讨论排名、份额与广告回报的组合，这些是示例，不能直接推出竞争者数量、强弱或利润。本站建议先核对报告口径、相关性、转化、成本与预算承受能力，再决定是否调整；增预算或竞价并非平台强制要求。作者是商业BI软件品牌，课程及工具有商业利益；原文授权未转授本站，图表、视频和课程均不转载。这是历史方法导读，不把当时入口、软件精度或省时效果当作当前实测。","reason","source",{"_9":114,"_115":116,"_75":117,"_118":39,"_119":120,"_121":122},"links",{"_111":112,"_65":113},"publishedAt","2023-02-16T01:56:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-02T09:09:03.749Z","timelineAt","category","advertising","tags",[105,106,107,108,109,110],"score",38,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","船长BI","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_75":76,"_77":102,"_79":103,"_81":104,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":99,"_79":100,"_81":101,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":96,"_79":97,"_81":98,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":93,"_79":94,"_81":95,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":90,"_79":91,"_81":92,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":87,"_79":88,"_81":89,"_83":-5,"_84":-5,"_85":-5,"_86":-5},{"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5,"_84":-5,"_85":-5,"_86":-5},"kind","image","url