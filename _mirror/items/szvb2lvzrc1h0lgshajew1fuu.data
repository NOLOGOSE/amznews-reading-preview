[{"_1":2,"_3":4},"root",{"_5":95},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_42":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":40,"_62":40,"_63":-5,"_64":65,"_66":67},"id","szvb2lvzrc1h0lgshajew1fuu","revision",2,"title","亚马逊在卖家平台推出多渠道销售工具，统一管理eBay、Shopify等渠道","originalTitle","Sellers can now manage sales across Amazon, eBay, Shopify, TikTok, and Walmart from Seller Central","summary","亚马逊副总裁Mary Beth Westmoreland宣布在Seller Central推出新的多渠道销售工具，允许卖家在一个界面管理Amazon、eBay、Shopify、TikTok和Walmart的列表、订单及盈利数据。该功能目前正向美国站卖家逐步免费开放，支持自动同步跨平台商品描述、集中处理各渠道订单并实时查看包含广告支出在内的整体盈利能力。","reason","亚马逊官方宣布在卖家平台推出免费的多渠道销售工具，支持统一管理eBay、Shopify等平台的订单与利润。","source",{"_9":88,"_89":90,"_91":92,"_93":40,"_94":-5},"links",{"_85":86,"_67":87},"publishedAt","2026-09-24T13:54:45.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:20:07.488Z","timelineAt","category","policy","tags",[81,82,83,84],"score",72,"selected",true,"channel","x","story",{"_72":73,"_74":52,"_75":76,"_77":78,"_79":-5,"_45":80},"media",[],"byline","detailedGuide","readingMode","full","author","amazonnews","language","zxx","body",{"_68":-5,"_67":69,"_70":-5,"_71":40},"outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","zh","<p>https://x.com/i/article/2103119628469784576</p>","zhKind","complete","authorName","Amazon News","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"AI/工具","多平台销售","亚马逊","Seller Central","aihot","/items/szvb2lvzrc1h0lgshajew1fuu","https://x.com/amazonnews/status/2103120960710697271","x-amazon-news","name","X · Amazon News","kind","x_search","firstParty","iconUrl",{