[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","t016utoznse6ewziii3egcfeq","revision",2,"title","Quartile 获 2026 Amazon Ads Partner Awards 战略本地化奖","originalTitle","Quartile Wins Strategic Localization Award in the 2026 Amazon Ads Partner Awards","summary","Quartile 自述凭借协助 Honeysticks 在八个亚马逊站点拓展市场，获得 2026 Amazon Ads Partner Awards 战略本地化奖。原文来自 Quartile，存在相关商业利益，并非独立测评。文中称其使用 Amazon Marketing Cloud (AMC) 受众策略，并给出 AMC 受众相较标准广告系列转化率提升 44%、ACoS 降低 20%，以及加拿大销售额同比增长 43% 等数据；这些数据出自原文自述，本站尚未独立核验。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-09-29T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T12:43:57.108Z","timelineAt","category","advertising","tags",[68,69,70],"score",12,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Chris Lamonica","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Quartile","广告/运营","AI工具","Amazon Ads","aihot","/items/t016utoznse6ewziii3egcfeq","https://www.quartile.com/blog/quartile-wins-strategic-localization-award-in-the-2026-amazon-ads-partner-awards","publisher-quartile-written-rolling","name","Quartile 亚马逊广告与Listing文章","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/9ba7171d74d08150.webp","iconSrcSet","/amznews-reading-preview/_img/9ba7171d74d08150.webp 48w, /amznews-reading-preview/_img/9ba7171d74d08150.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
