[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","t0hlp9p7kkfjwt9e3oc2t2y5p","revision",1,"title","YouTube将亚马逊产品直接集成至购物联盟计划","originalTitle","This is Big.","summary","据X用户@guyfosel转述@wallstengine的内容，YouTube已将亚马逊纳入其购物联盟计划，符合条件的美国创作者可在Shorts、长视频和直播中直接标记亚马逊产品。该转述称，集成支持自动产品打标，并在YouTube Studio内追踪点击和收益，佣金通过AdSense发放。转述还称YouTube表示7月测试发现产品标签比仅靠描述链接多带来110%以上的点击量；该测试数据来自转述，本站尚未独立核验。","reason","source",{"_9":93,"_94":95,"_96":97,"_98":39,"_99":-5},"links",{"_90":91,"_66":92},"publishedAt","2026-09-01T17:04:05.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:16.941Z","timelineAt","category","advertising","tags",[88,89],"score",58,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":79,"_44":80},"media",[],"byline","detailedGuide","readingMode","full","author","guyfosel","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>This is Big.</p>","zhKind","complete","authorName","Bearded Egg FBA 🛠️","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_71":81,"_73":82,"_83":84,"_85":86,"_87":-5},[],"Wall St Engine","wallstengine","text","YOUTUBE BRINGS AMAZON DIRECTLY INTO ITS SHOPPING AFFILIATE PROGRAM\n\nEligible U.S. creators can now link their Amazon Associates or Influencer account to YouTube and tag Amazon products directly inside Shorts, long-form videos and livestreams, instead of relying on links buried in descriptions.\n\nThe integration pulls from a curated Amazon catalog, supports automatic product tagging, tracks clicks and earnings inside YouTube Studio, and pays Amazon commissions through AdSense alongside creators’ existing YouTube affiliate earnings.\n\nFor viewers, the tags send them directly to Amazon to complete the purchase. YouTube says a July test found product tags generated 110%+ more clicks than description links alone.","url","https://x.com/wallstengine/status/2094758300504228288","translation","行业动态","亚马逊","aihot","/items/t0hlp9p7kkfjwt9e3oc2t2y5p","https://x.com/guyfosel/status/2094833684562022604","x-bearded-egg-fba","name","X · Bearded Egg FBA","kind","x_search","firstParty","iconUrl",{"_101":102},"changelogVersion","2026-10-09T22:08"]
