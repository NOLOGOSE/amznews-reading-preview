[{"_1":2,"_3":4},"root",{"_5":123},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","t22nu9c26apn93jyviea0m49w","revision",5,"title","亚马逊广告接入 ChatGPT，美国部分广告主试点对话式广告","originalTitle","亚马逊广告接入ChatGPT，卖家流量入口正在改变","summary","2026年9月10日，亚马逊广告宣布与 OpenAI 合作，支持通过 ChatGPT 上的对话式广告体验拓展活动。目前仅美国部分广告主参与试点，Seller Central 未向所有卖家开放自助入口，普通商品也无法直接在 ChatGPT 内完成购买。该变化标志着购物决策从搜索框延伸至对话框，卖家应优先完善 Listing 的场景描述与属性信息，以适应自然语言检索逻辑。","reason","source",{"_9":114,"_115":116,"_87":117,"_118":40,"_119":120,"_121":122},"links",{"_111":112,"_68":113},"publishedAt","2026-10-08T08:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-08","discoveredAt","2026-10-09T02:47:29.769Z","timelineAt","category","advertising","tags",[108,109,110],"score",37,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","CC站外推广","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fPgZGq--fmWs",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","7f102c7f-b1d8-4b38-b9b4-536c8226f0e7","亚马逊广告宣布与OpenAI合作试点ChatGPT Ads",{"_77":78,"_13":79},"platform","AMZ123",{"_87":88,"_89":105,"_91":106,"_93":107,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":102,"_91":103,"_93":104,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":99,"_91":100,"_93":101,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5,"_97":-5,"_98":-5},"kind","image","url","/amznews-reading-preview/_img/6fb4fe353a247e