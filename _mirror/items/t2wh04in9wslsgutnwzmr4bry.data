[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","t2wh04in9wslsgutnwzmr4bry","revision",3,"title","亚马逊调整测试检验认证流程，改由授权 TIC 服务商代为提交","originalTitle","Understand Amazon’s Testing, Inspection, and Certification Requirements Before Peak Season","summary","亚马逊调整测试、检验与认证（TIC）合规流程，卖家不能再直接上传合规文件，须由授权 TIC 服务商审核或检测后代为提交给亚马逊。新流程通过 Account Health 的 Policy Compliance 发起，涉及儿童玩具、儿童珠宝、膳食补充剂、锂离子电池、便携电源等受监管品类。","reason","source",{"_9":100,"_101":67,"_71":102,"_103":39,"_104":-5},"links",{"_97":98,"_65":99},"publishedAt","2026-07-30T11:30:07.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-01T17:38:13.082Z","timelineAt","category","policy","tags",[93,94,95,96],"score",62,"selected",false,"channel","news","story","x","media",[68,69,70],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Andreea","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerEngine",{"_71":72,"_73":90,"_75":91,"_77":92,"_79":88,"_81":89,"_83":-5,"_84":-5},{"_71":72,"_73":85,"_75":86,"_77":87,"_79":88,"_81":89,"_83":-5,"_84":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/e0b0734afbc57db3.webp","fullUrl","/amznews-reading-preview/_img/e0b0734afbc57db3.webp","srcSet","/amznews-reading-preview/_img/e0b0734afbc57db3.webp 336w, /amznews-reading-preview/_img/e0b0734afbc57db3.webp 720w","width",608,"height",611,"alt","poster","/amznews-reading-preview/_img/d342403a9ddede9a.webp","/amznews-reading-preview/_img/d342403a9ddede9a.webp","/amznews-reading-p