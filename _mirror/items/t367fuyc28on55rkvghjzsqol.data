[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","t367fuyc28on55rkvghjzsqol","revision",2,"title","亚马逊报告：2025年德国中小企业平台销售额超200亿欧元","originalTitle","亚马逊德国中小企业的年销售额超200亿欧元","summary","亚马逊最新报告显示，2025年德国中小企业通过其平台创造的销售额超过200亿欧元，其中跨境销售额达59亿欧元。这是亚马逊首次披露该群体在平台上的整体销售规模，此前仅公布出口数据。尽管跨境业务持续增长，但增速较早期有所放缓；同时卖家数量表述从2025年的约4.7万家回落至目前的“超过4万家”，具体减少幅度因未给出精确数字而尚不确定。","reason","source",{"_9":102,"_103":104,"_85":105,"_106":40,"_107":108,"_109":110},"links",{"_99":100,"_68":101},"publishedAt","2026-10-23T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-23","discoveredAt","2026-10-23T03:48:25.231Z","timelineAt","category","product","tags",[97,98],"score",39,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[84],"byline",{"_53":81,"_82":83},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":12,"_75":76},"hasTranslation","bodyLanguage","original","factId","f6_-MPw7RGgM",{"_77":78,"_13":79},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","27e66195-34ca-4406-af25-7bd4066b8f36","亚马逊首披德国中小企业年销售额超200亿欧元",{"_77":78,"_13":79},"Summer","platform","AMZ123",{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/a9336a72d8bed4bf.webp","fullUrl","/amznews-reading-preview/_img/a9336a72d8bed4bf.webp","srcSet","/amznews-reading-preview/_img/a9336a72d8bed4bf.webp 336w, /amznews-reading-preview/_img/a9336a72d8bed4bf.webp 720w","width","height","alt","poster","数据/报告","亚马逊","aihot","/items/t367