[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","t3qq2fppy3shp3jme7uyxp0nu","revision",2,"title","亚马逊周报：DSP开放ChatGPT广告位及Meta推出购物代理Muse","originalTitle","Amazon Just Made ChatGPT a New Ad Channel for Sellers","summary","亚马逊与OpenAI合作，允许美国DSP广告主将广告投放至ChatGPT内的赞助文本和图片单元。Meta发布WhatsApp AI代理Muse，可自主完成购买流程，导致订单附带更少的客户数据。FTC起诉亚马逊操纵广告拍卖机制，指控其通过隐藏底价抬高卖家竞价成本。此外，亚马逊在中国新增第三个全球仓储和配送中心以降低存储费率。","reason","source",{"_9":105,"_106":107,"_71":108,"_109":39,"_110":111,"_112":113},"links",{"_102":103,"_65":104},"publishedAt","2026-09-16T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T07:15:56.714Z","timelineAt","category","advertising","tags",[98,99,100,101],"score",62,"selected",false,"channel","news","story","x","media",[67,68,69,70],"byline",{"_51":-5,"_66":52},"detailedGuide","readingMode","full","author","SellerBites","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform",{"_71":72,"_73":93,"_75":94,"_77":95,"_79":96,"_81":97,"_83":-5,"_84":-5},{"_71":72,"_73":90,"_75":91,"_77":92,"_79":88,"_81":89,"_83":-5,"_84":-5},{"_71":72,"_73":85,"_75":86,"_77":87,"_79":88,"_81":89,"_83":-5,"_84":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/fdcfc292c1e612af.webp","fullUrl","/amznews-reading-preview/_img/fdcfc292c1e612af.webp","srcSet","/amznews-reading-preview/_img/fdcfc292c1e612af.webp 336w, /amznews-reading-preview/_img/fdcfc292c1e612af.webp 720w","width",1024,"height",415,"alt","poster","/amznews-reading-preview/_img/64d2f89c6d16678f.w