[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_42":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":40,"_62":40,"_63":-5,"_64":65,"_66":67},"id","t3rtv4jxpoy9awz1mfjqseexn","revision",1,"title","亚马逊向所有企业开放 Amazon Supply Chain Services","originalTitle","Amazon Supply Chain Services—our freight, distribution, fulfillment, and parcel shipping network—can now be used by any business.","summary","亚马逊 CEO Andy Jassy 宣布 Amazon Supply Chain Services 现已向任何企业开放。该服务整合了亚马逊近三十年构建的货运、分销、履约和包裹运输网络，覆盖陆海空全链路，无需拼接不同供应商。目前 P&G、3M、Lands' End 和 American Eagle 已接入使用。","reason","亚马逊CEO宣布其内部物流网络向所有企业开放，已有宝洁等品牌接入，为卖家提供一体化供应链替代方案。","source",{"_9":102,"_103":104,"_82":105,"_106":40,"_107":-5},"links",{"_100":101,"_67":87},"publishedAt","2026-05-05T02:28:36.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:20:07.238Z","timelineAt","category","fba","tags",[97,98,99],"score",62,"selected",true,"channel","x","story",{"_72":73,"_74":52,"_75":76,"_77":78,"_79":-5,"_45":80},"media",[],"byline","detailedGuide","readingMode","full","author","ajassy","language","en","body",{"_68":-5,"_67":69,"_70":-5,"_71":40},"outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","zh","<p>Amazon Supply Chain Services—our freight, distribution, fulfillment, and parcel shipping network—can now be used by any business.</p><p>Was built over nearly three decades to move, store, and deliver products across land, air, and sea. All one network, so no need to piece together different providers at every stage. Same reliability and speed our customers rely on.</p><p>P&amp;G, 3M, Lands' End, and American Eagle already on board. Gonna help a lot of businesses move faster, save money, and simplify things. https://www.aboutamazon.com/news/retail/amazon-supply-chain-services-for-business</p>","zhKind","complete","authorName","Andy Jassy","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[81],{"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":96},"kind","video","url","/amznews-reading-preview/_img/missing.svg","originalUrl","https://x.com/ajassy/status/2051489206737006810","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1920,"height",1080,"alt","poster","/amznews-reading-preview/_img/missing.svg","FBA/物流","供应链","亚马逊","aihot","/items/t3rtv4jxpoy9awz1mfjqseexn","x-amazon-ceo-ajassy","name","X · Andy Jassy","x_search","firstParty","iconUrl",{"_109":110},"changelogVersion","2026-10-09T22:08"]
