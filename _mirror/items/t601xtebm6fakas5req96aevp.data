[{"_1":2,"_3":4},"root",{"_5":118},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","t601xtebm6fakas5req96aevp","revision",1,"title","卖家分享Prime促销期间的跨平台价格匹配经历","originalTitle","Folks starting to share how they did.","summary","作者 SaulSellsStuff 在 X 上分享个人在 Prime 促销期间的采购经历：Prime 独家优惠无法用于 A2A，但许多商品在 Walmart 等零售商处有价格匹配；作者主要购买消耗品和玩具，并称自己购买了超过 1,000 包 Pur 口香糖，12 包装从 $35+ 降至 $10。作者还提到部分做 TikTok 直播的食品卖家加入了 FlipAlert，并称他们抓住了类似交易。以上均为作者个人自述，本站尚未独立核验。","reason","source",{"_9":112,"_113":114,"_84":115,"_116":39,"_117":-5},"links",{"_109":110,"_66":111},"publishedAt","2026-10-08T12:02:16.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.541Z","timelineAt","category","advertising","tags",[107,108],"score",12,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":79,"_44":80},"media",[],"byline","detailedGuide","readingMode","full","author","SaulSellsStuff","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Folks starting to share how they did.</p><p>The prime only deals were great, sadly we couldn’t buy them for A2A. However a ton were matching or matched across retailers like Walmart.</p><p>This sale was mainly consumables and toys for me. Mix of items going back up now and short holds for December pricing.</p><p>For example I purchased over 1,000 packs of Pur gum. Amazon happened to be matching Walmart across various bundles.</p><p>So a 12 pack became $10 down from $35+</p><p>Recently some food sellers that do TikTok live have joined us at FlipAlert and I know they grabbed those kind of deals as well.</p><p>Surge of new markets it’s become more interesting to look at deals across multiple platforms.</p><p>Not everyone is going to spend tens of thousands but it isn’t for a lack of opportunity.</p><p>I’m still thrilled when I snag 3 of something and can make $60 🥹</p>","zhKind","complete","authorName","Saul","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_71":72,"_73":51,"_103":104,"_86":105,"_106":-5},[81,82,83],{"_84":85,"_86":100,"_88":101,"_90":98,"_92":102,"_94":-5,"_95":-5},{"_84":85,"_86":96,"_88":97,"_90":98,"_92":99,"_94":-5,"_95":-5},{"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1174,"height",258,"alt","poster","/amznews-reading-preview/_img/missing.svg","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w",1320,457,"/amznews-reading-preview/_img/missing.svg","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w",1216,"text","Morning! \n\nI was asleep but it was a good day to be up early, or I suppose stay up late. \n\nCurrently seeing about 3x the deal volume so far with many retailer matches. \n\nHopefully Amazon can continue the pace and beat out previous sale days.","https://x.com/SaulSellsStuff/status/2107437710939959388","translation","广告/运营","多平台销售","aihot","/items/t601xtebm6fakas5req96aevp","https://x.com/SaulSellsStuff/status/2108166082200469938","x-saul-sells-stuff","name","X · Saul","x_search","firstParty","iconUrl",{"_119":120},"changelogVersion","2026-10-09T22:08"]
