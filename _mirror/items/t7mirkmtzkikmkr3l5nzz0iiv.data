[{"_1":2,"_3":4},"root",{"_5":143},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","t7mirkmtzkikmkr3l5nzz0iiv","revision",2,"title","IDC报告：大疆与影石Q2合计占全球手持智能相机93%份额，GoPro被收购","originalTitle","3个月狂卖588万台，深圳这2家跨境公司竟一举拿下了全球93%市场份额！","summary","原文援引IDC《2026年第二季度全球手持智能相机市场跟踪报告》称，2026年第二季度大疆与影石合计占全球手持智能相机市场93%份额，总出货588万台；其中大疆Pocket系列云台相机占口袋云台相机细分赛道93%。原文另称GoPro是剩余7%份额中出货量最大的一家，并于当地时间2026年9月1日被Starman Optical以2.85亿美元现金收购。上述IDC数据本站尚未独立核验。","reason","source",{"_9":134,"_135":136,"_92":137,"_138":40,"_139":140,"_141":142},"links",{"_131":132,"_68":133},"publishedAt","2026-10-21T01:46:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-22T01:48:30.609Z","timelineAt","category","product","tags",[128,129,130],"score",42,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89,90,91],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","直击跨境","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fT5EF2oYQKqs",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","637c5d64-acc7-4440-894b-9722f82b69b0","大疆影石Q2合计占手持智能相机93%份额",{"_77":78,"_13":79},"platform","AMZ123",{"_92":93,"_94":125,"_96":126,"_98":127,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":122,"_96":123,"_98":124,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":119,"_96":120,"_98":121,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":116,"_96":117,"_98":118,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":113