[{"_1":2,"_3":4},"root",{"_5":102},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_42":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":40,"_62":40,"_63":-5,"_64":65,"_66":67},"id","t8n1q7zvriu860ebbc3duo9n0","revision",1,"title","亚马逊在Seller Central推出多渠道销售工具","originalTitle","Most independent sellers in our store already sell across multiple channels, which has meant juggling separate dashboards, rewriting list...","summary","亚马逊卖家官方账号宣布，在Amazon Accelerate活动上于Seller Central推出多渠道销售工具，可在同一处管理Amazon、eBay、Shopify、TikTok和Walmart的业务，且不额外收费。原文来自亚马逊官方卖家账号，存在相关商业利益，并非独立测评；工具的实际使用效果本站尚未独立核验。","reason","亚马逊官方卖家账号发布Seller Central多渠道销售工具，覆盖Amazon、eBay、Shopify、TikTok和Walmart，且不额外收费；原文来自该机构，存在相关商业利益，并非独立测评。","source",{"_9":95,"_96":97,"_98":99,"_100":40,"_101":-5},"links",{"_92":93,"_67":94},"publishedAt","2026-09-24T16:29:11.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:27:07.988Z","timelineAt","category","policy","tags",[89,90,91],"score",72,"selected",true,"channel","x","story",{"_72":73,"_74":52,"_75":76,"_77":78,"_79":80,"_45":81},"media",[],"byline","detailedGuide","readingMode","full","author","Sell_on_Amazon","language","en","body",{"_68":-5,"_67":69,"_70":-5,"_71":40},"outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","zh","<p>Most independent sellers in our store already sell across multiple channels, which has meant juggling separate dashboards, rewriting listings, and hours of manual reconciliation.</p><p>At Amazon Accelerate, we launched multichannel selling tools in Seller Central: one place to manage your business across Amazon, eBay, Shopify, TikTok, and Walmart. Available at no additional cost.</p><p>Read the full announcement 👇</p><p>#AmazonAccelerate #AmazonSeller</p>","zhKind","complete","authorName","Sell on Amazon","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_72":82,"_74":83,"_84":85,"_86":87,"_88":-5},[],"Amazon News","amazonnews","text","https://x.com/i/article/2103119628469784576","url","https://x.com/amazonnews/status/2103120960710697271","translation","AI/工具","多平台销售","亚马逊","aihot","/items/t8n1q7zvriu860ebbc3duo9n0","https://x.com/Sell_on_Amazon/status/2103159825253491183","x-sell-on-amazon","name","X · Sell on Amazon","kind","x_search","firstParty","iconUrl",{"_103":104},"changelogVersion","2026-10-09T22:08"]
