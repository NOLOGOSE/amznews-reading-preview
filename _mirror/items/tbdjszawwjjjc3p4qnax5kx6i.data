[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","tbdjszawwjjjc3p4qnax5kx6i","revision",2,"title","亚马逊优惠券与订阅省徽章效应","originalTitle","A coupon does more than lower the price. It puts a badge on the search results page, right next to listings that don't have one.","summary","优惠券的作用不止于降价。它会在搜索结果页添加一个徽章，紧邻那些没有该徽章的商品详情页。\n\n“订阅并节省”功能也是如此。“订阅额外享受 15% 折扣”在用户点击前就会显示出来。\n\n这些徽章是你拱手让给竞争对手的点击量。","reason","source",{"_9":98,"_99":100,"_101":102,"_103":39,"_104":-5},"links",{"_95":96,"_68":97},"publishedAt","2026-10-21T00:55:18.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-21T01:25:13.082Z","timelineAt","category","advertising","tags",[93,94],"score",40,"selected",false,"channel","x","story",{"_77":78,"_13":14},{"_84":85,"_86":52,"_87":88,"_89":90,"_91":-5,"_45":92},"media",[],"byline","detailedGuide","readingMode","full","author","1000asins","language","en","body",{"_80":-5,"_68":81,"_82":-5,"_83":63},"outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fmttOpbrtIT8",{"_77":78,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","188b0506-2867-4bb8-89c2-c28d02e05273",{"_77":78,"_13":14},"zh","<p>A coupon does more than lower the price. It puts a badge on the search results page, right next to listings that don't have one.</p><p>Subscribe and save does the same thing. \"Extra 15% off when you subscribe\" shows up before anyone even clicks.</p><p>Badges are clicks you're giving away to competitors.</p>","zhKind","complete","authorName","Dan Boufford","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"广告/运营","Listing优化","aihot","/items/tbdjszawwjjjc3p4qnax5kx6i","https://x.com/1000asins/status/2112709278943306177","x-dan-boufford","name","X · Dan Boufford","kind","x_search","firstParty","iconUrl",{"_106":107},"changelogVersion","2026-10-09T22:08"]
