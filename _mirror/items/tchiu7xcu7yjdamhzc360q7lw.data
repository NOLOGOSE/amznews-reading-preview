[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","tchiu7xcu7yjdamhzc360q7lw","revision",5,"title","亚马逊新报告：独立卖家25年创造超2.5万亿美元销售额，在美国提供超200万个就业岗位","originalTitle","New Amazon report shows small businesses have created millions of US jobs and built thriving communities","summary","亚马逊2024年小企业赋能报告显示，过去25年独立卖家在亚马逊店铺累计销售额超2.5万亿美元，目前占平台总销量60%以上。独立卖家在美国为支持其亚马逊业务雇用了超200万人，同比增长11%；2024年卖家年均销售额超29万美元，同比增长16%，超5.5万名卖家销售额突破100万美元。","reason","source",{"_9":122,"_123":124,"_76":125,"_126":61,"_127":-5},"links",{"_119":120,"_65":121},"publishedAt","2025-05-20T10:00:59.114Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T06:05:39.746Z","timelineAt","category","product","tags",[114,115,116,117,118],"score",22,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Dharmesh Mehta","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","About Amazon",{"_76":77,"_78":111,"_80":112,"_82":113,"_84":85,"_86":98,"_88":-5,"_89":-5},{"_76":77,"_78":108,"_80":109,"_82":110,"_84":85,"_86":98,"_88":-5,"_89":-5},{"_76":77,"_78":105,"_80":106,"_82":107,"_84":93,"_86":94,"_88":-5,"_89":-5},{"_76":77,"_78":102,"_80":103,"_82":104,"_84":85,"_86":87,"_88":-5,"_89":-5},{"_76":77,"_78":99,"_80":100,"_82":101,"_84":93,"_86":94,"_88":-5,"_89":-5},{"_76":77,"_78":95,"_80":96,"_82":97,"_84":85,"_86":98,"_88":-5,"_89":-5},{"_76":77,"_78":90,"_80":91,"_82":92,"_84":93,"_86":94,"_88":-5,"_89":-5},{"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":