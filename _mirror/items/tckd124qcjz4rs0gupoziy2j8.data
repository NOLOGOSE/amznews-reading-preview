[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","tckd124qcjz4rs0gupoziy2j8","revision",2,"title","分享一个快速查询关键词小时维度排名的方法","originalTitle","summary","卖家可通过某柚找词的关键词分析功能下载广告放映机和自然放映机数据表格，再上传至关键词小时级别查询工具，输入 ASIN 即可查询多个关键词的小时维度排名，结果支持导出 Excel。按天查询排名曲线断断续续，是因为各类工具每天只抓取一次数据；按小时查询可用于判断自身产品排名的实时波动规律，并识别竞争对手在特定时段的广告投放与调价节奏。工具支持批量上传表格，已附在附件中。","reason","source",{"_9":74,"_75":66,"_76":77,"_78":38,"_79":80,"_81":82},"links",{"_71":72,"_64":73},"publishedAt","2025-09-16T05:41:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-01T09:32:55.496Z","timelineAt","category","ai-tools","tags",[67,68,69,70],"score",27,"selected",false,"channel","news","story","x","media",[],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","必胜哥的三板斧","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","AI/工具","关键词","卖家工具","亚马逊","aihot","/items/tckd124qcjz4rs0gupoziy2j8","https://wearesellers.com/question/110014","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
