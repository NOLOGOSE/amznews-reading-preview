[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","tf25cvwooggg4643z74k9exk0","revision",8,"title","亚马逊库存放置服务（IPS）是否适合卖家？","originalTitle","Is Amazon Inventory Placement Service the Right Choice for the Sellers?","summary","原文介绍亚马逊库存放置服务（IPS）：卖家可选择将 FBA 库存集中至单一仓库，或由亚马逊分散至多仓。原文列出按 SKU 重量计费的费用表，但同一费用主张在正文示例中存在冲突，本站尚未独立核验。原文还说明服装、珠宝、鞋、媒体、超大件、危险品、制造商条码商品及需 Amazon 预处理或贴标的商品等例外仍可能被分派至不同仓库，并提示可能延长配送时效。原文来自 SellerApp，该机构销售自有卖家工具，存在相关商业利益，并非独立测评。","reason","source",{"_9":95,"_96":97,"_71":98,"_99":39,"_100":-5},"links",{"_92":93,"_65":94},"publishedAt","2023-09-12T11:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-09-30T06:33:30.315Z","timelineAt","category","fba","tags",[89,90,91],"score",22,"selected",false,"channel","news","story","x","media",[68,69,70],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Arishekar N","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","sellerapp",{"_71":72,"_73":86,"_75":87,"_77":88,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":83,"_75":84,"_77":85,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":-5,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/d8c7cb8f65e412a6.webp","fullUrl","/amznews-reading-preview/_img/d8c7cb8f65e412a6.webp","srcSet","/amznews-reading-preview/_img/d8c7cb8f65e412a6.webp 336w, /amznews-reading-preview/_img/d8c7cb8f65e412a6.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/2042692a27c2c026.webp","/amznews-reading-preview/_img/2042692a27c