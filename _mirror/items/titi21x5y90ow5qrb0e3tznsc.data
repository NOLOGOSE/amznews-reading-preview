[{"_1":2,"_3":4},"root",{"_5":122},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","titi21x5y90ow5qrb0e3tznsc","revision",2,"title","亚马逊美国站节日装饰灯串UL 588合规与送检要点","originalTitle","UL588-亚马逊美国站节日装饰灯串上架强制合规要求","summary","原文由检测机构“HY检测”发布，存在相关商业利益，并非独立测评。文章梳理亚马逊美国站节日装饰灯串的UL 588合规框架：先判定产品是否适用UL 588（绳灯、小夜灯等不适用），关注标准版本动态（第19版已于2025-09-26发布、2025-11-13修订，第18版转为归档），并提示CPSC“重大产品危害”规则与CPSA §15(b)强制报告义务的关联。作者建议由ISO 17025认可实验室出具UL 588检测报告，按清单提交报告、图片、英文说明书等，并提前1–2个月安排检测。文中涉及的CPSC三要素具体内容、标准版本技术依据等，本站尚未独立核验。","reason","source",{"_9":114,"_115":82,"_87":116,"_117":40,"_118":119,"_120":121},"links",{"_111":112,"_68":113},"publishedAt","2026-10-13T21:07:40.982Z","publishedPrecision","calendar","calendarDate","2026-10-14","discoveredAt","2026-10-14T08:49:26.750Z","timelineAt","category","policy","tags",[108,109,110],"score",62,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86],"byline",{"_53":-5,"_81":82},"detailedGuide","readingMode","full","author","HY检测 V 13660011103","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fTzbwOsFoQwA",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","55379d43-ef93-427e-ae28-78f374eafea1","亚马逊美国站节日装饰灯串UL 588合规要点",{"_77":78,"_13":79},"platform","知无不言",{"_87":88,"_89":105,"_91":106,"_93":107,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":102,"_91":103,"_93":104,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":99,"_91":100,"_93":101,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5,