[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","tkil55gajt8zodwnkghynk6zw","revision",4,"title","兼职亚马逊店铺年利润20万、主业月薪8千提成不到位，要不要辞职全职做店铺？","originalTitle","6年开发，在兼职店铺年利润已达20万、主业月薪8千且提成不到位的情况下，要不要辞职全职做店铺？","summary","一位6年亚马逊从业者兼职开店今年实现20万利润，主业到手月薪8千且提成一直未到位，公司还准备调整开发岗，因此考虑明年春节后辞职全职做店铺。她与合伙人因资金精力投入不对等、发展规划不同已决定散伙，自己继续做店铺并分给对方一半资金。她顾虑失去主业后斗志下降、脱离职场导致信息闭塞，以及是否该换公司保住8千月薪。","reason","source",{"_9":75,"_76":67,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_72":73,"_65":74},"publishedAt","2026-09-15T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T12:46:21.785Z","timelineAt","category","advertising","tags",[68,69,70,71],"score",15,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","排骨汤很香香","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","广告/运营","行业动态","选品/市场","亚马逊","aihot","/items/tkil55gajt8zodwnkghynk6zw","https://www.wearesellers.com/question/124635","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
