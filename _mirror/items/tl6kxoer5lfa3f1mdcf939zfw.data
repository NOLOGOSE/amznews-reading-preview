[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","tl6kxoer5lfa3f1mdcf939zfw","revision",2,"title","秋季促销前一周怎么准备？当天怎么打？促后怎么稳？","originalTitle","summary","2026年秋季Prime大促定在10月6号到7号，促销价必须比近30天最低成交价再低5%。大促前一周需核查价格资格、库存、Listing、广告预算加到平时1.5到2倍并搭配促销组合；当天CPC会涨20%到30%，需每小时盯广告出单和秒杀进度条；促后7天是维稳黄金期，应按链接阶段调整预算和Coupon。","reason","source",{"_9":89,"_90":91,"_68":92,"_93":38,"_94":95,"_96":97},"links",{"_86":87,"_64":88},"publishedAt","2026-09-29T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:39.036Z","timelineAt","category","advertising","tags",[80,81,82,83,84,85],"score",48,"selected",false,"channel","news","story","x","media",[67],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","跨境移花宫","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_68":69,"_70":71,"_72":73,"_74":75,"_76":-5,"_77":-5,"_78":-5,"_79":-5},"kind","image","url","/amznews-reading-preview/_img/449eb27f85d43d8b.webp","fullUrl","/amznews-reading-preview/_img/449eb27f85d43d8b.webp","srcSet","/amznews-reading-preview/_img/449eb27f85d43d8b.webp 336w, /amznews-reading-preview/_img/449eb27f85d43d8b.webp 720w","width","height","alt","poster","广告/运营","广告投放","Listing优化","库存管理","亚马逊","FBA/物流","aihot","/items/tl6kxoer5lfa3f1mdcf939zfw","https://www.amz123.com/t/S669umyC","author-amz123-yihuagong-reviewed","name","AMZ123 · 跨境移花宫","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_im