[{"_1":2,"_3":4},"root",{"_5":101},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","tnzncq2gbux6lusxc5auurnb5","revision",1,"title","Del Rey谈与Peter Kafka的访谈及The Aisle试用","originalTitle","Man, this was fun. Peter is a close friend, yes. But also one of my favorite interviewers on the planet.","summary","Del Rey表示这次访谈很有趣，Peter Kafka是他的密友，也是他最喜欢的采访者之一。原文提到Channels听众可免费试用The Aisle一个月，并附有试用链接。原文来自Del Rey，存在相关商业利益，并非独立测评。","reason","source",{"_9":94,"_95":96,"_97":98,"_99":39,"_100":-5},"links",{"_91":92,"_66":93},"publishedAt","2026-09-17T16:35:05.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:35:22.394Z","timelineAt","category","ai-tools","tags",[88,89,90],"score",12,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":79,"_44":80},"media",[],"byline","detailedGuide","readingMode","full","author","DelRey","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Man, this was fun. Peter is a close friend, yes. But also one of my favorite interviewers on the planet.</p><p>Bonus...free month-long trial to The Aisle for Channels listeners: https://tinyurl.com/The-Aisle-Channels</p>","zhKind","complete","authorName","Jason Del Rey","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",{"_71":81,"_73":82,"_83":84,"_85":86,"_87":-5},[],"Peter Kafka","pkafka","text","The AI shopping era we've been promised might finally be arriving, via bots like Instinct and Meta's Muse. \n\nRetail expert @DelRey explains why it hasn't happened yet, and what happens if it does.\n\nCc @amazon \n\nText: https://www.businessinsider.com/ai-shopping-meta-muse-agent-jason-del-rey-kafka-interview-2026-9\n\nChannels: \nhttps://podcasts.apple.com/us/podcast/channels-with-peter-kafka/id1080467174?i=1000790010414","url","https://x.com/pkafka/status/2100600377158570456","translation","AI/工具","行业动态","亚马逊","aihot","/items/tnzncq2gbux6lusxc5auurnb5","https://x.com/DelRey/status/2100624595183194183","x-jason-del-rey","name","X · Jason Del Rey","kind","x_search","firstParty","iconUrl",{"_102":103},"changelogVersion","2026-10-09T22:08"]
