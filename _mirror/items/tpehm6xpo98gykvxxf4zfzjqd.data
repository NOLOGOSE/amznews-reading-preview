[{"_1":2,"_3":4},"root",{"_5":81},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":-5,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","tpehm6xpo98gykvxxf4zfzjqd","revision",5,"title","有电商和微开发经验、亚马逊0经验，想转行做亚马逊运营：求职定位、简历和面试该怎么准备？","originalTitle","有电商+微开发经验背景，想转行做亚马逊运营但0经验，不知如何定位求职、准备面试？简历上怎么写才能让HR觉得这人虽然没做过亚马逊但有基础？求前辈指条路","summary","这是一篇转行求职提问。发帖人自述做过电商系统开发和 Takealot 店铺运营，但没有亚马逊经验，向读者询问求职级别、简历写法、面试准备、深圳薪资预期、知识短板和学习资源。上述工作背景是发帖人的个人陈述，本站未独立核验；原文提出问题，没有给出经验证的薪资区间、招聘结论或培训方案。收录用于呈现职业转换时的疑问，不作为已经解答的求职教程。","reason","source",{"_9":72,"_73":66,"_74":75,"_76":38,"_77":78,"_79":80},"links",{"_69":70,"_64":71},"publishedAt","2026-09-29T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:45:54.283Z","timelineAt","category","tags",[67,68],"score",10,"selected",false,"channel","news","story","x","media",[],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","很努力的拾柒","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言","其他","广告/运营","aihot","/items/tpehm6xpo98gykvxxf4zfzjqd","https://www.wearesellers.com/question/125083","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_82":83},"changelogVersion","2026-10-09T22:08"]
