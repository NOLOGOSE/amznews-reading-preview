[{"_1":2,"_3":4},"root",{"_5":117},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","tpo1r3s6dmtuejg1ve44vn0oa","revision",2,"title","亚马逊向部分美国站卖家发送NWD规则下架通知，要求处理受影响库存","originalTitle","亚马逊大封杀！大批卖家收到下架通知","summary","亚马逊向部分美国站卖家发送通知，称依据NWD（无批发分销）规则，部分品牌商品自10月27日起需销售账号具备Brand Representative（品牌代表）权限，并要求在截止日期前处理受影响库存；原文提到部分海外卖家晒出的通知显示10月28日，具体执行时间应以各账号收到的邮件为准。原文还提到，一些拥有商标和品牌注册身份的自有品牌卖家也收到预警，有卖家自述向客服书面核实后得知销售账号正确关联品牌并具备相应权限原则上仍可销售，但原文明确这不能据此认定所有收到通知的品牌账号都不会受影响。此外，原文提到近期广东、江苏、福建等地部分卖家反映收到税务部门关于平台报送收入差异的提醒短信。","reason","原文梳理了NWD规则下品牌销售权限收紧的通知内容、库存处理选项与执行日期的不确定性，并呈现了自有品牌卖家收到通知的现象及原文对其原因尚未证实的说明。","source",{"_9":108,"_109":110,"_86":111,"_112":67,"_113":114,"_115":116},"links",{"_105":106,"_69":107},"publishedAt","2026-10-19T01:54:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-20T01:59:39.321Z","timelineAt","category","policy","tags",[101,102,103,104],"score",72,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","跨境知道网","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":12,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fbAjJrnzgSnM",{"_78":79,"_13":80},"reportCount",5,"additionalSourceCount","developmentCount",0,"publicId","dbf445cd-5ab4-4c48-9b75-67dad0c62a93","亚马逊NWD限售通知引发卖家下架与库存担忧",{"_78":79,"_13":80},"platform","AMZ123",{"_86":87,"_88":98,"_90":99,"_92":100,"_94":-5,"_95":-5,"_96":-5,"_97":-5},{"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":-5,"_96":-5,"_97":-5},"kind","image","url","/amznews-reading-preview/_img/d9671c256aea12d0.webp","fullUrl","/amznews-reading-preview/_img/d9671c256aea12d0.webp","srcSet","/amznews-reading-preview/_img/d9671c256aea12d0.webp 336w, /amznews-reading-preview/_img/d9671c256aea12d0.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/506395dccb029731.webp","/amznews-reading-preview/_img/506395dccb029731.webp","/amznews-reading-preview/_img/506395dccb029731.webp 336w, /amznews-reading-preview/_img/506395dccb029731.webp 720w","政策/合规","亚马逊","FBA/物流","Listing优化","aihot","/items/tpo1r3s6dmtuejg1ve44vn0oa","https://www.amz123.com/t/xfyTOhga","publisher-amz123-headlines","name","AMZ123 · 跨境头条","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_118":119},"changelogVersion","2026-10-09T22:08"]
