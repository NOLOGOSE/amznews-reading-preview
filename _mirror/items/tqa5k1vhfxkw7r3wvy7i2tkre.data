[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":64,"_65":40,"_66":67},"id","tqa5k1vhfxkw7r3wvy7i2tkre","revision",4,"title","CPSC 召回 ONTHEWEI 婴儿浴盆座椅，因存在溺水风险","originalTitle","ONTHEWEI Recalls Baby Bath Seats Due to Risk of Serious Injury or Death to Children from Drowning; Violate Mandatory Standard for Infant Bath Seats","summary","CPSC 于 2026 年 10 月 8 日召回约 2,140 件 ONTHEWEI 品牌婴儿浴盆座椅（型号 MY002），因其不稳定易翻倒，违反强制性标准并导致严重伤害或死亡风险。消费者应立即停止使用，联系卖家获取全额退款并按要求销毁产品。该商品曾在亚马逊以 $40-$50 价格销售。","reason","source",{"_9":87,"_88":81,"_89":90,"_91":62,"_92":93,"_94":95},"links",{"_84":85,"_67":86},"publishedAt","2026-10-08T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-08","discoveredAt","2026-10-08T20:49:57.080Z","timelineAt","category","policy","tags",[82,83],"score",26,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_53":-5,"_80":81},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_43":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","f0k_EdJWHnWk",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","d2072b83-3ce6-40aa-8923-fdb5c0370add","CPSC召回在亚马逊销售的婴儿浴椅",{"_76":77,"_13":78},"platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","aihot","/items/tqa5k1vhfxkw7r3wvy7i2tkre","https://cpsc.gov/Recalls/2027/ONTHEWEI-Recalls-Baby-Bath-Seats-Due-to-Risk-of-Serious-Injury-or-Death-to-Children-from-Drowning-Violate-Mandatory-Standard-for-Infant-Bath-Seats","official-cpsc-amazon-recalls-reviewed","name","kind","json_list","firstParty","iconUrl","/amznews-