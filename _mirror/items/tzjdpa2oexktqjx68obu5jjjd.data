[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","tzjdpa2oexktqjx68obu5jjjd","revision",4,"title","INFORM 法案历史资料：分清卖家与平台的官方指引","originalTitle","Online sellers: How the INFORM Consumers Act could impact your business","summary","这是 Lesley Fair 于2023年8月18日在FTC官网发布的资料入口文章，记录 INFORM Consumers Act 于当年6月27日生效。原文区分在线市场与高销量第三方卖家：前者承担收集、核实和披露特定信息的义务，后者需要了解平台会要求提供哪些信息，以及哪些信息可能向消费者公开。FTC分别链接了面向平台的《Informing Businesses about the INFORM Consumers Act》和面向卖家的《What Third Party Sellers Need to Know About the INFORM Consumers Act》。收到平台信息核验要求的卖家，可以先按自己的角色选择对应入口，再核对当前指南和账户通知；这是本站整理的查找顺序，不是法定义务清单。原稿只有四段，没有完整列出金额门槛、计算期间、例外、提交期限或处罚数额，不能依据本导读直接判断某个账户是否适用，更不能把所有卖家视为同一情况。文章还提供了报告涉嫌违反该法案的官网入口；本站没有替读者提交材料或作个案认定。本文为有限原创历史资料导读，不是新公告或现行法律完整复核，不代表FTC对本站的认可；两份完整指南和最新法律要求应从原文链接继续核对，原发日与收录日分别显示。第三方图片、原文全文及译文不在本站展示。","reason","source",{"_9":74,"_75":67,"_76":77,"_78":61,"_79":80,"_81":82},"links",{"_71":72,"_65":73},"publishedAt","2023-08-18T17:02:18.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-02T21:07:48.283Z","timelineAt","category","policy","tags",[68,69,70],"score",62,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Lesley Fair","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FTC Business Blog","政策/合规","合规税务","亚马逊","aihot","/items/tzjdpa2oexktqjx68obu5jjjd","https://www.ftc.gov/business-guidance/blog/2023/08/online-sellers-how-inform-consumers-act-could-impact-your-business","author-ftc-lesley-seller-resource-reviewed","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/8e6890cd6985d634.webp","iconSrcSet","/amznews-reading-preview/_img/8e6890cd6985d634.webp 48w, /amznews-reading-preview/_img/8e6890cd6985d634.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
