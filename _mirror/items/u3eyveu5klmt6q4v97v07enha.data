[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":64,"_65":40,"_66":67},"id","u3eyveu5klmt6q4v97v07enha","revision",2,"title","CPSC 召回 VQQQ 燃气庭院加热器，存在火灾烧伤风险","originalTitle","VQQQ Gas Patio Heaters Recalled Due to Risk of Serious Injury or Death from Fire and Burn Hazards","summary","CPSC 于 2026 年 10 月 22 日召回约 100 台 VQQQ 品牌天然气庭院加热器（型号 VQQQ-A1 和 VQQQ-001），因组件故障可能导致气体泄漏，引发严重伤害或死亡。该产品在 Amazon.com 上以约 $346 的价格销售，消费者应立即停用并联系厂商获取全额退款。","reason","source",{"_9":87,"_88":81,"_89":90,"_91":62,"_92":93,"_94":95},"links",{"_84":85,"_67":86},"publishedAt","2026-10-22T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-22T18:00:25.583Z","timelineAt","category","policy","tags",[82,83],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_53":-5,"_80":81},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_43":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fr6vB8XCmWcY",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","9e9efe5e-c0cb-462f-96e1-ee02c362a3f2","CPSC召回约100台VQQQ燃气庭院加热器",{"_76":77,"_13":78},"platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","aihot","/items/u3eyveu5klmt6q4v97v07enha","https://www.cpsc.gov/Recalls/2027/VQQQ-Gas-Patio-Heaters-Recalled-Due-to-Risk-of-Serious-Injury-or-Death-from-Fire-and-Burn-Hazards","official-cpsc-amazon-recalls-reviewed","name","kind","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp","iconSrcSet","/amznews-reading-preview/_img/3