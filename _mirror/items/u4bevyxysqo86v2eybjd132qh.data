[{"_1":2,"_3":4},"root",{"_5":120},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_42":45,"_46":47,"_48":-5,"_49":-5,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":61,"_62":40,"_63":40,"_64":65,"_66":67,"_68":69},"id","u4bevyxysqo86v2eybjd132qh","revision",2,"title","亚马逊规定2026年12月18日起多数美国FBM订单需预付退货标签","originalTitle","FYI for FBM sellers: Amazon says that starting December 18, 2026, most US returns for seller-fulfilled orders will require a prepaid retu...","summary","亚马逊宣布自2026年12月18日起，美国站大多数卖家自发货（FBM）订单的退货将强制要求提供预付退货标签。卖家须在收到退货请求后的7个日历日内通过“管理卖家自发货退货”上传标签或全额退款且不要求退回商品；若未执行，亚马逊可能自动发放无需退货的退款并从卖家账户扣除相应金额。重型和大件物品暂时豁免此规定，且不在亚马逊退货工作流内发送的标签无效。","reason","原文明确了FBM卖家处理退货的新规生效日期、7天时限及未合规时的自动退款扣款后果，有助于卖家提前调整运营流程。","source",{"_9":114,"_115":116,"_96":117,"_118":67,"_119":-5},"links",{"_111":112,"_69":113},"publishedAt","2026-10-19T18:36:08.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T18:56:39.954Z","timelineAt","category","policy","tags",[108,109,110],"score",80,"selected",true,"channel","x","story",{"_78":79,"_13":80},{"_86":87,"_88":53,"_89":90,"_91":92,"_93":-5,"_46":94},"media",[],"byline","detailedGuide","readingMode","full","author","AmazonASGTG","language","en","body",{"_82":-5,"_69":83,"_84":-5,"_85":40},"outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_43":72,"_73":74,"_75":12,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fXfrQy_90Ddk",{"_78":79,"_13":80},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","54a20201-0a95-4fe1-9774-3181d400f595","亚马逊FBM退货预付标签新规",{"_78":79,"_13":80},"zh","<p>FYI for FBM sellers: Amazon says that starting December 18, 2026, most US returns for seller-fulfilled orders will require a prepaid return label.</p><p>Within seven calendar days of a return request, sellers must upload the label through Manage Seller-Fulfilled Returns or issue a full refund without requiring the item back. If neither happens, Amazon says it may automatically issue a returnless refund and deduct the amount from the seller’s account.</p><p>Heavy and bulky items are temporarily excluded. Labels sent outside Amazon’s returns workflow won’t count.</p>","zhKind","complete","authorName","Amazon Sellers ASGTG","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[95],{"_96":97,"_98":99,"_100":101,"_102":103,"_104":105,"_106":-5,"_107":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",912,"height",2048,"alt","poster","政策/合规","FBA/物流","亚马逊","aihot","/items/u4bevyxysqo86v2eybjd132qh","https://x.com/AmazonASGTG/status/2112251468099043498","x-amazon-asgtg","name","X · ASGTG","x_search","firstParty","iconUrl",{"_121":122},"changelogVersion","2026-10-09T22:08"]
