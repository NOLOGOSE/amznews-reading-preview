[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","u5r6qihxwwmp0i58tpw0llnn4","revision",2,"title","亚马逊中国卖家增值税与企业所得税申报指南","originalTitle","亚马逊中国卖家怎么报税？讲清增值税+所得税！","summary","Yiju谈跨境详解亚马逊中国卖家的税务处理：增值税涉及买单清关（借用主体报关）、9810出口退税（海外仓模式）和9810出口免税三种路径；企业所得税按应纳税所得额计算而非销售额，一般税率25%，符合条件的小型微利企业年应纳税所得额不超过300万元部分实际税负约5%（政策执行至2027年底）。","reason","source",{"_9":100,"_101":102,"_82":103,"_104":39,"_105":106,"_107":108},"links",{"_97":98,"_67":99},"publishedAt","2026-10-19T07:03:27.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T07:57:35.186Z","timelineAt","category","policy","tags",[94,95,96],"score",58,"selected",false,"channel","news","story",{"_76":77,"_13":14},"x","media",[81],"byline",{"_52":53,"_79":80},"detailedGuide","readingMode","full","author","Yiju谈跨境","language","body","outline",[],"relatedStories",[78],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","feCVGIWqMSwU",{"_76":77,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","42ca6167-632d-4f2f-9a2b-b9259354d248",{"_76":77,"_13":14},"platform","雨果跨境",{"_82":83,"_84":85,"_86":87,"_88":89,"_90":-5,"_91":-5,"_92":-5,"_93":-5},"kind","image","url","/amznews-reading-preview/_img/8ac9cba6062793ea.webp","fullUrl","/amznews-reading-preview/_img/8ac9cba6062793ea.webp","srcSet","/amznews-reading-preview/_img/8ac9cba6062793ea.webp 336w, /amznews-reading-preview/_img/8ac9cba6062793ea.webp 720w","width","height","alt","poster","政策/合规","合规税务","亚马逊","aihot","/items/u5r6qihxwwmp0i58tpw0llnn4","https://www.cifnews.com/article/189511","publisher-