[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","u79vk4cahr6t8k4n8b8p62pfe","revision",3,"title","亚马逊印度新增20个履约中心，仓储容量提升50%至6400万立方英尺","originalTitle","亚马逊印度新增20个履约中心，扩张小城市物流网","summary","亚马逊印度宣布启动当地规模最大的运营网络扩张，一次性新增20个履约中心、6个分拣中心和150个末端配送站，整体仓储容量将提升50%至6400万立方英尺。此次扩张重点向二三线城市下沉，赖布尔、兰契和瓦拉纳西将首次迎来履约中心，12座城市首次拥有末端配送站。亚马逊今年将投入超过280亿卢比（约3亿美元）用于强化印度全国运营网络。","reason","source",{"_9":90,"_91":92,"_70":93,"_94":39,"_95":96,"_97":98},"links",{"_87":88,"_65":89},"publishedAt","2026-09-15T08:44:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:19.083Z","timelineAt","category","fba","tags",[82,83,84,85,86],"score",26,"selected",false,"channel","news","story","x","media",[69],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Summer","platform","AMZ123",{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/ee7e89d32460ffb5.webp","fullUrl","/amznews-reading-preview/_img/ee7e89d32460ffb5.webp","srcSet","/amznews-reading-preview/_img/ee7e89d32460ffb5.webp 336w, /amznews-reading-preview/_img/ee7e89d32460ffb5.webp 720w","width","height","alt","poster","FBA/物流","供应链","库存管理","亚马逊","行业动态","aihot","/items/u79vk4cahr6t8k4n8b8p62pfe","https://www.amz123.com/t/WOjgxJ8P","author-amz123-summer","name","AMZ123 · SUMMER","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w,