[{"_1":2,"_3":4},"root",{"_5":100},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","u7wug7m9zm2lc71r8jdejcudv","revision",2,"title","亚马逊美国站预警外国进口商IOR审查，并预告付费邀评广告公测","originalTitle","亚马逊严查！“双清包税”时代结束了......","summary","原文称，亚马逊美国站向卖家发送邮件，提示一项针对外国备案进口商（IOR）的新规定正在接受政府审查、可能很快落地，建议卖家尽早查看海关流程；原文同时提到，美国站将于10月下旬公测付费广告邀评功能Review Requests Ads，该功能与后台免费的Request a Review邮件邀评不是同一功能。原文来自跨境电商头条，文末含多份报告PDF下载推广，存在相关商业利益，并非独立测评。","reason","source",{"_9":90,"_91":92,"_93":94,"_95":40,"_96":97,"_98":99},"links",{"_87":88,"_68":89},"publishedAt","2026-10-22T03:55:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-23T01:40:37.249Z","timelineAt","category","policy","tags",[84,85,86],"score",31,"selected",false,"channel","news","story",{"_78":79,"_13":80},"x","media",[],"byline",{"_53":54,"_82":83},"detailedGuide","readingMode","full","author","跨境电商头条","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":77},"hasTranslation","bodyLanguage","original","factId","fmaocLwjsyyA",{"_78":79,"_13":80},"reportCount",4,"additionalSourceCount",1,"developmentCount",0,"publicId","17e32b95-4b2d-40d4-9f1a-a5926dff996a","亚马逊提醒卖家自查IOR应对美国进口新规",{"_78":79,"_13":80},"platform","AMZ123","政策/合规","FBA/物流","亚马逊","aihot","/items/u7wug7m9zm2lc71r8jdejcudv","https://www.amz123.com/t/pmivSblg","publisher-amz123-headlines","name","AMZ123 · 跨境头条","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_101":102},"changelogV