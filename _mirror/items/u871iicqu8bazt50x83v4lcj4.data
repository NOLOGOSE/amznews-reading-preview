[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","u871iicqu8bazt50x83v4lcj4","revision",2,"title","Seller Labs 发布自家 Amazon MCP 评测：对比电子表格计算真实利润的成本与效率","originalTitle","Seller Labs Amazon MCP Review: True Profit Without Spreadsheets","summary","Seller Labs 发布关于其 Amazon MCP 工具的自我评测，指出该工具连接亚马逊数据至 Claude 或 ChatGPT，支持通过自然语言查询 SKU 级真实利润。原文强调传统电子表格需手动整合交易、广告及仓储报告且耗时，而 Seller Labs 称其 MCP 已预置数据关联并覆盖 10 个站点，但提醒读者因存在商业利益关系，应自行验证效果。","reason","source",{"_9":88,"_89":81,"_90":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_67":87},"publishedAt","2026-10-22T15:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T15:18:26.290Z","timelineAt","category","ai-tools","tags",[82,83,84],"score",27,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Denis D","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fT2vKsZ9fXng",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","088d76ee-1d6a-4174-a1dc-b2a700d55707","Seller Labs 发布 Amazon MCP 自评：利润查询与局限",{"_76":77,"_13":78},"platform","Seller Labs","AI/工具","卖家工具","亚马逊","aihot","/items/u871iicqu8bazt50x83v4lcj4","https://www.sellerlabs.com/blog/seller-labs-amazon-mcp-review-true-profit/","rss-sellerlabs-prelaunch","name","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp","iconSrcSet","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 48w, /amznews-re