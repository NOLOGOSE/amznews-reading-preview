[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","u9eir28o9ciuz7v1rq7bio2bj","revision",2,"title","Five9调查：46%消费者对最近一次AI客服体验评价正面","originalTitle","为什么顾客对AI聊天机器人越来越不满？","summary","Five9自报调查显示，46%的消费者对最近一次使用AI和聊天机器人渠道的体验给予正面评价，低于电话、邮件等渠道约三分之二的正面评价比例。该调查覆盖美国、英国和德国的3000名消费者和600名企业决策者，本站尚未独立核验。原文引述客户体验专家Brad Cleveland的观点，建议企业确保知识库最新准确、用真实且不完美的客户对话进行测试，并衡量失败率和升级率、保留便捷的人工转接通道。","reason","source",{"_9":87,"_88":89,"_90":91,"_92":39,"_93":-5},"links",{"_84":85,"_67":86},"publishedAt","2026-10-23T02:42:48.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-23T04:26:28.116Z","timelineAt","category","ai-tools","tags",[82,83],"score",25,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","AI跨境快讯","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fIW0DxvRsRA8",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","77ee8e03-250a-45a9-b2d1-9a9dd8173855","Five9调查：AI客服体验正面评价仅46%",{"_76":77,"_13":78},"platform","卖家之家","AI/工具","AI工具","aihot","/items/u9eir28o9ciuz7v1rq7bio2bj","https://mjzj.com/article/g21zfng03lky","publisher-mjzj-feed","name","卖家之家 · 跨境资讯","kind","rss","firstParty","iconUrl",{"_95":96},"changelogVersion","2026-10-09T22:08"]
