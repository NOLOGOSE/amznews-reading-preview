[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":29,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":62,"_63":38,"_64":65},"id","ug2zc4jpgnm72ikfn64rlpkd8","revision",2,"title","欧洲时尚美妆奢侈500强出炉，跨境销售达790亿欧元","originalTitle","summary","欧洲跨境电商协会（Cbcommerce）发布第五版《欧洲跨境时尚、美妆及奢侈品零售500强》。2025财年该500强线上总收入达1200亿欧元，其中跨境占66%、欧洲跨境销售额790亿欧元。时尚、美妆与奢侈品占欧洲全部线上产品销售额的23%，500强企业占该地区线上交易近65%。","reason","source",{"_9":100,"_101":102,"_81":103,"_104":38,"_105":106,"_107":108},"links",{"_97":98,"_65":99},"publishedAt","2026-10-19T06:46:41.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-19T07:41:38.710Z","timelineAt","category","product","tags",[95,96],"score",26,"selected",false,"channel","news","story",{"_74":75,"_13":76},"x","media",[80],"byline",{"_51":-5,"_78":79},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[77],"indexable","markdownAvailable",true,"group",{"_66":67,"_41":68,"_69":70,"_71":72,"_73":72},"hasTranslation","bodyLanguage","original","factId","fvCfNSw8eHuI",{"_74":75,"_13":76},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","c9cbee96-dde3-41d2-b27a-fbfb87522974","欧洲跨境时尚美妆奢侈500强：跨境销售790亿欧元",{"_74":75,"_13":76},"platform","蓝海亿观网",{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5},"kind","image","url","/amznews-reading-preview/_img/2c41477b951c0411.webp","fullUrl","/amznews-reading-preview/_img/2c41477b951c0411.webp","srcSet","/amznews-reading-preview/_img/2c41477b951c0411.webp 336w, /amznews-reading-preview/_img/2c41477b951c0411.webp 720w","width",760,"height",400,"alt","poster","选品/市场","品类趋势","aihot","/items/ug2zc4jpgnm72ikfn64rlpkd8","https://www.egainnews.com/article/74414","publisher-egain