[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","ume043kof47fy52qh4mlhiqtc","revision",3,"title","不会写提示词？先让AI反问你~","originalTitle","​不会写提示词？先让AI反问你~","summary","作者以蓝牙音箱为例，分享用AI生成亚马逊产品图的三步法：先拍产品关键角度图发给AI，再把提示词框架交给AI并让AI反问以补全信息，最后用反推出的提示词正式生图，并提到可继续局部编辑。作者自述新模型出图在细节、一致性和稳定性上比上一代有进步，但卖点判断、转化逻辑等仍需人工主导。以上为作者个人体验，本站尚未独立核验。","reason","source",{"_9":120,"_121":68,"_78":122,"_123":40,"_124":125,"_126":127},"links",{"_117":118,"_66":119},"publishedAt","2026-09-13T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-14","discoveredAt","2026-10-07T13:47:12.754Z","timelineAt","category","ai-tools","tags",[114,115,116],"score",32,"selected",false,"channel","news","story","x","media",[69,70,71,72,73,74,75,76,77],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","阿浩的广告复盘","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_78":79,"_80":111,"_82":112,"_84":113,"_86":-5,"_87":-5,"_88":-5,"_89":-5},{"_78":79,"_80":108,"_82":109,"_84":110,"_86":-5,"_87":-5,"_88":-5,"_89":-5},{"_78":79,"_80":105,"_82":106,"_84":107,"_86":-5,"_87":-5,"_88":-5,"_89":-5},{"_78":79,"_80":102,"_82":103,"_84":104,"_86":-5,"_87":-5,"_88":-5,"_89":-5},{"_78":79,"_80":99,"_82":100,"_84":101,"_86":-5,"_87":-5,"_88":-5,"_89":-5},{"_78":79,"_80":96,"_82":97,"_84":98,"_86":-5,"_87":-5,"_88":-5,"_89":-5},{"_78":79,"_80":93,"_82":94,"_84":95,"_86":-5,"_87":-5,"_88":-5,"_89":-5},{"_78":79,"_80":90,"_82":91,"_84":92,"_86":-5,"_87":-5,"_88":-5,"_89":-5},{"_78":79,"_80":81,"_82":83,"_84":85,"_86":-5,"_87":-5,"_88":-5,"_89":-5},"kind","