[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","uq4mboqt3csy72oiwvdbyafpn","revision",1,"title","美国与14个经济体签署联合部长声明应对全球制造业产能过剩","originalTitle","Fourteen Economies Join the United States in Signing a Joint Ministerial Statement to Address Global Excess Capacity and Production in Key Manufacturing Sectors","summary","美国贸易代表办公室宣布，在OECD贸易委员会会议期间，美国与阿根廷、欧盟等14个经济体的贸易部长共同签署联合部长声明。该声明旨在通过建立新的专门部门平台，解决关键制造业领域的结构性产能过剩问题，并呼吁各国终止扭曲市场的非市场政策与实践。","reason","source",{"_9":72,"_73":74,"_75":76,"_77":60,"_78":79,"_80":81},"links",{"_69":70,"_64":71},"publishedAt","2026-10-07T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T09:19:32.339Z","timelineAt","category","policy","tags",[67,68],"score",20,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","USTR","政策/合规","行业动态","aihot","/items/uq4mboqt3csy72oiwvdbyafpn","https://ustr.gov/about/policy-offices/press-office/press-releases/2026/october/fourteen-economies-join-united-states-signing-joint-ministerial-statement-address-global-excess","official-ustr-press-releases-rolling","name","USTR 美国贸易代表办公室公告","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/dbeb162d0fa0fbc6.webp","iconSrcSet","/amznews-reading-preview/_img/dbeb162d0fa0fbc6.webp 48w, /amznews-reading-preview/_img/dbeb162d0fa0fbc6.webp 96w",{"_83":84},"changelogVersion","2026-10-09T22:08"]
