[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ustku22r6yostw5bkg5l3do8f","revision",1,"title","亚马逊印度站2026年下调卖家费用，1000卢比以下商品佣金归零","originalTitle","1000卢比以下商品佣金归零！亚马逊印度站2026新政，卖家最高省70%费用!","summary","亚马逊印度站自2026年3月16日起下调卖家费用，1000卢比以下商品推荐费归零，覆盖超1800个品类，零推荐费商品从1.2亿件增至12.5亿件。1000卢比以上热门品类推荐费下调4%至9.5%，300卢比以下订单结算费从45卢比降至20卢比，亚马逊官方称卖家最高可节省70%费用。文章还提到印度FDI政策要求零售须用印度公司主体，并列出IBS、自有印度公司、海外分销三条入驻路径。","reason","source",{"_9":89,"_90":91,"_69":92,"_93":39,"_94":95,"_96":97},"links",{"_86":87,"_65":88},"publishedAt","2026-04-12T02:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:07.091Z","timelineAt","category","policy","tags",[81,82,83,84,85],"score",66,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","隔壁老王说跨境","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/0448c53fb5d4dffd.webp","fullUrl","/amznews-reading-preview/_img/0448c53fb5d4dffd.webp","srcSet","/amznews-reading-preview/_img/0448c53fb5d4dffd.webp 336w, /amznews-reading-preview/_img/0448c53fb5d4dffd.webp 720w","width","height","alt","poster","费用变更","亚马逊","FBA/物流","合规税务","选品/市场","aihot","/items/ustku22r6yostw5bkg5l3do8f","https://www.amz123.com/t/8KW3OL2U","author-amz123-gebiwang-reviewed","name","AMZ123 · 隔壁老王说跨境","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-rea