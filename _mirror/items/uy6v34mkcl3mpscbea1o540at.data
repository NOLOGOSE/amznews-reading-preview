[{"_1":2,"_3":4},"root",{"_5":111},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","uy6v34mkcl3mpscbea1o540at","revision",7,"title","亚马逊视频创作者最高佣金品类分析：Amazon Games 20%、Luxury Beauty 10%，站内费率更低","originalTitle","Which Amazon Product Categories Pay the Highest Commission for Video Creators?","summary","ZonBase 指出 Amazon Games（20%）和 Luxury Beauty（10%）是亚马逊站外链接中佣金最高的品类，但 Amazon Games 可评测商品极少。站内 Influencer Program 费率通常低于站外，多在 1%-5% 之间，且受页面流量影响更大。作者建议结合价格与转化率选择 Kitchen（4.5%）等适合短视频展示的品类，并推广其免费 ACE 培训工具。","reason","source",{"_9":103,"_104":81,"_83":105,"_106":39,"_107":108,"_109":110},"links",{"_100":101,"_67":102},"publishedAt","2026-10-18T13:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-09T08:57:34.945Z","timelineAt","category","advertising","tags",[97,98,99],"score",38,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","zeeshan","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","f-3Wi4P3840I",{"_76":77,"_13":78},"reportCount",2,"additionalSourceCount",0,"developmentCount","publicId","f9efc448-df18-47c9-a6f6-919a8c87a76a","亚马逊创作者视频佣金模式与品类费率解析",{"_76":77,"_13":78},"platform","ZonBase",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/68ece41d3ab356cd.webp","fullUrl","/amznews-reading-preview/_img/68ece41d3ab356cd.webp","srcSet","/amznews-reading-preview/_img/68ece41d3ab356cd.webp 336w, /amznews-reading-preview/_im