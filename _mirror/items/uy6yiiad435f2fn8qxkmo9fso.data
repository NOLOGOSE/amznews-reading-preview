[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","uy6yiiad435f2fn8qxkmo9fso","revision",1,"title","亚马逊将 Amazon Now 30分钟送达服务从试点扩展至美国主要城市","originalTitle","Amazon cranks up 30-minute delivery in major U.S. cities","summary","亚马逊宣布将 Amazon Now 服务从有限试点扩展为大规模商业运营，在亚特兰大、达拉斯等数十个美国城市提供30分钟内送达。该服务依托微型履约中心，Prime会员每单配送费$3.99（非会员$13.99），订单低于$15需加收小额费用。此举旨在提升配送速度以应对沃尔玛等竞争对手，但亚马逊不保证严格30分钟送达，仅提供时间更新。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-05-12T17:10:04.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:42.514Z","timelineAt","category","fba","tags",[68,69,70],"score",25,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves","FBA/物流","供应链","亚马逊","aihot","/items/uy6yiiad435f2fn8qxkmo9fso","https://www.freightwaves.com/news/amazon-cranks-up-30-minute-delivery-in-major-u-s-cities","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
