[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","uz8tfobuwigdbeooyj3t6gnta","revision",2,"title","黑五前30天，别再找新网红达人了","originalTitle","summary","作者基于自身站外达人合作经验提出：黑五前30天不宜大规模冷启动新达人，因建联、寄样、拍摄、审稿走完约需四到六周，此时新建联难以赶上11月27日黑五；建议把过去12个月合作过的达人拉表打分、优先激活A档，仅留20%名额做补位，给老达人明确的旺季内容包，谈下旧内容的二次剪辑与白名单授权，并捡起邮件、短信、老客专属码和私域群。作者还提到窗口前移与毛利变薄两点变化，其中引用的消费者调研与关税说法本站尚未独立核验。以上为作者观点，适用条件与例外以原文为准。","reason","source",{"_9":105,"_106":107,"_84":108,"_109":39,"_110":111,"_112":113},"links",{"_102":103,"_67":104},"publishedAt","2026-10-20T06:13:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-20","discoveredAt","2026-10-21T02:23:13.086Z","timelineAt","category","advertising","tags",[99,100,101],"score",47,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82,83],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","C姐说品牌","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fbCpZ7o-l308",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","278d9886-73cc-41ba-b04f-0cf07b1a3a9f","黑五前30天达人营销策略建议",{"_76":77,"_13":78},"platform","AMZ123",{"_84":85,"_86":96,"_88":97,"_90":98,"_92":-5,"_93":-5,"_94":-5,"_95":-5},{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/415e43474867c043.webp","fullUrl","/amznews-reading-preview/_img/415e43474867c043.webp","srcSet","/amznews-reading-preview/_img/415e43474867c043.webp 336w, /amznews-reading-preview/_img/415e434748