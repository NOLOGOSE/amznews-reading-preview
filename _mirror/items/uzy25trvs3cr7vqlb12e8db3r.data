[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","uzy25trvs3cr7vqlb12e8db3r","revision",2,"title","爱尔兰电商交易额预计2026年达178亿欧元，网购普及率居欧洲首位","originalTitle","26年爱尔兰电商市场将达178亿欧元，网购普及率欧洲第一","summary","爱尔兰数字商业协会分析显示，该国电商交易额预计2026年达178亿欧元，较2025年增长8%，且2025年16至74岁消费者网购普及率达95%居欧洲38国之首。DBI创始人呼吁政府扩大“数字化发展券”补贴以助中小企业应对AI技术差距，该计划目前提供最高5000欧元支持符合条件的数字化投资。","reason","source",{"_9":101,"_102":103,"_84":104,"_105":40,"_106":107,"_108":109},"links",{"_98":99,"_68":100},"publishedAt","2026-10-18T20:03:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-19T04:38:37.590Z","timelineAt","category","product","tags",[96,97],"score",40,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","欧洲电商资讯","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fOGnfePHaQy8",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","4a32bbcd-3f61-4da9-99ec-db3a5f978f49","爱尔兰2026年电商规模预计达178亿欧元",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/76d05fff95fd1e95.webp","fullUrl","/amznews-reading-preview/_img/76d05fff95fd1e95.webp","srcSet","/amznews-reading-preview/_img/76d05fff95fd1e95.webp 336w, /amznews-reading-preview/_img/76d05fff95fd1e95.webp 720w","width","height","alt","poster","选品/市场","品类趋势","aihot","/items/uzy25trvs3cr7vqlb12e8db3r","htt