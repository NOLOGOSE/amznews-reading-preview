[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","v0clxjifmksgqmg6egh6zbkln","revision",1,"title","Love To Dream 召回便携式睡眠机，存在火灾和烧伤风险","originalTitle","Love To Dream Recalls Portable Sleep Machines Due to Risk of Injury from Fire and Burn Hazards","summary","Love To Dream 召回约 4,000 台便携式睡眠机（型号 LTD-SM23、日期码 7W15TN），因充电器不兼容时锂电池可能过热，存在火灾和烧伤风险。消费者应立即停用并在官网注册以获得全额退款，退款通过电子支付或店铺积分发放。该产品 2025 年 2 月至 2026 年 9 月在 Target、Nordstrom 及亚马逊等渠道以约 60 美元售出，目前无事故报告。","reason","source",{"_9":73,"_74":66,"_75":76,"_77":60,"_78":79,"_80":81},"links",{"_70":71,"_64":72},"publishedAt","2026-09-24T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T14:12:19.627Z","timelineAt","category","policy","tags",[67,68,69],"score",22,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","CPSC 美国消费品安全委员会","政策/合规","退货管理","亚马逊","aihot","/items/v0clxjifmksgqmg6egh6zbkln","https://cpsc.gov/Recalls/2026/Love-To-Dream-Recalls-Portable-Sleep-Machines-Due-to-Risk-of-Injury-from-Fire-and-Burn-Hazards","official-cpsc-amazon-recalls-reviewed","name","kind","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp","iconSrcSet","/amznews-reading-preview/_img/382881c3aef48a1a.webp 48w, /amznews-reading-preview/_img/382881c3aef48a1a.webp 96w",{"_83":84},"changelogVersion","2026-10-09T22:08"]
