[{"_1":2,"_3":4},"root",{"_5":120},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","v4w41ing51sd3k03e1xgw4zq6","revision",2,"title","亚马逊卖家因税务数据差异被警告，深圳一卖家被罚182万元","originalTitle","亚马逊卖家被税务多次警告！已有大卖直接被罚182万元","summary","部分亚马逊卖家收到税务风险提示短信，指出申报收入与平台报送收入存在差异。近期深圳一位北美站卖家因长期少报收入被税务部门查实，补缴税款及滞纳金合计182万元。文章建议卖家核实主体与口径，拉取平台订单、费用、流水等五类资料进行季度核对，并在专业人士协助下依法更正申报，避免将净回款直接等同于销售收入。","reason","原文通过深圳卖家被罚182万元的案例，揭示了平台数据与申报差异的常见成因及应对步骤，为跨境卖家提供了具体的合规自查路径。","source",{"_9":111,"_112":113,"_87":114,"_115":67,"_116":117,"_118":119},"links",{"_108":109,"_69":110},"publishedAt","2026-10-19T07:59:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-20T08:05:39.681Z","timelineAt","category","policy","tags",[105,106,107],"score",70,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","速推站外","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":76,"_77":74},"hasTranslation",false,"bodyLanguage","original","factId","f44UmLPw3fF0",{"_78":79,"_13":80},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","3a33e402-9e5d-4faf-9524-2ef79929ad65","多地跨境卖家收税务风险提示",{"_78":79,"_13":80},"platform","AMZ123",{"_87":88,"_89":102,"_91":103,"_93":104,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":99,"_91":100,"_93":101,"_95":-5,"_96":-5,"_97":-5,"_98":-5},{"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5,"_97":-5,"_98":-5},"kind","image","url","/amznews-reading-preview/_img/34f7945ed62f97fc.webp","fullUrl","/amznews-reading-preview/_img/34f7945ed62f97fc.webp","srcS