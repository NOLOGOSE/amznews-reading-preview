[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","v75zajzx2jryg82yefe55zclx","revision",2,"title","如何确定亚马逊 PPC 的理想 True ACoS 并设定广告目标","originalTitle","How to Find the Ideal True ACoS on Amazon PPC and Set Campaign Targets","summary","My Amazon Guy 提出通过计算广告前利润率、扣除目标净利率并按增长阶段调整，再除以广告销售占比来推导理想 True ACoS 及 Campaign ACoS。True ACoS 基于总销售额（含自然订单）衡量整体广告成本，比仅看直接转化的 Campaign ACoS 更贴近业务利润底线。不同 ASIN 需根据各自利润率与生命周期独立设定目标，避免套用通用基准导致预算错配。","reason","source",{"_9":88,"_89":90,"_91":92,"_93":39,"_94":95,"_96":97},"links",{"_85":86,"_67":87},"publishedAt","2026-10-14T01:21:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-14T11:46:30.638Z","timelineAt","category","advertising","tags",[82,83,84],"score",38,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Ken Zhou","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fUdnjmuhNKaY",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","6c728aba-c0b7-45b3-b7b6-2b1b429c3d9f","亚马逊 True ACoS 目标设定方法",{"_76":77,"_13":78},"platform","My Amazon Guy","广告/运营","广告投放","亚马逊","aihot","/items/v75zajzx2jryg82yefe55zclx","https://myamazonguy.com/advertising/how-to-find-the-ideal-true-acos-on-amazon-ppc/","author-myamazonguy-ken-zhou-rolling","name","My Amazon Guy · Ken Zhou","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/2367a94bae94b1de.webp","iconSrcSet","/amznews-reading-preview