[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","v7njsk524ndw9fxjipdnmzqkq","revision",2,"title","Feedviser 与 PartnerCentric 调研：AI 助推商品发现但评论仍决定购买","originalTitle","AI boosts discovery but reviews still seal the deal, new research shows","summary","Feedviser 自报调查显示，16% 的购物者通过 ChatGPT 开始寻找产品，但仅 9% 在此直接购买；PartnerCentric 数据指出，33% 的受访者在 AI 推荐后会去查看现有评论。该机构调查表明，即便在高度信任 AI 的用户中，仍有 42.2% 希望先看评论再行动，且 33% 的购物者称运费和退货政策常改变其购买决策。","reason","source",{"_9":87,"_88":89,"_90":91,"_92":39,"_93":94,"_95":96},"links",{"_84":85,"_67":86},"publishedAt","2026-10-22T04:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T04:05:26.442Z","timelineAt","category","ai-tools","tags",[82,83],"score",40,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Gabriela Barkho","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fhwcr-f6ldxU",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","54ce4f0f-522f-4127-8078-9eea237c3048","调查：AI 助推商品发现，评论仍决定购买",{"_76":77,"_13":78},"platform","modern-retail","AI/工具","行业动态","aihot","/items/v7njsk524ndw9fxjipdnmzqkq","https://www.modernretail.co/ai-strategies/ai-boosts-discovery-but-reviews-still-seal-the-deal-new-research-shows/?utm_campaign=modernretaildis&utm_medium=rss&utm_source=general-rss","author-modern-retail-gabriela-barkho","name","modern-retail · Gabriela Barkho","kind","rss","firstParty","iconUrl","/