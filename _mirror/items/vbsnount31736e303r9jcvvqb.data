[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","vbsnount31736e303r9jcvvqb","revision",2,"title","德国一次性塑料基金法新增烟花品类 跨境卖家需在DIVID完成注册","originalTitle","德国一次性塑料新规更新！跨境卖家务必提前完成DIVID注册！","summary","原文由乐鱼跨境发布，介绍德国一次性塑料基金法（EWKFondsG）将含塑料部件的烟花新增为受管制品类，主管机构为德国环境局UBA，义务主体需在DIVID平台完成注册并获取注册号。原文称烟花品类2026年无需申报、2027年起计征费用，并称首次将产品投放德国市场的进口商、品牌商及海外跨境卖家均属义务责任人，注册需指定授权代表。原文还称亚马逊等电商平台会校验一次性塑料注册号，并提及违规售卖最高可罚10万欧元；上述平台校验与处罚表述为原文作者说法，本站尚未独立核验相关法规条文与平台规则。原文同时说明EWKFondsG与VerpackDG包装法相互独立，分别监管产品本体自带的一次性塑料零件和产品外包装。原文来自该机构，存在相关商业利益，并非独立测评。","reason","source",{"_9":133,"_134":135,"_92":136,"_137":40,"_138":139,"_140":141},"links",{"_130":131,"_68":132},"publishedAt","2026-10-22T02:59:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-23T01:40:37.295Z","timelineAt","category","policy","tags",[128,129],"score",55,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89,90,91],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","乐鱼跨境","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fAGtZNqPru90",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","9f383a8e-a871-475b-9437-4118766f1ab9","德国EWKFondsG新增烟花品类 跨境卖家需DIVID注册",{"_77":78,"_13":79},"platform","AMZ123",{"_92":93,"_94":125,"_96":126,"_98":127,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":122,"_96":123,"_98":124,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":119,"_96":120,"_98":121,"_100":-5,"_101"