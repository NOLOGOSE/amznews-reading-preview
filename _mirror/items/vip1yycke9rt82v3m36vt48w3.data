[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","vip1yycke9rt82v3m36vt48w3","revision",3,"title","如何用 ChatGPT 做出高质量的亚马逊主图和 A+？附完整案例与 Skill","originalTitle","summary","作者 Ai史莱姆分享了一套用 ChatGPT 制作亚马逊主图和 A+ 页面的设计流程，并整理成「史莱姆亚马逊设计 skill」，目前在 Codex 中使用，生图调用环境里自带的原生工具，源码与使用说明已发布在 GitHub，安装范围及依赖以仓库说明为准。流程先从竞对页面拆出卖点逻辑，再由 AI 自动搜集画面与排版参考、结合自家产品多角度图约束一致性，生图后做 QC 并对具体问题返工，作者强调生成后仍需自行检查，不能默认每一处都准确。","reason","source",{"_9":95,"_96":66,"_70":97,"_98":38,"_99":100,"_101":102},"links",{"_92":93,"_64":94},"publishedAt","2026-09-13T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:45:54.283Z","timelineAt","category","ai-tools","tags",[88,89,90,91],"score",54,"selected",false,"channel","news","story","x","media",[67,68,69],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","Ai史莱姆","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_70":71,"_72":85,"_74":86,"_76":87,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":82,"_74":83,"_76":84,"_78":-5,"_79":-5,"_80":-5,"_81":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/557e5eb68c0960ef.webp","fullUrl","/amznews-reading-preview/_img/557e5eb68c0960ef.webp","srcSet","/amznews-reading-preview/_img/557e5eb68c0960ef.webp 336w, /amznews-reading-preview/_img/557e5eb68c0960ef.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/bab9db9ac6bcc971.webp","/amznews-reading-preview/_img/bab9db9ac6bcc971.webp","/amznews-reading-preview/_img/bab9d