[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","vjt0gxyqwn4waf0js24i3je9u","revision",5,"title","亚马逊后台订单突然“消失”广告费却还在烧，卖家如何判断是延迟还是真跌","originalTitle","亚马逊订单突然“消失”，广告费却还在烧","summary","近日不少亚马逊卖家发现 Seller Central 订单更新时间、当日销量和销售额长时间停滞，广告后台却仍有点击、花费和归因订单。截至素材成稿时，亚马逊尚未针对本轮异常发布公开说明。卖家可交叉核对订单管理、付款通知、广告归因和前台链接，先判断是数据延迟还是经营下滑，再决定是否调整广告。","reason","source",{"_9":99,"_100":101,"_72":102,"_103":39,"_104":105,"_106":107},"links",{"_96":97,"_65":98},"publishedAt","2026-09-14T19:51:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:00.956Z","timelineAt","category","advertising","tags",[93,94,95],"score",34,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","CC站外推广","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_72":73,"_74":90,"_76":91,"_78":92,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/3f253bbb891b90d8.webp","fullUrl","/amznews-reading-preview/_img/3f253bbb891b90d8.webp","srcSet","/amznews-reading-preview/_img/3f253bbb891b90d8.webp 336w, /amznews-reading-preview/_img/3f253bbb891b90d8.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/c268cb0ff808d9b5.webp","/amznews-reading-preview/_img/c268cb0ff808d9b5.webp","/amznews