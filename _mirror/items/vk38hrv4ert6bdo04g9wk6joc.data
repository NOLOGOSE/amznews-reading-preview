[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","vk38hrv4ert6bdo04g9wk6joc","revision",1,"title","欧盟海关申报单（SAD）填写指南：面向跨境电商品牌","originalTitle","Single Administrative Documents: The Guide for Ecommerce Brands","summary","SimplyVAT 发布文章介绍欧盟海关申报单（SAD）的填写框架。SAD 是欧盟用于跨境货物申报的标准化表格，共 54 个栏位。原文指出，英国在 2021 年脱欧后已停用 SAD，改用 C88 表格，C88 和 CHIEF 系统又于 2024 年被 CDS 取代；从英国发往欧盟的货物需要分别提交英国出口申报和欧盟进口 SAD。原文还说明，多数情况下由报关代理提交 SAD，并列出填写所需的信息类别，以及商品编码、原产地、估值和单证一致性等常见错误。原文来自 SimplyVAT，该机构同时销售报关代理服务，存在相关商业利益，并非独立测评。","reason","source",{"_9":88,"_89":90,"_69":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_65":87},"publishedAt","2026-09-01T15:49:17.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T18:36:26.917Z","timelineAt","category","fba","tags",[82,83,84],"score",27,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Jenny Budd","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SimplyVAT",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":80,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/19083cc62767c55b.webp","fullUrl","/amznews-reading-preview/_img/19083cc62767c55b.webp","srcSet","/amznews-reading-preview/_img/19083cc62767c55b.webp 336w, /amznews-reading-preview/_img/19083cc62767c55b.webp 720w","width","height","alt","UK & EU LANDED COST CALCULATOR   Work out what a shipment will cost once it clears customs, from duty to VAT  ","poster","FBA/物流","合规税务","供应链","aihot","/items/vk38hrv4ert6bdo04g9wk6joc","https://simplyvat.com/blog/single-administrative-documents/","publisher-simplyvat-blog","name","SimplyVAT · 国际 VAT 与跨境平台合规","rss","firstParty","iconUrl","/amznews-reading-preview/_img/7b583a80b7d3d834.webp","iconSrcSet","/amznews-reading-preview/_img/7b583a80b7d3d834.webp 48w, /amznews-reading-preview/_img/7b583a80b7d3d834.webp 96w",{"_98":99},"changelogVersion","2026-10-09T22:08"]
