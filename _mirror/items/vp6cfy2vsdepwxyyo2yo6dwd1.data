[{"_1":2,"_3":4},"root",{"_5":87},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","vp6cfy2vsdepwxyyo2yo6dwd1","revision",2,"title","亚马逊旺季临近，卖家现在就该准备的5件事：促销延期、广告诉讼、品牌起诉与AI广告测试","originalTitle","亚马逊旺季临近，这5件事卖家现在就该准备了","summary","亚马逊已将 Prime Big Deal Days 的 Deal 提交窗口延长至 9月22日，但 FBA 入仓时间并未同步延长。美国 FTC 联合22个州起诉亚马逊广告竞价机制，涉及超过100万广告客户；同时亚马逊正在美国测试通过 Amazon DSP 向 ChatGPT 提供广告。此外，Amway 起诉一家亚马逊卖家，印度班加罗尔仓库被查出食品过期及药品许可证问题。","reason","source",{"_9":77,"_78":79,"_80":81,"_82":39,"_83":84,"_85":86},"links",{"_74":75,"_65":76},"publishedAt","2026-09-23T06:43:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-05T11:15:55.028Z","timelineAt","category","advertising","tags",[68,69,70,71,72,73],"score",26,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","跨境视频cici","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","雨果跨境","广告/运营","广告投放","Listing优化","合规税务","库存管理","亚马逊","aihot","/items/vp6cfy2vsdepwxyyo2yo6dwd1","https://www.cifnews.com/article/189011","author-cifnews-cici","name","雨果跨境 · 跨境视频cici","kind","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp","iconSrcSet","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 48w, /amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp 96w",{"_88":89},"changelogVersion","2026-10-09T22:08"]
