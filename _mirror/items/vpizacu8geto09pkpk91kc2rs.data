[{"_1":2,"_3":4},"root",{"_5":103},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":-5,"_64":40,"_65":66},"id","vpizacu8geto09pkpk91kc2rs","revision",3,"title","亚马逊卖家咨询划线价维持机制及系统抓取规则","originalTitle","划线价【亿级大佬】请进屋~疑惑点，比如我提供图片的这个，为什么它没有把价格恢复到原价79.99（就是没有恢复到List Price和Your Price 79.99）却能一直保持79.99划线价呢？谢谢","summary","原文作者向资深卖家请教亚马逊划线价（List Price）的维持逻辑，质疑为何某商品未恢复原价仍能保持划线价。作者分享其通过设置 List Price 59.99 美金、短期出单后修改 Sales Price 至 49.99 美金并设定 2 个月活动期来生成划线价的操作经验，同时询问该反复调价是否影响链接权重及如何验证系统是否成功抓取划线价。","reason","source",{"_9":95,"_96":68,"_72":97,"_98":40,"_99":100,"_101":102},"links",{"_92":93,"_66":94},"publishedAt","2026-09-15T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-16","discoveredAt","2026-10-07T12:46:22.841Z","timelineAt","category","advertising","tags",[90,91],"score",24,"selected",false,"channel","news","story","x","media",[69,70,71],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","江寒月111222","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/833b696188ce21e5.webp","fullUrl","/amznews-reading-preview/_img/833b696188ce21e5.webp","srcSet","/amznews-reading-preview/_img/833b696188ce21e5.webp 336w, /amznews-reading-preview/_img/833b696188ce21e5.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/f671713c29581181.webp","/amznews-reading-preview/_img/f6717