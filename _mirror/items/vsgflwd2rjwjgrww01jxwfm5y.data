[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","vsgflwd2rjwjgrww01jxwfm5y","revision",2,"title","以后亚马逊卖家的差距，可能不在谁会用AI","originalTitle","summary","Y Combinator CEO Garry Tan 今年八月在 Startup School 演讲中提出，模型权重是租来的商品，个人积累的上下文才是复制不走的部分，并称\"你租来的智能，永远不会像你拥有的智能那样产生复利\"。原文作者据此认为，亚马逊卖家若长期记录选品、广告调整与踩坑复盘，AI 能将这些经验系统性重新调用；若从未认真记录，AI 放大零仍是零。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":38,"_80":81,"_82":83},"links",{"_71":72,"_64":73},"publishedAt","2026-10-05T21:07:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-08T02:33:36.459Z","timelineAt","category","ai-tools","tags",[67,68,69,70],"score",12,"selected",false,"channel","news","story","x","media",[],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","一汤说","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123","AI/工具","AI工具","亚马逊","品牌","aihot","/items/vsgflwd2rjwjgrww01jxwfm5y","https://www.amz123.com/t/s7is0R0r","author-amz123-yitang-reviewed","name","AMZ123 · 一汤说","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
