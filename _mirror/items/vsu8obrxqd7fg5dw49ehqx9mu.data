[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","vsu8obrxqd7fg5dw49ehqx9mu","revision",3,"title","亚马逊宣布9月1日起PAN-EU及发往法国货件须提供MRN和EORI","originalTitle","9/1起，通过PAN-EU入库欧盟货件以及直接发往法国的货件必须提供MRN+EORI","summary","亚马逊规定自2026年9月1日起，非欧盟注册卖家通过Pan-EU计划入库欧盟运营中心或直接发往法国的货件，必须在收到首个货件后60天内提供有效的运输参考编号（MRN）和经济营运者注册识别号（EORI）。若逾期未提交，卖家将无法创建新的欧盟入库货件，但已入库库存的销售不受影响。该要求依据《法国税法典》，旨在加强海关申报信息的收集与核验。","reason","明确了从仅法国扩展至全欧盟的适用范围，以及60天未提交将禁止创建新货件的执行后果。","source",{"_9":75,"_76":77,"_78":79,"_80":41,"_81":-5},"links",{"_72":73,"_66":74},"publishedAt","2026-08-10T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-08-11","discoveredAt","2026-10-16T14:13:44.087Z","timelineAt","category","policy","tags",[69,70,71],"score",82,"selected",true,"channel","news","story","x","media",[],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","亚马逊全球开店","政策/合规","FBA/物流","亚马逊","aihot","/items/vsu8obrxqd7fg5dw49ehqx9mu","https://gs.amazon.cn/news/news-notices-260811","official-amazon-global-selling-news","name","亚马逊全球开店 · 官方资讯","kind","web_list","firstParty","iconUrl",{"_83":84},"changelogVersion","2026-10-09T22:08"]
