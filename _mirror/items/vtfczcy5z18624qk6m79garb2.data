[{"_1":2,"_3":4},"root",{"_5":139},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","vtfczcy5z18624qk6m79garb2","revision",2,"title","作者分享用卖家精灵 MCP 与 AI 追踪亚马逊新品爆发过程的分析方法","originalTitle","把新品分析做成了一个 Skill：AI自动追踪新品爆发全过程","summary","作者以亚马逊美国站“双磁吸汽车挡风玻璃清洁器”为例，分享用 AI 调用卖家精灵 MCP 的分析流程：先判断类目新品比例，再查看细分关键词下销量靠前链接的上架时间分布，并与 Google Trends、TikTok、Facebook、Reddit 等站外信号交叉对照。文中新品占比与销量份额等数字来自作者使用卖家精灵 MCP 的查询结果，样本范围有限，本站尚未独立核验，不能推广为品类总体结论。原文多次提及卖家精灵 MCP，存在相关商业利益，并非独立测评。作者提出可将该流程固化为 Skill，属于作者观点。","reason","source",{"_9":130,"_131":132,"_91":133,"_134":40,"_135":136,"_137":138},"links",{"_127":128,"_68":129},"publishedAt","2026-10-21T00:53:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-21","discoveredAt","2026-10-22T04:00:24.658Z","timelineAt","category","ai-tools","tags",[124,125,126],"score",38,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89,90],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","咱们的跨境运营笔记","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f7ApL64QQKgQ",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","9bad107b-5722-4aad-903b-3e9745058865","作者分享用卖家精灵MCP追踪亚马逊磁吸清洁器新品爆发",{"_77":78,"_13":79},"platform","AMZ123",{"_91":92,"_93":121,"_95":122,"_97":123,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":118,"_95":119,"_97":120,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":115,"_95":116,"_97":117,"_99":-5,"_100":-5,"_101":-5,"_102":-5},{"_91":92,"_93":112,"_95":113,"_97":114,"_9