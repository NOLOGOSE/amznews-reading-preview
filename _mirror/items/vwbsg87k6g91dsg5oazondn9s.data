[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":40,"_60":61,"_62":-5,"_63":40,"_64":65},"id","vwbsg87k6g91dsg5oazondn9s","revision",1,"title","亚马逊广告推出 Sponsored Services 效果广告解决方案","originalTitle","Sponsored Services: Capture demand now","summary","亚马逊广告于 2026 年 9 月 29 日推出 Sponsored Services，这是一项面向本地及在线服务提供商的全新效果广告解决方案。该功能利用 AI 意图识别在亚马逊各渠道高购买意向节点投放广告，支持按成果付费 (CPO) 模式并具备广告内对话式流程。目前仅在美国推出，自 2026 年第 4 季度起仅可通过亚马逊广告统一 API 访问，广告平台访问权限将于 2027 年跟进。","reason","source",{"_9":104,"_105":106,"_72":107,"_108":61,"_109":110,"_111":112},"links",{"_101":102,"_65":103},"publishedAt","2026-09-29T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-29","discoveredAt","2026-10-22T17:24:11.696Z","timelineAt","category","advertising","tags",[98,99,100],"score",18,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_52":-5,"_66":67},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊广告",{"_72":73,"_74":93,"_76":94,"_78":95,"_80":96,"_82":97,"_84":-5,"_85":-5},{"_72":73,"_74":90,"_76":91,"_78":92,"_80":81,"_82":89,"_84":-5,"_85":-5},{"_72":73,"_74":86,"_76":87,"_78":88,"_80":81,"_82":89,"_84":-5,"_85":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":83,"_84":-5,"_85":-5},"kind","image","url","/amznews-reading-preview/_img/7afa773bfcc21467.webp","fullUrl","/amznews-reading-preview/_img/7afa773bfcc21467.webp","srcSet","/amznews-reading-preview/_img/7afa773bfcc21467.webp 336w, /amznews-reading-preview/_img/7afa773bfcc21467.webp 720w","width",602,"height",454,"alt","poster","/amznews-reading-preview/_im