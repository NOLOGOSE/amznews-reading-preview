[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","vxmg9j9n0jlaq7vamxyl4raiq","revision",7,"title","亚马逊创作者视频收益模式：按销售佣金而非浏览量结算","originalTitle","How Do Creators Get Paid for Amazon Product Review Videos?","summary","亚马逊创作者通过产品评测视频获得收入主要依赖销售佣金，而非按浏览量付费。原文来自ZonBase，该机构销售自有产品研究工具并提供相关培训，存在相关商业利益，并非独立测评。原文称站内视频通常赚取1%至5%的销售额分成，站外Amazon Associates链接依品类提供1%至10%的佣金，款项约在销售当月后60天到账；只有当观众购买视频中展示的具体产品或其变体时，才计入有效销售并触发支付。佣金率可能变动，应以账户内当前费率表为准。","reason","source",{"_9":102,"_103":81,"_83":104,"_105":39,"_106":107,"_108":109},"links",{"_99":100,"_67":101},"publishedAt","2026-10-09T08:32:13.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-09T08:57:34.945Z","timelineAt","category","advertising","tags",[97,98],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[82],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","zeeshan","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","f-3Wi4P3840I",{"_76":77,"_13":78},"reportCount",2,"additionalSourceCount",0,"developmentCount","publicId","f9efc448-df18-47c9-a6f6-919a8c87a76a","亚马逊创作者视频佣金模式与品类费率解析",{"_76":77,"_13":78},"platform","ZonBase",{"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/8aa8bf81ab8440e4.webp","fullUrl","/amznews-reading-preview/_img/8aa8bf81ab8440e4.webp","srcSet","/amznews-reading-preview/_img/8aa8bf81ab8440e4.webp 336w, /amznews-reading-preview/_img/8aa8bf81ab8440e4.webp 720w","width",1