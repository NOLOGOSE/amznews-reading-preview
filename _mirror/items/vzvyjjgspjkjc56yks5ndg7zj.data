[{"_1":2,"_3":4},"root",{"_5":142},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","vzvyjjgspjkjc56yks5ndg7zj","revision",2,"title","Olga Zikova 发起卡皮巴拉插画版权维权冻结31个店铺","originalTitle","TRO资讯｜维权510个店铺的热门萌宠插画又来收割了，卖家速查！","summary","插画艺术家 Olga Zikova 委托律所于2026年10月21日在美国宾夕法尼亚州西区联邦地区法院发起版权维权，锁定31个被告店铺。这是原告9个月内第5次维权，共计541个被告店铺被冻结。涉案作品为5张卡皮巴拉插画，覆盖服装配饰、家居用品等8个热门品类，睿观分析该系列后续仍有极大可能追加维权。","reason","source",{"_9":133,"_134":135,"_92":136,"_137":40,"_138":139,"_140":141},"links",{"_130":131,"_68":132},"publishedAt","2026-10-21T23:42:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-22T09:52:25.983Z","timelineAt","category","policy","tags",[128,129],"score",58,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89,90,91],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","睿观查侵权","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fN7xRCEyXKd8",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","e5a86240-8223-4592-bc00-5d14fa1473d0","Olga Zikova卡皮巴拉插画版权维权再诉31店",{"_77":78,"_13":79},"platform","AMZ123",{"_92":93,"_94":125,"_96":126,"_98":127,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":122,"_96":123,"_98":124,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":119,"_96":120,"_98":121,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":116,"_96":117,"_98":118,"_100":-5,"_101":-5,"_102":-5,"_103":-5},{"_92":93,"_94":113,"_96":114,"_98":115,"_100":-5,"_101":-5,"_102":-5,"_