[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","w6z2jl5z6b1obbank7kk3qtzr","revision",1,"title","亚马逊推出 Seller Central 多渠道销售工具以管理 eBay 等外部渠道","originalTitle","New Amazon Multichannel Selling Tools for eBay, Shopify, TikTok, and Walmart","summary","亚马逊宣布在 Seller Central 推出新的多渠道销售工具，允许卖家连接 eBay、Shopify、TikTok 和 Walmart 账户。该工具旨在统一 Listing 管理、订单处理和盈利分析，支持一次编辑描述并自动适配各渠道格式，以及跨渠道查看实时利润数据。目前该功能正逐步向美国站点卖家免费开放，未来将扩展更多渠道和功能。","reason","原文详述了亚马逊新推出的多渠道销售工具功能，卖家可借此在 Seller Central 统一管理 eBay、Shopify 等外部渠道的 Listing 与订单。","source",{"_9":76,"_77":78,"_79":80,"_81":64,"_82":83,"_84":85},"links",{"_73":74,"_66":75},"publishedAt","2026-09-25T08:25:08.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T09:17:27.482Z","timelineAt","category","policy","tags",[69,70,71,72],"score",64,"selected",true,"channel","news","story","x","media",[],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","Chris Dawson","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","ChannelX","AI/工具","多平台销售","亚马逊","Seller Central","aihot","/items/w6z2jl5z6b1obbank7kk3qtzr","https://channelx.world/2026/09/new-amazon-multichannel-selling-tools-for-ebay-shopify-tiktok-and-walmart/","rss-tamebay-amazon","name","Tamebay · Amazon 卖家新闻","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/87679903b998bbb0.webp","iconSrcSet","/amznews-reading-preview/_img/87679903b998bbb0.webp 48w, /amznews-reading-preview/_img/87679903b998bbb0.webp 96w",{"_87":88},"changelogVersion","2026-10-09T22:08"]
