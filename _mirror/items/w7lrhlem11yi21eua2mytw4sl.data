[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","w7lrhlem11yi21eua2mytw4sl","revision",2,"title","Meta 2026 归因变更导致 ROAS 下降原因分析","originalTitle","Why Your Meta ROAS Dropped: The 2026 Attribution Changes","summary","Meta 于 2026 年 3 月将点击归因收窄至链接点击，其余互动转入新设的“参与归因”，导致 Common Thread Collective 监测的 50 个账户 7 天点击 ROAS 平均下降 13%。此前 1 月 12 日已移除 API 中的长周期浏览窗口。由于计费逻辑未变，卖家需结合总转化与混合收入判断实际销售表现，避免误判为真实业绩下滑。","reason","source",{"_9":95,"_96":97,"_70":98,"_99":39,"_100":101,"_102":103},"links",{"_92":93,"_65":94},"publishedAt","2026-10-02T21:11:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:22.435Z","timelineAt","category","advertising","tags",[89,90,91],"score",36,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/7d886ce1ed115a4a.webp","fullUrl","/amznews-reading-preview/_img/7d886ce1ed115a4a.webp","srcSet","/amznews-reading-preview/_img/7d886ce1ed115a4a.webp 336w, /amznews-reading-preview/_img/7d886ce1ed115a4a.webp 720w","width",1600,"height",935,"alt","poster","/amznews-reading-preview/_img/23bcd9bf44280732.webp","/amznews-reading-preview/_img/23bcd9bf44280732.webp","/amznews-reading-preview/_img/23bcd9bf44280732.webp 336w, /amznews-readin