[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","w9q7wu73p0z63f48w7dsdukk5","revision",4,"title","亚马逊日本站将扩大自配送订单追踪率覆盖范围，买家发起的订单取消流程即将发生变化","originalTitle","今日要闻 |亚马逊日本站将扩大自配送订单追踪率覆盖范围，买家发起的订单取消流程即将发生变化......","summary","亚马逊日本站发布公告称，自2022年8月23日起将扩大日本站自配送卖家的订单追踪率覆盖范围，1000日元及以上的包裹在发货前需要输入订单单号供买家查询。原文未提供公告链接或独立证据，该政策主张无法由原文自证。另据公告，自2022年5月23日起，买家发起的订单取消请求将显示在卖家中心“管理订单”页面横幅中，不再通过买家与卖家消息通知，并可通过List Order Items API查看。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2022-05-23T01:56:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:52:52.374Z","timelineAt","category","policy","tags",[68,69,70],"score",32,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","枫火跨境电商","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123","政策/合规","FBA/物流","亚马逊","aihot","/items/w9q7wu73p0z63f48w7dsdukk5","https://www.amz123.com/t/KmSFlQTU","author-amz123-fenghuo-reviewed","name","AMZ123 · 枫火跨境电商","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview/_img/0083c7bf2225c6c0.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
