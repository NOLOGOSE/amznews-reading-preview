[{"_1":2,"_3":4},"root",{"_5":120},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","wde6g36eie3i7b60trgdrpdi8","revision",2,"title","亚马逊推多渠道工具整合 eBay 等数据，作者质疑卖家共享意愿","originalTitle","Amazon’s new multichannel tools promise to bring eBay, Shopify, TikTok and Walmart into Seller Central, with listings, orders and profita...","summary","亚马逊推出新的多渠道工具，旨在将 eBay、Shopify、TikTok 和 Walmart 的商品详情页、订单及利润数据整合至 Seller Central。作者指出该功能虽提供便利，但质疑卖家是否愿意向亚马逊开放其他销售渠道的数据。","reason","source",{"_9":114,"_115":116,"_95":117,"_118":39,"_119":-5},"links",{"_111":112,"_68":113},"publishedAt","2026-10-20T19:45:38.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-20T20:15:41.290Z","timelineAt","category","policy","tags",[107,108,109,110],"score",58,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","AmazonASGTG","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fokdJuLsUeVo",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","6a1fb84c-7b96-4a91-9d7c-8e14ccd9fae3","亚马逊推多渠道工具整合外部平台数据",{"_77":78,"_13":79},"zh","<p>Amazon’s new multichannel tools promise to bring eBay, Shopify, TikTok and Walmart into Seller Central, with listings, orders and profitability all in one place.</p><p>The convenience sounds appealing. But I wonder how many sellers will want Amazon to see what’s happening across their other channels. Will sellers be comfortable connecting all that data to Amazon?</p><p>Would you use it?</p>","zhKind","complete","authorName","Amazon Sellers ASGTG","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[94],{"_95":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":-5,"_106":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",719,"height",548,"alt","poster","行业动态","多平台销售","亚马逊","Seller Central","aihot","/items/wde6g36eie3i7b60trgdrpdi8","https://x.com/AmazonASGTG/status/2112631346686517537","x-amazon-asgtg","name","X · ASGTG","x_search","firstParty","iconUrl",{"_121":122},"changelogVersion","2026-10-09T22:08"]
