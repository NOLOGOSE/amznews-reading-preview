[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","wfljl4atdqu4o26tjrtcyn3o2","revision",4,"title","亚马逊更新商品捆绑政策，2027年1月11日起多数捆绑包须由品牌方打包","originalTitle","亚马逊捆绑商品将由卖家打包，违规或被下架","summary","亚马逊公告称自2027年1月11日起更新商品捆绑政策，大多数以单个ASIN形式销售的捆绑包必须由原始制造商或品牌方打包，同时取消部分此前的捆绑限制。若卖家自行重新组合包装或混入其他品牌商品，需持有品牌所有者或制造商的授权书，被认定不合规时可上传至Account Health页面。","reason","source",{"_9":89,"_90":91,"_70":92,"_93":39,"_94":95,"_96":97},"links",{"_86":87,"_65":88},"publishedAt","2026-09-11T08:43:30.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:19.083Z","timelineAt","category","policy","tags",[82,83,84,85],"score",75,"selected",false,"channel","news","story","x","media",[69],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Summer","platform","AMZ123",{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/29c44bda73691229.webp","fullUrl","/amznews-reading-preview/_img/29c44bda73691229.webp","srcSet","/amznews-reading-preview/_img/29c44bda73691229.webp 336w, /amznews-reading-preview/_img/29c44bda73691229.webp 720w","width","height","alt","poster","政策/合规","Listing优化","FBA/物流","亚马逊","aihot","/items/wfljl4atdqu4o26tjrtcyn3o2","https://www.amz123.com/t/40mvjjCq","author-amz123-summer","name","AMZ123 · SUMMER","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp 48w, /amznews-reading-preview