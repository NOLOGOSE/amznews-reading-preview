[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","wjvxxai8liqe23m03e8hxx7ia","revision",1,"title","亚马逊扩张美国物流：2029年自有网络将配送88.7%包裹","originalTitle","亚马逊扩张美国物流，29年近88%包裹将由自有网络配送","summary","亚马逊内部规划文件显示，到2029年其自有配送网络将处理美国88.7%的包裹，2027年和2028年分别为86.3%和87.4%，均高于此前83.8%和85%的预测。自有网络承运量预计从2027年约122亿件增至2029年158亿件，同期外部承运商包裹量基本维持在约20亿件。USPS份额预计从2027年约10%降至2029年8%，UPS则从1.8%降至1.4%。","reason","source",{"_9":89,"_90":91,"_70":92,"_93":39,"_94":95,"_96":97},"links",{"_86":87,"_65":88},"publishedAt","2026-09-07T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T19:53:19.333Z","timelineAt","category","fba","tags",[82,83,84,85],"score",47,"selected",false,"channel","news","story","x","media",[69],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Summer","platform","AMZ123",{"_70":71,"_72":73,"_74":75,"_76":77,"_78":-5,"_79":-5,"_80":-5,"_81":-5},"kind","image","url","/amznews-reading-preview/_img/43690a7816630a1c.webp","fullUrl","/amznews-reading-preview/_img/43690a7816630a1c.webp","srcSet","/amznews-reading-preview/_img/43690a7816630a1c.webp 336w, /amznews-reading-preview/_img/43690a7816630a1c.webp 720w","width","height","alt","poster","FBA/物流","供应链","亚马逊","行业动态","aihot","/items/wjvxxai8liqe23m03e8hxx7ia","https://www.amz123.com/t/4fBLLPIc","author-amz123-summer","name","AMZ123 · SUMMER","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","iconSrcSet","/amznews-reading-preview/_img/0083c7bf2225c6c0.w