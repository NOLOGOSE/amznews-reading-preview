[{"_1":2,"_3":4},"root",{"_5":112},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","wk1htz95fqic7d5z1btbtv8mo","revision",2,"title","美国海关拟收紧低价值包裹申报规则：要求提前申报并新增保证金","originalTitle","美国拟调整海关申报规则，提前申报时间并新增保证金","summary","美国海关与边境保护局（CBP）发布拟议规则，计划收紧价值2500美元及以下包裹的申报要求，规定需在进口当天或之前完成电子申报，并强制提供海关保证金。该规则还新增了针对国际邮件的专门申报类型，要求补充寄件人身份及追踪号码等信息。目前该规则处于公众意见征集阶段，截止日期为2026年12月7日。","reason","原文梳理了美国海关拟议新规中关于申报时间提前、新增保证金及具体成本估算等细节，为跨境卖家评估合规风险与调整业务提供了参考。","source",{"_9":103,"_104":105,"_85":106,"_107":67,"_108":109,"_110":111},"links",{"_100":101,"_69":102},"publishedAt","2026-10-21T18:24:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-22T02:32:47.026Z","timelineAt","category","policy","tags",[97,98,99],"score",78,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","跨境物流资讯","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":76,"_77":76},"hasTranslation",false,"bodyLanguage","original","factId","fNHs2FP8slpg",{"_78":79,"_13":80},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","877cec78-4bae-4615-9a66-a6c3f88031fd","美国海关拟收紧低价值包裹申报规则",{"_78":79,"_13":80},"platform","AMZ123",{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/214f9a32b6390e39.webp","fullUrl","/amznews-reading-preview/_img/214f9a32b6390e39.webp","srcSet","/amznews-reading-preview/_img/214f9a32b6390e39.webp 336w, /amznews-reading-preview/_img/214f9a32b6390e39.webp 720w","width","height","alt","poster","政策/合规"