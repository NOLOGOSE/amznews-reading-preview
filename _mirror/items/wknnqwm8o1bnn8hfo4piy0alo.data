[{"_1":2,"_3":4},"root",{"_5":119},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_41":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":39,"_62":63,"_64":65,"_66":39,"_67":68},"id","wknnqwm8o1bnn8hfo4piy0alo","revision",2,"title","亚马逊FBM卖家遭遇运费补扣与标签涨价","originalTitle","For my Amazon FBM Sellers:","summary","亚马逊FBM卖家近期频繁遭遇发货后运费补扣，部分标签费用从24美元涨至50美元。今年通过Seller Central购买的运费标签均加收7%费用，该现象自8月持续至今。卖家可在财务交易页搜索“Chargeback due to under charging postage”核实具体扣款记录。","reason","source",{"_9":113,"_114":115,"_95":116,"_117":39,"_118":-5},"links",{"_110":111,"_68":112},"publishedAt","2026-10-15T20:08:39.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.523Z","timelineAt","category","fba","tags",[107,108,109],"score",50,"selected",false,"channel","x","story",{"_77":78,"_13":79},{"_85":86,"_87":52,"_88":89,"_90":91,"_92":-5,"_45":93},"media",[],"byline","detailedGuide","readingMode","full","author","SaulSellsStuff","language","en","body",{"_81":-5,"_68":82,"_83":-5,"_84":63},"outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_42":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fihdyWJv6Bv0",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","67252c9e-a0fb-4230-b378-20ea58421b62","亚马逊FBM卖家反映运费补扣与标签涨价",{"_77":78,"_13":79},"zh","<p>For my Amazon FBM Sellers:</p><p>In the last 60 days we have seen a massive uptick in Amazon adding shipping charges after shipment.</p><p>Some of these items we have sold before paying $24 a label are now being upcharged to $50 a label.</p><p>Started in August and continues into October.</p><p>All shipping purchased through seller central, is adding 7% to the total label costs this year.</p><p>Opening tickets now, but to check this yourself:</p><p>https://sellercentral.amazon.com/manage/finance/transactions</p><p>Then look for \"Chargeback due to under charging postage label purchased\"</p><p>You can also grab your entire year report and send it to your LLM of choice to see the full damage.</p>","zhKind","complete","authorName","Saul","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[94],{"_95":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":-5,"_106":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1346,"height",341,"alt","poster","FBA/物流","费用变更","亚马逊","aihot","/items/wknnqwm8o1bnn8hfo4piy0alo","https://x.com/SaulSellsStuff/status/2110825201290113079","x-saul-sells-stuff","name","X · Saul","x_search","firstParty","iconUrl",{"_120":121},"changelogVersion","2026-10-09T22:08"]
