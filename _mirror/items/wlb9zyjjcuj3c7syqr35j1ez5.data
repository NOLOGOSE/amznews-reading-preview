[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":-5,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","wlb9zyjjcuj3c7syqr35j1ez5","revision",3,"title","拆解竞品黑五网一广告投放策略的方法与案例","originalTitle","详细拆解竞品的广告投放策略，助力黑五网一大促起飞","summary","原文作者分享通过 SIF 关键词插件和 Keepa 工具，系统性拆解竞品在黑五网一大促期间的广告架构与投放逻辑。该方法聚焦还原 SP、SB 及 SBV 的广告组合、匹配类型及新增活动变量，旨在帮助卖家提取可复制的高效打法以降低试错成本。文中以 ASIN B0D99JVNVK 为例，演示了如何通过对比不同周期的广告搜索词波动来区分精准、词组或自动等匹配方式。","reason","source",{"_9":120,"_121":67,"_77":122,"_123":39,"_124":125,"_126":127},"links",{"_117":118,"_65":119},"publishedAt","2025-10-13T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2025-10-14","discoveredAt","2026-10-01T09:32:55.365Z","timelineAt","category","advertising","tags",[113,114,115,116],"score","selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Vae","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_77":78,"_79":110,"_81":111,"_83":112,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":107,"_81":108,"_83":109,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":104,"_81":105,"_83":106,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":98,"_81":99,"_83":100,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":95,"_81":96,"_83":97,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":92,"_81":93,"_83":94,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5,"_87":-5,"_88":-5},{"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_