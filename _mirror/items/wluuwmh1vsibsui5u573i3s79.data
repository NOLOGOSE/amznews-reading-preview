[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","wluuwmh1vsibsui5u573i3s79","revision",2,"title","日本站换主体需同步变更 PSE 四项内容","originalTitle","日本站换主体，只改后台公司名不够：PSE这4样也要跟着换（附顺序）","summary","日本站卖家更换主体时，除修改亚马逊后台外，还需同步变更 PSE 相关的经产省届出、国内管理人合同、报告检查记录及铭牌平台信息。作者建议按“定新主体→重新届出与签约→处理证书名义→改铭牌→最后改后台”的顺序操作，以避免出现店铺与 PSE 主体不一致的空档期。","reason","source",{"_9":88,"_89":81,"_90":91,"_92":40,"_93":94,"_95":96},"links",{"_85":86,"_68":87},"publishedAt","2026-10-12T01:33:29.723Z","publishedPrecision","calendar","calendarDate","2026-10-12","discoveredAt","2026-10-12T08:34:27.226Z","timelineAt","category","policy","tags",[82,83,84],"score",34,"selected",false,"channel","news","story",{"_77":78,"_13":14},"x","media",[],"byline",{"_53":54,"_80":81},"detailedGuide","readingMode","full","author","Sai日本合规","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fPPFIVXp9fjs",{"_77":78,"_13":14},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","c3f4d766-8063-4e10-82b7-ae7431e93a51",{"_77":78,"_13":14},"platform","知无不言","政策/合规","合规税务","亚马逊","aihot","/items/wluuwmh1vsibsui5u573i3s79","https://www.wearesellers.com/question/125309","author-wearesellers-public-latest","name","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc825.webp 96w",{"_98":99},"changelogVersion","2026-10-09T22:08"]
