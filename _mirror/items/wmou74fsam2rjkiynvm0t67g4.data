[{"_1":2,"_3":4},"root",{"_5":83},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":-5,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","wmou74fsam2rjkiynvm0t67g4","revision",1,"title","亚马逊与美国邮政签署新配送协议，包裹量削减20%","originalTitle","Amazon signs new delivery deal with Postal Service at 20% less volume","summary","亚马逊与美国邮政（USPS）签署新协议，继续由 USPS 提供末端配送服务，但年包裹量降至约10亿件，较此前减少20%。该协议虽为面临财务压力的 USPS 保留收入与网络密度，但需经邮政监管委员会批准；分析师预测亚马逊或于2028年完全退出与 USPS 的合作。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":38,"_79":80,"_81":82},"links",{"_70":71,"_64":72},"publishedAt","2026-04-07T16:14:12.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:17:07.814Z","timelineAt","category","fba","tags",[67,68,69],"score","selected",false,"channel","news","story","x","media",[],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves","FBA/物流","供应链","亚马逊","aihot","/items/wmou74fsam2rjkiynvm0t67g4","https://www.freightwaves.com/news/amazon-signs-new-delivery-deal-with-postal-service-at-20-less-volume","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_84":85},"changelogVersion","2026-10-09T22:08"]
