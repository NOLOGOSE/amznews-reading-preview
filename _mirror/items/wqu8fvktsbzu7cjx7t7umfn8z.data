[{"_1":2,"_3":4},"root",{"_5":123},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","wqu8fvktsbzu7cjx7t7umfn8z","revision",2,"title","亚马逊美国站下发NWD限售邮件，要求卖家在10月27日前核对品牌销售角色","originalTitle","紧急！亚马逊卖家集体收到限售邮件","summary","亚马逊美国站向部分卖家发送通知，称相关商品将于2026年10月27日起被移除，仅拥有对应品牌代表角色的卖家可继续销售。此类限制针对不开放第三方批发分销（NWD）的品牌，即使持有正规发票或线下授权，若账号未绑定正确的Brand Representative或Reseller角色也可能受限。","reason","原文梳理了NWD限售邮件的触发逻辑与自查步骤，帮助卖家区分品牌管理权限与销售角色，明确截止前的库存处理路径。","source",{"_9":114,"_115":116,"_88":117,"_118":67,"_119":120,"_121":122},"links",{"_111":112,"_69":113},"publishedAt","2026-10-22T06:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-23T02:12:30.770Z","timelineAt","category","policy","tags",[109,110],"score",62,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[84,85,86,87],"byline",{"_54":55,"_82":83},"detailedGuide","readingMode","full","author","雪球站外","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":12,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fbAjJrnzgSnM",{"_78":79,"_13":80},"reportCount",5,"additionalSourceCount","developmentCount",0,"publicId","dbf445cd-5ab4-4c48-9b75-67dad0c62a93","亚马逊NWD限售通知引发卖家下架与库存担忧",{"_78":79,"_13":80},"platform","AMZ123",{"_88":89,"_90":106,"_92":107,"_94":108,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":103,"_92":104,"_94":105,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":100,"_92":101,"_94":102,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":91,"_92":93,"_94":95,"_96":-5,"_97":-5,"_98":-5,"_99":-5},"kind","image","url","/amznews-reading-preview/_img/a7ddd1f85d29669c.we