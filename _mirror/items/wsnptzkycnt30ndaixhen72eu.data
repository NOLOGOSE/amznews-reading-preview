[{"_1":2,"_3":4},"root",{"_5":114},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","wsnptzkycnt30ndaixhen72eu","revision",2,"title","香港拟推重点企业5%利得税优惠，跨境卖家需核实资格与业务实质","originalTitle","香港拟推5%税率，跨境卖家能省近百万？","summary","香港政府拟为从事重点产业的个别企业提供5%或半税（8.25%）利得税优惠，该政策尚未生效，具体适用条件及利润范围须以年底提交的修订条例草案及后续立法审批结果为准。原文测算显示，若1000万港元应评税利润全部获批适用5%，较现行两级制可省98.5万港元，但作者强调此仅为假设，实际节税取决于企业是否具备真实总部活动、人员开支及对港经济实质贡献，且“半税”与“5%”为两档不同税率，不可混淆。","reason","source",{"_9":105,"_106":107,"_85":108,"_109":40,"_110":111,"_112":113},"links",{"_102":103,"_68":104},"publishedAt","2026-10-19T04:20:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-20T01:59:39.285Z","timelineAt","category","policy","tags",[100,101],"score",40,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","Ken叔税服你","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f2yaJIG_1hVU",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","998d18bd-dcec-4162-8b7e-f4be39837eb6","香港拟推5%利得税优惠 跨境卖家关注资格",{"_77":78,"_13":79},"platform","AMZ123",{"_85":86,"_87":97,"_89":98,"_91":99,"_93":-5,"_94":-5,"_95":-5,"_96":-5},{"_85":86,"_87":88,"_89":90,"_91":92,"_93":-5,"_94":-5,"_95":-5,"_96":-5},"kind","image","url","/amznews-reading-preview/_img/34f7945ed62f97fc.webp","fullUrl","/amznews-reading-preview/_img/34f7945ed62f97fc.webp","srcSet","/amznews-reading-preview/_img/34f7945ed62f97fc.webp 336w, /amznews-reading-preview/_img/34f79