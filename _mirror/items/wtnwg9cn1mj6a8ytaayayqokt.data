[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","wtnwg9cn1mj6a8ytaayayqokt","revision",2,"title","SCFI连续两周上涨至3679.58点，欧线涨美线跌","originalTitle","SCFI连续两周上涨，美线现货运价小幅回落","summary","上海出口集装箱运价指数（SCFI）报3679.58点，周涨幅0.42%，实现连续两周走高。分航线看，地中海航线涨幅最高达8.3%，而美西、美东现货运价分别下跌0.8%和1.1%。业内分析指出，欧线上涨源于船公司推进涨价计划，但受需求疲软及运力增加影响，后续行情仍持谨慎态度；美线因积压货物未清及港口拥堵，预计维持高位震荡。","reason","source",{"_9":101,"_102":103,"_84":104,"_105":40,"_106":107,"_108":109},"links",{"_98":99,"_68":100},"publishedAt","2026-10-19T18:17:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-20","discoveredAt","2026-10-20T03:00:39.268Z","timelineAt","category","fba","tags",[96,97],"score",42,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跨境物流资讯","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fmTQGHGVhPOk",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","ff0a736a-b18d-48b8-88e8-e6605800ea4c","SCFI两连涨至3679.58点 欧地涨美线回落",{"_77":78,"_13":79},"platform","AMZ123",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/9192850dd25e407c.webp","fullUrl","/amznews-reading-preview/_img/9192850dd25e407c.webp","srcSet","/amznews-reading-preview/_img/9192850dd25e407c.webp 336w, /amznews-reading-preview/_img/9192850dd25e407c.webp 720w","width","height","alt","poster","FBA/物流","供应链","aihot","/items/wtnwg9cn1mj6a8ytaayayqokt","ht