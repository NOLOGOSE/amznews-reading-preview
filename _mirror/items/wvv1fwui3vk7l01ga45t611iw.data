[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","wvv1fwui3vk7l01ga45t611iw","revision",1,"title","亚马逊德国站收紧建议零售价（RRP）验证规则","originalTitle","Update your recommended retail prices on Amazon","summary","亚马逊宣布自2026年9月9日起收紧德国站建议零售价（RRP）的验证标准，要求站内历史售价必须在价格历史图表中显示为Featured Offer且持续一定天数方可通过验证。不符合新标准的RRP将被抑制，导致商品详情页不再显示该参考价格。此次调整旨在使显示的折扣信息与Rufus价格历史图表保持一致，此前英国站已于6月23日实施类似规则，其他欧盟站点将陆续跟进。","reason","原文详细说明了RRP验证新规中“有意义天数”的具体判定逻辑及90天回溯期，卖家可据此自查现有参考价是否面临隐藏风险。","source",{"_9":74,"_75":76,"_77":78,"_79":64,"_80":81,"_82":83},"links",{"_71":72,"_66":73},"publishedAt","2026-09-09T18:59:42.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T09:17:27.535Z","timelineAt","category","policy","tags",[69,70],"score",62,"selected",true,"channel","news","story","x","media",[],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","Chris Dawson","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","ChannelX","政策/合规","亚马逊","aihot","/items/wvv1fwui3vk7l01ga45t611iw","https://channelx.world/2026/09/update-your-recommended-retail-prices-on-amazon/","rss-tamebay-amazon","name","Tamebay · Amazon 卖家新闻","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/87679903b998bbb0.webp","iconSrcSet","/amznews-reading-preview/_img/87679903b998bbb0.webp 48w, /amznews-reading-preview/_img/87679903b998bbb0.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
