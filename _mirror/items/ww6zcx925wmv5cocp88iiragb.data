[{"_1":2,"_3":4},"root",{"_5":121},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ww6zcx925wmv5cocp88iiragb","revision",5,"title","亚马逊 1P 与 3P 对比：各自优势及为何要从 1P 转向 3P","originalTitle","Amazon 1P vs 3P: Benefits of Each and Why to Move From 1P to 3P","summary","亚马逊 1P 通过 Vendor Central 以批发价卖给亚马逊，需获邀请才能加入；原文称亚马逊批发采购价通常较零售价低 20%–30%，品牌失去定价、Listing 和物流控制权，且亚马逊通常收取 4%–10% 营销费、2% 运费补贴（freight allowance）等费用。3P 则通过 Seller Central 直接面向消费者，品牌掌握定价、库存和利润，可选择 FBA、FBM 或 Seller Fulfilled Prime 履约，但需自行搭建相应基础设施。","reason","source",{"_9":112,"_113":114,"_73":115,"_116":61,"_117":118,"_119":120},"links",{"_109":110,"_65":111},"publishedAt","2024-05-16T14:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T17:00:18.726Z","timelineAt","category","advertising","tags",[105,106,107,108],"score",31,"selected",false,"channel","news","story","x","media",[68,69,70,71,72],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Rachel Andrea Go","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","MyFBAPrep",{"_73":74,"_75":100,"_77":101,"_79":102,"_81":103,"_83":104,"_85":-5,"_86":-5},{"_73":74,"_75":97,"_77":98,"_79":99,"_81":90,"_83":91,"_85":-5,"_86":-5},{"_73":74,"_75":92,"_77":93,"_79":94,"_81":95,"_83":96,"_85":-5,"_86":-5},{"_73":74,"_75":87,"_77":88,"_79":89,"_81":90,"_83":91,"_85":-5,"_86":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":84,"_85":-5,"_86":-5},"kind","image","url","/amznews-reading-preview/_img/aac7d5b9775bc538.webp","fullUrl","/amznews-reading-preview/_img/aac7d5b9775bc538.webp","srcSet","/amznews-reading-prev