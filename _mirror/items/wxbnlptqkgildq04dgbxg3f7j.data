[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","wxbnlptqkgildq04dgbxg3f7j","revision",2,"title","亚马逊周报：11月起扩大责任险强制范围并收紧第三方授权","originalTitle","Amazon Just Made Liability Insurance Mandatory for More Sellers — Starting November 2","summary","亚马逊将于2026年11月2日扩大商业综合责任险（CGL）强制要求，覆盖汽车座椅等11个“增强安全”类别且不再设销售额门槛。同时，亚马逊已收紧 Seller Central 账户授权机制，取消旧邀请流程，新授权有效期限制为365天。此外，数据显示美国电商 Q2 同比增长12.2%，亚马逊在中国启用第三个全球仓储配送中心以降低存储费率。","reason","source",{"_9":104,"_105":106,"_71":107,"_108":39,"_109":110,"_111":112},"links",{"_101":102,"_65":103},"publishedAt","2026-09-10T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T07:15:56.714Z","timelineAt","category","policy","tags",[98,99,100],"score",62,"selected",false,"channel","news","story","x","media",[67,68,69,70],"byline",{"_51":-5,"_66":52},"detailedGuide","readingMode","full","author","SellerBites","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform",{"_71":72,"_73":93,"_75":94,"_77":95,"_79":96,"_81":97,"_83":-5,"_84":-5},{"_71":72,"_73":90,"_75":91,"_77":92,"_79":88,"_81":89,"_83":-5,"_84":-5},{"_71":72,"_73":85,"_75":86,"_77":87,"_79":88,"_81":89,"_83":-5,"_84":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":82,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/fdcfc292c1e612af.webp","fullUrl","/amznews-reading-preview/_img/fdcfc292c1e612af.webp","srcSet","/amznews-reading-preview/_img/fdcfc292c1e612af.webp 336w, /amznews-reading-preview/_img/fdcfc292c1e612af.webp 720w","width",1024,"height",415,"alt","poster","/amznews-reading-preview/_im