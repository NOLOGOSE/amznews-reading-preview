[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","x26f63uov7br2fp60vfzgk518","revision",1,"title","亚马逊全目录统一目标ACOS不合理","originalTitle","Using the same target ACOS across an entire Amazon catalog makes almost no sense.","summary","在整个亚马逊产品目录中使用相同的目标 ACOS 几乎毫无意义。\n\n不同产品的利润率不同。\n转化率不同。\n评论数量不同。\n复购行为不同。\n自然排名不同。\n生命周期阶段不同。\n\n为什么它们都该拥有完全相同的广告目标？\n\n我宁愿为设定目标找到理由，也不愿为了仪表盘看起来整洁，而强行让每个 SKU 都趋向 25%。","reason","source",{"_9":85,"_86":87,"_88":89,"_90":39,"_91":-5},"links",{"_82":83,"_66":84},"publishedAt","2026-10-14T18:15:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.573Z","timelineAt","category","advertising","tags",[80,81],"score",22,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Evan_Swanson_","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>Using the same target ACOS across an entire Amazon catalog makes almost no sense.</p><p>Different products have different margins.<br>Different conversion rates.<br>Different review counts.<br>Different repeat purchase behavior.<br>Different organic rank.<br>Different lifecycle stages.</p><p>Why would they all deserve the exact same ad target?</p><p>I’d rather have a reason for the target than a clean-looking dashboard where every SKU is forced toward 25%.</p>","zhKind","complete","authorName","Evan Swanson","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"广告/运营","广告投放","aihot","/items/x26f63uov7br2fp60vfzgk518","https://x.com/Evan_Swanson_/status/2110434211362705441","x-evan-swanson","name","X · Evan Swanson","kind","x_search","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
