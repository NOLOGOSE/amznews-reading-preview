[{"_1":2,"_3":4},"root",{"_5":94},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","x4iithlvwluk7tv27q1ecveq0","revision",3,"title","亚马逊卖家实测全渠道广告：高售价少素材产品C拿下64%销售额","originalTitle","讨论一下新出的全渠道广告：为什么在售价是AB两倍多、素材又最少的情况下，C产品反而能拿下64%的销售额，是不是全渠道广告把素材投到了站外更匹配高价值产品的人群？","summary","亚马逊卖家实测发现，在全渠道广告中，售价是其他产品两倍多且素材最少的C产品反而获得64%的销售额占比。该卖家推测亚马逊可能将此类素材投放至站外更匹配高价值产品的受众，引发对全渠道广告投放逻辑的讨论。","reason","source",{"_9":86,"_87":67,"_69":88,"_89":39,"_90":91,"_92":93},"links",{"_83":84,"_65":85},"publishedAt","2026-09-19T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T12:46:21.785Z","timelineAt","category","advertising","tags",[81,82],"score",26,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Merman","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/2db1ada9ab78ab6d.webp","fullUrl","/amznews-reading-preview/_img/2db1ada9ab78ab6d.webp","srcSet","/amznews-reading-preview/_img/2db1ada9ab78ab6d.webp 336w, /amznews-reading-preview/_img/2db1ada9ab78ab6d.webp 720w","width","height","alt","poster","广告/运营","广告投放","aihot","/items/x4iithlvwluk7tv27q1ecveq0","https://www.wearesellers.com/question/124782","author-wearesellers-public-latest","name","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","iconSrcSet","/amznews-reading-preview/_img/cd76ad478f9fc825.webp 48w, /amznews-reading-preview/_img/cd76ad478f9fc