[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","xc44vszopttoitq7ces4bc84v","revision",1,"title","美国贸易代表办公室宣布继续执行针对中国技术转让等行为的301关税措施","originalTitle","Continuation of Actions: China's Acts, Policies, and Practices Related to Technology Transfer, Intellectual Property, and Innovation","summary","美国贸易代表办公室（USTR）宣布，基于国内行业代表的延续请求，2018年7月6日和8月23日实施的针对中国技术转让、知识产权及创新相关行为的行动未于2026年到期终止，将继续生效。该决定源于对两项行动法定四年审查程序的第一步通知，后续可能根据审查结果进行进一步修改。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":61,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-10-07T04:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:13:46.627Z","timelineAt","category","policy","tags",[69,70],"score",22,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Trade Representative, Office of United States","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Trade Representative 等","platform","美国贸易代表办公室 USTR","政策/合规","亚马逊","aihot","/items/xc44vszopttoitq7ces4bc84v","https://www.federalregister.gov/documents/2026/10/07/2026-20510/continuation-of-actions-chinas-acts-policies-and-practices-related-to-technology-transfer","official-ustr-federal-register","name","美国贸易代表办公室 USTR · 联邦公报","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/fb25db0934701e45.webp","iconSrcSet","/amznews-reading-preview/_img/fb25db0934701e45.webp 48w, /amznews-reading-preview/_img/fb25db0934701e45.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
