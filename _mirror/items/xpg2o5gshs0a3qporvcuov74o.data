[{"_1":2,"_3":4},"root",{"_5":131},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","xpg2o5gshs0a3qporvcuov74o","revision",2,"title","章鱼水球洗澡玩具与美国发明专利的初步侵权比对","originalTitle","有相关美国发明专利，但是没把握确认是否侵权？记“水球洗澡玩具”选品","summary","原文作者对一款章鱼水球洗澡玩具与一项美国发明专利的权利要求1进行初步侵权比对，认为该产品外壳缺少“从壳体一体突出的多个凸起”这一技术特征，据此初步判定该产品未落入权利要求1的保护范围、相关侵权风险较低。原文比对分析中另称该产品壳体“腔体部分和密封部分”的组合结构与权利要求1对应技术特征相同，两处分析并存，结论仅为作者初步判断，不构成确定的法律意见。","reason","source",{"_9":122,"_123":124,"_89":125,"_126":40,"_127":128,"_129":130},"links",{"_119":120,"_68":121},"publishedAt","2026-10-20T06:40:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-20","discoveredAt","2026-10-21T02:23:13.077Z","timelineAt","category","product","tags",[116,117,118],"score",38,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","案说跨境知识产权","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f2qTZve5iRdg",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","53be03f9-30dc-46f7-89d2-98ac93b16c92","章鱼水球洗澡玩具与美国专利侵权初步比对",{"_77":78,"_13":79},"platform","AMZ123",{"_89":90,"_91":113,"_93":114,"_95":115,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":110,"_93":111,"_95":112,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":107,"_93":108,"_95":109,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":104,"_93":105,"_95":106,"_97":-5,"_98":-5,"_99":-5,"_100":-5},{"_89":90,"_91":101,"_93":102,"_95":103,"_97":-5,"_98":-5,"_99":-5,"_100":