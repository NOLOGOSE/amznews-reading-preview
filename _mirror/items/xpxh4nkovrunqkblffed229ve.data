[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","xpxh4nkovrunqkblffed229ve","revision",2,"title","2026年亚马逊品牌入驻 Walmart Marketplace 是否值得？","originalTitle","Walmart Marketplace in 2026: Is It Worth It for an Amazon Brand?","summary","对于拥有干净目录数据和闲置库存的成熟亚马逊品牌，Walmart Marketplace 在 2026 年通常值得作为测试渠道。其无月费且佣金为 3%-20%，新卖家计划提供最高 $75K 优惠，但广告额度仅 $500。建议按 SKU 建模并预留独立广告预算，而非直接复制亚马逊销量。","reason","source",{"_9":96,"_97":98,"_70":99,"_100":39,"_101":102,"_103":104},"links",{"_93":94,"_65":95},"publishedAt","2026-10-02T21:21:50.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:22.435Z","timelineAt","category","policy","tags",[89,90,91,92],"score",32,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/cd90194c5dd4b8e6.webp","fullUrl","/amznews-reading-preview/_img/cd90194c5dd4b8e6.webp","srcSet","/amznews-reading-preview/_img/cd90194c5dd4b8e6.webp 336w, /amznews-reading-preview/_img/cd90194c5dd4b8e6.webp 720w","width",1600,"height",1088,"alt","poster","/amznews-reading-preview/_img/353de3e20b3799c3.webp","/amznews-reading-preview/_img/353de3e20b3799c3.webp","/amznews-reading-preview/_img/353de3e20b3799c3.webp 336w, /amznews-reading-preview/_img/353