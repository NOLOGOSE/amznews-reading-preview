[{"_1":2,"_3":4},"root",{"_5":140},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","xsvwtc3whiucm71g019l0efvo","revision",1,"title","Data Dive 推出 MCP 连接 Claude 和 ChatGPT","originalTitle","How to Connect Your Amazon Data to Claude and ChatGPT with the Data Dive MCP","summary","原文来自 Data Dive 官方渠道，推广其自有 MCP 功能，存在相关商业利益，并非独立测评。该功能面向 Standard 和 Enterprise 计划用户，可将账户研究数据接入 Claude、ChatGPT 等支持自定义 MCP 连接器的 AI 工具。原文称设置约需一分钟，AI 在执行操作前会请求确认；写入权限为可选，需用户单独授予。原文还提到 ChatGPT 端存在限制：完整 MCP 支持（含写入工具）在 Business、Enterprise 和 Edu 计划上处于测试阶段，Pro 用户可在开发者模式下连接但仅限读取工具，自定义 MCP 应用不支持移动端，且仅管理员或所有者可开启开发者模式或发布应用。","reason","source",{"_9":131,"_132":133,"_77":134,"_135":39,"_136":137,"_138":139},"links",{"_128":129,"_65":130},"publishedAt","2026-09-28T11:44:05.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-11T16:17:09.224Z","timelineAt","category","ai-tools","tags",[125,126,127],"score",30,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","newsletter","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Data Dive",{"_77":78,"_79":121,"_81":122,"_83":123,"_85":109,"_87":124,"_89":-5,"_90":-5},{"_77":78,"_79":117,"_81":118,"_83":119,"_85":109,"_87":120,"_89":-5,"_90":-5},{"_77":78,"_79":114,"_81":115,"_83":116,"_85":94,"_87":95,"_89":-5,"_90":-5},{"_77":78,"_79":111,"_81":112,"_83":113,"_85":86,"_87":88,"_89":-5,"_90":-5},{"_77":78,"_79":106,"_81":107,"_83":108,"_85":109,"_87":110,"_89":-5,"_90":-5},{"_77":78,"_79":101,"_81":102,"_83":103,"_85":104,"_87":105,"_89":-5