[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":41,"_62":41,"_63":-5,"_64":65,"_66":67},"id","xtbakk5vl602pltqv55uzmkf5","revision",1,"title","亚马逊对NWD品牌实施销售限制，卖家需在10月27日前处理库存或获取授权","originalTitle","链接下架警告！10月27日前不处理将被强制移除","summary","亚马逊向部分卖家发出通知，因涉及NWD（无批发分销）品牌且未获授权，相关商品将于2026年10月27日被强制移除。文章指出，若卖家无法获得品牌方在后台添加的“授权转销商”角色，必须在截止日前成功提交FBA库存移除订单，否则库存将被直接处置且费用由卖家承担。自2026年5月1日起，移除费用已改为按单件直接扣取，精铺卖家需提前核算多SKU同时触发限制的成本。","reason","原文梳理了NWD品牌限制的背景与应对路径，明确了10月27日提交移除订单的关键节点及费用风险。","source",{"_9":98,"_99":100,"_73":101,"_102":65,"_103":104,"_105":106},"links",{"_95":96,"_67":97},"publishedAt","2026-10-17T01:30:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-17","discoveredAt","2026-10-19T02:19:35.469Z","timelineAt","category","policy","tags",[91,92,93,94],"score",75,"selected",true,"channel","news","story","x","media",[70,71,72],"byline",{"_53":54,"_68":69},"detailedGuide","readingMode","full","author","跨境电商优匠学堂","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","AMZ123",{"_73":74,"_75":88,"_77":89,"_79":90,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":85,"_77":86,"_79":87,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/9811b021bf7635a5.webp","fullUrl","/amznews-reading-preview/_img/9811b021bf7635a5.webp","srcSet","/amznews-reading-preview/_img/9811b021bf7635a5.webp 336w, /amznews-reading-preview/_img/9811b021bf7635a5.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/4e0e5c0a435ca42b.webp","/amznews-reading-preview/_img/4e0e5c