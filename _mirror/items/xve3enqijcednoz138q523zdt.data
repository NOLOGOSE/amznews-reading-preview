[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","xve3enqijcednoz138q523zdt","revision",1,"title","亚马逊推出全球仓储与分销服务，支持单次入仓覆盖八国","originalTitle","Amazon offers one inbound shipment to reach eight countries","summary","亚马逊宣布推出 Global Warehousing and Distribution (GWD) 服务，允许卖家将一批货物发送至靠近工厂的单一仓库，即可触达美国、英国、日本等八个国家的客户。公司称该服务连接后，存储成本比美国 AWD 低最多 45%，补货至 FBA 的速度快最多五天。此外，亚马逊还推出了针对玩具品类的合规测试简化方案，试点卖家报告合规成本节省最高可达 60%。","reason","原文介绍了亚马逊新推出的全球仓储与分销服务，卖家可单次入仓覆盖八国并降低存储成本。","source",{"_9":75,"_76":77,"_78":79,"_80":64,"_81":82,"_83":84},"links",{"_72":73,"_66":74},"publishedAt","2026-09-27T14:28:24.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:42.278Z","timelineAt","category","fba","tags",[69,70,71],"score",71,"selected",true,"channel","news","story","x","media",[],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","Thomas Wasson","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","FreightWaves","AI/工具","FBA/物流","亚马逊","aihot","/items/xve3enqijcednoz138q523zdt","https://www.freightwaves.com/news/amazon-global-warehousing-distribution-eight-countries","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_86":87},"changelogVersion","2026-10-09T22:08"]
