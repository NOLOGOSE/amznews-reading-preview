[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","xvs0fc70roi610zfmfwonh7p0","revision",2,"title","亚马逊品牌分析 Search Query Performance 报告：通过对比类目转化率判断是否具备扩量权限","originalTitle","Amazon Conversion Rate vs Category: How to Tell If You Have Permission to Scale","summary","利用 Brand Analytics 中的 Search Query Performance 报告，将品牌 CTR/CVR 与类目均值对比以决定广告扩量策略。若品牌转化优于类目且点击率高，可购买更多曝光；反之需先优化 Listing 或主图。该功能仅面向 Brand Registry 卖家，支持北美、欧洲及远东站点，需汇总数据计算而非直接平均各行比率。","reason","source",{"_9":88,"_89":90,"_69":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_65":87},"publishedAt","2026-09-03T13:45:52.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T11:38:35.262Z","timelineAt","category","advertising","tags",[81,82,83,84],"score",39,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","George Meressa","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","ClearAds Agency",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":-5,"_78":-5,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/472583ad180d4740.webp","fullUrl","/amznews-reading-preview/_img/472583ad180d4740.webp","srcSet","/amznews-reading-preview/_img/472583ad180d4740.webp 336w, /amznews-reading-preview/_img/472583ad180d4740.webp 720w","width","height","alt","poster","广告/运营","Listing优化","关键词","亚马逊","aihot","/items/xvs0fc70roi610zfmfwonh7p0","https://clearadsagency.com/amazon-conversion-rate-vs-category/","publisher-clearads-agency-written-rolling","name","ClearAds Agency 亚马逊广告文章","web_l