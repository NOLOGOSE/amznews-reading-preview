[{"_1":2,"_3":4},"root",{"_5":110},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","xwlugzihv1y5zukf6kmjcy1j0","revision",2,"title","亚马逊美国站电剪刀TIC审核：作者称执行UL62841-1+UL62841-2-8","originalTitle","亚马逊电剪刀 TIC 审核｜UL62841-1+UL62841-2-8","summary","原文作者（检测认证从业者）称，亚马逊美国站手持式电剪刀TIC审核执行UL62841-1+UL62841-2-8标准，旧UL60745报告不再被认可；该说法为作者个人陈述，本站尚未独立核验。作者列出的资料要点包括：ISO17025实验室出具、12个月内、含北美差异项，EN/IEC报告不可直接使用；Listing、报告、铭牌的品牌、型号、额定参数需三方一致，铭牌英文警示完整；锂电款需电池UL62133、UN38.3+BTS及充电器对应UL标准。作者还列出常见驳回原因与审核流程，并建议上架前提前核对资料。原文来自该检测认证机构，存在相关商业利益，并非独立测评。","reason","source",{"_9":102,"_103":82,"_84":104,"_105":40,"_106":107,"_108":109},"links",{"_99":100,"_68":101},"publishedAt","2026-10-13T01:27:28.953Z","publishedPrecision","calendar","calendarDate","2026-10-13","discoveredAt","2026-10-13T09:46:30.192Z","timelineAt","category","policy","tags",[96,97,98],"score",62,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","检测认证小蔡","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","frKXD-nFdjFY",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","ad77a074-0588-4421-9ab3-0da65d78f83c","亚马逊北美站电动切割工具TIC合规审核",{"_77":78,"_13":79},"platform","知无不言",{"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/1a683dc35f25b9f5.webp","fullUrl","/amznews-reading-preview/_img/1a683dc35f25b9f5.webp","srcSet","/amznews-reading-preview/_img/1a683dc35f25b9f5.webp 336w, /amz