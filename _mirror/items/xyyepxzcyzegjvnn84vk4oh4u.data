[{"_1":2,"_3":4},"root",{"_5":138},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","xyyepxzcyzegjvnn84vk4oh4u","revision",3,"title","如何对亚马逊主图进行拆分测试（A/B 测试）","originalTitle","How to Split Test Your Amazon Image","summary","亚马逊主图拆分测试需按时间轮换版本：先上 A 图一段时间（如一周），再换成 B 图同样时长，对比 CTR、session rate 和销量。测试工具分两类，Splitly、Cashcowpro、Listing Dojo 可在亚马逊站内自动轮换图片，但站内测试要求每天至少有若干销量，且测试可能持续数天到数周，表现差的图片上线期间有损失销量和搜索排名的风险。","reason","source",{"_9":129,"_130":131,"_78":132,"_133":39,"_134":135,"_136":137},"links",{"_126":127,"_65":128},"publishedAt","2020-03-19T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:22:02.618Z","timelineAt","category","advertising","tags",[122,123,124,125],"score",42,"selected",false,"channel","news","story","x","media",[69,70,71,72,73,74,75,76,77],"byline",{"_51":66,"_67":68},"detailedGuide","readingMode","full","author","Helium 10 Team","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","Anthony Lee","platform","Helium 10",{"_78":79,"_80":118,"_82":119,"_84":120,"_86":89,"_88":121,"_90":-5,"_91":-5},{"_78":79,"_80":114,"_82":115,"_84":116,"_86":89,"_88":117,"_90":-5,"_91":-5},{"_78":79,"_80":111,"_82":112,"_84":113,"_86":87,"_88":89,"_90":-5,"_91":-5},{"_78":79,"_80":108,"_82":109,"_84":110,"_86":87,"_88":89,"_90":-5,"_91":-5},{"_78":79,"_80":104,"_82":105,"_84":106,"_86":89,"_88":107,"_90":-5,"_91":-5},{"_78":79,"_80":100,"_82":101,"_84":102,"_86":89,"_88":103,"_90":-5,"_91":-5},{"_78":79,"_80":96,"_82":97,"_84":98,"_86":89,"_88":99,"_90":-5,"_91":-5},{"_78":79,"_80":92,"_82":93,"_84":94,"_86":89,"_88":95,"_90":-5,"_91":-5},{"_78":