[{"_1":2,"_3":4},"root",{"_5":105},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","y0iyp6qwjyehc20vnaqe9p8uu","revision",2,"title","Rothy’s、Caraway 与 Hanna Andersson 的 DTC 品牌差异化做法","originalTitle","What Durable DTC Brands Do Differently: Rothy’s, Caraway, Hanna","summary","原文以 Rothy’s、Caraway 和 Hanna Andersson 为例，讨论 DTC 品牌把自有网站视为多渠道之一、按自身条件加入亚马逊与零售渠道，并收紧产品与宣称的做法。Rothy’s 于 2024 年 5 月上线 Amazon Fashion；Hanna Andersson 据 Modern Retail 2026 年 9 月 29 日报道，以 90% 独家商品入驻亚马逊，以减少与官网的重叠，该文全文本站尚未独立核验。原文来自该机构，存在相关商业利益，并非独立测评。","reason","source",{"_9":96,"_97":98,"_70":99,"_100":39,"_101":102,"_103":104},"links",{"_93":94,"_65":95},"publishedAt","2026-10-03T12:04:18.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T06:34:20.412Z","timelineAt","category","advertising","tags",[89,90,91,92],"score",33,"selected",false,"channel","news","story","x","media",[68,69],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mohammad Jalil (MJ)","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SellerElevate",{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/34dfa19c89cddf2b.webp","fullUrl","/amznews-reading-preview/_img/34dfa19c89cddf2b.webp","srcSet","/amznews-reading-preview/_img/34dfa19c89cddf2b.webp 336w, /amznews-reading-preview/_img/34dfa19c89cddf2b.webp 720w","width",1600,"height",905,"alt","poster","/amznews-reading-preview/_img/ece75bf1cf17c745.webp","/amznews-reading-preview/_img/ec