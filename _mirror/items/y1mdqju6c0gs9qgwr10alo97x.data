[{"_1":2,"_3":4},"root",{"_5":126},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","y1mdqju6c0gs9qgwr10alo97x","revision",2,"title","作者称亚马逊扫号转向直接协议三审核：主号被冻、小号未受影响","originalTitle","一夜之间主号全冻！小号没事？亚马逊这次改了\"抓人逻辑\"","summary","本文为作者“跟着阿杜学跨境电商”对近期亚马逊账号冻结现象的个人观察与解释，并非亚马逊官方规则说明。作者称，部分卖家因通过小号跟卖等方式进行刷单等违规操作，主账号被冻结并收到协议三审核邮件，而执行操作的小号未触发审核；作者将此解释为亚马逊按违规行为的受益账号判断处理对象。作者还称，此次直接进入协议三审核，未像过去那样先发警告、允许卖家写POA申诉整改。上述机制变化与处理方式均为作者个人描述，本站尚未独立核验，不构成对亚马逊政策或申诉权利的确定说明。","reason","source",{"_9":117,"_118":119,"_88":120,"_121":40,"_122":123,"_124":125},"links",{"_114":115,"_68":116},"publishedAt","2026-10-19T22:32:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-20","discoveredAt","2026-10-21T02:34:11.417Z","timelineAt","category","policy","tags",[112,113],"score",58,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","跟着阿杜学跨境电商","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","f4BbJn9HI9Xw",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","0b3c238e-a348-4152-ab30-2c5d25457ecd","作者称亚马逊扫号转向直接协议三审核",{"_77":78,"_13":79},"platform","AMZ123",{"_88":89,"_90":109,"_92":110,"_94":111,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":106,"_92":107,"_94":108,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":103,"_92":104,"_94":105,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":100,"_92":101,"_94":102,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":91,"_92":93,"_94":