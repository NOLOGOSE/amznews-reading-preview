[{"_1":2,"_3":4},"root",{"_5":122},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":40,"_62":-5,"_63":64,"_65":66},"id","y98e1fdfgn4yv1brirfigyskl","revision",6,"title","亚马逊升级 Seller Assistant 并推出连接 Amazon Quick 和 Claude 的新插件","originalTitle","Amazon gives sellers a smarter Seller Assistant and a new plugin for Amazon Quick","summary","亚马逊宣布升级 Seller Assistant 并推出新的销售合作伙伴插件。Seller Assistant 新增了持久化记忆功能，可记录卖家的定价模式和库存周期，并引入能全天候自动执行补货、调价等任务的自定义工作流。","reason","原文介绍了 Seller Assistant 新增的持续记忆与自动化工作流，以及连接外部 AI 工具的插件，展示了平台将智能体能力向第三方生态延伸的路径。","source",{"_9":116,"_117":118,"_76":119,"_120":40,"_121":-5},"links",{"_113":114,"_66":115},"publishedAt","2026-09-23T13:00:08.829Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-29T19:32:29.595Z","timelineAt","category","ai-tools","tags",[110,111,112],"score",66,"selected",true,"channel","news","story","x","media",[69,70,71,72,73,74,75],"byline",{"_52":53,"_67":68},"detailedGuide","readingMode","full","author","Mary Beth Westmoreland","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","About Amazon",{"_76":77,"_78":107,"_80":108,"_82":109,"_84":85,"_86":87,"_88":-5,"_89":-5},{"_76":77,"_78":104,"_80":105,"_82":106,"_84":96,"_86":97,"_88":-5,"_89":-5},{"_76":77,"_78":101,"_80":102,"_82":103,"_84":85,"_86":87,"_88":-5,"_89":-5},{"_76":77,"_78":98,"_80":99,"_82":100,"_84":96,"_86":97,"_88":-5,"_89":-5},{"_76":77,"_78":93,"_80":94,"_82":95,"_84":96,"_86":97,"_88":-5,"_89":-5},{"_76":77,"_78":90,"_80":91,"_82":92,"_84":85,"_86":87,"_88":-5,"_89":-5},{"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":-5,"_89":-5},"kind","image","url","/amznews