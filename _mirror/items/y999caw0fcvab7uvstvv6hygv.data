[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","y999caw0fcvab7uvstvv6hygv","revision",2,"title","澄海玩具占全球塑料玩具供应近三分之一，出海需应对合规与物流挑战","originalTitle","占据全球三分之一，这座广东小城凭什么让世界买单？","summary","汕头澄海以不足400平方公里面积贡献全球约三分之一塑料玩具产量，2024年出口额达102.4亿元。文章指出，TikTok美区热销的澄海双刃剑玩具虽出厂价仅二三十元，但溢价主要源于欧美严格的CPC、FCC等合规认证及带电产品物流成本。一八供应链介绍其针对普货、带电带磁货物的专线服务及英欧美自营卡车派送能力，原文带有商业推广性质。","reason","source",{"_9":119,"_120":121,"_88":122,"_123":40,"_124":125,"_126":127},"links",{"_116":117,"_68":118},"publishedAt","2026-10-19T02:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-19","discoveredAt","2026-10-20T01:59:39.314Z","timelineAt","category","product","tags",[112,113,114,115],"score",30,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","一八供应链跨境物流","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fPFpNc_8HFJs",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","ebe9ac10-d34e-4f08-89a3-7686da6b5d87","澄海玩具占全球供应近三分之一，出海面临合规物流挑战",{"_77":78,"_13":79},"platform","AMZ123",{"_88":89,"_90":109,"_92":110,"_94":111,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":106,"_92":107,"_94":108,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":103,"_92":104,"_94":105,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":100,"_92":101,"_94":102,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":91,"_92":93,"_94":95,"_96":-5,"_97":-5,"_98":-5,"_99":-5},"kind",