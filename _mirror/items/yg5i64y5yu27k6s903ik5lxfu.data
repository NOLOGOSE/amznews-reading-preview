[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","yg5i64y5yu27k6s903ik5lxfu","revision",2,"title","美国海关 CBP 修改国际邮件电子非正式入境测试规则","originalTitle","Modification of the Test of the New Electronic Informal Entry Process for Mail","summary","美国海关与边境保护局（CBP）宣布修改针对国际邮件入境的新电子非正式入境类型测试，允许在传输入境信息时选择包含或不包含电子合作伙伴政府机构（PGA）数据。该修改于 2026 年 10 月 22 日生效，旨在优化通过国际邮件进入美国的货物申报流程。","reason","source",{"_9":87,"_88":89,"_90":91,"_92":62,"_93":94,"_95":96},"links",{"_84":85,"_67":86},"publishedAt","2026-10-22T04:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T05:17:26.692Z","timelineAt","category","policy","tags",[82,83],"score",30,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":-5,"_80":81},"detailedGuide","readingMode","full","author","Homeland Security Department, U.S. Customs and Border Protection","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fngHNJ5XT3I4",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","d835fbd4-a80f-4a56-b0b4-7aaefb79e9f8","CBP修改邮件入境电子非正式报关测试",{"_76":77,"_13":78},"platform","美国海关 CBP","政策/合规","亚马逊","aihot","/items/yg5i64y5yu27k6s903ik5lxfu","https://www.federalregister.gov/documents/2026/10/22/2026-21570/modification-of-the-test-of-the-new-electronic-informal-entry-process-for-mail","official-us-cbp-federal-register","name","美国海关 CBP · 联邦公报公告","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/fb25db0934701e45.webp","iconSrcSet","/amznews-read