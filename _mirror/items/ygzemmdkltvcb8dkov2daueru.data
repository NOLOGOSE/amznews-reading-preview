[{"_1":2,"_3":4},"root",{"_5":108},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","ygzemmdkltvcb8dkov2daueru","revision",1,"title","亚马逊卖家分享清仓转售经验","originalTitle","I’m a small fish on eBay but nearing $10k in the last 30 days from random Amazon flips.","summary","一位 eBay 小卖家称近 30 天通过随机亚马逊转售获利近 $10k，单笔销售在不到一周内赚取 +$56.20。作者认为无最佳单一模式，建议寻找适合自身且能持续精进的方法，并强调保持开放心态、承认无知及向他人学习的重要性。","reason","source",{"_9":102,"_103":104,"_82":105,"_106":39,"_107":-5},"links",{"_99":100,"_66":101},"publishedAt","2026-09-30T11:45:33.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:58:17.595Z","timelineAt","category","advertising","tags",[97,98],"score",15,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","SaulSellsStuff","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>I’m a small fish on eBay but nearing $10k in the last 30 days from random Amazon flips.</p><p>+$56.20 on this sale yesterday in under a week.</p><p>Is each buy replenish-able?  No <br>Can I string together enough consistently to pay my mortgage? Sure</p><p>You’ve got sellers doing a million a month buying clearance and close out items.</p><p>No one method or model is best, just find something that you can get better at and be consistent. One that fits your life and interests. Then expand from there if that’s what you want to do.</p><p>Every time I open X lately it’s a post about how some model wont work or that people are wasting their time.</p><p>What’s cool is that everyone can have an idea and then act on it, that what you want to do is likely possible if you iterate enough, and that we each have our own metric of success.</p><p>Also, be okay being wrong. Opinions are cool but so is changing them when new information enters your world. Nobody knows everything and honestly I have entered this phase of my life professionally by acknowledging I know so very little.</p><p>Position yourself around other people who spend their time doing things you don’t, then be open minded to their experiences and ideas. Do your best to leave the ego out of it and embrace the idea we can all learn and help each other at any level.</p>","zhKind","complete","authorName","Saul","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[80,81],{"_82":83,"_84":94,"_86":95,"_88":89,"_90":96,"_92":-5,"_93":-5},{"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":-5,"_93":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1320,"height",1213,"alt","poster","/amznews-reading-preview/_img/missing.svg","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w",1078,"广告/运营","多平台销售","aihot","/items/ygzemmdkltvcb8dkov2daueru","https://x.com/SaulSellsStuff/status/2105262773563199884","x-saul-sells-stuff","name","X · Saul","x_search","firstParty","iconUrl",{"_109":110},"changelogVersion","2026-10-09T22:08"]
