[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","yin6fkotcpapcx24h5w5sl5q0","revision",1,"title","亚马逊将零担运输服务扩展至所有企业","originalTitle","Amazon opens full-scale, less-than-truckload shipping to all businesses","summary","亚马逊宣布将其零担（LTL）运输服务从仅限入库模式扩展至所有目的地，向各类企业提供端到端物流支持。该服务允许企业向仓库、配送中心及零售店发送1至6个托盘或150至15,000磅的货物，并提供实时追踪与次日提货选项。分析师指出，尽管亚马逊拥有庞大设备网络，但其初期规模受限且运营模式更接近货运经纪商，主要竞争经济型零担市场。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-06-10T11:53:29.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T16:16:42.472Z","timelineAt","category","fba","tags",[68,69,70],"score",36,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Eric Kulisch","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","FreightWaves","FBA/物流","供应链","亚马逊","aihot","/items/yin6fkotcpapcx24h5w5sl5q0","https://www.freightwaves.com/news/amazon-opens-full-scale-less-than-truckload-network-to-all-businesses","publisher-freightwaves-amazon","name","FreightWaves · 亚马逊物流与运输报道","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp","iconSrcSet","/amznews-reading-preview/_img/d08cdc93ed86beb2.webp 48w, /amznews-reading-preview/_img/d08cdc93ed86beb2.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
