[{"_1":2,"_3":4},"root",{"_5":107},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","yio3xdqua3xdjo77ceojsqv4f","revision",2,"title","亚马逊选品差异化：加数量、送配件，为什么还是逃不出价格战？","originalTitle","亚马逊选品差异化，加数量、送配件，为什么还是逃不出价格战？","summary","亚马逊卖家靠加数量、送配件、换包装做差异化，往往只增加了自身成本，却没进入消费者的购买理由，价格一降利润就被吃掉。文章提出加任何东西前先问四件事：消费者何时用到、没有它会多出什么麻烦、是否愿为解决麻烦付钱、这笔投入能否收回。并以手动切菜器为例，演示如何从清洗残渣这一真实痛点出发判断改动是否值得做。","reason","source",{"_9":98,"_99":100,"_72":101,"_102":39,"_103":104,"_105":106},"links",{"_95":96,"_65":97},"publishedAt","2026-09-17T21:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:42.138Z","timelineAt","category","product","tags",[93,94],"score",22,"selected",false,"channel","news","story","x","media",[68,69,70,71],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","一汤说","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_72":73,"_74":90,"_76":91,"_78":92,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":87,"_76":88,"_78":89,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":84,"_76":85,"_78":86,"_80":-5,"_81":-5,"_82":-5,"_83":-5},{"_72":73,"_74":75,"_76":77,"_78":79,"_80":-5,"_81":-5,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/f8c87b93e8f2b65c.webp","fullUrl","/amznews-reading-preview/_img/f8c87b93e8f2b65c.webp","srcSet","/amznews-reading-preview/_img/f8c87b93e8f2b65c.webp 336w, /amznews-reading-preview/_img/f8c87b93e8f2b65c.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/2ec1a22a8f05f90a.webp","/amznews-reading-preview/_img/2ec1a22a8f05f90a.webp","/amznews-