[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","yio72p0ii9nza13e1efguvgb5","revision",2,"title","一个中端服装品牌如何通过季节性 SKU 切换在一周内将亚马逊销售额提升 37%","originalTitle","How a mid-market apparel brand grew Amazon sales 37% in a week with a seasonal SKU shift","summary","作者 Mike Begg 自述：一个中端服装品牌在亚马逊通常较弱的月份，采用其称为\"季节性 SKU 切换\"的两步做法——优先保障即将承接需求的 SKU 库存，并在季节完全转变前把广告预算从短裤转向慢跑裤——据其称一周内销售额从 $8,600 增至 $11,800，增长 37.2%，估计增加 $1,200 利润。该案例未提供可独立核验的数据来源。","reason","source",{"_9":89,"_90":52,"_68":91,"_92":39,"_93":94,"_95":96},"links",{"_86":87,"_65":88},"publishedAt","2026-10-05T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:50:44.156Z","timelineAt","category","advertising","tags",[81,82,83,84,85],"score",23,"selected",false,"channel","news","story","x","media",[67],"byline",{"_51":-5,"_66":52},"detailedGuide","readingMode","full","author","Mike Begg","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform",{"_68":69,"_70":71,"_72":73,"_74":75,"_76":77,"_78":77,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/adaa9617d61903e4.webp","fullUrl","/amznews-reading-preview/_img/adaa9617d61903e4.webp","srcSet","/amznews-reading-preview/_img/adaa9617d61903e4.webp 336w, /amznews-reading-preview/_img/adaa9617d61903e4.webp 720w","width",80,"height","alt","poster","广告/运营","广告投放","库存管理","品类趋势","亚马逊","aihot","/items/yio72p0ii9nza13e1efguvgb5","https://mikebegg.me/case-studies/seasonal-sku-shift-apparel","author-mikebegg-reviewed-cases","name","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/17e3