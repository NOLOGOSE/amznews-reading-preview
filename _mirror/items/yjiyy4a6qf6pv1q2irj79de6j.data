[{"_1":2,"_3":4},"root",{"_5":128},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","yjiyy4a6qf6pv1q2irj79de6j","revision",2,"title","亚马逊美欧站部分卖家反映10月销量下滑，物流爆仓与关仓传闻引关注","originalTitle","订单滑铁卢！亚马逊卖家销量创新低","summary","亚马逊美国站、欧洲站多名卖家在社交平台反映10月销量下滑，部分卖家称降价或增加广告预算后ACOS反而上涨。原文引述卖家猜测，秋促透支效应可能比往年更明显；同时提到亚马逊上线Browse Node 3.0后出现类目错放，但原文明确尚难断言这类调整是影响销量的主要因素。物流端，多家物流服务商反映美西、美中、美东多个仓库入库容量不足、预约困难；外媒报道亚马逊正考虑裁减约5000个岗位并关闭纽约市15个仓库，该消息与纽约市拟议中的《配送保障法案》有关，法案能否落地尚不确定。原文含“2027招商新政”线下活动推广及1V1问策略，存在相关商业利益，并非独立测评。","reason","source",{"_9":119,"_120":121,"_88":122,"_123":40,"_124":125,"_126":127},"links",{"_116":117,"_68":118},"publishedAt","2026-10-19T22:58:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-20","discoveredAt","2026-10-20T07:04:38.450Z","timelineAt","category","advertising","tags",[112,113,114,115],"score",35,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","AMZ123跨境电商","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":73},"hasTranslation","bodyLanguage","original","factId","fdWGz0nqzuqo",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","5cfa749d-785d-4a90-86a8-2c88d423eca0","亚马逊美国站FBA旺季爆仓与入仓截止线",{"_77":78,"_13":79},"platform","AMZ123",{"_88":89,"_90":109,"_92":110,"_94":111,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":106,"_92":107,"_94":108,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":103,"_92":104,"_94":105,"_96":-5,"_97":-5,"_98":-5,"_99":-5},{"_88":89,"_90":100,"_92":101,"_94":102,"_96":-5,"_9