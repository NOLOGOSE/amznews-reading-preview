[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":-5,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","ylh8w4to3g1k8rworr1i8a080","revision",3,"title","亚马逊与独立卖家合作 25 年：累计销售额超 2.5 万亿美元","originalTitle","$2.5 trillion in sales and counting: Celebrating 25 years of Amazon’s partnership with independent sellers","summary","亚马逊与独立卖家合作 25 年，这些卖家累计在亚马逊店铺创造超 2.5 万亿美元销售额，目前占店铺总销量 60% 以上。2025 年前十个月，卖家销售额已超过双方合作头十年总和；2024 年独立卖家在美国雇用了超 200 万人。","reason","source",{"_9":100,"_101":102,"_70":103,"_104":60,"_105":-5},"links",{"_97":98,"_64":99},"publishedAt","2025-11-06T14:00:03.275Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-29T19:32:29.470Z","timelineAt","category","tags",[92,93,94,95,96],"score",16,"selected",false,"channel","news","story","x","media",[67,68,69],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","Dharmesh Mehta","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","About Amazon",{"_70":71,"_72":89,"_74":90,"_76":91,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":84,"_74":85,"_76":86,"_78":87,"_80":88,"_82":-5,"_83":-5},{"_70":71,"_72":73,"_74":75,"_76":77,"_78":79,"_80":81,"_82":-5,"_83":-5},"kind","image","url","/amznews-reading-preview/_img/429c6b91f1278b79.webp","fullUrl","/amznews-reading-preview/_img/429c6b91f1278b79.webp","srcSet","/amznews-reading-preview/_img/429c6b91f1278b79.webp 336w, /amznews-reading-preview/_img/429c6b91f1278b79.webp 720w","width",1320,"height",743,"alt","poster","/amznews-reading-preview/_img/2798c4ea047d9151.webp","/amznews-reading-preview/_img/2798c4ea047d9151.webp","/amznews-reading-preview/_i