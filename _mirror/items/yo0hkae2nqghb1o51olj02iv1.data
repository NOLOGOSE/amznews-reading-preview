[{"_1":2,"_3":4},"root",{"_5":85},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","yo0hkae2nqghb1o51olj02iv1","revision",2,"title","亚马逊简报：2024 年策略混乱让 1P 品牌陷入两难","originalTitle","Amazon Briefing: Confusion over 2024 strategy leaves 1P brands in a bind","summary","亚马逊 1P 供应商称，平台在合同谈判中继续收紧利润空间；据 Dan Brownsher（Channel Key）称，亚马逊将硬线类目（如电子产品和家电）的销售利润率提高至 40%，此前约为 30% 至 35%。据 Martin Heubel（Consulterce）称，约六周前亚马逊供应商经理开始告知某些类目的欧洲品牌，不再支持均价低于约 10 美元的 listings，但亚马逊否认这些说法，称政策未变，并继续与供应商合作扩大低价商品选择。部分品牌被建议创建高价批量链接或重新调整广告预算，1P 与 3P 模式的选择因此再度成为焦点。","reason","source",{"_9":75,"_76":77,"_78":79,"_80":39,"_81":82,"_83":84},"links",{"_72":73,"_65":74},"publishedAt","2024-01-11T15:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:24:31.600Z","timelineAt","category","policy","tags",[68,69,70,71],"score",42,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Jessica Xing","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Modern Retail","政策/合规","亚马逊","品牌","费用变更","aihot","/items/yo0hkae2nqghb1o51olj02iv1","https://www.modernretail.co/technology/amazon-briefing-confusion-over-2024-strategy-leaves-1p-brands-in-a-bind/?utm_campaign=modernretaildis&utm_medium=rss&utm_source=general-rss","author-modern-retail-jessica-holiday-fulfillment-reviewed","name","Modern Retail · Jessica Xing","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/feec9bcddc707257.webp","iconSrcSet","/amznews-reading-preview/_img/feec9bcddc707257.webp 48w, /amznews-reading-preview/_img/feec9bcddc707257.webp 96w",{"_86":87},"changelogVersion","2026-10-09T22:08"]
