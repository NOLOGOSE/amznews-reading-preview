[{"_1":2,"_3":4},"root",{"_5":86},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","ypucgz6rehjag6ivar6dy7cqn","revision",3,"title","亚马逊卖家 250 万美元退出后，陷入 60 万美元体育卡庞氏骗局","originalTitle","#759 – Amazon Exit Turned Into a $600K Nightmare","summary","亚马逊卖家 Mitul Patel 把 Run Forever Sports 做到年销售额 250 万美元并于 2020 年卖出，随后在体育卡生意中遭遇庞氏骗局，损失 55 万至 60 万美元。他没有申请破产，而是变卖投资和收藏、向父亲借款，坚持还清客户欠款。他目前在 Navira 重建事业，并围绕体育卡热情经营新品牌，同时管理约 45 个品牌。","reason","source",{"_9":76,"_77":78,"_79":80,"_81":39,"_82":83,"_84":85},"links",{"_73":74,"_65":75},"publishedAt","2026-08-03T15:06:06.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-30T10:08:21.643Z","timelineAt","category","ai-tools","tags",[68,69,70,71,72],"score",21,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Bradley Sutton","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Helium 10","AI/工具","卖家工具","亚马逊","品牌","Listing优化","aihot","/items/ypucgz6rehjag6ivar6dy7cqn","https://www.helium10.com/podcast/759-amazon-exit-turned-into-a-600k-nightmare/","author-helium10-bradley","name","Helium 10 · Bradley Sutton","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/8526814066f79ad2.webp","iconSrcSet","/amznews-reading-preview/_img/8526814066f79ad2.webp 48w, /amznews-reading-preview/_img/8526814066f79ad2.webp 96w",{"_87":88},"changelogVersion","2026-10-09T22:08"]
