[{"_1":2,"_3":4},"root",{"_5":136},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","yq7h5cc04h9ljje4f9jbrhmc1","revision",2,"title","返校季已成第二个 Q4：Tinuiti 最新消费者调研对广告主意味着什么","originalTitle","Back-to-School Is Now a Second Q4. What Our Latest Consumer Research Means for Advertisers","summary","Tinuiti 基于 2026 年 6 月对 1040 名美国家长的调研指出，返校季已变成第二个 Q4，70% 的购买集中在 7 月和 8 月。65% 的家长把价格列为前三大购物影响因素，63% 称食品杂货涨价会挤压返校预算，但 59% 仍计划比去年多花钱。社媒与店内陈列以 43% 并列第一发现渠道，多数家长计划使用 AI 工具购物，47% 同时在 Walmart 和 Amazon 线上购物。","reason","source",{"_9":128,"_129":67,"_77":130,"_131":61,"_132":133,"_134":135},"links",{"_125":126,"_65":127},"publishedAt","2026-07-30T10:07:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T16:25:24.604Z","timelineAt","category","advertising","tags",[120,121,122,123,124],"score",34,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74,75,76],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Jenn Wheatley","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","Tinuiti",{"_77":78,"_79":116,"_81":117,"_83":118,"_85":119,"_87":86,"_89":-5,"_90":-5},{"_77":78,"_79":112,"_81":113,"_83":114,"_85":86,"_87":115,"_89":-5,"_90":-5},{"_77":78,"_79":109,"_81":110,"_83":111,"_85":86,"_87":88,"_89":-5,"_90":-5},{"_77":78,"_79":106,"_81":107,"_83":108,"_85":86,"_87":88,"_89":-5,"_90":-5},{"_77":78,"_79":103,"_81":104,"_83":105,"_85":94,"_87":94,"_89":-5,"_90":-5},{"_77":78,"_79":99,"_81":100,"_83":101,"_85":102,"_87":102,"_89":-5,"_90":-5},{"_77":78,"_79":96,"_81":97,"_83":98,"_85":86,"_87":88,"_89":-5,"_90":-5},{"_77":