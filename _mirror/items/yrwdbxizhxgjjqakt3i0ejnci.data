[{"_1":2,"_3":4},"root",{"_5":115},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","yrwdbxizhxgjjqakt3i0ejnci","revision",3,"title","亚马逊产品断货前后的运营推广方案：风险预判、广告调控与权重修复","originalTitle","关于亚马逊产品断货前后的运营推广方案","summary","亚马逊断货的核心是需求放大能力与库存承接能力失衡，短期断货会导致销售增速停滞、关键词排名下滑，长期断货则让竞品抢占市场份额。断货前应提前7-10天逐步收缩广告预算、分批清理低效关键词，单次涨价幅度不超过10%并观察3-5天数据。按断货时长分为短期（0-14天）保链接权重、长期（15天以上）最大化降低损失两类场景，补货后分阶段重启广告并将核心预算提升至日常的1.5-2倍。","reason","source",{"_9":106,"_107":108,"_73":109,"_110":39,"_111":112,"_113":114},"links",{"_103":104,"_65":105},"publishedAt","2026-09-07T02:06:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:36.001Z","timelineAt","category","advertising","tags",[97,98,99,100,101,102],"score",27,"selected",false,"channel","news","story","x","media",[68,69,70,71,72],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","夕木运营笔记本","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_73":74,"_75":94,"_77":95,"_79":96,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":91,"_77":92,"_79":93,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":88,"_77":89,"_79":90,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":85,"_77":86,"_79":87,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/aaad55bec58d3a15.webp","fullUrl","/amznews-reading-preview/_img/aaad55bec58d3a15.webp","srcSet","/amznews-reading-preview/_img/aaad55bec58d3a15.webp 336w, /amznews-reading-preview/_img/aaad55bec58d3a15.webp 720w","width","height",