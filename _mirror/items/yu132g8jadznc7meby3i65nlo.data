[{"_1":2,"_3":4},"root",{"_5":82},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":26,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":41,"_61":41,"_62":-5,"_63":64,"_65":66},"id","yu132g8jadznc7meby3i65nlo","revision",3,"title","亚马逊发布卖家自配送多项新规及常见问题解答","originalTitle","亚马逊卖家自配送近期新规，10个常见问题一次讲清","summary","亚马逊针对美国和欧洲等站点的卖家自配送（FBM）政策更新整理了10个常见问题，涵盖备货时间、准时送达率（OTDR）、营业时间送达率（BHDR）及欧盟清关等要求。其中，美国及欧洲5国自9月30日起BHDR须不低于90%，发往欧盟订单7月起征收3欧元进口关税且11月起增加2欧元海关手续费；中国发往日本的FBM Ship+订单自7月15日起仅能通过“购买配送”发货。","reason","原文汇总了美欧日等多站点自配送新规的生效时间与具体指标，帮助卖家快速核对合规要求。","source",{"_9":75,"_76":77,"_78":79,"_80":41,"_81":-5},"links",{"_72":73,"_66":74},"publishedAt","2026-09-14T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-09-15","discoveredAt","2026-10-16T14:13:44.071Z","timelineAt","category","policy","tags",[69,70,71],"score",71,"selected",true,"channel","news","story","x","media",[],"byline",{"_53":-5,"_67":68},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","platform","亚马逊全球开店","政策/合规","亚马逊","FBA/物流","aihot","/items/yu132g8jadznc7meby3i65nlo","https://globalselling.amazon.com/news/news-notics-260915","official-amazon-global-selling-news","name","亚马逊全球开店 · 官方资讯","kind","web_list","firstParty","iconUrl",{"_83":84},"changelogVersion","2026-10-09T22:08"]
