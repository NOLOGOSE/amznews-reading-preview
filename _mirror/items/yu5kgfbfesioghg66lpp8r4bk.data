[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","yu5kgfbfesioghg66lpp8r4bk","revision",6,"title","AI 不擅长什么？一个被 AI 垃圾邮件过滤器误杀客户邮件的真实案例","originalTitle","What Is AI Bad At?","summary","一名 AI 讲师为产品公司准备 AI 午餐分享会时，客户周五发来的准备材料被自己搭建的 AI 邮件过滤器判定为垃圾邮件，导致他始终没收到。他把这件事写进演讲，作为\"AI 不擅长什么\"的第 15 题答案：AI 会自信地给出错误答案且从不告知，它受限于上下文窗口、无法为决策负责，指向错误流程只会让错误流程更快。","reason","source",{"_9":88,"_89":81,"_90":91,"_92":39,"_93":94,"_95":96},"links",{"_85":86,"_67":87},"publishedAt","2026-09-30T13:30:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-01T18:12:22.169Z","timelineAt","category","ai-tools","tags",[82,83,84],"score",13,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Nhan Dinh","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fmCQjHxCEV4w",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","c533d0f8-7e99-4017-85c1-939891a9dfb7","AI 邮件过滤器误杀客户邮件案例",{"_76":77,"_13":78},"platform","Seller Labs","AI/工具","AI工具","卖家工具","aihot","/items/yu5kgfbfesioghg66lpp8r4bk","https://www.sellerlabs.com/blog/what-is-ai-bad-at/","rss-sellerlabs-prelaunch","name","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp","iconSrcSet","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 48w, /amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 96w",{"_98":99},"changelogVersion","2026-10-09T22:08"]
