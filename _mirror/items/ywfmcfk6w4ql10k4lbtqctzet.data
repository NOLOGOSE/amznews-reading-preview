[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","ywfmcfk6w4ql10k4lbtqctzet","revision",4,"title","Pasha Knish 建议卖家停止将亚马逊 Listing 视为静态宣传册","originalTitle","Stop Treating Your Amazon Listing Like a Brochure, with Pasha Knish","summary","嘉宾 Pasha Knish 在播客中提出，卖家不应将 Amazon Listing 当作静态宣传册，因为亚马逊会自行编辑链接且 AI（Rufus/Cosmo）正根据买家意图匹配内容。他建议通过回答 14 个关于产品用途、受众及结果的问题来优化文案与图片，以同时满足算法与人类购物者的需求。","reason","source",{"_9":87,"_88":81,"_89":90,"_91":39,"_92":93,"_94":95},"links",{"_84":85,"_67":86},"publishedAt","2026-10-08T13:00:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-08T14:32:29.402Z","timelineAt","category","advertising","tags",[82,83],"score",22,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Nhan Dinh","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fa7HhUM1xOqc",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","42ba7fce-6f12-49c0-b812-83ef1ac227ee","Pasha Knish 谈亚马逊 Listing 优化新思路",{"_76":77,"_13":78},"platform","Seller Labs","广告/运营","Listing优化","aihot","/items/ywfmcfk6w4ql10k4lbtqctzet","https://www.sellerlabs.com/blog/amazon-listing-not-a-brochure-pasha-knish/","rss-sellerlabs-prelaunch","name","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp","iconSrcSet","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 48w, /amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 96w",{