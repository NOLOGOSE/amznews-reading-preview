[{"_1":2,"_3":4},"root",{"_5":126},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","z1ae5umsoiaz4e3pekd8rzypw","revision",9,"title","Seller Central 多渠道工具逐步面向美国站推出：先核对当前能力","originalTitle","Sellers can now manage sales across Amazon, eBay, Shopify, TikTok, and Walmart from Seller Central","summary","Mary Beth Westmoreland 在2026年9月24日的亚马逊官方署名公告中介绍，多渠道销售工具将在未来数月逐步向美国站卖家推出。原文描述连接 eBay、Shopify、TikTok、Walmart，导入或关联站外商品、查看多渠道销售与订单及履约；跨渠道一次修改商品信息、利润和广告流量分析等能力包含未来推出的表述，不能据此认定所有账户现在都可使用。工具不额外收费，不代表仓储、履约、广告及其他平台费用免费。本站建议先查看自己账户的功能与准入要求，核对账户连接权限、数据范围和既有履约成本，再用小范围流程验证；没有代卖家完成连接，也未独立测试隐私、安全或经营效果。客户节省时间是采访自述，不是普遍收益保证。本文是有限原创条件导读，保留原文，不转载全文、译文、图片或音视频。","reason","source",{"_9":120,"_121":122,"_75":123,"_124":61,"_125":-5},"links",{"_117":118,"_65":119},"publishedAt","2026-09-24T13:00:11.009Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-09-29T19:32:29.411Z","timelineAt","category","ai-tools","tags",[111,112,113,114,115,116],"score",69,"selected",false,"channel","news","story","x","media",[68,69,70,71,72,73,74],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mary Beth Westmoreland","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","About Amazon",{"_75":76,"_77":106,"_79":107,"_81":108,"_83":109,"_85":110,"_87":-5,"_88":-5},{"_75":76,"_77":103,"_79":104,"_81":105,"_83":84,"_85":86,"_87":-5,"_88":-5},{"_75":76,"_77":100,"_79":101,"_81":102,"_83":84,"_85":86,"_87":-5,"_88":-5},{"_75":76,"_77":97,"_79":98,"_81":99,"_83":92,"_85":93,"_87":-5,"_88":-5},{"_75":76,"_77":94,"_79":95,"_81":96,"_83":92,"_85":93,"_87":-5,"_88":-5},{"_75":76,"_7