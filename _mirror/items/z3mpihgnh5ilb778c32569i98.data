[{"_1":2,"_3":4},"root",{"_5":80},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":25,"_33":34,"_35":36,"_37":-5,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","z3mpihgnh5ilb778c32569i98","revision",3,"title","亚马逊公布2026年欧洲站销售佣金与FBA费用变更","originalTitle","2026亚马逊欧洲站销售佣金和亚马逊物流费用变更","summary","亚马逊宣布2026年在欧洲站实施大规模费用下调，每件商品平均降低£0.15或€0.17。服装、家居等品类佣金及包裹配送费将于2025年12月15日生效调整，低价商品FBA优惠费率扩至£20/€20并于2026年2月1日生效。部分仓储及退货费用将同步上调，卖家需关注库存健康以优化成本。","reason","source",{"_9":73,"_74":75,"_76":77,"_78":60,"_79":-5},"links",{"_70":71,"_64":72},"publishedAt","2025-11-30T16:00:00.000Z","publishedPrecision","calendar","calendarDate","2025-12-01","discoveredAt","2026-10-16T14:13:44.052Z","timelineAt","category","policy","tags",[67,68,69],"score","selected",false,"channel","news","story","x","media",[],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","亚马逊全球开店","费用变更","亚马逊","FBA/物流","aihot","/items/z3mpihgnh5ilb778c32569i98","https://gs.amazon.cn/news/news-notices-251201?ref=as_cn_ags_news_hp_notice_s2","official-amazon-global-selling-news","name","亚马逊全球开店 · 官方资讯","kind","web_list","firstParty","iconUrl",{"_81":82},"changelogVersion","2026-10-09T22:08"]
