[{"_1":2,"_3":4},"root",{"_5":104},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","z5gt8pd4px05rist0fuscar68","revision",5,"title","亚马逊推出AI购物助手Rufus测试，或改变卖家流量获取逻辑","originalTitle","亚马逊最新AI“搜索工具”Rufus推出测试，或是AI电商对传统搜索电商颠覆的开始？作为卖家/运营预期能做些什么？","summary","亚马逊于2024年2月左右在美国站APP端推出生成式AI购物工具Rufus进行测试。该工具基于产品目录、评论及网络信息训练，支持场景化提问与推荐，可能分流传统关键词搜索流量。作者建议卖家优化Listing内容以适配语义理解，并关注站外SEO对AI收录的影响。","reason","source",{"_9":96,"_97":67,"_71":98,"_99":39,"_100":101,"_102":103},"links",{"_93":94,"_65":95},"publishedAt","2024-02-19T16:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-01T09:32:55.313Z","timelineAt","category","advertising","tags",[89,90,91,92],"score",38,"selected",false,"channel","news","story","x","media",[68,69,70],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","应如是","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","知无不言",{"_71":72,"_73":86,"_75":87,"_77":88,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":83,"_75":84,"_77":85,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":-5,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/57ab9cf5e5083303.webp","fullUrl","/amznews-reading-preview/_img/57ab9cf5e5083303.webp","srcSet","/amznews-reading-preview/_img/57ab9cf5e5083303.webp 336w, /amznews-reading-preview/_img/57ab9cf5e5083303.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/d15676b94154fb60.webp","/amznews-reading-preview/_img/d15676b94154fb60.webp","/amznews-reading-preview/_img/d15676b94154fb60.webp 336w, /amznews-readi