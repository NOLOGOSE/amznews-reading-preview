[{"_1":2,"_3":4},"root",{"_5":130},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","z5xn1jjuho8oshovbbod3j5px","revision",2,"title","亚马逊提醒卖家核查进口商身份以应对美国进口新规审查","originalTitle","美国进口新规已进入审查阶段！亚马逊提醒卖家速自查","summary","亚马逊向美国站卖家发出邮件通知，提醒提前核查备案进口商（IOR）身份及清关安排，以应对已进入白宫审查阶段的联邦规则。该规则源于第14411号行政令，拟根据IOR是美国实体或外国实体设置差异化合规要求，其中针对外国IOR的条款可能率先生效。","reason","原文梳理了美国进口新规对IOR身份的具体合规要求及潜在成本影响，为卖家提供了自查路径与应对建议。","source",{"_9":121,"_122":123,"_90":124,"_125":67,"_126":127,"_128":129},"links",{"_118":119,"_69":120},"publishedAt","2026-10-22T02:45:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-22","discoveredAt","2026-10-23T01:40:37.322Z","timelineAt","category","policy","tags",[114,115,116,117],"score",62,"selected",true,"channel","news","story",{"_79":80,"_13":81},"x","media",[85,86,87,88,89],"byline",{"_54":55,"_83":84},"detailedGuide","readingMode","full","author","腾信物流","language","body","outline",[],"relatedStories",[82],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":76,"_77":78},"hasTranslation",false,"bodyLanguage","original","factId","fmaocLwjsyyA",{"_79":80,"_13":81},"reportCount",4,"additionalSourceCount",1,"developmentCount",0,"publicId","17e32b95-4b2d-40d4-9f1a-a5926dff996a","亚马逊提醒卖家自查IOR应对美国进口新规",{"_79":80,"_13":81},"platform","AMZ123",{"_90":91,"_92":111,"_94":112,"_96":113,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":108,"_94":109,"_96":110,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":105,"_94":106,"_96":107,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":102,"_94":103,"_96":104,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":93,"_94":95,"_96":97,"_98":-5,"_99":-5,"_100":-5,"_101":-5},"kind"