[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","z6gasb404d1a32y5git4veyb3","revision",4,"title","该付入库配置费还是拆分货件？亚马逊Q4发货成本对比","originalTitle","Pay the Placement Fee or Split the Shipment? The Q4 Math","summary","Seller Labs 给出亚马逊入库配置费与拆分货件运费的对比方法：若配置费高于额外运费就拆分，反之付费，并附每单位盈亏平衡点算法。以 2400 件 6 托为例，最小拆分总成本 1620 美元，亚马逊优化拆分 1440 美元，拆分省 180 美元，盈亏平衡点为每件 0.225 美元；1200 件 5 托的小货件则相反，付费反而省 240 美元。","reason","source",{"_9":89,"_90":81,"_91":92,"_93":39,"_94":95,"_96":97},"links",{"_86":87,"_67":88},"publishedAt","2026-09-30T14:40:32.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-01T18:12:06.961Z","timelineAt","category","fba","tags",[82,83,84,85],"score",62,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Denis D","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fe4qvT3ZTZ6U",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","0301d5c9-268e-40b4-97d2-99705bbd6e9a","亚马逊入库配置费与拆分发货成本对比",{"_76":77,"_13":78},"platform","Seller Labs","FBA/物流","库存管理","费用变更","亚马逊","aihot","/items/z6gasb404d1a32y5git4veyb3","https://www.sellerlabs.com/blog/amazon-inbound-placement-fee-split-shipment/","rss-sellerlabs-prelaunch","name","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp","iconSrcSet","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 48w, /amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp 96w",{"_9