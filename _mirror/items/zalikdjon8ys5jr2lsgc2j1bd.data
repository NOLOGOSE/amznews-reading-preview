[{"_1":2,"_3":4},"root",{"_5":106},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","zalikdjon8ys5jr2lsgc2j1bd","revision",1,"title","51Degrees报告：AI机器人占其追踪的AI机器人流量63%","originalTitle","AI bots may be reading your listings more than actual shoppers are","summary","Rambler_Amz在X上评论51Degrees自报调查：该机构分析截至2026年5月29日的一年内30亿次网站访问，称AmazonBot与Meta-External-Agent合计占其追踪到的AI机器人流量的63%，整体AI机器人流量同比增62.5%，占全部网络会话13%（一年前为8%）；并称出版商仅通过robots.txt屏蔽约21%的已知AI爬虫。上述数据来自该机构自报，本站尚未独立核验，不能推广为亚马逊平台流量或总体结论。作者对合作伙伴亚马逊listing流量是否混有AI与人类表示不确定。","reason","source",{"_9":100,"_101":102,"_81":103,"_104":39,"_105":-5},"links",{"_97":98,"_66":99},"publishedAt","2026-09-05T16:52:29.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T15:42:17.640Z","timelineAt","category","advertising","tags",[93,94,95,96],"score",38,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","Rambler_Amz","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>AI bots may be reading your listings more than actual shoppers are</p><p>51Degrees analyzed 3 billion website visits (year to May 29, 2026)</p><p>AmazonBot + Meta-External-Agent = 63% of all AI bot traffic tracked</p><p>On May 29 alone: AmazonBot logged 6.43M sessions, Meta's bot 4.23M &gt; combined, more than AhrefsBot + BingBot put together</p><p>Overall AI bot traffic: +62.5% YoY, now 13% of all web sessions (up from 8% a year ago)</p><p>The catch: these bots scrape the page, feed an AI answer to someone else's question, and the original site never gets the click or the sale.</p><p>Publishers are only blocking ~21% of known AI scrapers via robots.txt but most are leaving the door wide open</p><p>Not really sure about the traffic numbers we're getting on our partners' listings on Amazon, are they all organic, or a mix of AI and humans? 🤔</p>","zhKind","complete","authorName","Rambler | X -Amazonian | Account Health Expert |","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[80],{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":-5,"_92":-5},"kind","image","url","/amznews-reading-preview/_img/missing.svg","srcSet","/amznews-reading-preview/_img/missing.svg 720w, /amznews-reading-preview/_img/missing.svg 1200w, /amznews-reading-preview/_img/missing.svg 1600w","width",1080,"height",1350,"alt","poster","广告/运营","Listing优化","AI工具","亚马逊","aihot","/items/zalikdjon8ys5jr2lsgc2j1bd","https://x.com/Rambler_Amz/status/2096280319716724900","x-rambler-amz","name","X · Rambler","x_search","firstParty","iconUrl",{"_107":108},"changelogVersion","2026-10-09T22:08"]
