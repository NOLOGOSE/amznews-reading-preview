[{"_1":2,"_3":4},"root",{"_5":84},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","zc7wntyu4xgl48zx3jpq6xr9o","revision",1,"title","Walmart Connect 推出 Sponsored Products 否定关键词功能","originalTitle","Walmart finally lets advertisers exclude certain search terms","summary","Walmart Connect 于7月下旬在 Ad Center 及 Pacvue、Teikametrics 等合作伙伴平台上线 Sponsored Products 否定关键词功能，允许广告主排除特定搜索词以优化预算。该功能旨在提升自动投放的精准度，帮助品牌避免在低效或无关流量上花费，此前亚马逊自2019年起已提供类似能力。","reason","source",{"_9":74,"_75":76,"_77":78,"_79":39,"_80":81,"_82":83},"links",{"_71":72,"_65":73},"publishedAt","2026-08-11T04:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-05T07:13:43.582Z","timelineAt","category","advertising","tags",[68,69,70],"score",22,"selected",false,"channel","news","story","x","media",[],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Mitchell Parton","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","modern-retail","广告/运营","关键词","多平台销售","aihot","/items/zc7wntyu4xgl48zx3jpq6xr9o","https://www.modernretail.co/marketing/walmart-finally-lets-advertisers-exclude-certain-search-terms/","author-modern-retail-mitchellparton","name","modern-retail · Mitchell Parton","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/feec9bcddc707257.webp","iconSrcSet","/amznews-reading-preview/_img/feec9bcddc707257.webp 48w, /amznews-reading-preview/_img/feec9bcddc707257.webp 96w",{"_85":86},"changelogVersion","2026-10-09T22:08"]
