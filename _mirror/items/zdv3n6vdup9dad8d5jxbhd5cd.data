[{"_1":2,"_3":4},"root",{"_5":96},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","zdv3n6vdup9dad8d5jxbhd5cd","revision",2,"title","花生酱品牌如何用 SKU 隔离在广告预算不变下提升亚马逊销售额 18%","originalTitle","How a peanut butter brand grew Amazon sales 18% on flat ad spend with SKU isolation","summary","Mike Begg 复盘一个多件装花生酱品牌的亚马逊广告案例，该账号周销售额从 17,536 美元增至 20,612 美元，增幅 18%，广告支出保持不变。做法包括在 Auto、Broad 和 Phrase 广告活动中添加否定词剔除不转化的搜索词，把预算集中到转化最好的 FBA SKU 和包装规格，并改为每个广告活动只投放一个 SKU，避免变体之间互相争抢预算。","reason","source",{"_9":88,"_89":52,"_68":90,"_91":39,"_92":93,"_94":95},"links",{"_85":86,"_65":87},"publishedAt","2026-09-28T00:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-07T11:50:44.156Z","timelineAt","category","advertising","tags",[81,82,83,84],"score",57,"selected",false,"channel","news","story","x","media",[67],"byline",{"_51":-5,"_66":52},"detailedGuide","readingMode","full","author","Mike Begg","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform",{"_68":69,"_70":71,"_72":73,"_74":75,"_76":77,"_78":77,"_79":-5,"_80":-5},"kind","image","url","/amznews-reading-preview/_img/adaa9617d61903e4.webp","fullUrl","/amznews-reading-preview/_img/adaa9617d61903e4.webp","srcSet","/amznews-reading-preview/_img/adaa9617d61903e4.webp 336w, /amznews-reading-preview/_img/adaa9617d61903e4.webp 720w","width",80,"height","alt","poster","广告/运营","广告投放","Listing优化","亚马逊","aihot","/items/zdv3n6vdup9dad8d5jxbhd5cd","https://mikebegg.me/case-studies/sku-isolation-efficiency-stack-peanut-butter","author-mikebegg-reviewed-cases","name","web_list","firstParty","iconUrl","/amznews-reading-previe