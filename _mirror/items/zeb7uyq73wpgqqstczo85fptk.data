[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":-5,"_16":17,"_18":-5,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":29,"_30":24,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":-5,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":38,"_59":60,"_61":-5,"_62":38,"_63":64},"id","zeb7uyq73wpgqqstczo85fptk","revision",4,"title","亚马逊CPC越来越贵，真的只是竞争对手出价更高吗？","originalTitle","summary","亚马逊CPC上涨未必是同行加价，较便宜关键词流量减少、较贵关键词占比增加，同样会推高整体平均CPC。8月31日美国FTC与22个州起诉Amazon，指控其通过未披露的定价安排抬高广告拍卖价格，其中称2024年Sponsored Products按广告主自身中标出价收费的比例约为80%，Amazon否认相关指控。提价前应先拆解流量与投放变化，并按产品利润测算可承受的点击成本。","reason","source",{"_9":100,"_101":102,"_71":103,"_104":38,"_105":106,"_107":108},"links",{"_97":98,"_64":99},"publishedAt","2026-09-15T21:00:00.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-04T15:21:42.138Z","timelineAt","category","advertising","tags",[92,93,94,95,96],"score",24,"selected",false,"channel","news","story","x","media",[67,68,69,70],"byline",{"_50":51,"_65":66},"detailedGuide","readingMode","full","author","一汤说","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","AMZ123",{"_71":72,"_73":89,"_75":90,"_77":91,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":86,"_75":87,"_77":88,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":83,"_75":84,"_77":85,"_79":-5,"_80":-5,"_81":-5,"_82":-5},{"_71":72,"_73":74,"_75":76,"_77":78,"_79":-5,"_80":-5,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/267bd8efa2bdf700.webp","fullUrl","/amznews-reading-preview/_img/267bd8efa2bdf700.webp","srcSet","/amznews-reading-preview/_img/267bd8efa2bdf700.webp 336w, /amznews-reading-preview/_img/267bd8efa2bdf700.webp 720w","width","height","alt","poster","/amznews-reading-preview/_img/3e9a23d5b29e0a35.webp","/amznews-reading-preview/_img/3e9a23d5b29e0a3