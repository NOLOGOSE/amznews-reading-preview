[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":-5,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":40,"_61":62,"_63":64,"_65":40,"_66":67},"id","zgoamn835o2uzoj0to50koamb","revision",4,"title","美国CPSC召回PACEARTH秋千座椅，因断裂致坠落风险","originalTitle","Pacearth Direct Recalls PACEARTH Swing Seats Due to Risk of Serious Injury from Fall Hazard","summary","美国消费品安全委员会（CPSC）宣布召回约110,550个PACEARTH U型秋千座椅，因金属扣件或织带可能在使用中断裂导致严重坠落伤害。该问题已引发至少30起跌落报告及9人受伤。消费者应立即停用并联系Pacearth Direct获取全额退款，该产品曾于2017年5月至2026年6月在Amazon.com销售。","reason","source",{"_9":88,"_89":82,"_90":91,"_92":62,"_93":94,"_95":96},"links",{"_85":86,"_67":87},"publishedAt","2026-10-08T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-08","discoveredAt","2026-10-08T20:49:57.080Z","timelineAt","category","policy","tags",[83,84],"score",28,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[],"byline",{"_53":-5,"_81":82},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_68":69,"_43":70,"_71":72,"_73":74,"_75":76},"hasTranslation","bodyLanguage","original","factId","fCHW8vLQuD64",{"_77":78,"_13":79},"reportCount",2,"additionalSourceCount",1,"developmentCount",0,"publicId","8fe11098-c631-4d19-8132-a81c071f3ef1","CPSC召回PACEARTH秋千座椅",{"_77":78,"_13":79},"platform","CPSC 美国消费品安全委员会","政策/合规","亚马逊","aihot","/items/zgoamn835o2uzoj0to50koamb","https://www.cpsc.gov/Recalls/2027/Pacearth-Direct-Recalls-PACEARTH-Swing-Seats-Due-to-Risk-of-Serious-Injury-from-Fall-Hazard","official-cpsc-amazon-recalls-reviewed","name","kind","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp","iconSrcSet","/amznews-reading-preview/_img/3828