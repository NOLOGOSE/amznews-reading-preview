[{"_1":2,"_3":4},"root",{"_5":139},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":-5,"_52":-5,"_53":-5,"_54":55,"_56":57,"_58":39,"_59":60,"_61":-5,"_62":39,"_63":64},"id","zl0d7q4n7xqherlg86sjkb37x","revision",1,"title","前泽宝合伙人创立Dreo，2025年预估销售额达22亿元","originalTitle","前泽宝合伙人创业，再战小家电，年售22亿","summary","前泽宝轮值CEO魏立虎等人创立小家电品牌Dreo（和生创新），2025年预估销售额约22亿元。该品牌聚焦风扇、取暖器等家庭环境设备，通过直流无刷电机等微创新解决痛点，在亚马逊美国站及欧盟市场占据头部份额。尽管渠道覆盖线上线下，但Dreo仍高度依赖亚马逊单一平台，且面临季节性波动与多品类竞争压力。","reason","source",{"_9":130,"_131":132,"_76":133,"_134":39,"_135":136,"_137":138},"links",{"_127":128,"_64":129},"publishedAt","2026-10-13T07:31:39.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T14:43:54.088Z","timelineAt","category","product","tags",[124,125,126],"score",22,"selected",false,"channel","news","story","x","media",[67,68,69,70,71,72,73,74,75],"byline",{"_51":-5,"_65":66},"detailedGuide","readingMode","full","author","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","蓝海亿观网",{"_76":77,"_78":119,"_80":120,"_82":121,"_84":122,"_86":123,"_88":-5,"_89":-5},{"_76":77,"_78":115,"_80":116,"_82":117,"_84":85,"_86":118,"_88":-5,"_89":-5},{"_76":77,"_78":111,"_80":112,"_82":113,"_84":85,"_86":114,"_88":-5,"_89":-5},{"_76":77,"_78":106,"_80":107,"_82":108,"_84":109,"_86":110,"_88":-5,"_89":-5},{"_76":77,"_78":102,"_80":103,"_82":104,"_84":85,"_86":105,"_88":-5,"_89":-5},{"_76":77,"_78":98,"_80":99,"_82":100,"_84":85,"_86":101,"_88":-5,"_89":-5},{"_76":77,"_78":94,"_80":95,"_82":96,"_84":85,"_86":97,"_88":-5,"_89":-5},{"_76":77,"_78":90,"_80":91,"_82":92,"_84":85,"_86":93,"_88":-5,"_89":-5},{"_76":77,"_78":79,"_80":81,"_82":83,"_84":85,"_86":87,"_88":-5,"_89":-5},"kind","ima