[{"_1":2,"_3":4},"root",{"_5":109},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","zlmly573vrsozdboiiiyqrn9s","revision",7,"title","Amazon DSP 受众抑制策略：通过排除无效购物者减少广告浪费","originalTitle","Amazon DSP Audience Suppression: Cutting Waste by Excluding the Wrong Shoppers","summary","Amazon DSP 受众抑制旨在通过排除近期购买者、现有订阅者等低增量价值人群，将预算重新分配给高转化潜力用户以提升效率。该策略区别于频次上限，直接移除特定受众资格，需结合订单级与行项目级设置以避免重叠浪费。原文指出平台平均 CPM 为 $7.82，错误投放百万次曝光即造成 $7,820 损失，建议按漏斗阶段构建抑制框架并配合 Holdout 测试衡量影响。","reason","source",{"_9":103,"_104":105,"_73":106,"_107":39,"_108":-5},"links",{"_100":101,"_65":102},"publishedAt","2026-09-05T11:30:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-09-30T06:02:31.007Z","timelineAt","category","advertising","tags",[97,98,99],"score",36,"selected",false,"channel","news","story","x","media",[68,69,70,71,72],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Nithin Mentreddy","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","sellerapp",{"_73":74,"_75":94,"_77":95,"_79":96,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":91,"_77":92,"_79":93,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":88,"_77":89,"_79":90,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":85,"_77":86,"_79":87,"_81":-5,"_82":-5,"_83":-5,"_84":-5},{"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5,"_83":-5,"_84":-5},"kind","image","url","/amznews-reading-preview/_img/07036abdc2bd836e.webp","fullUrl","/amznews-reading-preview/_img/07036abdc2bd836e.webp","srcSet","/amznews-reading-preview/_img/07036abdc2bd836e.webp 336w, /amznews-reading-preview/_im