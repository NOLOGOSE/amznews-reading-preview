[{"_1":2,"_3":4},"root",{"_5":134},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":31,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":-5,"_46":47,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":-5,"_56":-5,"_57":58,"_59":60,"_61":40,"_62":63,"_64":65,"_66":40,"_67":68},"id","zn8lis3ey91wgpstu8aqn175p","revision",7,"title","圣诞品竞品少但秋促后排名下跌且广告有点击无单，是否应加预算反超","originalTitle","# 运营案例分析 # 我推的圣诞品只有6、7个直接竞品，秋促后排名都跌了，日投40美元广告却只有点击没单，该加预算反超吗？问题有下面几个……","summary","卖家分享圣诞品在直接竞品仅6-7个的情况下，秋促后排名集体下跌、日投40美元广告仅有点击无转化的案例。其朋友建议关闭原有混乱广告，改开4个长尾词广泛匹配及自动广告并降低竞价，但近期仍受市场流量下降影响出单不稳定。","reason","source",{"_9":126,"_127":82,"_90":128,"_129":40,"_130":131,"_132":133},"links",{"_123":124,"_68":125},"publishedAt","2026-10-15T02:28:26.809Z","publishedPrecision","calendar","calendarDate","2026-10-15","discoveredAt","2026-10-15T02:33:22.030Z","timelineAt","category","advertising","tags",[120,121,122],"score",22,"selected",false,"channel","news","story",{"_77":78,"_13":79},"x","media",[83,84,85,86,87,88,89],"byline",{"_53":54,"_81":82},"detailedGuide","readingMode","full","author","排骨汤很香香","language","body","outline",[],"relatedStories",[80],"indexable","markdownAvailable",true,"group",{"_69":70,"_43":71,"_72":73,"_74":75,"_76":75},"hasTranslation","bodyLanguage","original","factId","fgb-Z5ndcg-k",{"_77":78,"_13":79},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","7883b53d-1f53-457b-b66d-e0c0e92621fd","卖家咨询圣诞品秋促后排名下跌及广告无单问题",{"_77":78,"_13":79},"platform","知无不言",{"_90":91,"_92":117,"_94":118,"_96":119,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":114,"_94":115,"_96":116,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":111,"_94":112,"_96":113,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":108,"_94":109,"_96":110,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,"_92":105,"_94":106,"_96":107,"_98":-5,"_99":-5,"_100":-5,"_101":-5},{"_90":91,