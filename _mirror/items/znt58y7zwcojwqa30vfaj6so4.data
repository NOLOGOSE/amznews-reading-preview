[{"_1":2,"_3":4},"root",{"_5":97},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":-5,"_30":31,"_32":26,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":-5,"_42":44,"_45":46,"_47":-5,"_48":-5,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":40,"_62":40,"_63":-5,"_64":65,"_66":67},"id","znt58y7zwcojwqa30vfaj6so4","revision",2,"title","亚马逊推出新工具与服务助力卖家从第一天起实现全球销售","originalTitle","Amazon announces new tools and services to help sellers go global from day one","summary","亚马逊宣布推出一系列新功能和工具，帮助卖家简化跨国销售流程，包括统一的扩展机会视图、自动本地化列表以及端到端供应链可见性。在合规方面，亚马逊引入“一次提交，多国认证”机制，试点卖家报告称合规成本最高节省60%，该功能目前从玩具类目开始逐步扩展。","reason","亚马逊官方发布多项全球销售新功能，涵盖统一视图、一次测试多国认证及全球仓储配送，旨在降低卖家出海门槛。","source",{"_9":90,"_91":92,"_93":94,"_95":40,"_96":-5},"links",{"_87":88,"_67":89},"publishedAt","2026-09-24T21:28:46.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-16T18:20:07.482Z","timelineAt","category","policy","tags",[81,82,83,84,85,86],"score",60,"selected",true,"channel","x","story",{"_72":73,"_74":52,"_75":76,"_77":78,"_79":-5,"_45":80},"media",[],"byline","detailedGuide","readingMode","full","author","amazonnews","language","zxx","body",{"_68":-5,"_67":69,"_70":-5,"_71":40},"outline",[],"relatedStories",[],"indexable","markdownAvailable","group","hasTranslation",false,"bodyLanguage","original","zh","<p>https://x.com/i/article/2103228981067526144</p>","zhKind","complete","authorName","Amazon News","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"AI/工具","亚马逊","FBA/物流","卖家工具","合规税务","供应链","aihot","/items/znt58y7zwcojwqa30vfaj6so4","https://x.com/amazonnews/status/2103235214705082416","x-amazon-news","name","X · Amazon News","kind","x_search","firstParty","iconUrl",{"_98":99},"changelogVersion","2026-10-09T22:08"]
