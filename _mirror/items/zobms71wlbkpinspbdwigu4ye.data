[{"_1":2,"_3":4},"root",{"_5":92},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_41":43,"_44":45,"_46":-5,"_47":-5,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":39,"_61":62,"_63":-5,"_64":39,"_65":66},"id","zobms71wlbkpinspbdwigu4ye","revision",1,"title","电商高价教训：2.25万与封号","originalTitle","The most expensive lesson I ever learned in e-commerce cost me $22,500 and a complete group ban.","summary","我在电商领域学到的最昂贵的一课，让我损失了 $22,500 并导致整个群组被封禁。\n\n2018年，我想从零售和线上套利扩展到批发业务。我支付了 $10,000 加入一个群组，该群组承诺通过其零售店提供独家品牌分销商的准入权限。\n\n回顾过去，我简直不敢相信我当时加入了这个群组，但在这个过程中我学到了很多。","reason","source",{"_9":85,"_86":87,"_88":89,"_90":39,"_91":-5},"links",{"_82":83,"_66":84},"publishedAt","2026-10-08T15:00:10.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-17T16:14:18.204Z","timelineAt","category","advertising","tags",[80,81],"score",12,"selected",false,"channel","x","story",{"_71":72,"_73":51,"_74":75,"_76":77,"_78":-5,"_44":79},"media",[],"byline","detailedGuide","readingMode","full","author","askjimmysmith","language","en","body",{"_67":-5,"_66":68,"_69":-5,"_70":62},"outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","zh","<p>The most expensive lesson I ever learned in e-commerce cost me $22,500 and a complete group ban.</p><p>I wanted to scale beyond retail and online arbitrage into wholesale back in 2018. I paid $10,000 to join a group promising access to exclusive brand distributors through their retail store.</p><p>Looking back, I can't believe I joined this but I learned a lot in the process.</p>","zhKind","complete","authorName","Jimmy Smith","handle","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w","quoted",[],"广告/运营","亚马逊","aihot","/items/zobms71wlbkpinspbdwigu4ye","https://x.com/askjimmysmith/status/2108210852650180836","x-jimmy-smith","name","X · Jimmy Smith","kind","x_search","firstParty","iconUrl",{"_93":94},"changelogVersion","2026-10-09T22:08"]
