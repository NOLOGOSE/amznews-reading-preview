[{"_1":2,"_3":4},"root",{"_5":99},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":25,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":-5,"_54":-5,"_55":56,"_57":58,"_59":39,"_60":61,"_62":-5,"_63":39,"_64":65},"id","zop2bwv02k5411gv6u0km8z9x","revision",4,"title","亚马逊卖家必须关注的关键 KPI 指标概览","originalTitle","The most important Amazon KPIs at a glance: These metrics sellers must definitely consider!","summary","文章梳理了亚马逊卖家需重点监控的绩效指标，涵盖卖家表现与广告效率。核心数据包括：负面反馈率、取消率及配送延迟率需分别低于 1%、2.5% 和 4%，追踪号有效率须达 95% 以上，客服响应时间应控制在 24 小时内。此外，卖家还需通过 ACoS（广告销售成本比）优化广告投放，以维持 Buy Box 资格并避免账号受限风险。","reason","source",{"_9":90,"_91":92,"_69":93,"_94":39,"_95":96,"_97":98},"links",{"_87":88,"_65":89},"publishedAt","2025-06-15T09:03:22.000Z","publishedPrecision","unknown","calendarDate","discoveredAt","2026-10-09T14:14:57.200Z","timelineAt","category","advertising","tags",[83,84,85,86],"score",25,"selected",false,"channel","news","story","x","media",[68],"byline",{"_51":52,"_66":67},"detailedGuide","readingMode","full","author","Robin Bals","language","body","outline",[],"relatedStories",[],"indexable","markdownAvailable",true,"group","hasTranslation","bodyLanguage","original","platform","SELLERLOGIC",{"_69":70,"_71":72,"_73":74,"_75":76,"_77":78,"_79":80,"_81":-5,"_82":-5},"kind","image","url","/amznews-reading-preview/_img/078d357ac7dd5a6c.webp","fullUrl","/amznews-reading-preview/_img/078d357ac7dd5a6c.webp","srcSet","/amznews-reading-preview/_img/078d357ac7dd5a6c.webp 336w, /amznews-reading-preview/_img/078d357ac7dd5a6c.webp 720w","width",844,"height",443,"alt","poster","广告/运营","Listing优化","关键词","亚马逊","aihot","/items/zop2bwv02k5411gv6u0km8z9x","https://www.sellerlogic.com/en/blog/amazon-kpi/","author-sellerlogic-robin-bals-rolling","name","SELLERLOGIC · Robin Bals","web_list","firstParty","iconUrl","/amznews-reading-preview/_