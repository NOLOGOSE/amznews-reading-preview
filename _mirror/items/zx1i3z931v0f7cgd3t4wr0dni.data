[{"_1":2,"_3":4},"root",{"_5":113},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":32,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":-5,"_47":48,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":-5,"_57":-5,"_58":59,"_60":61,"_62":41,"_63":41,"_64":65,"_66":67,"_68":69},"id","zx1i3z931v0f7cgd3t4wr0dni","revision",2,"title","亚马逊宣布 11 月起欧洲站物流附加费上调至 2%","originalTitle","11月起，亚马逊欧洲站物流附加费将上调至2%","summary","亚马逊宣布将欧洲多个市场的燃油及物流附加费从 1.5% 上调至 2%，FBA 订单自 11 月 2 日起生效，MCF 业务自 11 月 19 日起覆盖。新费率按配送费用计算，预计使欧洲站 FBA 卖家每件商品平均增加约 0.02 欧元成本，英国站约为 0.02 英镑。亚马逊已更新 Seller Central 中的多项经营工具以纳入新费用，并强调该附加费将根据后续市场情况持续评估。","reason","原文给出了欧洲站物流附加费上调的生效日期、适用市场及平均成本增幅，卖家可据此核算利润。","source",{"_9":104,"_105":106,"_86":107,"_108":67,"_109":110,"_111":112},"links",{"_101":102,"_69":103},"publishedAt","2026-10-20T00:00:00.000Z","publishedPrecision","calendar","calendarDate","2026-10-20","discoveredAt","2026-10-20T02:37:38.073Z","timelineAt","category","policy","tags",[98,99,100],"score",72,"selected",true,"channel","news","story",{"_78":79,"_13":80},"x","media",[85],"byline",{"_54":82,"_83":84},"detailedGuide","readingMode","full","author","Summer/AMZ123","language","body","outline",[],"relatedStories",[81],"indexable","markdownAvailable","group",{"_70":71,"_44":72,"_73":74,"_75":12,"_76":77},"hasTranslation",false,"bodyLanguage","original","factId","fc5buGKM2v34",{"_78":79,"_13":80},"reportCount",3,"additionalSourceCount","developmentCount",0,"publicId","bc6e2a21-a35f-4fb5-bd3e-84734e57c3d2","亚马逊欧洲站燃油及物流附加费上调至2%",{"_78":79,"_13":80},"Summer","platform","AMZ123",{"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":-5,"_96":-5,"_97":-5},"kind","image","url","/amznews-reading-preview/_img/5303ec716f4c025e.webp","fullUrl","/amznews-reading-preview/_img/5303ec716f4c025e.webp","srcSet","/amznews-reading-preview/_img/5303ec716f4c025e.webp 336w, /amznews-reading-preview/_img/5303ec716f4c025e.webp 72