[{"_1":2,"_3":4},"root",{"_5":98},"routes/item",{"_5":6},"data",{"_7":8},"item",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":-5,"_20":21,"_22":23,"_24":25,"_26":27,"_28":-5,"_29":30,"_31":30,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":-5,"_45":46,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":-5,"_55":-5,"_56":57,"_58":59,"_60":39,"_61":62,"_63":64,"_65":39,"_66":67},"id","zzu42oddr28krt0cd8s224jxl","revision",2,"title","进口关税如何影响亚马逊PPC ACoS目标及应对方法","originalTitle","Import Duties and Your Amazon PPC ACoS Target: The Margin Math Most Sellers Skip","summary","My Amazon Guy 指出进口关税会推高落地成本并压缩利润空间，导致基于旧成本的 PPC 竞价侵蚀利润率。文章提出通过重建含关税的落地 COGS、按 ASIN 重新计算盈亏平衡 ACoS 和调整最高 CPC 来保护利润，并以 $30 商品为例展示 25% 关税使盈亏平衡 ACoS 从 38.3% 降至 34.2%，建议卖家据此下调竞价或通过提升转化率找回预算空间。","reason","source",{"_9":88,"_89":90,"_91":92,"_93":39,"_94":95,"_96":97},"links",{"_85":86,"_67":87},"publishedAt","2026-10-21T01:21:00.000Z","publishedPrecision","timestamp","calendarDate","discoveredAt","2026-10-22T10:32:29.920Z","timelineAt","category","advertising","tags",[82,83,84],"score",58,"selected",false,"channel","news","story",{"_76":77,"_13":78},"x","media",[],"byline",{"_52":53,"_80":81},"detailedGuide","readingMode","full","author","Ken Zhou","language","body","outline",[],"relatedStories",[79],"indexable","markdownAvailable",true,"group",{"_68":69,"_42":70,"_71":72,"_73":74,"_75":74},"hasTranslation","bodyLanguage","original","factId","fe9AmcMw2RHE",{"_76":77,"_13":78},"reportCount",1,"additionalSourceCount",0,"developmentCount","publicId","3f71e8e6-5459-4cbc-8a35-6d56698846e4","进口关税如何影响亚马逊PPC的ACoS目标",{"_76":77,"_13":78},"platform","My Amazon Guy","广告/运营","亚马逊","Amazon Ads","aihot","/items/zzu42oddr28krt0cd8s224jxl","https://myamazonguy.com/advertising/import-duties-and-your-amazon-ppc-acos-target/","author-myamazonguy-ken-zhou-rolling","name","My Amazon Guy · Ken Zhou","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/2367a94bae94b1de.webp","iconSrcSet","/amznews-reading-pre