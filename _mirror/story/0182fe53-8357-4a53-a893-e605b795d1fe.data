[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","0182fe53-8357-4a53-a893-e605b795d1fe","title","2026年亚马逊PPC基准数据：类目差异与盈亏平衡","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-14T00:00:00.000Z","latestAt","digest","2026年10月14日，SellerForge创始人David Gallo发布文章，汇总Ad Badger、Autron、Triple Whale及SellerPlex四组2026年数据集，指出亚马逊Sponsored Products全平台平均ACoS约30–35%、平均CPC 1.10–1.22美元、转化率10–11%、点击率约0.56%，健康成熟品牌TACoS为10–15%。但各类目中位数在数据源之间分歧明显：Toys & Games等类目ACoS差距仅2个百分点，Clothing & Apparel则相差27个百分点。文章建议先用“三源差距测试”判断基准可信度，再以自身盈亏平衡ACoS（即广告前利润率）设定目标，而非套用类目均值。文中披露作者推广自家工具SellerForge（49美元/月起），并称其不销售基准数据集。","digestUpdatedAt","2026-10-17T10:41:37.211Z","summary","excerpt","latest","作者汇总四组2026数据：平台均值稳定，但类目ACoS分歧最高达27个百分点。","whyHot",{"_73":74,"_75":74,"_76":74,"_77":78,"_79":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","v9bpyn6r83gqb8ks6e0ai767t","2026年亚马逊PPC分类基准数据：ACoS、CPC与转化率差异分析","David Gallo 汇总 Ad Badger、Autron 等四组 2026 数据集，指出 Sponsored Products 平均 ACoS 为 30–35%、CPC $1.10–$1.22，但不同来源的类目中位数最大相差 27 个百分点。作者建议依据自身盈亏平衡点设定目标，并推广其工具 SellerForge（$49/月起）以对比 ASIN 数据，原文带有商业利益披露。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-14","originalUrl","https://www.sellerforge.ai/blog/amazon-ppc-benchmarks-by-category","selected",false,"factId","fe2XpWYTBWMs","author-sellerforge-david-gallo-rolling","name","SellerForge · David Gallo","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0819b3e6c0704749.webp",{"_57":58,"_11":68,"_69":-5,"_18":19,"_15":16,"_70":71},"2026年亚马逊PPC基准数据汇总与差异分析","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":72,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_81":82},"changelogVersion","2026-10-09T22:08"]
