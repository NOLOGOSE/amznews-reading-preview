[{"_1":2,"_3":4},"root",{"_5":77},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","02050f05-4d22-46ab-886f-bb0cd25a2d82","title","亚马逊搜索结果首页广告位挤占自然位","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T17:04:05.000Z","latestAt","digest","2026年10月15日，亚马逊卖家顾问 Dan Boufford 在 X 上指出，目前在亚马逊搜索几乎任何内容，第一行全是广告，在第一个自然结果出现之前有 5 个赞助位。他称大多数购物者不会翻过第一页的前半部分，未投放 PPC 的品牌在大多数搜索中起始位置都在首屏以下。该说法来自卖家顾问的个人观察，报道未提供具体搜索样本、统计范围或亚马逊方面的回应。目前进展限于这一观察本身。","digestUpdatedAt","2026-10-17T16:15:50.677Z","summary","excerpt","latest","卖家顾问称亚马逊搜索首行全为广告，首个自然结果前有5个赞助位。","whyHot",{"_70":71,"_72":71,"_73":71,"_74":75,"_76":-5,"_37":-5},"developments",[65],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","epc21wxlizkla89cy8g1mmfk2","亚马逊首页广告挤占自然位","现在在亚马逊搜索几乎任何内容，第一行全是广告。在第一个自然结果出现之前有 5 个赞助位。\n\n大多数购物者不会翻过第一页的前半部分。\n\n未投放 PPC 的品牌在大多数搜索中起始位置都在首屏以下。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":-5},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://x.com/1000asins/status/2110778751717879947","selected",false,"factId","fHlxgryIh2mo","x-dan-boufford","name","X · Dan Boufford","kind","x_search","firstParty","iconUrl",{"_56":57,"_11":44,"_66":-5,"_18":19,"_15":16,"_67":68},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":69,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":-5},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_78":79},"changelogVersion","2026-10-09T22:08"]
