[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","0269e973-8754-4c67-abdc-5135a32df005","title","卖家因外部比价丢失购物车申诉被拒","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-05T16:00:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_77":43,"_78":59},"latest","whyHot",{"_70":71,"_72":71,"_73":71,"_74":75,"_76":-5,"_35":-5},"developments",[65],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},"id","gjm4najj7f6saw921v7kxxu2j","亚马逊英国站卖家因外部比价丢失购物车，询问 TEMU 低价竞品溯源及申诉方案","亚马逊英国站卖家称其 ASIN 受外部比价影响，购物车丢失、价格受限，后台申诉被拒；该卖家发现 TEMU 有多款外观相似的低价产品，但未找到与自身竞争价一致的确切比价链接，账号无付费经理协助，正考虑自建独立站链接、品牌证书及带建议零售价的产品包装图片用于申诉，并询问是否必须找到外部比价源链接及其他解决方案。","source",{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-06","originalUrl","https://www.wearesellers.com/question/125137","selected",false,"factId","fQum1gUnziNw","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_55":56,"_11":12,"_66":-5,"_18":19,"_15":16,"_67":68},"occurredAt","representative",{"_40":41,"_11":42,"_23":43,"_44":69,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_80":81},"changelogVersion","2026-10-09T22:08"]
