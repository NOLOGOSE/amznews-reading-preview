[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","0301d5c9-268e-40b4-97d2-99705bbd6e9a","title","亚马逊入库配置费与拆分发货成本对比","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-09-30T14:40:32.000Z","latestAt","digest","围绕亚马逊入库配置费与拆分发货的成本取舍，目前可确认的进展来自 Seller Labs 于 2026-09-30 给出的一套对比算法：把入库配置费与拆分到多地的额外运费放在一起比较，其中额外运费等于优化拆分运费减最小拆分运费，配置费等于件数乘每件费率；若配置费高于额外运费就选择拆分，低于则付费。报道未给出具体费率、件数或运费数值，也未提及亚马逊方面的规则变动或卖家实际执行结果。","digestUpdatedAt","2026-10-01T18:13:20.357Z","summary","excerpt","latest","Seller Labs 给出配置费与拆分额外运费的对比算法，供卖家判断拆分还是付费。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","z6gasb404d1a32y5git4veyb3","该付入库配置费还是拆分货件？亚马逊Q4发货成本对比","Seller Labs 给出亚马逊入库配置费与拆分货件运费的对比方法：若配置费高于额外运费就拆分，反之付费，并附每单位盈亏平衡点算法。以 2400 件 6 托为例，最小拆分总成本 1620 美元，亚马逊优化拆分 1440 美元，拆分省 180 美元，盈亏平衡点为每件 0.225 美元；1200 件 5 托的小货件则相反，付费反而省 240 美元。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","unknown","calendarDate","originalUrl","https://www.sellerlabs.com/blog/amazon-inbound-placement-fee-split-shipment/","selected",false,"factId","fe4qvT3ZTZ6U","rss-sellerlabs-prelaunch","name","Seller Labs","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp",{"_56":57,"_11":12,"_67":68,"_18":19,"_15":16,"_69":70},"occurredAt","2026-01-14T16:00:00.000Z","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
