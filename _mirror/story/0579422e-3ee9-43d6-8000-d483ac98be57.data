[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","0579422e-3ee9-43d6-8000-d483ac98be57","title","亚马逊广告预算转向视频与DSP，冒充攻击激增","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T00:00:00.000Z","latestAt","digest","2026年10月15日报道称，亚马逊广告支出正从 Sponsored Products 转向 Amazon DSP、Prime Video、Fire TV 及体育直播等上游渠道。媒体买家向 Digiday 表示，Prime Big Deal Days（10月6—7日）前客户在亚马逊广告上的支出较去年同期高出15%—40%，全年增幅可能接近三分之一；亚马逊自身第二季度广告收入同比增长26%至198亿美元。代理机构 Tinuiti 预计今年亚马逊总支出增长约15%，其中 DSP 支出增长25%—30%；PMG 估计平均折扣力度从28%降至24%。同期，KnowBe4 数据显示8月底至9月亚马逊冒充攻击激增188%，Check Point Research 发现新注册的亚马逊及 Prime Day 主题域名从7月的905个增至9月的1284个，约十六分之一被标记为恶意或可疑。","digestUpdatedAt","2026-10-17T10:37:54.301Z","summary","excerpt","latest","报道称亚马逊广告支出转向DSP与视频，Prime Big Deal Days前冒充攻击激增188%。","whyHot",{"_73":74,"_75":74,"_76":74,"_77":78,"_79":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","bf35yn9klnhgro6vvsxkh6y35","亚马逊广告预算向视频与DSP转移，TikTok自动化广告投放","媒体买家称亚马逊广告支出正从 Sponsored Products 转向 Amazon DSP、Prime Video 等上游渠道，Q2 广告收入同比增 26%。TikTok 推出 Smart+ 和 GMV Max 实现广告端全自动化，但保留人工购买确认。KnowBe4 数据显示 Prime Big Deal Days 前亚马逊冒充攻击激增 188%，卖家需警惕客户信任风险。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-15","originalUrl","https://sellerbites.com/amazons-ad-dollars-are-quietly-moving-away-from-sponsored-products/","selected",false,"factId","f5x9qVCyikEA","publisher-sellerbites-newsletter-rolling","name","SellerBites 亚马逊卖家周报","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/a41184568d996aef.webp",{"_57":58,"_11":68,"_69":-5,"_18":19,"_15":16,"_70":71},"亚马逊广告预算向视频和DSP转移","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":72,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_81":82},"changelogVersion","2026-10-09T22:08"]
