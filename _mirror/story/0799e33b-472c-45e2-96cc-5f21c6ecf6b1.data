[{"_1":2,"_3":4},"root",{"_5":83},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","0799e33b-472c-45e2-96cc-5f21c6ecf6b1","title","Loving Thyself Rocks 召回约600个水晶玻璃杯","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T00:00:00.000Z","latestAt","digest","2026年10月15日，美国消费品安全委员会（CPSC）公布，佛罗里达州 Winter Park 的 Loving Thyself Rocks LLC 召回约600个内含松散水晶碎片的双层水晶玻璃杯（召回编号27-026）。该产品在两层玻璃之间夹有水晶碎石，既作装饰也可饮用，尺寸约3.5×3英寸，涉及紫水晶、黑曜石、粉晶等多种碎石款式。CPSC 称，杯子在使用中玻璃可能破裂，存在严重割伤和误食风险。企业已收到一起饮用时杯内玻璃破裂的报告，尚无人员受伤报告。产品于2026年4月至9月在该公司门店、Instagram 及 Etsy 销售，售价20至50美元，产地为中国。补救措施为全额退款：消费者应立即停用，在官网登记，提交用黑色永久记号笔在杯身正面写有“RECALL”字样的照片，并确认已按公司网站说明妥善处置。","digestUpdatedAt","2026-10-17T10:38:25.606Z","summary","excerpt","latest","CPSC 公布 Loving Thyself Rocks 召回约600个可能破裂的水晶玻璃杯，提供全额退款。","whyHot",{"_77":78,"_79":78,"_80":78,"_81":65,"_82":-5,"_37":-5},"developments",[70],"officialReports",[68],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","g2i7mcmlft7recofz9me98xvt","Loving Thyself Rocks 召回水晶玻璃杯，因存在割伤和误食风险","Loving Thyself Rocks LLC 于 2026 年 10 月 15 日召回约 600 个内含松散水晶碎片的双层玻璃杯，原因是使用中玻璃可能破裂导致严重割伤或误食风险。","source",{"_42":59,"_60":61,"_62":63,"_64":65,"_66":67},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-15","originalUrl","https://cpsc.gov/Recalls/2027/Loving-Thyself-Rocks-Recalls-Crystal-Glass-Cups-Due-to-Risk-of-Serious-Injury-from-Ingestion-and-Laceration-Hazards","selected",false,"factId","fhVFNiaJtcew","official-cpsc-amazon-recalls-reviewed","name","CPSC 美国消费品安全委员会","kind","json_list","firstParty",true,"iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp",{"_42":43,"_11":44,"_25":45,"_46":69,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":65,"_66":67},{"_57":58,"_11":71,"_72":73,"_18":19,"_15":16,"_74":75},"Loving Thyself Rocks召回水晶玻璃杯","occurredAt","2026-10-14T16:00:00.000Z","representative",{"_42":43,"_11":44,"_25":45,"_46":76,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":65,"_66":67},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_84":85},"changelogVersion","2026-10-09T22:08"]
