[{"_1":2,"_3":4},"root",{"_5":77},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","0ac3d18c-965d-45bf-81fe-ae83ab3dc0ba","title","SellerApp发布用AMC评估DSP广告效果指南","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-03T11:30:00.000Z","latestAt","digest","2026年10月3日，SellerApp的Dilip发布指南，介绍如何用Amazon Marketing Cloud（AMC）评估Amazon DSP广告活动表现。文章称，AMC可帮助广告主在Amazon DSP的归因指标之外，分析客户旅程、跨渠道互动、受众重叠和新客获取。文中引用SellerApp 2026年亚马逊广告基准报告数据：平台整体CPM同比上涨47.46%至$7.82，CPA下降5.65%，转化率提升至11.02%，ROAS升至3.14x。目前事件进展即为该指南的发布及其引用的上述基准数据。","digestUpdatedAt","2026-10-03T11:42:17.341Z","summary","excerpt","latest","SellerApp发布指南，介绍用AMC评估Amazon DSP广告活动表现。","whyHot",{"_70":71,"_72":71,"_73":71,"_74":75,"_76":-5,"_37":-5},"developments",[65],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","wwngaq736hwoy6czg92d01z0y","如何利用 Amazon Marketing Cloud 评估 Amazon DSP 广告活动表现","SellerApp 指南介绍利用 Amazon Marketing Cloud (AMC) 突破原生 DSP 报告局限，通过跨渠道客户旅程分析优化投放。其《2026 亚马逊广告基准报告》显示平台 CPM 同比涨 47.46% 至 $7.82，但 ROAS 升至 3.14x，强调需结合 AMC 洞察而非仅看归因指标。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":-5},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.sellerapp.com/blog/how-to-evaluate-amazon-dsp-campaign-performance-using-amazon-marketing-cloud/","selected",false,"factId","fzOgrvPaDzc4","author-sellerapp-usersp","name","sellerapp · Dilip","kind","rss","firstParty","iconUrl",{"_56":57,"_11":12,"_66":-5,"_18":19,"_15":16,"_67":68},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":69,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":-5},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_78":79},"changelogVersion","2026-10-09T22:08"]
