[{"_1":2,"_3":4},"root",{"_5":85},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":20,"_22":-5,"_23":-5,"_24":-5,"_25":26,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39},"publicId","0d85db36-2072-443b-a7fb-48009bb4bb27","title","2026年10月亚马逊游戏畅销榜配件占比高","status","settled","reportCount",2,"sourceCount",1,"firstReportAt","2026-10-13T11:40:25.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_83":68,"_84":60},"latest","whyHot",{"_76":77,"_78":77,"_79":77,"_80":81,"_82":-5,"_36":-5},"developments",[71],"officialReports",[],"timeline",[40,41],"heat",[],"related",[],{"_42":66,"_11":67,"_24":68,"_46":69,"_48":20,"_49":50,"_51":-5,"_52":70,"_54":55,"_56":57},{"_42":43,"_11":44,"_24":45,"_46":47,"_48":20,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","vc02osiw2jk3plg5z0xdaujhn","亚马逊 Video Games 畅销榜分析：独立品牌配件占据前30名中11席","2026年10月13日数据显示，亚马逊 Video Games 畅销榜前30名中，11席由 Logitech、Razer 等独立品牌配件占据，7席为数字礼品卡。ESA 报告指出配件仅占美国游戏消费约5%且同比下滑7%，但仍是第三方卖家可切入的主要领域。卖家应关注平台子榜单排名，并优先选择无需主机厂商授权的通用配件以规避合规风险。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://sellerplex.com/amazon-best-sellers-video-games-what-the-list-tells-sellers/","selected",false,"factId","fTUKJJmXdcN8","publisher-sellerplex-written-rolling","name","SellerPlex 亚马逊运营文章","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/a40a0a5b8e7f6e9d.webp","hz5fphqhm2wzj631ctd7sccax","亚马逊 Video Games 畅销榜分析：独立品牌配件占前30名11席","2026年10月13日数据显示，亚马逊 Video Games 畅销榜前30名中，11个席位由 Logitech、Razer 等独立品牌配件占据，其余多为平台方数字代码及主机。ESA 报告指出配件支出仅占游戏总消费约5%且同比下降7%，卖家应聚焦无需授权的通用硬件周边，并参考子类目排名以规避礼品卡波动干扰。",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"https://sellerplex.com/amazon-best-sellers-video-games-what-the-list-tells-sellers-3/",{"_56":57,"_11":12,"_72":-5,"_19":20,"_15":16,"_73":74},"occurredAt","representative",{"_42":66,"_11":67,"_24":68,"_46":75,"_48":20,"_49":