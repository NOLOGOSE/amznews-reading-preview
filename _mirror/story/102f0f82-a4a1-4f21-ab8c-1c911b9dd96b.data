[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","102f0f82-a4a1-4f21-ab8c-1c911b9dd96b","title","卖家紫鸟设Passkey触发亚马逊ATO封禁","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-11T01:33:37.771Z","latestAt","digest","2026年10月11日，有卖家在知无不言发帖称，因公司主体变更，其在紫鸟浏览器中更新法人信息、删除旧手机号并启用Passkey后，被亚马逊判定为高危环境（VPS）恶意篡改资料，触发ATO最高级别封锁。该卖家称，系统随后强制回滚，删除新手机号与Passkey，将验证手机号恢复为半年前已注销的旧主体手机号，导致前端登录收不到验证码。其邮件申诉陷入模板循环，一级客服无权限处理；后经亚马逊高管团队高级客服介入，称已抹除旧手机号、更新登录邮箱并禁用两步验证，但前端Cognito登录服务器未同步，页面仍提示“找不到具有该电子邮件地址的账户”，申诉再度被ATO团队按模板流程处理。帖子称账号仍无法登录，并提醒避免在VPS或紫鸟环境中短时间内修改底层安全信息。","digestUpdatedAt","2026-10-17T10:52:37.296Z","summary","excerpt","latest","卖家称高管客服已改后台数据，但前端未同步，账号仍显示找不到账户。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","puy4voha1wvwpejfogddbhste","卖家在紫鸟浏览器设置 Passkey 触发亚马逊 ATO 封禁，因前后端同步 Bug 导致账号无法登录","卖家在紫鸟浏览器更新法人信息并启用 Passkey 后，被亚马逊判定为高危环境操作触发 ATO 最高级别封锁，系统强制回滚至已注销的旧手机号。尽管高级客服在后端完成数据修正，但前端 Cognito 登录服务器未同步，导致账号显示“找不到账户”且申诉陷入循环。作者警示在 VPS 或紫鸟环境中短时间内修改底层安全信息极易引发此类风控死锁与系统同步故障。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-11","originalUrl","https://www.wearesellers.com/question/125278","selected",false,"factId","fsrH2Pqdl5qk","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_57":58,"_11":44,"_68":-5,"_18":19,"_15":16,"_69":70},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
