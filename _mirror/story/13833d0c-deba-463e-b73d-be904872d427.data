0.000Z",9.2,"2026-10-22T06:00:00.000Z",9.4,{"_180":181,"_11":182,"_25":183,"_184":185,"_186":19,"_187":188,"_189":-5,"_190":191,"_192":193,"_194":195},"id","jcem29w53t30yzjcckk2ks3im","美国海关 CBP 延长邮政包裹正式报关合规期限","美国海关与边境保护局（CBP）宣布延长针对国际邮政网络入境商品的正式报关合规日期，该规定原于 2026 年 6 月 24 日发布。此次延期旨在给公众更多时间准备合规，涉及受合作伙伴政府机构要求、需缴纳关税或申请免税待遇的商品。同时，CBP 指出在延迟合规窗口结束时，申报人可选择进行正式报关，或参与针对价值不超过 $2,500 合格货物的 Entry Type 13 自愿电子邮件流程测试。","source",{"_180":196,"_197":198,"_199":200,"_201":193,"_202":203},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.federalregister.gov/documents/2026/10/22/2026-21600/indefinite-suspension-of-the-de-minimis-exemption-for-mail-shipments-and-new-postal-informal-entry","selected",true,"factId","fP9zQPcqdVf4","official-us-cbp-federal-register","name","美国海关 CBP · 联邦公报公告","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/fb25db0934701e45.webp",{"_180":181,"_11":182,"_25":183,"_184":205,"_186":19,"_187":188,"_189":-5,"_190":191,"_192":193,"_194":195},{"_180":196,"_197":198,"_199":200,"_201":193,"_202":203},{"_194":195,"_11":12,"_207":-5,"_18":19,"_15":16,"_208":209},"occurredAt","representative",{"_180":181,"_11":182,"_25":183,"_184":210,"_186":19,"_187":188,"_189":-5,"_190":191,"_192":193,"_194":195},{"_180":196,"_197":198,"_199":200,"_201":193,"_202":203},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_218":219},"changelogVersion","2026-10-09T22:08"]
