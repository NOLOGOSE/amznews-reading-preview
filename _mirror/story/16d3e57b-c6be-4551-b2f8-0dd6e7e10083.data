[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","16d3e57b-c6be-4551-b2f8-0dd6e7e10083","title","客服从业者主张AI只用于准备环节","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-05T13:30:00.000Z","latestAt","digest","2026年10月5日，Seller Labs刊出客服从业者Nhan Dinh的经验文章。他记录了一场面向一家战术装备制造商的AI培训会，会上有员工表示客户常因能接通真人而给出五星好评，真人接电话是该公司的卖点。作者随后介绍自己的做法：把AI接入邮箱，在回复前检索历史对话并起草回复，每份草稿都由人阅读后再发出，强调AI只用于准备、不直接与客户对话。文中还转述了Gartner的调查数据和分析师Eric Keller的言论，但这些数字与引语未提供可独立核验的出处，本稿不将其作为可核验事实采用。","digestUpdatedAt","2026-10-08T01:34:00.509Z","summary","excerpt","latest","作者发文主张AI只用于回复前的准备，不直接与客户对话。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","l8l6ejwuf0z6960r9z8fu2112","卖家客服中 AI 应置于人工背后而非替代对话","原文作者主张在客服场景中，AI 仅用于检索历史、起草回复及润色措辞，严禁直接面向客户对话，以确保人工始终掌控沟通。Gartner 2024 年调查显示 64% 客户偏好无 AI 服务，而 2026 年数据指出 87% 认为保留人工通道至关重要。实现该模式需通过 MCP 连接邮件等系统，使 AI 能读取完整上下文辅助人工决策。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.sellerlabs.com/blog/customer-service-ai-that-keeps-the-human-on-the-phone/","selected",false,"factId","fWDQ-1hNRRv0","rss-sellerlabs-prelaunch","name","Seller Labs","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp",{"_56":57,"_11":67,"_68":-5,"_18":19,"_15":16,"_69":70},"把 AI 放在准备环节，而非对话中：一位客服从业者的经验","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
