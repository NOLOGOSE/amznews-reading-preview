[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","17f1d29f-a148-4433-a4ad-1cd490f1e75a","title","前投行人陈紫阳创办ZendEsltenx在亚马逊卖牛仔裤","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T23:34:28.173Z","latestAt","digest","2026年10月13日报道，北大毕业后进入投行的陈紫阳与拥有金融背景的合伙人离开投行，来到广州创办服装品牌 ZendEsltenx，面向美国消费者销售牛仔裤。报道称2025年该品牌在亚马逊销售额突破200万美金。团队启动资金全部来自自有投入，2024年曾关注智能硬件、储能等方向，最终选择服装中的牛仔细分。经营上，团队用投行尽调习惯分析 BSR、搜索词、评论、价格带与竞品数据验证选品，并依托广州产业带，把退货反馈落到面料、打版与工艺上改进产品。报道举例称，一条销量不错的蓝色牛仔裤因退货原因出现“太宽松”，团队重新试穿并逐尺寸点排查，最终只调整腿部宽度，其余部分保持不变并继续观察退货率。团队称增长为持续稳步积累，新品先在可承受预算内试错。","digestUpdatedAt","2026-10-17T10:41:48.887Z","summary","excerpt","latest","报道称该品牌2025年在亚马逊销售额突破200万美金。","whyHot",{"_73":74,"_75":74,"_76":74,"_77":78,"_79":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","je12p3zxlu029uv3xhv6zrrg9","前投行精英陈紫阳创办 ZendEsltenx，靠数据尽调与广州产业带在亚马逊卖牛仔裤","前投行精英陈紫阳与合伙人创办服装品牌 ZendEsltenx，面向美国消费者销售牛仔裤，2025年该品牌在亚马逊销售额突破200万美金。团队利用投行尽调习惯分析 BSR、搜索词及评论等数据验证选品，并依托广州产业带将退货反馈快速转化为产品改进。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-14","originalUrl","https://www.wearesellers.com/question/125434","selected",false,"factId","fbvYa7iEm6JY","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_57":58,"_11":68,"_69":-5,"_18":19,"_15":16,"_70":71},"ZendEsltenx品牌2025年亚马逊销售额超200万美金","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":72,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_81":82},"changelogVersion","2026-10-09T22:08"]
