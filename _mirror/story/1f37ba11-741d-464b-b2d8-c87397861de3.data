[{"_1":2,"_3":4},"root",{"_5":83},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","1f37ba11-741d-464b-b2d8-c87397861de3","title","3M 召回约5.36万台 Scotch 热覆膜机","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T00:00:00.000Z","latestAt","digest","2026年10月15日，美国消费品安全委员会（CPSC）发布召回公告：3M Company 召回约 53,634 台 Scotch™ 热覆膜机，型号 TL1302Z。该产品可能过热，构成火灾风险。召回编号 27-024，产品由中国制造，由明尼苏达州圣保罗的 3M Company 进口。3M 已收到 63 起冒烟、熔化、过热报告，其中 5 起起火、1 起轻微财产损失，尚无人员受伤报告。产品于 2024 年 6 月至 2026 年 9 月在 Amazon.com 销售，售价 44 至 56 美元。补救措施为全额退款：消费者应立即停止使用并拔下插头，联系 3M，在线填写召回登记表、确认产品在召回范围内并上传已剪断电源线的照片，退款以支票形式寄出；产品应按当地电子回收法规处置。","digestUpdatedAt","2026-10-17T10:38:35.947Z","summary","excerpt","latest","CPSC 公告 3M 召回约 53,634 台 TL1302Z 热覆膜机，因过热火灾风险提供全额退款。","whyHot",{"_77":78,"_79":78,"_80":78,"_81":65,"_82":-5,"_37":-5},"developments",[70],"officialReports",[68],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","jt8nrzx9xb24mat4x6uprh5kt","3M 召回 Scotch™ 热覆膜机因火灾风险","3M Company 召回约 53,634 台 Scotch™ Thermal Laminators（型号 TL1302Z），因设备过热存在引发严重伤害或死亡的火灾风险。","source",{"_42":59,"_60":61,"_62":63,"_64":65,"_66":67},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-15","originalUrl","https://cpsc.gov/Recalls/2027/3M-Company-Recalls-ScotchTM-Thermal-Laminators-Due-to-Risk-of-Serious-Injury-or-Death-from-Fire-Hazard","selected",false,"factId","fxfL-71ivWRY","official-cpsc-amazon-recalls-reviewed","name","CPSC 美国消费品安全委员会","kind","json_list","firstParty",true,"iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp",{"_42":43,"_11":44,"_25":45,"_46":69,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":65,"_66":67},{"_57":58,"_11":71,"_72":73,"_18":19,"_15":16,"_74":75},"3M召回Scotch热覆膜机，曾在亚马逊销售","occurredAt","2026-10-14T16:00:00.000Z","representative",{"_42":43,"_11":44,"_25":45,"_46":76,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":65,"_66":67},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_84":85},"changelogVersion","2026-10-09T22:08"]
