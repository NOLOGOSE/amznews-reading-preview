[{"_1":2,"_3":4},"root",{"_5":81},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","22426b5d-1ca5-45cd-9d42-bd9318074dd4","title","英国OPSS通报亚马逊下架幼儿幽灵服装","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T17:01:13.000Z","latestAt","digest","2026年10月13日，英国产品安全与标准办公室（OPSS）发布产品安全报告（PSD通知编号2609-0106，由地方当局贸易标准部门通报），涉及通过亚马逊销售的一款名为“QhgPnt Toddler Ghost Costume”的幼儿幽灵服装（ASIN B0HBBWM2B8）。报告称，该产品标称适合幼儿使用，但随附的调节绳长度超过幼儿玩具允许标准，绳索可能缠绕儿童颈部，存在严重勒颈风险；包装用软塑料袋厚度低于最低允许值，构成窒息隐患；部分所需文件和标识缺失，产品不符合《2011年玩具安全法规》。纠正措施方面，该商品链接已由在线市场亚马逊下架；报告建议使用者立即停止使用并远离儿童，联系零售商或供应商更换或退款。目前进展为商品已下架，报告未提及进一步调查或处罚。","digestUpdatedAt","2026-10-17T10:44:33.117Z","summary","excerpt","latest","OPSS通报后，涉事商品链接已由亚马逊下架。","whyHot",{"_75":76,"_77":76,"_78":76,"_79":64,"_80":-5,"_37":-5},"developments",[69],"officialReports",[67],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","bedbslaejef7boyhouzsybo5j","亚马逊下架幼儿幽灵服装：因绳索超标存勒颈风险","亚马逊已下架一款名为“QhgPnt Toddler Ghost Costume”的幼儿幽灵服装（ASIN B0HBBWM2B8），因该产品附带的调节绳长度超过幼儿玩具允许标准，存在严重勒颈风险。此外，其包装塑料袋厚度低于最低要求，亦构成窒息隐患，且不符合《2011年玩具安全法规》。建议用户立即停止使用并联系零售商退款或更换。","source",{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-report-toddler-ghost-costume-sold-via-amazon-2609-0106","selected",false,"factId","fNKKRwygI8ko","official-uk-opss-rolling","name","UK OPSS 产品安全公告","kind","web_list","firstParty",true,"iconUrl","/amznews-reading-preview/_img/1fbf571bfada1bb0.webp",{"_42":43,"_11":44,"_25":45,"_46":68,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},{"_56":57,"_11":70,"_71":-5,"_18":19,"_15":16,"_72":73},"UK OPSS通报亚马逊下架违规幼儿幽灵服装","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":74,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_82":83},"changelogVersion","2026-10-09T22:08"]
