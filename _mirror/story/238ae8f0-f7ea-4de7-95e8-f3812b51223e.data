[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","238ae8f0-f7ea-4de7-95e8-f3812b51223e","title","亚马逊卖家数据MCP选型指南","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-09-28T16:00:00.000Z","latestAt","digest","2026年9月30日，一名AI+商业实践者卖家在知无不言发文，对比卖家精灵、Sif、Sorftime三家数据MCP的能力与适用场景，为亚马逊卖家提供选型参考。文中称：卖家精灵亚马逊站内数据最全面，含CVR转化率等字段；Sif在流量与广告数据上更专业，并封装业务解读；Sorftime覆盖亚马逊、Temu、TK、沃尔玛、Shopee、Reddit、1688等多平台，可交叉验证。文章另附提示词和教程。截至该报道，事件仅此一篇内容，尚无后续进展或其他来源的补充信息。","digestUpdatedAt","2026-09-30T14:53:32.192Z","summary","excerpt","latest","卖家对比卖家精灵、Sif、Sorftime三家数据MCP能力，给出选型参考。","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","w3w8c1ua5f9ajjxh0o3godf56","选品、广告、关键词数据从哪来？亚马逊卖家的数据 MCP 选型指南：卖家精灵、Sif、Sorftime 对比（附提示词和教程）","AI+商业实践者、一线跨境卖家 Bulus lan 分享了自己在业务环境中调用卖家精灵、Sif、Sorftime 三家数据 MCP 的个人使用体验，并整理了选品、关键词、买家需求分析等场景的提示词与 MCP 配置教程。原文来自该机构，存在相关商业利益，并非独立测评。文中对三家 MCP 的能力描述均为作者个人使用感受，未提供独立验证或可核验出处，不能作为选型或投放依据。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","unknown","calendarDate","originalUrl","https://www.wearesellers.com/question/125034","selected",false,"factId","f5Wqg8262Et8","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_56":57,"_11":12,"_67":-5,"_18":19,"_15":16,"_68":69},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":70,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"cha