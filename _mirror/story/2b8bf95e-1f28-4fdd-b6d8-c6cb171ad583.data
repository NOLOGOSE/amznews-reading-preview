[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","2b8bf95e-1f28-4fdd-b6d8-c6cb171ad583","title","中小跨境卖家采购无凭证与财税合规讨论","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-16T06:07:29.520Z","latestAt","digest","2026年10月16日，知无不言论坛有用户发帖讨论中小跨境卖家的财税合规问题。该用户自称主营Temu和亚马逊，反映国内向小工厂、散户采购时上游基本开不出进货凭证，货款长期走个人卡收款，担心平台流水、报关数据与银行流水交叉比对；同时账面销售额可观但利润薄，按常规方式做账核算工作量大、成本高。该用户提及综试区跨境零售出口所得税政策，称政策出台即考虑到跨境零售行业普遍难以取得进货凭证的痛点，符合条件的主体可按收入总额核算，无需精细核算账面利润，以减轻账务压力。原文为个人经验交流，未提供具体操作细节或官方验证依据；作者署名指向返税园区核定业务，存在相关商业利益，并非独立测评。","digestUpdatedAt","2026-10-17T10:30:45.164Z","summary","excerpt","latest","论坛用户发帖讨论采购无进货凭证与个人卡收款的财税合规应对，提及综试区所得税政策。","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","qfkofi09xvgmus4pghtm4uflp","中小跨境卖家应对采购无进货凭证及财税合规问题的讨论","知无不言论坛用户分享中小跨境卖家在采购无进货凭证、个人卡收款面临数据比对风险时的应对思路。该用户提及综试区跨境零售出口所得税政策，称符合条件主体可按收入总额核算以减轻账务压力。原文为个人经验交流，未提供具体操作细节或官方验证依据。作者署名指向返税园区核定业务，存在相关商业利益，并非独立测评。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.wearesellers.com/question/125510","selected",false,"factId","f7I9hknvXu28","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_56":57,"_11":44,"_67":-5,"_18":19,"_15":16,"_68":69},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":70,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersio