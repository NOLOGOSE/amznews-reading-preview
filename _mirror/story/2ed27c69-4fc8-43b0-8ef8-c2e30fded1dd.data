[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","2ed27c69-4fc8-43b0-8ef8-c2e30fded1dd","title","Acadia 发布 2026 Prime Big Deal Days 销售数据","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-14T18:16:57.000Z","latestAt","digest","2026 年 10 月 14 日，服务商 Acadia 公布其追踪的美国 Seller Central 品牌在 2026 年 Prime Big Deal Days（10 月 6 日至 7 日）的销售数据：整体销售额同比增长 32%，活动销售额达平日 3.5 倍（2025 年为 3.2 倍）；16 个类目组中 13 个实现同比增长，美妆个护增长 72%、服饰鞋包 63%、食品杂货 60%，运动户外下降 28%。Acadia 称第二天销售额为第一天的 95%，为两天表现最均衡的一次；广告 CPC 同比上升 15%、ROAS 下降 15%。该数据仅覆盖 Acadia 追踪的卖家样本，并非亚马逊官方数据。","digestUpdatedAt","2026-10-17T10:39:34.814Z","summary","excerpt","latest","Acadia 公布其追踪卖家在 2026 年 Prime Big Deal Days 的销售数据，整体同比增长 32%。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","z21eumn2xv25kcojtxtv0eik0","Acadia 发布 Prime Big Deal Days 2026 结果：美妆个护类目同比增长 72%","服务商 Acadia 公布其追踪的美国卖家在 2026 年 Prime Big Deal Days 的销售数据，整体销售额同比增长 32%，其中美妆个护、服饰鞋包和食品杂货分别增长 72%、63% 和 60%。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://acadia.io/prime-big-deal-days-2026-results","selected",false,"factId","fpmNzJagyYbI","acadia-retail-media-rolling","name","Acadia 亚马逊与零售媒体博客","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/bf0321f1fad93a43.webp",{"_56":57,"_11":67,"_68":-5,"_18":19,"_15":16,"_69":70},"Acadia发布2026年Prime大促数据报告","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","r