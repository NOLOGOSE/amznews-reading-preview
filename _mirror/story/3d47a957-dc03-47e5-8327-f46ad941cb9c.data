[{"_1":2,"_3":4},"root",{"_5":92},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":-5,"_28":-5,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42},"publicId","3d47a957-dc03-47e5-8327-f46ad941cb9c","title","卖家精灵MCP结合AI-Skill的亚马逊选品与竞品调研实操","status","settled","reportCount",2,"sourceCount",1,"firstReportAt","2026-10-08T19:25:00.000Z","latestAt","2026-10-12T17:30:00.000Z","digest","2026年10月8日，AMZ123作者Regan跨境发文，介绍用GitHub上liangdabiao公开的亚马逊研究Skill，结合卖家精灵MCP数据，对美国站假睫毛类目做选品分析：清洗100条商品样本（排除1条疑似胶水，留99条），交叉分析关键词与属性，锁定“自然短款DIY簇状睫毛”方向并建立8个竞品池，基于假设参数测算广告后单件贡献约2.37美元；因数据月份差异、成本未核实，结论为进入样品验证阶段而非立即采购。10月12日，同一作者再发文，将竞品调研流程固化为AI-Skill，用卖家精灵MCP对美国站ASIN B0GFD6L4YK（GTPLAYER气压升降移动桌）实操六步流程，采集日期为2026年10月11日、月度销量用2026年9月，展示筛选直接竞品、区分商品与页面差距、验证关键词相关性，并以假设参数测算广告后单件贡献为负，强调数据需结合成本与利润条件复核。两篇均为方法演示，未执行改版、投放或采购。","digestUpdatedAt","2026-10-17T10:48:49.498Z","summary","excerpt","latest","10月12日作者再发文，将竞品调研固化为AI-Skill并用真实ASIN实操演示。","whyHot",{"_85":86,"_87":86,"_88":86,"_89":90,"_91":-5,"_39":-5},"developments",[77,78],"officialReports",[],"timeline",[43,44],"heat",[],"related",[],{"_45":70,"_11":71,"_27":72,"_49":73,"_51":22,"_52":53,"_54":74,"_56":75,"_58":59,"_60":76},{"_45":46,"_11":47,"_27":48,"_49":50,"_51":20,"_52":53,"_54":55,"_56":57,"_58":59,"_60":61},"id","akr6t1cgnyxcaxfuakn4w8jq3","用GitHub上的Skill做亚马逊选品？美国站Lashes实操全流程","作者利用GitHub上liangdabiao发布的亚马逊研究Skill，结合卖家精灵MCP数据，对美国站假睫毛类目进行选品分析。流程涵盖清洗100条商品样本、交叉分析关键词与属性，最终锁定“自然短款DIY簇状睫毛”方向并建立竞品池。基于假设参数测算显示广告后单件贡献约2.37美元，但因数据月份差异及成本未核实，结论为进入样品验证阶段而非立即采购。","source",{"_45":62,"_63":64,"_65":66,"_67":59,"_68":69},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-09","originalUrl","https://www.amz123.com/t/xd90K0v9","selected",false,"factId","f8rgrYFBnsBQ","author-amz123-regan-reviewed","name","AMZ123 · Regan跨境","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","dkqgmrapy6vi65z767c414daz","卖家精灵MCP结合AI-Skill实操亚马逊竞品调研案例","作者分享将亚马逊竞品调研流程固化为AI-Skill的方法，并利用卖家精灵MCP对美国站ASIN B0GFD6L4YK进行实操演示。该案例展示了如何通过六步流程筛选直接竞品、区分商品与页面差距及验证关键词相关性，强调数据需结合成本与利润条件复核，避免仅凭销量或排名盲目决策。",{"_45":62,"_63":64,"_65":66,"_67":59,"_68":69},"2026-10-13","https://www.amz123.com/t/PEcL4Oh1","fGrBYUHgzE-Y",{"_60":76,"_11":71,"_79":-5,"_19":22,"_15":18,"_80":83},{"_60":61,"_11":47,"_79":-5,"_19":20,"_15":18,"_80":81},"occurredAt","representative",{"_45":46,"_11":47,"_27":48,"_49":82,"_51":20,"_52":53,"_54":55,"_56":57,"_58":59,"_60":61},{"_45":62,"_63":64,"_65":66,"_67":59,"_68":69},{"_45":70,"_11":71,"_27":72,"_49":84,"_51":22,"_52":53,"_54":74,"_56":75,"_58":59,"_60":76},{"_45":62,"_63":64,"_65":66,"_67":59,"_68":69},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_93":94},"changelogVersion","2026-10-09T22:08"]
