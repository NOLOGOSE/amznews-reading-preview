[{"_1":2,"_3":4},"root",{"_5":108},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41},"publicId","3d96fd12-f2e4-4456-bccf-6eadbb21bec4","title","Shoper指数：波兰9月电商销售额同比增13.1%","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-16T01:55:00.000Z","latestAt","2026-10-16T03:34:43.000Z","digest","2026年10月16日，电商平台服务商Shoper发布数据，2026年9月受调查约2万家网店电商销售额同比增长13.1%，创近12个月最高，并连续第二个月保持两位数增长；环比增长4.1%，Shoper Trends指数达1595点，较2023年1月基准高59.5%。增长主要由购买人数增加驱动：订单量同比增9.2%，购买人数同比增8.9%，平均订单金额409.48波兰兹罗提，同比仅增3.5%，环比增0.08%。品类方面，工具及建筑材料同比增28.3%居首，家具增22.7%，艺术与娱乐增19.7%；书籍、音乐和电影类降0.9%，电子产品仅增0.2%但订单量增10.9%。Shoper称数据表明波兰电商正以较强势头进入第四季度。","digestUpdatedAt","2026-10-17T10:31:47.652Z","summary","excerpt","latest","Shoper发布9月数据：波兰电商销售额同比增13.1%，创近12个月新高。","whyHot",{"_101":102,"_103":102,"_104":102,"_105":106,"_107":-5,"_38":-5},"developments",[95],"officialReports",[],"timeline",[69],"heat",[42,43,44,45,46,47,48,49],"related",[],{"_50":67,"_38":68,"_53":58},{"_50":65,"_38":66,"_53":58},{"_50":63,"_38":64,"_53":58},{"_50":61,"_38":62,"_53":58},{"_50":59,"_38":60,"_53":58},{"_50":56,"_38":57,"_53":58},{"_50":54,"_38":55,"_53":16},{"_50":51,"_38":52,"_53":16},"hour","2026-10-18T03:00:00.000Z",2.5,"participants","2026-10-18T02:00:00.000Z",2.6,"2026-10-18T01:00:00.000Z",5.3,2,"2026-10-18T00:00:00.000Z",5.4,"2026-10-17T23:00:00.000Z",5.6,"2026-10-17T22:00:00.000Z",5.7,"2026-10-17T21:00:00.000Z",5.9,"2026-10-17T20:00:00.000Z",6.1,{"_70":71,"_11":72,"_26":73,"_74":75,"_76":19,"_77":78,"_79":80,"_81":82,"_83":84,"_85":86},"id","bq7bxov6peht7lidjbqisj29k","Shoper数据：9月波兰电商销售额同比增13.1%，工具家具品类热销","电商平台服务商Shoper发布数据显示，2026年9月受调查约2万家网店销售额同比增长13.1%，创近12个月最高。增长主要由购买人数增加驱动，订单量同比增9.2%，平均订单金额仅微增3.5%至409.48波兰兹罗提。工具及建筑材料、家具品类表现突出，分别同比增长28.3%和22.7%。","source",{"_70":87,"_88":89,"_90":91,"_92":84,"_93":94},"publishedAt","publishedPrecision","calendar","ca