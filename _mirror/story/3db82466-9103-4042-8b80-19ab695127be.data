[{"_1":2,"_3":4},"root",{"_5":77},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","3db82466-9103-4042-8b80-19ab695127be","title","英国电商Zavvi停止运营进入破产程序","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T07:08:11.000Z","latestAt","digest","英国影视游戏收藏品电商Zavvi于10月12日停止业务运营并进入正式破产程序。该平台源自2007年Virgin Megastores英国业务，2009年被THG收购品牌。据10月15日报道，Zavvi不再发出任何在库订单与预订单，不再接受退货，德国站zavvi.de已关闭；已付款项不自动退还，消费者需向银行、信用卡机构或支付服务商发起拒付或买家保护申诉。限量收藏版买家受影响最大。目前尚无后续进展报道。","digestUpdatedAt","2026-10-17T10:35:32.582Z","summary","excerpt","latest","Zavvi于10月12日停止运营并进入破产程序，德国站关闭、订单停发、退款需自行申诉。","whyHot",{"_70":71,"_72":71,"_73":71,"_74":75,"_76":-5,"_37":-5},"developments",[65],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":12,"_25":44,"_45":46,"_47":19,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":56},"id","b2fhft1pbs9upckxe5m77g1kf","英国影视游戏收藏品电商Zavvi于10月12日停止业务运营并进入正式破产程序：不再发出任何在库订单与预订单、不再接受退货，德国站zavvi.de已关闭；已付款项不自动退还，消费者需向银行、信用卡机构或支付服务商发起拒付/买家保护申诉。限量收藏版买家受影响最大。","source",{"_42":57,"_58":59,"_60":61,"_62":54,"_63":64},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.egainnews.com/article/74378","selected",false,"factId","fZ1Z15P5YWOI","publisher-egainnews-articles","name","蓝海亿观网 · 跨境电商资讯","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/bf9841f40884e812.webp",{"_55":56,"_11":12,"_66":-5,"_18":19,"_15":16,"_67":68},"occurredAt","representative",{"_42":43,"_11":12,"_25":44,"_45":69,"_47":19,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":56},{"_42":57,"_58":59,"_60":61,"_62":54,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_78":79},"changelogVersion","2026-10-09T22:08"]
