[{"_1":2,"_3":4},"root",{"_5":98},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41},"publicId","419cfaa6-a612-4626-bc53-a977c19b8439","title","亚马逊推FBA退货定制分级功能","status","settled","reportCount",2,"sourceCount","firstReportAt","2026-10-13T21:01:40.712Z","latestAt","2026-10-15T00:00:00.000Z","digest","2026年10月13日，有卖家发文称收到亚马逊FBA团队邮件，亚马逊推出“定制分级”（Customized grading）功能，入口在后台【设置】＞【订单】＞【回收】＞【定制分级】。卖家可自定义退货作为新品转售的验收标准，涉及四个维度：密封和包装（可选封膜类型，并决定仅封膜破损能否作为新品转售）、随附配件（可要求所有配件均须存在或仅限基本配件，并规定缺件补配后能否作二手转售）、设备功能（勾选蓝牙、按键、充电、制冷、加热、滤芯、固件、IMEI等必测项）、正品标识（写明防伪验证方式）。规则可按目录全部ASIN、指定ASIN或CSV批量上传，未覆盖的ASIN仍走默认分级流程；提交新规则会替换原有规则。作者指出该标准是“作为指导”（as guidance），最终判定权仍在亚马逊，且功能刚上线执行尺度待观察。10月15日，ASGTG周报亦提及亚马逊允许FBA卖家设定自定义分级规则，以帮助退货库存符合品牌标准。","digestUpdatedAt","2026-10-17T10:37:43.786Z","summary","excerpt","latest","10月15日ASGTG周报亦提及亚马逊允许FBA卖家设定自定义退货分级规则。","whyHot",{"_91":92,"_93":92,"_94":92,"_95":96,"_97":-5,"_38":-5},"developments",[79,80],"officialReports",[],"timeline",[42,43],"heat",[],"related",[],{"_44":69,"_11":70,"_26":71,"_48":72,"_50":21,"_51":52,"_53":73,"_55":74,"_57":58,"_59":75},{"_44":45,"_11":46,"_26":47,"_48":49,"_50":19,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60},"id","mfwuuobwbmies365qvlhsqda9","卖家实测亚马逊退货定制分级功能：自定义标准拦截缺件退货当新品","亚马逊推出“定制分级”（Customized grading）功能，允许卖家在后台设定退货作为新品转售的具体标准。作者实测指出，该功能支持从密封包装、随附配件、设备功能和正品标识四个维度自定义验收规则，例如要求所有配件均须存在或封膜破损不可当新品。","source",{"_44":61,"_62":63,"_64":65,"_66":58,"_67":68},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-14","originalUrl","https://www.wearesellers.com/question/125409","selected",false,"factId","fCEQWL--4LIE","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp","h0ounruub66q6bp32g8o56srg","亚马逊 Seller Central 图片异常、ROVE Listing 移除及 FBA 退货新规","亚马逊卖家反馈 Seller Central 出现图片被 AI 生成或错误替换的问题，同时 ROVE Listing 将于 10 月 23 日移除，仅品牌代表可继续销售。亚马逊推出 FBA 自定义退货分级规则，允许卖家设定标准以优化库存评估。",{"_44":76,"_62":77,"_64":65,"_66":58,"_67":78},"2026-10-15","https://asgtg.com/amazon-image-issue-sparks-seller-complaints-rove-listings-at-risk-positive-news-for-fba-returns/","fGfFDzV4GxEk","publisher-asgtg-official-blog-rolling","ASGTG · 官方卖家周报","/amznews-reading-preview/_img/cb7e87c8dd6d977d.webp",{"_59":75,"_11":87,"_82":88,"_18":21,"_15":83,"_84":89},{"_59":60,"_11":81,"_82":-5,"_18":19,"_15":83,"_84":85},"亚马逊推出定制分级功能允许卖家设定退货标准","occurredAt",1,"representative",{"_44":45,"_11":46,"_26":47,"_48":86,"_50":19,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60},{"_44":61,"_62":63,"_64":65,"_66":58,"_67":68},"亚马逊通知ROVE品牌Listing将于10月23日移除","2026-10-22T16:00:00.000Z",{"_44":69,"_11":70,"_26":71,"_48":90,"_50":21,"_51":52,"_53":73,"_55":74,"_57":58,"_59":75},{"_44":76,"_62":77,"_64":65,"_66":58,"_67":78},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_99":100},"changelogVersion","2026-10-09T22:08"]
