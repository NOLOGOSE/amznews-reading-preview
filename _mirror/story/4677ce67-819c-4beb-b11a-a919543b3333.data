[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","4677ce67-819c-4beb-b11a-a919543b3333","title","Jungle Scout推出Brand Performance工具","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-09-30T15:39:37.000Z","latestAt","digest","2026年9月30日，Jungle Scout 推出 AI 解决方案 Brand Performance。据该报道，这一工具可回答某品牌在所属类目中的表现、是否跟上类目增长、哪些产品跑赢类目平均，基于 Jungle Scout 的亚马逊数据。报道称其面向三类使用者：按季度追踪自身位置的品牌、为客户做竞品基准的代理机构，以及接手品牌却缺乏清晰定位的团队。目前报道仅涉及该工具的发布与功能定位，未提及后续更新或其他进展。","digestUpdatedAt","2026-10-07T07:39:31.116Z","summary","excerpt","latest","Jungle Scout 推出 AI 工具 Brand Performance，支持品牌与类目增长对标。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","j9w1e3zngl4nyj6uqt9cuwrmh","Jungle Scout 推出 Brand Performance：用 AI 对比品牌与类目增长","Jungle Scout 推出 AI 解决方案 Brand Performance，可回答某品牌在所属类目中的表现、是否跟上类目增长、哪些产品跑赢类目平均。该工具基于 Jungle Scout 的亚马逊数据，面向按季度追踪自身位置的品牌、为客户做竞品基准的代理机构，以及接手品牌却缺乏清晰定位的团队。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","unknown","calendarDate","originalUrl","https://www.junglescout.com/resources/articles/amazon-brand-performance-vs-category/","selected",false,"factId","fd_-3i7rWscU","author-jungle-scout-shared-articles","name","Jungle Scout","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/cac30dcab47cf624.webp",{"_56":57,"_11":67,"_68":-5,"_18":19,"_15":16,"_69":70},"Jungle Scout推出Brand Performance品牌对标工具","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","o