[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","47f38cca-a28d-4dd5-ac0c-a28e3b5f9825","title","亚马逊卖家费用结构详解与利润审计指南","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-08T16:00:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_77":43,"_78":59},"latest","whyHot",{"_70":71,"_72":71,"_73":71,"_74":75,"_76":-5,"_35":-5},"developments",[65],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},"id","fr1d84uzdcebbo4qy076l13hj","亚马逊卖家费用结构逐层审计：解析收入与利润差距及贡献毛利计算","文章指出亚马逊费用并非单一费率，而是由推荐费、FBA 配送费及入库配置服务费等构成的叠加体系，导致营收数字掩盖真实利润。作者建议通过计算单位贡献毛利（售价减去所有可变成本）来评估业务健康度，并强调需定期对照 Seller Central 最新费率页进行月度审计以捕捉利润泄漏。","source",{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-09","originalUrl","https://zonflip.com/where-your-amazon-margin-actually-goes-a-line-by-line-audit-of-the-seller-fee-stack/","selected",false,"factId","fjlbGebsfu48","author-zonflip-joey-rolling","name","ZonFlip · Joey Glyshaw","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/5f0d894cf7d4661c.webp",{"_55":56,"_11":12,"_66":-5,"_18":19,"_15":16,"_67":68},"occurredAt","representative",{"_40":41,"_11":42,"_23":43,"_44":69,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_80":81},"changelogVersion","2026-10-09T22:08"]
