[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","4d0af82d-ef51-4b0e-941e-48f5df3f650c","title","亚马逊美国站B2B自配送90%履约率要求","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-09-30T02:54:00.000Z","latestAt","digest","2026年9月30日，据雨果跨境报道，亚马逊官方公告要求美国站面向Amazon Business客户的自配送订单，自2026年9月30日起须维持至少90%的营业时间送达率（BHDR），按滚动14天计算。公告称，若到10月30日仍未改善，相关自配送报价可能不再面向企业客户；FBA及零售报价资格不受影响。目前进展为该项要求已自9月30日起生效，10月30日为观察节点。","digestUpdatedAt","2026-10-01T23:07:31.608Z","summary","excerpt","latest","美国站B2B自配送90%营业时间送达率要求自9月30日起生效。","whyHot",{"_73":74,"_75":74,"_76":74,"_77":78,"_79":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","rbjf94hscnkl56t1wrqnpjyr7","美国站B2B自配送：BHDR须维持90%，未改善可能影响企业客户报价","Amazon官方公告要求美国站面向Amazon Business客户的自配送订单，自2026年9月30日起维持至少90%的营业时间送达率（BHDR），按滚动14天计算。若到10月30日仍未改善，相关自配送报价可能不再面向企业客户；FBA及零售报价资格不受影响。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.cifnews.com/article/189235","selected",false,"factId","fP170A4Pkh24","author-cifnews-cici","name","雨果跨境 · 跨境视频cici","kind","json_list","firstParty","iconUrl","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp",{"_56":57,"_11":67,"_68":69,"_18":19,"_15":16,"_70":71},"亚马逊美国站B2B自配送执行90%履约率要求","occurredAt","2026-09-29T16:00:00.000Z","representative",{"_42":43,"_11":44,"_25":45,"_46":72,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_81":82},"changelogVersion","2026-10-09T22:08"]
