0Z",9,"2026-10-20T18:00:00.000Z",9.2,"2026-10-20T17:00:00.000Z",9.5,"2026-10-20T16:00:00.000Z",9.8,{"_187":188,"_11":189,"_25":190,"_191":192,"_193":19,"_194":195,"_196":-5,"_197":198,"_199":200,"_201":202},"id","j0qlt3w91girre57xw0dhxj7e","亚马逊 FBA 库存丢失或损坏的赔偿申请指南","作者 Ivonne Haire 介绍了亚马逊 FBA 卖家在库存丢失或损坏时申请赔偿的流程框架，包括在货件处于“Closed”状态后核对已接收与预期数量、准备发票和承运方签收单据等凭证，以及通过卖家中心提交索赔。原文指出 90 天期限针对货件关闭情形，并说明不同索赔类型的截止窗口可能不同，卖家应以卖家中心具体索赔类型为准。原文还称亚马逊通常按商品成本而非零售价赔付，未提供成本时可能按估值处理。原文推荐第三方自动化工具并设有账户审查表单，存在相关商业利益，并非独立测评。","source",{"_187":203,"_204":205,"_206":207,"_208":200,"_209":210},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.bellavix.com/amazon-fba-inventory-reimbursement-how-to-recover-money-for-lost-or-damaged-inventory/","selected",false,"factId","f1HhiHNHOsNk","bellavix-marketplace-insights-rolling","name","BellaVix · Amazon与Walmart运营洞察","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/21e5bebf630b7ade.webp",{"_201":202,"_11":189,"_212":-5,"_18":19,"_15":16,"_213":214},"occurredAt","representative",{"_187":188,"_11":189,"_25":190,"_191":215,"_193":19,"_194":195,"_196":-5,"_197":198,"_199":200,"_201":202},{"_187":203,"_204":205,"_206":207,"_208":200,"_209":210},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_224":225},"changelogVersion","2026-10-09T22:08"]
