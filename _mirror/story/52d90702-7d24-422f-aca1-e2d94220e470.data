[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39},"publicId","52d90702-7d24-422f-aca1-e2d94220e470","title","亚马逊商品图片转化策略与AI合规指南","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T22:04:08.000Z","latestAt","digest","2026年10月13日，Canopy Management 的 Chuck Kessler 发布文章，提出亚马逊高转化图片栈的构建方法。文章称主图须符合纯白背景（RGB 255,255,255）、商品占画面85%至100%、无文字或logo等规则，最长边500至10000像素，缩放需至少1000像素。亚马逊员工建议至少六张图片加一段视频，每张辅图应逐一回应买家购买异议，顺序为核心利益、尺寸参照、细节证明、使用场景、首要异议、包装内容。视频方面，文章称有至少三个月销售历史的品牌及非品牌卖家均可添加可购物视频，每个ASIN最多四个，并引用亚马逊2026年1至6月内部数据称添加首个可购物视频的商品详情页平均销售增长24%。AI图片方面，文章称亚马逊并无全面禁令，但要求图片准确代表商品，且自2026年7月起，展示逼真AI生成人物的图片须在元数据中标注“contains-synthetic-performer”。","digestUpdatedAt","2026-10-17T10:42:05.337Z","summary","excerpt","latest","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_36":-5},"developments",[65],"officialReports",[],"timeline",[40],"heat",[],"related",[],{"_41":42,"_11":43,"_25":44,"_45":46,"_47":19,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":56},"id","cxozq3fmad7z4oyr33cqxfsb2","亚马逊2026年商品图片转化策略：主图规范、异议拆解与AI合规指南","Chuck Kessler 提出亚马逊高转化图片栈需以符合纯白背景及85-100%占比的主图为基础，后续图片按核心利益、尺寸参照、细节证明等顺序逐一回应买家购买异议。","source",{"_41":57,"_58":59,"_60":61,"_62":54,"_63":64},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://canopymanagement.com/amazon-product-images-that-convert/","selected",false,"factId","fxzV7nT8q-Rg","publisher-canopy-management-written-rolling","name","Canopy Management 亚马逊运营与广告文章","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/4fdc8a2c82c45bd3.webp",{"_55":56,"_11":66,"_67":-5,"_18":19,"_15":16,"_68":69},"2026年亚马逊图片堆栈与AI规则指南","occurredAt","representative",{"_41":42,"_11":43,"_25":44,"_45":70,"_47":19,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":56},{"_41":57,"_58":59,"_60":61,"_62":54,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersion","2026-10-09T22:08"]
