0.000Z",14.9,"2026-10-20T04:00:00.000Z",15.3,"2026-10-20T03:00:00.000Z",15.8,"2026-10-20T02:00:00.000Z",16.2,"2026-10-20T01:00:00.000Z",16.7,"2026-10-20T00:00:00.000Z",17.2,"2026-10-19T23:00:00.000Z",17.7,"2026-10-19T22:00:00.000Z",18.2,"2026-10-19T21:00:00.000Z",18.8,"2026-10-19T20:00:00.000Z",19.3,"2026-10-19T19:00:00.000Z",{"_195":227,"_11":228,"_26":229,"_199":230,"_201":21,"_202":231,"_204":232,"_205":233,"_207":217,"_209":210},{"_195":219,"_11":220,"_26":221,"_199":222,"_201":223,"_202":203,"_204":-5,"_205":224,"_207":208,"_209":210},{"_195":196,"_11":197,"_26":198,"_199":200,"_201":19,"_202":203,"_204":-5,"_205":206,"_207":208,"_209":210},"id","u4bevyxysqo86v2eybjd132qh","亚马逊规定2026年12月18日起多数美国FBM订单需预付退货标签","亚马逊宣布自2026年12月18日起，美国站大多数卖家自发货（FBM）订单的退货将强制要求提供预付退货标签。卖家须在收到退货请求后的7个日历日内通过“管理卖家自发货退货”上传标签或全额退款且不要求退回商品；若未执行，亚马逊可能自动发放无需退货的退款并从卖家账户扣除相应金额。重型和大件物品暂时豁免此规定，且不在亚马逊退货工作流内发送的标签无效。","source",{"_195":211,"_212":213,"_214":215,"_216":217,"_218":-5},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://x.com/AmazonASGTG/status/2112251468099043498","selected",true,"factId","fXfrQy_90Ddk","x-amazon-asgtg","name","X · ASGTG","kind","x_search","firstParty",false,"iconUrl","fef2ezdkclqu2l36k3tmaheal","亚马逊要求FBM卖家提供预付退货标签","亚马逊宣布自2026年12月18日起，大多数美国FBM订单退货需卖家提供预付退货标签。卖家须在7天内上传标签或全额退款，否则亚马逊可能自动执行无退货退款并从账户扣款，重型和大件商品暂时豁免。作者转发此消息并评论称这是卖家应分散亚马逊依赖的又一理由。",{"_195":225,"_212":226,"_214":215,"_216":217,"_218":-5},"2026-10-19T19:00:09.000Z","https://x.com/michaelpatron0/status/2112257512204554496","x-michael-patron","X · Michael Patrón","eoyht5c0jeb0r499hy0wjsddi","亚马逊：多数美国卖家自发货退货将需预付标签，并拟推出跨渠道工具","原文转述亚马逊公告称，自2026年12月18日起，多数美国卖家自发货（FBM）退货将要求使用预付标签；卖家需在7个日历日内上传，否则可能触发自动无退货退款。原文还提到，亚马逊宣布的Seller Central工具拟整合eBay、Shopify、TikTok和Walmart的列表、订单与盈利数据，但卖家对亚马逊可见的跨渠道数据范围及履约错误是否会影响其他平台账户表示担忧。",{"_195":234,"_212":235,"_214":236,"_216":217,"_218":237},"calendar","2026-10-22","https://asgtg.com/amazons-next-big-move-has-sellers-nervous-texas-targets-linked-accounts-200-safety-requests/","publisher-asgtg-official-blog-rolling","ASGTG · 官方卖家周报","web_list","/amznews-reading-preview/_img/cb7e87c8dd6d977d.webp",{"_209":210,"_11":220,"_239":240,"_18":19,"_15":16,"_241":242},"occurredAt","2026-12-17T16:00:00.000Z","representative",{"_195":196,"_11":197,"_26":198,"_199":243,"_201":19,"_202":203,"_204":-5,"_205":206,"_207":208,"_209":210},{"_195":211,"_212":213,"_214":215,"_216":217,"_218":-5},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_251":252},"changelogVersion","2026-10-09T22:08"]
