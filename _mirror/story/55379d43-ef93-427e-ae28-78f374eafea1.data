[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","55379d43-ef93-427e-ae28-78f374eafea1","title","亚马逊美国站节日装饰灯串UL 588合规要点","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T21:07:40.982Z","latestAt","digest","2026年10月13日，检测机构“HY检测”在知无不言发文，梳理亚马逊美国站节日装饰灯串的UL 588合规框架（该文存在商业利益，非独立测评）。文章指出，UL 588适用于插头连接、便携、临时使用、额定输入电压≤120V的季节性装饰照明产品及配件，绳灯、小夜灯等不适用；标准限定安装与使用周期不超过90天，工厂组装的并联灯串符合补充要求SD可宣称全年使用。标准版本方面，UL 588第19版已于2025年9月26日发布、2025年11月13日修订，第18版转为归档，而CPSC“重大产品危害”规则的技术依据仍锚定第18版相关章节。文章还称，缺少CPSC认定的可观察安全特性即构成重大产品危害，并适用CPSA §15(b)强制报告义务；建议由ISO 17025认可实验室出具检测报告，按清单提交报告、图片、英文说明书等，并提前1–2个月安排检测。文中涉及的CPSC三要素具体内容、标准版本技术依据等，本站尚未独立核验。","digestUpdatedAt","2026-10-17T10:42:26.205Z","summary","excerpt","latest","检测机构发文梳理亚马逊美国站节日装饰灯串UL 588合规与送检要点。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","titi21x5y90ow5qrb0e3tznsc","亚马逊美国站节日装饰灯串UL 588合规与送检要点","原文由检测机构“HY检测”发布，存在相关商业利益，并非独立测评。文章梳理亚马逊美国站节日装饰灯串的UL 588合规框架：先判定产品是否适用UL 588（绳灯、小夜灯等不适用），关注标准版本动态（第19版已于2025-09-26发布、2025-11-13修订，第18版转为归档），并提示CPSC“重大产品危害”规则与CPSA §15(b)强制报告义务的关联。作者建议由ISO 17025认可实验室出具UL 588检测报告，按清单提交报告、图片、英文说明书等，并提前1–2个月安排检测。文中涉及的CPSC三要素具体内容、标准版本技术依据等，本站尚未独立核验。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-14","originalUrl","https://www.wearesellers.com/question/125399","selected",false,"factId","fTzbwOsFoQwA","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_57":58,"_11":44,"_68":-5,"_18":19,"_15":16,"_69":70},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
