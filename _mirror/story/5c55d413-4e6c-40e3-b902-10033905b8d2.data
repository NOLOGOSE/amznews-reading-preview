[{"_1":2,"_3":4},"root",{"_5":82},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","5c55d413-4e6c-40e3-b902-10033905b8d2","title","Romorgniz召回在亚马逊销售的六斗柜","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-08T00:00:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_80":43,"_81":59},"latest","whyHot",{"_74":75,"_76":75,"_77":75,"_78":63,"_79":-5,"_35":-5},"developments",[68],"officialReports",[66],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},"id","mm5wjwfh09k3p253mou59k1z5","美国CPSC召回Romorgniz六斗柜，因违反STURDY Act存在倾倒风险","美国消费品安全委员会（CPSC）于2026年10月8日召回约12,078件Romorgniz六斗柜，因其未固定时存在导致儿童严重受伤或死亡的倾倒及被困风险，且违反STURDY Act强制安全标准。该木质斗柜在Amazon.com以100至170美元售价销售，消费者应立即停用并联系厂商获取全额退款后自行处置。","source",{"_40":57,"_58":59,"_60":61,"_62":63,"_64":65},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-08","originalUrl","https://www.cpsc.gov/Recalls/2027/Romorgniz-Recalls-Six-Drawer-Dressers-Due-to-Risk-of-Serious-Injury-or-Death-from-Tip-Over-and-Entrapment-Hazards-Violate-Mandatory-Standard-for-Clothing-Storage-Units","selected",false,"factId","fT9oQw3wDajM","official-cpsc-amazon-recalls-reviewed","name","CPSC 美国消费品安全委员会","kind","json_list","firstParty",true,"iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp",{"_40":41,"_11":42,"_23":43,"_44":67,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},{"_40":57,"_58":59,"_60":61,"_62":63,"_64":65},{"_55":56,"_11":12,"_69":70,"_18":19,"_15":16,"_71":72},"occurredAt","2026-10-07T16:00:00.000Z","representative",{"_40":41,"_11":42,"_23":43,"_44":73,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},{"_40":57,"_58":59,"_60":61,"_62":63,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank","text","sourceName",{"_83":84},"changelogVersion","2026-10-09T22:08"]
