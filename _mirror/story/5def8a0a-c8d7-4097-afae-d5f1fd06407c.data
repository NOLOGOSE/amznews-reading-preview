[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","5def8a0a-c8d7-4097-afae-d5f1fd06407c","title","卖家实测亚马逊SBV视频广告效果","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T05:01:26.814Z","latestAt","digest","2026年10月15日，卖家“奋斗的青年”在知无不言分享其针对新品的亚马逊SBV视频广告实测结果。该卖家对同一产品同时投放SP广告和SBV广告并分析长达一个月的数据，结果显示SBV广告点击率高出2倍、订单量高出3倍，但ACOS高出8%。作者指出该测试受产品自然排名和上架初期流量影响，产品于8月27日开始销售，当时尚未进入流量高峰期，使用已有自然排名的核心关键词测试也可能导致数据偏差。文中还总结制作高转化率视频的最佳实践，包括前3秒出现人物可提升12%点击率、时长控制在15至30秒、结尾添加清晰号召性用语、品牌标识至少一半时间留在屏幕上，以及通过A/B测试优化广告效果，并提及通过特定平台寻找达人合作制作视频素材的方法。","digestUpdatedAt","2026-10-17T10:36:37.982Z","summary","excerpt","latest","卖家实测新品SBV广告较SP点击率高2倍、订单多3倍，但ACOS高8%。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","caopwyl5yz22h4db46q4cvm4d","卖家实测亚马逊SBV视频广告：CTR高2倍但ACOS高8%及优化建议","奋斗的青年分享其针对新品的亚马逊SBV视频广告实测结果，数据显示相比SP广告，SBV的点击率高2倍、订单多3倍，但ACOS高出8%。作者指出该测试受产品自然排名和上架初期流量影响，并总结了制作高转化率视频的最佳实践，包括前3秒出现人物可提升12% CTR、时长控制在15-30秒以及进行A/B测试等策略。文中还提及通过特定平台寻找达人合作制作视频素材的方法。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-15","originalUrl","https://www.wearesellers.com/question/125454","selected",false,"factId","fbk8F3PeoP7Y","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_57":58,"_11":44,"_68":-5,"_18":19,"_15":16,"_69":70},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
