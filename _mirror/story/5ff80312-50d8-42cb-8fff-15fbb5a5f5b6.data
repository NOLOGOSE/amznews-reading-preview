[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","5ff80312-50d8-42cb-8fff-15fbb5a5f5b6","title","亚马逊前员工创立的Wyze：低价模式面临多重考验","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T06:59:38.000Z","latestAt","digest","2017年，四位亚马逊前工程师在西雅图创立智能家居品牌Wyze，以19.99美元低价摄像头切入安防赛道，首年销量超100万台、销售额超3000万美元，此后扩展至门铃、灯泡、门锁等品类，并转向“硬件+订阅”模式。报道引用ECDB数据称其2025年线上业务GMV约3.59亿美元。近年其模式承压：Cam Plus年费由19.99美元上调至29.99美元（涨幅50%），免费功能收缩、App广告增多，并接连发生隐私与安全事件。2026年6月，Wyze因安装说明错误可能导致锂电池过热起火，在美国召回约32.14万台Solar Cam Pan摄像头，加拿大另有约2560台，报告13起过热事件、6起爆炸或起火、6起轻微烧伤。报道还提到2025年4月一批价值16.7万美元的泛光灯产品产生25.5万美元关税。需注意，原文对独立站访问量给出“4-9月”与“2026年3-8月”两个统计区间且均记为4185万，口径矛盾未获解释。","digestUpdatedAt","2026-10-17T10:36:05.697Z","summary","excerpt","latest","2026年6月，Wyze因电池起火风险在美加召回约32.4万台Solar Cam Pan摄像头。","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","resuir5rqhsx6mgczh2pe5mhq","亚马逊前员工创立 Wyze 智能家居，低价模式面临订阅涨价与安全事件考验","四位亚马逊前工程师于 2017 年创立智能家居品牌 Wyze，以低价硬件与订阅服务组合切入市场。原文引用 ECDB 数据称其 2025 年线上业务 GMV 约 3.59 亿美元，本站尚未独立核验该引用。原文同时提到 Wyze 独立站访问量数据存在“4-9月”与“2026年3-8月”两个不同统计区间，均记为 4185 万，口径矛盾未获解释，故不采用“访问量超 eufy”的对比结论。原文还提及该品牌面临 Cam Plus 订阅费上涨、App 广告增多及隐私安全事件等挑战，其性价比优势正受到考验。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.egainnews.com/article/74363","selected",false,"factId","fV26zC-OMKII","publisher-egainnews-articles","name","蓝海亿观网 · 跨境电商资讯","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/bf9841f40884e812.webp",{"_56":57,"_11":44,"_67":-5,"_18":19,"_15":16,"_68":69},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":70,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersion","2026-10-09T22:08"]
