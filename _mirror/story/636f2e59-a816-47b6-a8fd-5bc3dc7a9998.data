[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","636f2e59-a816-47b6-a8fd-5bc3dc7a9998","title","David Stellato 谈亚马逊外联盟营销漏斗策略","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T13:00:00.000Z","latestAt","digest","2026年10月13日，Seller Labs 博客发布对电商营销人 David Stellato 的访谈（节目录制于2026年2月）。Stellato 提出，在亚马逊做到数百万美元销量的卖家往往忽视自有 Shopify 站点，而直接响应漏斗可改变这一局面：流程为广告、软文、主推产品页，再到 good/better/best 结账与一键追加销售，可把 50 美元订单提升至 100 至 150 美元，并建议追加销售附加率至少达 30%。他还分享了该模式的设置成本、典型收入分成、目标利润率、如何对标亚马逊与 MAP 定价，以及应预留多少媒体测试资金。","digestUpdatedAt","2026-10-17T10:46:05.549Z","summary","excerpt","latest","Stellato 建议追加销售附加率至少达 30%，可将 50 美元订单提升至 100-150 美元。","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","l2el91qv46rnvj739oi1k9qv8","David Stellato 分享利用联盟营销漏斗在亚马逊外提升销量的策略","David Stellato 提出通过直接响应漏斗将亚马逊卖家流量转化为自有 Shopify 销售，以摆脱仅构建亚马逊客户列表的局面。该模式包含广告、软文及多级结账流程，旨在将 $50 订单提升至 $100-$150，并建议附加率至少达 30%。Stellato 还分享了设置成本、收入分成比例及媒体测试资金储备等关键运营数据。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.sellerlabs.com/blog/sell-more-off-amazon-affiliate-funnels-david-stellato/","selected",false,"factId","fmQqqr46CUu8","rss-sellerlabs-prelaunch","name","Seller Labs","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp",{"_56":57,"_11":44,"_67":-5,"_18":19,"_15":16,"_68":69},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":70,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersion","2026-10-09T22:08"]
