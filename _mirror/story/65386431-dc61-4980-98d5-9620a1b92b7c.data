T23:00:00.000Z",6.8,"2026-10-20T22:00:00.000Z",7,"2026-10-20T21:00:00.000Z",7.2,"2026-10-20T20:00:00.000Z",7.4,"2026-10-20T19:00:00.000Z",7.6,"2026-10-20T18:00:00.000Z",7.9,"2026-10-20T17:00:00.000Z",8.1,"2026-10-20T16:00:00.000Z",8.3,"2026-10-20T15:00:00.000Z",8.6,"2026-10-20T14:00:00.000Z",8.8,"2026-10-20T13:00:00.000Z",9.1,"2026-10-20T12:00:00.000Z",9.4,"2026-10-20T11:00:00.000Z",9.6,"2026-10-20T10:00:00.000Z",9.9,{"_187":188,"_11":12,"_25":189,"_190":191,"_192":19,"_193":194,"_195":-5,"_196":197,"_198":199,"_200":201},"id","mz0qjr3oiyguckxt1g80bdtse","Channel Bakers 分享利用亚马逊 AMC、DSP 及 Performance+ 助力 XPPen 和 Makartt 实现全流域增长的案例。XPPen 通过跨触点协同使品牌新客销售额环比提升 207%；Makartt 借助增量触达优化使增量触达同比提升 82%。数据由 Channel Bakers 提供，相关案例获 2026 亚马逊广告合作伙伴奖。","source",{"_187":202,"_203":204,"_205":206,"_207":199,"_208":209},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.cifnews.com/article/189558","selected",false,"factId","fOSvw1VdvRtM","publisher-cifnews-amazon","name","雨果跨境 · 亚马逊频道最新","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp",{"_200":201,"_11":211,"_212":-5,"_18":19,"_15":16,"_213":214},"Channel Bakers分享XPPen与Makartt全流域营销案例","occurredAt","representative",{"_187":188,"_11":12,"_25":189,"_190":215,"_192":19,"_193":194,"_195":-5,"_196":197,"_198":199,"_200":201},{"_187":202,"_203":204,"_205":206,"_207":199,"_208":209},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_224":225},"changelogVersion","2026-10-09T22:08"]
