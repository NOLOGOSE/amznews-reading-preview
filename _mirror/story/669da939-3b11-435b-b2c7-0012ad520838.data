:00.000Z",8.1,"2026-10-22T15:00:00.000Z",8.4,"2026-10-22T14:00:00.000Z",8.6,"2026-10-22T13:00:00.000Z",8.9,"2026-10-22T12:00:00.000Z",9.1,{"_177":178,"_11":179,"_25":180,"_181":182,"_183":19,"_184":185,"_186":-5,"_187":188,"_189":190,"_191":192},"id","pebw0lrd9qdf8i6b1c2mvbkze","鞋服跨境出口面临欧盟PFAS新规与美国海关侵权扣押双重监管收紧","鞋服品类作为跨境电商最大出口类目，正遭遇欧盟PFAS限制生效及美国海关加大侵权货物扣押力度的监管收紧。欧盟PFAS新规于2026年10月10日生效，禁止特定浓度物质销售；欧洲鞋业联合会测试显示Shein、Temu部分样品化学指标超标。同时，低价小包直邮模式因欧盟3欧元进口费及多国取消免税政策而成本激增，合规成为卖家生存关键。","source",{"_177":193,"_194":195,"_196":197,"_198":190,"_199":-5},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://mjzj.com/article/g1zbopig6z9c","selected",false,"factId","fEWVyZd9jYk0","publisher-mjzj-feed","name","卖家之家 · 跨境资讯","kind","rss","firstParty","iconUrl",{"_191":192,"_11":201,"_202":203,"_18":19,"_15":16,"_204":205},"鞋服品类面临欧盟PFAS禁令及美国海关侵权扣押收紧","occurredAt","2026-10-12T16:00:00.000Z","representative",{"_177":178,"_11":179,"_25":180,"_181":206,"_183":19,"_184":185,"_186":-5,"_187":188,"_189":190,"_191":192},{"_177":193,"_194":195,"_196":197,"_198":190,"_199":-5},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_215":216},"changelogVersion","2026-10-09T22:08"]
