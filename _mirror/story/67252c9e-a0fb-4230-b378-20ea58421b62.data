[{"_1":2,"_3":4},"root",{"_5":83},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","67252c9e-a0fb-4230-b378-20ea58421b62","title","亚马逊FBM卖家反映运费补扣与标签涨价","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T20:08:39.000Z","latestAt","digest","2026年10月15日，有亚马逊FBM卖家在社交平台反映，近60天内发货后被追加运费的情况明显增多：部分此前每张24美元的运费标签，现被加收至50美元。该卖家称，这一现象自8月开始，持续至10月；今年通过Seller Central购买的所有运费标签均被加收7%费用。其建议卖家在财务交易页搜索“Chargeback due to under charging postage label purchased”核对扣款，并可导出全年报告查看。上述内容来自卖家个人陈述，亚马逊方面未作回应。","digestUpdatedAt","2026-10-17T15:59:46.452Z","summary","excerpt","latest","卖家反映发货后运费补扣增多，部分标签费由24美元涨至50美元。","whyHot",{"_76":77,"_78":77,"_79":77,"_80":81,"_82":-5,"_37":-5},"developments",[70],"officialReports",[],"timeline",[46],"heat",[41],"related",[],{"_42":43,"_37":44,"_45":16},"hour","2026-10-17T20:00:00.000Z",2.5,"participants",{"_47":48,"_11":49,"_25":50,"_51":52,"_53":19,"_54":55,"_56":-5,"_57":58,"_59":60,"_61":62},"id","wknnqwm8o1bnn8hfo4piy0alo","亚马逊FBM卖家遭遇运费补扣与标签涨价","亚马逊FBM卖家近期频繁遭遇发货后运费补扣，部分标签费用从24美元涨至50美元。今年通过Seller Central购买的运费标签均加收7%费用，该现象自8月持续至今。卖家可在财务交易页搜索“Chargeback due to under charging postage”核实具体扣款记录。","source",{"_47":63,"_64":65,"_66":67,"_68":60,"_69":-5},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://x.com/SaulSellsStuff/status/2110825201290113079","selected",false,"factId","fihdyWJv6Bv0","x-saul-sells-stuff","name","X · Saul","kind","x_search","firstParty","iconUrl",{"_61":62,"_11":71,"_72":-5,"_18":19,"_15":16,"_73":74},"卖家称亚马逊FBM运费标签出现补扣费现象","occurredAt","representative",{"_47":48,"_11":49,"_25":50,"_51":75,"_53":19,"_54":55,"_56":-5,"_57":58,"_59":60,"_61":62},{"_47":63,"_64":65,"_66":67,"_68":60,"_69":-5},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_84":85},"changelogVersion","