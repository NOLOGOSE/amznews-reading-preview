[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","69a4013e-4f86-4747-a950-04031af0d3d4","title","Shopify 店铺 Meta 广告设置与数据差异指南","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-10T23:24:24.000Z","latestAt","digest","2026年10月10日，Eva Commerce 旗下 Hai Mag 发布指南，说明 Shopify 店铺运行 Meta 广告的设置与衡量方法。文章建议：通过 Shopify 官方“Facebook & Instagram by Meta”销售渠道连接店铺，只接入一个 Meta 像素，并将客户数据共享设为 Enhanced 或 Maximum，以启用 Conversions API 进行服务器端购买事件传输；同时同步商品目录、验证域名并更新隐私政策。文章指出，Meta 报告的购买数据与 Shopify 订单通常不一致，原因包括归因窗口、浏览后归因、建模转化以及退款与时区差异；建议用 UTM 标记、混合效率（总收入除以总广告支出）、新老客占比、贡献毛利和增量测试综合评估。文章还列举重复像素、仅用浏览器像素、优化错误事件、目录错误等常见问题，并给出 30 天设置与衡量计划。","digestUpdatedAt","2026-10-17T10:52:49.856Z","summary","excerpt","latest","指南建议 Shopify 商家用单一像素并启用 Conversions API，结合 UTM 与混合效率核对 Meta 数据。","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","ii98vm85cvuzjjadh2s8v7xs3","Shopify 店铺 Meta 广告设置、测量与常见错误指南","为 Shopify 店铺运行 Meta 广告，需连接官方销售渠道、配置单一像素并将数据共享设为 Enhanced 或 Maximum 以启用 Conversions API。由于归因窗口和去重机制差异，Meta 报告数据常与 Shopify 订单不符，建议结合 UTM 标记、混合效率及增量测试进行综合评估。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","unknown","calendarDate","originalUrl","https://eva.guru/blog/meta-ads-shopify-setup-measurement/","selected",false,"factId","fulOYt_rLENY","author-eva-hai-mag-rolling","name","Eva Commerce · Hai Mag","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/104a8dac4cdece16.webp",{"_56":57,"_11":44,"_67":-5,"_18":19,"_15":16,"_68":69},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":70,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersion","2026-10-09T22:08"]
