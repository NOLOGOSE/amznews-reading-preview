[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","6ae7b856-0e0f-44f5-b694-edd1a4e5a343","title","泛欧计划自行车灯德国仓库存因GPSR缺失变瑕疵","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T21:01:42.383Z","latestAt","digest","2026年10月13日，有卖家在知无不言发帖反映：一款自行车灯在欧洲多站点销售，但因德国有额外合规要求，未在德国销售也未创建德国Listing。该ASIN加入欧洲FBA相关计划后，系统显示其在德国站有ASIN级别豁免，主要销售法西意荷市场。但卖家发现该ASIN持续有库存变为瑕疵品，调查称这些瑕疵品发生在德国仓库，原因是德国缺少GPSR（通用产品安全法规）信息，进入德国仓库即被判定为瑕疵品；又因卖家不敢在德国站创建Listing（担心创建后直接下架），无法匹配GPSR信息。目前卖家只能将货物移除至海外仓再重新发回亚马逊仓库，并询问是否有其他解决方案，或是否问题定位有误。","digestUpdatedAt","2026-10-17T10:42:57.738Z","summary","excerpt","latest","卖家反映未在德国销售的自行车灯入德国仓后因缺GPSR变瑕疵品，目前仅能移除海外仓再重发。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","qggax91gg0jjgjm4wywrkp48w","欧洲FBA自行车灯因德国GPSR合规缺失致库存变瑕疵，卖家寻求解决方案","卖家反馈一款未在德国销售的自行车灯ASIN加入泛欧计划后，进入德国仓库的库存因缺失GPSR信息被判定为瑕疵品。尽管系统显示该ASIN在德国站有豁免，但因不敢创建Listing以匹配合规信息，目前仅能通过移除至海外仓再重发解决，正寻求其他方案或确认问题定位是否准确。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-14","originalUrl","https://www.wearesellers.com/question/125393","selected",false,"factId","f3LZ8SoPXipU","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_57":58,"_11":44,"_68":-5,"_18":19,"_15":16,"_69":70},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
