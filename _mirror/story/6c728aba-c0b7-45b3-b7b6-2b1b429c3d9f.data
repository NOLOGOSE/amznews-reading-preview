[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","6c728aba-c0b7-45b3-b7b6-2b1b429c3d9f","title","亚马逊 True ACoS 目标设定方法","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-14T01:21:00.000Z","latestAt","digest","2026年10月14日，My Amazon Guy 的 Ken Zhou 发布文章，介绍如何为亚马逊 PPC 确定理想的 True ACoS 并设定广告目标。文章称，True ACoS 以总广告支出除以含自然订单的总销售额计算，比只衡量直接转化广告销售的 Campaign ACoS 更贴近业务利润底线。其提出的计算路径为：先算出广告前利润率（即盈亏平衡 ACoS），减去希望保留的目标净利率，得到理想 True ACoS，再除以广告销售占比换算为 Campaign ACoS 目标。文章给出分阶段参考区间：新品期 15%–25%、扩张期 10%–15%、成熟期 7%–10%、收获期低于 7%，并强调不同 ASIN 应按各自利润率与生命周期独立设定目标，而非套用通用基准。文章还建议每周检查 Campaign ACoS、每月复核 True ACoS，并在 Q4 前重新计算。","digestUpdatedAt","2026-10-17T10:41:25.811Z","summary","excerpt","latest","My Amazon Guy 发文介绍按广告前利润率与目标净利率推导理想 True ACoS 的方法。","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","v75zajzx2jryg82yefe55zclx","如何确定亚马逊 PPC 的理想 True ACoS 并设定广告目标","My Amazon Guy 提出通过计算广告前利润率、扣除目标净利率并按增长阶段调整，再除以广告销售占比来推导理想 True ACoS 及 Campaign ACoS。True ACoS 基于总销售额（含自然订单）衡量整体广告成本，比仅看直接转化的 Campaign ACoS 更贴近业务利润底线。不同 ASIN 需根据各自利润率与生命周期独立设定目标，避免套用通用基准导致预算错配。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://myamazonguy.com/advertising/how-to-find-the-ideal-true-acos-on-amazon-ppc/","selected",false,"factId","fUdnjmuhNKaY","author-myamazonguy-ken-zhou-rolling","name","My Amazon Guy · Ken Zhou","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/2367a94bae94b1de.webp",{"_56":57,"_11":44,"_67":-5,"_18":19,"_15":16,"_68":69},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":70,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersion","2026-10-09T22:08"]
