[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39},"publicId","7225740f-075f-4020-a13e-27747090ac77","title","Costco 9月净营收300.2亿美元同比增13%","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T07:09:53.000Z","latestAt","digest","2026年10月15日，蓝海亿观网援引Costco公布的截至10月4日的9月业绩报道：净营收300.2亿美元，同比增长13%；全球可比销售增长11.4%，其中美国增长12.5%、加拿大增长6.3%、其他国际增长10.8%；电商销售增长19%；全球客单价增长6.4%，客流量增长4.7%。同一报道还汇总了其他跨境电商动态：WhatsApp测试定时发送消息功能，可设定未来一年内任意时间；印度Meesho大促首日订单同比增约75%，AI推荐促成85%订单；TikTok Shop菲律宾联合Converge与菲贸工部推出SellerPlus计划，新入驻卖家享90天零佣金；俄罗斯M.Video电商平台前九个月营业额228亿卢布，同比增长202%；美国CPSC召回PACEARTH品牌约11.055万件U型秋千座椅，涉至少30起坠落事故、至少9人受伤。上述为目前该事件的全部报道内容，暂无后续进展。","digestUpdatedAt","2026-10-17T10:35:28.527Z","summary","excerpt","latest","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_36":-5},"developments",[65],"officialReports",[],"timeline",[40],"heat",[],"related",[],{"_41":42,"_11":43,"_25":44,"_45":46,"_47":19,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":56},"id","p959nqzf918n9lo1mj20s8c8y","Costco 9月净营收300.2亿美元，同比增13%","Costco公布截至10月4日的9月业绩，净营收达300.2亿美元，同比增长13%。全球可比销售增长11.4%，其中美国市场增长12.5%，电商销售增长19%。","source",{"_41":57,"_58":59,"_60":61,"_62":54,"_63":64},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.egainnews.com/article/74381","selected",false,"factId","fH_a49tkrbVY","publisher-egainnews-articles","name","蓝海亿观网 · 跨境电商资讯","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/bf9841f40884e812.webp",{"_55":56,"_11":66,"_67":-5,"_18":19,"_15":16,"_68":69},"美国CPSC召回亚马逊在售秋千座椅","occurredAt","representative",{"_41":42,"_11":43,"_25":44,"_45":70,"_47":19,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":56},{"_41":57,"_58":59,"_60":61,"_62":54,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersion","2026-10-09T22:08"]
