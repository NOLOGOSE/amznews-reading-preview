00.000Z",10.8,"2026-10-23T18:00:00.000Z",11.1,"2026-10-23T17:00:00.000Z",11.5,"2026-10-23T16:00:00.000Z",11.8,"2026-10-23T15:00:00.000Z",12.2,"2026-10-23T14:00:00.000Z",12.5,"2026-10-23T13:00:00.000Z",12.9,"2026-10-23T12:00:00.000Z",13.3,"2026-10-23T11:00:00.000Z",13.6,"2026-10-23T10:00:00.000Z",14,"2026-10-23T09:00:00.000Z",14.4,"2026-10-23T08:00:00.000Z",14.9,"2026-10-23T07:00:00.000Z",15.3,"2026-10-23T06:00:00.000Z",15.8,"2026-10-23T05:00:00.000Z",16.2,"2026-10-23T04:00:00.000Z",16.7,"2026-10-23T03:00:00.000Z","2026-10-23T02:00:00.000Z","2026-10-23T01:00:00.000Z",13.7,"2026-10-23T00:00:00.000Z",14.1,"2026-10-22T23:00:00.000Z",14.5,"2026-10-22T22:00:00.000Z","2026-10-22T21:00:00.000Z",15.4,"2026-10-22T20:00:00.000Z","2026-10-22T19:00:00.000Z",16.3,"2026-10-22T18:00:00.000Z",16.8,"2026-10-22T17:00:00.000Z",7.5,"2026-10-22T16:00:00.000Z",7.8,"2026-10-22T15:00:00.000Z",8,"2026-10-22T14:00:00.000Z",8.2,"2026-10-22T13:00:00.000Z",8.5,"2026-10-22T12:00:00.000Z",8.7,"2026-10-22T11:00:00.000Z",9,"2026-10-22T10:00:00.000Z",9.2,"2026-10-22T09:00:00.000Z",9.5,{"_220":245,"_11":246,"_26":247,"_224":248,"_226":21,"_228":229,"_230":-5,"_231":249,"_233":234,"_235":236},{"_220":221,"_11":222,"_26":223,"_224":225,"_226":227,"_228":229,"_230":-5,"_231":232,"_233":234,"_235":236},"id","ju5cf65w4jgo87plls5uiwhyz","沃尔玛推出 Agent Gateway 允许 AI 代理代客购物，亚马逊则继续封堵","沃尔玛推出 Agent Gateway，这是一个 MCP 服务器，允许经批准的 AI 代理在 Walmart 和 Sam’s Club 搜索库存并下单，代理无需获取用户的个人详情或订单历史。沃尔玛 CEO John Furner 周三在旧金山发布该服务。原文称，从下月起，Agent Profiles 将为每个代理在客户账户中建立独立档案，使代理订单与客户订单分开；每笔购买需经客户批准，或保持在客户设定的消费上限内。沃尔玛条款禁止代理超出购物者要求或接触支付详情，代理下错单时退货政策仍然适用。原文还称，亚马逊在 9 月开始封堵 AI 代理，包括沃尔玛合作伙伴 Meta 的 Muse。","source",{"_220":237,"_238":239,"_240":241,"_242":234,"_243":244},"publishedAt","2026-10-22T15:57:45.000Z","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.shopifreaks.com/walmart-launches-agent-gateway-so-ai-agents-can-shop-for-customers-while-amazon-keeps-blocking-agents-from-buying-on-its-site/","selected",false,"factId","fWxX72jKf1KQ","publisher-shopifreaks-news","name","Shopifreaks · 电商行业快讯","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/142f20f64079a020.webp","f9d1acp7wporu9qroqzmmg74a","沃尔玛推出代理档案与网关，开放AI代理购物权限","沃尔玛宣布将在未来一个月内推出“代理档案”并测试“代理网关”，允许用户授权AI代理在设定限额内购物或进行审批。该方案基于MCP协议，旨在让外部AI连接服务时不共享用户个人信息，与亚马逊限制Perplexity等代理的做法形成对比。",{"_220":250,"_238":251,"_240":241,"_242":234,"_243":-5},"https://mjzj.com/article/g21zclyoterk","publisher-mjzj-feed","卖家之家 · 跨境资讯",{"_235":236,"_11":253,"_254":-5,"_18":227,"_15":16,"_255":256},"沃尔玛推出Agent Gateway允许AI智能体下单","occurredAt","representative",{"_220":221,"_11":222,"_26":223,"_224":257,"_226":227,"_228":229,"_230":-5,"_231":232,"_233":234,"_235":236},{"_220":237,"_238":239,"_240":241,"_242":234,"_243":244},"participants48h","newParticipants6h",0,"recentReports24h","observationComplete",true,"rank",{"_266":267},"changelogVersion","2026-10-09T22:08"]
