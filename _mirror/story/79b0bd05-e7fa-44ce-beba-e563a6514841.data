[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","79b0bd05-e7fa-44ce-beba-e563a6514841","title","亚马逊SEND海运开通中英中德航线","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-12T01:33:36.752Z","latestAt","digest","2026年10月12日，有媒体报道称，亚马逊跨境承运伙伴方案（Amazon SEND）正式开通中国至英国、德国的海运服务，可选承运商目前包括美通供应链（AAF）和九方通逊（Jiufang）。报道称，卖家可在卖家平台完成下单、查价与货件追踪，使用亚马逊协议价，国内仓库入仓费用和中转费全免，并支持预约上门取件或自送承运商就近集货点两种方式。报道给出的参考时效为：中国至英国海运45–58天送达，中国至德国海运47–63天送达，并注明时效仅供参考、实际可能受多种因素影响。报道还称，英德站库容紧张时SEND可协助转仓，无需卖家额外操作。需注意，该内容为亚马逊SEND服务的推广信息，存在相关商业利益，并非独立测评；文中价格、时效等主张来自原文，本站尚未独立核验。","digestUpdatedAt","2026-10-17T10:49:56.208Z","summary","excerpt","latest","报道称亚马逊SEND海运新开通中国至英国、德国航线，可选承运商为美通供应链和九方通逊。","whyHot",{"_73":74,"_75":74,"_76":74,"_77":78,"_79":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","le3eoh2wsead7z95sa64zopc2","亚马逊SEND海运服务开通中国至英国和德国航线","原文介绍亚马逊跨境承运伙伴方案（Amazon SEND）开通中国至英国、德国的海运服务，目前可选承运商包括美通供应链（AAF）和九方通逊（Jiufang）。原文称该服务在卖家平台提供下单、查价与货件追踪，使用亚马逊协议价，国内仓库入仓费用和中转费全免，并支持上门取件或自送集货点两种方式。原文为亚马逊SEND服务的推广内容，存在相关商业利益，并非独立测评；文中价格、时效等主张来自原文，本站尚未独立核验。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-12","originalUrl","https://www.wearesellers.com/question/125322","selected",false,"factId","ft8fAr2zVCv8","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_57":58,"_11":68,"_69":-5,"_18":19,"_15":16,"_70":71},"Amazon SEND开通中国至英德海运航线","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":72,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64