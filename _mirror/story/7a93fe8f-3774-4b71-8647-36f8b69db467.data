[{"_1":2,"_3":4},"root",{"_5":84},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":-5,"_23":-5,"_24":-5,"_25":26,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39},"publicId","7a93fe8f-3774-4b71-8647-36f8b69db467","title","亚马逊 Influencer Program 与 Associates 新手收益对比","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-11T13:00:00.000Z","latestAt","2026-10-15T13:00:00.000Z","digest","digestUpdatedAt","summary","excerpt",{"_82":49,"_83":64},"latest","whyHot",{"_75":76,"_77":76,"_78":76,"_79":80,"_81":-5,"_36":-5},"developments",[70],"officialReports",[],"timeline",[45],"heat",[],"related",[40],{"_9":41,"_11":42,"_43":38,"_20":44},"f9efc448-df18-47c9-a6f6-919a8c87a76a","亚马逊创作者视频佣金模式与品类费率解析","relation","2026-10-18T13:00:00.000Z",{"_46":47,"_11":48,"_24":49,"_50":51,"_52":19,"_53":54,"_55":-5,"_56":57,"_58":59,"_60":61},"id","hk5kxsw8s4u77di5h2h06v7r2","亚马逊达人计划收入区间与选品因素（含工具方推广）","原文讨论亚马逊达人（Amazon Influencer）通过产品视频赚取佣金，收入来自销售佣金而非观看量。文中给出的各阶段收入区间（如首两月 $0-$100、100-200 个视频时 $300-$1,500、400-500 个视频时 $1,500-$3,000 以上、头部加品牌合作 $5,000-$10,000）引自 Hubfluence（2026）和 Ainfluencer（2026）等第三方创作者收入报告，并非亚马逊官方数据，本站尚未独立核验这些引用；原文亦说明应将其视为区间而非保证。作者认为收入更取决于选品（产品需求、佣金类别、视频位置、视频库规模、品牌合作），并给出估算公式与选品流程，这些属于作者观点，适用前提是产品确有需求且视频被亚马逊放置到商品页。原文来自 Zonbase，存在相关商业利益（推广其 ACE 工具与免费培训），并非独立测评。","source",{"_46":62,"_63":64,"_65":66,"_67":59,"_68":69},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.zonbase.com/blog/how-much-money-can-you-make-reviewing-amazon-products/","selected",false,"factId","f_v54C9ikcY4","rss-zonbase-prelaunch","name","ZonBase","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/534ea8c1139e7673.webp",{"_60":61,"_11":12,"_71":-5,"_18":19,"_15":16,"_72":73},"occurredAt","representative",{"_46":47,"_11":48,"_24":49,"_50":74,"_52":19,"_53":54,"_55":-5,"_56":57,"_58":59,"_60":61},{"_46":62,"_63":64,"_65":66,"_67":59,"_68":69},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_85":86},"changelogVersion","2026-10-09T22:08"]
