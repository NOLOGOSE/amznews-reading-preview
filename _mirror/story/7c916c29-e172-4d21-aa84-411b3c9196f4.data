[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","7c916c29-e172-4d21-aa84-411b3c9196f4","title","亚马逊卖家主推ASIN自然排名下滑","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-16T03:50:15.264Z","latestAt","digest","2026年10月16日，有卖家在知无不言发帖反映，其产品三个核心词的自然排名此前长期位居第一，近期开始下降甚至消失，其他变体则出现在第8至10名。该卖家称，涉事主推ASIN点击量占比46.13%、销量占比46.29%，价格低于其他变体，每日销量最高，广告转化率在10个投放变体中排第4，且无绩效问题、差评或店铺异常，链接仍遥遥领先第二名。卖家开case咨询后，客服称可能是算法变化，认为其他变体销售表现优于该ASIN。卖家对此存疑，因该主推ASIN广告转化率仍领先第二名较多，遂向其他卖家请教原因与恢复方法。目前事件仍停留在卖家求助阶段，尚无平台正式回应或后续进展。","digestUpdatedAt","2026-10-17T10:31:15.841Z","summary","excerpt","latest","卖家反映主推ASIN核心词自然排名下滑消失，客服称或为算法变化。","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","jl0yjke2i3c6z4062thi46z9n","亚马逊主推ASIN自然排名下滑原因与恢复建议","卖家反馈其核心词自然排名第一的主推 ASIN 近期排名下滑甚至消失，尽管该 ASIN 点击量占比 46.13%、销量占比 46.29%，且价格更低、无绩效问题。客服称可能是算法变化导致其他变体销售表现更优，但卖家指出主推 ASIN 广告转化率在 10 个变体中排第 4，仍遥遥领先第二名。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.wearesellers.com/question/125506","selected",false,"factId","fkN1BMibiOnI","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_56":57,"_11":44,"_67":-5,"_18":19,"_15":16,"_68":69},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":70,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersion","2026-10-09T22:08"]
