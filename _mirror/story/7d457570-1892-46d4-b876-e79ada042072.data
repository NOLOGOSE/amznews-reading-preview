[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","7d457570-1892-46d4-b876-e79ada042072","title","亚马逊美国站2026年启用八级尺寸分段","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-02T15:00:00.000Z","latestAt","digest","亚马逊美国站自2026年1月15日起启用八个尺寸分段，新增介于Large standard与Large Bulky之间的Small Bulky分段。据Seller Labs报道，该分段标准为最长边37英寸、中位边28英寸、最短边20英寸、长+围130英寸、重量50磅以内。报道以“你的包装箱离更便宜的FBA尺寸分段只差一英寸吗”为题，提示包装尺寸接近分段边界的卖家可能因一英寸之差落入不同分段。目前公开报道仅涉及分段数量与Small Bulky的具体门槛，尚未见关于费率变化或其他分段调整的进一步信息。","digestUpdatedAt","2026-10-02T16:37:38.225Z","summary","excerpt","latest","亚马逊美国站确认2026年1月15日起启用八级尺寸分段，新增Small Bulky。","whyHot",{"_73":74,"_75":74,"_76":74,"_77":55,"_78":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","y1g774571l76ubtjtuteq1apw","亚马逊2026年FBA尺寸分级下如何通过包装优化降低履约费","针对2026年1月15日生效的亚马逊美国站新尺寸分级（含新增Small Bulky），作者提出通过对比SKU实测尺寸与分级界限来识别可降费的包装机会。文章给出了基于Fee Preview报告的数据提取方法、年化节省额计算公式及回本周期评估模型，并列举了因体积重计费导致高费用的典型案例。","source",{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.sellerlabs.com/blog/amazon-fba-size-tiers-2026-packaging/","selected",true,"factId","fDq-rxFszfvA","rss-sellerlabs-prelaunch","name","Seller Labs","kind","rss","firstParty",false,"iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp",{"_56":57,"_11":12,"_68":69,"_18":19,"_15":16,"_70":71},"occurredAt","2026-01-14T16:00:00.000Z","representative",{"_42":43,"_11":44,"_25":45,"_46":72,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
