[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","7f102c7f-b1d8-4b38-b9b4-536c8226f0e7","title","亚马逊广告宣布与OpenAI合作试点ChatGPT Ads","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-08T08:00:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_78":43,"_79":59},"latest","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_35":-5},"developments",[65],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},"id","t22nu9c26apn93jyviea0m49w","亚马逊广告接入 ChatGPT，美国部分广告主试点对话式广告","2026年9月10日，亚马逊广告宣布与 OpenAI 合作，支持通过 ChatGPT 上的对话式广告体验拓展活动。目前仅美国部分广告主参与试点，Seller Central 未向所有卖家开放自助入口，普通商品也无法直接在 ChatGPT 内完成购买。该变化标志着购物决策从搜索框延伸至对话框，卖家应优先完善 Listing 的场景描述与属性信息，以适应自然语言检索逻辑。","source",{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-08","originalUrl","https://www.amz123.com/t/qwpuBpPt","selected",false,"factId","fPgZGq--fmWs","author-amz123-cc-listing-check-reviewed","name","AMZ123 · CC站外推广","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_55":56,"_11":12,"_66":67,"_18":19,"_15":16,"_68":69},"occurredAt","2026-09-09T16:00:00.000Z","representative",{"_40":41,"_11":42,"_23":43,"_44":70,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_81":82},"changelogVersion","2026-10-09T22:08"]
