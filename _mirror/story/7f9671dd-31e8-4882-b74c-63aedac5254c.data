[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","7f9671dd-31e8-4882-b74c-63aedac5254c","title","Mike Begg分享家居品牌广告预算重平衡案例","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-12T00:00:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_77":43,"_78":59},"latest","whyHot",{"_70":71,"_72":71,"_73":71,"_74":75,"_76":-5,"_35":-5},"developments",[65],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},"id","dj0fmdms1zghd99g0kydaglbg","Mike Begg 分享家居品牌通过 Bid-and-Budget Rebalance 策略实现销量增长与 ACOS 降低的案例","Mike Begg 分享一个家居品牌案例：通过“Bid-and-Budget Rebalance”策略，该品牌周销售额从 $11,981.70 增至 $18,527.10（增长 54.6%），同时 ACOS 从 24.35% 降至 13.79%。该策略核心在于根据表现重新分配预算和出价，将资金集中于高转化目标并削减低效支出，而非单纯增加总预算。此为作者提供的个案经验，具体效果因账户而异。","source",{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-12","originalUrl","https://mikebegg.me/case-studies/bid-budget-rebalance-home-goods","selected",false,"factId","f4YB1vPmbsL8","author-mikebegg-reviewed-cases","name","Mike Begg","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/17e3b731411d4578.webp",{"_55":56,"_11":12,"_66":-5,"_18":19,"_15":16,"_67":68},"occurredAt","representative",{"_40":41,"_11":42,"_23":43,"_44":69,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_80":81},"changelogVersion","2026-10-09T22:08"]
