[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","839dc835-13d0-4ace-b143-3ebb2366e29a","title","亚马逊卖家广告转化困境与类目错放风波","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-11T21:07:57.394Z","latestAt","digest","2026年10月11日，一名亚马逊卖家在知无不言发帖求助。其A产品售价从21.99美元加15%优惠券降至17.99美元加15%优惠券，总曝光53,600、点击467、花费545.1美元，仅出39单；手动精准3组竞价0.8并加顶部和其余位置40%的bid后订单反而减少，卖家不确定是CPC够不到顶部还是链接仅一个评论导致转化差。B产品总曝光46,280、点击508、花费532.99美元，出48单；因平台放错类目，小类排名一度到第31名，后被平台改回，排名跌至2852名，卖家已关闭广告，等待Vine计划回评后翻新链接重新推。此外，A产品因图片风格相似被判定版权图片滥用侵权，申诉未通过，卖家咨询是否找服务商“内部恢复”，原文提到服务商报价2300。","digestUpdatedAt","2026-10-17T10:51:46.081Z","summary","excerpt","latest","卖家A产品因图片风格相似被判版权侵权，二次申诉中并咨询服务商“内部恢复”。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","cz3od2tt69wgg8d9fjkkeag1f","亚马逊卖家求助：A产品降价加券曝光高转化低，B产品因类目错放排名暴跌","卖家分享A产品在17.99美元售价配15%优惠券下，曝光53,600仅出39单，手动精准3组竞价0.8加顶部和其余位置40%的bid后订单反降，作者不确定是否因CPC够不到顶部或链接仅一个评论致转化差。B产品因平台放错类目致小类排名从31跌至2852，卖家关闭广告等待Vine计划回评以翻新链接。此外，A产品因图片风格相似被判定版权侵权申诉失败，卖家咨询是否需找服务商“内部恢复”，原文提到服务商报价2300，存在相关商业利益，并非独立测评。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-12","originalUrl","https://www.wearesellers.com/question/125305","selected",false,"factId","fawHq2Vqg0Qg","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_57":58,"_11":44,"_68":-5,"_18":19,"_15":16,"_69":70},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
