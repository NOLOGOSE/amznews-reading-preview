[{"_1":2,"_3":4},"root",{"_5":81},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","85adaa4a-85a0-4a7e-9351-4724364fe319","title","亚马逊启动2027新卖家入驻并推扶持政策","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-11T20:57:00.000Z","latestAt","digest","2026年9月，亚马逊全球开店宣布启动2027年新卖家入驻。据2026年10月11日报道，官方推出的优惠包括多站点最高55万美元销售佣金抵扣、部分订单销售佣金低至5%、配送费用最高节省24%、广告优惠券最高1000美元，具体领取条件、使用期限和适用范围因站点和经营场景而异。官方还介绍商机探测器、选品指南针、物流收入计算器、Gen AI Listing和卖家助手等AI工具。注册需准备企业营业执照等五类资料，营业执照须存续且距到期超过45天，使用实际经营地址可能需补充近90天公共事业账单；注册后还需完成身份验证，美国站需通过税务审核，否则买家无法看到商品。","digestUpdatedAt","2026-10-17T10:52:07.239Z","summary","excerpt","latest","2026年10月报道梳理2027新卖家入驻的扶持政策、注册资料与审核要求。","whyHot",{"_74":75,"_76":75,"_77":75,"_78":79,"_80":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","yodhqa6ybuouakn0uxjkj0inx","亚马逊全球开店启动2027新卖家入驻，提供最高55万美元佣金抵扣及AI工具支持","亚马逊全球开店于2026年9月宣布启动2027年新卖家入驻。官方推出多站点最高55万美元销售佣金抵扣、部分订单佣金低至5%等优惠，并提供商机探测器等AI工具辅助运营。卖家需提前准备营业执照等五类资料完成注册，并注意不同站点的合规要求及身份验证流程。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-12","originalUrl","https://www.amz123.com/t/8ZV02kSA","selected",false,"factId","fmYGT5hsYWWg","author-amz123-moonsees-reviewed","name","AMZ123 · 跨境电商MoonSees","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_57":58,"_11":68,"_69":70,"_18":19,"_15":16,"_71":72},"亚马逊启动2027新卖家入驻及扶持政策","occurredAt","2026-08-31T16:00:00.000Z","representative",{"_42":43,"_11":44,"_25":45,"_46":73,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_82":83},"changelogVersion","2026-10-09T22:08"]
