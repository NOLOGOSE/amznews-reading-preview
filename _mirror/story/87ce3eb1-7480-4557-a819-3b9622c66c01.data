[{"_1":2,"_3":4},"root",{"_5":81},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","87ce3eb1-7480-4557-a819-3b9622c66c01","title","亚马逊 SP-API 新增 IVP 受众值及多项更新","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-14T21:09:44.000Z","latestAt","digest","2026年10月14日，亚马逊 SP-API 发布更新公告。自2026年10月15日起，EU5（英国、德国、法国、意大利、西班牙）、日本和加拿大站点的 Listings Items API 在 purchasable_offer.audience 字段中接受新的行业垂直定价（IVP）受众值，适用于已注册 Amazon Business IVP 计划的第三方卖家；IVP 支持单件折扣与数量折扣，此次扩展是在2026年5月美国站点支持 IVP 之后。公告还称，自2026年10月26日起，亚马逊将更新多个站点众多商品类型的属性使用与枚举值，影响使用 Listings Items API v2021-08-01 和 JSON_LISTINGS_FEED 创建、编辑带报价商品的公私开发者，纯商品列表、XSD 与 XML 上传不受影响。自2026年10月28日起，通过 Amazon Autos 销售车辆的英国站点卖家，其 ORDER_CHANGE 通知将包含 PreFulfillmentStatusChange 类型值及可选的 Summary.PreFulfillmentStatus 字段。","digestUpdatedAt","2026-10-17T10:39:04.433Z","summary","excerpt","latest","SP-API 公告：10月15日起 EU5、日本、加拿大站点 Listings Items API 支持新 IVP 受众值。","whyHot",{"_75":76,"_77":76,"_78":76,"_79":64,"_80":-5,"_37":-5},"developments",[69],"officialReports",[67],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","qaax8vwj8iy2s7s5of1cyuem8","亚马逊 SP-API 更新：EU5/JP/CA 站点新增 IVP 受众值、10月属性枚举变更及 Amazon Autos 订单通知类型","亚马逊 SP-API 于 2026-10-15 起在 EU5、JP 和 CA 站点的 Listings Items API 中支持新的行业垂直定价（IVP）受众值，适用于已注册 Amazon Business IVP 计划的第三方卖家。","source",{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://developer-docs.amazon/sp-api/changelog/sp-api-updates-new-listings-items-api-ivp-values-in-eu5-jp-and-ca-stores-october-updates-to-listing-attribute-usage-and-enumeration-values-and-a-new-notifications-api-order-change-type-value","selected",false,"factId","ftzfZUkexQY8","official-amazon-spapi-updates","name","Amazon SP-API 更新","kind","rss","firstParty",true,"iconUrl","/amznews-reading-preview/_img/9b8d2c0eb5b987fc.webp",{"_42":43,"_11":44,"_25":45,"_46":68,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},{"_56":57,"_11":70,"_71":-5,"_18":19,"_15":16,"_72":73},"亚马逊 SP-API 更新：EU5/JP/CA 站点新增 IVP 受众值、10月属性枚举变更及 Amazon Autos","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":74,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_82":83},"changelogVersion","2026-10-09T22:08"]
