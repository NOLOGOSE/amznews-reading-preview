[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","8988c4a0-0d0e-4b38-a55c-7cf6df48c776","title","亚马逊红海类目BS1卖家为何难降广告支出","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T03:01:39.985Z","latestAt","digest","2026年10月15日，知无不言作者“阿浩的广告复盘”发文分析亚马逊大红海类目BS1卖家的广告困境。其链接最近7天广告出4800单，整体转化率64%，但ACOS仍偏高。作者称，因大量竞争对手紧盯第一位置，稍降竞价排名就可能被挤下，故需持续以较高成本维持。核心词数据：一词出2250单、广告转化率56.6%，自然第一与第二日订单差距接近1000单；二词出520单、转化率约63%，ACOS已亏损，但为维持自然第一（每天约多100单）仍继续投放，且分时排名仍会掉到第二；三词出1141单、转化率178%，自然排名稳定第一，作者选择不调整。作者总结，蓝海类目排名稳定后可逐步减少广告支出，超级红海类目一旦减少投入就会被抢位，不能仅凭ACOS判断广告价值。","digestUpdatedAt","2026-10-17T10:37:05.999Z","summary","excerpt","latest","作者称红海类目BS1仍需高广告成本守排名，不能仅凭ACOS决策。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","mje02vnm4dy168b0qcjjkw1c9","亚马逊红海类目BS1卖家为何难降广告支出：需平衡自然排名与维持成本","原文作者分析指出，在亚马逊大红海类目中，即使商品详情页（Listing）做到小类第一（BS1），卖家仍需维持高广告成本以稳固自然排名。数据显示核心关键词自然排名第一与第二的日订单量差距可达约1000单，且部分亏损广告因能带来额外自然订单而整体盈利。作者强调，在竞争激烈的红海类目，降低竞价可能导致排名迅速下滑，因此不能仅凭ACOS判断广告价值，需结合自然排名稳定性综合决策。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-15","originalUrl","https://www.wearesellers.com/question/125448","selected",false,"factId","foIEFAptTQpc","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_57":58,"_11":44,"_68":-5,"_18":19,"_15":16,"_69":70},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
