":192,"_24":193,"_194":195,"_196":19,"_197":198,"_199":200,"_201":202,"_203":204,"_205":206},"id","iphi67ilsdtqhdax776oy69wr","波兰拟扩大电商检查权限，违规最高罚年营业额10%","波兰竞争与消费者保护局（UOKiK）计划扩大执法人员权限，允许其以普通消费者身份实际购买商品以检验销售流程。新规赋予监管机构要求发布警告、删除内容或限制访问等管理手段，侵害消费者集体利益者最高面临相当于年度营业额10%的罚款。","source",{"_190":207,"_208":209,"_210":211,"_212":204,"_213":214},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-20","originalUrl","https://www.amz123.com/t/jgp2MFtQ","selected",false,"factId","foFkGeHb9Pvc","publisher-amz123-headlines","name","AMZ123 · 跨境头条","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_205":206,"_11":12,"_216":-5,"_18":19,"_15":16,"_217":218},"occurredAt","representative",{"_190":191,"_11":192,"_24":193,"_194":219,"_196":19,"_197":198,"_199":200,"_201":202,"_203":204,"_205":206},{"_190":207,"_208":209,"_210":211,"_212":204,"_213":214},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_230":231},"changelogVersion","2026-10-09T22:08"]
