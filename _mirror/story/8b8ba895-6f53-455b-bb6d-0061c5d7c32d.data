T18:00:00.000Z",13.6,"2026-10-21T17:00:00.000Z",14,"2026-10-21T16:00:00.000Z",14.4,"2026-10-21T15:00:00.000Z",14.9,"2026-10-21T14:00:00.000Z",15.3,"2026-10-21T13:00:00.000Z",15.7,"2026-10-21T12:00:00.000Z",16.2,"2026-10-21T11:00:00.000Z",16.7,{"_187":212,"_11":213,"_27":214,"_191":215,"_193":216,"_194":195,"_196":197,"_198":217,"_200":201,"_202":203},{"_187":188,"_11":189,"_27":190,"_191":192,"_193":20,"_194":195,"_196":197,"_198":199,"_200":201,"_202":203},"id","w4fehohdck5mrvysrutj6mlf4","插画师Franziska Paetzold起诉66名卖家：圣诞备货前需核对书架猫等图案授权","Keith律所代理插画师Franziska Paetzold于2026-10-20提起版权诉讼，涉及66名被告及5幅登记作品。经营挂毯、杯子等印花商品的卖家需在圣诞备货前，严格核对“书架上的猫”等具体图案的授权范围与来源凭证，避免仅凭删除商品或更换配色误判风险解除。","source",{"_187":204,"_205":206,"_207":208,"_209":201,"_210":211},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-21","originalUrl","https://www.amz123.com/t/4KchwRwn","selected",false,"factId","fT8YvvlZENVM","publisher-amz123-headlines","name","AMZ123 · 跨境头条","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","l33pb4lppdabpjj8imi2mydeo","Keith律所代理德国插画师Franzi Draws发起版权诉讼（案号26-cv-02270）","据原文，Keith & Ference律所代理德国插画师Franziska Paetzold（Franzi Draws）就5幅矢量插画提起版权诉讼，案号26-cv-02270，起诉时间为2026年10月20日。原文标题提及66名卖家，但正文未列出被告人数，本站尚未独立核验该数字及诉讼文书。原文建议卖家按图排查多平台相似图案，并在收到平台冻结或法院材料时依据案号核验TRO是否真实签发，再在21天响应窗口期内联系专业律师；该期限的起算与适用条件原文未说明。",{"_187":204,"_205":206,"_207":208,"_209":201,"_210":211},"2026-10-21T01:52:00.000Z","https://www.amz123.com/t/ZDEdHEej",{"_202":203,"_11":219,"_220":221,"_19":20,"_15":16,"_222":223},"插画师Franziska Paetzold起诉66名卖家侵犯版权","occurredAt","2026-10-19T16:00:00.000Z","representative",{"_187":188,"_11":189,"_27":190,"_191":224,"_193":20,"_194":195,"_196":197,"_198":199,"_200":201,"_202":203},{"_187":204,"_205":206,"_207":208,"_209":201,"_210":211},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_233":234},"changelogVersion","2026-10-09T22:08"]
