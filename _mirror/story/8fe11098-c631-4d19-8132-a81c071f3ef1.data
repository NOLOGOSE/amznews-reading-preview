[{"_1":2,"_3":4},"root",{"_5":95},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41},"publicId","8fe11098-c631-4d19-8132-a81c071f3ef1","title","CPSC召回PACEARTH秋千座椅","status","settled","reportCount",2,"sourceCount","firstReportAt","2026-10-08T00:00:00.000Z","latestAt","2026-10-13T00:00:00.000Z","digest","2026年10月8日，美国消费品安全委员会（CPSC）宣布召回约110,550个PACEARTH U型秋千座椅，召回编号27-019。产品因金属登山扣、快速连接扣或织带可能在使用中断裂，存在坠落致严重伤害风险。Pacearth Direct已收到至少30起跌落报告，至少9人受伤，包括骨折、头部受伤和淤青。涉事产品有绿、蓝、粉、红、青绿等颜色，链条包裹黄色塑料，配黄色织带，分单件装和双件装，2017年5月至2026年6月在Amazon.com销售，售价27至57美元，由中国制造，销售商为加州工业市的Pacearth Direct。CPSC要求消费者立即停用，用永久性记号笔在座椅上写“RECALLED”并拍照（含PACEARTH标识）发至recall@pacearth.com，联系Pacearth Direct获取全额退款。10月13日，AMZ123报道了同一召回，称约11.055万件，与CPSC公布的数量一致。","digestUpdatedAt","2026-10-17T10:47:26.432Z","summary","excerpt","latest","10月13日媒体跟进报道CPSC召回约11.055万件PACEARTH秋千座椅，与官方数量一致。","whyHot",{"_89":90,"_91":90,"_92":90,"_93":67,"_94":-5,"_38":-5},"developments",[82],"officialReports",[80],"timeline",[42,43],"heat",[],"related",[],{"_44":70,"_11":71,"_26":72,"_48":73,"_50":21,"_51":52,"_53":74,"_55":75,"_57":58,"_59":60},{"_44":45,"_11":46,"_26":47,"_48":49,"_50":19,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60},"id","zgoamn835o2uzoj0to50koamb","美国CPSC召回PACEARTH秋千座椅，因断裂致坠落风险","美国消费品安全委员会（CPSC）宣布召回约110,550个PACEARTH U型秋千座椅，因金属扣件或织带可能在使用中断裂导致严重坠落伤害。该问题已引发至少30起跌落报告及9人受伤。消费者应立即停用并联系Pacearth Direct获取全额退款，该产品曾于2017年5月至2026年6月在Amazon.com销售。","source",{"_44":61,"_62":63,"_64":65,"_66":67,"_68":69},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-08","originalUrl","https://www.cpsc.gov/Recalls/2027/Pacearth-Direct-Recalls-PACEARTH-Swing-Seats-Due-to-Risk-of-Serious-Injury-from-Fall-Hazard","selected",false,"factId","fCHW8vLQuD64","official-cpsc-amazon-recalls-reviewed","name","CPSC 美国消费品安全委员会","kind","json_list","firstParty",true,"iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp","kthytn4227anjj6bxjhqbvy9b","美国CPSC召回11万件亚马逊在售PAC EARTH秋千座椅","美国消费品安全委员会（CPSC）发布公告，紧急召回在Amazon.com销售的约11.055万件PAC EARTH品牌U型秋千座椅。因产品部件可能在使用中断裂导致使用者坠落受伤，该机构要求消费者立即停用并联系卖家申请全额退款。",{"_44":76,"_62":77,"_64":78,"_66":58,"_68":79},"2026-10-13","https://www.amz123.com/t/fgKCKDcu","author-amz123-summer","AMZ123 · SUMMER","web_list","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_44":45,"_11":46,"_26":47,"_48":81,"_50":19,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60},{"_44":61,"_62":63,"_64":65,"_66":67,"_68":69},{"_59":60,"_11":83,"_84":85,"_18":19,"_15":16,"_86":87},"CPSC发布PACEARTH秋千座椅召回令","occurredAt","2026-10-07T16:00:00.000Z","representative",{"_44":45,"_11":46,"_26":47,"_48":88,"_50":19,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60},{"_44":61,"_62":63,"_64":65,"_66":67,"_68":69},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_96":97},"changelogVersion","2026-10-09T22:08"]
