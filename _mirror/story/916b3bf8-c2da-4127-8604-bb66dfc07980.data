[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","916b3bf8-c2da-4127-8604-bb66dfc07980","title","凯度与亚马逊广告发布旺季出海白皮书","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T18:50:00.000Z","latestAt","digest","2026年10月13日，凯度（Kantar）与亚马逊广告联合发布《出海新视野》和《品牌破局》两份白皮书，合计66页，聚焦旺季消费者跨渠道购物行为与AI推荐策略。白皮书称，消费者完成一次购买平均跨4.5个渠道、耗时约8.8天；76.2%的消费者在“听说→查询→下单”三个环节使用不同渠道；80.5%看到后不立即查证或购买，41.1%中途暂停后回归（近八成一周内回归）。AI助手方面，2026年其作为“唤醒触发渠道”的占比在家具为9.6%、家装改造8.3%、消费电子7.7%；82%的全球成年人近6个月用过AI助手，AI工具日活率54.2%。作者Kris据此建议卖家以多类型广告覆盖全链路、重视视频内容，并为AI短名单优化信息。","digestUpdatedAt","2026-10-17T10:43:58.589Z","summary","excerpt","latest","凯度与亚马逊广告发布两份旺季白皮书，解析跨渠道购物与AI推荐策略。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","s59up353n0gsvsv2mqi1cxboz","凯度与亚马逊联合发布白皮书，解析旺季消费者跨渠道购物行为及AI推荐策略","凯度 Kantar 与亚马逊广告联合发布《出海新视野》和《品牌破局》两份白皮书，指出消费者平均跨 4.5 个渠道、耗时约 8.8 天完成购买。数据显示 76.2% 用户在听说、查询、下单环节使用不同渠道，且 AI 助手正成为关键决策入口，在家具等品类作为“唤醒触发渠道”占比最高达 9.6%。作者 Kris 建议卖家通过多类型广告覆盖全链路，并重视视频内容及为 AI 短名单优化信息以应对旺季变化。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-14","originalUrl","https://www.amz123.com/t/PAlYGE9C","selected",false,"factId","fEoqidZ4d5Nk","author-amz123-kris-reviewed","name","AMZ123 · Kris浩","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_57":58,"_11":44,"_68":-5,"_18":19,"_15":16,"_69":70},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
