[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39},"publicId","9180fa2f-cc8d-4aa5-8a4f-e91240880881","title","亚马逊FBA部分退款可按退货原因配置","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-14T13:33:43.000Z","latestAt","digest","2026年10月14日，BellaVix 报道称，亚马逊 FBA 部分退款项目新增配置能力：美国、英国、德国、法国、意大利、西班牙和加拿大站点的卖家可按退货原因设置退款比例，最多可设三种配置，也可上传文件指定符合条件的 ASIN、退货原因和退款比例；符合条件的客户接受后保留商品，无需退回 FBA 履约中心。报道同时明确，客户是否符合部分退款资格仍由亚马逊根据客户画像和购买历史判定，不符合条件的客户继续走标准退货流程。同一报道还提及沃尔玛 Brand Highlights 功能，称符合条件的品牌可在 Seller Center 为最多 500 个商品添加图文视频内容；并引用 Adobe 数据称 Prime Big Deal Days（10月6日至7日）美国线上消费为 98.6 亿美元，同比增长 8.5%，该数据尚未经独立核验。原文来自 Bellavix，文末引导读者填写表单咨询其电商服务，存在商业利益。","digestUpdatedAt","2026-10-22T12:35:54.736Z","summary","excerpt","latest","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_36":-5},"developments",[65],"officialReports",[],"timeline",[40],"heat",[],"related",[],{"_41":42,"_11":43,"_25":44,"_45":46,"_47":19,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":56},"id","qykopqj0jfcqjdyoi4s7ijmdx","亚马逊Q4截止日、沃尔玛Brand Highlights及AI购物趋势","亚马逊FBA部分退款项目允许美国、英国、德国、法国、意大利、西班牙和加拿大站点的卖家按退货原因配置退款比例，最多可设三种配置；但客户是否符合部分退款资格仍由亚马逊根据客户画像和购买历史判定。沃尔玛推出Brand Highlights功能，符合条件的品牌可在Seller Center为最多500个商品添加图文视频内容。原文引用Adobe数据称，Prime Big Deal Days期间（10月6日至7日）美国线上消费为98.6亿美元，同比增长8.5%，本站尚未独立核验该引用。原文来自Bellavix，文末引导读者填写表单咨询其电商服务，存在相关商业利益，并非独立测评。","source",{"_41":57,"_58":59,"_60":61,"_62":54,"_63":64},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.bellavix.com/amazon-q4-deadlines-walmart-fulfillment-and-ais-new-buy-box/","selected",false,"factId","fCxQnO1kpbcY","bellavix-marketplace-insights-rolling","name","BellaVix · Amazon与Walmart运营洞察","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/21e5bebf630b7ade.webp",{"_55":56,"_11":66,"_67":-5,"_18":19,"_15":16,"_68":69},"亚马逊更新FBA部分退款配置及Q4运营要点","occurredAt","representative",{"_41":42,"_11":43,"_25":44,"_45":70,"_47":19,"_48":49,"_50":-5,"_51":52,"_53":54,"_55":56},{"_41":57,"_58":59,"_60":61,"_62":54,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersion","2026-10-09T22:08"]
