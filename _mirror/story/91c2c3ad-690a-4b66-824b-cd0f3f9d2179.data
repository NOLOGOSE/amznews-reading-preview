[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","91c2c3ad-690a-4b66-824b-cd0f3f9d2179","title","Incrementum 发布 2026 Prime Big Deal Days 基准","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-14T14:01:41.000Z","latestAt","digest","2026年10月14日，亚马逊代运营机构 Incrementum Digital 发布其管理品牌的 2026 年 Prime Big Deal Days（10月6日至7日）广告与销量基准报告。报告称，活动两日日均销售额为活动前30天日均的 1.78 倍，与 2025 年的 1.78 倍持平；其中首日为 1.81 倍（2025 年为 1.79 倍），次日为 1.75 倍（2025 年为 1.76 倍）。两年均被管理的品牌营收同比增长 14.1%，而活动前日常销售基数已增长 15.5%，报告认为增长来自日常基数扩大而非活动爆发力提升。自然销售较平日增长 88%（2025 年为 85%），广告归因销售增长 51%（2025 年为 58%），广告支出增长 52%（2025 年为 74%），TACoS 较平日下降 15%（2025 年下降 2%）。品类差异明显：床垫与寝具 2.6 倍、家装 2.5 倍、服饰 2.4 倍，杂货 1.4 倍、宠物 1.3 倍。报告还引用 Numerator 数据称，91% 买家购物前知晓活动，但仅 35% 称活动是其主要购物原因，55% 曾比价。","digestUpdatedAt","2026-10-17T10:40:16.473Z","summary","excerpt","latest","Incrementum Digital 报告称 2026 年 Prime Big Deal Days 活动倍数 1.78 倍与 2025 年持平，营收增长 14.1% 源于日常基数扩大。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","dqe2jtmv171zfyd3c4pgudedy","Incrementum Digital 发布 2026 亚马逊 Prime Big Deal Days 广告与销量基准报告","亚马逊代运营机构 Incrementum Digital 公布其管理品牌的 2026 年 Prime Big Deal Days 数据，显示活动日均销售额为平日的 1.78 倍，与 2025 年持平；总营收同比增长 14.1%，主要源于日常销售基数扩大而非活动爆发力提升。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://incrementumdigital.com/blog/advertising/amazon-prime-big-deal-days-2026-results/","selected",false,"factId","fJtgz9Q38vuQ","incrementum-digital-media-rolling","name","Incrementum Digital · Amazon广告与品牌运营","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/d786c74e0c91f389.webp",{"_56":57,"_11":67,"_68":-5,"_18":19,"_15":16,"_69":70},"Incrementum发布2026 Prime Big Deal Days数据基准","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
