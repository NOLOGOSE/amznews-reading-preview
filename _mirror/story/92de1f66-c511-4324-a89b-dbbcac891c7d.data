[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","92de1f66-c511-4324-a89b-dbbcac891c7d","title","美妆品牌通过“去浪费再分配”策略将 TACoS 从 21.95% 降至 14.40%","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-12T00:00:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_76":42,"_77":58},"latest","whyHot",{"_69":70,"_71":70,"_72":70,"_73":74,"_75":-5,"_35":-5},"developments",[64],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":12,"_23":42,"_43":44,"_45":19,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55},"id","azxx90hhoab3cyq64u8bn9m58","某美妆品牌采用“去浪费再分配”策略，在两个9天对比窗口中将 TACoS 从 21.95% 降至 14.40%，销售额增加约 $18.9K。该案例由 Mike Begg 分享，核心在于先通过否定关键词和暂停高 ACOS 广告削减无效支出，再将预算重新分配至高转化活动，从而在降低广告成本的同时提升整体销售表现。","source",{"_40":56,"_57":58,"_59":60,"_61":53,"_62":63},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-12","originalUrl","https://mikebegg.me/case-studies/waste-out-tacos-cut-beauty-personal-care","selected",false,"factId","fX0T_imxKe8o","author-mikebegg-reviewed-cases","name","Mike Begg","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/17e3b731411d4578.webp",{"_54":55,"_11":12,"_65":-5,"_18":19,"_15":16,"_66":67},"occurredAt","representative",{"_40":41,"_11":12,"_23":42,"_43":68,"_45":19,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55},{"_40":56,"_57":58,"_59":60,"_61":53,"_62":63},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_79":80},"changelogVersion","2026-10-09T22:08"]
