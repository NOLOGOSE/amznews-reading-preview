[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","a10219fe-904e-4f7a-ae29-1105c7f42698","title","TikTok巴西数据中心拟6个月内开建","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T07:04:59.000Z","latestAt","digest","2026年10月15日，巴西矿业与能源部长席尔维拉宣布，TikTok巴西数据中心将于未来6个月内开建，选址塞阿拉州佩塞姆港口综合体。该项目由字节跳动与风能开发商Casa dos Ventos联合推进，投资达500亿雷亚尔（约91.1亿美元），并获卢拉政府联邦税收减免支持。报道称，项目落地后将缓解巴西短视频加载与直播延迟，提升拉美数据基础设施竞争力，并为TikTok Shop巴西业务扩张铺路。目前该项目处于宣布阶段，尚未见开工或建设进度的后续报道。","digestUpdatedAt","2026-10-17T10:35:43.148Z","summary","excerpt","latest","巴西部长宣布TikTok巴西数据中心将于未来6个月内开建，投资500亿雷亚尔。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","ctuiw2zi1fmql7wlqp4j9h7ni","TikTok巴西数据中心未来6个月内开建，投资500亿雷亚尔","巴西矿业与能源部长席尔维拉宣布，TikTok巴西数据中心将于未来6个月内开建，选址塞阿拉州佩塞姆港口综合体。该项目由字节跳动与风能开发商Casa dos Ventos联合推进，投资达500亿雷亚尔（约91.1亿美元），并获卢拉政府联邦税收减免支持。项目落地后将缓解巴西短视频加载与直播延迟，提升拉美数据基础设施竞争力，并为TikTok Shop巴西业务扩张铺路。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.egainnews.com/article/74375","selected",false,"factId","fDB0n10t3a3Q","publisher-egainnews-articles","name","蓝海亿观网 · 跨境电商资讯","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/bf9841f40884e812.webp",{"_56":57,"_11":67,"_68":-5,"_18":19,"_15":16,"_69":70},"美国CPSC召回PACEARTH秋千座椅","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersi