[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","a1536942-1b72-44db-87b0-93949548331a","title","远程医疗品牌缺席亚马逊搜索","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-02T17:27:43.000Z","latestAt","digest","2026年10月3日，播客节目 The PPC Den 中，Spillover Commerce 的 Sean Stone 指出，远程医疗是一个十亿美元级市场，但 11 家头部玩家中有 9 家缺席亚马逊。他提到 Hims 和 Ro 在亚马逊上仅销售少量非处方产品，而大型 GLP-1 品牌在亚马逊上没有相关减重产品，形成流量空白。这是目前关于该话题的唯一报道，尚无后续进展或与其他报道的矛盾信息。","digestUpdatedAt","2026-10-02T17:44:40.991Z","summary","excerpt","latest","播客指出远程医疗11家头部玩家中9家缺席亚马逊，GLP-1品牌无减重产品。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","x033xlc1kp0yat4v36iy5uk0u","十亿美元品牌缺席亚马逊搜索：GLP-1 与远程医疗的流量空白 [The PPC Den Podcast]","播客 The PPC Den 中，Spillover Commerce 的 Sean Stone 指出远程医疗是 11 家头部玩家中有 9 家缺席亚马逊的十亿美元级市场，Hims、Ro 仅售少量非处方产品，大型 GLP-1 品牌在亚马逊上没有相关减重产品。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","unknown","calendarDate","originalUrl","https://www.adbadger.com/blog/amazon-ppc-education/the-billion-dollar-brands-leaving-amazon-search-wide-open-the-ppc-den-podcast/","selected",false,"factId","fwHhlaDA-_JM","author-adbadger-thebadger","name","Ad Badger · The Badger","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/20a766fd7260a353.webp",{"_56":57,"_11":67,"_68":-5,"_18":19,"_15":16,"_69":70},"播客讨论远程医疗品牌缺席亚马逊搜索","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":