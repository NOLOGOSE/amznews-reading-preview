[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":21,"_22":23,"_24":25,"_26":-5,"_27":-5,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41},"publicId","a2b567f1-dad3-4d23-9b51-21c6b92de8d3","title","亚马逊GWD仓储服务年底前扩至七国","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-09-29T03:10:45.000Z","latestAt","2026-10-12T00:33:00.000Z","digest","2026年9月29日，AMZ123报道，亚马逊宣布将在今年年底前把全球仓储与配送服务（GWD）扩展至德国、法国、意大利、西班牙、英国、日本和加拿大七个市场。报道称，卖家可将库存集中存放在一个亚马逊运营的仓储设施中，再按各国实际需求调拨商品，无需提前分仓。亚马逊表示，与AWD相比，GWD仓储成本更低，补货至FBA最快可缩短5天。目前报道仅涉及扩展计划与上述服务说明，尚无进一步进展披露。","digestUpdatedAt","2026-10-07T02:33:51.575Z","summary","excerpt","latest","亚马逊宣布年底前将GWD扩展至欧亚七国市场。","whyHot",{"_74":75,"_76":75,"_77":75,"_78":56,"_79":-5,"_38":-5},"developments",[68],"officialReports",[],"timeline",[42],"heat",[],"related",[],{"_43":44,"_11":45,"_26":46,"_47":48,"_49":19,"_50":51,"_52":-5,"_53":54,"_55":56,"_57":58},"id","i1o8mxw9tl15fs812w7tfihbn","亚马逊宣布GWD仓储服务将扩展至欧亚洲七国","亚马逊宣布将在今年年底前把全球仓储与配送服务（GWD）扩展到欧洲、亚洲等七个市场，包括德国、法国、意大利、西班牙、英国、日本和加拿大。通过GWD，卖家可将库存集中存放在一个由亚马逊运营的设施中，再根据各国实际需求调拨商品；相比AWD，其仓储成本更低且补货至FBA的速度最快可缩短5天。","source",{"_43":59,"_60":61,"_62":63,"_64":65,"_66":67},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.amz123.com/t/n8ApZ544","selected",true,"factId","f0CSEvmoFgUo","author-amz123-summer","name","AMZ123 · SUMMER","kind","web_list","firstParty",false,"iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_57":58,"_11":69,"_70":-5,"_18":19,"_15":16,"_71":72},"亚马逊GWD仓储服务年底前扩展至七国","occurredAt","representative",{"_43":44,"_11":45,"_26":46,"_47":73,"_49":19,"_50":51,"_52":-5,"_53":54,"_55":56,"_57":58},{"_43":59,"_60":61,"_62":63,"_64":65,"_66":67},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_81":82},"changelogVersion","2026-10-09T22:08"]
