[{"_1":2,"_3":4},"root",{"_5":92},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","a5537f4b-406c-4285-83f3-c4e5192a8061","title","亚马逊广告归因偏差与 Halo Sales 解析工具","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-16T00:00:00.000Z","latestAt","digest","2026年10月16日，Make Brands Big 联合创始人 Basil Zaidi 在 ASGTG 发布客座文章，指出亚马逊 Campaign Manager 将点击产生的跨商品销售（Halo Sales）归因于被点击广告的商品，导致多 SKU 账户的产品级 ACOS 失真。文章称，购物者点击商品 A 的广告后购买商品 B，该销售仍记在 A 的广告活动下，使 A 看起来高效、B 看起来自然出单。作者以一个月销 6.1 万美元、广告归因销售 3.385 万美元的十 ASIN 照明类目样本账户为例，称其中 1.05 万美元广告销售落在非广告商品上，占广告销售的 31%。据此，其团队推出免费浏览器端工具 Account MRI，读取 Seller Central 的 Purchased Product 等报告，按广告点击商品与实际购买商品对应展示销售归属，并给出暂停某广告后的风险销售、自身 ACOS 与全貌 ACOS 及判定。文章强调样本数据非客户结果，归因本身不能证明停投后收入会流失。","digestUpdatedAt","2026-10-17T10:33:26.300Z","summary","excerpt","latest","Make Brands Big 推出免费工具 Account MRI，解析亚马逊广告跨商品归因偏差。","whyHot",{"_85":86,"_87":86,"_88":86,"_89":90,"_91":-5,"_37":-5},"developments",[80],"officialReports",[],"timeline",[54],"heat",[41,42,43,44],"related",[],{"_45":52,"_37":53,"_48":16},{"_45":50,"_37":51,"_48":16},{"_45":49,"_37":47,"_48":16},{"_45":46,"_37":47,"_48":16},"hour","2026-10-17T23:00:00.000Z",2.6,"participants","2026-10-17T22:00:00.000Z","2026-10-17T21:00:00.000Z",2.7,"2026-10-17T20:00:00.000Z",2.8,{"_55":56,"_11":57,"_25":58,"_59":60,"_61":19,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71},"id","wmx1f78lux321q13x8354hk87","亚马逊广告归因偏差：Make Brands Big 推出 Account MRI 工具解析 Halo Sales","Make Brands Big 联合创始人 Basil Zaidi 指出，Campaign Manager 将点击产生的跨商品销售（Halo Sales）错误归因于广告商品，导致多 SKU 账户的产品级 ACOS 失真。","source",{"_55":72,"_73":74,"_75":76,"_77":69,"_78":79},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-16","originalUrl","https://asgtg.com/your-amazon-ads-are-selling-products-you-are-not-advertising-hereis-how-to-see-which-ones/","selected",false,"factId","f8GknBFPNd_E","publisher-asgtg-official-blog-rolling","name","ASGTG · 官方卖家周报","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cb7e87c8dd6d977d.webp",{"_70":71,"_11":57,"_81":-5,"_18":19,"_15":16,"_82":83},"occurredAt","representative",{"_55":56,"_11":57,"_25":58,"_59":84,"_61":19,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71},{"_55":72,"_73":74,"_75":76,"_77":69,"_78":79},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_93":94},"changelogVersion","2026-10-09T22:08"]
