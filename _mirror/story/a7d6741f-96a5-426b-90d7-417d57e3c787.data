[{"_1":2,"_3":4},"root",{"_5":81},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","a7d6741f-96a5-426b-90d7-417d57e3c787","title","GUYISA安全鞋因合规证明缺失被英国边境拒入","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-06T11:08:58.000Z","latestAt","digest","2026年10月6日，英国产品安全与标准办公室（OPSS）发布产品安全报告（编号2609-0242），通报GUYISA品牌F055SBK型号安全鞋在英国边境被拒绝入境。该产品属于个人防护装备（PPE）类安全鞋，产地为中国，以黑黄色鞋盒包装出售，所评估产品的标签仅有中文。报告称，该产品未能证明符合个人防护装备的基本健康与安全要求，供应时缺少充分的技术文档、合格评估证据、安全说明及所需产品标识，可能导致使用不当并造成伤害，不符合欧盟《个人防护装备条例》(EU) 2016/425的要求。报告指出，这些产品为海外市场制造，未经品牌持有人授权即供应至英国市场；相关结论仅针对被检查的GUYISA F055SBK产品，不构成对其他GUYISA型号的评估。纠正措施为在边境拒绝该批进口。该通报由地方当局贸易标准部门提交。","digestUpdatedAt","2026-10-20T21:47:47.119Z","summary","excerpt","latest","OPSS通报GUYISA F055SBK安全鞋因缺乏合规证明在英国边境被拒入。","whyHot",{"_75":76,"_77":76,"_78":76,"_79":64,"_80":-5,"_37":-5},"developments",[69],"officialReports",[67],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","b9rdo0iavfkuyx1xxlg7fadk7","GUYISA 品牌安全鞋因缺乏合规证明被英国边境拒入","GUYISA 品牌 F055SBK 型号安全鞋因无法证明符合个人防护装备法规要求，在英国边境被拒绝入境。该产品缺少必要的技术文档、合格评估证据及安全标识，存在导致使用者受伤的高风险。","source",{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.gov.uk/product-safety-alerts-reports-recalls/product-safety-report-guyisa-safety-shoes-2609-0242","selected",false,"factId","fdmlIPu3e8xM","official-uk-opss-rolling","name","UK OPSS 产品安全公告","kind","web_list","firstParty",true,"iconUrl","/amznews-reading-preview/_img/1fbf571bfada1bb0.webp",{"_42":43,"_11":44,"_25":45,"_46":68,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},{"_56":57,"_11":70,"_71":-5,"_18":19,"_15":16,"_72":73},"英国OPSS通报GUYISA安全鞋因合规缺失被拒入境","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":74,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_82":83},"changelogVersion","2026-10-09T22:08"]
