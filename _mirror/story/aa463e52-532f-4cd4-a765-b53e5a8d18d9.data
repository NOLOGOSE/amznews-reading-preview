[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","aa463e52-532f-4cd4-a765-b53e5a8d18d9","title","Bogg推出Go Tote拓展通勤旅行场景","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T10:00:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_76":43,"_77":58},"latest","whyHot",{"_69":70,"_71":70,"_72":70,"_73":74,"_75":-5,"_35":-5},"developments",[64],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":55},"id","mmfbc45zlg3d98p0dtofkrosd","Bogg 推出 Go Tote 拓展通勤与旅行场景","Bogg 本月推出新品 Go Tote，旨在从海滩包拓展至通勤、运动及旅行市场。该系列提供三种尺寸（售价 $90-$150），具备拉链封口、笔记本电脑隔层及 EVA 泡沫底，由创始人 Kim Vaccarella 称基于客户反馈开发。尽管受关税影响去年损失近 $10 million，Bogg 仍保持原价并计划通过优化 GEO 描述及线下推广提升 AI 引擎可见度。","source",{"_40":56,"_57":58,"_59":60,"_61":53,"_62":63},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.modernretail.co/operations/why-bogg-is-moving-away-from-its-signature-eva-beach-bag/?utm_campaign=modernretaildis&utm_medium=rss&utm_source=general-rss","selected",false,"factId","fWsCycuC_22g","author-modern-retail-juliawaldow","name","modern-retail · Julia Waldow","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/feec9bcddc707257.webp",{"_54":55,"_11":12,"_65":-5,"_18":19,"_15":16,"_66":67},"occurredAt","representative",{"_40":41,"_11":42,"_23":43,"_44":68,"_46":19,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":55},{"_40":56,"_57":58,"_59":60,"_61":53,"_62":63},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_79":80},"changelogVersion","2026-10-09T22:08"]
