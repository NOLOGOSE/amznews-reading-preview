[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","ac202e85-0162-4230-a148-293b92244c4e","title","Jungle Scout 推出 Product Performance 工具","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-07T15:40:19.000Z","latestAt","digest","2026年10月7日，Jungle Scout 发布 AI 工具 Product Performance，可按单个 ASIN 并排查看销售、排名与评论趋势，并在销量下滑、排名下降或评论转差时标记该 SKU。用户可用自然语言提问，例如找出销量与评分同时下滑的 SKU，或对比新品前 90 天与上一版本的表现。该功能已内置于 Jungle Scout Cobalt，现有客户可直接使用。截至本版，尚无其他后续报道，事件进展即为该工具的推出与内置上线。","digestUpdatedAt","2026-10-07T15:46:48.832Z","summary","excerpt","latest","Jungle Scout 推出 Product Performance，已内置 Cobalt 供现有客户使用。","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","wk0fe2zx92gknlo1rpm22lm3h","Jungle Scout 推出 Product Performance：按 ASIN 追踪亚马逊销售、排名与评论趋势","Jungle Scout 推出 AI 工具 Product Performance，可按单个 ASIN 并排查看销售、排名和评论趋势，当销量下滑、排名下降或评论转差时标记该 SKU。用户可用自然语言提问，如找出销量与评分同时下滑的 SKU，或对比新品前 90 天与上一版本的表现。该功能已内置于 Jungle Scout Cobalt，现有客户可直接使用。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","unknown","calendarDate","originalUrl","https://www.junglescout.com/resources/articles/amazon-product-performance/","selected",false,"factId","f5e9tUFeFIAA","author-jungle-scout-shared-articles","name","Jungle Scout","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/cac30dcab47cf624.webp",{"_56":57,"_11":44,"_67":-5,"_18":19,"_15":16,"_68":69},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":70,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentRepo