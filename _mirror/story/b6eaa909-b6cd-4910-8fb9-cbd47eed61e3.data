[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","b6eaa909-b6cd-4910-8fb9-cbd47eed61e3","title","Jungle Scout 推出 ASIN 销量估算功能","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-14T15:35:48.000Z","latestAt","digest","2026年10月14日，Jungle Scout 发布文章介绍其 AI Solutions 中的 Sales Estimation 功能。该工具基于销售排名和类目数据，并结合卖家贡献的基准销售数据，为亚马逊上任意 ASIN（包括竞品）估算销量与营收，可用于评估竞争威胁、查看市场份额或设定新品上市目标。文章指出，估算结果仅供方向性参考，适合衡量规模与比较竞品，不适用于精确财务报告；且仅覆盖已在售的 ASIN，尚未上架的产品需改用 Category Sizing 或 Product Innovation 评估机会。用户可通过 Jungle Scout Cobalt 内置的 Ask Cobalt 提问，或将 Jungle Scout MCP 接入 Claude、ChatGPT、Gemini Enterprise、Microsoft Copilot 使用同一数据。","digestUpdatedAt","2026-10-17T10:39:55.152Z","summary","excerpt","latest","Jungle Scout 发文介绍 Sales Estimation，可为任意 ASIN 估算销量与营收。","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","qpbtd16cmkob3br7o2gae6z6f","Jungle Scout 介绍 Sales Estimation 功能：估算亚马逊 ASIN 销量","Jungle Scout 介绍其 AI Solutions 中的 Sales Estimation 功能，该工具基于销售排名和类目数据，为任意 ASIN（含竞品）提供销量与营收估算。作者指出结果仅供方向性参考，适用于评估竞争威胁或设定目标，而非精确财务报告；未上架产品需使用 Category Sizing 等其他工具。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.junglescout.com/resources/articles/amazon-sales-estimates/","selected",false,"factId","fWQ3ixpY0YCM","author-jungle-scout-shared-articles","name","Jungle Scout","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/cac30dcab47cf624.webp",{"_56":57,"_11":44,"_67":-5,"_18":19,"_15":16,"_68":69},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":70,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersion","2026-10-09T22:08"]
