[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","b76938a3-1756-4fde-be2e-5e9a9c3256a6","title","亚马逊合伙创业散伙案例：运营与供应链股东因利益分配、决策权及资产归属分歧导致合作破裂","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-07T20:34:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_77":43,"_78":59},"latest","whyHot",{"_70":71,"_72":71,"_73":71,"_74":75,"_76":-5,"_35":-5},"developments",[65],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},"id","nazag9gq0a9lpa42bm7pbifqz","亚马逊合伙创业散伙案例：MoonSees建议提前明确6项关键规则","MoonSees通过老A与廖哥因采购价、决策权及资产归属分歧导致公司盈利却散伙的案例，建议亚马逊合伙人在创业前明确工资计算、关联采购定价、经营权限划分、利润分配条件、店铺数据资产归属及退出机制这6件事。作者指出运营能力不等于公司经营能力，强调需在关系良好时签署协议以规避后期利益纠纷，文中观点仅为个人经验分享，不构成法律或投资建议。","source",{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-08","originalUrl","https://www.amz123.com/t/mobc4Dhr","selected",false,"factId","f50G9ZPggTiY","author-amz123-moonsees-reviewed","name","AMZ123 · 跨境电商MoonSees","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_55":56,"_11":12,"_66":-5,"_18":19,"_15":16,"_67":68},"occurredAt","representative",{"_40":41,"_11":42,"_23":43,"_44":69,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_80":81},"changelogVersion","2026-10-09T22:08"]
