000Z",9.2,{"_346":381,"_11":382,"_26":383,"_350":384,"_352":385,"_353":386,"_355":-5,"_357":387,"_359":369,"_361":362},{"_346":372,"_11":373,"_26":374,"_350":375,"_352":376,"_353":354,"_355":377,"_357":378,"_359":360,"_361":362},{"_346":347,"_11":348,"_26":349,"_350":351,"_352":19,"_353":354,"_355":356,"_357":358,"_359":360,"_361":362},"id","zx1i3z931v0f7cgd3t4wr0dni","亚马逊宣布 11 月起欧洲站物流附加费上调至 2%","亚马逊宣布将欧洲多个市场的燃油及物流附加费从 1.5% 上调至 2%，FBA 订单自 11 月 2 日起生效，MCF 业务自 11 月 19 日起覆盖。新费率按配送费用计算，预计使欧洲站 FBA 卖家每件商品平均增加约 0.02 欧元成本，英国站约为 0.02 英镑。亚马逊已更新 Seller Central 中的多项经营工具以纳入新费用，并强调该附加费将根据后续市场情况持续评估。","source",{"_346":363,"_364":365,"_366":367,"_368":369,"_370":371},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-20","originalUrl","https://www.amz123.com/t/GWhlPvYF","selected",true,"factId","fc5buGKM2v34","author-amz123-summer","name","AMZ123 · SUMMER","kind","web_list","firstParty",false,"iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","g673jzl01inbiu8f9x4evz3r4","亚马逊欧洲10站燃油物流附加费上调至2% 11月旺季生效","亚马逊宣布自2026年11月2日起将欧洲10个站点的FBA燃油及物流附加费从1.5%上调至2%，MCF服务自11月19日起执行。计费基数为配送费，平台称平均每件增加约0.02欧元，作者分析指出这收回了年初降费的约四成，且因按百分比计算会与旺季配送费叠加，大件重货受影响更大。",{"_346":379,"_364":380,"_366":367,"_368":369,"_370":371},"2026-10-20T23:12:00.000Z","2026-10-21","https://www.amz123.com/t/8f3HgmsK","publisher-amz123-headlines","AMZ123 · 跨境头条","lp65rtoyohvr30opj2khtmltc","亚马逊欧洲上调燃油及物流附加费至2%","亚马逊宣布将欧洲多个市场的燃油及物流附加费从1.5%上调至2%，为7个月内第二次调整。新费率自2026年11月2日起适用于FBA订单，覆盖德、法、意、西、英等市场；11月19日扩展至MCF。附加费按配送费用计算，预计FBA卖家每件商品平均增加约0.02欧元（英国站约0.02英镑）。",{"_346":388,"_364":389,"_366":367,"_368":369,"_370":390},"2026-10-21T07:10:56.000Z","timestamp","https://www.egainnews.com/article/74433","publisher-egainnews-articles","蓝海亿观网 · 跨境电商资讯","/amznews-reading-preview/_img/bf9841f40884e812.webp",{"_361":362,"_11":12,"_392":393,"_18":19,"_15":16,"_394":395},"occurredAt","2026-11-01T16:00:00.000Z","representative",{"_346":347,"_11":348,"_26":349,"_350":396,"_352":19,"_353":354,"_355":356,"_357":358,"_359":360,"