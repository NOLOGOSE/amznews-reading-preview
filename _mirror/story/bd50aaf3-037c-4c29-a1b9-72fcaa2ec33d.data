[{"_1":2,"_3":4},"root",{"_5":86},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","bd50aaf3-037c-4c29-a1b9-72fcaa2ec33d","title","CreeLED在美提起商标侵权诉讼 涉26-cv-12604","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-17T02:28:00.000Z","latestAt","digest","2026年10月14日，CreeLED, Inc.向伊利诺伊州北区联邦地区法院提起商标侵权诉讼，案件号为26-cv-12604，代理律所为Pierson Ferdinand LLP。起诉材料列明多项CreeLED联邦注册商标，包括2,440,530、3,935,628、3,935,629、4,641,937、6,091,202、5,566,249、3,935,630、3,327,299、3,360,315、3,014,910和5,294,417。原告主营高性能LED芯片、器件及照明产品，仅许可自身、被许可方及明示授权主体制造、进口、分销和销售带CreeLED商标的商品。相关报道提示，手电筒、车灯、家用灯具、商业照明、工业照明及LED元器件类卖家需排查商标使用风险，核查范围包括标题、主图、详情页、A+页面、变体图、外包装、说明书、后台埋词及广告关键词。目前公开信息仅显示诉状已递交，案件尚无进一步进展披露。","digestUpdatedAt","2026-10-19T01:37:40.112Z","summary","excerpt","latest","CreeLED于10月14日在伊利诺伊州北区联邦法院提起商标侵权诉讼，案件号26-cv-12604。","whyHot",{"_79":80,"_81":80,"_82":80,"_83":84,"_85":-5,"_37":-5},"developments",[72],"officialReports",[],"timeline",[46],"heat",[41],"related",[],{"_42":43,"_37":44,"_45":16},"hour","2026-10-19T02:00:00.000Z",2.5,"participants",{"_47":48,"_11":49,"_25":50,"_51":52,"_53":19,"_54":55,"_56":57,"_58":59,"_60":61,"_62":63},"id","q1zm252qw3dkk5or2ache2fj7","CreeLED在美发起商标维权诉讼 跨境照明类卖家需排查侵权风险","CreeLED, Inc.于2026年10月14日向伊利诺伊州北区联邦地区法院提起商标侵权诉讼（案件号26-cv-12604），代理律所是Pierson Ferdinand LLP。","source",{"_47":64,"_65":66,"_67":68,"_69":61,"_70":71},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-17","originalUrl","https://www.amz123.com/t/Om8Nzaof","selected",false,"factId","flsade0ZKBu4","publisher-amz123-headlines","name","AMZ123 · 跨境头条","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_62":63,"_11":73,"_74":75,"_18":19,"_15":16,"_76":77},"CreeLED Inc.起诉商标侵权案26-cv-12604","occurredAt","2026-10-13T16:00:00.000Z","representative",{"_47":48,"_11":49,"_25":50,"_51":78,"_53":19,"_54":55,"_56":57,"_58":59,"_60":61,"_62":63},{"_47":64,"_65":66,"_67":68,"_69":61,"_70":71},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_87":88},"changelogVersion","2026-10-09T22:08"]
