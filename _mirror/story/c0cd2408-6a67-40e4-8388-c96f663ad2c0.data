[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","c0cd2408-6a67-40e4-8388-c96f663ad2c0","title","亚马逊AGL新增中美空运选项并扩围零配置费","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-09-30T02:37:42.000Z","latestAt","digest","2026年9月30日报道，亚马逊宣布扩大中国至美国的Amazon Global Logistics（AGL）空运服务，新增Air SMP和Economy Air两种运输选项。Air SMP允许卖家在中国发货地拆分库存，空运至美国5个区域中的指定履约中心，从起运地提货起预计7至10个日历日送达，上海和香港提供每日航班，且不收取FBA入库配置服务费，服装、电子产品和锂电池产品不产生额外附加费。Economy Air从上海或深圳发往洛杉矶，预计11至15天，价格低于标准AGL空运。报道称，自2026年第四季度起，亚马逊将0美元FBA入库配置费结构扩展至空运货物，此前空运未纳入这一零费用安排；2024年推出的FBA入库配置费过去按商品尺寸、重量和运输距离收取，每件可能产生0.27至1.58美元以上费用。报道同时提示，0美元配置费不等于AGL一定更便宜，卖家需综合计算含关税在内的完整到岸成本，并承担进口商记录方法律责任。","digestUpdatedAt","2026-10-21T04:00:08.917Z","summary","excerpt","latest","亚马逊扩大中美AGL空运，新增Air SMP与Economy Air，2026年第四季度起空运纳入0美元FBA入库配置费。","whyHot",{"_73":74,"_75":74,"_76":74,"_77":55,"_78":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","ol2o4egbpxir9hga8kmd3zmyb","亚马逊AGL新增两项中美空运服务及零配置费政策","亚马逊宣布扩大中国至美国的Amazon Global Logistics（AGL）空运服务，新增Air SMP和Economy Air两种运输选项。其中Air SMP预计7至10天送达且免收FBA入库配置服务费，Economy Air预计11至15天送达；自2026年第四季度起，空运货物将纳入0美元FBA入库配置费结构。","source",{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.amz123.com/t/tEUfN1Tk","selected",true,"factId","f6ZMw0AdzIgo","author-amz123-summer","name","AMZ123 · SUMMER","kind","web_list","firstParty",false,"iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_56":57,"_11":68,"_69":-5,"_18":19,"_15":16,"_70":71},"亚马逊AGL新增中美空运服务并扩展0美元入库配置费","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":72,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":64,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
