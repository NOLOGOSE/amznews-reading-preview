7.1,"2026-10-19T14:00:00.000Z",17.7,"2026-10-19T13:00:00.000Z",18.2,"2026-10-19T12:00:00.000Z",18.7,"2026-10-19T11:00:00.000Z",18.4,"2026-10-19T10:00:00.000Z",19,"2026-10-19T09:00:00.000Z",{"_266":302,"_11":303,"_27":304,"_270":305,"_272":22,"_273":297,"_275":-5,"_277":306,"_279":280,"_281":282},{"_266":292,"_11":293,"_27":294,"_270":295,"_272":296,"_273":297,"_275":-5,"_277":298,"_279":280,"_281":282},{"_266":267,"_11":268,"_27":269,"_270":271,"_272":20,"_273":274,"_275":276,"_277":278,"_279":280,"_281":282},"id","bu1fulimfaq257h47cdthfdu2","亚马逊美国站保险新规：11大类目商品上架即需投保","亚马逊美国站更新商业责任险要求，自 11 月 2 日起，销售儿童产品、锂电池等 11 大类具有更严格安全发布要求的商品，无论销售额是否达到 1 万美金均须投保，最低保额为每次事故及累计 100 万美金。","source",{"_266":283,"_284":285,"_286":287,"_288":289,"_290":291},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-19","originalUrl","https://www.amz123.com/t/pWwYmNTB","selected",true,"factId","fJrNToYU4s3w","author-amz123-yihuagong-reviewed","name","AMZ123 · 跨境移花宫","kind","web_list","firstParty",false,"iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","muglv49c5ioxn90ckhqz877dc","亚马逊美国站商业责任险新规2026年11月2日生效，高危类目无销售额门槛投保且中国大陆卖家新保单须走AIA渠道","亚马逊公布美国站商业责任险新规，将于2026年11月2日正式生效，目前处于60天过渡期。据原文，售卖属于“强化安全上架要求”范围的高危商品（原文列举儿童用品、锂电池产品等，称“包括但不限于”）的卖家，无论销售额多少均须持有最低每次事故及累计100万美元保额的商业责任险；中国大陆注册卖家新提交的保单仅接受通过亚马逊保险加速器（AIA）获取的合规保单，外部第三方保单将被拒收。原文来自“小黄银站外推广”，存在相关商业利益，并非独立测评。",{"_266":299,"_284":300,"_286":287,"_288":289,"_290":301},"2026-10-19T08:17:38.000Z","timestamp","https://www.cifnews.com/article/189536","publisher-cifnews-amazon","雨果跨境 · 亚马逊频道最新","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp","knwhuqm2cvh1ruudoggx2asg4","亚马逊美国站商业责任险新规11月2日生效，大陆卖家须通过AIA投保","亚马逊公布美国站商业责任险新规将于11月2日正式生效，规定销售具有更严格安全要求的商品无论销售额高低均须投保，且中国大陆卖家新提交保单必须通过亚马逊保险加速器（AIA）获取。不符合要求的listing将被停售，保单需满足每次事故及累计赔偿限额至少100万美元等13项标准。",{"_266":299,"_284":300,"_286":287,"_288":289,"_290":301},"https://www.cifnews.com/article/189561",{"_281":282,"_11":308,"_309":310,"_19":20,"_15":16,"_311":312},"亚马逊美国站商业责任险新规生效","occurredAt","2026-11-01T16:00:00.000Z","representative",{"_266":267,"_11":268,"_27":269,"_270":313,"_272":20,"_273":274,"_275":276,"_277":278,"_279":280,"_281":282},{"_266":283,"_284":285,"_286":287,"_288":289,"_290":291},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_321":322},"changelogVersion","2026-10-09T22:08"]
