[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","c3f4d766-8063-4e10-82b7-ae7431e93a51","title","日本站换主体需同步变更 PSE 四项内容","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-12T01:33:29.723Z","latestAt","digest","2026年10月12日，知无不言平台一篇由“Sai日本合规”发布的文章指出，日本站卖家更换主体（大陆换大陆、换香港、换日本公司）时，除修改亚马逊后台外，还需同步变更 PSE 相关事项。文章称 PSE 义务跟随“事业者”而非店铺：新公司须在事业开始后30日内重新做经产省届出，旧公司不再进口销售则做事业废止届出，仅公司改名、法人未变则做变更届出；国内管理人合同需与新公司重签并更新届出信息；圆形 PSE 的技术基准适合确认、自主检查记录义务人为届出事业者，报告申请者若仍为旧公司易被平台质疑，菱形适合性检查证明书需提前咨询发证登録検査機関；铭牌上的届出事业者名及亚马逊新 ASIN 中「届出事业者」「国内管理人」两栏均须与新届出一致。作者建议按“定新主体→重新届出与签约→处理证书名义→改铭牌→最后改后台”的顺序操作，以免出现店铺与 PSE 主体不一致的空档期。","digestUpdatedAt","2026-10-17T10:50:14.561Z","summary","excerpt","latest","文章建议换主体时按先办 PSE 届出与签约、最后改亚马逊后台的顺序操作。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":12,"_25":44,"_45":46,"_47":19,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57},"id","wluuwmh1vsibsui5u573i3s79","日本站卖家更换主体时，除修改亚马逊后台外，还需同步变更 PSE 相关的经产省届出、国内管理人合同、报告检查记录及铭牌平台信息。作者建议按“定新主体→重新届出与签约→处理证书名义→改铭牌→最后改后台”的顺序操作，以避免出现店铺与 PSE 主体不一致的空档期。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-12","originalUrl","https://www.wearesellers.com/question/125309","selected",false,"factId","fPPFIVXp9fjs","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_56":57,"_11":67,"_68":-5,"_18":19,"_15":16,"_69":70},"日本站换主体需同步变更PSE相关事项","occurredAt","representative",{"_42":43,"_11":12,"_25":44,"_45":71,"_47":19,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
