[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","c533d0f8-7e99-4017-85c1-939891a9dfb7","title","AI 邮件过滤器误杀客户邮件案例","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-09-30T13:30:00.000Z","latestAt","digest","2026年9月30日，Seller Labs 报道了一名 AI 讲师为产品公司准备 AI 午餐分享会时，客户周五发来的准备材料被其自建的 AI 邮件过滤器判定为垃圾邮件，导致他始终未收到。他将此事写入演讲，作为“AI 不擅长什么”的第 15 题答案：AI 会自信地给出错误答案且从不告知，受限于上下文窗口、无法为决策负责，指向错误流程只会让错误流程更快。报道未提及该过滤器所用模型、误判具体原因及后续是否修复。","digestUpdatedAt","2026-10-04T19:24:30.024Z","summary","excerpt","latest","AI 讲师自建邮件过滤器误判客户邮件为垃圾邮件，被写入演讲案例。","whyHot",{"_71":72,"_73":72,"_74":72,"_75":76,"_77":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","yu5kgfbfesioghg66lpp8r4bk","AI 不擅长什么？一个被 AI 垃圾邮件过滤器误杀客户邮件的真实案例","一名 AI 讲师为产品公司准备 AI 午餐分享会时，客户周五发来的准备材料被自己搭建的 AI 邮件过滤器判定为垃圾邮件，导致他始终没收到。他把这件事写进演讲，作为\"AI 不擅长什么\"的第 15 题答案：AI 会自信地给出错误答案且从不告知，它受限于上下文窗口、无法为决策负责，指向错误流程只会让错误流程更快。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","unknown","calendarDate","originalUrl","https://www.sellerlabs.com/blog/what-is-ai-bad-at/","selected",false,"factId","fmCQjHxCEV4w","rss-sellerlabs-prelaunch","name","Seller Labs","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp",{"_56":57,"_11":44,"_67":-5,"_18":19,"_15":16,"_68":69},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":70,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_79":80},"changelogVersion","2026-10-09T22:08"]
