[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","c59bda64-c1eb-46f6-818f-c4896d1acf01","title","亚马逊FBA部分退款功能与SKU优化策略","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-14T12:39:46.000Z","latestAt","digest","亚马逊自2025年10月起在US、UK、德国、法国、意大利、西班牙六国推出FBA部分退款功能，允许卖家对订单退款10-40%且无需买家退货，卖家可按ASIN设置资格与比例。该功能不同于主要自动执行、通常全额退款的FBA Returnless Resolutions。报道建议按SKU逐一评估：核心是比较退货总成本（处理费＋入仓运费＋不可回收成本）与部分退款金额，当商品转售回收率低于约85%时部分退款通常更划算，回收率高于约88-90%时标准退货可能更优。报道还称2026年亚马逊关闭退货进行中的买卖双方消息通道、扩大低价商品免退货退款门槛，并将索赔窗口从18个月缩短至60天。","digestUpdatedAt","2026-10-17T10:41:16.269Z","summary","excerpt","latest","报道称2026年亚马逊将索赔窗口从18个月缩短至60天，并关闭退货中的买卖消息通道。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[65],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","v2sxvzqa0o9xgm9m559i3utej","亚马逊FBA部分退款策略：2026年基于盈亏平衡点的SKU级优化指南","亚马逊自2025年10月起在US、UK等六国推出FBA部分退款功能，允许卖家对订单进行10-40%的退款且无需退货。该策略需按SKU逐一评估，核心在于比较包含处理费、运费及不可回收成本的实际退货总成本与部分退款金额。当商品转售回收率低于85%时，部分退款通常更具成本效益；反之若回收率高，标准退货可能更优。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":-5},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.sellerapp.com/blog/amazon-fba-partial-refund-strategy-for-2026-what-actually-moves-the-needle/","selected",false,"factId","fMujqN89ylwY","author-sellerapp-brij-reviewed","name","SellerApp · Brij Purohit","kind","rss","firstParty","iconUrl",{"_56":57,"_11":66,"_67":68,"_18":19,"_15":16,"_69":70},"Amazon FBA Partial Refunds program launched in Oct 2025","occurredAt","2025-09-30T16:00:00.000Z","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":-5},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
