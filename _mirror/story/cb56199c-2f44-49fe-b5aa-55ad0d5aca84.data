[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","cb56199c-2f44-49fe-b5aa-55ad0d5aca84","title","日本经产省邮寄届出不再退回盖章回执","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-16T08:29:32.557Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_77":43,"_78":58},"latest","whyHot",{"_70":71,"_72":71,"_73":71,"_74":75,"_76":-5,"_35":-5},"developments",[64],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":55},"id","kiidu0tn1m2gvuue23u1w7l7s","亚马逊来信要“NOB”，到底要你交什么？先分清3种情况再动手","知无不言用户Sai日本合规指出，NOB是日本经产省事业届出受理后的回执，不是需要另办的证件，用于证明卖家主体已登记，但不代表产品合规。作者按已有回执、丢失回执、未届出三种情况给出应对思路，并提醒2026年6月30日起邮寄提交的届出不再退回盖章回执，保安网受理完成画面即为凭证。以上为作者经验分享，具体适用条件以平台和主管部门要求为准。","source",{"_40":56,"_57":58,"_59":60,"_61":53,"_62":63},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.wearesellers.com/question/125526","selected",false,"factId","fH_5nubEfLBM","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_54":55,"_11":12,"_65":66,"_18":19,"_15":16,"_67":68},"occurredAt","2026-06-29T16:00:00.000Z","representative",{"_40":41,"_11":42,"_23":43,"_44":69,"_46":19,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":55},{"_40":56,"_57":58,"_59":60,"_61":53,"_62":63},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_80":81},"changelogVersion","2026-10-09T22:08"]
