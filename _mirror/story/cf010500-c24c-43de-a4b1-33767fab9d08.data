[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","cf010500-c24c-43de-a4b1-33767fab9d08","title","WOOT提报规则与Q4广告补贴拆解","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-09T00:04:12.416Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_77":43,"_78":59},"latest","whyHot",{"_70":71,"_72":71,"_73":71,"_74":75,"_76":-5,"_35":-5},"developments",[65],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},"id","bxx2zbpb3l8j2tp7g6ilyiv5x","巧豚豚拆解 WOOT 提报规则与 Q4 广告补贴","原文来自 Frual 巧豚豚 - WOOT，存在相关商业利益，并非独立测评。作者介绍其理解的 WOOT 提报收费逻辑与 9.15–11.15 阶段性广告补贴规则：标准提报在活动周期内日均 GMV 达到 3500 美金可免提报费，第 7 轮 BD 起后续活动可免费参与；批次团购提报一次性提交 3 个及以上不同父体 ASIN，任意子体在活动期间日均 GMV 达到 1000 美金，对应父体免提报费，未达门槛则对应父体三轮提报费用为 199 美金。补贴需通过巧豚豚提报 Woot Deal，Deal 期间日均广告花费大于 30 美金，按单个 Campaign 的 ACoS 分档发放，各 Campaign 独立核算，档位不可叠加，最终补贴金额以后台核查结果为准。作者还介绍了六大智豚工具的定位及适合、不适合申报 Woot 的场景。以上规则与效果均为作者自述，本站尚未独立核验。","source",{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-09","originalUrl","https://www.wearesellers.com/question/125207","selected",false,"factId","fiDcHLLPdST4","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_55":56,"_11":12,"_66":-5,"_18":19,"_15":16,"_67":68},"occurredAt","representative",{"_40":41,"_11":42,"_23":43,"_44":69,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},{"_40":57,"_58":59,"_60":61,"_62":54,"_63":64},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_80":81},"changelogVersion","2026-10-09T22:08"]
