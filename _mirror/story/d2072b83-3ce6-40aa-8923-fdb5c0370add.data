[{"_1":2,"_3":4},"root",{"_5":82},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","d2072b83-3ce6-40aa-8923-fdb5c0370add","title","CPSC召回在亚马逊销售的婴儿浴椅","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-08T00:00:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_80":43,"_81":59},"latest","whyHot",{"_74":75,"_76":75,"_77":75,"_78":63,"_79":-5,"_35":-5},"developments",[68],"officialReports",[66],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},"id","tqa5k1vhfxkw7r3wvy7i2tkre","CPSC 召回 ONTHEWEI 婴儿浴盆座椅，因存在溺水风险","CPSC 于 2026 年 10 月 8 日召回约 2,140 件 ONTHEWEI 品牌婴儿浴盆座椅（型号 MY002），因其不稳定易翻倒，违反强制性标准并导致严重伤害或死亡风险。消费者应立即停止使用，联系卖家获取全额退款并按要求销毁产品。该商品曾在亚马逊以 $40-$50 价格销售。","source",{"_40":57,"_58":59,"_60":61,"_62":63,"_64":65},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-08","originalUrl","https://cpsc.gov/Recalls/2027/ONTHEWEI-Recalls-Baby-Bath-Seats-Due-to-Risk-of-Serious-Injury-or-Death-to-Children-from-Drowning-Violate-Mandatory-Standard-for-Infant-Bath-Seats","selected",false,"factId","f0k_EdJWHnWk","official-cpsc-amazon-recalls-reviewed","name","CPSC 美国消费品安全委员会","kind","json_list","firstParty",true,"iconUrl","/amznews-reading-preview/_img/382881c3aef48a1a.webp",{"_40":41,"_11":42,"_23":43,"_44":67,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},{"_40":57,"_58":59,"_60":61,"_62":63,"_64":65},{"_55":56,"_11":12,"_69":70,"_18":19,"_15":16,"_71":72},"occurredAt","2026-10-07T16:00:00.000Z","representative",{"_40":41,"_11":42,"_23":43,"_44":73,"_46":19,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56},{"_40":57,"_58":59,"_60":61,"_62":63,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank","text","sourceName",{"_83":84},"changelogVersion","2026-10-09T22:08"]
