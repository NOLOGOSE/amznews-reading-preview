[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","d516afc1-fe0f-4183-afc6-89e3f64a3c0d","title","亚马逊美国站锂电池智能家居产品合规标准","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T01:27:32.261Z","latestAt","digest","2026年10月13日，有报道称亚马逊美国站要求所有由锂电池供电的智能家居和消费类电子产品符合适用的法律、法规和标准。按品类划分：监控摄像头、视频门铃、扬声器、耳麦、耳机和显示器需符合 UL/CSA C22.2 No. 62368-1；空气质量和环境监测仪、氡探测器、环境温湿度传感器及仪表、数字万用表和电流钳需符合 UL/CSA-C22.2 No. 61010-1，并配合 61010-2-032 或 61010-2-033 的特殊要求；用于智能家居设备和消费类电子产品的锂电池充电器需符合 UL 1310 或 UL 62368-1 之一。目前为该合规要求的公布阶段，尚无后续进展报道。","digestUpdatedAt","2026-10-17T10:46:53.976Z","summary","excerpt","latest","亚马逊美国站公布锂电池供电智能家居及消费电子产品的合规标准。","whyHot",{"_73":74,"_75":74,"_76":74,"_77":78,"_79":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","lohdjcq7ua0dydvd6l84naivh","亚马逊美国站公布锂电池供电智能家居及消费电子产品合规标准","亚马逊要求美国站所有由锂电池供电的智能家居和消费类电子产品符合适用的法律、法规和标准。监控摄像头、视频门铃等音视频设备需符合 UL/CSA C22.2 No. 62368-1；空气质量和环境监测仪、数字万用表等测量控制设备需符合 UL/CSA-C22.2 No. 61010-1 及相关特殊要求；锂电池充电器需符合 UL 1310 或 UL 62368-1。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-13","originalUrl","https://www.wearesellers.com/question/125332","selected",false,"factId","f2i45ZBNrq-A","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_57":58,"_11":68,"_69":-5,"_18":19,"_15":16,"_70":71},"亚马逊美国站要求锂电池智能家居及消费电子符合安全标准","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":72,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_81":82},"changelogVersion","2026-10-09T22:08"]
