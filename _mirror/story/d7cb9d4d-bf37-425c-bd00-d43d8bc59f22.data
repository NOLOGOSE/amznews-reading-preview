[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","d7cb9d4d-bf37-425c-bd00-d43d8bc59f22","title","亚马逊巴西加入YouTube Shopping联盟计划","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-09-29T09:34:44.000Z","latestAt","digest","2026年9月29日，AMZ123报道，亚马逊巴西宣布加入 YouTube Shopping 联盟计划，扩大创作者内容在其电商平台内的展示范围。该合作同时覆盖亚马逊网站和App：符合条件的YouTube频道可在视频、Shorts短视频和直播中标记 Amazon.com.br 上销售的巴西本土及国际商品，消费者通过这类内容购买后，创作者可获得佣金；同时，创作者视频也将出现在亚马逊首页、订单确认页面及专门的视频内容区域，并以竖屏形式展示，平台会根据用户浏览场景匹配内容。亚马逊援引数据显示，YouTube在巴西拥有1.3亿月活跃用户，2026年购物相关视频消费量较2025年增长120%以上；81%的消费者购买过创作者推荐的商品。报道称，YouTube在巴西还与Magalu、Mercado Livre和Shopee等平台有类似合作。","digestUpdatedAt","2026-10-20T04:00:10.757Z","summary","excerpt","latest","亚马逊巴西宣布加入YouTube Shopping联盟计划，创作者可标记商品获佣金。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","vgijh8jk4y62y9un00mwt2cel","亚马逊巴西加入 YouTube Shopping 联盟计划","亚马逊巴西宣布加入 YouTube Shopping 联盟计划，允许创作者在视频中标记 Amazon.com.br 商品并获取佣金。该合作同时覆盖亚马逊网站和 App，将创作者视频引入首页及订单确认页等场景。亚马逊援引数据显示，YouTube 在巴西拥有 1.3 亿月活跃用户，2026 年购物相关视频消费量较 2025 年增长超 120%。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.amz123.com/t/Gb7fXQyA","selected",false,"factId","fXhK0lnr3eXQ","author-amz123-summer","name","AMZ123 · SUMMER","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_56":57,"_11":67,"_68":-5,"_18":19,"_15":16,"_69":70},"亚马逊巴西加入YouTube购物联盟计划","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
