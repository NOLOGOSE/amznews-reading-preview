[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","d9244c3b-04a4-4ada-b738-4e2d0f711459","title","亚马逊黑五卖家备货与费用调整","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T01:38:00.000Z","latestAt","digest","2026年10月13日，My Amazon Guy 的 Steven Pope 发布黑五前 Listing 优化清单（原文含商业利益，非独立测评）。文中建议卖家在10月20日前提交 Black Friday Deals，10月28日为 FBA 入仓截止，11月9日后冻结标题、后台关键词与变体，图片与 A+ 内容更新可在11月中旬前完成。费用方面，原文称优惠券费用已从每单 $0.60 调整为 $5 加 2.5% 优惠券销售额，$24 为与旧费用持平的临界价：低于该价更便宜，高于该价更贵；并提示旺季活动定价可能不同，需在 Seller Central 确认 Black Friday deal 与 Prime Exclusive Discount 费用。","digestUpdatedAt","2026-10-17T10:46:33.441Z","summary","excerpt","latest","My Amazon Guy 发布黑五 Listing 优化清单，建议10月20日前提交 Deal、11月9日冻结标题。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","q07fwpj6omc4bfd176wg7dtss","亚马逊卖家黑五前 Listing 优化清单：10月20日截止提交 Deal，11月9日冻结标题","原文来自 My Amazon Guy，存在相关商业利益，并非独立测评。作者 Steven Pope 建议亚马逊卖家在10月20日前提交 Black Friday Deals，11月9日后避免修改标题、后台关键词与变体，图片与 A+ 内容更新可在11月中旬前完成。原文称优惠券费用已从每单 $0.60 调整为 $5 加 2.5% 优惠券销售额，$24 是与旧费用持平的临界价：低于该价更便宜，高于该价更贵；原文同时提示旺季活动定价可能不同，需在 Seller Central 确认 Black Friday deal 与 Prime Exclusive Discount 费用。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://myamazonguy.com/selling-on-amazon/amazon-black-friday-listing-prep/","selected",false,"factId","fVUxPJPE8Eqs","author-myamazonguy-steven-pope-rolling","name","My Amazon Guy · Steven Pope","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/2367a94bae94b1de.webp",{"_56":57,"_11":67,"_68":-5,"_18":19,"_15":16,"_69":70},"Steven Po