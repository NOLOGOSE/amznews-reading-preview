[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","daaa63e0-c02b-41c3-a9dd-415131df29f2","title","WOOT秒杀广告销售额与售价不符原因解析","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-15T02:55:41.121Z","latestAt","digest","2026年10月15日，巧豚豚（WOOT）在知无不言发布文章，回应WOOT秒杀卖家反映的广告数据问题：主推商品客单价在30～59美元之间，广告报表却出现5.99美元的销售额。文章指出，这并非数据异常，也与亚马逊SP广告的7天归因窗口有关。买家点击WOOT商品SP广告后进入7天归因窗口，在此期间若购买店铺内其他符合归因条件的商品，该订单金额也可能计入这条广告的销售额，因此广告推广的ASIN不一定等于最终被归因购买的ASIN。文章举例称，推广售价39.99美元的WOOT商品，买家点击广告后改买售价5.99美元的配件，若符合归因条件，报表就可能记录5.99美元的归因销售额。巧豚豚建议卖家遇到此类情况先不必判断为系统异常，应理解归因逻辑后再看待WOOT秒杀期间的广告销售数据。","digestUpdatedAt","2026-10-17T10:37:16.755Z","summary","excerpt","latest","巧豚豚解析WOOT秒杀广告销售额与主推售价不符，称系SP广告7天归因窗口所致。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[67],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},"id","le6cscx0cqc7l0qi0npsh4ozr","WOOT秒杀广告销售额与售价不符原因解析：亚马逊SP广告7天归因机制","巧豚豚指出WOOT秒杀卖家遇到的广告销售额（如5.99美元）低于主推商品客单价（30～59美元）并非数据异常，而是受亚马逊SP广告7天归因窗口影响。买家点击广告后若购买店铺内其他符合归因条件的ASIN，该订单金额将计入广告报表，导致推广ASIN与最终成交ASIN不一致。","source",{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-15","originalUrl","https://www.wearesellers.com/question/125449","selected",false,"factId","fhhoCQpDZDIo","author-wearesellers-public-latest","name","知无不言","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/cd76ad478f9fc825.webp",{"_57":58,"_11":44,"_68":-5,"_18":19,"_15":16,"_69":70},"occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58},{"_42":59,"_60":61,"_62":63,"_64":56,"_65":66},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
