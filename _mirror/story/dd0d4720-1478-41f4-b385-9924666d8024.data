07":444,"_409":445,"_411":430,"_413":414},{"_398":434,"_11":435,"_27":436,"_402":437,"_404":438,"_405":428,"_407":-5,"_409":439,"_411":412,"_413":414},{"_398":423,"_11":424,"_27":425,"_402":426,"_404":427,"_405":428,"_407":-5,"_409":429,"_411":430,"_413":414},{"_398":399,"_11":400,"_27":401,"_402":403,"_404":20,"_405":406,"_407":408,"_409":410,"_411":412,"_413":414},"id","bh78qa56iosocpw85ht93lg43","亚马逊宣布 Listing Protection 机制：AHA 卖家违规审核期间可继续销售","亚马逊在 Accelerate 大会宣布推出 Listing Protection（商品保护机制），官方说法是多数情况下商品被标记违规后，Listing 会在卖家处理问题期间保持正常售卖，并提供处理步骤与错误判定申诉通道。该机制适用对象为 AHA 卖家，美国站预计 2026 年底前覆盖，2027 年扩展至全球。原文同时提醒，具体适用范围、执行细节及开放进度仍应以亚马逊后续正式政策和卖家平台通知为准。","source",{"_398":415,"_416":417,"_418":419,"_420":412,"_421":422},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-15","originalUrl","https://www.amz123.com/t/BUJrKFBn","selected",false,"factId","feo6IK5EleFM","author-amz123-youjiang-reviewed","name","AMZ123 · 跨境电商优匠学堂","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp","r2arg0z1i1luk3a5hafxbgkqo","亚马逊宣布推出Listing保护机制，AHA卖家商品审核期间或可继续销售","亚马逊在2026年9月22日至24日西雅图Accelerate大会上宣布推出Listing Protection（listing保护机制）。据大会说明，在大多数情况下，商品被判定违规后，Listing可在卖家处理问题期间保持正常售卖，并提供处理步骤和错误判定申诉通道。该机制适用对象为AHA卖家，即账户健康评分（AHR）保持在250分以上持续6个月、期间低于250分的天数不超过10天的专业卖家，符合条件后自动纳入；美国站预计2026年底前覆盖AHA卖家，2027年扩展至全球。原文同时介绍Seller Challenge申诉机制，并提示具体适用范围、执行细节及开放进度以亚马逊后续正式政策和卖家平台通知为准。",{"_398":431,"_416":432,"_418":419,"_420":412,"_421":433},"2026-10-19T06:38:36.000Z","timestamp","https://www.cifnews.com/article/189503",true,"publisher-cifnews-amazon","雨果跨境 · 亚马逊频道最新","/amznews-reading-preview/_img/3eb2ff60f5bc21ce.webp","pb1mvhqfxdk5x7bt7qwcrtngd","亚马逊公布 Listing Protection 机制：符合条件卖家在违规审核期间可继续销售","亚马逊在 Accelerate 大会公布 Listing Protection 机制：符合条件的卖家在商品被标记违规后的审核期间可继续维持销售。该权益与 Account Health Assurance（AHA）资格挂钩，要求账户健康评分（AHR）达到 250 分或以上、连续保持 6 个月，且在此期间评分低于 250 分的时间不超过 10 天；达到要求后自动纳入，无需额外申请。原文同时说明，继续销售不等于违规被豁免，最终是否受限仍取决于亚马逊审核结果，具体执行以正式上线规则为准。",{"_398":431,"_416":432,"_418":419,"_420":412,"_421":433},"2026-10-19T07:21:28.000Z","https://www.cifnews.com/article/189518","myc3rmrju2ct7vi2kx7xv42t6","亚马逊推出Listing Protection机制及Seller Challenge申诉通道","亚马逊在2026年Accelerate大会宣布推出Listing Protection机制，符合条件的卖家在商品被标记违规处理期间可保持Listing在线，该机制预计2026年底前覆盖美国站所有符合Account Health Assurance条件的卖家。",{"_398":446,"_416":447,"_418":419,"_420":412,"_421":422},"2026-10-20","https://www.amz123.com/t/wcos8T62","publisher-amz123-headlines","AMZ123 · 跨境头条","nidam1apulzytsayl6rqtew5v","亚马逊上线Listing Protection机制，违规审核期链接可保持在线","亚马逊在2026 Amazon Accelerate大会发布Listing Protection（商品信息保护）新机制，符合条件的卖家在商品被标记违规时，多数情况下Listing可继续在线销售直至审核完成。",{"_398":431,"_416":432,"_418":419,"_420":412,"_421":433},"2026-10-21T07:14:57.000Z","https://www.cifnews.com/article/189578","jgqh6oqxfavaz0srp6hy2hd4j","亚马逊推出 Listing Protection 机制允许部分违规链接在审核期间保持在线","亚马逊在2026年Amazon Accelerate大会上公布Listing Protection机制，计划在2026年底前覆盖美国站符合Account Health Assurance（AHA）条件的卖家，并于2027年向全球推广。",{"_398":446,"_416":447,"_418":419,"_420":412,"_421":422},"2026-10-21T07:59:00.000Z","2026-10-21","https://www.amz123.com/t/KvFbjhF7","fgtxgbn8lwtbk8xhn0t992yvz","亚马逊推出 Listing Protection 机制允许部分违规链接在审核期继续销售","亚马逊在 Amazon Accelerate 大会公布 Listing Protection 机制，允许被标记为政策违规的商品 Listing 在符合条件时于审核期间保持在线，供卖家整改或申诉。",{"_398":466,"_416":467,"_418":468,"_420":412,"_421":-5},"https://mjzj.com/article/g1zboxm9txj4","publisher-mjzj-feed","卖家之家 · 跨境资讯","rss",{"_413":414,"_11":470,"_471":472,"_19":20,"_15":16,"_473":474},"亚马逊宣布推出 Listing Protection 机制","occurredAt","2026-09-21T16:00:00.000Z","representative",{"_398":423,"_11":424,"_27":425,"_402":475,"_404":427,"_405":428,"_407":-5,"_409":429,"_411":430,"_413":414},{"_398":431,"_416":432,"_418":419,"_420":412,"_421":433},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete","rank",{"_483":484},"changelogVersion","2026-10-09T22:08"]
