[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","e1d7690b-3b74-4372-b9db-408c14ef200b","title","亚马逊卖家靠维持4.7分高评分挤进头部前三，对比砸200万广告费做烂品失败案例","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-13T22:35:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_76":42,"_77":58},"latest","whyHot",{"_69":70,"_71":70,"_72":70,"_73":74,"_75":-5,"_35":-5},"developments",[64],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":12,"_23":42,"_43":44,"_45":19,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55},"id","qx0uyfh33yig3w4oiuw794d3y","原文作者分享通过严控品质将Listing评分维持在4.7分，成功超越竞品进入类目头部前三并实现月入十几万利润的经验。其朋友因产品品质差、退货率高，虽投入两百多万广告费仍无法做起来，印证了广告是放大器而非造血机，劣质产品投广只会加速死亡。","source",{"_40":56,"_57":58,"_59":60,"_61":53,"_62":63},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-14","originalUrl","https://www.amz123.com/t/80cj4Xwk","selected",false,"factId","fzMnILTWyo98","author-amz123-adu-reviewed","name","AMZ123 · 跟着阿杜学跨境电商","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_54":55,"_11":12,"_65":-5,"_18":19,"_15":16,"_66":67},"occurredAt","representative",{"_40":41,"_11":12,"_23":42,"_43":68,"_45":19,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55},{"_40":56,"_57":58,"_59":60,"_61":53,"_62":63},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_79":80},"changelogVersion","2026-10-09T22:08"]
