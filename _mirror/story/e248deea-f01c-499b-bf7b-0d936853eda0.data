[{"_1":2,"_3":4},"root",{"_5":79},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","e248deea-f01c-499b-bf7b-0d936853eda0","title","销量下滑归因：拆解流量、转化与价格","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-01T15:00:00.000Z","latestAt","digest","2026年10月1日，Seller Labs 发布文章，讨论卖家在销量下滑时该如何判断原因。文章提出，不应先急着加广告预算，而应先把销量变化拆解开来。其给出的方法是使用公式 Sales = sessions × conversion rate × average selling price，把销量的整体变化分解为流量、转化率、平均售价三项各自带来的美元影响，并指出这三项影响相加正好等于销量的总变化。文章的核心主张是：先通过这一拆解定位销量下滑究竟来自流量、转化还是价格，再据此决定是否追加广告预算。截至该报道，事件进展仅停留在这一分析方法的提出，尚无后续报道或实际应用结果。","digestUpdatedAt","2026-10-04T19:23:55.000Z","summary","excerpt","latest","Seller Labs 提出用 sessions×转化率×均价拆解销量变化，再决定是否加广告预算。","whyHot",{"_72":73,"_74":73,"_75":73,"_76":77,"_78":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","c2xsvxwdpdhjpvwhm4amf29j1","销量下滑时先拆分流量、转化与价格，再决定是否加广告预算","作者提出用 Sales = sessions × conversion rate × average selling price 把销量变化拆成流量、转化、价格三项美元影响，三项相加正好等于总变化。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","unknown","calendarDate","originalUrl","https://www.sellerlabs.com/blog/amazon-sales-drop-traffic-conversion-price/","selected",false,"factId","fGRwCkXJmdq8","rss-sellerlabs-prelaunch","name","Seller Labs","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/2e4fdd2c4f370e2a.webp",{"_56":57,"_11":67,"_68":-5,"_18":19,"_15":16,"_69":70},"销量下滑时先拆解流量、转化与价格，再决定是否加广告预算","occurredAt","representative",{"_42":43,"_11":44,"_25":45,"_46":71,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_80":81},"changelogVersion","2026-10-09T22:08"]
