[{"_1":2,"_3":4},"root",{"_5":78},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","e254d365-616e-4cd9-a672-0f1b6bcacbbb","title","亚马逊封锁Meta Muse购物代理访问","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-08T00:00:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_76":43,"_77":58},"latest","whyHot",{"_69":70,"_71":70,"_72":70,"_73":74,"_75":-5,"_35":-5},"developments",[64],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":42,"_23":43,"_44":45,"_46":19,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":55},"id","d9cek7b8qogl1kvaptw8b3ydl","亚马逊封锁 Meta Muse 购物权限并起诉退款欺诈团伙","亚马逊阻止 Meta 的 Muse AI 代理在 Amazon.com 完成购买，坚持仅允许自家 Rufus 和 Alexa 处理智能体购物。Meta 随即转向推出面向小企业的 Muse，连接 Shopify、QuickBooks 等后台软件但不含 Seller Central。此外，亚马逊起诉一个利用虚假警方报告骗取约 400 万美元 GPU 和笔记本电脑退款的哈萨克斯坦团伙。","source",{"_40":56,"_57":58,"_59":60,"_61":53,"_62":63},"publishedAt","publishedPrecision","unknown","calendarDate","originalUrl","https://sellerbites.com/amazon-locks-metas-muse-out-of-its-marketplace-heres-why-that-matters/","selected",false,"factId","fsy1nNfNCtbo","publisher-sellerbites-newsletter-rolling","name","SellerBites 亚马逊卖家周报","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/a41184568d996aef.webp",{"_54":55,"_11":12,"_65":-5,"_18":19,"_15":16,"_66":67},"occurredAt","representative",{"_40":41,"_11":42,"_23":43,"_44":68,"_46":19,"_47":48,"_49":-5,"_50":51,"_52":53,"_54":55},{"_40":56,"_57":58,"_59":60,"_61":53,"_62":63},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_79":80},"changelogVersion","2026-10-09T22:08"]
