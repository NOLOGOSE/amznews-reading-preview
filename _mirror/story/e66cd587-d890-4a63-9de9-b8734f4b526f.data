[{"_1":2,"_3":4},"root",{"_5":77},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":-5,"_22":-5,"_23":-5,"_24":25,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38},"publicId","e66cd587-d890-4a63-9de9-b8734f4b526f","title","Adobe Express 2026 调查：TikTok 搜索使用率升至 49%，但 Gen Z 偏好度降至 4%","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-09T09:12:00.000Z","latestAt","digest","digestUpdatedAt","summary","excerpt",{"_75":42,"_76":57},"latest","whyHot",{"_68":69,"_70":69,"_71":69,"_72":73,"_74":-5,"_35":-5},"developments",[63],"officialReports",[],"timeline",[39],"heat",[],"related",[],{"_40":41,"_11":12,"_23":42,"_43":44,"_45":19,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":54},"id","eg3h1o3spzb0cdg8kdgg343ln","Adobe Express 2026年2月调查显示，美国消费者在 TikTok 进行搜索的比例从 41% 升至 49%，但 Gen Z 中偏好 TikTok 而非 Google 的比例从 8% 降至 4%。该机构自报样本较小且未公布误差范围，数据仅作为趋势信号；Reddit 和 ChatGPT 正成为购买前的主要核查渠道，品牌需适应多平台碎片化的产品发现路径。","source",{"_40":55,"_56":57,"_58":59,"_60":52,"_61":62},"publishedAt","publishedPrecision","unknown","calendarDate","originalUrl","https://sellerelevate.com/tiktok-gen-zs-search-engine-2026-data/","selected",false,"factId","fNnN4X6lqSI4","publisher-sellerelevate-written-rolling","name","SellerElevate 亚马逊广告与运营文章","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/3c5cd185312c2802.webp",{"_53":54,"_11":12,"_64":-5,"_18":19,"_15":16,"_65":66},"occurredAt","representative",{"_40":41,"_11":12,"_23":42,"_43":67,"_45":19,"_46":47,"_48":-5,"_49":50,"_51":52,"_53":54},{"_40":55,"_56":57,"_58":59,"_60":52,"_61":62},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_78":79},"changelogVersion","2026-10-09T22:08"]
