湾海峡管控，华南北上航线面临调整","福建海事局因台风“蔷琵”及冷空气影响，自10月21日12时起暂停广东方向其他船舶进入台湾海峡。此前已分阶段限制闽浙交界及部分货船北上，并引导中小船舶避风、暂停部分海上作业。受此影响，东海及台湾海峡海域未来几天将出现6—13级大风，华南至北方航线的货代与货主需重新确认实际通行安排并预留运输时间余量。","source",{"_187":204,"_205":206,"_207":208,"_209":201,"_210":211},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-21","originalUrl","https://www.amz123.com/t/VF3Fnn9f","selected",false,"factId","fU61sC4kefAg","publisher-amz123-headlines","name","AMZ123 · 跨境头条","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_202":203,"_11":213,"_214":215,"_18":19,"_15":16,"_216":217},"福建海事局因台风收紧台湾海峡船舶通行管控","occurredAt","2026-10-20T16:00:00.000Z","representative",{"_187":188,"_11":189,"_24":190,"_191":218,"_193":19,"_194":195,"_196":197,"_198":199,"_200":201,"_202":203},{"_187":204,"_205":206,"_207":208,"_209":201,"_210":211},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank","text","sourceName",{"_229":230},"changelogVersion","2026-10-09T22:08"]
