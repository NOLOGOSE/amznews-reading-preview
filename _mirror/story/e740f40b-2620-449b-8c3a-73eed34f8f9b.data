[{"_1":2,"_3":4},"root",{"_5":91},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","e740f40b-2620-449b-8c3a-73eed34f8f9b","title","Xeneta：航空货运短约占比升至60%","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-17T04:08:00.000Z","latestAt","digest","2026年10月17日报道，行业分析机构Xeneta数据显示，自2026年第三季度起生效的新航空货运合同中，期限三个月或更短的合同占比达60%，而2025年第三季度为25%、2026年第二季度为47%；其中仅三个月期合同占新合同总量的42%，较去年同期的16%大幅上升。与此同时，12个月期合同占比从40%降至25%，期限超过12个月的合同占比仅3%。Xeneta首席航空货运官Niall van de Wouw表示，发货人越来越倾向以基础运价为起点、再按市场情况调整的“浮动机制”，缺乏调整机制的一年期协议正逐渐从行业惯例变成例外。报道还提到，9月全球航空货运现货运价平均为每公斤3.10美元，同比高27%、环比涨2%；8月中国对欧洲低价值商品及电商出口同比下降40%，降幅较7月的25%扩大，报道将其归因于欧盟自7月1日起实施的每件商品3欧元关税。","digestUpdatedAt","2026-10-19T01:37:24.996Z","summary","excerpt","latest","Xeneta称三季度起生效的新航空货运合同中，三个月及以内短约占比达60%，一年期固定运价合同占比降至25%。","whyHot",{"_84":85,"_86":85,"_87":85,"_88":89,"_90":-5,"_37":-5},"developments",[78],"officialReports",[],"timeline",[52],"heat",[41,42,43],"related",[],{"_44":50,"_37":51,"_47":16},{"_44":48,"_37":49,"_47":16},{"_44":45,"_37":46,"_47":16},"hour","2026-10-19T04:00:00.000Z",2.5,"participants","2026-10-19T03:00:00.000Z",2.6,"2026-10-19T02:00:00.000Z",2.7,{"_53":54,"_11":55,"_25":56,"_57":58,"_59":19,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69},"id","ycv2v5yc40zybp230cf1ud4z8","Xeneta 数据：发货人转向短期合同，一年期固定运价占比降至 25%","Xeneta 数据显示，自 2026 年第三季度起生效的新航空货运合同中，期限在三个月或更短的占比达 60%，而一年期固定运价合同占比从 40% 降至 25%，发货人正通过“浮动机制”应对市场波动。","source",{"_53":70,"_71":72,"_73":74,"_75":67,"_76":77},"publishedAt","publishedPrecision","calendar","calendarDate","2026-10-17","originalUrl","https://www.amz123.com/t/4C0vNGm2","selected",false,"factId","fTCE-sBj8ecE","publisher-amz123-headlines","name","AMZ123 · 跨境头条","kind","web_list","firstParty","iconUrl","/amznews-reading-preview/_img/0083c7bf2225c6c0.webp",{"_68":69,"_11":79,"_80":-5,"_18":19,"_15":16,"_81":82},"Xeneta数据显示发货人转向短期航空货运合同","occurredAt","representative",{"_53":54,"_11":55,"_25":56,"_57":83,"_59":19,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69},{"_53":70,"_71":72,"_73":74,"_75":67,"_76":77},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_92":93},"changelogVersion","2026-10-09T22:08"]
