[{"_1":2,"_3":4},"root",{"_5":80},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","eb546257-02c9-4742-b903-bd623aedf3f2","title","Jungle Scout 与 PODEAN 发布 2026 亚马逊市场指数","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-12T18:47:44.000Z","latestAt","digest","2026年10月12日，Jungle Scout 联合全球市场机构 PODEAN 发布 2026 Marketplace Index，基于 Jungle Scout Cobalt 的销售数据，评估美国、英国、德国、墨西哥、巴西和澳大利亚六国超过 3500 个品牌及 50000 个 ASIN。每家品牌获得 PODEAN 的 MDEX 评分，涵盖零售、内容、客户情绪、媒体及今年新增的 AI Readiness 五大支柱。报告称，美国品牌 2026 年平均 MDEX 得分为 76.7%，高于 2023 年的 67%；Prime 资格产品占比从 2023 年的 49% 升至 89%。但仅 40% 在 2023 与 2026 均被评估的品牌提高了得分。广告方面，96% 的品牌在自身品牌名搜索上投放 Sponsored Products，75% 的时间保住该位置，而在品类热门关键词上仅 36% 出现，Sponsored Brands 品类搜索位置仅 8%。AI Readiness 方面，美国品牌平均 64%，仅 18% 符合亚马逊新的 75 字符标题标准，仅 10% 的 listing 使用高级 Q&A 模块。内容上，仅 34% 的 ASIN 达到要点和描述标准。品类中口腔护理、家居用品和宠物用品 MDEX 平均分最高，香水在美国垫底。","digestUpdatedAt","2026-10-17T10:48:27.746Z","summary","excerpt","latest","Jungle Scout 与 PODEAN 发布 2026 市场指数：美国品牌 MDEX 均分 76.7%，仅 18% 符合新标题标准。","whyHot",{"_73":74,"_75":74,"_76":74,"_77":78,"_79":-5,"_37":-5},"developments",[66],"officialReports",[],"timeline",[41],"heat",[],"related",[],{"_42":43,"_11":44,"_25":45,"_46":47,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},"id","d7qd73ev5x8rv255z8we16a5m","Jungle Scout 与 PODEAN 发布 2026 Marketplace Index：3500 品牌数据揭示亚马逊竞争新趋势","Jungle Scout 联合 PODEAN 发布 2026 Marketplace Index，基于 Cobalt 销售数据评估美英德等六国超 3500 个品牌和 50,000 个 ASIN。该机构自报调查显示，美国品牌 MDEX 平均分升至 76.7%，但仅 18% 符合新标题标准，AI Readiness 成为主要差距；多数品牌广告预算用于防御而非获取新客。","source",{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://www.junglescout.com/resources/articles/what-3500-brands-reveal-about-winning-on-amazon-in-2026/","selected",false,"factId","fs6RavVx3iXk","author-jungle-scout-shared-articles","name","Jungle Scout","kind","rss","firstParty","iconUrl","/amznews-reading-preview/_img/cac30dcab47cf624.webp",{"_56":57,"_11":67,"_68":69,"_18":19,"_15":16,"_70":71},"Jungle Scout发布2026年市场指数报告","occurredAt","2026-10-11T16:00:00.000Z","representative",{"_42":43,"_11":44,"_25":45,"_46":72,"_48":19,"_49":50,"_51":-5,"_52":53,"_54":55,"_56":57},{"_42":58,"_59":60,"_61":62,"_63":55,"_64":65},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_81":82},"changelogVersion","2026-10-09T22:08"]
