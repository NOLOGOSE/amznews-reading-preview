[{"_1":2,"_3":4},"root",{"_5":96},"routes/story",{"_5":6},"data",{"_7":8},"story",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":16,"_18":19,"_20":19,"_21":22,"_23":24,"_25":-5,"_26":-5,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"publicId","f3f47f6b-65ce-4c53-83c7-3117e1117c7e","title","ASGTG社区称亚马逊向老卖家发安全请求","status","settled","reportCount",1,"sourceCount","firstReportAt","2026-10-16T01:41:12.000Z","latestAt","digest","2026年10月16日，亚马逊卖家社区ASGTG在X上转发卖家反馈称，亚马逊的安全请求（safety requests）也正送达成熟卖家。一名卖家告诉ASGTG，Aurora地区的转售商已收到200多份涉及库存产品的安全请求，部分请求在不同卖家之间重复出现；该卖家称亚马逊解释这一流程有助于判定谁是合法卖家。这些请求还可能影响捆绑商品，同一产品的文件可能在多个listing中被要求提供。卖家们询问发票和授权书能否证明合法采购，以及安全检测能否由品牌层面统一处理。ASGTG明确表示，这是来自卖家的报告，并非亚马逊已确认的全平台政策公告，并呼吁收到类似请求的卖家反馈受影响产品及所需文件。","digestUpdatedAt","2026-10-17T15:43:36.238Z","summary","excerpt","latest","ASGTG转发卖家反馈：Aurora转售商收到200多份安全请求，非官方政策公告。","whyHot",{"_89":90,"_91":90,"_92":90,"_93":94,"_95":-5,"_37":-5},"developments",[83],"officialReports",[],"timeline",[59],"heat",[41,42,43,44,45,46],"related",[],{"_47":58,"_37":57,"_50":16},{"_47":56,"_37":57,"_50":16},{"_47":54,"_37":55,"_50":16},{"_47":52,"_37":53,"_50":16},{"_47":51,"_37":49,"_50":16},{"_47":48,"_37":49,"_50":16},"hour","2026-10-18T01:00:00.000Z",2.6,"participants","2026-10-18T00:00:00.000Z","2026-10-17T23:00:00.000Z",2.7,"2026-10-17T22:00:00.000Z",2.8,"2026-10-17T21:00:00.000Z",2.9,"2026-10-17T20:00:00.000Z",{"_60":61,"_11":62,"_25":63,"_64":65,"_66":19,"_67":68,"_69":-5,"_70":71,"_72":73,"_74":75},"id","ngv81q4zs8ncyf00zfzmprauw","ASGTG社区讨论亚马逊向卖家发送合规通知","亚马逊卖家社区 ASGTG 转发讨论称，亚马逊近期向部分卖家发送了合规相关通知。该信息源自社区用户反馈，具体涉及的通知类型、触发条件及官方回应细节在原文中未明确说明。","source",{"_60":76,"_77":78,"_79":80,"_81":73,"_82":-5},"publishedAt","publishedPrecision","timestamp","calendarDate","originalUrl","https://x.com/AmazonASGTG/status/2110908889604428142","selected",false,"factId","frPsXk-kWhBM","x-amazon-asgtg","name","X · ASGTG","kind","x_search","firstParty","iconUrl",{"_74":75,"_11":84,"_85":-5,"_18":19,"_15":16,"_86":87},"卖家称收到亚马逊安全请求","occurredAt","representative",{"_60":61,"_11":62,"_25":63,"_64":88,"_66":19,"_67":68,"_69":-5,"_70":71,"_72":73,"_74":75},{"_60":76,"_77":78,"_79":80,"_81":73,"_82":-5},"participants48h",0,"newParticipants6h","recentReports24h","observationComplete",true,"rank",{"_97":98},"changelogVersion","2026-10-09T22:08"]
