:59,"_60":232,"_62":233,"_64":-5},{"_35":209,"_37":210,"_39":211,"_41":212,"_43":213,"_45":214,"_47":215,"_49":215,"_50":51,"_52":216,"_54":115,"_56":57,"_58":59,"_60":217,"_62":218,"_64":-5},{"_35":193,"_37":194,"_39":195,"_41":196,"_43":197,"_45":198,"_47":199,"_49":199,"_50":51,"_52":200,"_54":201,"_56":57,"_58":59,"_60":202,"_62":203,"_64":-5},{"_35":176,"_37":177,"_39":178,"_41":179,"_43":180,"_45":181,"_47":182,"_49":182,"_50":183,"_52":184,"_54":115,"_56":57,"_58":59,"_60":185,"_62":186,"_64":-5},{"_35":157,"_37":158,"_39":159,"_41":160,"_43":161,"_45":162,"_47":163,"_49":163,"_50":113,"_52":164,"_54":115,"_56":57,"_58":59,"_60":165,"_62":166,"_64":-5},{"_35":139,"_37":140,"_39":141,"_41":142,"_43":143,"_45":144,"_47":145,"_49":145,"_50":51,"_52":146,"_54":147,"_56":57,"_58":59,"_60":148,"_62":149,"_64":-5},{"_35":127,"_37":128,"_39":129,"_41":130,"_43":131,"_45":132,"_47":133,"_49":133,"_50":51,"_52":134,"_54":95,"_56":57,"_58":59,"_60":135,"_62":136,"_64":-5},{"_35":106,"_37":107,"_39":108,"_41":109,"_43":110,"_45":111,"_47":112,"_49":112,"_50":113,"_52":114,"_54":115,"_56":57,"_58":59,"_60":116,"_62":117,"_64":-5},{"_35":87,"_37":88,"_39":89,"_41":90,"_43":91,"_45":92,"_47":93,"_49":93,"_50":51,"_52":94,"_54":95,"_56":57,"_58":59,"_60":96,"_62":97,"_64":-5},{"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":48,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":61,"_62":63,"_64":-5},"id","zx1i3z931v0f7cgd3t4wr0dni","title","亚马逊宣布 11 月起欧洲站物流附加费上调至 2%","summary","亚马逊宣布将欧洲多个市场的燃油及物流附加费从 1.5% 上调至 2%，FBA 订单自 11 月 2 日起生效，MCF 业务自 11 月 19 日起覆盖。新费率按配送费用计算，预计使欧洲站 FBA 卖家每件商品平均增加约 0.02 欧元成本，英国站约为 0.02 英镑。亚马逊已更新 Seller Central 中的多项经营工具以纳入新费用，并强调该附加费将根据后续市场情况持续评估。","reason","原文给出了欧洲站物流附加费上调的生效日期、适用市场及平均成本增幅，卖家可据此核算利润。","source",{"_85":86},"publishedAt","2026-10-20T00:00:00.000Z","collectedAt","2026-10-20T02:37:38.073Z","timelineAt","category","policy","tags",[82,83,84],"score",72,"selected",true,"channel","news","byline",{"_78":79,"_80":81},"media",[65],"x",{"_66":67,"_68":69,"_70":71,"_72":73,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"kind","image","url","/amznews-reading-preview/_img/5303ec716f4c025e.webp","fullUrl","/amznews-reading-preview/_img/5303ec716f4c025e.webp","srcSet","/amznews-reading-preview/_img/5303ec716f4c025e.webp 336w, /amznews-reading-preview/_img/5303ec716f4c025e.webp 720w","width","height","alt","poster","author","Summer","platform","AMZ123","费用变更","FBA/物流","亚马逊","name","AMZ123 · SUMMER","myc3rmrju2ct7vi2kx7xv42t6","亚马逊推出Listing Protection机制及Seller Challenge申诉通道","亚马逊在2026年Accelerate大会宣布推出Listing Protection机制，符合条件的卖家在商品被标记违规处理期间可保持Listing在线，该机制预计2026年底前覆盖美国站所有符合Account Health Assurance条件的卖家。","原文梳理了Listing Protection的适用条件与Seller Challenge申诉额度，为旺季合规运营提供具体参考。",{"_85":105},"2026-10-20T06:00:00.000Z","2026-10-21T02:23:13.109Z",[103,84,104],67,{"_78":102,"_80":81},[98],{"_66":67,"_68":99,"_70":100,"_72":101,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/935c89ad2fd3fe14.svg","/amznews-reading-preview/_img/935c89ad2fd3fe14.svg","/amznews-reading-preview/_img/935c89ad2fd3fe14.svg 336w, /amznews-reading-preview/_img/935c89ad2fd3fe14.svg 720w","雪球站外","AI/工具","Seller Central","AMZ123 · 跨境头条","p5bh3lhbteb297ieqx0jx3ei9","亚马逊推出 Review Requests 付费广告邀请买家评分","亚马逊宣布在 Amazon Ads 中推出 Review Requests 功能，这是一种付费广告，旨在邀请近期购买者通过一键操作留下星级评分。该功能目前仅在美国市场开放测试，要求产品总评分和评论数少于 1,000 条，达到阈值后自动暂停。亚马逊尚未公布具体定价模型，建议卖家通过计算“每个额外评分的成本”来评估效果，并将其作为 Vine 计划和免费“请求评论”按钮的补充手段，而非替代品。","原文梳理了Review Requests的资格限制、与Vine及免费按钮的区别，并提供了基于增量评分成本的测试方法。",{"_85":126},"2026-10-20T06:38:49.000Z","2026-10-20T11:11:41.143Z","advertising",[124,84,125],62,{"_78":122,"_80":123},[118],{"_66":67,"_68":119,"_70":120,"_72":121,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/23b5f2b0c24038ac.webp","/amznews-reading-preview/_img/23b5f2b0c24038ac.webp","/amznews-reading-preview/_img/23b5f2b0c24038ac.webp 336w, /amznews-reading-preview/_img/23b5f2b0c24038ac.webp 720w","George Meressa","ClearAds Agency","广告/运营","Amazon Ads","ClearAds Agency 亚马逊广告文章","oyh18c2kk75j7akiynb9vqujl","亚马逊广告推出 Review Requests 功能，10月下旬美国站开启公测","亚马逊广告宣布推出 Review Requests 功能，计划于2026年10月下旬在美国站进入公开测试阶段。卖家可通过 Amazon Ads Agent 创建广告活动，向近期购买者展示原生邀评广告以获取星级评分或评价。该功能主要面向累计评论少于1000条的商品，达到上限后广告自动暂停，旨在帮助新品卖家缩短评论积累周期并提升真实反馈比例。","原文梳理了亚马逊Review Requests功能的测试时间、适用条件及运作流程，为新品卖家提供了站内合规邀评的新路径参考。",{"_85":105},"2026-10-20T07:59:00.000Z","2026-10-21T02:23:13.034Z",[103,84,125],{"_78":138,"_80":81},[137],{"_66":67,"_68":99,"_70":100,"_72":101,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"速推站外","knwhuqm2cvh1ruudoggx2asg4","亚马逊美国站商业责任险新规11月2日生效，大陆卖家须通过AIA投保","亚马逊公布美国站商业责任险新规将于11月2日正式生效，规定销售具有更严格安全要求的商品无论销售额高低均须投保，且中国大陆卖家新提交保单必须通过亚马逊保险加速器（AIA）获取。不符合要求的listing将被停售，保单需满足每次事故及累计赔偿限额至少100万美元等13项标准。","原文梳理了亚马逊美国站商业责任险新规的生效时间、触发条件及中国大陆卖家通过AIA投保的具体要求。",{"_85":156},"2026-10-20T10:01:33.000Z","2026-10-20T10:37:38.068Z",[155,84],88,{"_78":84,"_80":154},[150],{"_66":67,"_68":151,"_70":152,"_72":153,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/1e106d54b9a1553b.webp","/amznews-reading-preview/_img/1e106d54b9a1553b.webp","/amznews-reading-preview/_img/1e106d54b9a1553b.webp 336w, /amznews-reading-preview/_img/1e106d54b9a1553b.webp 720w","雨果跨境","政策/合规","雨果跨境 · 亚马逊频道最新","gyk8t0gfma3991fzuadhxipj4","亚马逊 AI 购物助手推荐逻辑解析：为何多数选品不依赖搜索排名","ZonFlip 引用 Marketplace Pulse 及 Autopilotbrand.com 的研究指出，亚马逊 AI 购物助手（Alexa for Shopping）的推荐结果与传统的自然搜索排名和广告投放关联度较低。","文章基于第三方调研数据，指出亚马逊AI购物助手推荐结果与搜索排名存在显著差异，为卖家提供了应对新流量入口的运营思路。",{"_85":175},"2026-10-20T10:12:41.000Z","2026-10-20T10:57:42.001Z",[173,174,84],{"_78":171,"_80":172},[167],{"_66":67,"_68":168,"_70":169,"_72":170,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/148d944238cddc44.webp","/amznews-reading-preview/_img/148d944238cddc44.webp","/amznews-reading-preview/_img/148d944238cddc44.webp 336w, /amznews-reading-preview/_img/148d944238cddc44.webp 720w","Joey Glyshaw","ZonFlip","行业动态","AI工具","ZonFlip · Joey Glyshaw","be3ozmi5kkxrt6le171lmi6ig","亚马逊后台新增“创建卖家工作流程”功能及实操方法","亚马逊后台新增“创建卖家工作流程”（Seller Assistant Workflows）功能，允许卖家将重复性运营任务设计为持续运行的自动化流程。原文作者分享了该功能与早期Agent能力的区别，并提供了重点ASIN销量变化日报、账户健康待办巡检和重点商品价格观察三个具体任务的指令模板，强调需明确数据口径、判断标准和操作边界才能有效使用。","作者拆解了亚马逊后台新增的卖家工作流程功能，并提供了销量日报、账户巡检和价格观察三个场景的具体指令模板。",{"_85":192},"2026-10-20T17:30:00.000Z","2026-10-21T09:45:08.666Z","ai-tools",[103,124,84],{"_78":191,"_80":81},[187],{"_66":67,"_68":188,"_70":189,"_72":190,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/484fefd2b6df002f.webp","/amznews-reading-preview/_img/484fefd2b6df002f.webp","/amznews-reading-preview/_img/484fefd2b6df002f.webp 336w, /amznews-reading-preview/_img/484fefd2b6df002f.webp 720w","Regan跨境","AMZ123 · Regan跨境","k019k6agv4ojxo64yc6acny7k","美国IOR监管趋严，亚马逊提醒卖家自查进口主体","亚马逊向美国站卖家发送风险提示邮件，提醒核实发货使用的IOR（进口备案人）属于美国本土实体还是境外实体。此次变动源于2026年6月3日签署的第14411号行政令《加强海关执法》，要求国土安全部与CBP在2026年11月30日前完成进口商资质条款修订。","原文梳理了美国IOR新规对进口商资质和保证金的收紧要求，并给出了卖家自查货代配套IOR属性的具体步骤。",{"_85":105},"2026-10-20T18:19:00.000Z","2026-10-21T02:23:12.996Z",[155,84,83],74,{"_78":208,"_80":81},[204],{"_66":67,"_68":205,"_70":206,"_72":207,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/d031d52c2a21e8ae.webp","/amznews-reading-preview/_img/d031d52c2a21e8ae.webp","/amznews-reading-preview/_img/d031d52c2a21e8ae.webp 336w, /amznews-reading-preview/_img/d031d52c2a21e8ae.webp 720w","北美电商资讯","g673jzl01inbiu8f9x4evz3r4","亚马逊欧洲10站燃油物流附加费上调至2% 11月旺季生效","亚马逊宣布自2026年11月2日起将欧洲10个站点的FBA燃油及物流附加费从1.5%上调至2%，MCF服务自11月19日起执行。计费基数为配送费，平台称平均每件增加约0.02欧元，作者分析指出这收回了年初降费的约四成，且因按百分比计算会与旺季配送费叠加，大件重货受影响更大。","原文梳理了欧洲站燃油物流附加费上调的具体费率、生效日期及与旺季配送费的叠加影响，并对比了历史降费数据。",{"_85":105},"2026-10-20T23:12:00.000Z","2026-10-21T10:31:12.381Z",[155,83,82,84],{"_78":223,"_80":81},[219],{"_66":67,"_68":220,"_70":221,"_72":222,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/41d8eda1e60d3ba6.webp","/amznews-reading-preview/_img/41d8eda1e60d3ba6.webp","/amznews-reading-preview/_img/41d8eda1e60d3ba6.webp 336w, /amznews-reading-preview/_img/41d8eda1e60d3ba6.webp 720w","欧洲跨境之路","owjehrlrkwho1jcpthmor8byn","亚马逊NWD下架通知倒计时及卖家应对指南","亚马逊向部分卖家发送NWD（无批发分销）通知，要求2026年10月27日前处理相关库存，否则可能被弃置。该通知由系统批量发送给品牌代表和分销商两类账号，品牌代表角色可忽略，但需确认后台登记无误。自有品牌若因角色同步问题误收通知，应先修正后台配置再提交Case申诉。分销型、铺货型等卖家需尽快创建移除订单或清仓，注意旺季移除周期可能长达10到30天。","原文梳理了NWD通知的误发逻辑与申诉步骤，并给出不同身份卖家的库存处理方案。",{"_85":105},"2026-10-21T01:05:00.000Z","2026-10-22T02:32:47.060Z",[155,84,83],{"_78":238,"_80":81},[234],{"_66":67,"_68":235,"_70":236,"_72":237,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/d18a82cff56146f5.webp","/amznews-reading-preview/_img/d18a82cff56146f5.webp","/amznews-reading-preview/_img/d18a82cff56146f5.webp 336w, /amznews-reading-preview/_img/d18a82cff56146f5.webp 720w","三头六臂跨境电商联盟","nidam1apulzytsayl6rqtew5v","亚马逊上线Listing Protection机制，违规审核期链接可保持在线","亚马逊在2026 Amazon Accelerate大会发布Listing Protection（商品信息保护）新机制，符合条件的卖家在商品被标记违规时，多数情况下Listing可继续在线销售直至审核完成。","原文梳理了Listing Protection的准入条件与申诉规则，为卖家提供旺季链接保护的实操参考。",{"_85":156},"2026-10-21T07:14:57.000Z","2026-10-21T08:13:08.261Z",[103,84],{"_78":249,"_80":154},[],"Jackson跨境智多星","soobkm191itpfweiq8iux9usl","亚马逊推出Amazon Ads Agent及全漏斗广告活动","亚马逊推出AI驱动的Amazon Ads Agent平台，整合赞助广告、DVA+及全漏斗广告活动，帮助广告主打通从曝光到购买的链路。官方数据显示，2026年6月至8月测试期间，长期ROAS提升67%，新客获取成本降低29%（基于内部测试）。目前全漏斗广告已向美国部分广告主开放公测，DVA+计划于2026年10月下旬逐步开放。","原文梳理了亚马逊新推出的全漏斗广告功能及测试数据，卖家可了解其如何整合多类广告并优化预算分配。",{"_85":156},"2026-10-21T07:29:01.000Z","2026-10-21T08:13:08.255Z",[124,174,84,125],{"_78":260,"_80":154},[],"Yiju谈跨境","kyrnypufzhh46wk62te5n7kut","亚马逊美国站灰度测试前台AI商品摘要模块","亚马逊在美国站灰度测试新的AI商品摘要模块，由Alexa自动从Listing信息中提炼3条核心卖点展示在五点描述附近。该功能目前未全量开放，同一商品在不同设备或账号下展示情况可能不同。作者提醒卖家注意核心卖点被错序抓取、关键词堆砌干扰判断、变体信息冲突以及违规话术被优先展示等风险，建议通过定期自查前台、精简前置核心卖点、补齐后台结构化属性及统一全页面信息来优化Listing。","原文解析了亚马逊美国站灰度测试的AI摘要功能，指出其抓取逻辑与卖家需防范的合规及信息错序风险。",{"_85":156},"2026-10-21T08:10:31.000Z","2026-10-21T09:17:10.011Z",[103,276,84],{"_78":275,"_80":154},[271],{"_66":67,"_68":272,"_70":273,"_72":274,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/9acdd32de669625e.webp","/amznews-reading-preview/_img/9acdd32de669625e.webp","/amznews-reading-preview/_img/9acdd32de669625e.webp 336w, /amznews-reading-preview/_img/9acdd32de669625e.webp 720w","小黄银站外推广","Listing优化","z5xn1jjuho8oshovbbod3j5px","亚马逊提醒卖家核查进口商身份以应对美国进口新规审查","亚马逊向美国站卖家发出邮件通知，提醒提前核查备案进口商（IOR）身份及清关安排，以应对已进入白宫审查阶段的联邦规则。该规则源于第14411号行政令，拟根据IOR是美国实体或外国实体设置差异化合规要求，其中针对外国IOR的条款可能率先生效。","原文梳理了美国进口新规对IOR身份的具体合规要求及潜在成本影响，为卖家提供了自查路径与应对建议。",{"_85":105},"2026-10-22T02:45:00.000Z","2026-10-23T01:40:37.322Z",[155,84,83,289],{"_78":288,"_80":81},[287],{"_66":67,"_68":99,"_70":100,"_72":101,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"腾信物流","供应链","qny6lz83jjrjxhpkeavv42jjx","德国包装新规实施：境外卖家需指定包装EPR授权代表","自2026年8月12日起，无德国分支机构且直接向德国终端用户提供带包装商品的境外企业，须指定符合要求的德国包装EPR授权代表。该义务独立于产品欧代，已有LUCID注册号的卖家需核实并补充资料；同一生产者仅可指定一名授权代表，且协议须以德语签署并经系统确认生效。","原文梳理了德国包装EPR授权代表与产品欧代的区别，并给出了LUCID资料更新的具体核查步骤。",{"_85":105},"2026-10-22T03:41:00.000Z","2026-10-23T01:40:37.264Z",[155,305,84],{"_78":304,"_80":81},[300],{"_66":67,"_68":301,"_70":302,"_72":303,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/67e71883b6bb7907.webp","/amznews-reading-preview/_img/67e71883b6bb7907.webp","/amznews-reading-preview/_img/67e71883b6bb7907.webp 336w, /amznews-reading-preview/_img/67e71883b6bb7907.webp 720w","腾邦说跨境","合规税务","wqu8fvktsbzu7cjx7t7umfn8z","亚马逊美国站下发NWD限售邮件，要求卖家在10月27日前核对品牌销售角色","亚马逊美国站向部分卖家发送通知，称相关商品将于2026年10月27日起被移除，仅拥有对应品牌代表角色的卖家可继续销售。此类限制针对不开放第三方批发分销（NWD）的品牌，即使持有正规发票或线下授权，若账号未绑定正确的Brand Representative或Reseller角色也可能受限。","原文梳理了NWD限售邮件的触发逻辑与自查步骤，帮助卖家区分品牌管理权限与销售角色，明确截止前的库存处理路径。",{"_85":105},"2026-10-22T06:00:00.000Z","2026-10-23T02:12:30.770Z",[155,84],{"_78":102,"_80":81},[316],{"_66":67,"_68":99,"_70":100,"_72":101,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"fgtxgbn8lwtbk8xhn0t992yvz","亚马逊推出 Listing Protection 机制允许部分违规链接在审核期继续销售","亚马逊在 Amazon Accelerate 大会公布 Listing Protection 机制，允许被标记为政策违规的商品 Listing 在符合条件时于审核期间保持在线，供卖家整改或申诉。","原文梳理了 Listing Protection 的适用条件与流程变化，帮助卖家理解违规审核期间链接保持在线的具体规则。",{"_85":329},"2026-10-22T08:49:30.000Z","2026-10-22T11:38:28.909Z",[155,84,276],{"_78":327,"_80":328},[],"跨境资讯通","卖家之家","卖家之家 · 跨境资讯","lqz9gk9mglvrj1wpifejpsqji","Venture Forge发布2026年亚马逊英国站秋季大促市场数据","电商分析机构Venture Forge公布2026年亚马逊英国站Prime Big Deal Days数据，该周期内总销售额达10.6亿英镑，同比增长22%。其中第三方卖家增速（27.5%）接近自营卖家（13.9%）的两倍，且并非依靠更深折扣取胜。在追踪的10个主要品类中，第三方卖家有8个品类增速超过自营；韩国护肤品牌借势大促快速抢占市场份额，其在该品类中的占比从去年的9%升至25%。","原文引用了第三方机构对英国站大促的追踪数据，拆解了不同渠道和品类的销售表现差异。",{"_85":105},"2026-10-22T19:16:00.000Z","2026-10-23T03:16:32.691Z","product",[346,347,348,84],{"_78":345,"_80":81},[341],{"_66":67,"_68":342,"_70":343,"_72":344,"_74":-5,"_75":-5,"_76":-5,"_77":-5},"/amznews-reading-preview/_img/92c4f26b0516012f.webp","/amznews-reading-preview/_img/92c4f26b0516012f.webp","/amznews-reading-preview/_img/92c4f26b0516012f.webp 336w, /amznews-reading-preview/_img/92c4f26b0516012f.webp 720w","亚马逊资讯","数据/报告","选品/市场","品类趋势","l3rn4y9e88vuei9t9mbbtp9gd","亚马逊NWD通知引卖家关注：10月27日移除订单提交截止，收到邮件不等于下架","近期部分卖家收到亚马逊NWD（品牌方仅做DTC直营、不向批发商或第三方转售商供货）相关通知，邮件提及商品10月27日下架、逾期未处理FBA库存可能被弃置。原文指出，本轮通知由系统批量发给品牌代表和分销商两类账号、不单独识别角色，收到邮件不等于下架，关键看账号在品牌备案后台是否登记为Brand Representative且角色生效；已登记且角色生效的正常销售不受影响，授权经销商、普通转售商不等于品牌代表。原文按品牌维度判定风险，列出分销型、铺货型、精铺型、拿货转售四类高风险卖家，并给出自有品牌误通知、正规分销商、品牌本身属NWD模式、合法经销体系被误判四种场景的应对步骤；其中货物无需27日前实际出库，截止日前成功提交移除订单即可避免弃置。以上为原文观点，具体规则与账号状态需以亚马逊后台及官方通知为准。","原文区分了系统批量通知与确定下架，说明需先核对Brand Representative角色再匹配应对方案，并给出四类高风险卖家与分场景处理步骤，同时保留提交移除订单即可避免弃置的条件。",{"_85":329},"2026-10-23T01:32:00.000Z","2026-10-23T02:02:27.832Z",[155,83,84],{"_78":359,"_80":328},[],"海象跨境","qzmmoq731wpzau4mal0lbt2wb","2026年亚马逊英国站秋季大促销售额达10.6亿英镑，第三方卖家增速显著","电商分析机构 Venture Forge 公布 2026 年亚马逊英国站 Prime Big Deal Days 数据，大促周总销售额预计达 10.6 亿英镑，同比增长 22%。","Venture Forge 数据显示第三方卖家增速近自营两倍，且非依赖深折，为黑五备货与渠道策略提供量化参考。",{"_85":329},"2026-10-23T03:33:09.000Z","2026-10-23T04:58:30.197Z",[346,84],{"_78":327,"_80":328},[],"slug","amazon","亚马逊 / Amazon","group","company","definition","亚马逊官方的全部卖家相关动态：政策、费用、平台功能与全球开店的最新消息。","total",85,"recent",52,"indexable","latestAt","related",[385,386,387],{"_370":391,"_85":392},{"_370":389,"_85":390},{"_370":113,"_85":388},"广告投放","fba","FBA 与物流","policy-announcements","政策与公告",{"_394":395},"changelogVersion","2026-10-09T22:08"]
