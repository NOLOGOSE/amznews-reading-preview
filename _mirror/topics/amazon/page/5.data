[{"_1":2,"_3":4},"root",{"_5":182},"topic-page",{"_5":6},"data",{"_5":7},{"_8":9,"_10":11,"_12":13,"_14":13},"topic",{"_158":159,"_75":160,"_161":162,"_163":164,"_165":166,"_167":168,"_169":42,"_170":171,"_172":173},"items",[15,16,17,18,19],"page",5,"pageCount",{"_20":142,"_22":143,"_24":144,"_26":145,"_28":146,"_30":147,"_32":148,"_34":147,"_35":36,"_37":149,"_39":40,"_41":42,"_43":44,"_45":150,"_47":151,"_49":-5},{"_20":113,"_22":114,"_24":115,"_26":116,"_28":117,"_30":118,"_32":119,"_34":118,"_35":84,"_37":120,"_39":40,"_41":42,"_43":49,"_45":-5,"_47":121,"_49":122},{"_20":95,"_22":96,"_24":97,"_26":98,"_28":99,"_30":100,"_32":101,"_34":100,"_35":84,"_37":102,"_39":40,"_41":42,"_43":44,"_45":103,"_47":104,"_49":-5},{"_20":77,"_22":78,"_24":79,"_26":80,"_28":81,"_30":82,"_32":83,"_34":82,"_35":84,"_37":85,"_39":40,"_41":42,"_43":44,"_45":86,"_47":87,"_49":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":31,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","ny0pehwcbufue3nmvohbwky1w","title","亚马逊推出多项 AI 工具，帮助卖家更快上线新品","summary","亚马逊宣布推出和升级多项面向卖家的 AI 工具，包括 AI 版 Opportunity Explorer、Unmet Demand Insights 和 Niche Product Overview，用于识别未满足需求和选品机会。","reason","亚马逊官方集中发布面向新品上线的多项 AI 工具与 Vine、A+ 内容升级，卖家可据此了解各功能的作用与适用环节。","source",{"_75":76},"publishedAt","2025-09-18T13:00:18.517Z","collectedAt","2026-10-07T15:34:47.328Z","timelineAt","category","ai-tools","tags",[69,70,71,72,73,74],"score",62,"selected",true,"channel","news","byline",{"_65":66,"_67":68},"media",[50],"x",{"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":62,"_63":-5,"_64":-5},"kind","image","url","/amznews-reading-preview/_img/ee18af70c8b3009e.webp","fullUrl","/amznews-reading-preview/_img/ee18af70c8b3009e.webp","srcSet","/amznews-reading-preview/_img/ee18af70c8b3009e.webp 336w, /amznews-reading-preview/_img/ee18af70c8b3009e.webp 720w","width",1240,"height",698,"alt","poster","author","Mary Beth Westmoreland","platform","About Amazon","AI/工具","亚马逊","AI工具","选品/市场","Listing优化","FBA/物流","name","About Amazon · 创新","eejgxxyhkygoq27qj94bljfxr","亚马逊推出全球仓储与配送服务GWD，并扩展AGL与AI清关工具","亚马逊宣布推出全球仓储与配送服务（GWD），让卖家在制造地附近低成本批量备货，再按需发往各目的国，早期试点中商品进入FBA网络最多快7天。亚马逊同时扩展Amazon Global Logistics直航运线，预计到2026年底AGL覆盖卖家发往FBA的96%入境货量，并用生成式AI预填商品分类等清关字段，早期结果显示卖家清关文书时间减少一半以上。","亚马逊官方披露供应链服务多项更新，含GWD新服务、AGL覆盖目标和AI清关工具，卖家可据此评估物流布局。",{"_75":94},"2025-09-18T13:00:24.125Z","2026-09-30T06:05:39.650Z","fba",[74,93,71,70],{"_65":92,"_67":68},[88],{"_51":52,"_53":89,"_55":90,"_57":91,"_59":60,"_61":62,"_63":-5,"_64":-5},"/amznews-reading-preview/_img/fb49327ae0aa6a2c.webp","/amznews-reading-preview/_img/fb49327ae0aa6a2c.webp","/amznews-reading-preview/_img/fb49327ae0aa6a2c.webp 336w, /amznews-reading-preview/_img/fb49327ae0aa6a2c.webp 720w","Dharmesh Mehta","供应链","About Amazon · 小企业与卖家","fsnb2eqexgczapnxseyu4qf8q","亚马逊卖家获取Listing页面当日达次日达标标识的实操指南","亚马逊全球开店发布卖家常见问题解答，指导如何提升商品前台“当日达/次日达”标识的展示比例。文章指出该标识由系统根据消费者位置与库存分布实时匹配，建议卖家将头部ASIN库存维持在6-8周并每3周规律补货，优先选择多点入仓或使用BPR包装方式（每件可获$0.15配送费折扣），并通过“配送时效”报告验证调整效果。","原文以问答形式梳理了提升当日达次日达标展示比例的实操方法，涵盖数据查询、库存分布与入仓策略。",{"_75":112},"2026-04-24T16:00:00.000Z","2026-10-16T14:28:58.347Z",[110,74,111,70],{"_65":-5,"_67":109},[105],{"_51":52,"_53":106,"_55":107,"_57":108,"_59":-5,"_61":-5,"_63":-5,"_64":-5},"/amznews-reading-preview/_img/f74530c464ee3450.webp","/amznews-reading-preview/_img/f74530c464ee3450.webp","/amznews-reading-preview/_img/f74530c464ee3450.webp 336w, /amznews-reading-preview/_img/f74530c464ee3450.webp 720w","亚马逊全球开店","广告/运营","库存管理","亚马逊全球开店 · 官方资讯","t3rtv4jxpoy9awz1mfjqseexn","亚马逊向所有企业开放 Amazon Supply Chain Services","亚马逊 CEO Andy Jassy 宣布 Amazon Supply Chain Services 现已向任何企业开放。该服务整合了亚马逊近三十年构建的货运、分销、履约和包裹运输网络，覆盖陆海空全链路，无需拼接不同供应商。目前 P&G、3M、Lands' End 和 American Eagle 已接入使用。","亚马逊CEO宣布其内部物流网络向所有企业开放，已有宝洁等品牌接入，为卖家提供一体化供应链替代方案。",{"_75":141},"2026-05-05T02:28:36.000Z","2026-10-16T18:20:07.238Z",[74,93,70],[],{"_123":124,"_125":126,"_127":128,"_129":130,"_47":131,"_132":-5},"authorName","Andy Jassy","handle","ajassy","avatarUrl","/amznews-reading-preview/_img/missing.svg","avatarSrcSet","/amznews-reading-preview/_img/missing.svg 48w, /amznews-reading-preview/_img/missing.svg 96w",[133],"quoted",{"_51":134,"_53":135,"_136":137,"_57":138,"_59":139,"_61":140,"_63":-5,"_64":135},"video","/amznews-reading-preview/_img/missing.svg","originalUrl","https://x.com/ajassy/status/2051489206737006810","/amznews-reading-preview/_img/missing.svg 336w, /amznews-reading-preview/_img/missing.svg 720w",1920,1080,"X · Andy Jassy","yf6fxxom7wq7y1zysxqekj1yp","亚马逊美国站上线Alexa for Shopping AI购物助手","原文介绍，亚马逊美国站搜索框旁出现Alexa for Shopping，由Rufus与Alexa+合并而成。原文以举例方式描述其可能具备价格提醒、历史价格查询、定期自动加购及站外商品购买等功能。原文作者据此分析，买家搜索习惯可能变化，流量分配或从关键词搜索向自然语言语义推荐转移，并建议卖家在Listing中增加具体应用场景、人群痛点和差异化信息描述。上述流量变化与优化建议属作者分析，原文未提供平台规则或效果证据。","原文梳理了亚马逊新AI助手的功能设想，并给出从关键词布局转向场景化语义优化的思路；相关流量影响为作者分析，非平台已公布规则。",{"_75":157},"2026-05-21T14:58:51.000Z","2026-10-16T14:43:54.249Z",[69,73,110,70],{"_65":-5,"_67":156},[152],{"_51":52,"_53":153,"_55":154,"_57":155,"_59":-5,"_61":-5,"_63":-5,"_64":-5},"/amznews-reading-preview/_img/0da89f4e56cc6ba8.webp","/amznews-reading-preview/_img/0da89f4e56cc6ba8.webp","/amznews-reading-preview/_img/0da89f4e56cc6ba8.webp 336w, /amznews-reading-preview/_img/0da89f4e56cc6ba8.webp 720w","蓝海亿观网","蓝海亿观网 · 跨境电商资讯","slug","amazon","亚马逊 / Amazon","group","company","definition","亚马逊官方的全部卖家相关动态：政策、费用、平台功能与全球开店的最新消息。","total",85,"recent",52,"indexable","latestAt","2026-10-23T03:33:09.000Z","related",[174,175,176],{"_158":180,"_75":181},{"_158":84,"_75":179},{"_158":177,"_75":178},"advertising","广告投放","FBA 与物流","policy-announcements","政策与公告",{"_183":184},"changelogVersion","2026-10-09T22:08"]
