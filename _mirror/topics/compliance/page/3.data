[{"_1":2,"_3":4},"root",{"_5":134},"topic-page",{"_5":6},"data",{"_5":7},{"_8":9,"_10":11,"_12":13,"_14":13},"topic",{"_113":114,"_68":115,"_116":117,"_118":119,"_120":121,"_122":123,"_124":41,"_125":126,"_127":128},"items",[15,16,17,18],"page",3,"pageCount",{"_19":98,"_21":99,"_23":100,"_25":101,"_27":102,"_29":103,"_31":104,"_33":103,"_34":77,"_36":105,"_38":106,"_40":41,"_42":43,"_44":107,"_46":108,"_48":-5},{"_19":86,"_21":87,"_23":88,"_25":89,"_27":90,"_29":91,"_31":92,"_33":91,"_34":35,"_36":93,"_38":94,"_40":41,"_42":43,"_44":95,"_46":96,"_48":-5},{"_19":70,"_21":71,"_23":72,"_25":73,"_27":74,"_29":75,"_31":76,"_33":75,"_34":77,"_36":78,"_38":79,"_40":41,"_42":43,"_44":80,"_46":81,"_48":-5},{"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":30,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","iy7mqi2ymzg8ktngwquwd76v2","title","亚马逊公布2026年SIPP新规及卖家注册指南","summary","亚马逊发布2026年自有包装发货计划（SIPP）新规，未加入该计划的大件商品每件将收取$1.51-$4.04包装费，加入即可减免。官方提供了通过后台报告诊断、ASIN分组及测试提交的3步注册流程，并说明了新旧库存共存规则与退货处理标准。","reason","原文详细拆解了2026年大件商品SIPP新规的费率变化与3步注册流程，并解答了库存共存等实操疑问。","source",{"_68":69},"publishedAt","2026-06-02T16:00:00.000Z","collectedAt","2026-10-16T14:13:44.257Z","timelineAt","category","fba","tags",[65,66,67],"score",71,"selected",true,"channel","news","byline",{"_62":-5,"_63":64},"media",[49],"x",{"_50":51,"_52":53,"_54":55,"_56":57,"_58":-5,"_59":-5,"_60":-5,"_61":-5},"kind","image","url","/amznews-reading-preview/_img/47a1a46fff7d7c4c.webp","fullUrl","/amznews-reading-preview/_img/47a1a46fff7d7c4c.webp","srcSet","/amznews-reading-preview/_img/47a1a46fff7d7c4c.webp 336w, /amznews-reading-preview/_img/47a1a46fff7d7c4c.webp 720w","width","height","alt","poster","author","platform","亚马逊全球开店","政策/合规","FBA/物流","亚马逊","name","亚马逊全球开店 · 官方资讯","lz9ccwekpos0xm1yzb6r7c7zm","亚马逊实施75字符商品标题限制及Item Highlights新规","亚马逊宣布自2026年7月27日起，除媒体类目外所有商品标题不得超过75个字符（含空格），并新增125字符的可搜索字段 Item Highlights。未合规标题将由亚马逊 AI 自动重写，仅品牌备案卖家拥有14天审核窗口。","原文梳理了75字符标题新规与Item Highlights字段，提供了卖家在AI强制重写前自查并调整Listing的具体步骤。",{"_68":85},"2026-07-06T07:05:43.000Z","2026-10-09T11:38:35.262Z","policy",[65,84,67],78,{"_62":82,"_63":83},[],"George Meressa","ClearAds Agency","Listing优化","ClearAds Agency 亚马逊广告文章","ayn2z2n9c1m9ou9qqfoybx9yl","亚马逊美国站AWD将于7月31日起停止接受大件商品入仓","亚马逊宣布自2026年7月31日起，美国站AWD仅接受标准尺寸商品入仓，超过长18英寸、宽14英寸、高8英寸或重20磅任一阈值的商品将无法创建AWD货件。受影响的大件商品需直接发送至FBA仓库或使用GWD作为替代方案；已在AWD库内的大件库存无需移出，可继续正常补货至FBA直至出库，且7月31日前创建的货件不受影响。","原文明确了AWD大件商品入仓的尺寸重量阈值及生效日期，并提供了GWD替代方案与存量库存处理指引。",{"_68":69},"2026-07-10T16:00:00.000Z","2026-10-16T14:13:44.127Z",[65,66,97,67],69,{"_62":-5,"_63":64},[],"库存管理","blqar4ut02jmoxwzghw3p8xzw","亚马逊提醒卖家在8月12日前完成欧盟包装法合规","亚马逊发布通知提醒卖家，欧盟《包装与包装废弃物法规》（PPWR）将于8月12日正式生效，未合规商品可能面临停售风险。所有向欧盟配送带包装商品的卖家需在截止日期前获取各目的国注册号（ERN）并上传至卖家平台；法国和西班牙站点的代付服务转为新模式，需先自行注册号码再选择是否继续由亚马逊代为申报缴费，奥地利站点则提供涵盖电池、包装和WEEE类目的注册加代付一站式服务。","原文汇总了欧盟包装法生效前的注册与上传要求，并说明了代付模式变化及验证滞后等实操细节。",{"_68":69},"2026-07-12T16:00:00.000Z","2026-10-16T14:13:44.119Z",[65,66,67],82,{"_62":-5,"_63":64},[109],{"_50":51,"_52":110,"_54":111,"_56":112,"_58":-5,"_59":-5,"_60":-5,"_61":-5},"/amznews-reading-preview/_img/7816f3331d0ac461.webp","/amznews-reading-preview/_img/7816f3331d0ac461.webp","/amznews-reading-preview/_img/7816f3331d0ac461.webp 336w, /amznews-reading-preview/_img/7816f3331d0ac461.webp 720w","slug","compliance","合规与税务","group","field","definition","合规与税务：VAT、产品合规、品牌备案与各站点监管要求。","total",44,"recent",30,"indexable","latestAt","2026-10-23T01:32:00.000Z","related",[129,130],{"_113":132,"_68":133},{"_113":35,"_68":131},"FBA 与物流","policy-announcements","政策与公告",{"_135":136},"changelogVersion","2026-10-09T22:08"]
