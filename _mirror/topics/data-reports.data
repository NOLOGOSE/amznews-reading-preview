[{"_1":2,"_3":4},"root",{"_5":175},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_153":154,"_74":155,"_156":157,"_158":159,"_160":161,"_162":163,"_164":165,"_166":147,"_167":168},"items",[14,15,16,17,18,19],"page",1,"pageCount",{"_20":142,"_22":143,"_24":144,"_26":145,"_28":146,"_30":147,"_32":148,"_34":148,"_35":36,"_37":149,"_39":40,"_41":42,"_43":44,"_45":150,"_47":151,"_49":-5},{"_20":129,"_22":130,"_24":131,"_26":132,"_28":133,"_30":134,"_32":135,"_34":135,"_35":36,"_37":136,"_39":40,"_41":42,"_43":44,"_45":137,"_47":138,"_49":-5},{"_20":114,"_22":115,"_24":116,"_26":117,"_28":118,"_30":119,"_32":120,"_34":120,"_35":36,"_37":121,"_39":40,"_41":42,"_43":44,"_45":122,"_47":123,"_49":-5},{"_20":96,"_22":97,"_24":98,"_26":99,"_28":100,"_30":101,"_32":102,"_34":101,"_35":36,"_37":103,"_39":40,"_41":42,"_43":44,"_45":104,"_47":105,"_49":-5},{"_20":76,"_22":77,"_24":78,"_26":79,"_28":80,"_30":81,"_32":82,"_34":81,"_35":36,"_37":83,"_39":84,"_41":42,"_43":44,"_45":85,"_47":86,"_49":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":31,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","gy3vj64j8pb1honnxcqz8byo0","title","Feedvisor 发布 Prime Day 2026 数据：营收增长但盈利难度加大","summary","Feedvisor 分析显示，其客户在 Prime Day 2026 期间销售额同比增长 25%，但平均订单价值下降 5.8%。由于 CPC 和 CPM 分别上涨 13.5% 和 11%，商品详情页转化率从 3.23% 提升至 5.20% 成为维持利润的核心因素。此外，亚马逊自 4 月起收紧参考价规则，要求划线价必须有真实成交记录支撑，这促使卖家放弃虚假折扣以换取更高的价格可信度。","reason","原文结合第三方数据与自身客户样本，指出转化率提升是抵消流量成本上涨的关键，并提示了定价规则收紧对折扣可信度的影响。","source",{"_74":75},"publishedAt","2026-07-13T18:21:11.000Z","collectedAt","2026-10-16T14:43:47.681Z","timelineAt","category","product","tags",[70,71,72,73],"score",62,"selected",true,"channel","news","byline",{"_66":67,"_68":69},"media",[50],"x",{"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":-5},"kind","image","url","/amznews-reading-preview/_img/aad8904875ceabda.webp","fullUrl","/amznews-reading-preview/_img/aad8904875ceabda.webp","srcSet","/amznews-reading-preview/_img/aad8904875ceabda.webp 336w, /amznews-reading-preview/_img/aad8904875ceabda.webp 720w","width",123,"height",107,"alt","","poster","author","Marissa Incitti","platform","Feedvisor","数据/报告","广告/运营","选品/市场","亚马逊","name","Feedvisor · 亚马逊运营与数据博客","ejaut0xzgyckhb73ku9j99tpb","Seller Snap 发布 Prime Day 2026 定价与需求数据分析报告","Seller Snap 分析美国站超 10 万款商品发现，仅 18% 的商品在 Prime Day 期间降价 5% 以上，却贡献了 70% 的销量增长。数据显示折扣越深销量提升越大（如降价 30% 以上销量激增 771%），且大幅降价品类在活动后出现明显的销量回落。","基于10万款商品同品对比，量化了折扣深度与销量增幅的阶梯关系，并验证了促销后的需求透支效应。",{"_74":95},"2026-07-15T07:47:44.000Z","2026-10-16T16:16:44.568Z",[70,72,73],66,{"_66":93,"_68":94},[87],{"_51":52,"_53":88,"_55":89,"_57":90,"_59":91,"_61":92,"_63":64,"_65":-5},"/amznews-reading-preview/_img/d3aafc60a2d4fe9a.webp","/amznews-reading-preview/_img/d3aafc60a2d4fe9a.webp","/amznews-reading-preview/_img/d3aafc60a2d4fe9a.webp 336w, /amznews-reading-preview/_img/d3aafc60a2d4fe9a.webp 720w",640,335,"Julian Goldhill","Seller Snap","Seller Snap · 亚马逊调价与 Buy Box 博客","i6hnhpokxg74kva9wqgwz0v5h","Marketplace Pulse发布2026年TikTok Shop美国站趋势报告：头部卖家销售额占比59%","Marketplace Pulse发布《2026年TikTok Shop美国站趋势报告》，基于截至2026年9月的追踪数据显示，TikTok Shop美国站前1%的卖家贡献了59%的销售额，美妆、服饰和健康类商品占据主导。","原文归纳了TikTok Shop美国站头部卖家集中度高及内容驱动销售等七大趋势，为品牌评估跨平台运营策略提供了数据参考。",{"_74":113},"2026-10-16T02:07:00.000Z","2026-10-16T14:43:50.705Z",[70,72,112,73],{"_66":110,"_68":111},[106],{"_51":52,"_53":107,"_55":108,"_57":109,"_59":-5,"_61":-5,"_63":-5,"_65":-5},"/amznews-reading-preview/_img/398f0ec5bbb74b80.webp","/amznews-reading-preview/_img/398f0ec5bbb74b80.webp","/amznews-reading-preview/_img/398f0ec5bbb74b80.webp 336w, /amznews-reading-preview/_img/398f0ec5bbb74b80.webp 720w","跨境数据中心","AMZ123","品类趋势","AMZ123 · 跨境头条","lqz9gk9mglvrj1wpifejpsqji","Venture Forge发布2026年亚马逊英国站秋季大促市场数据","电商分析机构Venture Forge公布2026年亚马逊英国站Prime Big Deal Days数据，该周期内总销售额达10.6亿英镑，同比增长22%。其中第三方卖家增速（27.5%）接近自营卖家（13.9%）的两倍，且并非依靠更深折扣取胜。在追踪的10个主要品类中，第三方卖家有8个品类增速超过自营；韩国护肤品牌借势大促快速抢占市场份额，其在该品类中的占比从去年的9%升至25%。","原文引用了第三方机构对英国站大促的追踪数据，拆解了不同渠道和品类的销售表现差异。",{"_74":113},"2026-10-22T19:16:00.000Z","2026-10-23T03:16:32.691Z",[70,72,112,73],{"_66":128,"_68":111},[124],{"_51":52,"_53":125,"_55":126,"_57":127,"_59":-5,"_61":-5,"_63":-5,"_65":-5},"/amznews-reading-preview/_img/92c4f26b0516012f.webp","/amznews-reading-preview/_img/92c4f26b0516012f.webp","/amznews-reading-preview/_img/92c4f26b0516012f.webp 336w, /amznews-reading-preview/_img/92c4f26b0516012f.webp 720w","亚马逊资讯","qzmmoq731wpzau4mal0lbt2wb","2026年亚马逊英国站秋季大促销售额达10.6亿英镑，第三方卖家增速显著","电商分析机构 Venture Forge 公布 2026 年亚马逊英国站 Prime Big Deal Days 数据，大促周总销售额预计达 10.6 亿英镑，同比增长 22%。","Venture Forge 数据显示第三方卖家增速近自营两倍，且非依赖深折，为黑五备货与渠道策略提供量化参考。",{"_74":141},"2026-10-23T03:33:09.000Z","2026-10-23T04:58:30.197Z",[70,73],{"_66":139,"_68":140},[],"跨境资讯通","卖家之家","卖家之家 · 跨境资讯","rjra5h5dj4i040g1aq43a4o3d","e-Conomy SEA 2026报告：东南亚电商GMV预计达2260亿美元","谷歌、淡马锡和贝恩公司联合发布《e-Conomy SEA 2026》报告，预计2026年东南亚数字经济GMV达3680亿美元，其中电子商务GMV为2260亿美元，同比增长18%。报告指出AI正改变消费者购物方式，六国约58%劳动年龄人口使用生成式AI，69%受访消费者用AI比较商品；平台如Lazada和Shopee也利用AI提升运营效率与用户体验。","原文引用谷歌等机构联合发布的东南亚互联网经济报告，提供了2026年电商GMV预测及AI在购物决策中的具体渗透率数据。",{"_74":141},"2026-10-23T03:33:42.000Z","2026-10-23T04:58:30.175Z",[70,112,152],{"_66":139,"_68":140},[],"AI工具","slug","data-reports","数据与报告","group","genre","definition","市场数据、品类趋势与调研报告：帮助卖家做选品、定价与预算决策。","total",6,"recent",4,"indexable",false,"latestAt","related",[169,170],{"_153":173,"_74":174},{"_153":171,"_74":172},"advertising","广告投放","product-selection","选品与市场",{"_176":177},"changelogVersion","2026-10-09T22:08"]
