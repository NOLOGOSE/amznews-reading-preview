[{"_1":2,"_3":4},"root",{"_5":173},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_153":154,"_55":54,"_155":156,"_157":158,"_159":160,"_161":160,"_162":163,"_164":140,"_165":166},"items",[14,15,16,17,18,19],"page",1,"pageCount",{"_20":135,"_22":136,"_24":137,"_26":138,"_28":139,"_30":140,"_32":141,"_34":141,"_35":142,"_37":143,"_39":65,"_41":42,"_43":44,"_45":144,"_47":145,"_49":-5},{"_20":113,"_22":114,"_24":115,"_26":116,"_28":117,"_30":118,"_32":119,"_34":119,"_35":120,"_37":121,"_39":122,"_41":42,"_43":44,"_45":123,"_47":124,"_49":-5},{"_20":100,"_22":101,"_24":102,"_26":103,"_28":104,"_30":105,"_32":106,"_34":105,"_35":36,"_37":107,"_39":65,"_41":42,"_43":44,"_45":108,"_47":109,"_49":-5},{"_20":70,"_22":71,"_24":72,"_26":73,"_28":74,"_30":75,"_32":76,"_34":75,"_35":77,"_37":78,"_39":65,"_41":42,"_43":44,"_45":79,"_47":80,"_49":-5},{"_20":57,"_22":58,"_24":59,"_26":60,"_28":61,"_30":62,"_32":63,"_34":62,"_35":36,"_37":64,"_39":65,"_41":42,"_43":44,"_45":66,"_47":67,"_49":-5},{"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":31,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":-5},"id","q2kry5nzvy5pq56dfcq6qcxm7","title","商务部公布中美贸易理事会及“300亿对300亿”对等降税框架有关情况","summary","商务部公布中美双方就建立政府间贸易理事会及“300亿对300亿”对等降税框架达成的共识。双方商定，对各自规模约为300亿美元（参照2024年度双边贸易额）的进口产品，在符合双方各自国内法律和程序的基础上，以对等方式提供降低关税待遇；其中超过90%的产品将免除相互加征的全部关税，享受最惠国关税待遇。后续双方将在履行各自国内相关法律程序后，同步实施降税。","reason","原文披露了中美贸易理事会工作规程、300亿美元对等降税框架的产品清单及实施条件，并明确降税须在符合双方各自国内法律和程序的基础上、履行相关程序后同步实施。","source",{"_55":56},"publishedAt","2026-09-28T00:00:00.000Z","collectedAt","2026-10-17T05:16:20.993Z","timelineAt","category","policy","tags",[53,54],"score",67,"selected",true,"channel","news","byline",{"_50":-5,"_51":52},"media",[],"x","author","platform","商务部","政策/合规","行业动态","name","商务部 · 新闻发布","h5ce52rywnku4zc7fqpfvpou0","美国海关发布低值货物入境规则：区分非邮政与邮政渠道暂停免税待遇","美国海关与边境保护局（CBP）在联邦公报发布关于低值货物（Low-Value Shipments）的规则文件。据原文脚注，2026年6月24日CBP分别发布两份临时最终规则，一份暂停非邮政渠道低值货物的免税豁免，另一份暂停邮政渠道低值货物的免税豁免。","原文列出了低值货物免税豁免暂停后涉及的入境类型要求、数据字段及违规罚款标准等规则内容，可供相关进口商与承运人了解合规要求。",{"_55":69},"2026-10-08T04:00:00.000Z","2026-10-16T14:13:45.511Z",[53,54],62,{"_50":-5,"_51":68},[],"美国海关 CBP","美国海关 CBP · 联邦公报公告","nh8bxs4e30n8m1xnmthamza4f","亚马逊封禁 Meta AI 智能体 Muse 访问购物功能，Shopify 选择合作接入支付体系","蓝海亿观网报道，Meta 新上线的 AI 智能体 Muse 因表现强劲引发关注，亚马逊于 9 月 20 日阻止其代替用户购物，理由是未获授权、未表明 AI 身份及存在隐私安全风险；而 Shopify 则主动开放商品库数据并将 Shop Pay 接入 Muse 支付体系。","原文对比了亚马逊封禁与 Shopify 拥抱 Meta AI 智能体 Muse 的不同策略，并分析了背后的商业模式差异。",{"_55":99},"2026-10-09T07:04:19.000Z","2026-10-16T14:43:54.096Z","ai-tools",[54,97,98],{"_50":-5,"_51":96},[81],{"_82":83,"_84":85,"_86":87,"_88":89,"_90":91,"_92":93,"_94":-5,"_95":-5},"kind","image","url","/amznews-reading-preview/_img/749caa88d5f17e8f.webp","fullUrl","/amznews-reading-preview/_img/749caa88d5f17e8f.webp","srcSet","/amznews-reading-preview/_img/749caa88d5f17e8f.webp 336w, /amznews-reading-preview/_img/749caa88d5f17e8f.webp 720w","width",760,"height",400,"alt","poster","蓝海亿观网","AI工具","亚马逊","蓝海亿观网 · 跨境电商资讯","j3fyibxp94irr8478nk5fv0aj","欧盟拟引入市场监督费以加强非欧盟包裹检查","据泄露草案显示，欧盟委员会计划推出“联盟市场监督费”，旨在资助对来自欧盟以外产品的市场监督和检查。该费用将在现有的3欧元进口关税和即将实施的2欧元清关处理费之外叠加，原则上由进口商承担，且针对直接发货给消费者的个人包裹费率高于批量进口。此外，草案还规定违规者可能面临高达全球年营收6%的罚款。","原文梳理了欧盟拟议的第三项包裹费用及最高6%全球营收罚款，为跨境卖家提供了合规成本与风险参考。",{"_55":112},"2026-10-09T16:17:20.000Z","2026-10-16T09:17:27.464Z",[53,54],{"_50":110,"_51":111},[],"Arjan","Ecommerce News Europe","Ecommerce News Europe · 欧洲电商与平台动态","o7kn5o69m03o7ues0p9998d69","亚马逊美国站FBA仓库拥堵，卖家旺季入仓受阻","原文报道称，2026年10月亚马逊美国站多个热门FBA仓库出现拥堵、预约紧张和入仓延迟，部分卖家货物到仓后无法及时入库。原文列出黑五网一入仓截止线：AWD为10月14日，选择“最少货件拆分”的FBA为10月21日，选择“亚马逊优化货件拆分”的FBA为10月28日；并称自2026年7月31日起AWD仅接受标准尺寸商品。原文引用Descartes数据称美国9月海运集装箱进口量及中国货物进口量同比增长，并引用贝恩公司对旺季零售额的预测；本站尚未独立核验上述引用。原文还提到部分仓库拒收率和卸货等待时长，相关说法来自物料商信息，本站未独立核实。","文章汇总了美国站旺季入仓截止线、仓库拥堵情况及卖家应对建议，并标注了进口数据与预测的来源归属；相关统计和拒收率说法本站尚未独立核验，读者应结合原文条件判断。",{"_55":134},"2026-10-18T05:12:00.000Z","2026-10-19T03:37:38.400Z","fba",[54,131,132,133,98],65,{"_50":129,"_51":130},[125],{"_82":83,"_84":126,"_86":127,"_88":128,"_90":-5,"_92":-5,"_94":-5,"_95":-5},"/amznews-reading-preview/_img/7059e6aa91f09829.webp","/amznews-reading-preview/_img/7059e6aa91f09829.webp","/amznews-reading-preview/_img/7059e6aa91f09829.webp 336w, /amznews-reading-preview/_img/7059e6aa91f09829.webp 720w","跨境电商头条","AMZ123","FBA/物流","库存管理","供应链","AMZ123 · 跨境头条","gyk8t0gfma3991fzuadhxipj4","亚马逊 AI 购物助手推荐逻辑解析：为何多数选品不依赖搜索排名","ZonFlip 引用 Marketplace Pulse 及 Autopilotbrand.com 的研究指出，亚马逊 AI 购物助手（Alexa for Shopping）的推荐结果与传统的自然搜索排名和广告投放关联度较低。","文章基于第三方调研数据，指出亚马逊AI购物助手推荐结果与搜索排名存在显著差异，为卖家提供了应对新流量入口的运营思路。",{"_55":152},"2026-10-20T10:12:41.000Z","2026-10-20T10:57:42.001Z","advertising",[54,97,98],{"_50":150,"_51":151},[146],{"_82":83,"_84":147,"_86":148,"_88":149,"_90":-5,"_92":-5,"_94":-5,"_95":-5},"/amznews-reading-preview/_img/148d944238cddc44.webp","/amznews-reading-preview/_img/148d944238cddc44.webp","/amznews-reading-preview/_img/148d944238cddc44.webp 336w, /amznews-reading-preview/_img/148d944238cddc44.webp 720w","Joey Glyshaw","ZonFlip","ZonFlip · Joey Glyshaw","slug","industry","group","genre","definition","跨境电商与亚马逊生态的商业脉搏：并购、诉讼、监管与平台竞争。","total",6,"recent","indexable",false,"latestAt","related",[167,168],{"_153":171,"_55":172},{"_153":169,"_55":170},"amazon","亚马逊 / Amazon","opinions","观点与分析",{"_174":175},"changelogVersion","2026-10-09T22:08"]
