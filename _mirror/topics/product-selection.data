[{"_1":2,"_3":4},"root",{"_5":174},"topic",{"_5":6},"data",{"_5":7},{"_3":8,"_9":10,"_11":12,"_13":12},{"_152":153,"_74":154,"_155":156,"_157":158,"_159":160,"_161":162,"_163":164,"_165":142,"_166":167},"items",[14,15,16,17,18],"page",1,"pageCount",{"_19":137,"_21":138,"_23":139,"_25":140,"_27":141,"_29":142,"_31":143,"_33":143,"_34":83,"_36":144,"_38":39,"_40":41,"_42":43,"_44":145,"_46":146,"_48":-5},{"_19":119,"_21":120,"_23":121,"_25":122,"_27":123,"_29":124,"_31":125,"_33":124,"_34":83,"_36":126,"_38":39,"_40":41,"_42":43,"_44":127,"_46":128,"_48":-5},{"_19":99,"_21":100,"_23":101,"_25":102,"_27":103,"_29":104,"_31":105,"_33":104,"_34":83,"_36":106,"_38":107,"_40":41,"_42":43,"_44":108,"_46":109,"_48":-5},{"_19":76,"_21":77,"_23":78,"_25":79,"_27":80,"_29":81,"_31":82,"_33":81,"_34":83,"_36":84,"_38":39,"_40":41,"_42":43,"_44":85,"_46":86,"_48":-5},{"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":30,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":-5},"id","ny0pehwcbufue3nmvohbwky1w","title","亚马逊推出多项 AI 工具，帮助卖家更快上线新品","summary","亚马逊宣布推出和升级多项面向卖家的 AI 工具，包括 AI 版 Opportunity Explorer、Unmet Demand Insights 和 Niche Product Overview，用于识别未满足需求和选品机会。","reason","亚马逊官方集中发布面向新品上线的多项 AI 工具与 Vine、A+ 内容升级，卖家可据此了解各功能的作用与适用环节。","source",{"_74":75},"publishedAt","2025-09-18T13:00:18.517Z","collectedAt","2026-10-07T15:34:47.328Z","timelineAt","category","ai-tools","tags",[68,69,70,71,72,73],"score",62,"selected",true,"channel","news","byline",{"_64":65,"_66":67},"media",[49],"x",{"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":61,"_62":-5,"_63":-5},"kind","image","url","/amznews-reading-preview/_img/ee18af70c8b3009e.webp","fullUrl","/amznews-reading-preview/_img/ee18af70c8b3009e.webp","srcSet","/amznews-reading-preview/_img/ee18af70c8b3009e.webp 336w, /amznews-reading-preview/_img/ee18af70c8b3009e.webp 720w","width",1240,"height",698,"alt","poster","author","Mary Beth Westmoreland","platform","About Amazon","AI/工具","亚马逊","AI工具","选品/市场","Listing优化","FBA/物流","name","About Amazon · 创新","gy3vj64j8pb1honnxcqz8byo0","Feedvisor 发布 Prime Day 2026 数据：营收增长但盈利难度加大","Feedvisor 分析显示，其客户在 Prime Day 2026 期间销售额同比增长 25%，但平均订单价值下降 5.8%。由于 CPC 和 CPM 分别上涨 13.5% 和 11%，商品详情页转化率从 3.23% 提升至 5.20% 成为维持利润的核心因素。此外，亚马逊自 4 月起收紧参考价规则，要求划线价必须有真实成交记录支撑，这促使卖家放弃虚假折扣以换取更高的价格可信度。","原文结合第三方数据与自身客户样本，指出转化率提升是抵消流量成本上涨的关键，并提示了定价规则收紧对折扣可信度的影响。",{"_74":98},"2026-07-13T18:21:11.000Z","2026-10-16T14:43:47.681Z","product",[96,97,71,69],{"_64":94,"_66":95},[87],{"_50":51,"_52":88,"_54":89,"_56":90,"_58":91,"_60":92,"_62":93,"_63":-5},"/amznews-reading-preview/_img/aad8904875ceabda.webp","/amznews-reading-preview/_img/aad8904875ceabda.webp","/amznews-reading-preview/_img/aad8904875ceabda.webp 336w, /amznews-reading-preview/_img/aad8904875ceabda.webp 720w",123,107,"","Marissa Incitti","Feedvisor","数据/报告","广告/运营","Feedvisor · 亚马逊运营与数据博客","ejaut0xzgyckhb73ku9j99tpb","Seller Snap 发布 Prime Day 2026 定价与需求数据分析报告","Seller Snap 分析美国站超 10 万款商品发现，仅 18% 的商品在 Prime Day 期间降价 5% 以上，却贡献了 70% 的销量增长。数据显示折扣越深销量提升越大（如降价 30% 以上销量激增 771%），且大幅降价品类在活动后出现明显的销量回落。","基于10万款商品同品对比，量化了折扣深度与销量增幅的阶梯关系，并验证了促销后的需求透支效应。",{"_74":118},"2026-07-15T07:47:44.000Z","2026-10-16T16:16:44.568Z",[96,71,69],66,{"_64":116,"_66":117},[110],{"_50":51,"_52":111,"_54":112,"_56":113,"_58":114,"_60":115,"_62":93,"_63":-5},"/amznews-reading-preview/_img/d3aafc60a2d4fe9a.webp","/amznews-reading-preview/_img/d3aafc60a2d4fe9a.webp","/amznews-reading-preview/_img/d3aafc60a2d4fe9a.webp 336w, /amznews-reading-preview/_img/d3aafc60a2d4fe9a.webp 720w",640,335,"Julian Goldhill","Seller Snap","Seller Snap · 亚马逊调价与 Buy Box 博客","i6hnhpokxg74kva9wqgwz0v5h","Marketplace Pulse发布2026年TikTok Shop美国站趋势报告：头部卖家销售额占比59%","Marketplace Pulse发布《2026年TikTok Shop美国站趋势报告》，基于截至2026年9月的追踪数据显示，TikTok Shop美国站前1%的卖家贡献了59%的销售额，美妆、服饰和健康类商品占据主导。","原文归纳了TikTok Shop美国站头部卖家集中度高及内容驱动销售等七大趋势，为品牌评估跨平台运营策略提供了数据参考。",{"_74":136},"2026-10-16T02:07:00.000Z","2026-10-16T14:43:50.705Z",[96,71,135,69],{"_64":133,"_66":134},[129],{"_50":51,"_52":130,"_54":131,"_56":132,"_58":-5,"_60":-5,"_62":-5,"_63":-5},"/amznews-reading-preview/_img/398f0ec5bbb74b80.webp","/amznews-reading-preview/_img/398f0ec5bbb74b80.webp","/amznews-reading-preview/_img/398f0ec5bbb74b80.webp 336w, /amznews-reading-preview/_img/398f0ec5bbb74b80.webp 720w","跨境数据中心","AMZ123","品类趋势","AMZ123 · 跨境头条","lqz9gk9mglvrj1wpifejpsqji","Venture Forge发布2026年亚马逊英国站秋季大促市场数据","电商分析机构Venture Forge公布2026年亚马逊英国站Prime Big Deal Days数据，该周期内总销售额达10.6亿英镑，同比增长22%。其中第三方卖家增速（27.5%）接近自营卖家（13.9%）的两倍，且并非依靠更深折扣取胜。在追踪的10个主要品类中，第三方卖家有8个品类增速超过自营；韩国护肤品牌借势大促快速抢占市场份额，其在该品类中的占比从去年的9%升至25%。","原文引用了第三方机构对英国站大促的追踪数据，拆解了不同渠道和品类的销售表现差异。",{"_74":136},"2026-10-22T19:16:00.000Z","2026-10-23T03:16:32.691Z",[96,71,135,69],{"_64":151,"_66":134},[147],{"_50":51,"_52":148,"_54":149,"_56":150,"_58":-5,"_60":-5,"_62":-5,"_63":-5},"/amznews-reading-preview/_img/92c4f26b0516012f.webp","/amznews-reading-preview/_img/92c4f26b0516012f.webp","/amznews-reading-preview/_img/92c4f26b0516012f.webp 336w, /amznews-reading-preview/_img/92c4f26b0516012f.webp 720w","亚马逊资讯","slug","product-selection","选品与市场","group","field","definition","选品与市场洞察：品类趋势、竞品分析、销量数据与商机挖掘。","total",5,"recent",2,"indexable",false,"latestAt","related",[168,169],{"_152":172,"_74":173},{"_152":170,"_74":171},"advertising","广告投放","data-reports","数据与报告",{"_175":176},"changelogVersion","2026-10-09T22:08"]
